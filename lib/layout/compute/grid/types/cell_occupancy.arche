/// compute.grid.types.cell_occupancy: taffy 0.15's
/// compute/grid/types/cell_occupancy.rs, the record of which grid cells are
/// taken while items are placed.
///
/// Occupancy is kept sparsely: each track holds a sorted list of disjoint
/// occupied intervals, in both orientations, so memory follows the number
/// of items, not of cells. taffy's Range<i16> is a start and an end here.
import alloc;
import layout.compute.grid.types.grid_track_counts as counts;
import layout.geometry as geo;
import layout.style.grid as sgrid;

/// The state of a grid cell (CellOccupancyState).
pub type CellOccupancyState = enum {
    /// Free.
    Unoccupied,
    /// Taken by an item with a definite position.
    DefinitelyPlaced,
    /// Taken by an auto-placed item.
    AutoPlaced,
}

/// A run of occupied cells in one track, in origin-zero lines of the other
/// axis (OccupiedInterval).
type OccupiedInterval = struct {
    /// The first line of the run.
    range_start: i16,
    /// The line after the run.
    range_end: i16,
    /// The state of every cell of the run.
    state: CellOccupancyState,

    /// Whether the run overlaps start..end.
    fn overlaps(self: &OccupiedInterval, start: i16, end: i16) -> bool {
        return self.range_start < end and self.range_end > start;
    }
}

/// The occupied cells of one track (TrackIntervals): sorted, disjoint
/// runs; touching runs of one state are merged.
type TrackIntervals = struct {
    /// The runs.
    intervals: alloc.List(OccupiedInterval),
    /// The furthest end line of an auto-placed item that starts in this
    /// secondary-axis track.
    auto_placement_cursor: ?sgrid.OriginZeroLine,

    /// An empty track (TrackIntervals::default).
    fn new(a: alloc.Allocator) -> TrackIntervals {
        return TrackIntervals { intervals: alloc.List(OccupiedInterval).init(a), auto_placement_cursor: none };
    }

    /// Whether any cell is occupied.
    fn is_empty(self: &TrackIntervals) -> bool {
        return self.intervals.len() == 0;
    }

    /// The state of the cell that starts at coordinate.
    fn state_at(self: &TrackIntervals, coordinate: i16) -> CellOccupancyState {
        for interval in self.intervals.items() {
            if interval.range_start <= coordinate and coordinate < interval.range_end {
                return interval.state;
            }
        }
        return CellOccupancyState.Unoccupied;
    }

    /// Sets the cells start..end to state, over whatever was there.
    fn paint(self: &mut TrackIntervals, start: i16, end: i16, state: CellOccupancyState, a: alloc.Allocator) {
        if start >= end {
            return;
        }

        // Fast path: the painted range lies after every run.
        let count = self.intervals.len();
        if count == 0 {
            self.intervals.push(OccupiedInterval { range_start: start, range_end: end, state: state });
            return;
        }
        let last = self.intervals.items()[count - 1];
        if last.range_end <= start {
            if last.state == state and last.range_end == start {
                self.intervals.items_mut()[count - 1].range_end = end;
            } else {
                self.intervals.push(OccupiedInterval { range_start: start, range_end: end, state: state });
            }
            return;
        }

        var result = alloc.List(OccupiedInterval).init(a);

        // Runs, or their parts, before the painted range.
        for interval in self.intervals.items() {
            if interval.range_end <= start {
                result.push(interval.*);
            } else if interval.range_start < start {
                result.push(OccupiedInterval { range_start: interval.range_start, range_end: start, state: interval.state });
            }
        }

        // The painted range, merged with the run before it if they touch
        // and share a state.
        let before = result.len();
        if before > 0 and result.items()[before - 1].state == state and result.items()[before - 1].range_end == start {
            result.items_mut()[before - 1].range_end = end;
        } else {
            result.push(OccupiedInterval { range_start: start, range_end: end, state: state });
        }

        // Runs, or their parts, after the painted range.
        for interval in self.intervals.items() {
            var trimmed = interval.*;
            if interval.range_start >= end {
                trimmed = interval.*;
            } else if interval.range_end > end {
                trimmed = OccupiedInterval { range_start: end, range_end: interval.range_end, state: interval.state };
            } else {
                continue;
            }
            let n = result.len();
            if result.items()[n - 1].state == trimmed.state and result.items()[n - 1].range_end == trimmed.range_start {
                result.items_mut()[n - 1].range_end = trimmed.range_end;
            } else {
                result.push(trimmed);
            }
        }

        self.intervals = result;
    }

    /// The last occupied cell of the last run overlapping start..end that
    /// an auto-placement search would collide with, or none when the range
    /// is free.
    fn collision_extent(self: &TrackIntervals, start: i16, end: i16) -> ?i16 {
        let items = self.intervals.items();
        var i = items.len();
        while i > 0 {
            i -= 1;
            let interval = items[i];
            if not (interval.range_end > start) {
                return none;
            }
            if interval.overlaps(start:, end:) {
                return interval.range_end - 1;
            }
        }
        return none;
    }
}

/// The occupancy of every cell during placement, growing as the implicit
/// grid does (CellOccupancyMatrix).
pub type CellOccupancyMatrix = struct {
    /// The column counts.
    columns: counts.TrackCounts,
    /// The row counts.
    rows: counts.TrackCounts,
    /// For each row track, its runs in column lines.
    row_intervals: alloc.List(TrackIntervals),
    /// For each column track, its runs in row lines.
    column_intervals: alloc.List(TrackIntervals),
    /// Where the lists go.
    a: alloc.Allocator,

    /// A matrix for provisional track counts; it grows as needed
    /// (with_track_counts).
    pub fn with_track_counts(columns: counts.TrackCounts, rows: counts.TrackCounts, a: alloc.Allocator) -> CellOccupancyMatrix {
        var row_intervals = alloc.List(TrackIntervals).with_capacity(a, rows.len());
        var r: usize = 0;
        while r < rows.len() : (r += 1) {
            row_intervals.push(TrackIntervals.new(a));
        }
        var column_intervals = alloc.List(TrackIntervals).with_capacity(a, columns.len());
        var c: usize = 0;
        while c < columns.len() : (c += 1) {
            column_intervals.push(TrackIntervals.new(a));
        }
        return CellOccupancyMatrix { columns: columns, rows: rows, row_intervals: row_intervals, column_intervals: column_intervals, a: a };
    }

    /// Grows the matrix, in any direction, until both spans fit.
    fn expand_to_fit_range(self: &mut CellOccupancyMatrix, row_span: geo.Line(sgrid.OriginZeroLine), col_span: geo.Line(sgrid.OriginZeroLine)) {
        let req_negative_rows = max_i16(a: 0 - (self.rows.negative_implicit as i16) - row_span.start.value, b: 0);
        let req_positive_rows = max_i16(a: row_span.end.value - self.rows.implicit_end_line().value, b: 0);
        let req_negative_cols = max_i16(a: 0 - (self.columns.negative_implicit as i16) - col_span.start.value, b: 0);
        let req_positive_cols = max_i16(a: col_span.end.value - self.columns.implicit_end_line().value, b: 0);

        // Runs are kept in origin-zero lines, so they do not shift.
        if req_negative_rows > 0 {
            prepend_empty_tracks(&mut self.row_intervals, req_negative_rows as usize, self.a);
        }
        var p: i16 = 0;
        while p < req_positive_rows : (p += 1) {
            self.row_intervals.push(TrackIntervals.new(self.a));
        }
        if req_negative_cols > 0 {
            prepend_empty_tracks(&mut self.column_intervals, req_negative_cols as usize, self.a);
        }
        var q: i16 = 0;
        while q < req_positive_cols : (q += 1) {
            self.column_intervals.push(TrackIntervals.new(self.a));
        }

        self.rows.negative_implicit += req_negative_rows as u16;
        self.rows.positive_implicit += req_positive_rows as u16;
        self.columns.negative_implicit += req_negative_cols as u16;
        self.columns.positive_implicit += req_positive_cols as u16;
    }

    /// Marks an area as occupied, growing the matrix to hold it.
    pub fn mark_area_as(self: &mut CellOccupancyMatrix, primary_axis: geo.AbsoluteAxis, primary_span: geo.Line(sgrid.OriginZeroLine), secondary_span: geo.Line(sgrid.OriginZeroLine), value: CellOccupancyState) {
        var row_span = primary_span;
        var column_span = secondary_span;
        if primary_axis == geo.AbsoluteAxis.Horizontal {
            row_span = secondary_span;
            column_span = primary_span;
        }

        self.expand_to_fit_range(row_span: row_span, col_span: column_span);

        if value == CellOccupancyState.AutoPlaced and primary_span.start.value < primary_span.end.value and secondary_span.start.value < secondary_span.end.value {
            self.advance_auto_placement_cursor(primary_axis, secondary_start: secondary_span.start, primary_end: primary_span.end);
        }

        let row_range = self.rows.oz_line_range_to_track_range(row_span);
        let col_range = self.columns.oz_line_range_to_track_range(column_span);
        var row_index = row_range.start;
        while row_index < row_range.end : (row_index += 1) {
            self.row_intervals.items_mut()[row_index as usize].paint(start: column_span.start.value, end: column_span.end.value, state: value, a: self.a);
        }
        var column_index = col_range.start;
        while column_index < col_range.end : (column_index += 1) {
            self.column_intervals.items_mut()[column_index as usize].paint(start: row_span.start.value, end: row_span.end.value, state: value, a: self.a);
        }
    }

    /// Whether the area between the lines is free (taffy's test helper).
    pub fn line_area_is_unoccupied(self: &CellOccupancyMatrix, primary_axis: geo.AbsoluteAxis, primary_span: geo.Line(sgrid.OriginZeroLine), secondary_span: geo.Line(sgrid.OriginZeroLine)) -> bool {
        match self.line_area_collision_jump(primary_axis, primary_span: primary_span, secondary_span: secondary_span) {
            some(_) => { return false; }
            none => { return true; }
        }
    }

    /// none when the area between the lines is free; otherwise the next
    /// search position along the primary axis that does not surely collide
    /// with what is there, so the search can jump past it.
    pub fn line_area_collision_jump(self: &CellOccupancyMatrix, primary_axis: geo.AbsoluteAxis, primary_span: geo.Line(sgrid.OriginZeroLine), secondary_span: geo.Line(sgrid.OriginZeroLine)) -> ?sgrid.OriginZeroLine {
        let secondary_axis = primary_axis.other_axis();
        let secondary_counts = self.track_counts(secondary_axis);
        let secondary_range = secondary_counts.oz_line_range_to_track_range(secondary_span);

        // Cells outside the matrix are free: only the tracks that exist.
        var list_len: usize = self.row_intervals.len();
        if secondary_axis == geo.AbsoluteAxis.Horizontal {
            list_len = self.column_intervals.len();
        }
        let secondary_start = max_i16(a: secondary_range.start, b: 0);
        let secondary_end = min_i16(a: secondary_range.end, b: list_len as i16);

        var extent: ?i16 = none;
        var secondary_index = secondary_start;
        while secondary_index < secondary_end : (secondary_index += 1) {
            var found: ?i16 = none;
            if secondary_axis == geo.AbsoluteAxis.Horizontal {
                found = self.column_intervals.items()[secondary_index as usize].collision_extent(start: primary_span.start.value, end: primary_span.end.value);
            } else {
                found = self.row_intervals.items()[secondary_index as usize].collision_extent(start: primary_span.start.value, end: primary_span.end.value);
            }
            match found {
                some(cell) => {
                    match extent {
                        some(best) => { extent = some(max_i16(a: best, b: cell)); }
                        none => { extent = some(cell); }
                    }
                }
                none => { }
            }
        }

        match extent {
            some(cell) => { return sgrid.OriginZeroLine { value: cell + 1 }; }
            none => { return none; }
        }
    }

    /// none when every track of axis in span is empty; otherwise the
    /// search position past the last track there that is not (for items
    /// spanning every track of the other axis).
    pub fn occupied_track_jump(self: &CellOccupancyMatrix, axis: geo.AbsoluteAxis, span: geo.Line(sgrid.OriginZeroLine)) -> ?sgrid.OriginZeroLine {
        let track_counts = self.track_counts(axis);
        var list_len: usize = self.row_intervals.len();
        if axis == geo.AbsoluteAxis.Horizontal {
            list_len = self.column_intervals.len();
        }
        let range = track_counts.oz_line_range_to_track_range(span);
        let start = max_i16(a: range.start, b: 0);
        let end = min_i16(a: range.end, b: list_len as i16);
        var index = end;
        while index > start {
            index -= 1;
            var empty = true;
            if axis == geo.AbsoluteAxis.Horizontal {
                empty = self.column_intervals.items()[index as usize].is_empty();
            } else {
                empty = self.row_intervals.items()[index as usize].is_empty();
            }
            if not empty {
                let line = track_counts.track_to_prev_oz_line(index as u16);
                return line.add_u16(1);
            }
        }
        return none;
    }

    /// Whether the row (a matrix index) holds any item.
    pub fn row_is_occupied(self: &CellOccupancyMatrix, row_index: usize) -> bool {
        if row_index >= self.row_intervals.len() {
            return false;
        }
        return not self.row_intervals.items()[row_index].is_empty();
    }

    /// Whether the column (a matrix index) holds any item.
    pub fn column_is_occupied(self: &CellOccupancyMatrix, column_index: usize) -> bool {
        if column_index >= self.column_intervals.len() {
            return false;
        }
        return not self.column_intervals.items()[column_index].is_empty();
    }

    /// The track counts in an axis.
    pub fn track_counts(self: &CellOccupancyMatrix, track_type: geo.AbsoluteAxis) -> counts.TrackCounts {
        match track_type {
            .Horizontal => { return self.columns; }
            .Vertical => { return self.rows; }
        }
    }

    /// The placement cursor of the secondary-axis track that starts at
    /// start_at (taffy's sparse cursor).
    pub fn auto_placement_cursor(self: &CellOccupancyMatrix, track_type: geo.AbsoluteAxis, start_at: sgrid.OriginZeroLine) -> ?sgrid.OriginZeroLine {
        let other = track_type.other_axis();
        let track_counts = self.track_counts(other);
        let track_computed_index = track_counts.oz_line_to_next_track(start_at);
        if other == geo.AbsoluteAxis.Horizontal {
            if track_computed_index < 0 or track_computed_index >= (self.column_intervals.len() as i16) {
                return none;
            }
            return self.column_intervals.items()[track_computed_index as usize].auto_placement_cursor;
        }
        if track_computed_index < 0 or track_computed_index >= (self.row_intervals.len() as i16) {
            return none;
        }
        return self.row_intervals.items()[track_computed_index as usize].auto_placement_cursor;
    }

    /// Moves the cursor of the secondary-axis track at secondary_start to
    /// at least primary_end; the track exists already.
    fn advance_auto_placement_cursor(self: &mut CellOccupancyMatrix, primary_axis: geo.AbsoluteAxis, secondary_start: sgrid.OriginZeroLine, primary_end: sgrid.OriginZeroLine) {
        let track_index = self.track_counts(primary_axis.other_axis()).oz_line_to_next_track(secondary_start) as usize;
        if primary_axis == geo.AbsoluteAxis.Horizontal {
            let cursor = self.row_intervals.items()[track_index].auto_placement_cursor;
            self.row_intervals.items_mut()[track_index].auto_placement_cursor = cursor_max(cursor, primary_end);
        } else {
            let cursor = self.column_intervals.items()[track_index].auto_placement_cursor;
            self.column_intervals.items_mut()[track_index].auto_placement_cursor = cursor_max(cursor, primary_end);
        }
    }
}

/// max(cursor, Some(line)), none being the smallest.
fn cursor_max(cursor: ?sgrid.OriginZeroLine, line: sgrid.OriginZeroLine) -> ?sgrid.OriginZeroLine {
    match cursor {
        some(c) => { return c.max(line); }
        none => { return line; }
    }
}

/// Puts count empty tracks before the others.
fn prepend_empty_tracks(list: &mut alloc.List(TrackIntervals), count: usize, a: alloc.Allocator) {
    var reversed = alloc.List(TrackIntervals).init(a);
    while true {
        match list.pop() {
            some(t) => { reversed.push(t); }
            none => { break; }
        }
    }
    var k: usize = 0;
    while k < count : (k += 1) {
        list.push(TrackIntervals.new(a));
    }
    while true {
        match reversed.pop() {
            some(t) => { list.push(t); }
            none => { break; }
        }
    }
}

/// core::cmp::max for i16.
fn max_i16(a: i16, b: i16) -> i16 {
    if b > a {
        return b;
    }
    return a;
}

/// core::cmp::min for i16.
fn min_i16(a: i16, b: i16) -> i16 {
    if b < a {
        return b;
    }
    return a;
}
