/// tree.cache: taffy 0.15's tree/cache.rs, the per-node cache of layout
/// results that compute.compute_cached_layout reads and fills through
/// LayoutTree.cache_get and cache_store. The embedder keeps one Cache per
/// node.
import core.float;
import layout.geometry as geo;
import layout.style as sty;
import layout.tree as lt;

/// The number of size entries per node (CACHE_SIZE).
const CACHE_SIZE: usize = 9;

/// f32::INFINITY's bits.
const INFINITY_BITS: u32 = 0x7F800000;
/// f32::NEG_INFINITY's bits.
const NEG_INFINITY_BITS: u32 = 0xFF800000;
/// The sign bit of the first f32 of a key.
const SIGN_BIT_1: u64 = 0x8000000000000000;
/// The sign bit of the second f32 of a key.
const SIGN_BIT_2: u64 = 0x80000000;
/// Both sign bits.
const BOTH_SIGN_BITS_MASK: u64 = 0x8000000080000000;
/// Everything but the sign bits.
const NON_SIGN_BITS_MASK: u64 = 0x7FFFFFFF7FFFFFFF;
/// The bits of the first (x-axis) f32 of a key.
const X_AXIS_VALUE_MASK: u64 = 0xFFFFFFFF00000000;

/// An Option<f32> as 32 bits: the value's, or infinity's for none.
fn option_cache_key(input: ?f32) -> u32 {
    match input {
        some(value) => { return float.bits32(value); }
        none => { return INFINITY_BITS; }
    }
}

/// A Size<Option<f32>> as 64 bits.
fn size_option_cache_key(input: geo.Size(?f32)) -> u64 {
    return ((option_cache_key(input.width) as u64) << 32) | (option_cache_key(input.height) as u64);
}

/// An AvailableSpace as 32 bits: a definite value negated (so its sign
/// bit is free), min-content as -infinity, max-content as infinity.
fn available_space_cache_key(input: sty.AvailableSpace) -> u32 {
    match input {
        .Definite { value } => { return float.bits32(-value); }
        .MinContent => { return NEG_INFINITY_BITS; }
        .MaxContent => { return INFINITY_BITS; }
    }
}

/// A known dimension, or else the available space, in one axis.
fn mixed_cache_key(kd: ?f32, avs: sty.AvailableSpace) -> u32 {
    match kd {
        some(value) => { return float.bits32(value); }
        none => { return available_space_cache_key(avs); }
    }
}

/// The known dimensions and available space of both axes as 64 bits.
fn size_mixed_cache_key(kd: geo.Size(?f32), avs: geo.Size(sty.AvailableSpace)) -> u64 {
    return ((mixed_cache_key(kd.width, avs.width) as u64) << 32) | (mixed_cache_key(kd.height, avs.height) as u64);
}

/// A cache entry's key (CacheKey).
type CacheKey = struct {
    /// The known dimensions and available space.
    kd_available_space: u64,
    /// The parent size, the requested axis in its sign bits.
    parent_size: u64,
    /// Whether each known dimension is definite; true without one.
    known_dimensions_are_definite: geo.Size(bool),

    /// The key of a layout input.
    fn from(input: &lt.LayoutInput) -> CacheKey {
        var extra_bits = SIGN_BIT_1 | SIGN_BIT_2;
        if input.axis == lt.RequestedAxis.Horizontal {
            extra_bits = SIGN_BIT_1;
        } else if input.axis == lt.RequestedAxis.Vertical {
            extra_bits = SIGN_BIT_2;
        }
        return CacheKey {
            kd_available_space: size_mixed_cache_key(input.known_dimensions, input.available_space),
            parent_size: (size_option_cache_key(input.parent_size) & NON_SIGN_BITS_MASK) | extra_bits,
            known_dimensions_are_definite: geo.Size(bool) {
                width: input.known_dimensions_are_definite.width or is_none(input.known_dimensions.width),
                height: input.known_dimensions_are_definite.height or is_none(input.known_dimensions.height),
            },
        };
    }

    /// The parent size's x-axis bits, without the axis bits.
    fn x_axis_parent_size(self: CacheKey) -> u64 {
        return self.parent_size & (X_AXIS_VALUE_MASK & NON_SIGN_BITS_MASK);
    }

    /// The bits of the requested axis.
    fn requested_axis_bits(self: CacheKey) -> u64 {
        return self.parent_size & BOTH_SIGN_BITS_MASK;
    }

    /// Whether this entry's size is valid for other's axis: it was computed
    /// for both axes or for the same one.
    fn size_is_valid_for(self: CacheKey, other: CacheKey) -> bool {
        let entry_axis = self.requested_axis_bits();
        return entry_axis == BOTH_SIGN_BITS_MASK or entry_axis == other.requested_axis_bits();
    }

    /// Whether every field is equal.
    fn eq(self: CacheKey, other: CacheKey) -> bool {
        return self.kd_available_space == other.kd_available_space and self.parent_size == other.parent_size and self.known_dimensions_are_definite.width == other.known_dimensions_are_definite.width and self.known_dimensions_are_definite.height == other.known_dimensions_are_definite.height;
    }
}

/// The bit of a size entry in recently_used_entries.
fn bit(index: usize) -> u16 {
    let one: u16 = 1;
    return one << (index as u32);
}

/// Whether x is none.
fn is_none(x: ?f32) -> bool {
    match x {
        some(_) => { return false; }
        none => { return true; }
    }
}

/// The sizing mode and collapsible margins all entries were computed with,
/// as bits (CacheMode).
fn cache_mode(input: &lt.LayoutInput) -> u8 {
    var mode: u8 = 0;
    if input.sizing_mode == lt.SizingMode.InherentSize {
        mode = mode | 1;
    }
    if input.vertical_margins_are_collapsible.start {
        mode = mode | 2;
    }
    if input.vertical_margins_are_collapsible.end {
        mode = mode | 4;
    }
    return mode;
}

/// The final layout entry (CacheEntry<LayoutOutput>).
type FinalEntry = struct {
    /// Its key.
    key: CacheKey,
    /// The result.
    content: lt.LayoutOutput,
}

/// A size entry (CacheEntry<Size<f32>>).
type MeasureEntry = struct {
    /// Its key.
    key: CacheKey,
    /// The size.
    content: geo.Size(f32),
}

/// One node's cache: a final layout and up to nine sizes (Cache). It holds
/// a LayoutOutput, so it is move-only.
pub type Cache = struct {
    /// The final layout's entry.
    final_layout_entry: ?FinalEntry,
    /// The size entries.
    measure_entries: [9]?MeasureEntry,
    /// Which size entries were used since the eviction cursor passed them.
    recently_used_entries: u16,
    /// The next size entry to replace.
    next_measure_entry: u8,
    /// Whether every entry is empty.
    is_empty_flag: bool,
    /// The sizing mode and collapsible margins of every entry.
    mode: u8,

    /// Cache::new: empty.
    pub fn new() -> Cache {
        return Cache {
            final_layout_entry: none,
            measure_entries: [none, none, none, none, none, none, none, none, none],
            recently_used_entries: 0,
            next_measure_entry: 0,
            is_empty_flag: true,
            mode: 0,
        };
    }

    /// The cached result for the input, if any (get): a final layout for
    /// PerformLayout, a size for ComputeSize, never for a hidden layout.
    pub fn get(self: &mut Cache, input: &lt.LayoutInput) -> ?lt.LayoutOutput {
        if self.mode != cache_mode(input) {
            return none;
        }
        let key = CacheKey.from(input);
        match input.run_mode {
            .PerformLayout => {
                match &self.final_layout_entry {
                    some(entry) => {
                        if entry.key.eq(key) {
                            return entry.content.clone();
                        }
                        return none;
                    }
                    none => { return none; }
                }
            }
            .ComputeSize => {
                var index: usize = 0;
                while index < CACHE_SIZE : (index += 1) {
                    match self.measure_entries[index] {
                        some(entry) => {
                            if entry.key.kd_available_space == key.kd_available_space
                                and entry.key.known_dimensions_are_definite.width == key.known_dimensions_are_definite.width
                                and entry.key.known_dimensions_are_definite.height == key.known_dimensions_are_definite.height
                                and entry.key.x_axis_parent_size() == key.x_axis_parent_size()
                                and entry.key.size_is_valid_for(key) {
                                self.recently_used_entries = self.recently_used_entries | bit(index);
                                return lt.LayoutOutput.from_outer_size(entry.content);
                            }
                        }
                        none => { }
                    }
                }
                return none;
            }
            .PerformHiddenLayout => { return none; }
        }
    }

    /// Stores a result (store). Storing under another mode drops every
    /// entry first; a size result that carries collapsible margins is not
    /// stored, as a size alone cannot give them back.
    pub fn store(self: &mut Cache, input: &lt.LayoutInput, layout_output: lt.LayoutOutput) {
        if input.run_mode == lt.RunMode.PerformHiddenLayout {
            return;
        }
        let mode = cache_mode(input);
        if self.mode != mode {
            _ = self.clear();
            self.mode = mode;
        }
        let key = CacheKey.from(input);
        if input.run_mode == lt.RunMode.PerformLayout {
            self.is_empty_flag = false;
            self.final_layout_entry = some(FinalEntry { key: key, content: layout_output });
            return;
        }
        // ComputeSize
        if layout_output.margins_can_collapse_through or not layout_output.top_margin.eq(lt.CollapsibleMarginSet.zero()) or not layout_output.bottom_margin.eq(lt.CollapsibleMarginSet.zero()) {
            return;
        }
        self.is_empty_flag = false;
        var index: usize = 0;
        while index < CACHE_SIZE : (index += 1) {
            match self.measure_entries[index] {
                some(entry) => {
                    if entry.key.eq(key) {
                        self.measure_entries[index] = some(MeasureEntry { key: entry.key, content: layout_output.size });
                        self.recently_used_entries = self.recently_used_entries | bit(index);
                        return;
                    }
                }
                none => { }
            }
        }
        while (self.recently_used_entries & bit(self.next_measure_entry as usize)) != 0 {
            self.recently_used_entries = self.recently_used_entries & ~bit(self.next_measure_entry as usize);
            self.next_measure_entry += 1;
            if (self.next_measure_entry as usize) == CACHE_SIZE {
                self.next_measure_entry = 0;
            }
        }
        let entry_index = self.next_measure_entry as usize;
        self.measure_entries[entry_index] = some(MeasureEntry { key: key, content: layout_output.size });
        self.recently_used_entries = self.recently_used_entries | bit(entry_index);
        self.next_measure_entry += 1;
        if (self.next_measure_entry as usize) == CACHE_SIZE {
            self.next_measure_entry = 0;
        }
    }

    /// Drops every entry (clear); true when there was one, taffy's
    /// ClearState::Cleared.
    pub fn clear(self: &mut Cache) -> bool {
        if self.is_empty_flag {
            return false;
        }
        self.is_empty_flag = true;
        self.final_layout_entry = none;
        self.measure_entries = [none, none, none, none, none, none, none, none, none];
        self.recently_used_entries = 0;
        self.next_measure_entry = 0;
        return true;
    }

    /// Whether every entry is empty (is_empty).
    pub fn is_empty(self: &Cache) -> bool {
        match &self.final_layout_entry {
            some(_) => { return false; }
            none => { }
        }
        var index: usize = 0;
        while index < CACHE_SIZE : (index += 1) {
            match self.measure_entries[index] {
                some(_) => { return false; }
                none => { }
            }
        }
        return true;
    }
}
