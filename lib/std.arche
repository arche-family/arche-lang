/// std for a Linux host (docs/sprints.md S17): the capabilities a program
/// reaches only through std.System (spec/arche.md §1.3). Arche-0's surface
/// (spec/arche-0.md §11) keeps its signatures; Clock, Env, Proc, Net and
/// Rand are new. Output's buffers and the file reads are the runtime's
/// (compiler/runtime/rt.c); the rest are system calls from std.linux.
import alloc;
import core;
import core.mem;
import core.utf8;
import std.linux;

/// What main is given: every capability the program has. Its layout is the
/// runtime's (docs/abi.md).
pub type System = struct {
    pub fs: Fs,
    pub stdout: Output,
    pub stderr: Output,
    pub args: Args,
    pub alloc: alloc.Allocator,
    pub clock: Clock,
    pub env: Env,
    pub proc: Proc,
    pub net: Net,
    pub rand: Rand,
    pub stdin: Input,
}

/// The system this std is for (spec/arche.md §10.3): a program that must
/// tell them apart, such as a test runner, asks for this.
pub const SYSTEM: str = "linux";

/// Arche-0's errors of reading and writing files (spec/arche-0.md §11).
pub type IoError = error { NotFound, AccessDenied, IsDirectory, InvalidUtf8, IoFailed }

/// The errors of the other file operations.
pub type FsError = error { NotFound, AccessDenied, IsDirectory, IoFailed, AlreadyExists, NotEmpty }

/// The runtime's functions std calls (compiler/runtime/rt.c).
extern "c" fn a0rt_write(output: *i64, p: *u8, n: u64);
extern "c" fn a0rt_write_byte(output: *i64, c: u8);
extern "c" fn a0rt_write_u64(output: *i64, v: u64);
extern "c" fn a0rt_write_i64(output: *i64, v: i64);
extern "c" fn a0rt_write_f64(output: *i64, x: f64);
extern "c" fn a0rt_write_f32(output: *i64, x: f32);
extern "c" fn a0rt_fs_read(path: *u8, path_len: u64, out: *mut u8, utf8: bool) -> u16;
extern "c" fn a0rt_write_file(fs: *u8, path: *u8, path_len: u64, data: *u8, len: u64) -> u16;
extern "c" fn a0rt_write_executable(fs: *u8, path: *u8, path_len: u64, data: *u8, len: u64) -> u16;
extern "c" fn a0rt_flush_all();
extern "c" fn a0rt_io_wait(fd: i64, events: u32);
extern "c" fn a0rt_exit(status: u8) -> noreturn;

/// The runtime's error numbers, 1 to 5 in IoError's order.
fn io_error(code: u16) -> IoError {
    match code {
        1 => { return IoError.NotFound; }
        2 => { return IoError.AccessDenied; }
        3 => { return IoError.IsDirectory; }
        4 => { return IoError.InvalidUtf8; }
        _ => { return IoError.IoFailed; }
    }
}

/// An errno as an FsError.
fn errno_error(e: i64) -> FsError {
    if e == linux.ENOENT { return FsError.NotFound; }
    if e == linux.EACCES { return FsError.AccessDenied; }
    if e == linux.EISDIR { return FsError.IsDirectory; }
    if e == linux.EEXIST { return FsError.AlreadyExists; }
    if e == linux.ENOTEMPTY { return FsError.NotEmpty; }
    return FsError.IoFailed;
}

// ---- Output -----------------------------------------------------------------------

/// stdout or stderr, buffered; flushed when the program exits.
pub type Output = struct {
    fd: i64,
    unique: core.Unique,

    fn raw(self: &Output) -> *i64 {
        unsafe {
            // SAFETY: the runtime reads only fd, the first field.
            return self as *Output as *i64;
        }
    }

    pub fn write(self: &mut Output, text: str) {
        unsafe {
            // SAFETY: text's bytes, read as long as the call lasts.
            a0rt_write(self.raw(), mem.str_data(text), text.len() as u64);
        }
    }

    pub fn write_byte(self: &mut Output, byte: u8) {
        unsafe {
            // SAFETY: as write.
            a0rt_write_byte(self.raw(), byte);
        }
    }

    pub fn write_u64(self: &mut Output, n: u64) {
        unsafe {
            // SAFETY: as write.
            a0rt_write_u64(self.raw(), n);
        }
    }

    pub fn write_i64(self: &mut Output, n: i64) {
        unsafe {
            // SAFETY: as write.
            a0rt_write_i64(self.raw(), n);
        }
    }

    pub fn write_f64(self: &mut Output, x: f64) {
        unsafe {
            // SAFETY: as write.
            a0rt_write_f64(self.raw(), x);
        }
    }

    pub fn write_f32(self: &mut Output, x: f32) {
        unsafe {
            // SAFETY: as write.
            a0rt_write_f32(self.raw(), x);
        }
    }

    /// Writes out what is buffered now, for both outputs.
    pub fn flush(self: &mut Output) {
        unsafe {
            // SAFETY: the runtime's buffers only.
            a0rt_flush_all();
        }
    }
}

// ---- Args -------------------------------------------------------------------------

/// The program's arguments, its own path first.
pub type Args = struct {
    items: *str,
    count: usize,
    unique: core.Unique,

    pub fn len(self: &Args) -> usize {
        return self.count;
    }

    pub fn get(self: &Args, i: usize) -> str {
        if i >= self.count {
            panic("argument index out of range");
        }
        unsafe {
            // SAFETY: the runtime made count of them, valid UTF-8, for the
            // whole run.
            return self.items.add(i).*;
        }
    }
}

// ---- Fs ---------------------------------------------------------------------------

/// The file system, from the directory the program started in.
pub type Fs = struct {
    dir: i64,
    unique: core.Unique,

    pub fn read_file(self: &Fs, path: str, a: alloc.Allocator) -> IoError!alloc.String {
        var text = alloc.String.init(a);
        var code: u16 = 0;
        unsafe {
            // SAFETY: the runtime fills text as a String, with its allocator.
            code = a0rt_fs_read(mem.str_data(path), path.len() as u64, &mut text as *mut alloc.String as *mut u8, true);
        }
        if code != 0 {
            return io_error(code);
        }
        return text;
    }

    pub fn read_bytes(self: &Fs, path: str, a: alloc.Allocator) -> IoError!alloc.List(u8) {
        var bytes = alloc.List(u8).init(a);
        var code: u16 = 0;
        unsafe {
            // SAFETY: as read_file, for a List(u8).
            code = a0rt_fs_read(mem.str_data(path), path.len() as u64, &mut bytes as *mut alloc.List(u8) as *mut u8, false);
        }
        if code != 0 {
            return io_error(code);
        }
        return bytes;
    }

    /// Writes bytes, which need not be text, to a file, made or emptied.
    pub fn write_bytes(self: &Fs, path: str, data: []u8) -> IoError!void {
        var code: u16 = 0;
        unsafe {
            // SAFETY: both are read during the call only.
            let fs = mem.null(u8) as *u8;
            code = a0rt_write_file(fs: fs, path: mem.str_data(path), path_len: path.len() as u64, data: mem.slice_data(u8, data) as *u8, len: data.len() as u64);
        }
        if code != 0 {
            return io_error(code);
        }
    }

    /// Writes a program: a new file that the system can run.
    pub fn write_executable(self: &Fs, path: str, data: []u8) -> IoError!void {
        var code: u16 = 0;
        unsafe {
            // SAFETY: both are read during the call only.
            let fs = mem.null(u8) as *u8;
            code = a0rt_write_executable(fs: fs, path: mem.str_data(path), path_len: path.len() as u64, data: mem.slice_data(u8, data) as *u8, len: data.len() as u64);
        }
        if code != 0 {
            return io_error(code);
        }
    }

    pub fn write_file(self: &Fs, path: str, data: str) -> IoError!void {
        var code: u16 = 0;
        unsafe {
            // SAFETY: both texts are read during the call only.
            let fs = mem.null(u8) as *u8;
            code = a0rt_write_file(fs: fs, path: mem.str_data(path), path_len: path.len() as u64, data: mem.str_data(data), len: data.len() as u64);
        }
        if code != 0 {
            return io_error(code);
        }
    }

    /// The directory that relative paths start from.
    pub fn current_dir(self: &Fs, a: alloc.Allocator) -> FsError!alloc.String {
        var buf: [4096]u8 = [0; 4096];
        var n: i64 = 0;
        unsafe {
            // SAFETY: getcwd writes at most 4096 bytes, with a NUL, and returns
            // how many.
            n = linux.syscall(linux.GETCWD, [linux.arg(u8, &buf[0] as *u8), 4096, 0, 0, 0, 0]);
        }
        if linux.errno(n) != 0 {
            return errno_error(linux.errno(n));
        }
        if n < 1 or not utf8.valid(buf[0..(n - 1) as usize]) {
            return FsError.IoFailed;
        }
        var s = alloc.String.init(a);
        unsafe {
            // SAFETY: checked just now.
            s.push_str(mem.str_from(buf[0..(n - 1) as usize]));
        }
        return s;
    }

    /// A directory for files that need not outlive the program: TMPDIR
    /// when the environment names one, and /tmp otherwise, without a
    /// separator at its end. Windows has its own (lib/std-windows.arche),
    /// so a program that wants one is the same on both.
    pub fn temp_dir(self: &Fs, env: &Env, a: alloc.Allocator) -> FsError!alloc.String {
        let named = env.get("TMPDIR", a) orelse alloc.String.init(a);
        var text = named.view();
        if text.len() == 0 {
            text = "/tmp";
        }
        let b = text.bytes();
        var n = b.len();
        while n > 1 and b[n - 1] == '/' : (n -= 1) {
        }
        var s = alloc.String.init(a);
        unsafe {
            // SAFETY: the separators dropped at the end are ASCII, so what
            // is left is still UTF-8.
            s.push_str(mem.str_from(b[0..n]));
        }
        return s;
    }

    /// Whether something is at path.
    pub fn exists(self: &Fs, path: str) -> bool {
        var buf: [4096]u8 = [0; 4096];
        if not linux.c_path(path, buf[0..4096]) {
            return false;
        }
        var stat: [144]u8 = [0; 144];
        var r: i64 = 0;
        unsafe {
            // SAFETY: newfstatat writes a struct stat, 144 bytes on x86-64.
            r = linux.syscall(linux.NEWFSTATAT, [self.dir, linux.arg(u8, &buf[0] as *u8), linux.arg(u8, &stat[0] as *u8), 0, 0, 0]);
        }
        return r == 0;
    }

    /// Waits until what was written to the file at path, or the names in the
    /// directory at path, is on the disk and not only in the system's memory:
    /// what a power cut leaves. A file written whole and renamed into place is
    /// kept once both the file and its directory are synced.
    pub fn sync(self: &Fs, path: str) -> FsError!void {
        var buf: [4096]u8 = [0; 4096];
        if not linux.c_path(path, buf[0..4096]) {
            return FsError.NotFound;
        }
        var fd: i64 = 0;
        unsafe {
            // SAFETY: the path is NUL-terminated in buf. O_RDONLY | O_CLOEXEC:
            // a directory opens so too.
            fd = linux.syscall(linux.OPENAT, [self.dir, linux.arg(u8, &buf[0] as *u8), 0x80000, 0, 0, 0]);
        }
        if linux.errno(fd) != 0 {
            return errno_error(linux.errno(fd));
        }
        var r: i64 = 0;
        unsafe {
            // SAFETY: fd is the file just opened, closed here.
            r = linux.syscall(linux.FSYNC, [fd, 0, 0, 0, 0, 0]);
            _ = linux.syscall(linux.CLOSE, [fd, 0, 0, 0, 0, 0]);
        }
        if linux.errno(r) != 0 {
            return errno_error(linux.errno(r));
        }
    }

    pub fn make_dir(self: &Fs, path: str) -> FsError!void {
        try self.make_dir_with(path, mode: 0x1ED);
    }

    /// As make_dir, but only this user can enter it (0700).
    pub fn make_private_dir(self: &Fs, path: str) -> FsError!void {
        try self.make_dir_with(path, mode: 0x1C0);
    }

    fn make_dir_with(self: &Fs, path: str, mode: i64) -> FsError!void {
        var buf: [4096]u8 = [0; 4096];
        if not linux.c_path(path, buf[0..4096]) {
            return FsError.NotFound;
        }
        var r: i64 = 0;
        unsafe {
            // SAFETY: the path is NUL-terminated in buf.
            r = linux.syscall(linux.MKDIRAT, [self.dir, linux.arg(u8, &buf[0] as *u8), mode, 0, 0, 0]);
        }
        if linux.errno(r) != 0 {
            return errno_error(linux.errno(r));
        }
    }

    /// Removes a file, or an empty directory.
    pub fn remove(self: &Fs, path: str) -> FsError!void {
        var buf: [4096]u8 = [0; 4096];
        if not linux.c_path(path, buf[0..4096]) {
            return FsError.NotFound;
        }
        var r: i64 = 0;
        unsafe {
            // SAFETY: the path is NUL-terminated in buf.
            r = linux.syscall(linux.UNLINKAT, [self.dir, linux.arg(u8, &buf[0] as *u8), 0, 0, 0, 0]);
            if linux.errno(r) == linux.EISDIR {
                r = linux.syscall(linux.UNLINKAT, [self.dir, linux.arg(u8, &buf[0] as *u8), 0x200, 0, 0, 0]);
            }
        }
        if linux.errno(r) != 0 {
            return errno_error(linux.errno(r));
        }
    }

    pub fn rename(self: &Fs, from: str, to: str) -> FsError!void {
        var a: [4096]u8 = [0; 4096];
        var b: [4096]u8 = [0; 4096];
        if not linux.c_path(from, a[0..4096]) or not linux.c_path(to, b[0..4096]) {
            return FsError.NotFound;
        }
        var r: i64 = 0;
        unsafe {
            // SAFETY: both paths are NUL-terminated.
            r = linux.rename_at(dir_from: self.dir, from: linux.arg(u8, &a[0] as *u8), dir_to: self.dir, to: linux.arg(u8, &b[0] as *u8));
        }
        if linux.errno(r) != 0 {
            return errno_error(linux.errno(r));
        }
    }

    /// The names in a directory, without . and .., sorted by byte order so
    /// the result is the same on every run (docs/plan.md, determinism).
    pub fn list(self: &Fs, path: str, a: alloc.Allocator) -> FsError!alloc.List(alloc.String) {
        var buf: [4096]u8 = [0; 4096];
        if not linux.c_path(path, buf[0..4096]) {
            return FsError.NotFound;
        }
        var fd: i64 = 0;
        unsafe {
            // SAFETY: O_RDONLY | O_DIRECTORY | O_CLOEXEC.
            fd = linux.syscall(linux.OPENAT, [self.dir, linux.arg(u8, &buf[0] as *u8), 0x80000 | linux.O_DIRECTORY, 0, 0, 0]);
        }
        if linux.errno(fd) != 0 {
            return errno_error(linux.errno(fd));
        }
        var names = alloc.List(alloc.String).init(a);
        var entries: [4096]u8 = [0; 4096];
        while true {
            var n: i64 = 0;
            unsafe {
                // SAFETY: getdents64 writes up to 4096 bytes of entries.
                n = linux.syscall(linux.GETDENTS64, [fd, linux.arg(u8, &entries[0] as *u8), 4096, 0, 0, 0]);
            }
            if n <= 0 {
                break;
            }
            // linux_dirent64: ino u64, off i64, reclen u16, type u8, name.
            var at: usize = 0;
            while at < n as usize {
                let reclen = (entries[at + 16] as usize) | ((entries[at + 17] as usize) << 8);
                var end = at + 19;
                while entries[end] != 0 : (end += 1) {
                }
                let name = entries[at + 19..end];
                let dot = name.len() == 1 and name[0] == '.';
                let dotdot = name.len() == 2 and name[0] == '.' and name[1] == '.';
                if not dot and not dotdot {
                    var s = alloc.String.init(a);
                    unsafe {
                        // SAFETY: file names on Linux are bytes; those that
                        // are not UTF-8 are left out below.
                        if utf8.valid(name) {
                            s.push_str(mem.str_from(name));
                        }
                    }
                    if s.len() > 0 {
                        names.push(s);
                    }
                }
                at += reclen;
            }
        }
        unsafe {
            // SAFETY: fd is the directory opened above.
            _ = linux.syscall(linux.CLOSE, [fd, 0, 0, 0, 0, 0]);
        }
        sort_names(&mut names);
        return names;
    }
}

fn bytes_less(a: []u8, than: []u8) -> bool {
    var i: usize = 0;
    while i < a.len() and i < than.len() : (i += 1) {
        if a[i] != than[i] {
            return a[i] < than[i];
        }
    }
    return a.len() < than.len();
}

/// Insertion sort by byte order: directories are small.
fn sort_names(names: &mut alloc.List(alloc.String)) {
    let items = names.items_mut();
    var i: usize = 1;
    while i < items.len() : (i += 1) {
        var j = i;
        while j > 0 and bytes_less(a: items[j].view().bytes(), than: items[j - 1].view().bytes()) : (j -= 1) {
            unsafe {
                // SAFETY: j and j - 1 are inside items; the two values
                // trade places, so each is still owned once.
                let base = mem.slice_data(alloc.String, items) as *mut alloc.String;
                let t = base.add(j).*;
                base.add(j).* = base.add(j - 1).*;
                base.add(j - 1).* = t;
            }
        }
    }
}

// ---- Clock ------------------------------------------------------------------------

type Timespec = struct {
    sec: i64,
    nsec: i64,
}

/// Time: a clock that only goes forward, the wall clock, and sleeping.
pub type Clock = struct {
    unique: core.Unique,

    fn read(self: &Clock, id: i64) -> u64 {
        var ts = Timespec { sec: 0, nsec: 0 };
        unsafe {
            // SAFETY: clock_gettime writes one timespec.
            _ = linux.syscall(linux.CLOCK_GETTIME, [id, linux.arg(Timespec, &ts as *Timespec), 0, 0, 0, 0]);
        }
        return (ts.sec as u64) * 1000000000 + ts.nsec as u64;
    }

    /// Nanoseconds since some moment in the past; never goes back.
    pub fn monotonic_ns(self: &Clock) -> u64 {
        return self.read(1);
    }

    /// Nanoseconds since 1970-01-01 00:00 UTC.
    pub fn unix_ns(self: &Clock) -> u64 {
        return self.read(0);
    }

    pub fn sleep_ns(self: &Clock, ns: u64) {
        var ts = Timespec { sec: (ns / 1000000000) as i64, nsec: (ns % 1000000000) as i64 };
        unsafe {
            // SAFETY: nanosleep reads ts and writes what is left into it.
            while linux.errno(linux.syscall(linux.NANOSLEEP, [linux.arg(Timespec, &ts as *Timespec), linux.arg(Timespec, &ts as *Timespec), 0, 0, 0, 0])) == linux.EINTR {
            }
        }
    }
}

// ---- Env --------------------------------------------------------------------------

/// The environment variables the program started with.
pub type Env = struct {
    vars: **u8,
    unique: core.Unique,

    /// The value of the variable name, copied.
    pub fn get(self: &Env, name: str, a: alloc.Allocator) -> ?alloc.String {
        let want = name.bytes();
        var value = alloc.List(u8).init(a);
        var found = false;
        unsafe {
            // SAFETY: envp is an array of NUL-terminated entries that ends
            // with a null pointer; an entry is read only up to its NUL.
            var i: usize = 0;
            while not found : (i += 1) {
                let entry = self.vars.add(i).*;
                if entry.addr() == 0 {
                    break;
                }
                var k: usize = 0;
                while k < want.len() and entry.add(k).* == want[k] : (k += 1) {
                }
                if k == want.len() and entry.add(k).* == '=' {
                    var j = k + 1;
                    while entry.add(j).* != 0 : (j += 1) {
                        value.push(entry.add(j).*);
                    }
                    found = true;
                }
            }
        }
        if not found {
            return none;
        }
        var s = alloc.String.init(a);
        if utf8.valid(value.items()) {
            unsafe {
                // SAFETY: checked just now.
                s.push_str(mem.str_from(value.items()));
            }
        }
        return s;
    }
}

// ---- Proc -------------------------------------------------------------------------

pub type ProcError = error { NotFound, AccessDenied, Killed, ProcFailed }

/// What the system does to this process when it writes to a pipe nobody
/// reads: 0 ends it, as is the default, and 1 makes the write fail.
fn set_broken_pipe(action: u64) {
    // struct sigaction: the action, flags, a restorer that only a handler
    // needs, and a mask.
    var act: [4]u64 = [0; 4];
    act[0] = action;
    unsafe {
        // SAFETY: the kernel reads act during the call only, and takes a
        // mask of 8 bytes.
        _ = linux.syscall(linux.RT_SIGACTION, [linux.SIGPIPE, linux.arg(u64, &act[0] as *u64), 0, 8, 0, 0]);
    }
}

/// This process, and the ones it starts.
pub type Proc = struct {
    unique: core.Unique,

    /// A write to a pipe nobody reads fails from now on, and what it wrote
    /// is lost, instead of ending the program: for a server whose client may
    /// go away while it answers. The programs it starts are not affected.
    pub fn ignore_broken_pipe(self: &Proc) {
        set_broken_pipe(0x1);
    }

    pub fn pid(self: &Proc) -> u32 {
        unsafe {
            // SAFETY: getpid reads nothing.
            return linux.syscall(linux.GETPID, [0, 0, 0, 0, 0, 0]) as u32;
        }
    }

    /// How many processors the program may run on.
    pub fn cpu_count(self: &Proc) -> u32 {
        var mask: [16]u64 = [0; 16];
        var r: i64 = 0;
        unsafe {
            // SAFETY: sched_getaffinity writes at most 128 bytes of mask.
            r = linux.syscall(linux.SCHED_GETAFFINITY, [0, 128, linux.arg(u64, &mask[0] as *u64), 0, 0, 0]);
        }
        if r <= 0 {
            return 1;
        }
        var n: u32 = 0;
        for word in mask[0..16] {
            var w = word.*;
            while w != 0 {
                n += (w & 1) as u32;
                w = w >> 1;
            }
        }
        if n == 0 {
            return 1;
        }
        return n;
    }

    /// Makes the program count processes in all, count - 1 copies of this
    /// one from here on, each with what it has open, a listener too, so that
    /// they accept connections side by side: a server's worker per
    /// processor. Says which one this is, 0 for the first; a copy ends when
    /// the first does. Call it before starting tasks.
    pub fn workers(self: &Proc, count: u32) -> u32 {
        var i: u32 = 1;
        while i < count : (i += 1) {
            var r: i64 = 0;
            unsafe {
                // SAFETY: no task runs yet, so the copy has one thread, as
                // this does.
                r = linux.fork();
            }
            if r == 0 {
                unsafe {
                    // SAFETY: PR_SET_PDEATHSIG (1) with SIGTERM (15): the
                    // copy ends with the process that made it.
                    _ = linux.syscall(linux.PRCTL, [1, 15, 0, 0, 0, 0]);
                }
                return i;
            }
        }
        return 0;
    }

    /// Ends the program with this status, after writing out stdout and
    /// stderr.
    pub fn exit(self: &Proc, status: u8) -> noreturn {
        unsafe {
            // SAFETY: the runtime flushes and exits.
            a0rt_exit(status);
        }
    }

    /// Runs argv[0], a path, with argv and this environment, and waits for
    /// it: its exit status.
    pub fn run(self: &Proc, argv: &alloc.List(alloc.String), env: &Env, a: alloc.Allocator) -> ProcError!u8 {
        if argv.len() == 0 {
            return ProcError.NotFound;
        }
        // NUL-terminated copies, and the array of pointers to them.
        var texts = alloc.List(alloc.List(u8)).init(a);
        for s in argv.items() {
            var t = alloc.List(u8).init(a);
            for b in s.view().bytes() {
                t.push(b.*);
            }
            t.push(0);
            texts.push(t);
        }
        var ptrs = alloc.List(u64).init(a);
        for t in texts.items() {
            unsafe {
                // SAFETY: each copy lives until the call ends.
                ptrs.push(mem.slice_data(u8, t.items()).addr() as u64);
            }
        }
        ptrs.push(0);
        var pid: i64 = 0;
        unsafe {
            // SAFETY: what is buffered is written once, by the parent.
            a0rt_flush_all();
            pid = linux.fork();
        }
        if linux.errno(pid) != 0 {
            return ProcError.ProcFailed;
        }
        if pid == 0 {
            // What this program does about a broken pipe is its own.
            set_broken_pipe(0);
            unsafe {
                // SAFETY: the child: exec, or end without the parent's buffers.
                let path = mem.slice_data(u8, texts[0].items());
                let r = linux.syscall(linux.EXECVE, [linux.arg(u8, path), linux.arg(u64, mem.slice_data(u64, ptrs.items())), env.vars.addr() as% i64, 0, 0, 0]);
                var code: i64 = 126;
                if linux.errno(r) == linux.ENOENT {
                    code = 127;
                }
                _ = linux.syscall(linux.EXIT, [code, 0, 0, 0, 0, 0]);
            }
        }
        var status: i32 = 0;
        unsafe {
            // SAFETY: wait4 writes one int.
            _ = linux.syscall(linux.WAIT4, [pid, linux.arg(i32, &status as *i32), 0, 0, 0, 0]);
        }
        if (status & 0x7F) != 0 {
            return ProcError.Killed;
        }
        let code = ((status >> 8) & 0xFF) as u8;
        if code == 127 {
            return ProcError.NotFound;
        }
        return code;
    }

    /// Starts cmd with stdin from /dev/null, in a process group of its own,
    /// and waits for it, or until its time is up; then the whole group is
    /// killed, so nothing it started outlives it. A program without a '/'
    /// in its name is looked for in PATH.
    pub fn spawn(self: &Proc, cmd: &Command, env: &Env, clock: &Clock, a: alloc.Allocator) -> ProcError!Ending {
        if cmd.argv.len() == 0 {
            return ProcError.NotFound;
        }
        // The candidates for argv[0]: itself, or each directory of PATH.
        var programs = alloc.List(alloc.List(u8)).init(a);
        let name = cmd.argv[0].view();
        var has_slash = false;
        for c in name.bytes() {
            if c.* == '/' {
                has_slash = true;
            }
        }
        if has_slash {
            programs.push(c_string(name, a));
        } else {
            let path = env.get("PATH", a) orelse alloc.String.init(a);
            let pb = path.view().bytes();
            var start: usize = 0;
            var i: usize = 0;
            while i <= pb.len() : (i += 1) {
                if i == pb.len() or pb[i] == ':' {
                    var full = alloc.String.init(a);
                    if i > start {
                        unsafe {
                            // SAFETY: a part of a str, split at an ASCII ':'.
                            full.push_str(mem.str_from(pb[start..i]));
                        }
                        full.push_str("/");
                    }
                    full.push_str(name);
                    programs.push(c_string(full.view(), a));
                    start = i + 1;
                }
            }
        }
        var texts = alloc.List(alloc.List(u8)).init(a);
        for s in cmd.argv.items() {
            texts.push(c_string(s.view(), a));
        }
        var ptrs = alloc.List(u64).init(a);
        for t in texts.items() {
            unsafe {
                // SAFETY: each copy lives until the call ends.
                ptrs.push(mem.slice_data(u8, t.items()).addr() as u64);
            }
        }
        ptrs.push(0);
        let dir = c_string(cmd.dir.view(), a);
        let out_file = c_string(cmd.stdout_path.view(), a);
        let err_file = c_string(cmd.stderr_path.view(), a);
        let null = c_string("/dev/null", a);
        var pid: i64 = 0;
        unsafe {
            // SAFETY: what is buffered is written once, by the parent.
            a0rt_flush_all();
            pid = linux.fork();
        }
        if linux.errno(pid) != 0 {
            return ProcError.ProcFailed;
        }
        if pid == 0 {
            // What this program does about a broken pipe is its own.
            set_broken_pipe(0);
            unsafe {
                // SAFETY: the child sets itself up and execs, or ends
                // without the parent's buffers.
                _ = linux.syscall(linux.SETPGID, [0, 0, 0, 0, 0, 0]);
                let f = linux.syscall(linux.OPENAT, [linux.AT_FDCWD, linux.arg(u8, mem.slice_data(u8, null.items())), 0, 0, 0, 0]);
                if linux.errno(f) == 0 {
                    _ = linux.dup2(from: f, to: 0);
                }
            }
            if cmd.stdout_path.len() > 0 {
                redirect(&out_file, fd: 1);
            }
            if cmd.stderr_path.len() > 0 {
                if cmd.stderr_path.view().eq(cmd.stdout_path.view()) {
                    unsafe {
                        // SAFETY: both go to the file opened as stdout.
                        _ = linux.dup2(from: 1, to: 2);
                    }
                } else {
                    redirect(&err_file, fd: 2);
                }
            }
            unsafe {
                // SAFETY: as above.
                if cmd.dir.len() > 0 {
                    let r = linux.syscall(linux.CHDIR, [linux.arg(u8, mem.slice_data(u8, dir.items())), 0, 0, 0, 0, 0]);
                    if linux.errno(r) != 0 {
                        _ = linux.syscall(linux.EXIT, [126, 0, 0, 0, 0, 0]);
                    }
                }
                var code: i64 = 127;
                for p in programs.items() {
                    let r = linux.syscall(linux.EXECVE, [linux.arg(u8, mem.slice_data(u8, p.items())), linux.arg(u64, mem.slice_data(u64, ptrs.items())), env.vars.addr() as% i64, 0, 0, 0]);
                    if linux.errno(r) != linux.ENOENT {
                        code = 126;
                    }
                }
                _ = linux.syscall(linux.EXIT, [code, 0, 0, 0, 0, 0]);
            }
        }
        unsafe {
            // SAFETY: the child's group, set from both sides so neither
            // waits for the other.
            _ = linux.syscall(linux.SETPGID, [pid, pid, 0, 0, 0, 0]);
        }
        // Waits with WNOWAIT, which leaves the child a zombie: its group
        // id stays reserved until the group is killed below.
        let start = clock.monotonic_ns();
        var timed_out = false;
        while true {
            var info: [128]u8 = [0; 128];
            var r: i64 = 0;
            unsafe {
                // SAFETY: waitid writes a siginfo_t, 128 bytes.
                r = linux.syscall(linux.WAITID, [1, pid, linux.arg(u8, &info[0] as *u8), 0x1000004 | 1, 0, 0]);
            }
            let child = (info[16] as i64) | ((info[17] as i64) << 8) | ((info[18] as i64) << 16) | ((info[19] as i64) << 24);
            if r == 0 and child == pid {
                break;
            }
            if cmd.timeout_ms > 0 and clock.monotonic_ns() - start >= cmd.timeout_ms * 1000000 {
                timed_out = true;
                break;
            }
            clock.sleep_ns(5000000);
        }
        var status: i32 = 0;
        unsafe {
            // SAFETY: the group the child made; then wait4 writes one int.
            _ = linux.syscall(linux.KILL, [-pid, 9, 0, 0, 0, 0]);
            var w: i64 = -linux.EINTR;
            while linux.errno(w) == linux.EINTR {
                w = linux.syscall(linux.WAIT4, [pid, linux.arg(i32, &status as *i32), 0, 0, 0, 0]);
            }
        }
        if timed_out {
            return Ending.TimedOut;
        }
        if (status & 0x7F) != 0 {
            return Ending.Signaled { signal: (status & 0x7F) as u8 };
        }
        return Ending.Exited { status: ((status >> 8) & 0xFF) as u8 };
    }
}

/// A program to start: its arguments, the directory it runs in, and where
/// its output goes (Proc.spawn).
pub type Command = struct {
    pub argv: alloc.List(alloc.String),
    /// The directory to run in; empty for this program's.
    pub dir: alloc.String,
    /// Files for its stdout and stderr, made or emptied; empty to share
    /// this program's. The same path for both puts them in one file.
    pub stdout_path: alloc.String,
    pub stderr_path: alloc.String,
    /// How long it may run, in milliseconds; 0 for as long as it takes.
    pub timeout_ms: u64,

    pub fn init(a: alloc.Allocator) -> Command {
        return Command {
            argv: alloc.List(alloc.String).init(a),
            dir: alloc.String.init(a),
            stdout_path: alloc.String.init(a),
            stderr_path: alloc.String.init(a),
            timeout_ms: 0,
        };
    }

    /// Adds an argument; the first is the program.
    pub fn arg(self: &mut Command, text: str, a: alloc.Allocator) {
        var s = alloc.String.init(a);
        s.push_str(text);
        self.argv.push(s);
    }
}

/// How a started program ended.
pub type Ending = enum {
    Exited { status: u8 },
    Signaled { signal: u8 },
    TimedOut,
}

fn c_string(text: str, a: alloc.Allocator) -> alloc.List(u8) {
    var t = alloc.List(u8).init(a);
    for b in text.bytes() {
        t.push(b.*);
    }
    t.push(0);
    return t;
}

/// In a child that has forked: opens path for output onto fd, or ends.
fn redirect(path: &alloc.List(u8), fd: i64) {
    unsafe {
        // SAFETY: path is NUL-terminated; O_WRONLY | O_CREAT | O_TRUNC, 0644.
        let f = linux.syscall(linux.OPENAT, [linux.AT_FDCWD, linux.arg(u8, mem.slice_data(u8, path.items())), 0x241, 0x1A4, 0, 0]);
        if linux.errno(f) != 0 {
            _ = linux.syscall(linux.EXIT, [126, 0, 0, 0, 0, 0]);
        }
        _ = linux.dup2(from: f, to: fd);
    }
}

// ---- Rand -------------------------------------------------------------------------

/// Randomness from the kernel. For repeatable randomness, use a seeded
/// generator: core.rand.
pub type Rand = struct {
    unique: core.Unique,

    pub fn fill(self: &mut Rand, into: []mut u8) {
        var done: usize = 0;
        while done < into.len() {
            var r: i64 = 0;
            unsafe {
                // SAFETY: getrandom writes at most the bytes left in into.
                r = linux.syscall(linux.GETRANDOM, [linux.arg(u8, mem.slice_data(u8, into) as *u8) + done as i64, (into.len() - done) as i64, 0, 0, 0, 0]);
            }
            if r > 0 {
                done += r as usize;
            }
        }
    }

    pub fn next_u64(self: &mut Rand) -> u64 {
        var b: [8]u8 = [0; 8];
        self.fill(b[0..8]);
        var v: u64 = 0;
        var i: usize = 0;
        while i < 8 : (i += 1) {
            v = (v << 8) | b[i] as u64;
        }
        return v;
    }
}

// ---- Net --------------------------------------------------------------------------

pub type NetError = error { Refused, AddressInUse, NetFailed }

/// An IPv4 address and port.
pub type Address = struct {
    pub ip: [4]u8,
    pub port: u16,
}

/// struct sockaddr_in: the port in network byte order.
type SockAddr = struct {
    family: u16,
    port: u16,
    ip: [4]u8,
    zero: u64,
}

fn sock_addr(at: Address) -> SockAddr {
    return SockAddr { family: 2, port: (at.port >> 8) | (at.port << 8), ip: at.ip, zero: 0 };
}

fn net_error(e: i64) -> NetError {
    if e == linux.ECONNREFUSED { return NetError.Refused; }
    if e == linux.EADDRINUSE { return NetError.AddressInUse; }
    return NetError.NetFailed;
}

/// poll(2)'s events: the socket can be read, or written.
const POLLIN: u32 = 1;
const POLLOUT: u32 = 4;

/// Waits until fd is ready; other tasks run meanwhile (rt.c).
fn io_wait(fd: i64, events: u32) {
    unsafe {
        // SAFETY: the runtime only polls fd.
        a0rt_io_wait(fd, events);
    }
}

/// What the program is given to read: file descriptor 0. A task that waits
/// for it lets the others run.
pub type Input = struct {
    unique: core.Unique,

    /// Up to into.len() bytes; 0 at the end of the input.
    pub fn read(self: &mut Input, into: []mut u8) -> IoError!usize {
        io_wait(0, events: POLLIN);
        var r: i64 = -linux.EINTR;
        while linux.errno(r) == linux.EINTR {
            unsafe {
                // SAFETY: read writes at most into.len() bytes.
                r = linux.syscall(linux.READ, [0, linux.arg(u8, mem.slice_data(u8, into) as *u8), into.len() as i64, 0, 0, 0]);
            }
        }
        if linux.errno(r) != 0 {
            return IoError.IoFailed;
        }
        return r as usize;
    }

    /// Whether a read would not wait, after waiting at most this long for
    /// it to be so. The end of the input counts: the read gives 0. Nothing
    /// else runs meanwhile, unlike in read.
    pub fn ready(self: &Input, timeout_ms: u32) -> bool {
        // struct pollfd: fd 0, POLLIN in the events' low byte.
        var fds: [8]u8 = [0, 0, 0, 0, 1, 0, 0, 0];
        var r: i64 = -linux.EINTR;
        while linux.errno(r) == linux.EINTR {
            unsafe {
                // SAFETY: poll reads one pollfd and writes its revents.
                r = linux.poll(fds: linux.arg(u8, &fds[0] as *u8), count: 1, timeout_ms: timeout_ms as i64);
            }
        }
        return r > 0;
    }
}

/// TCP over IPv4. Sockets do not block the program: a task that waits for
/// one lets the others run.
pub type Net = struct {
    unique: core.Unique,

    pub fn connect(self: &Net, to: Address) -> NetError!Socket {
        var sa = sock_addr(to);
        var fd: i64 = 0;
        var r: i64 = 0;
        unsafe {
            // SAFETY: AF_INET, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC;
            // sa is 16 bytes; SO_ERROR is one int.
            fd = linux.syscall(linux.SOCKET, [2, 0x80801, 0, 0, 0, 0]);
            if linux.errno(fd) != 0 {
                return net_error(linux.errno(fd));
            }
            r = linux.syscall(linux.CONNECT, [fd, linux.arg(SockAddr, &sa as *SockAddr), 16, 0, 0, 0]);
            if linux.errno(r) == linux.EINPROGRESS {
                io_wait(fd, events: POLLOUT);
                var e: i32 = 0;
                var len: u32 = 4;
                r = linux.syscall(linux.GETSOCKOPT, [fd, 1, 4, linux.arg(i32, &e as *i32), linux.arg(u32, &len as *u32), 0]);
                if linux.errno(r) == 0 and e != 0 {
                    r = -(e as i64);
                }
            }
            if linux.errno(r) != 0 {
                _ = linux.syscall(linux.CLOSE, [fd, 0, 0, 0, 0, 0]);
                return net_error(linux.errno(r));
            }
        }
        return Socket { fd: fd, unique: core.Unique { } };
    }

    /// Listens at the address; port 0 lets the kernel choose one, which
    /// Listener.port says.
    pub fn listen(self: &Net, at: Address) -> NetError!Listener {
        var sa = sock_addr(at);
        var fd: i64 = 0;
        unsafe {
            // SAFETY: as connect; SO_REUSEADDR takes one int.
            fd = linux.syscall(linux.SOCKET, [2, 0x80801, 0, 0, 0, 0]);
            if linux.errno(fd) != 0 {
                return net_error(linux.errno(fd));
            }
            var one: i32 = 1;
            _ = linux.syscall(linux.SETSOCKOPT, [fd, 1, 2, linux.arg(i32, &one as *i32), 4, 0]);
            var r = linux.syscall(linux.BIND, [fd, linux.arg(SockAddr, &sa as *SockAddr), 16, 0, 0, 0]);
            if linux.errno(r) == 0 {
                r = linux.syscall(linux.LISTEN, [fd, 128, 0, 0, 0, 0]);
            }
            if linux.errno(r) != 0 {
                _ = linux.syscall(linux.CLOSE, [fd, 0, 0, 0, 0, 0]);
                return net_error(linux.errno(r));
            }
        }
        return Listener { fd: fd, unique: core.Unique { } };
    }
}

pub type Listener = struct {
    fd: i64,
    unique: core.Unique,

    pub fn port(self: &Listener) -> u16 {
        var sa = SockAddr { family: 0, port: 0, ip: [0, 0, 0, 0], zero: 0 };
        var len: u32 = 16;
        unsafe {
            // SAFETY: getsockname writes up to len bytes of sa.
            _ = linux.syscall(linux.GETSOCKNAME, [self.fd, linux.arg(SockAddr, &sa as *SockAddr), linux.arg(u32, &len as *u32), 0, 0, 0]);
        }
        return (sa.port >> 8) | (sa.port << 8);
    }

    pub fn accept(self: &Listener) -> NetError!Socket {
        var fd: i64 = -linux.EAGAIN;
        while linux.errno(fd) == linux.EAGAIN or linux.errno(fd) == linux.EINTR {
            unsafe {
                // SAFETY: the peer's address is not asked for; the new
                // socket is SOCK_NONBLOCK | SOCK_CLOEXEC too.
                fd = linux.syscall(linux.ACCEPT4, [self.fd, 0, 0, 0x80800, 0, 0]);
            }
            if linux.errno(fd) == linux.EAGAIN {
                io_wait(self.fd, events: POLLIN);
            }
        }
        if linux.errno(fd) != 0 {
            return net_error(linux.errno(fd));
        }
        return Socket { fd: fd, unique: core.Unique { } };
    }

    pub fn close(self: &mut Listener) {
        unsafe {
            // SAFETY: fd is this listener's.
            _ = linux.syscall(linux.CLOSE, [self.fd, 0, 0, 0, 0, 0]);
        }
        self.fd = -1;
    }
}

/// A TCP connection.
pub type Socket = struct {
    fd: i64,
    unique: core.Unique,

    /// Up to into.len() bytes; 0 when the peer has closed.
    pub fn read(self: &mut Socket, into: []mut u8) -> NetError!usize {
        var r: i64 = -linux.EAGAIN;
        while linux.errno(r) == linux.EAGAIN or linux.errno(r) == linux.EINTR {
            unsafe {
                // SAFETY: read writes at most into.len() bytes.
                r = linux.syscall(linux.READ, [self.fd, linux.arg(u8, mem.slice_data(u8, into) as *u8), into.len() as i64, 0, 0, 0]);
            }
            if linux.errno(r) == linux.EAGAIN {
                io_wait(self.fd, events: POLLIN);
            }
        }
        if linux.errno(r) != 0 {
            return net_error(linux.errno(r));
        }
        return r as usize;
    }

    /// All of data.
    pub fn write(self: &mut Socket, data: []u8) -> NetError!void {
        var done: usize = 0;
        while done < data.len() {
            var r: i64 = 0;
            unsafe {
                // SAFETY: send reads the bytes left in data. MSG_NOSIGNAL:
                // a peer that has gone is an error, not SIGPIPE.
                r = linux.syscall(linux.SENDTO, [self.fd, linux.arg(u8, mem.slice_data(u8, data)) + done as i64, (data.len() - done) as i64, 0x4000, 0, 0]);
            }
            if linux.errno(r) == linux.EAGAIN or linux.errno(r) == linux.EINTR {
                if linux.errno(r) == linux.EAGAIN {
                    io_wait(self.fd, events: POLLOUT);
                }
                continue;
            }
            if linux.errno(r) != 0 {
                return net_error(linux.errno(r));
            }
            done += r as usize;
        }
    }

    pub fn close(self: &mut Socket) {
        unsafe {
            // SAFETY: fd is this socket's.
            _ = linux.syscall(linux.CLOSE, [self.fd, 0, 0, 0, 0, 0]);
        }
        self.fd = -1;
    }
}
