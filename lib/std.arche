/// std for a Linux host (docs/sprints.md S17): the capabilities a program
/// reaches only through std.System (spec/arche.md §1.3). Arche-0's surface
/// (spec/arche-0.md §11) keeps its signatures; Clock, Env, Proc, Net and
/// Rand are new. Output's buffers and the file reads are the runtime's
/// (compiler/runtime/rt.c); the rest are system calls from std.linux.
import alloc;
import core;
import core.mem;
import core.utf8;
import std.linux;

/// What main is given: every capability the program has. Its layout is the
/// runtime's (docs/abi.md).
pub type System = struct {
    pub fs: Fs,
    pub stdout: Output,
    pub stderr: Output,
    pub args: Args,
    pub alloc: alloc.Allocator,
    pub clock: Clock,
    pub env: Env,
    pub proc: Proc,
    pub net: Net,
    pub rand: Rand,
}

/// Arche-0's errors of reading and writing files (spec/arche-0.md §11).
pub type IoError = error { NotFound, AccessDenied, IsDirectory, InvalidUtf8, IoFailed }

/// The errors of the other file operations.
pub type FsError = error { NotFound, AccessDenied, IsDirectory, IoFailed, AlreadyExists, NotEmpty }

/// The runtime's functions std calls (compiler/runtime/rt.c).
extern "c" fn a0rt_write(output: *i64, p: *u8, n: u64);
extern "c" fn a0rt_write_byte(output: *i64, c: u8);
extern "c" fn a0rt_write_u64(output: *i64, v: u64);
extern "c" fn a0rt_write_i64(output: *i64, v: i64);
extern "c" fn a0rt_write_f64(output: *i64, x: f64);
extern "c" fn a0rt_write_f32(output: *i64, x: f32);
extern "c" fn a0rt_fs_read(path: *u8, path_len: u64, out: *mut u8, utf8: bool) -> u16;
extern "c" fn a0rt_write_file(fs: *u8, path: *u8, path_len: u64, data: *u8, len: u64) -> u16;
extern "c" fn a0rt_flush_all();
extern "c" fn a0rt_io_wait(fd: i64, events: u32);
extern "c" fn a0rt_exit(status: u8) -> noreturn;

/// The runtime's error numbers, 1 to 5 in IoError's order.
fn io_error(code: u16) -> IoError {
    match code {
        1 => { return IoError.NotFound; }
        2 => { return IoError.AccessDenied; }
        3 => { return IoError.IsDirectory; }
        4 => { return IoError.InvalidUtf8; }
        _ => { return IoError.IoFailed; }
    }
}

/// An errno as an FsError.
fn errno_error(e: i64) -> FsError {
    if e == linux.ENOENT { return FsError.NotFound; }
    if e == linux.EACCES { return FsError.AccessDenied; }
    if e == linux.EISDIR { return FsError.IsDirectory; }
    if e == linux.EEXIST { return FsError.AlreadyExists; }
    if e == linux.ENOTEMPTY { return FsError.NotEmpty; }
    return FsError.IoFailed;
}

// ---- Output -----------------------------------------------------------------------

/// stdout or stderr, buffered; flushed when the program exits.
pub type Output = struct {
    fd: i64,
    unique: core.Unique,

    fn raw(self: &Output) -> *i64 {
        unsafe {
            // SAFETY: the runtime reads only fd, the first field.
            return self as *Output as *i64;
        }
    }

    pub fn write(self: &mut Output, text: str) {
        unsafe {
            // SAFETY: text's bytes, read as long as the call lasts.
            a0rt_write(self.raw(), mem.str_data(text), text.len() as u64);
        }
    }

    pub fn write_byte(self: &mut Output, byte: u8) {
        unsafe {
            // SAFETY: as write.
            a0rt_write_byte(self.raw(), byte);
        }
    }

    pub fn write_u64(self: &mut Output, n: u64) {
        unsafe {
            // SAFETY: as write.
            a0rt_write_u64(self.raw(), n);
        }
    }

    pub fn write_i64(self: &mut Output, n: i64) {
        unsafe {
            // SAFETY: as write.
            a0rt_write_i64(self.raw(), n);
        }
    }

    pub fn write_f64(self: &mut Output, x: f64) {
        unsafe {
            // SAFETY: as write.
            a0rt_write_f64(self.raw(), x);
        }
    }

    pub fn write_f32(self: &mut Output, x: f32) {
        unsafe {
            // SAFETY: as write.
            a0rt_write_f32(self.raw(), x);
        }
    }

    /// Writes out what is buffered now, for both outputs.
    pub fn flush(self: &mut Output) {
        unsafe {
            // SAFETY: the runtime's buffers only.
            a0rt_flush_all();
        }
    }
}

// ---- Args -------------------------------------------------------------------------

/// The program's arguments, its own path first.
pub type Args = struct {
    items: *str,
    count: usize,
    unique: core.Unique,

    pub fn len(self: &Args) -> usize {
        return self.count;
    }

    pub fn get(self: &Args, i: usize) -> str {
        if i >= self.count {
            panic("argument index out of range");
        }
        unsafe {
            // SAFETY: the runtime made count of them, valid UTF-8, for the
            // whole run.
            return self.items.add(i).*;
        }
    }
}

// ---- Fs ---------------------------------------------------------------------------

/// The file system, from the directory the program started in.
pub type Fs = struct {
    dir: i64,
    unique: core.Unique,

    pub fn read_file(self: &Fs, path: str, a: alloc.Allocator) -> IoError!alloc.String {
        var text = alloc.String.init(a);
        var code: u16 = 0;
        unsafe {
            // SAFETY: the runtime fills text as a String, with its allocator.
            code = a0rt_fs_read(mem.str_data(path), path.len() as u64, &mut text as *mut alloc.String as *mut u8, true);
        }
        if code != 0 {
            return io_error(code);
        }
        return text;
    }

    pub fn read_bytes(self: &Fs, path: str, a: alloc.Allocator) -> IoError!alloc.List(u8) {
        var bytes = alloc.List(u8).init(a);
        var code: u16 = 0;
        unsafe {
            // SAFETY: as read_file, for a List(u8).
            code = a0rt_fs_read(mem.str_data(path), path.len() as u64, &mut bytes as *mut alloc.List(u8) as *mut u8, false);
        }
        if code != 0 {
            return io_error(code);
        }
        return bytes;
    }

    pub fn write_file(self: &Fs, path: str, data: str) -> IoError!void {
        var code: u16 = 0;
        unsafe {
            // SAFETY: both texts are read during the call only.
            let fs = mem.null(u8) as *u8;
            code = a0rt_write_file(fs: fs, path: mem.str_data(path), path_len: path.len() as u64, data: mem.str_data(data), len: data.len() as u64);
        }
        if code != 0 {
            return io_error(code);
        }
    }

    /// Whether something is at path.
    pub fn exists(self: &Fs, path: str) -> bool {
        var buf: [4096]u8 = [0; 4096];
        if not linux.c_path(path, buf[0..4096]) {
            return false;
        }
        var stat: [144]u8 = [0; 144];
        var r: i64 = 0;
        unsafe {
            // SAFETY: newfstatat writes a struct stat, 144 bytes on x86-64.
            r = linux.syscall(linux.NEWFSTATAT, [self.dir, linux.arg(u8, &buf[0] as *u8), linux.arg(u8, &stat[0] as *u8), 0, 0, 0]);
        }
        return r == 0;
    }

    pub fn make_dir(self: &Fs, path: str) -> FsError!void {
        var buf: [4096]u8 = [0; 4096];
        if not linux.c_path(path, buf[0..4096]) {
            return FsError.NotFound;
        }
        var r: i64 = 0;
        unsafe {
            // SAFETY: the path is NUL-terminated in buf.
            r = linux.syscall(linux.MKDIRAT, [self.dir, linux.arg(u8, &buf[0] as *u8), 0x1ED, 0, 0, 0]);
        }
        if linux.errno(r) != 0 {
            return errno_error(linux.errno(r));
        }
    }

    /// Removes a file, or an empty directory.
    pub fn remove(self: &Fs, path: str) -> FsError!void {
        var buf: [4096]u8 = [0; 4096];
        if not linux.c_path(path, buf[0..4096]) {
            return FsError.NotFound;
        }
        var r: i64 = 0;
        unsafe {
            // SAFETY: the path is NUL-terminated in buf.
            r = linux.syscall(linux.UNLINKAT, [self.dir, linux.arg(u8, &buf[0] as *u8), 0, 0, 0, 0]);
            if linux.errno(r) == linux.EISDIR {
                r = linux.syscall(linux.UNLINKAT, [self.dir, linux.arg(u8, &buf[0] as *u8), 0x200, 0, 0, 0]);
            }
        }
        if linux.errno(r) != 0 {
            return errno_error(linux.errno(r));
        }
    }

    pub fn rename(self: &Fs, from: str, to: str) -> FsError!void {
        var a: [4096]u8 = [0; 4096];
        var b: [4096]u8 = [0; 4096];
        if not linux.c_path(from, a[0..4096]) or not linux.c_path(to, b[0..4096]) {
            return FsError.NotFound;
        }
        var r: i64 = 0;
        unsafe {
            // SAFETY: both paths are NUL-terminated.
            r = linux.syscall(linux.RENAMEAT, [self.dir, linux.arg(u8, &a[0] as *u8), self.dir, linux.arg(u8, &b[0] as *u8), 0, 0]);
        }
        if linux.errno(r) != 0 {
            return errno_error(linux.errno(r));
        }
    }

    /// The names in a directory, without . and .., sorted by byte order so
    /// the result is the same on every run (docs/plan.md, determinism).
    pub fn list(self: &Fs, path: str, a: alloc.Allocator) -> FsError!alloc.List(alloc.String) {
        var buf: [4096]u8 = [0; 4096];
        if not linux.c_path(path, buf[0..4096]) {
            return FsError.NotFound;
        }
        var fd: i64 = 0;
        unsafe {
            // SAFETY: O_RDONLY | O_DIRECTORY | O_CLOEXEC.
            fd = linux.syscall(linux.OPENAT, [self.dir, linux.arg(u8, &buf[0] as *u8), 0x90000, 0, 0, 0]);
        }
        if linux.errno(fd) != 0 {
            return errno_error(linux.errno(fd));
        }
        var names = alloc.List(alloc.String).init(a);
        var entries: [4096]u8 = [0; 4096];
        while true {
            var n: i64 = 0;
            unsafe {
                // SAFETY: getdents64 writes up to 4096 bytes of entries.
                n = linux.syscall(linux.GETDENTS64, [fd, linux.arg(u8, &entries[0] as *u8), 4096, 0, 0, 0]);
            }
            if n <= 0 {
                break;
            }
            // linux_dirent64: ino u64, off i64, reclen u16, type u8, name.
            var at: usize = 0;
            while at < n as usize {
                let reclen = (entries[at + 16] as usize) | ((entries[at + 17] as usize) << 8);
                var end = at + 19;
                while entries[end] != 0 : (end += 1) {
                }
                let name = entries[at + 19..end];
                let dot = name.len() == 1 and name[0] == '.';
                let dotdot = name.len() == 2 and name[0] == '.' and name[1] == '.';
                if not dot and not dotdot {
                    var s = alloc.String.init(a);
                    unsafe {
                        // SAFETY: file names on Linux are bytes; those that
                        // are not UTF-8 are left out below.
                        if utf8.valid(name) {
                            s.push_str(mem.str_from(name));
                        }
                    }
                    if s.len() > 0 {
                        names.push(s);
                    }
                }
                at += reclen;
            }
        }
        unsafe {
            // SAFETY: fd is the directory opened above.
            _ = linux.syscall(linux.CLOSE, [fd, 0, 0, 0, 0, 0]);
        }
        sort_names(&mut names);
        return names;
    }
}

fn bytes_less(a: []u8, than: []u8) -> bool {
    var i: usize = 0;
    while i < a.len() and i < than.len() : (i += 1) {
        if a[i] != than[i] {
            return a[i] < than[i];
        }
    }
    return a.len() < than.len();
}

/// Insertion sort by byte order: directories are small.
fn sort_names(names: &mut alloc.List(alloc.String)) {
    let items = names.items_mut();
    var i: usize = 1;
    while i < items.len() : (i += 1) {
        var j = i;
        while j > 0 and bytes_less(a: items[j].view().bytes(), than: items[j - 1].view().bytes()) : (j -= 1) {
            unsafe {
                // SAFETY: j and j - 1 are inside items; the two values
                // trade places, so each is still owned once.
                let base = mem.slice_data(alloc.String, items) as *mut alloc.String;
                let t = base.add(j).*;
                base.add(j).* = base.add(j - 1).*;
                base.add(j - 1).* = t;
            }
        }
    }
}

// ---- Clock ------------------------------------------------------------------------

type Timespec = struct {
    sec: i64,
    nsec: i64,
}

/// Time: a clock that only goes forward, the wall clock, and sleeping.
pub type Clock = struct {
    unique: core.Unique,

    fn read(self: &Clock, id: i64) -> u64 {
        var ts = Timespec { sec: 0, nsec: 0 };
        unsafe {
            // SAFETY: clock_gettime writes one timespec.
            _ = linux.syscall(linux.CLOCK_GETTIME, [id, linux.arg(Timespec, &ts as *Timespec), 0, 0, 0, 0]);
        }
        return (ts.sec as u64) * 1000000000 + ts.nsec as u64;
    }

    /// Nanoseconds since some moment in the past; never goes back.
    pub fn monotonic_ns(self: &Clock) -> u64 {
        return self.read(1);
    }

    /// Nanoseconds since 1970-01-01 00:00 UTC.
    pub fn unix_ns(self: &Clock) -> u64 {
        return self.read(0);
    }

    pub fn sleep_ns(self: &Clock, ns: u64) {
        var ts = Timespec { sec: (ns / 1000000000) as i64, nsec: (ns % 1000000000) as i64 };
        unsafe {
            // SAFETY: nanosleep reads ts and writes what is left into it.
            while linux.errno(linux.syscall(linux.NANOSLEEP, [linux.arg(Timespec, &ts as *Timespec), linux.arg(Timespec, &ts as *Timespec), 0, 0, 0, 0])) == linux.EINTR {
            }
        }
    }
}

// ---- Env --------------------------------------------------------------------------

/// The environment variables the program started with.
pub type Env = struct {
    vars: **u8,
    unique: core.Unique,

    /// The value of the variable name, copied.
    pub fn get(self: &Env, name: str, a: alloc.Allocator) -> ?alloc.String {
        let want = name.bytes();
        var value = alloc.List(u8).init(a);
        var found = false;
        unsafe {
            // SAFETY: envp is an array of NUL-terminated entries that ends
            // with a null pointer; an entry is read only up to its NUL.
            var i: usize = 0;
            while not found : (i += 1) {
                let entry = self.vars.add(i).*;
                if entry.addr() == 0 {
                    break;
                }
                var k: usize = 0;
                while k < want.len() and entry.add(k).* == want[k] : (k += 1) {
                }
                if k == want.len() and entry.add(k).* == '=' {
                    var j = k + 1;
                    while entry.add(j).* != 0 : (j += 1) {
                        value.push(entry.add(j).*);
                    }
                    found = true;
                }
            }
        }
        if not found {
            return none;
        }
        var s = alloc.String.init(a);
        if utf8.valid(value.items()) {
            unsafe {
                // SAFETY: checked just now.
                s.push_str(mem.str_from(value.items()));
            }
        }
        return s;
    }
}

// ---- Proc -------------------------------------------------------------------------

pub type ProcError = error { NotFound, AccessDenied, Killed, ProcFailed }

/// This process, and the ones it starts.
pub type Proc = struct {
    unique: core.Unique,

    pub fn pid(self: &Proc) -> u32 {
        unsafe {
            // SAFETY: getpid reads nothing.
            return linux.syscall(linux.GETPID, [0, 0, 0, 0, 0, 0]) as u32;
        }
    }

    /// Ends the program with this status, after writing out stdout and
    /// stderr.
    pub fn exit(self: &Proc, status: u8) -> noreturn {
        unsafe {
            // SAFETY: the runtime flushes and exits.
            a0rt_exit(status);
        }
    }

    /// Runs argv[0], a path, with argv and this environment, and waits for
    /// it: its exit status.
    pub fn run(self: &Proc, argv: &alloc.List(alloc.String), env: &Env, a: alloc.Allocator) -> ProcError!u8 {
        if argv.len() == 0 {
            return ProcError.NotFound;
        }
        // NUL-terminated copies, and the array of pointers to them.
        var texts = alloc.List(alloc.List(u8)).init(a);
        for s in argv.items() {
            var t = alloc.List(u8).init(a);
            for b in s.view().bytes() {
                t.push(b.*);
            }
            t.push(0);
            texts.push(t);
        }
        var ptrs = alloc.List(u64).init(a);
        for t in texts.items() {
            unsafe {
                // SAFETY: each copy lives until the call ends.
                ptrs.push(mem.slice_data(u8, t.items()).addr() as u64);
            }
        }
        ptrs.push(0);
        var pid: i64 = 0;
        unsafe {
            // SAFETY: what is buffered is written once, by the parent.
            a0rt_flush_all();
            pid = linux.syscall(linux.FORK, [0, 0, 0, 0, 0, 0]);
        }
        if linux.errno(pid) != 0 {
            return ProcError.ProcFailed;
        }
        if pid == 0 {
            unsafe {
                // SAFETY: the child: exec, or end without the parent's buffers.
                let path = mem.slice_data(u8, texts[0].items());
                let r = linux.syscall(linux.EXECVE, [linux.arg(u8, path), linux.arg(u64, mem.slice_data(u64, ptrs.items())), env.vars.addr() as% i64, 0, 0, 0]);
                var code: i64 = 126;
                if linux.errno(r) == linux.ENOENT {
                    code = 127;
                }
                _ = linux.syscall(linux.EXIT, [code, 0, 0, 0, 0, 0]);
            }
        }
        var status: i32 = 0;
        unsafe {
            // SAFETY: wait4 writes one int.
            _ = linux.syscall(linux.WAIT4, [pid, linux.arg(i32, &status as *i32), 0, 0, 0, 0]);
        }
        if (status & 0x7F) != 0 {
            return ProcError.Killed;
        }
        let code = ((status >> 8) & 0xFF) as u8;
        if code == 127 {
            return ProcError.NotFound;
        }
        return code;
    }
}

// ---- Rand -------------------------------------------------------------------------

/// Randomness from the kernel. For repeatable randomness, use a seeded
/// generator: core.rand.
pub type Rand = struct {
    unique: core.Unique,

    pub fn fill(self: &mut Rand, into: []mut u8) {
        var done: usize = 0;
        while done < into.len() {
            var r: i64 = 0;
            unsafe {
                // SAFETY: getrandom writes at most the bytes left in into.
                r = linux.syscall(linux.GETRANDOM, [linux.arg(u8, mem.slice_data(u8, into) as *u8) + done as i64, (into.len() - done) as i64, 0, 0, 0, 0]);
            }
            if r > 0 {
                done += r as usize;
            }
        }
    }

    pub fn next_u64(self: &mut Rand) -> u64 {
        var b: [8]u8 = [0; 8];
        self.fill(b[0..8]);
        var v: u64 = 0;
        var i: usize = 0;
        while i < 8 : (i += 1) {
            v = (v << 8) | b[i] as u64;
        }
        return v;
    }
}

// ---- Net --------------------------------------------------------------------------

pub type NetError = error { Refused, AddressInUse, NetFailed }

/// An IPv4 address and port.
pub type Address = struct {
    pub ip: [4]u8,
    pub port: u16,
}

/// struct sockaddr_in: the port in network byte order.
type SockAddr = struct {
    family: u16,
    port: u16,
    ip: [4]u8,
    zero: u64,
}

fn sock_addr(at: Address) -> SockAddr {
    return SockAddr { family: 2, port: (at.port >> 8) | (at.port << 8), ip: at.ip, zero: 0 };
}

fn net_error(e: i64) -> NetError {
    if e == linux.ECONNREFUSED { return NetError.Refused; }
    if e == linux.EADDRINUSE { return NetError.AddressInUse; }
    return NetError.NetFailed;
}

/// poll(2)'s events: the socket can be read, or written.
const POLLIN: u32 = 1;
const POLLOUT: u32 = 4;

/// Waits until fd is ready; other tasks run meanwhile (rt.c).
fn io_wait(fd: i64, events: u32) {
    unsafe {
        // SAFETY: the runtime only polls fd.
        a0rt_io_wait(fd, events);
    }
}

/// TCP over IPv4. Sockets do not block the program: a task that waits for
/// one lets the others run.
pub type Net = struct {
    unique: core.Unique,

    pub fn connect(self: &Net, to: Address) -> NetError!Socket {
        var sa = sock_addr(to);
        var fd: i64 = 0;
        var r: i64 = 0;
        unsafe {
            // SAFETY: AF_INET, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC;
            // sa is 16 bytes; SO_ERROR is one int.
            fd = linux.syscall(linux.SOCKET, [2, 0x80801, 0, 0, 0, 0]);
            if linux.errno(fd) != 0 {
                return net_error(linux.errno(fd));
            }
            r = linux.syscall(linux.CONNECT, [fd, linux.arg(SockAddr, &sa as *SockAddr), 16, 0, 0, 0]);
            if linux.errno(r) == linux.EINPROGRESS {
                io_wait(fd, events: POLLOUT);
                var e: i32 = 0;
                var len: u32 = 4;
                r = linux.syscall(linux.GETSOCKOPT, [fd, 1, 4, linux.arg(i32, &e as *i32), linux.arg(u32, &len as *u32), 0]);
                if linux.errno(r) == 0 and e != 0 {
                    r = -(e as i64);
                }
            }
            if linux.errno(r) != 0 {
                _ = linux.syscall(linux.CLOSE, [fd, 0, 0, 0, 0, 0]);
                return net_error(linux.errno(r));
            }
        }
        return Socket { fd: fd, unique: core.Unique { } };
    }

    /// Listens at the address; port 0 lets the kernel choose one, which
    /// Listener.port says.
    pub fn listen(self: &Net, at: Address) -> NetError!Listener {
        var sa = sock_addr(at);
        var fd: i64 = 0;
        unsafe {
            // SAFETY: as connect; SO_REUSEADDR takes one int.
            fd = linux.syscall(linux.SOCKET, [2, 0x80801, 0, 0, 0, 0]);
            if linux.errno(fd) != 0 {
                return net_error(linux.errno(fd));
            }
            var one: i32 = 1;
            _ = linux.syscall(linux.SETSOCKOPT, [fd, 1, 2, linux.arg(i32, &one as *i32), 4, 0]);
            var r = linux.syscall(linux.BIND, [fd, linux.arg(SockAddr, &sa as *SockAddr), 16, 0, 0, 0]);
            if linux.errno(r) == 0 {
                r = linux.syscall(linux.LISTEN, [fd, 128, 0, 0, 0, 0]);
            }
            if linux.errno(r) != 0 {
                _ = linux.syscall(linux.CLOSE, [fd, 0, 0, 0, 0, 0]);
                return net_error(linux.errno(r));
            }
        }
        return Listener { fd: fd, unique: core.Unique { } };
    }
}

pub type Listener = struct {
    fd: i64,
    unique: core.Unique,

    pub fn port(self: &Listener) -> u16 {
        var sa = SockAddr { family: 0, port: 0, ip: [0, 0, 0, 0], zero: 0 };
        var len: u32 = 16;
        unsafe {
            // SAFETY: getsockname writes up to len bytes of sa.
            _ = linux.syscall(linux.GETSOCKNAME, [self.fd, linux.arg(SockAddr, &sa as *SockAddr), linux.arg(u32, &len as *u32), 0, 0, 0]);
        }
        return (sa.port >> 8) | (sa.port << 8);
    }

    pub fn accept(self: &Listener) -> NetError!Socket {
        var fd: i64 = -linux.EAGAIN;
        while linux.errno(fd) == linux.EAGAIN or linux.errno(fd) == linux.EINTR {
            unsafe {
                // SAFETY: the peer's address is not asked for; the new
                // socket is SOCK_NONBLOCK | SOCK_CLOEXEC too.
                fd = linux.syscall(linux.ACCEPT4, [self.fd, 0, 0, 0x80800, 0, 0]);
            }
            if linux.errno(fd) == linux.EAGAIN {
                io_wait(self.fd, events: POLLIN);
            }
        }
        if linux.errno(fd) != 0 {
            return net_error(linux.errno(fd));
        }
        return Socket { fd: fd, unique: core.Unique { } };
    }

    pub fn close(self: &mut Listener) {
        unsafe {
            // SAFETY: fd is this listener's.
            _ = linux.syscall(linux.CLOSE, [self.fd, 0, 0, 0, 0, 0]);
        }
        self.fd = -1;
    }
}

/// A TCP connection.
pub type Socket = struct {
    fd: i64,
    unique: core.Unique,

    /// Up to into.len() bytes; 0 when the peer has closed.
    pub fn read(self: &mut Socket, into: []mut u8) -> NetError!usize {
        var r: i64 = -linux.EAGAIN;
        while linux.errno(r) == linux.EAGAIN or linux.errno(r) == linux.EINTR {
            unsafe {
                // SAFETY: read writes at most into.len() bytes.
                r = linux.syscall(linux.READ, [self.fd, linux.arg(u8, mem.slice_data(u8, into) as *u8), into.len() as i64, 0, 0, 0]);
            }
            if linux.errno(r) == linux.EAGAIN {
                io_wait(self.fd, events: POLLIN);
            }
        }
        if linux.errno(r) != 0 {
            return net_error(linux.errno(r));
        }
        return r as usize;
    }

    /// All of data.
    pub fn write(self: &mut Socket, data: []u8) -> NetError!void {
        var done: usize = 0;
        while done < data.len() {
            var r: i64 = 0;
            unsafe {
                // SAFETY: send reads the bytes left in data. MSG_NOSIGNAL:
                // a peer that has gone is an error, not SIGPIPE.
                r = linux.syscall(linux.SENDTO, [self.fd, linux.arg(u8, mem.slice_data(u8, data)) + done as i64, (data.len() - done) as i64, 0x4000, 0, 0]);
            }
            if linux.errno(r) == linux.EAGAIN or linux.errno(r) == linux.EINTR {
                if linux.errno(r) == linux.EAGAIN {
                    io_wait(self.fd, events: POLLOUT);
                }
                continue;
            }
            if linux.errno(r) != 0 {
                return net_error(linux.errno(r));
            }
            done += r as usize;
        }
    }

    pub fn close(self: &mut Socket) {
        unsafe {
            // SAFETY: fd is this socket's.
            _ = linux.syscall(linux.CLOSE, [self.fd, 0, 0, 0, 0, 0]);
        }
        self.fd = -1;
    }
}
