/// A host for Nimadir's mini-apps (github.com/Nodirbek-Abdulaxadov/nimadir,
/// wit/world.wit, nimadir:shell@1.2.0): the shell's side of host-api and dom,
/// with no window. Each frame calls the app's update and writes what it drew,
/// one line a widget; a button is clicked by naming it. The limits are the
/// shell's: a second for a frame, ten for init, 512 MiB of memory, and 16 MiB
/// and 65536 widgets sent in a frame. Past one the app is stopped, and the
/// shell says which.
import alloc;
import core.utf8;
import image.png;
import wasm.component as c;
import wasm.exec;
import wasm.wasip2;

pub const FRAME_BUDGET_NS: u64 = 1000000000;
pub const INIT_BUDGET_NS: u64 = 10000000000;
pub const MAX_MEMORY: u64 = 512 << 20;
pub const MAX_FRAME_BYTES: u64 = 16 << 20;
pub const MAX_FRAME_CMDS: u64 = 1 << 16;
pub const MAX_STORAGE: u64 = 1 << 20;
pub const MAX_NODES: usize = 65536;
pub const MAX_NESTING: u32 = 32;
/// An image's longest side, and the pixels an app's images hold together.
pub const MAX_IMAGE_SIDE: u32 = 4096;
pub const MAX_APP_PIXELS: u64 = 8 << 20;
/// No frame is asked for sooner than this, in ms.
pub const MIN_FRAME_MS: u32 = 16;
/// The events waiting for the app; past this, the oldest goes.
pub const MAX_EVENTS: usize = 256;

const HOST_API: str = "nimadir:shell/host-api@1.2.0";
const DOM: str = "nimadir:shell/dom@1.2.0";
/// What a runtime's randomness (wasi:random) starts from: "nimadir!".
const WASI_SEED: u64 = 0x6E696D6164697221;

const HOST_FUNCS: str = " log ui-label ui-button ui-text-edit ui-heading ui-search-field ui-tile now-millis list-apps open-app request-frame storage-get storage-set storage-remove storage-keys ui-begin ui-end ui-checkbox ui-choice ui-separator ui-progress ui-submitted image-load ui-image fetch fetch-poll locale time-zone utc-offset app-info ";
const DOM_FUNCS: str = " root create-element create-text append-child insert-before remove release set-text set-attribute remove-attribute get-attribute toggle-class set-style set-markup query-all parent children value focus bounds add-stylesheet remove-stylesheet listen unlisten events ";

/// What a widget is, as a screen's shell draws it.
pub const LABEL: u32 = 1;
pub const HEADING: u32 = 2;
pub const BUTTON: u32 = 3;
pub const TILE: u32 = 4;
pub const CHECKBOX: u32 = 5;
pub const FIELD: u32 = 6;
pub const SEARCH: u32 = 7;
pub const CHOICE: u32 = 8;
pub const SEPARATOR: u32 = 9;
pub const PROGRESS: u32 = 10;
pub const IMAGE: u32 = 11;
/// A group begins, of the kind text says (row, column, section or
/// scroll), its number among the frame's groups in value; its widgets have
/// depth one more, until its END.
pub const BEGIN: u32 = 12;
pub const END: u32 = 13;

/// A widget the app drew this frame, for a shell with a screen to draw:
/// its kind, its text, a second text (a tile's detail, a search field's
/// placeholder, a choice's options, a line apart), a number (a heading's
/// level, a checkbox's state, a choice, progress in thousandths, an
/// image), how deep in groups it is, and its index among the frame's
/// buttons (button, tile, checkbox) or fields (field, search, choice).
pub type Widget = struct {
    pub kind: u32,
    pub text: alloc.String,
    pub detail: alloc.String,
    pub value: u64,
    pub depth: u32,
    pub index: u32,
}

/// Where a node was laid out: x, y, width, height; width below 0 for
/// nowhere.
type Box = struct {
    x: i32,
    y: i32,
    w: i32,
    h: i32,
}

/// An element, or a run of text when tag is empty.
type Node = struct {
    tag: alloc.String,
    text: alloc.String,
    names: alloc.List(alloc.String),
    values: alloc.List(alloc.String),
    children: alloc.List(u32),
    parent: u32,
    alive: bool,
    listens: alloc.List(alloc.String),
}

/// An event waiting for the app: kind, the node it happened on and the one
/// that listens, and a control's value.
type Event = struct {
    kind: alloc.String,
    target: u32,
    current: u32,
    value: alloc.String,
}

/// The shell's state the app's calls reach: what it drew this frame, its
/// storage, its element tree.
pub type Ui = struct {
    /// What the frame drew, widget by widget.
    pub widgets: alloc.List(Widget),
    /// The frame's buttons, fields and groups so far.
    buttons: u32,
    fields: u32,
    groups: u32,
    /// What the user did, for the next frame: the buttons tapped and the
    /// fields submitted, for that frame only; and the text each field
    /// edited holds, until it is edited again, or the app hands the field
    /// something else than it was given (a message's text cleared once it
    /// is sent): what each edited text field gave the app last, and
    /// whether it has yet.
    clicked: alloc.List(u32),
    submits: alloc.List(u32),
    edit_fields: alloc.List(u32),
    edits: alloc.List(alloc.String),
    gave: alloc.List(alloc.String),
    gave_yet: alloc.List(bool),
    /// The text field drawn last, for ui-submitted; NONE for none.
    last_field: u32,
    pub now_ms: i64,
    /// Who the user is, as the shell that runs the app says: its language
    /// and region (BCP 47), its time zone (IANA, "" for none said), and
    /// how many minutes east of UTC that is now.
    pub locale: alloc.String,
    pub time_zone: alloc.String,
    pub utc_offset: i32,
    /// The network as the shell gives it: the origins the app's manifest
    /// declares (none: it may reach nowhere), whether the shell fetches at
    /// all, and whether it lets apps reach this machine and its local
    /// network (a test's, as NIMADIR_ALLOW_LOCAL_NETWORK does).
    pub origins: alloc.List(alloc.String),
    pub online: bool,
    pub allow_local: bool,
    /// Requests the app made, for the shell to make (take_outgoing); the
    /// numbers of those under way; the shell's answers (reply), each given
    /// to the app once; the next request's number.
    outgoing: alloc.List(Outgoing),
    under_way: alloc.List(u32),
    replies: alloc.List(Reply),
    next_request: u32,
    /// Whether storage-set or storage-remove changed the app's storage
    /// since the shell last kept it.
    pub storage_changed: bool,
    keys: alloc.List(alloc.String),
    values: alloc.List(alloc.String),
    nodes: alloc.List(Node),
    events: alloc.List(Event),
    sheets: u32,
    /// The stylesheets added, by number less one; a removed one is empty.
    sheet_texts: alloc.List(alloc.String),
    /// Where the shell laid each node out last: x, y, width, height, in
    /// logical pixels; a width below 0 for none.
    boxes: alloc.List(Box),
    /// The control that has the keyboard, or 0.
    pub focused: u32,
    /// The app asked to open this, honoured between frames; empty for none.
    pub open_request: alloc.String,
    /// The apps list-apps gives: name, source and what it is, three
    /// strings an app; empty for the three of Nimadir's tests.
    apps: alloc.List(alloc.String),
    /// The images the app loaded, by number, and their pixels together.
    pictures: alloc.List(png.Image),
    pixels: u64,
    /// What the app logged, made visible, until the shell takes it.
    logs: alloc.List(alloc.String),
    /// The soonest the app asked to be drawn again, in ms, this frame;
    /// NONE when it did not ask.
    pub frame_after: u32,
    depth: u32,
    sent_bytes: u64,
    sent_cmds: u64,
    pub exceeded: bool,
    /// Functions this shell keeps from the app, to see it refused.
    denied: alloc.List(alloc.String),
    /// What a runtime the app is built on reaches through WASI.
    wasi: wasip2.Wasi,
    /// Functions the embedder adds to Nimadir's world, and the calls made
    /// to them since it last took them (add, take_calls).
    added: alloc.List(Added),
    calls: alloc.List(Call),
    next_call: u32,
    a: alloc.Allocator,
}

/// A function the embedder adds to what Nimadir's world gives, for a world
/// that includes it and imports more (the phone's arche:phone): each call
/// is kept for the embedder (take_calls) and answered at once, with
/// answer, which the embedder may change between calls (set_answer), or,
/// when numbered, with the call's own number, a u32.
type Added = struct {
    instance: alloc.String,
    func: alloc.String,
    numbered: bool,
    answer: c.Val,
}

/// A call to an added function: its number, where it went, and what it
/// was given.
pub type Call = struct {
    pub number: u32,
    pub instance: alloc.String,
    pub func: alloc.String,
    pub args: alloc.List(c.Val),
}

/// func of instance (as "ns:pkg/interface@version") added: answered with
/// answer, or, numbered, with each call's number (Added).
pub fn add(ui: &mut Ui, instance: str, func: str, numbered: bool, answer: c.Val) {
    ui.added.push(Added { instance: alloc.String.from(instance, ui.a), func: alloc.String.from(func, ui.a), numbered: numbered, answer: answer });
}

/// What calls to func of instance are answered with from now on.
pub fn set_answer(ui: &mut Ui, instance: str, func: str, answer: c.Val) {
    var k: usize = 0;
    while k < ui.added.len() : (k += 1) {
        if ui.added.items()[k].instance.view().eq(instance) and ui.added.items()[k].func.view().eq(func) {
            ui.added.items_mut()[k].answer = copy_val(&answer, a: ui.a);
        }
    }
}

/// The calls to added functions since this was last asked, in order.
pub fn take_calls(ui: &mut Ui, a: alloc.Allocator) -> alloc.List(Call) {
    var out = alloc.List(Call).init(a);
    for k in ui.calls.items() {
        var args = alloc.List(c.Val).init(a);
        for v in k.args.items() {
            args.push(copy_val(v, a: a));
        }
        out.push(Call { number: k.number, instance: alloc.String.from(k.instance.view(), a), func: alloc.String.from(k.func.view(), a), args: args });
    }
    ui.calls = alloc.List(Call).init(ui.a);
    return out;
}

/// A copy of v, its strings and lists too.
fn copy_val(v: &c.Val, a: alloc.Allocator) -> c.Val {
    match v {
        .Unit => { return c.Val.Unit; }
        .Bool { v: b } => { return c.Val.Bool { v: b.* }; }
        .Int { v: n } => { return c.Val.Int { v: n.* }; }
        .F32 { bits } => { return c.Val.F32 { bits: bits.* }; }
        .F64 { bits } => { return c.Val.F64 { bits: bits.* }; }
        .Char { v: ch } => { return c.Val.Char { v: ch.* }; }
        .Str { v: text } => { return c.Val.Str { v: alloc.String.from(text.view(), a) }; }
        .List { items } => {
            var out = alloc.List(c.Val).init(a);
            for x in items.items() {
                out.push(copy_val(x, a: a));
            }
            return c.Val.List { items: out };
        }
        .Variant { case, payload } => {
            var out = alloc.List(c.Val).init(a);
            for x in payload.items() {
                out.push(copy_val(x, a: a));
            }
            return c.Val.Variant { case: case.*, payload: out };
        }
        .Flags { bits } => { return c.Val.Flags { bits: bits.* }; }
    }
}

/// The added function func of instance, by its place; NONE for none.
fn added_at(ui: &Ui, instance: str, func: str) -> usize {
    var k: usize = 0;
    while k < ui.added.len() : (k += 1) {
        if ui.added.items()[k].instance.view().eq(instance) and ui.added.items()[k].func.view().eq(func) {
            return k;
        }
    }
    return NONE_AT;
}

const NONE_AT: usize = 0xFFFFFFFFFFFFFFFF;

pub fn new_ui(a: alloc.Allocator) -> Ui {
    var ui = Ui {
        widgets: alloc.List(Widget).init(a),
        buttons: 0,
        fields: 0,
        groups: 0,
        clicked: alloc.List(u32).init(a),
        submits: alloc.List(u32).init(a),
        edit_fields: alloc.List(u32).init(a),
        edits: alloc.List(alloc.String).init(a),
        gave: alloc.List(alloc.String).init(a),
        gave_yet: alloc.List(bool).init(a),
        last_field: NONE,
        now_ms: 0,
        locale: alloc.String.from("en-US", a),
        time_zone: alloc.String.init(a),
        utc_offset: 0,
        origins: alloc.List(alloc.String).init(a),
        online: false,
        allow_local: false,
        outgoing: alloc.List(Outgoing).init(a),
        under_way: alloc.List(u32).init(a),
        replies: alloc.List(Reply).init(a),
        next_request: 1,
        storage_changed: false,
        keys: alloc.List(alloc.String).init(a),
        values: alloc.List(alloc.String).init(a),
        nodes: alloc.List(Node).init(a),
        events: alloc.List(Event).init(a),
        sheets: 0,
        sheet_texts: alloc.List(alloc.String).init(a),
        boxes: alloc.List(Box).init(a),
        focused: 0,
        open_request: alloc.String.init(a),
        apps: alloc.List(alloc.String).init(a),
        pictures: alloc.List(png.Image).init(a),
        pixels: 0,
        logs: alloc.List(alloc.String).init(a),
        frame_after: NONE,
        depth: 0,
        sent_bytes: 0,
        sent_cmds: 0,
        exceeded: false,
        denied: alloc.List(alloc.String).init(a),
        wasi: wasip2.new_wasi(seed: WASI_SEED, a),
        added: alloc.List(Added).init(a),
        calls: alloc.List(Call).init(a),
        next_call: 1,
        a: a,
    };
    // Node 0 is no node; 1 is the page's body.
    _ = new_node(&mut ui, tag: "none");
    _ = new_node(&mut ui, tag: "body");
    return ui;
}

fn new_node(ui: &mut Ui, tag: str) -> u32 {
    ui.nodes.push(Node {
        tag: alloc.String.from(tag, ui.a),
        text: alloc.String.init(ui.a),
        names: alloc.List(alloc.String).init(ui.a),
        values: alloc.List(alloc.String).init(ui.a),
        children: alloc.List(u32).init(ui.a),
        parent: 0,
        alive: true,
        listens: alloc.List(alloc.String).init(ui.a),
    });
    return (ui.nodes.len() - 1) as u32;
}

/// The shell gives the app no function of this name.
pub fn deny(ui: &mut Ui, func: str) {
    ui.denied.push(alloc.String.from(func, ui.a));
}

/// No button or field.
pub const NONE: u32 = 0xFFFFFFFF;

fn has(list: &alloc.List(u32), x: u32) -> bool {
    for y in list.items() {
        if y.* == x {
            return true;
        }
    }
    return false;
}

/// The button i (button, tile or checkbox, counted in the order the frame
/// draws them) is tapped in the next frame: it says so as it is drawn.
pub fn tap(ui: &mut Ui, i: u32) {
    if not has(&ui.clicked, x: i) {
        ui.clicked.push(i);
    }
}

/// The field i (text, search or choice, counted apart from buttons) holds
/// text from the next frame on, whatever the app hands it, until it is set
/// again. A choice's text is the number of the option picked.
pub fn set_field(ui: &mut Ui, i: u32, text: str) {
    var k: usize = 0;
    while k < ui.edit_fields.len() : (k += 1) {
        if ui.edit_fields.items()[k] == i {
            ui.edits.items_mut()[k] = alloc.String.from(text, ui.a);
            return;
        }
    }
    ui.edit_fields.push(i);
    ui.edits.push(alloc.String.from(text, ui.a));
    ui.gave.push(alloc.String.init(ui.a));
    ui.gave_yet.push(false);
}

/// The edit of the field at k dropped: the app's own text holds again.
fn drop_edit(ui: &mut Ui, k: usize) {
    var fields = alloc.List(u32).init(ui.a);
    var edits = alloc.List(alloc.String).init(ui.a);
    var gave = alloc.List(alloc.String).init(ui.a);
    var gave_yet = alloc.List(bool).init(ui.a);
    var j: usize = 0;
    while j < ui.edit_fields.len() : (j += 1) {
        if j != k {
            fields.push(ui.edit_fields.items()[j]);
            edits.push(alloc.String.from(ui.edits.items()[j].view(), ui.a));
            gave.push(alloc.String.from(ui.gave.items()[j].view(), ui.a));
            gave_yet.push(ui.gave_yet.items()[j]);
        }
    }
    ui.edit_fields = fields;
    ui.edits = edits;
    ui.gave = gave;
    ui.gave_yet = gave_yet;
}

/// The field i is submitted in the next frame: Enter, or a phone
/// keyboard's action key.
pub fn submit_field(ui: &mut Ui, i: u32) {
    if not has(&ui.submits, x: i) {
        ui.submits.push(i);
    }
}

/// The field i holds text, and is submitted when submit.
pub fn edit_field(ui: &mut Ui, i: u32, text: str, submit: bool) {
    set_field(ui, i: i, text: text);
    if submit {
        submit_field(ui, i: i);
    }
}

/// Option option of the choice i is picked.
pub fn pick(ui: &mut Ui, i: u32, option: u64) {
    var t = alloc.String.init(ui.a);
    t.push_u64(option);
    set_field(ui, i: i, text: t.view());
}

/// What the field i holds by the user's edits; none when not edited.
fn edit_of(ui: &Ui, i: u32) -> ?usize {
    var k: usize = 0;
    while k < ui.edit_fields.len() : (k += 1) {
        if ui.edit_fields.items()[k] == i {
            return k;
        }
    }
    return none;
}

/// A new frame: what was drawn and sent so far no longer counts.
pub fn begin_frame(ui: &mut Ui) {
    ui.widgets = alloc.List(Widget).init(ui.a);
    ui.buttons = 0;
    ui.fields = 0;
    ui.groups = 0;
    ui.last_field = NONE;
    ui.sent_bytes = 0;
    ui.sent_cmds = 0;
    ui.depth = 0;
    ui.frame_after = NONE;
}

/// What the app logged since the shell last took it, each line made
/// visible: control and bidirectional characters as \u{...}.
pub fn logs_of(ui: &Ui) -> []alloc.String {
    return ui.logs.items();
}

pub fn clear_logs(ui: &mut Ui) {
    ui.logs.clear();
}

// ---- values -------------------------------------------------------------------------

fn text_arg(args: &alloc.List(c.Val), i: usize) -> str {
    match &args.items()[i] {
        .Str { v } => { return v.view(); }
        _ => { return ""; }
    }
}

fn int_arg(args: &alloc.List(c.Val), i: usize) -> u64 {
    match &args.items()[i] {
        .Int { v } => { return v.*; }
        .Bool { v } => {
            if v.* {
                return 1;
            }
            return 0;
        }
        _ => { return 0; }
    }
}

/// Whether x sorts before y, byte by byte.
fn bytes_before(x: str, y: str) -> bool {
    let xb = x.bytes();
    let yb = y.bytes();
    var i: usize = 0;
    while i < xb.len() and i < yb.len() : (i += 1) {
        if xb[i] != yb[i] {
            return xb[i] < yb[i];
        }
    }
    return xb.len() < yb.len();
}

/// A request's url, its record's second field.
fn url_of(args: &alloc.List(c.Val)) -> str {
    match &args.items()[0] {
        .List { items } => {
            if items.len() > 1 {
                match &items.items()[1] {
                    .Str { v } => { return v.view(); }
                    _ => { }
                }
            }
        }
        _ => { }
    }
    return "";
}

/// Why a fetch of url is refused, as Nimadir's shell says it: plain http
/// to anywhere but this machine, an address that is no http or https one
/// or has no host, this machine or its local network, and, past those,
/// an app that declares no network access.
fn refusal(ui: &Ui, url: str, size: usize, why: &mut alloc.String, a: alloc.Allocator) {
    if url.starts_with("http://") and not loopback(host_in(url[7..url.len()]), a: a) {
        why.push_str(url);
        why.push_str(" is plain http — the shell only fetches over https:// (this machine, localhost or 127.0.0.1, is the one exception)");
        return;
    }
    let b = url.bytes();
    var sep: usize = 0;
    while sep + 3 <= b.len() and not url[sep..sep + 3].eq("://") {
        sep += 1;
    }
    if sep + 3 > b.len() {
        why.push_str(url);
        why.push_str(" is not an http or https address");
        return;
    }
    let scheme = lower(url[0..sep], a: a);
    var default_port = "";
    if scheme.view().eq("https") {
        default_port = ":443";
    } else if scheme.view().eq("http") {
        default_port = ":80";
    } else {
        why.push_str(url);
        why.push_str(" is not an http or https address");
        return;
    }
    let host = lower(authority_in(url[sep + 3..url.len()]), a: a);
    var end = host.len();
    if end >= default_port.len() and host.view()[end - default_port.len()..end].eq(default_port) {
        end -= default_port.len();
    }
    if end == 0 {
        why.push_str(url);
        why.push_str(" has no host");
        return;
    }
    var origin = alloc.String.from(scheme.view(), a);
    origin.push_str("://");
    origin.push_str(host.view()[0..end]);
    if local(host_in(host.view()[0..end])) and not ui.allow_local {
        why.push_str(origin.view());
        why.push_str(" is this machine or its local network, which apps may not reach");
        return;
    }
    if ui.origins.len() == 0 {
        why.push_str("this app declares no network access in its manifest");
        return;
    }
    var declared = false;
    for o in ui.origins.items() {
        if lower(o.view(), a: a).view().eq(origin.view()) {
            declared = true;
        }
    }
    if not declared {
        why.push_str(origin.view());
        why.push_str(" is not among the origins this app's manifest declares");
        return;
    }
    if size > MAX_BODY {
        why.push_str("a request body may be 8 MiB");
        return;
    }
    if ui.under_way.len() >= 8 {
        why.push_str("8 requests are already under way");
        return;
    }
    if not ui.online {
        why.push_str("no network in this shell");
    }
}

/// The largest body of a request, and of an answer: 8 MiB, as Nimadir's.
const MAX_BODY: usize = 8 << 20;

/// A request's body's length, its record's fourth field.
fn body_len(args: &alloc.List(c.Val)) -> usize {
    match &args.items()[0] {
        .List { items } => {
            if items.len() > 3 {
                match &items.items()[3] {
                    .List { items: bytes } => { return bytes.len(); }
                    _ => { }
                }
            }
        }
        _ => { }
    }
    return 0;
}

/// A request an app made, for the shell to make: its number; its method,
/// address, headers (a name, then its value, and so on) and body.
pub type Outgoing = struct {
    pub id: u32,
    pub method: alloc.String,
    pub url: alloc.String,
    pub headers: alloc.List(alloc.String),
    pub body: alloc.List(u8),
}

/// The shell's answer to a request: a response (answered), its status,
/// headers and body; or why there is none.
pub type Reply = struct {
    pub id: u32,
    pub answered: bool,
    pub status: u16,
    pub headers: alloc.List(alloc.String),
    pub body: alloc.List(u8),
    pub why: alloc.String,
}

/// The request in fetch's args, as Outgoing, in a.
fn outgoing_of(args: &alloc.List(c.Val), id: u32, a: alloc.Allocator) -> Outgoing {
    var out = Outgoing { id: id, method: alloc.String.init(a), url: alloc.String.init(a), headers: alloc.List(alloc.String).init(a), body: alloc.List(u8).init(a) };
    match &args.items()[0] {
        .List { items } => {
            if items.len() == 4 {
                match &items.items()[0] {
                    .Str { v } => { out.method.push_str(v.view()); }
                    _ => { }
                }
                match &items.items()[1] {
                    .Str { v } => { out.url.push_str(v.view()); }
                    _ => { }
                }
                match &items.items()[2] {
                    .List { items: pairs } => {
                        for pair in pairs.items() {
                            match pair {
                                .List { items: two } => {
                                    for half in two.items() {
                                        match half {
                                            .Str { v } => { out.headers.push(alloc.String.from(v.view(), a)); }
                                            _ => { }
                                        }
                                    }
                                }
                                _ => { }
                            }
                        }
                    }
                    _ => { }
                }
                match &items.items()[3] {
                    .List { items: bytes } => {
                        for byte in bytes.items() {
                            match byte {
                                .Int { v } => { out.body.push((v.* & 0xFF) as u8); }
                                _ => { }
                            }
                        }
                    }
                    _ => { }
                }
            }
        }
        _ => { }
    }
    return out;
}

/// A reply as fetch-poll gives it: ok with the http-response record, or
/// err with why.
fn reply_val(r: &Reply, a: alloc.Allocator) -> c.Val {
    if not r.answered {
        return done(r.why.view(), a);
    }
    var headers = alloc.List(c.Val).init(a);
    var k: usize = 0;
    while k + 1 < r.headers.len() : (k += 2) {
        var pair = alloc.List(c.Val).init(a);
        pair.push(str_val(r.headers.items()[k].view(), a));
        pair.push(str_val(r.headers.items()[k + 1].view(), a));
        headers.push(c.Val.List { items: pair });
    }
    var body = alloc.List(c.Val).init(a);
    for byte in r.body.items() {
        body.push(int_val(byte.* as u64));
    }
    var fields = alloc.List(c.Val).init(a);
    fields.push(int_val(r.status as u64));
    fields.push(c.Val.List { items: headers });
    fields.push(c.Val.List { items: body });
    var p = alloc.List(c.Val).init(a);
    p.push(c.Val.List { items: fields });
    return c.Val.Variant { case: 0, payload: p };
}

/// The requests the app made since this was last asked, for the shell to
/// make; each is answered with reply.
pub fn take_outgoing(ui: &mut Ui, a: alloc.Allocator) -> alloc.List(Outgoing) {
    var out = alloc.List(Outgoing).init(a);
    for o in ui.outgoing.items() {
        var copy = Outgoing { id: o.id, method: alloc.String.from(o.method.view(), a), url: alloc.String.from(o.url.view(), a), headers: alloc.List(alloc.String).init(a), body: alloc.List(u8).init(a) };
        for h in o.headers.items() {
            copy.headers.push(alloc.String.from(h.view(), a));
        }
        for byte in o.body.items() {
            copy.body.push(byte.*);
        }
        out.push(copy);
    }
    ui.outgoing.clear();
    return out;
}

/// The shell's answer to request r.id, for fetch-poll to give.
pub fn reply(ui: &mut Ui, r: Reply) {
    var k: usize = 0;
    while k < ui.under_way.len() : (k += 1) {
        if ui.under_way.items()[k] == r.id {
            ui.under_way.items_mut()[k] = 0;
        }
    }
    var left = alloc.List(u32).init(ui.a);
    for u in ui.under_way.items() {
        if u.* != 0 {
            left.push(u.*);
        }
    }
    ui.under_way = left;
    ui.replies.push(r);
}

/// The app's storage, live entries only, into keys and values, for the
/// shell to keep.
pub fn storage_entries(ui: &Ui, keys: &mut alloc.List(alloc.String), values: &mut alloc.List(alloc.String), a: alloc.Allocator) {
    var i: usize = 0;
    while i < ui.keys.len() : (i += 1) {
        if ui.keys.items()[i].len() > 0 {
            keys.push(alloc.String.from(ui.keys.items()[i].view(), a));
            values.push(alloc.String.from(ui.values.items()[i].view(), a));
        }
    }
}

/// An entry of the app's storage as the shell kept it, put back before
/// the app starts.
pub fn storage_put(ui: &mut Ui, key: str, value: str) {
    if key.len() == 0 {
        return;
    }
    ui.keys.push(alloc.String.from(key, ui.a));
    ui.values.push(alloc.String.from(value, ui.a));
}

/// s in lower case.
fn lower(s: str, a: alloc.Allocator) -> alloc.String {
    var out = alloc.String.init(a);
    for ch in s.bytes() {
        if ch.* >= 'A' and ch.* <= 'Z' {
            out.push_ascii(ch.* + 32);
        } else {
            out.push_ascii(ch.*);
        }
    }
    return out;
}

/// An address's authority, after its scheme: up to its path, query or
/// fragment, past any user in it.
fn authority_in(rest: str) -> str {
    let b = rest.bytes();
    var end: usize = 0;
    while end < b.len() and b[end] != '/' and b[end] != '?' and b[end] != '#' {
        end += 1;
    }
    var start: usize = 0;
    var i: usize = 0;
    while i < end : (i += 1) {
        if b[i] == '@' {
            start = i + 1;
        }
    }
    return rest[start..end];
}

/// The host of an address after its scheme: inside its brackets, or
/// before its port.
fn host_in(rest: str) -> str {
    let auth = authority_in(rest);
    let b = auth.bytes();
    if b.len() > 0 and b[0] == '[' {
        var e: usize = 1;
        while e < b.len() and b[e] != ']' {
            e += 1;
        }
        return auth[1..e];
    }
    var e: usize = 0;
    while e < b.len() and b[e] != ':' {
        e += 1;
    }
    return auth[0..e];
}

/// A dotted IPv4 address as a number; none for what is not one.
fn ipv4(host: str) -> ?u32 {
    let b = host.bytes();
    var value: u32 = 0;
    var parts: u32 = 0;
    var i: usize = 0;
    while parts < 4 {
        var n: u32 = 0;
        var digits: u32 = 0;
        while i < b.len() and b[i] >= '0' and b[i] <= '9' and digits < 4 {
            n = n * 10 + (b[i] - '0') as u32;
            digits += 1;
            i += 1;
        }
        if digits == 0 or n > 255 {
            return none;
        }
        value = (value << 8) | n;
        parts += 1;
        if parts < 4 {
            if i >= b.len() or b[i] != '.' {
                return none;
            }
            i += 1;
        }
    }
    if i != b.len() {
        return none;
    }
    return value;
}

/// The first 16 bits of an IPv6 address, as far as its text tells them:
/// 0 for one that starts with ::.
fn ipv6_first(host: str) -> u32 {
    let b = host.bytes();
    var v: u32 = 0;
    var i: usize = 0;
    while i < b.len() and b[i] != ':' : (i += 1) {
        let d = b[i];
        if d >= '0' and d <= '9' {
            v = v * 16 + (d - '0') as u32;
        } else if d >= 'a' and d <= 'f' {
            v = v * 16 + (d - 'a' + 10) as u32;
        } else if d >= 'A' and d <= 'F' {
            v = v * 16 + (d - 'A' + 10) as u32;
        }
    }
    return v & 0xFFFF;
}

/// Whether host is this machine: localhost, or a loopback address.
fn loopback(host: str, a: alloc.Allocator) -> bool {
    if lower(host, a: a).view().eq("localhost") or host.eq("::1") {
        return true;
    }
    match ipv4(host) {
        some(ip) => { return (ip >> 24) == 127; }
        none => { return false; }
    }
}

/// Whether host, in lower case, names this machine or a private network
/// by address: localhost, loopback, RFC 1918, link-local, unspecified,
/// and IPv6's unique-local and link-local.
fn local(host: str) -> bool {
    let suffix = ".localhost";
    if host.eq("localhost") or (host.len() > suffix.len() and host[host.len() - suffix.len()..host.len()].eq(suffix)) {
        return true;
    }
    match ipv4(host) {
        some(ip) => {
            let first = ip >> 24;
            let second = (ip >> 16) & 0xFF;
            return first == 127 or first == 10 or (first == 172 and second >= 16 and second <= 31) or (first == 192 and second == 168) or (first == 169 and second == 254) or ip == 0;
        }
        none => { }
    }
    var colons: u32 = 0;
    for d in host.bytes() {
        if d.* == ':' {
            colons += 1;
        }
    }
    if colons < 2 {
        return false;
    }
    if host.eq("::1") or host.eq("::") {
        return true;
    }
    let first = ipv6_first(host);
    return (first & 0xFE00) == 0xFC00 or (first & 0xFFC0) == 0xFE80;
}

fn str_val(s: str, a: alloc.Allocator) -> c.Val {
    return c.Val.Str { v: alloc.String.from(s, a) };
}

fn int_val(v: u64) -> c.Val {
    return c.Val.Int { v: v };
}

fn bool_val(v: bool) -> c.Val {
    return c.Val.Bool { v: v };
}

fn some_val(v: c.Val, a: alloc.Allocator) -> c.Val {
    var p = alloc.List(c.Val).init(a);
    p.push(v);
    return c.Val.Variant { case: 1, payload: p };
}

fn nothing(a: alloc.Allocator) -> c.Val {
    return c.Val.Variant { case: 0, payload: alloc.List(c.Val).init(a) };
}

/// result<_, string>: ok, or err with why.
fn done(why: str, a: alloc.Allocator) -> c.Val {
    if why.len() == 0 {
        return c.Val.Variant { case: 0, payload: alloc.List(c.Val).init(a) };
    }
    var p = alloc.List(c.Val).init(a);
    p.push(str_val(why, a));
    return c.Val.Variant { case: 1, payload: p };
}

fn node_list(nodes: &alloc.List(u32), a: alloc.Allocator) -> c.Val {
    var items = alloc.List(c.Val).init(a);
    for n in nodes.items() {
        items.push(int_val(n.* as u64));
    }
    return c.Val.List { items: items };
}

// ---- drawing ------------------------------------------------------------------------

/// What the app sends, counted against the frame's limits.
fn spend(ui: &mut Ui, bytes: usize) -> exec.Trap!void {
    ui.sent_cmds += 1;
    ui.sent_bytes += bytes as u64;
    if ui.sent_cmds > MAX_FRAME_CMDS or ui.sent_bytes > MAX_FRAME_BYTES {
        ui.exceeded = true;
        return exec.Trap.HostLimit;
    }
}

/// A widget for the screen; its index is the next button's or field's when
/// it is one, or the next group's.
fn widget(ui: &mut Ui, kind: u32, text: str, detail: str, value: u64) -> u32 {
    var index = NONE;
    if kind == BUTTON or kind == TILE or kind == CHECKBOX {
        index = ui.buttons;
        ui.buttons += 1;
    } else if kind == FIELD or kind == SEARCH or kind == CHOICE {
        index = ui.fields;
        ui.fields += 1;
    } else if kind == BEGIN {
        index = ui.groups;
        ui.groups += 1;
    }
    ui.widgets.push(Widget { kind: kind, text: alloc.String.from(text, ui.a), detail: alloc.String.from(detail, ui.a), value: value, depth: ui.depth, index: index });
    return index;
}

/// A group's kind as the shell draws it: what it does not know is a column.
fn group_kind(kind: str) -> str {
    if kind.eq("row") or kind.eq("section") or kind.eq("scroll") {
        return kind;
    }
    return "column";
}

/// A fraction's f32 bits, NaN as 0 and the rest clamped to 0..1.
fn fraction_bits(v: &c.Val) -> u64 {
    var bits: u32 = 0;
    match v {
        .F32 { bits: b } => { bits = b.*; }
        _ => { }
    }
    let exp = (bits >> 23) & 0xFF;
    if exp == 0xFF and (bits & 0x7FFFFF) != 0 {
        return 0;
    }
    if (bits & 0x80000000) != 0 {
        return 0;
    }
    if bits > 0x3F800000 {
        return 0x3F800000;
    }
    return bits as u64;
}

/// A fraction's percent, as Nimadir's headless runner says it: the f32
/// times 100, rounded to the f32 it makes, then to a whole number, half to
/// even.
pub fn percent(bits: u64) -> u64 {
    let e = ((bits >> 23) & 0xFF) as i64;
    var m = bits & 0x7FFFFF;
    if e == 0 and m == 0 {
        return 0;
    }
    var ex: i64 = e - 150;
    if e == 0 {
        ex = -149;
    } else {
        m |= 0x800000;
    }
    // m * 100 * 2^ex, its mantissa rounded to 24 bits, half to even.
    var p = m * 100;
    var len: i64 = 0;
    var t = p;
    while t > 0 : (t >>= 1) {
        len += 1;
    }
    if len > 24 {
        let sh = (len - 24) as u64;
        let one: u64 = 1;
        let q = p >> sh;
        let r = p & ((one << sh) - 1);
        let half = one << (sh - 1);
        p = q;
        if r > half or (r == half and (q & 1) == 1) {
            p += 1;
        }
        ex += sh as i64;
    }
    if ex >= 0 {
        return p << (ex as u64);
    }
    let sh = (0 - ex) as u64;
    if sh > 40 {
        return 0;
    }
    let one: u64 = 1;
    let q = p >> sh;
    let r = p & ((one << sh) - 1);
    let half = one << (sh - 1);
    if r > half or (r == half and (q & 1) == 1) {
        return q + 1;
    }
    return q;
}

/// Text made visible, as Nimadir's log keeps it: control characters and
/// the bidirectional ones as \u{...}.
fn visible(text: str, out: &mut alloc.String) {
    let b = text.bytes();
    var i: usize = 0;
    while i < b.len() {
        var end = i + 1;
        while end < b.len() and (b[end] & 0xC0) == 0x80 {
            end += 1;
        }
        let cp = code_point(b[i..end]);
        if cp < 0x20 or (cp >= 0x7F and cp < 0xA0) or cp == 0x61C or cp == 0x200E or cp == 0x200F or (cp >= 0x202A and cp <= 0x202E) or (cp >= 0x2066 and cp <= 0x2069) {
            out.push_str("\\u{");
            push_hex(out, v: cp);
            out.push_str("}");
        } else {
            out.push_str(text[i..end]);
        }
        i = end;
    }
}

/// The code point of one UTF-8 character's bytes.
fn code_point(b: []u8) -> u32 {
    if b.len() == 1 {
        return b[0] as u32;
    }
    var cp: u32 = 0;
    if b.len() == 2 {
        cp = (b[0] & 0x1F) as u32;
    } else if b.len() == 3 {
        cp = (b[0] & 0x0F) as u32;
    } else {
        cp = (b[0] & 0x07) as u32;
    }
    var k: usize = 1;
    while k < b.len() : (k += 1) {
        cp = (cp << 6) | (b[k] & 0x3F) as u32;
    }
    return cp;
}

fn push_hex(out: &mut alloc.String, v: u32) {
    let digits = "0123456789abcdef";
    var shift: u32 = 28;
    var started = false;
    while true {
        let d = (v >> shift) & 0xF;
        if d != 0 or started or shift == 0 {
            out.push_ascii(digits.bytes()[d as usize]);
            started = true;
        }
        if shift == 0 {
            break;
        }
        shift -= 4;
    }
}

fn storage_used(ui: &Ui) -> u64 {
    var n: u64 = 0;
    var i: usize = 0;
    while i < ui.keys.len() : (i += 1) {
        n += ui.keys.items()[i].len() as u64 + ui.values.items()[i].len() as u64;
    }
    return n;
}

fn storage_index(ui: &Ui, key: str) -> ?usize {
    var i: usize = 0;
    while i < ui.keys.len() : (i += 1) {
        if ui.keys.items()[i].view().eq(key) {
            return i;
        }
    }
    return none;
}

fn app_entry(name: str, source: str, about: str, a: alloc.Allocator) -> c.Val {
    var fields = alloc.List(c.Val).init(a);
    fields.push(str_val(name, a));
    fields.push(str_val(source, a));
    fields.push(str_val(about, a));
    return c.Val.List { items: fields };
}

/// A whole number, written in decimal; none for anything else.
fn whole_number(s: str) -> ?u64 {
    if s.len() == 0 or s.len() > 10 {
        return none;
    }
    var n: u64 = 0;
    for b in s.bytes() {
        if b.* < '0' or b.* > '9' {
            return none;
        }
        n = n * 10 + (b.* - '0') as u64;
    }
    return n;
}

/// The big-endian u32 at b[at..at + 4].
fn be32(b: []u8, at: usize) -> u32 {
    return (b[at] as u32 << 24) | (b[at + 1] as u32 << 16) | (b[at + 2] as u32 << 8) | b[at + 3] as u32;
}

/// An image the app hands over, decoded and kept; why not, into why. Its
/// size is read from the header first, so a few bytes that claim a huge
/// image cost nothing.
fn load_image(ui: &mut Ui, bytes: []u8, why: &mut alloc.String) {
    let sig: [8]u8 = [137, 80, 78, 71, 13, 10, 26, 10];
    var is_png = bytes.len() >= 24;
    var i: usize = 0;
    while is_png and i < 8 : (i += 1) {
        if bytes[i] != sig[i] {
            is_png = false;
        }
    }
    if not is_png {
        why.push_str("not an image this shell reads (PNG)");
        return;
    }
    let w = be32(bytes, at: 16);
    let h = be32(bytes, at: 20);
    if w > MAX_IMAGE_SIDE or h > MAX_IMAGE_SIDE {
        why.push_str("image is ");
        why.push_u64(w as u64);
        why.push_str(" x ");
        why.push_u64(h as u64);
        why.push_str("; the most is 4096 on a side");
        return;
    }
    if ui.pixels + (w as u64) * (h as u64) > MAX_APP_PIXELS {
        why.push_str("an app's images may hold 8 megapixels in all");
        return;
    }
    match png.decode(bytes, max_pixels: (w as u64) * (h as u64), ui.a) {
        ok(img) => {
            ui.pixels += (img.width as u64) * (img.height as u64);
            ui.pictures.push(img);
        }
        err(_) => { why.push_str("could not decode the image"); }
    }
}

fn host_api(ui: &mut Ui, func: str, args: &alloc.List(c.Val)) -> exec.Trap!c.Val {
    let a = ui.a;
    if func.eq("log") {
        try spend(ui, bytes: text_arg(args, i: 0).len());
        var line = alloc.String.init(a);
        visible(text_arg(args, i: 0), out: &mut line);
        ui.logs.push(line);
        return c.Val.Unit;
    }
    if func.eq("ui-label") {
        try spend(ui, bytes: text_arg(args, i: 0).len());
        _ = widget(ui, kind: LABEL, text: text_arg(args, i: 0), detail: "", value: 0);
        return c.Val.Unit;
    }
    if func.eq("ui-separator") {
        try spend(ui, bytes: 0);
        _ = widget(ui, kind: SEPARATOR, text: "", detail: "", value: 0);
        return c.Val.Unit;
    }
    if func.eq("ui-heading") {
        try spend(ui, bytes: text_arg(args, i: 0).len());
        // Clamped: a level of 9 is a typo, not worth a trap.
        var level = int_arg(args, i: 1) & 0xFF;
        if level < 1 {
            level = 1;
        }
        if level > 3 {
            level = 3;
        }
        _ = widget(ui, kind: HEADING, text: text_arg(args, i: 0), detail: "", value: level);
        return c.Val.Unit;
    }
    if func.eq("ui-button") or func.eq("ui-tile") {
        var kind = BUTTON;
        var detail = "";
        if func.eq("ui-tile") {
            kind = TILE;
            detail = text_arg(args, i: 1);
        }
        try spend(ui, bytes: text_arg(args, i: 0).len() + detail.len());
        let i = widget(ui, kind: kind, text: text_arg(args, i: 0), detail: detail, value: 0);
        return bool_val(has(&ui.clicked, x: i));
    }
    if func.eq("ui-checkbox") {
        try spend(ui, bytes: text_arg(args, i: 0).len());
        let i = ui.buttons;
        let checked = (int_arg(args, i: 1) != 0) != has(&ui.clicked, x: i);
        var v: u64 = 0;
        if checked {
            v = 1;
        }
        _ = widget(ui, kind: CHECKBOX, text: text_arg(args, i: 0), detail: "", value: v);
        return bool_val(checked);
    }
    if func.eq("ui-text-edit") or func.eq("ui-search-field") {
        var kind = FIELD;
        var detail = "";
        if func.eq("ui-search-field") {
            kind = SEARCH;
            detail = text_arg(args, i: 1);
        }
        // What the user typed, else what the app holds; and what the app
        // holds when it hands the field other text than it was given, as
        // it does to clear what was sent.
        let i = ui.fields;
        let held = text_arg(args, i: 0);
        var current = alloc.String.from(held, a);
        match edit_of(ui, i: i) {
            some(k) => {
                if ui.gave_yet.items()[k] and not held.eq(ui.gave.items()[k].view()) and not held.eq(ui.edits.items()[k].view()) {
                    drop_edit(ui, k: k);
                } else {
                    current = alloc.String.from(ui.edits.items()[k].view(), a);
                    ui.gave.items_mut()[k] = alloc.String.from(current.view(), ui.a);
                    ui.gave_yet.items_mut()[k] = true;
                }
            }
            none => { }
        }
        try spend(ui, bytes: current.len() + detail.len());
        _ = widget(ui, kind: kind, text: current.view(), detail: detail, value: 0);
        ui.last_field = i;
        return c.Val.Str { v: current };
    }
    if func.eq("ui-choice") {
        // The options, a line each.
        var options = alloc.String.init(a);
        var count: u64 = 0;
        var size: usize = 0;
        match &args.items()[0] {
            .List { items } => {
                for o in items.items() {
                    match o {
                        .Str { v } => {
                            options.push_str(v.view());
                            options.push_str("\n");
                            size += v.len();
                        }
                        _ => { }
                    }
                    count += 1;
                }
            }
            _ => { }
        }
        try spend(ui, bytes: size);
        // The user's pick, when it is one of them; else the app's, when it
        // is; else the first.
        let i = ui.fields;
        var selected = int_arg(args, i: 1) & 0xFFFFFFFF;
        if selected >= count {
            selected = 0;
        }
        match edit_of(ui, i: i) {
            some(k) => {
                match whole_number(ui.edits.items()[k].view()) {
                    some(n) => {
                        if n < count {
                            selected = n;
                        }
                    }
                    none => { }
                }
            }
            none => { }
        }
        _ = widget(ui, kind: CHOICE, text: "", detail: options.view(), value: selected);
        ui.last_field = NONE;
        return int_val(selected);
    }
    if func.eq("ui-progress") {
        try spend(ui, bytes: 0);
        _ = widget(ui, kind: PROGRESS, text: "", detail: "", value: fraction_bits(&args.items()[0]));
        return c.Val.Unit;
    }
    if func.eq("ui-image") {
        try spend(ui, bytes: 0);
        let h = int_arg(args, i: 0);
        if h < ui.pictures.len() as u64 {
            _ = widget(ui, kind: IMAGE, text: "", detail: "", value: h);
        }
        return c.Val.Unit;
    }
    if func.eq("ui-submitted") {
        return bool_val(ui.last_field != NONE and has(&ui.submits, x: ui.last_field));
    }
    if func.eq("ui-begin") {
        try spend(ui, bytes: 0);
        ui.depth += 1;
        if ui.depth <= MAX_NESTING {
            // Its widgets are one deeper than it.
            ui.depth -= 1;
            _ = widget(ui, kind: BEGIN, text: group_kind(text_arg(args, i: 0)), detail: "", value: 0);
            ui.depth += 1;
        }
        return c.Val.Unit;
    }
    if func.eq("ui-end") {
        try spend(ui, bytes: 0);
        if ui.depth == 0 {
            return c.Val.Unit;
        }
        if ui.depth <= MAX_NESTING {
            ui.depth -= 1;
            _ = widget(ui, kind: END, text: "", detail: "", value: 0);
            return c.Val.Unit;
        }
        ui.depth -= 1;
        return c.Val.Unit;
    }
    if func.eq("now-millis") {
        return int_val(ui.now_ms as% u64);
    }
    if func.eq("list-apps") {
        var items = alloc.List(c.Val).init(a);
        var k: usize = 0;
        while k + 2 < ui.apps.len() : (k += 3) {
            items.push(app_entry(name: ui.apps.items()[k].view(), source: ui.apps.items()[k + 1].view(), about: ui.apps.items()[k + 2].view(), a));
        }
        return c.Val.List { items: items };
    }
    if func.eq("open-app") {
        // The last one asked for in a frame is the one.
        ui.open_request = alloc.String.from(text_arg(args, i: 0), a);
        return c.Val.Unit;
    }
    if func.eq("request-frame") {
        // The soonest asked for, and none sooner than MIN_FRAME_MS.
        var ms = (int_arg(args, i: 0) & 0xFFFFFFFF) as u32;
        if ms < MIN_FRAME_MS {
            ms = MIN_FRAME_MS;
        }
        if ui.frame_after == NONE or ms < ui.frame_after {
            ui.frame_after = ms;
        }
        return c.Val.Unit;
    }
    if func.eq("storage-get") {
        let i = storage_index(ui, key: text_arg(args, i: 0)) orelse return nothing(a);
        return some_val(str_val(ui.values.items()[i].view(), a), a);
    }
    if func.eq("storage-set") {
        let key = text_arg(args, i: 0);
        let value = text_arg(args, i: 1);
        var used = storage_used(ui);
        let at = storage_index(ui, key: key);
        match at {
            some(i) => { used -= ui.keys.items()[i].len() as u64 + ui.values.items()[i].len() as u64; }
            none => { }
        }
        if used + key.len() as u64 + value.len() as u64 > MAX_STORAGE {
            return done("storage is full: 1 MiB per app", a);
        }
        match at {
            some(i) => { ui.values.items_mut()[i] = alloc.String.from(value, a); }
            none => {
                ui.keys.push(alloc.String.from(key, a));
                ui.values.push(alloc.String.from(value, a));
            }
        }
        ui.storage_changed = true;
        return done("", a);
    }
    if func.eq("storage-remove") {
        match storage_index(ui, key: text_arg(args, i: 0)) {
            some(i) => {
                ui.keys.items_mut()[i] = alloc.String.init(a);
                ui.values.items_mut()[i] = alloc.String.init(a);
                ui.storage_changed = true;
            }
            none => { }
        }
        return c.Val.Unit;
    }
    if func.eq("storage-keys") {
        // In order of their bytes, as Nimadir's shell keeps them (a
        // BTreeMap), whatever order they were set in.
        var keys = alloc.List(u32).init(a);
        var i: u32 = 0;
        while (i as usize) < ui.keys.len() : (i += 1) {
            if ui.keys.items()[i as usize].len() > 0 {
                keys.push(i);
            }
        }
        let ks = keys.items_mut();
        var j: usize = 1;
        while j < ks.len() : (j += 1) {
            var m = j;
            while m > 0 and bytes_before(x: ui.keys.items()[ks[m] as usize].view(), y: ui.keys.items()[ks[m - 1] as usize].view()) {
                let keep = ks[m];
                ks[m] = ks[m - 1];
                ks[m - 1] = keep;
                m -= 1;
            }
        }
        var items = alloc.List(c.Val).init(a);
        for k in keys.items() {
            items.push(str_val(ui.keys.items()[k.* as usize].view(), a));
        }
        return c.Val.List { items: items };
    }
    if func.eq("image-load") {
        var bytes = alloc.List(u8).init(a);
        match &args.items()[0] {
            .List { items } => {
                for v in items.items() {
                    match v {
                        .Int { v: x } => { bytes.push(x.* as u8); }
                        _ => { }
                    }
                }
            }
            _ => { }
        }
        try spend(ui, bytes: bytes.len());
        var why = alloc.String.init(a);
        load_image(ui, bytes: bytes.items(), why: &mut why);
        if why.len() > 0 {
            var p = alloc.List(c.Val).init(a);
            p.push(c.Val.Str { v: why });
            return c.Val.Variant { case: 1, payload: p };
        }
        var p = alloc.List(c.Val).init(a);
        p.push(int_val((ui.pictures.len() - 1) as u64));
        return c.Val.Variant { case: 0, payload: p };
    }
    if func.eq("fetch") {
        // Refused as Nimadir's shell refuses it (host/src/net.rs), in its
        // order; else made by the shell (take_outgoing), its number given.
        var why = alloc.String.init(a);
        refusal(ui, url: url_of(args), size: body_len(args), why: &mut why, a: a);
        if why.len() > 0 {
            return done(why.view(), a);
        }
        let id = ui.next_request;
        ui.next_request += 1;
        ui.outgoing.push(outgoing_of(args, id: id, a: ui.a));
        ui.under_way.push(id);
        var p = alloc.List(c.Val).init(a);
        p.push(int_val(id as u64));
        return c.Val.Variant { case: 0, payload: p };
    }
    if func.eq("fetch-poll") {
        // Its answer, once; none while it is under way.
        let id = (int_arg(args, i: 0) & 0xFFFFFFFF) as u32;
        var k: usize = 0;
        while k < ui.replies.len() : (k += 1) {
            if ui.replies.items()[k].id == id {
                let answer = reply_val(&ui.replies.items()[k], a: a);
                ui.replies.items_mut()[k].id = 0;
                return some_val(answer, a);
            }
        }
        for u in ui.under_way.items() {
            if u.* == id {
                return nothing(a);
            }
        }
        var why = alloc.String.from("no request numbered ", a);
        why.push_u64(id as u64);
        return some_val(done(why.view(), a), a);
    }
    if func.eq("locale") {
        return str_val(ui.locale.view(), a);
    }
    if func.eq("time-zone") {
        return str_val(ui.time_zone.view(), a);
    }
    if func.eq("utc-offset") {
        return int_val(ui.utc_offset as% u64);
    }
    if func.eq("app-info") {
        var fields = alloc.List(c.Val).init(a);
        fields.push(str_val("", a));
        fields.push(str_val("", a));
        return c.Val.List { items: fields };
    }
    return exec.Trap.HostTrap;
}

// ---- the element tree -------------------------------------------------------------------

fn live(ui: &Ui, n: u64) -> bool {
    return n > 0 and n < ui.nodes.len() as u64 and ui.nodes.items()[n as usize].alive;
}

fn attr_index(node: &Node, name: str) -> ?usize {
    var i: usize = 0;
    while i < node.names.len() : (i += 1) {
        if node.names.items()[i].view().eq(name) {
            return i;
        }
    }
    return none;
}

fn set_attr(ui: &mut Ui, n: u32, name: str, value: str) {
    let a = ui.a;
    match attr_index(&ui.nodes.items()[n as usize], name: name) {
        some(i) => { ui.nodes.items_mut()[n as usize].values.items_mut()[i] = alloc.String.from(value, a); }
        none => {
            ui.nodes.items_mut()[n as usize].names.push(alloc.String.from(name, a));
            ui.nodes.items_mut()[n as usize].values.push(alloc.String.from(value, a));
        }
    }
}

fn detach(ui: &mut Ui, n: u32) {
    let p = ui.nodes.items()[n as usize].parent;
    if p == 0 {
        return;
    }
    var kept = alloc.List(u32).init(ui.a);
    for x in ui.nodes.items()[p as usize].children.items() {
        if x.* != n {
            kept.push(x.*);
        }
    }
    ui.nodes.items_mut()[p as usize].children = kept;
    ui.nodes.items_mut()[n as usize].parent = 0;
}

fn inside(ui: &Ui, n: u32, of: u32) -> bool {
    var at = of;
    while at != 0 {
        if at == n {
            return true;
        }
        at = ui.nodes.items()[at as usize].parent;
    }
    return false;
}

fn append(ui: &mut Ui, parent: u32, child: u32) {
    if inside(ui, n: child, of: parent) or ui.nodes.items()[parent as usize].tag.len() == 0 {
        return;
    }
    detach(ui, n: child);
    ui.nodes.items_mut()[parent as usize].children.push(child);
    ui.nodes.items_mut()[child as usize].parent = parent;
}

fn release(ui: &mut Ui, n: u32) {
    detach(ui, n: n);
    var stack = alloc.List(u32).init(ui.a);
    stack.push(n);
    while stack.len() > 0 {
        let x = stack.pop() orelse 0;
        ui.nodes.items_mut()[x as usize].alive = false;
        for k in ui.nodes.items()[x as usize].children.items() {
            stack.push(k.*);
        }
    }
}

fn clear_children(ui: &mut Ui, n: u32) {
    while ui.nodes.items()[n as usize].children.len() > 0 {
        let k = ui.nodes.items()[n as usize].children.items()[0];
        release(ui, n: k);
    }
}

fn text_content(ui: &Ui, n: u32, out: &mut alloc.String) {
    let node = &ui.nodes.items()[n as usize];
    if node.tag.len() == 0 {
        out.push_str(node.text.view());
        return;
    }
    for k in node.children.items() {
        text_content(ui, n: k.*, out: out);
    }
}

fn make_node(ui: &mut Ui, tag: str) -> exec.Trap!u32 {
    if ui.nodes.len() >= MAX_NODES {
        ui.exceeded = true;
        return exec.Trap.HostLimit;
    }
    return new_node(ui, tag: tag);
}

fn name_byte(b: u8) -> bool {
    return (b >= 'a' and b <= 'z') or (b >= 'A' and b <= 'Z') or (b >= '0' and b <= '9') or b == '-' or b == '_' or b == ':';
}

/// A whole number as an f32's bits.
fn f32_of(v: i32) -> c.Val {
    if v == 0 {
        return c.Val.F32 { bits: 0 };
    }
    var sign: u32 = 0;
    var m = v as i64;
    if m < 0 {
        sign = 0x80000000;
        m = -m;
    }
    var e: u32 = 0;
    var t = m;
    while t > 1 {
        t = t >> 1;
        e += 1;
    }
    // The bits below the leading one, in the 23 of the mantissa.
    var frac: u64 = 0;
    if e <= 23 {
        frac = ((m as u64) << (23 - e)) & 0x7FFFFF;
    } else {
        frac = ((m as u64) >> (e - 23)) & 0x7FFFFF;
    }
    return c.Val.F32 { bits: sign | ((e + 127) << 23) | (frac as u32) };
}

/// The class name added to n's class attribute, or taken away.
fn toggle_class(ui: &mut Ui, n: u32, name: str, on: bool) {
    var kept = alloc.String.init(ui.a);
    var classes = alloc.String.init(ui.a);
    match attr_index(&ui.nodes.items()[n as usize], name: "class") {
        some(k) => { classes = alloc.String.from(ui.nodes.items()[n as usize].values.items()[k].view(), ui.a); }
        none => { }
    }
    let b = classes.view().bytes();
    var c0: usize = 0;
    while c0 < b.len() {
        var c1 = c0;
        while c1 < b.len() and b[c1] != ' ' {
            c1 += 1;
        }
        let one = classes.view()[c0..c1];
        if one.len() > 0 and not one.eq(name) {
            if kept.len() > 0 {
                kept.push_str(" ");
            }
            kept.push_str(one);
        }
        c0 = c1 + 1;
    }
    if on {
        if kept.len() > 0 {
            kept.push_str(" ");
        }
        kept.push_str(name);
    }
    set_attr(ui, n: n, name: "class", value: kept.view());
}

/// One property of n's inline style set, or taken out when value is empty.
fn set_style(ui: &mut Ui, n: u32, property: str, value: str) {
    var out = alloc.String.init(ui.a);
    match attr_index(&ui.nodes.items()[n as usize], name: "style") {
        some(k) => {
            let style = alloc.String.from(ui.nodes.items()[n as usize].values.items()[k].view(), ui.a);
            let b = style.view().bytes();
            var d0: usize = 0;
            while d0 < b.len() {
                var d1 = d0;
                while d1 < b.len() and b[d1] != ';' {
                    d1 += 1;
                }
                let decl = style.view()[d0..d1];
                var colon: usize = 0;
                while colon < decl.len() and decl.bytes()[colon] != ':' {
                    colon += 1;
                }
                let name = trim(decl[0..colon]);
                if name.len() > 0 and not name.eq(property) {
                    out.push_str(trim(decl));
                    out.push_str("; ");
                }
                d0 = d1 + 1;
            }
        }
        none => { }
    }
    if value.len() > 0 {
        out.push_str(property);
        out.push_str(": ");
        out.push_str(value);
        out.push_str("; ");
    }
    set_attr(ui, n: n, name: "style", value: trim(out.view()));
}

fn trim(s: str) -> str {
    let b = s.bytes();
    var i: usize = 0;
    var j = b.len();
    while i < j and (b[i] == ' ' or b[i] == '\n' or b[i] == '\t') {
        i += 1;
    }
    while j > i and (b[j - 1] == ' ' or b[j - 1] == '\n' or b[j - 1] == '\t') {
        j -= 1;
    }
    return s[i..j];
}

fn bytes_eq(b: []u8, s: str) -> bool {
    return same_bytes(x: b, y: s.bytes());
}

fn same_bytes(x: []u8, y: []u8) -> bool {
    if x.len() != y.len() {
        return false;
    }
    var i: usize = 0;
    while i < x.len() : (i += 1) {
        if x[i] != y[i] {
            return false;
        }
    }
    return true;
}

/// Elements that never have content, so never a closing tag, as Nimadir's
/// shell has them (host/src/dom/markup.rs).
fn is_void(tag: str) -> bool {
    return tag.eq("br") or tag.eq("hr") or tag.eq("img") or tag.eq("input") or tag.eq("meta") or tag.eq("link") or tag.eq("area") or tag.eq("base") or tag.eq("col") or tag.eq("embed") or tag.eq("source") or tag.eq("track") or tag.eq("wbr");
}

/// How deep markup nests at most, as Nimadir's document does.
const MARKUP_DEPTH: usize = 256;

/// A node of markup read, not yet in the document: an element's tag
/// (empty for a text) and attributes, or a text; and its parent among
/// them, NO_PARENT for one at the top.
type Parsed = struct {
    tag: alloc.String,
    text: alloc.String,
    names: alloc.List(alloc.String),
    values: alloc.List(alloc.String),
    parent: u32,
}

const NO_PARENT: u32 = 0xFFFFFFFF;

/// Where at is in src, as a person counts: "line 3, column 7".
fn place(src: str, at: usize, out: &mut alloc.String) {
    let b = src.bytes();
    var end = at;
    if end > b.len() {
        end = b.len();
    }
    var line: u64 = 1;
    var column: u64 = 1;
    var i: usize = 0;
    while i < end : (i += 1) {
        if b[i] == '\n' {
            line += 1;
            column = 1;
        } else if (b[i] & 0xC0) != 0x80 {
            column += 1;
        }
    }
    out.push_str("line ");
    out.push_u64(line);
    out.push_str(", column ");
    out.push_u64(column);
}

fn is_space(b: u8) -> bool {
    return b == ' ' or b == '\t' or b == '\n' or b == '\r' or b == 0x0B or b == 0x0C;
}

/// Whether b is part of a tag's name: a letter, a digit, - _ or :, or a
/// byte of a character past ASCII.
fn tag_byte(b: u8) -> bool {
    return name_byte(b) or b >= 0x80;
}

/// Where what is first at or after from in s; none for nowhere.
fn find_in(s: str, from: usize, what: str) -> ?usize {
    let b = s.bytes();
    let w = what.bytes();
    var at = from;
    while at + w.len() <= b.len() : (at += 1) {
        if s[at..at + w.len()].eq(what) {
            return at;
        }
    }
    return none;
}

/// s in ASCII lower case.
fn lowered(s: str, a: alloc.Allocator) -> alloc.String {
    var out = alloc.String.init(a);
    var i: usize = 0;
    let b = s.bytes();
    while i < b.len() {
        var end = i + 1;
        while end < b.len() and (b[end] & 0xC0) == 0x80 {
            end += 1;
        }
        if end == i + 1 and b[i] >= 'A' and b[i] <= 'Z' {
            out.push_ascii(b[i] + 32);
        } else {
            _ = out.push_utf8(b[i..end]);
        }
        i = end;
    }
    return out;
}

/// s without the spaces at its ends.
fn trimmed(s: str) -> str {
    let b = s.bytes();
    var from: usize = 0;
    var to = b.len();
    while from < to and is_space(b[from]) {
        from += 1;
    }
    while to > from and is_space(b[to - 1]) {
        to -= 1;
    }
    return s[from..to];
}

/// Text with its entities put back, onto out, as Nimadir reads them:
/// &amp; &lt; &gt; &quot; &apos; &nbsp; &mdash; &ndash; &hellip; &copy;
/// &times;, and &#NN; and &#xHH;. One it does not know stays as written.
fn decode(s: str, out: &mut alloc.String) {
    let b = s.bytes();
    var i: usize = 0;
    while i < b.len() {
        if b[i] == '&' {
            var semi = i + 1;
            while semi < b.len() and b[semi] != ';' {
                semi += 1;
            }
            if semi < b.len() and semi - i <= 10 {
                let name = s[i + 1..semi];
                var cp: u32 = 0xFFFFFFFF;
                if name.eq("amp") {
                    cp = 0x26;
                } else if name.eq("lt") {
                    cp = 0x3C;
                } else if name.eq("gt") {
                    cp = 0x3E;
                } else if name.eq("quot") {
                    cp = 0x22;
                } else if name.eq("apos") {
                    cp = 0x27;
                } else if name.eq("nbsp") {
                    cp = 0xA0;
                } else if name.eq("mdash") {
                    cp = 0x2014;
                } else if name.eq("ndash") {
                    cp = 0x2013;
                } else if name.eq("hellip") {
                    cp = 0x2026;
                } else if name.eq("copy") {
                    cp = 0xA9;
                } else if name.eq("times") {
                    cp = 0xD7;
                } else if name.starts_with("#x") or name.starts_with("#X") {
                    cp = number(name[2..name.len()], base: 16);
                } else if name.starts_with("#") {
                    cp = number(name[1..name.len()], base: 10);
                }
                if cp <= 0x10FFFF and (cp < 0xD800 or cp > 0xDFFF) {
                    var buf: [4]u8 = [0, 0, 0, 0];
                    let n = utf8.encode(cp, buf[0..4]);
                    _ = out.push_utf8(buf[0..n]);
                    i = semi + 1;
                    continue;
                }
            }
        }
        // One whole character at a time keeps the string UTF-8.
        var end = i + 1;
        while end < b.len() and (b[end] & 0xC0) == 0x80 {
            end += 1;
        }
        _ = out.push_utf8(b[i..end]);
        i = end;
    }
}

/// digits as a number in base; 0xFFFFFFFF for what is none, or too large.
fn number(digits: str, base: u32) -> u32 {
    let b = digits.bytes();
    if b.len() == 0 {
        return 0xFFFFFFFF;
    }
    var v: u64 = 0;
    for d in b {
        var x: u32 = 99;
        if d.* >= '0' and d.* <= '9' {
            x = (d.* - '0') as u32;
        } else if d.* >= 'a' and d.* <= 'f' {
            x = (d.* - 'a' + 10) as u32;
        } else if d.* >= 'A' and d.* <= 'F' {
            x = (d.* - 'A' + 10) as u32;
        }
        if x >= base {
            return 0xFFFFFFFF;
        }
        v = v * base as u64 + x as u64;
        if v > 0xFFFFFFFF {
            return 0xFFFFFFFF;
        }
    }
    return v as u32;
}

/// The opening tag at start: its name into tag, its attributes into
/// names and values (the first of a name kept), whether it closes itself
/// into closes; how long it is. Why it cannot be read, into why.
fn open_tag(src: str, start: usize, tag: &mut alloc.String, names: &mut alloc.List(alloc.String), values: &mut alloc.List(alloc.String), closes: &mut bool, why: &mut alloc.String, a: alloc.Allocator) -> usize {
    let b = src.bytes();
    var j = start + 1;
    while j < b.len() and tag_byte(b[j]) {
        j += 1;
    }
    tag.* = lowered(src[start + 1..j], a: a);
    if tag.len() == 0 {
        why.push_str("`<` begins no tag, at ");
        place(src, at: start, out: why);
        return 0;
    }
    while true {
        while j < b.len() and is_space(b[j]) {
            j += 1;
        }
        if j >= b.len() {
            why.push_str("`<");
            why.push_str(tag.view());
            why.push_str("` is never finished, at ");
            place(src, at: start, out: why);
            return 0;
        }
        if b[j] == '>' {
            return j + 1 - start;
        }
        if b[j] == '/' {
            j += 1;
            if j < b.len() and b[j] == '>' {
                closes.* = true;
                return j + 1 - start;
            }
            continue;
        }
        let name_at = j;
        while j < b.len() and not is_space(b[j]) and b[j] != '=' and b[j] != '>' and b[j] != '/' and b[j] != '"' and b[j] != '\'' {
            j += 1;
        }
        if j == name_at {
            why.push_str("an attribute of `<");
            why.push_str(tag.view());
            why.push_str(">` has no name, at ");
            place(src, at: name_at, out: why);
            return 0;
        }
        let name = lowered(src[name_at..j], a: a);
        while j < b.len() and is_space(b[j]) {
            j += 1;
        }
        var value = alloc.String.init(a);
        if j < b.len() and b[j] == '=' {
            j += 1;
            while j < b.len() and is_space(b[j]) {
                j += 1;
            }
            var from = j;
            if j < b.len() and (b[j] == '"' or b[j] == '\'') {
                let q = b[j];
                j += 1;
                from = j;
                while j < b.len() and b[j] != q {
                    j += 1;
                }
                if j >= b.len() {
                    why.push_str("a value in `<");
                    why.push_str(tag.view());
                    why.push_str(">` is never closed, at ");
                    place(src, at: start, out: why);
                    return 0;
                }
                decode(src[from..j], out: &mut value);
                j += 1;
            } else {
                while j < b.len() and not is_space(b[j]) and b[j] != '>' {
                    j += 1;
                }
                decode(src[from..j], out: &mut value);
            }
        }
        var seen = false;
        for n in names.items() {
            if n.view().eq(name.view()) {
                seen = true;
            }
        }
        if not seen {
            names.push(name);
            values.push(value);
        }
    }
    return 0;
}

/// The nodes src describes, in the order a document gets them, onto out,
/// read as Nimadir's shell reads set-markup's: whole before any of it
/// touches the document. Why it cannot be read, into why.
fn read_markup(src: str, out: &mut alloc.List(Parsed), why: &mut alloc.String, a: alloc.Allocator) {
    let b = src.bytes();
    // The open elements, by their place in out, and where each opened.
    var stack = alloc.List(u32).init(a);
    var opened = alloc.List(usize).init(a);
    var i: usize = 0;
    while i < b.len() {
        var top = NO_PARENT;
        if stack.len() > 0 {
            top = stack.items()[stack.len() - 1];
        }
        if b[i] != '<' {
            var end = i;
            while end < b.len() and b[end] != '<' {
                end += 1;
            }
            var text = alloc.String.init(a);
            decode(src[i..end], out: &mut text);
            if text.len() > 0 {
                out.push(Parsed { tag: alloc.String.init(a), text: text, names: alloc.List(alloc.String).init(a), values: alloc.List(alloc.String).init(a), parent: top });
            }
            i = end;
            continue;
        }
        let rest = src[i..b.len()];
        if rest.starts_with("<!--") {
            match find_in(s: src, from: i, what: "-->") {
                some(end) => {
                    i = end + 3;
                    continue;
                }
                none => {
                    why.push_str("a comment is never closed, at ");
                    place(src, at: i, out: why);
                    return;
                }
            }
        }
        if rest.starts_with("<!") or rest.starts_with("<?") {
            match find_in(s: src, from: i, what: ">") {
                some(end) => {
                    i = end + 1;
                    continue;
                }
                none => {
                    why.push_str("`<!` is never closed, at ");
                    place(src, at: i, out: why);
                    return;
                }
            }
        }
        if rest.starts_with("</") {
            match find_in(s: src, from: i + 2, what: ">") {
                some(gt) => {
                    let closing = lowered(trimmed(src[i + 2..gt]), a: a);
                    match stack.pop() {
                        some(open) => {
                            let open_tag_name = out.items()[open as usize].tag.view();
                            if not open_tag_name.eq(closing.view()) {
                                why.push_str("`</");
                                why.push_str(closing.view());
                                why.push_str(">` closes `<");
                                why.push_str(open_tag_name);
                                why.push_str(">`, at ");
                                place(src, at: i, out: why);
                                return;
                            }
                            _ = opened.pop();
                        }
                        none => {
                            why.push_str("`</");
                            why.push_str(closing.view());
                            why.push_str(">` closes nothing, at ");
                            place(src, at: i, out: why);
                            return;
                        }
                    }
                    i = gt + 1;
                    continue;
                }
                none => {
                    why.push_str("a closing tag is never finished, at ");
                    place(src, at: i, out: why);
                    return;
                }
            }
        }
        var tag = alloc.String.init(a);
        var names = alloc.List(alloc.String).init(a);
        var values = alloc.List(alloc.String).init(a);
        var closes = false;
        let len = open_tag(src, start: i, tag: &mut tag, names: &mut names, values: &mut values, closes: &mut closes, why: why, a: a);
        if why.len() > 0 {
            return;
        }
        i += len;
        if tag.view().eq("script") or tag.view().eq("style") {
            // Dropped, with everything up to its closing tag.
            var closing = alloc.String.from("</", a);
            closing.push_str(tag.view());
            let low = lowered(src[i..b.len()], a: a);
            match find_in(s: low.view(), from: 0, what: closing.view()) {
                some(end) => {
                    match find_in(s: src, from: i + end, what: ">") {
                        some(gt) => { i = gt + 1; }
                        none => { i = b.len(); }
                    }
                }
                none => {
                    why.push_str("`<");
                    why.push_str(tag.view());
                    why.push_str(">` is never closed, at ");
                    place(src, at: i, out: why);
                    return;
                }
            }
            continue;
        }
        let empty = closes or is_void(tag.view());
        if not empty and stack.len() >= MARKUP_DEPTH {
            why.push_str("nested more than 256 levels deep, at ");
            place(src, at: i, out: why);
            return;
        }
        if not empty {
            stack.push(out.len() as u32);
            opened.push(i);
        }
        out.push(Parsed { tag: tag, text: alloc.String.init(a), names: names, values: values, parent: top });
    }
    if stack.len() > 0 {
        why.push_str("`<");
        why.push_str(out.items()[stack.items()[stack.len() - 1] as usize].tag.view());
        why.push_str(">` is never closed, opened at ");
        place(src, at: opened.items()[opened.len() - 1], out: why);
    }
}

/// set-markup: the markup read whole, then n's children replaced by what
/// it describes; why it could not be read, or "", when nothing changes.
fn set_markup(ui: &mut Ui, n: u32, markup: str, a: alloc.Allocator) -> exec.Trap!alloc.String {
    var parsed = alloc.List(Parsed).init(a);
    var why = alloc.String.init(a);
    read_markup(markup, out: &mut parsed, why: &mut why, a: a);
    if why.len() > 0 {
        return why;
    }
    clear_children(ui, n: n);
    var made = alloc.List(u32).init(a);
    for p in parsed.items() {
        let k = try make_node(ui, tag: p.tag.view());
        if p.tag.len() == 0 {
            ui.nodes.items_mut()[k as usize].text = alloc.String.from(p.text.view(), ui.a);
        } else {
            var j: usize = 0;
            while j < p.names.len() : (j += 1) {
                set_attr(ui, n: k, name: p.names.items()[j].view(), value: p.values.items()[j].view());
            }
        }
        var parent = n;
        if p.parent != NO_PARENT {
            parent = made.items()[p.parent as usize];
        }
        append(ui, parent: parent, child: k);
        made.push(k);
    }
    return why;
}

/// Whether n matches one compound selector: a tag, #id and .classes.
fn matches_compound(ui: &Ui, n: u32, sel: []u8) -> bool {
    let node = &ui.nodes.items()[n as usize];
    if node.tag.len() == 0 {
        return false;
    }
    var i: usize = 0;
    while i < sel.len() {
        var kind: u8 = 't';
        if sel[i] == '#' or sel[i] == '.' {
            kind = sel[i];
            i += 1;
        }
        let start = i;
        while i < sel.len() and sel[i] != '#' and sel[i] != '.' {
            i += 1;
        }
        let part = sel[start..i];
        if kind == 't' {
            if part.len() > 0 and not bytes_eq(part, node.tag.view()) and not bytes_eq(part, "*") {
                return false;
            }
        } else if kind == '#' {
            match attr_index(node, name: "id") {
                some(k) => {
                    if not bytes_eq(part, node.values.items()[k].view()) {
                        return false;
                    }
                }
                none => { return false; }
            }
        } else {
            var found = false;
            match attr_index(node, name: "class") {
                some(k) => {
                    let classes = node.values.items()[k].view().bytes();
                    var c0: usize = 0;
                    while c0 < classes.len() {
                        var c1 = c0;
                        while c1 < classes.len() and classes[c1] != ' ' {
                            c1 += 1;
                        }
                        if c1 - c0 == part.len() and same_bytes(x: classes[c0..c1], y: part) {
                            found = true;
                        }
                        c0 = c1 + 1;
                    }
                }
                none => { }
            }
            if not found {
                return false;
            }
        }
    }
    return true;
}

/// Whether n matches a selector of compounds parted by spaces, each an
/// ancestor of the next (the descendant combinator), below scope.
fn matches(ui: &Ui, n: u32, sel: []u8, scope: u32) -> bool {
    // The last compound is n's; the ones before match ancestors, in order.
    var end = sel.len();
    while end > 0 and sel[end - 1] == ' ' {
        end -= 1;
    }
    var start = end;
    while start > 0 and sel[start - 1] != ' ' {
        start -= 1;
    }
    if start == end or not matches_compound(ui, n: n, sel: sel[start..end]) {
        return false;
    }
    var at = ui.nodes.items()[n as usize].parent;
    var rest = start;
    while rest > 0 {
        var e = rest;
        while e > 0 and sel[e - 1] == ' ' {
            e -= 1;
        }
        if e == 0 {
            return true;
        }
        var st = e;
        while st > 0 and sel[st - 1] != ' ' {
            st -= 1;
        }
        // The nearest ancestor below scope that matches.
        while at != 0 and at != scope and not matches_compound(ui, n: at, sel: sel[st..e]) {
            at = ui.nodes.items()[at as usize].parent;
        }
        if at == 0 or at == scope {
            return false;
        }
        at = ui.nodes.items()[at as usize].parent;
        rest = st;
    }
    return true;
}

fn query(ui: &Ui, scope: u32, n: u32, sel: []u8, out: &mut alloc.List(u32)) {
    for k in ui.nodes.items()[n as usize].children.items() {
        if matches(ui, n: k.*, sel: sel, scope: scope) {
            out.push(k.*);
        }
        query(ui, scope: scope, n: k.*, sel: sel, out: out);
    }
}

fn first_match(ui: &Ui, sel: str) -> u32 {
    var found = alloc.List(u32).init(ui.a);
    query(ui, scope: 1, n: 1, sel: sel.bytes(), out: &mut found);
    if found.len() == 0 {
        return 0;
    }
    return found.items()[0];
}

fn dom(ui: &mut Ui, func: str, args: &alloc.List(c.Val)) -> exec.Trap!c.Val {
    let a = ui.a;
    if func.eq("root") {
        return int_val(1);
    }
    if func.eq("create-element") {
        return int_val(try make_node(ui, tag: text_arg(args, i: 0)) as u64);
    }
    if func.eq("create-text") {
        let t = try make_node(ui, tag: "");
        ui.nodes.items_mut()[t as usize].text = alloc.String.from(text_arg(args, i: 0), a);
        return int_val(t as u64);
    }
    if func.eq("add-stylesheet") {
        ui.sheets += 1;
        ui.sheet_texts.push(alloc.String.from(text_arg(args, i: 0), a));
        return int_val(ui.sheets as u64);
    }
    if func.eq("remove-stylesheet") {
        let k = int_arg(args, i: 0);
        if k >= 1 and k <= ui.sheet_texts.len() as u64 {
            ui.sheet_texts.items_mut()[(k - 1) as usize] = alloc.String.init(a);
        }
        return c.Val.Unit;
    }
    if func.eq("focus") {
        let n = int_arg(args, i: 0);
        if live(ui, n: n) {
            ui.focused = n as u32;
        }
        return c.Val.Unit;
    }
    if func.eq("events") {
        var items = alloc.List(c.Val).init(a);
        for e in ui.events.items() {
            var fields = alloc.List(c.Val).init(a);
            fields.push(str_val(e.kind.view(), a));
            fields.push(int_val(e.target as u64));
            fields.push(int_val(e.current as u64));
            fields.push(str_val(e.value.view(), a));
            fields.push(c.Val.F32 { bits: 0 });
            fields.push(c.Val.F32 { bits: 0 });
            items.push(c.Val.List { items: fields });
        }
        ui.events.clear();
        return c.Val.List { items: items };
    }
    // The rest name a node first; one that is not a node is ignored.
    let n = int_arg(args, i: 0);
    if not live(ui, n: n) {
        if func.eq("get-attribute") or func.eq("parent") or func.eq("bounds") {
            return nothing(a);
        }
        if func.eq("query-all") or func.eq("children") {
            return c.Val.List { items: alloc.List(c.Val).init(a) };
        }
        if func.eq("value") {
            return str_val("", a);
        }
        if func.eq("set-markup") {
            var not_one = alloc.String.from("#", a);
            not_one.push_u64(n);
            not_one.push_str(" is not an element");
            return done(not_one.view(), a);
        }
        return c.Val.Unit;
    }
    let node = n as u32;
    if func.eq("append-child") or func.eq("insert-before") {
        let child = int_arg(args, i: 1);
        if live(ui, n: child) {
            append(ui, parent: node, child: child as u32);
            if func.eq("insert-before") and live(ui, n: int_arg(args, i: 2)) {
                // Moved to just before the one named.
                let before = int_arg(args, i: 2) as u32;
                var order = alloc.List(u32).init(a);
                for k in ui.nodes.items()[node as usize].children.items() {
                    if k.* == before {
                        order.push(child as u32);
                    }
                    if k.* != child as u32 {
                        order.push(k.*);
                    }
                }
                if order.len() == ui.nodes.items()[node as usize].children.len() {
                    ui.nodes.items_mut()[node as usize].children = order;
                }
            }
        }
        return c.Val.Unit;
    }
    if func.eq("remove") {
        detach(ui, n: node);
        return c.Val.Unit;
    }
    if func.eq("release") {
        release(ui, n: node);
        return c.Val.Unit;
    }
    if func.eq("set-text") {
        if ui.nodes.items()[node as usize].tag.len() == 0 {
            ui.nodes.items_mut()[node as usize].text = alloc.String.from(text_arg(args, i: 1), a);
        } else {
            // An element's children replaced by one text; by none for "",
            // as Nimadir's document does.
            clear_children(ui, n: node);
            if text_arg(args, i: 1).len() > 0 {
                let t = try make_node(ui, tag: "");
                ui.nodes.items_mut()[t as usize].text = alloc.String.from(text_arg(args, i: 1), a);
                append(ui, parent: node, child: t);
            }
        }
        return c.Val.Unit;
    }
    if func.eq("set-attribute") {
        set_attr(ui, n: node, name: text_arg(args, i: 1), value: text_arg(args, i: 2));
        return c.Val.Unit;
    }
    if func.eq("remove-attribute") {
        let name = text_arg(args, i: 1);
        match attr_index(&ui.nodes.items()[node as usize], name: name) {
            some(k) => {
                // Kept in order: the rest move up.
                var names = alloc.List(alloc.String).init(a);
                var values = alloc.List(alloc.String).init(a);
                var i: usize = 0;
                while i < ui.nodes.items()[node as usize].names.len() : (i += 1) {
                    if i != k {
                        names.push(ui.nodes.items()[node as usize].names.items()[i].clone());
                        values.push(ui.nodes.items()[node as usize].values.items()[i].clone());
                    }
                }
                ui.nodes.items_mut()[node as usize].names = names;
                ui.nodes.items_mut()[node as usize].values = values;
            }
            none => { }
        }
        return c.Val.Unit;
    }
    if func.eq("get-attribute") {
        match attr_index(&ui.nodes.items()[node as usize], name: text_arg(args, i: 1)) {
            some(k) => { return some_val(str_val(ui.nodes.items()[node as usize].values.items()[k].view(), a), a); }
            none => { return nothing(a); }
        }
    }
    if func.eq("toggle-class") {
        toggle_class(ui, n: node, name: text_arg(args, i: 1), on: int_arg(args, i: 2) != 0);
        return c.Val.Unit;
    }
    if func.eq("set-style") {
        set_style(ui, n: node, property: text_arg(args, i: 1), value: text_arg(args, i: 2));
        return c.Val.Unit;
    }
    if func.eq("set-markup") {
        if ui.nodes.items()[node as usize].tag.len() == 0 {
            var not_one = alloc.String.from("#", a);
            not_one.push_u64(node as u64);
            not_one.push_str(" is not an element");
            return done(not_one.view(), a);
        }
        let why = try set_markup(ui, n: node, markup: text_arg(args, i: 1), a: a);
        return done(why.view(), a);
    }
    if func.eq("query-all") {
        var found = alloc.List(u32).init(a);
        query(ui, scope: node, n: node, sel: text_arg(args, i: 1).bytes(), out: &mut found);
        return node_list(&found, a);
    }
    if func.eq("parent") {
        let p = ui.nodes.items()[node as usize].parent;
        if p == 0 {
            return nothing(a);
        }
        return some_val(int_val(p as u64), a);
    }
    if func.eq("children") {
        return node_list(&ui.nodes.items()[node as usize].children, a);
    }
    if func.eq("value") {
        match attr_index(&ui.nodes.items()[node as usize], name: "value") {
            some(k) => { return str_val(ui.nodes.items()[node as usize].values.items()[k].view(), a); }
            none => { }
        }
        var text = alloc.String.init(a);
        text_content(ui, n: node, out: &mut text);
        return c.Val.Str { v: text };
    }
    if func.eq("bounds") {
        if (node as usize) < ui.boxes.len() and ui.boxes.items()[node as usize].w >= 0 {
            let b = ui.boxes.items()[node as usize];
            var fields = alloc.List(c.Val).init(a);
            fields.push(f32_of(b.x));
            fields.push(f32_of(b.y));
            fields.push(f32_of(b.w));
            fields.push(f32_of(b.h));
            return some_val(c.Val.List { items: fields }, a);
        }
        return nothing(a);
    }
    if func.eq("listen") or func.eq("unlisten") {
        // Kinds trimmed and in lower case, each once.
        var kind = alloc.String.init(a);
        for b in trim(text_arg(args, i: 1)).bytes() {
            if b.* >= 'A' and b.* <= 'Z' {
                kind.push_ascii(b.* + 32);
            } else {
                kind.push_ascii(b.*);
            }
        }
        if ui.nodes.items()[node as usize].tag.len() == 0 or kind.len() == 0 {
            return c.Val.Unit;
        }
        var kept = alloc.List(alloc.String).init(a);
        for k in ui.nodes.items()[node as usize].listens.items() {
            if not k.view().eq(kind.view()) {
                kept.push(k.clone());
            }
        }
        if func.eq("listen") {
            // Where it was, if it was.
            var at_old = false;
            for k in ui.nodes.items()[node as usize].listens.items() {
                if k.view().eq(kind.view()) {
                    at_old = true;
                }
            }
            if at_old {
                return c.Val.Unit;
            }
            kept.push(kind);
        }
        ui.nodes.items_mut()[node as usize].listens = kept;
        return c.Val.Unit;
    }
    return exec.Trap.HostTrap;
}

impl c.Imports for Ui {
    fn has(self: &Ui, instance: str, func: str) -> bool {
        for d in self.denied.items() {
            if d.view().eq(func) {
                return false;
            }
        }
        if instance.starts_with("wasi:") {
            return wasip2.has(instance: instance, func: func);
        }
        var list = "";
        if instance.eq(HOST_API) {
            list = HOST_FUNCS;
        } else if instance.eq(DOM) {
            list = DOM_FUNCS;
        } else {
            return added_at(self, instance: instance, func: func) != NONE_AT;
        }
        // " name " in the list.
        let l = list.bytes();
        let f = func.bytes();
        var i: usize = 0;
        while i + f.len() + 2 <= l.len() : (i += 1) {
            if l[i] == ' ' and l[i + f.len() + 1] == ' ' and same_bytes(x: l[i + 1..i + 1 + f.len()], y: f) {
                return true;
            }
        }
        return false;
    }

    fn call(self: &mut Ui, instance: str, func: str, args: &alloc.List(c.Val), a: alloc.Allocator) -> exec.Trap!c.Val {
        let k = added_at(self, instance: instance, func: func);
        if k != NONE_AT {
            var kept = alloc.List(c.Val).init(self.a);
            for v in args.items() {
                kept.push(copy_val(v, a: self.a));
            }
            let made = self.next_call;
            self.next_call += 1;
            self.calls.push(Call { number: made, instance: alloc.String.from(instance, self.a), func: alloc.String.from(func, self.a), args: kept });
            if self.added.items()[k].numbered {
                return c.Val.Int { v: made as u64 };
            }
            return copy_val(&self.added.items()[k].answer, a: a);
        }
        if instance.eq(DOM) {
            return try dom(self, func: func, args: args);
        }
        if instance.starts_with("wasi:") {
            return try wasip2.call(&mut self.wasi, instance: instance, func: func, args: args, now_ms: self.now_ms, a: a);
        }
        return try host_api(self, func: func, args: args);
    }
}

/// An app: its component, and the shell its imports reach. It is the host
/// the store calls back, for the component's lowered imports.
pub type App = struct {
    pub comp: c.Component,
    pub ui: Ui,
}

impl exec.Host for App {
    fn call(self: &mut App, store: &mut exec.Store, id: u32, args: []u64, results: []mut u64) -> exec.Trap!void {
        try c.handle(&self.comp, store, imports: &mut self.ui, id, args, results);
    }
}

/// What the app wrote to stdout and stderr, into its logs a line at a
/// time, made visible as log's are; as Nimadir's shell does with stderr
/// after each call.
fn take_output(ui: &mut Ui) {
    var lines = alloc.List(alloc.String).init(ui.a);
    wasip2.drain(&mut ui.wasi, lines: &mut lines);
    for l in lines.items() {
        var line = alloc.String.init(ui.a);
        visible(l.view(), out: &mut line);
        ui.logs.push(line);
    }
}

/// The shell's limits for a store of apps.
pub fn limits() -> exec.Limits {
    var l = exec.default_limits();
    l.memory_bytes = MAX_MEMORY;
    l.trap = true;
    return l;
}

/// Calls the app's export name (init or update), within budget_ns of now.
pub fn run(app: &mut App, store: &mut exec.Store, now: &dyn fn() -> u64, name: str, budget_ns: u64) -> exec.Trap!void {
    // The core instances' start functions first, once, within the budget:
    // a language's runtime may start there, calling the imports.
    let starts = c.take_starts(&mut app.comp);
    if starts.len() > 0 {
        store.deadline_ns = now() + budget_ns;
        for f in starts.items() {
            var none_results = alloc.List(u64).init(app.ui.a);
            let none_args: [0]u64 = [];
            let started = exec.invoke(store, app, now, func: f.*, none_args[0..0], &mut none_results);
            match started {
                ok(_) => { }
                err(e) => {
                    store.deadline_ns = 0;
                    return e;
                }
            }
        }
        store.deadline_ns = 0;
    }
    let none_args = alloc.List(c.Val).init(app.ui.a);
    let p = try c.prepare(&app.comp, store, name: name, &none_args);
    var results = alloc.List(u64).init(app.ui.a);
    store.deadline_ns = now() + budget_ns;
    let r = exec.invoke(store, app, now, func: p.core, p.args.items(), &mut results);
    store.deadline_ns = 0;
    take_output(&mut app.ui);
    if name.eq("update") {
        // Taps and submits were this frame's; groups the app left open
        // close here, so a shell always sees them balanced.
        app.ui.clicked.clear();
        app.ui.submits.clear();
        var open = app.ui.depth;
        if open > MAX_NESTING {
            open = MAX_NESTING;
        }
        while open > 0 : (open -= 1) {
            app.ui.depth = open - 1;
            _ = widget(&mut app.ui, kind: END, text: "", detail: "", value: 0);
        }
        app.ui.depth = 0;
    }
    try r;
    _ = try c.finish(&app.comp, store, &p, &results);
}

// ---- for a shell with a screen -----------------------------------------------------

/// How many node numbers there are; some may name nodes released.
pub fn node_count(ui: &Ui) -> u32 {
    return ui.nodes.len() as u32;
}

/// Whether n is a node in the page: alive, and the body or under it.
pub fn in_page(ui: &Ui, n: u32) -> bool {
    if n == 0 or n as usize >= ui.nodes.len() or not ui.nodes.items()[n as usize].alive {
        return false;
    }
    return inside(ui, n: 1, of: n);
}

/// n's tag, an element's; empty for a run of text.
pub fn tag_of(ui: &Ui, n: u32) -> str {
    return ui.nodes.items()[n as usize].tag.view();
}

/// A run of text's text.
pub fn text_of(ui: &Ui, n: u32) -> str {
    return ui.nodes.items()[n as usize].text.view();
}

/// n's attribute name, copied; none when it has none.
pub fn attribute(ui: &Ui, n: u32, name: str, a: alloc.Allocator) -> ?alloc.String {
    let node = &ui.nodes.items()[n as usize];
    let k = attr_index(node, name: name) orelse return none;
    return alloc.String.from(node.values.items()[k].view(), a);
}

/// n's children, in order.
pub fn children_of(ui: &Ui, n: u32) -> []u32 {
    return ui.nodes.items()[n as usize].children.items();
}

pub fn parent_of(ui: &Ui, n: u32) -> u32 {
    return ui.nodes.items()[n as usize].parent;
}

/// Whether n matches a selector of compounds (tag, #id, .class) parted by
/// spaces, as a stylesheet's rule says it.
pub fn matches_selector(ui: &Ui, n: u32, selector: str) -> bool {
    return matches(ui, n: n, sel: selector.bytes(), scope: 0);
}

/// How many stylesheets were added; stylesheet(i) is the ith, from 0,
/// empty when it was removed.
pub fn stylesheet_count(ui: &Ui) -> u32 {
    return ui.sheet_texts.len() as u32;
}

pub fn stylesheet(ui: &Ui, i: u32) -> str {
    return ui.sheet_texts.items()[i as usize].view();
}

/// Where the shell laid n out, for bounds to say.
pub fn set_box(ui: &mut Ui, n: u32, x: i32, y: i32, width: i32, height: i32) {
    while ui.boxes.len() <= n as usize {
        ui.boxes.push(Box { x: 0, y: 0, w: -1, h: 0 });
    }
    ui.boxes.items_mut()[n as usize] = Box { x: x, y: y, w: width, h: height };
}

/// Something the user did to target: it goes to target, or its nearest
/// ancestor that listens for kind, as the app's events will say. Whether
/// one listened.
pub fn dispatch(ui: &mut Ui, kind: str, target: u32, value: str) -> bool {
    var at = target;
    while at != 0 {
        for l in ui.nodes.items()[at as usize].listens.items() {
            if l.view().eq(kind) {
                if ui.events.len() >= MAX_EVENTS {
                    // The oldest goes.
                    var rest = alloc.List(Event).init(ui.a);
                    var k: usize = 1;
                    while k < ui.events.len() : (k += 1) {
                        let e = &ui.events.items()[k];
                        rest.push(Event { kind: e.kind.clone(), target: e.target, current: e.current, value: e.value.clone() });
                    }
                    ui.events = rest;
                }
                ui.events.push(Event { kind: alloc.String.from(kind, ui.a), target: target, current: at, value: alloc.String.from(value, ui.a) });
                return true;
            }
        }
        at = ui.nodes.items()[at as usize].parent;
    }
    return false;
}

/// A control's value as the user leaves it: its value attribute.
pub fn set_value(ui: &mut Ui, n: u32, value: str) {
    set_attr(ui, n: n, name: "value", value: value);
}

/// An app list-apps gives from now on, after those added before.
pub fn add_app(ui: &mut Ui, name: str, source: str, about: str) {
    ui.apps.push(alloc.String.from(name, ui.a));
    ui.apps.push(alloc.String.from(source, ui.a));
    ui.apps.push(alloc.String.from(about, ui.a));
}

/// Whether the app loaded an image numbered h.
pub fn has_image(ui: &Ui, h: u64) -> bool {
    return h < ui.pictures.len() as u64;
}

/// The image numbered h, which has_image says there is.
pub fn picture(ui: &Ui, h: u64) -> &png.Image {
    return &ui.pictures.items()[h as usize];
}

// ---- what the user does to the element tree ----------------------------------------

/// The nearest element at or above n, or 0 for one that is gone or inside
/// something disabled.
fn live_element(ui: &Ui, n: u32) -> u32 {
    if n == 0 or n as usize >= ui.nodes.len() or not ui.nodes.items()[n as usize].alive {
        return 0;
    }
    var at = n;
    var element: u32 = 0;
    while at != 0 {
        let node = &ui.nodes.items()[at as usize];
        if node.tag.len() > 0 {
            match attr_index(node, name: "disabled") {
                some(_) => { return 0; }
                none => { }
            }
            if element == 0 {
                element = at;
            }
        }
        at = node.parent;
    }
    return element;
}

fn attr_is(ui: &Ui, n: u32, name: str, value: str) -> bool {
    let node = &ui.nodes.items()[n as usize];
    match attr_index(node, name: name) {
        some(k) => { return node.values.items()[k].view().eq(value); }
        none => { return false; }
    }
}

fn has_attr(ui: &Ui, n: u32, name: str) -> bool {
    match attr_index(&ui.nodes.items()[n as usize], name: name) {
        some(_) => { return true; }
        none => { return false; }
    }
}

fn is_checkbox(ui: &Ui, n: u32) -> bool {
    return ui.nodes.items()[n as usize].tag.view().eq("input") and attr_is(ui, n: n, name: "type", value: "checkbox");
}

fn is_radio(ui: &Ui, n: u32) -> bool {
    return ui.nodes.items()[n as usize].tag.view().eq("input") and attr_is(ui, n: n, name: "type", value: "radio");
}

/// A control the user edits the text of, or slides: an input that is not
/// a checkbox or radio, or a textarea.
fn is_field(ui: &Ui, n: u32) -> bool {
    let tag = ui.nodes.items()[n as usize].tag.view();
    return (tag.eq("input") and not is_checkbox(ui, n: n) and not is_radio(ui, n: n)) or tag.eq("textarea");
}

fn is_focusable(ui: &Ui, n: u32) -> bool {
    let tag = ui.nodes.items()[n as usize].tag.view();
    return is_field(ui, n: n) or is_checkbox(ui, n: n) or is_radio(ui, n: n) or tag.eq("select") or tag.eq("button");
}

/// The keyboard goes to n, when it is a control in the page.
pub fn focus_node(ui: &mut Ui, n: u32) {
    if n != 0 and n as usize < ui.nodes.len() and ui.nodes.items()[n as usize].tag.len() > 0 and is_focusable(ui, n: n) and in_page(ui, n: n) {
        ui.focused = n;
    }
}

/// A checkbox or radio set to on by the user, and told so; the other
/// radios of its name are no longer picked.
fn toggle(ui: &mut Ui, n: u32, on: bool) {
    if on {
        set_attr(ui, n: n, name: "checked", value: "");
        if is_radio(ui, n: n) {
            match attribute(ui, n: n, name: "name", a: ui.a) {
                some(group) => {
                    var k: u32 = 1;
                    while (k as usize) < ui.nodes.len() : (k += 1) {
                        if k != n and ui.nodes.items()[k as usize].alive and is_radio(ui, n: k) and attr_is(ui, n: k, name: "name", value: group.view()) {
                            remove_attr(ui, n: k, name: "checked");
                        }
                    }
                }
                none => { }
            }
        }
    } else {
        remove_attr(ui, n: n, name: "checked");
    }
    var value = "false";
    if on {
        value = "true";
    }
    _ = dispatch(ui, kind: "input", target: n, value: value);
    _ = dispatch(ui, kind: "change", target: n, value: value);
}

fn remove_attr(ui: &mut Ui, n: u32, name: str) {
    let a = ui.a;
    match attr_index(&ui.nodes.items()[n as usize], name: name) {
        some(k) => {
            var names = alloc.List(alloc.String).init(a);
            var values = alloc.List(alloc.String).init(a);
            var i: usize = 0;
            while i < ui.nodes.items()[n as usize].names.len() : (i += 1) {
                if i != k {
                    names.push(ui.nodes.items()[n as usize].names.items()[i].clone());
                    values.push(ui.nodes.items()[n as usize].values.items()[i].clone());
                }
            }
            ui.nodes.items_mut()[n as usize].names = names;
            ui.nodes.items_mut()[n as usize].values = values;
        }
        none => { }
    }
}

/// The first control inside n, for a label without a for.
fn first_control(ui: &Ui, n: u32) -> u32 {
    for k in ui.nodes.items()[n as usize].children.items() {
        let x = k.*;
        if ui.nodes.items()[x as usize].tag.len() > 0 {
            let tag = ui.nodes.items()[x as usize].tag.view();
            if tag.eq("input") or tag.eq("select") or tag.eq("textarea") or tag.eq("button") {
                return x;
            }
            let inner = first_control(ui, n: x);
            if inner != 0 {
                return inner;
            }
        }
    }
    return 0;
}

/// The element of the page whose id is id; 0 for none.
fn element_by_id(ui: &Ui, n: u32, id: str) -> u32 {
    if ui.nodes.items()[n as usize].tag.len() > 0 and attr_is(ui, n: n, name: "id", value: id) {
        return n;
    }
    for k in ui.nodes.items()[n as usize].children.items() {
        let found = element_by_id(ui, n: k.*, id: id);
        if found != 0 {
            return found;
        }
    }
    return 0;
}

fn inside_tag(ui: &Ui, n: u32, tag: str) -> bool {
    var at = ui.nodes.items()[n as usize].parent;
    while at != 0 {
        if ui.nodes.items()[at as usize].tag.view().eq(tag) {
            return true;
        }
        at = ui.nodes.items()[at as usize].parent;
    }
    return false;
}

/// The user tapped n: the click, and what a click on that element does by
/// itself: a checkbox flips, a radio is picked, a field takes the
/// keyboard, a label acts for its control, a link is followed (into
/// open_request), a button in a form submits it.
pub fn click_node(ui: &mut Ui, n: u32) {
    let target = live_element(ui, n: n);
    if target == 0 {
        return;
    }
    _ = dispatch(ui, kind: "click", target: target, value: "");
    var at = target;
    while at != 0 and ui.nodes.items()[at as usize].tag.len() > 0 {
        let tag = alloc.String.from(ui.nodes.items()[at as usize].tag.view(), ui.a);
        if is_checkbox(ui, n: at) {
            toggle(ui, n: at, on: not has_attr(ui, n: at, name: "checked"));
            return;
        }
        if is_radio(ui, n: at) {
            if not has_attr(ui, n: at, name: "checked") {
                toggle(ui, n: at, on: true);
            }
            return;
        }
        if is_field(ui, n: at) or tag.view().eq("select") {
            focus_node(ui, n: at);
            return;
        }
        if tag.view().eq("label") {
            var control: u32 = 0;
            match attribute(ui, n: at, name: "for", a: ui.a) {
                some(f) => { control = element_by_id(ui, n: 1, id: f.view()); }
                none => { control = first_control(ui, n: at); }
            }
            if control != 0 and control != at {
                if is_checkbox(ui, n: control) {
                    toggle(ui, n: control, on: not has_attr(ui, n: control, name: "checked"));
                } else if is_radio(ui, n: control) {
                    if not has_attr(ui, n: control, name: "checked") {
                        toggle(ui, n: control, on: true);
                    }
                } else if is_focusable(ui, n: control) {
                    focus_node(ui, n: control);
                }
            }
            return;
        }
        if tag.view().eq("a") {
            match attribute(ui, n: at, name: "href", a: ui.a) {
                some(h) => {
                    let href = trim(h.view());
                    if href.len() > 0 {
                        ui.open_request = alloc.String.from(href, ui.a);
                    }
                }
                none => { }
            }
            return;
        }
        if tag.view().eq("button") {
            if not attr_is(ui, n: at, name: "type", value: "button") and inside_tag(ui, n: at, tag: "form") {
                _ = dispatch(ui, kind: "submit", target: at, value: "");
            }
            return;
        }
        at = ui.nodes.items()[at as usize].parent;
    }
}

/// The user changed the field n's text to text: its listeners hear input
/// when that is a change.
pub fn type_text(ui: &mut Ui, n: u32, text: str) {
    let target = live_element(ui, n: n);
    if target == 0 or not is_field(ui, n: target) {
        return;
    }
    if attr_is(ui, n: target, name: "value", value: text) {
        return;
    }
    if not has_attr(ui, n: target, name: "value") and text.len() == 0 {
        return;
    }
    set_attr(ui, n: target, name: "value", value: text);
    _ = dispatch(ui, kind: "input", target: target, value: text);
}

/// The user pressed Enter, or a phone keyboard's action key, in n.
pub fn submit_node(ui: &mut Ui, n: u32) {
    let target = live_element(ui, n: n);
    if target == 0 {
        return;
    }
    let value = attribute(ui, n: target, name: "value", a: ui.a) orelse alloc.String.init(ui.a);
    _ = dispatch(ui, kind: "change", target: target, value: value.view());
    _ = dispatch(ui, kind: "submit", target: target, value: value.view());
}

// ---- as Nimadir's headless runner prints it --------------------------------------------

/// s quoted as Rust's Debug quotes a string: \" and \\, \n, \r, \t and
/// \0, and other characters that do not print as \u{...}.
fn quoted(s: str, out: &mut alloc.String) {
    out.push_str("\"");
    let b = s.bytes();
    var i: usize = 0;
    while i < b.len() {
        var end = i + 1;
        while end < b.len() and (b[end] & 0xC0) == 0x80 {
            end += 1;
        }
        let cp = code_point(b[i..end]);
        if cp == '"' as u32 {
            out.push_str("\\\"");
        } else if cp == '\\' as u32 {
            out.push_str("\\\\");
        } else if cp == '\n' as u32 {
            out.push_str("\\n");
        } else if cp == '\r' as u32 {
            out.push_str("\\r");
        } else if cp == '\t' as u32 {
            out.push_str("\\t");
        } else if cp == 0 {
            out.push_str("\\0");
        } else if not printable(cp) {
            out.push_str("\\u{");
            push_hex(out, v: cp);
            out.push_str("}");
        } else {
            out.push_str(s[i..end]);
        }
        i = end;
    }
    out.push_str("\"");
}

/// Whether Rust prints cp as it is in a string's Debug: not a control,
/// format or separator character.
fn printable(cp: u32) -> bool {
    if cp < 0x20 or (cp >= 0x7F and cp < 0xA0) or cp == 0xAD {
        return false;
    }
    if cp == 0x61C or cp == 0x180E or (cp >= 0x200B and cp <= 0x200F) or (cp >= 0x2028 and cp <= 0x202E) {
        return false;
    }
    if (cp >= 0x2060 and cp <= 0x206F) or cp == 0xFEFF or (cp >= 0xFFF9 and cp <= 0xFFFB) {
        return false;
    }
    return true;
}

fn pad(out: &mut alloc.String, depth: u32) {
    out.push_str("   ");
    var i: u32 = 0;
    while i < depth : (i += 1) {
        out.push_str("  ");
    }
}

/// The frame's widgets, a line each, as Nimadir's headless runner prints
/// them: three spaces, two more a group deep.
pub fn write_frame(ui: &Ui, out: &mut alloc.String) {
    var depth: u32 = 0;
    for w in ui.widgets.items() {
        if w.kind == END and depth > 0 {
            depth -= 1;
        }
        pad(out, depth: depth);
        if w.kind == LABEL {
            out.push_str("label   : ");
            quoted(w.text.view(), out: out);
        } else if w.kind == BUTTON {
            out.push_str("button");
            out.push_u64(w.index as u64);
            out.push_str(" : ");
            quoted(w.text.view(), out: out);
        } else if w.kind == FIELD {
            out.push_str("field");
            out.push_u64(w.index as u64);
            out.push_str("  : ");
            quoted(w.text.view(), out: out);
        } else if w.kind == HEADING {
            out.push_str("heading");
            out.push_u64(w.value);
            out.push_str(" : ");
            quoted(w.text.view(), out: out);
        } else if w.kind == SEARCH {
            out.push_str("search");
            out.push_u64(w.index as u64);
            out.push_str(" : ");
            quoted(w.text.view(), out: out);
            out.push_str("  (hint ");
            quoted(w.detail.view(), out: out);
            out.push_str(")");
        } else if w.kind == TILE {
            out.push_str("tile");
            out.push_u64(w.index as u64);
            out.push_str(" : ");
            quoted(w.text.view(), out: out);
            out.push_str(" ");
            quoted(w.detail.view(), out: out);
        } else if w.kind == BEGIN {
            out.push_str("begin ");
            out.push_str(w.text.view());
            out.push_str("#");
            out.push_u64(w.index as u64);
        } else if w.kind == END {
            out.push_str("end");
        } else if w.kind == CHECKBOX {
            out.push_str("check");
            out.push_u64(w.index as u64);
            if w.value != 0 {
                out.push_str(" : [x] ");
            } else {
                out.push_str(" : [ ] ");
            }
            quoted(w.text.view(), out: out);
        } else if w.kind == CHOICE {
            out.push_str("choice");
            out.push_u64(w.index as u64);
            out.push_str(" : ");
            let d = w.detail.view();
            let b = d.bytes();
            var at: usize = 0;
            var k: u64 = 0;
            while at < b.len() : (k += 1) {
                var e = at;
                while e < b.len() and b[e] != '\n' {
                    e += 1;
                }
                if k > 0 {
                    out.push_str(" | ");
                }
                if k == w.value {
                    out.push_str("[");
                    out.push_str(d[at..e]);
                    out.push_str("]");
                } else {
                    out.push_str(d[at..e]);
                }
                at = e + 1;
            }
        } else if w.kind == SEPARATOR {
            out.push_str("----");
        } else if w.kind == PROGRESS {
            out.push_str("progress : ");
            out.push_u64(percent(w.value));
            out.push_str("%");
        } else if w.kind == IMAGE {
            let p = picture(ui, h: w.value);
            out.push_str("image : ");
            out.push_u64(p.width as u64);
            out.push_str("x");
            out.push_u64(p.height as u64);
        }
        out.push_str("\n");
        if w.kind == BEGIN {
            depth += 1;
        }
    }
}

/// Whether the app built a page: the body has something in it.
pub fn has_page(ui: &Ui) -> bool {
    return ui.nodes.items()[1].children.len() > 0;
}

/// The nodes the app holds: made and not released.
pub fn live_nodes(ui: &Ui) -> u32 {
    var n: u32 = 0;
    var k: usize = 1;
    while k < ui.nodes.len() : (k += 1) {
        if ui.nodes.items()[k].alive {
            n += 1;
        }
    }
    return n;
}

/// The page, a node a line, as Nimadir's headless runner prints it:
/// `#5 input#q.big [type="search"] value="" (focused) {input}`.
pub fn write_outline(ui: &Ui, n: u32, depth: u32, out: &mut alloc.String) {
    let node = &ui.nodes.items()[n as usize];
    pad(out, depth: depth);
    out.push_str("#");
    out.push_u64(n as u64);
    out.push_str(" ");
    if node.tag.len() == 0 {
        quoted(node.text.view(), out: out);
        out.push_str("\n");
        return;
    }
    out.push_str(node.tag.view());
    match attr_index(node, name: "id") {
        some(k) => {
            out.push_str("#");
            out.push_str(node.values.items()[k].view());
        }
        none => { }
    }
    match attr_index(node, name: "class") {
        some(k) => {
            let cls = node.values.items()[k].view();
            let b = cls.bytes();
            var at: usize = 0;
            while at < b.len() {
                while at < b.len() and (b[at] == ' ' or b[at] == '\t' or b[at] == '\n') {
                    at += 1;
                }
                var e = at;
                while e < b.len() and not (b[e] == ' ' or b[e] == '\t' or b[e] == '\n') {
                    e += 1;
                }
                if e > at {
                    out.push_str(".");
                    out.push_str(cls[at..e]);
                }
                at = e;
            }
        }
        none => { }
    }
    var first = true;
    var k: usize = 0;
    while k < node.names.len() : (k += 1) {
        let name = node.names.items()[k].view();
        if name.eq("id") or name.eq("class") or name.eq("value") or name.eq("checked") {
            continue;
        }
        if first {
            out.push_str(" [");
            first = false;
        } else {
            out.push_str(" ");
        }
        out.push_str(name);
        out.push_str("=");
        quoted(node.values.items()[k].view(), out: out);
    }
    if not first {
        out.push_str("]");
    }
    let value = attr_index(node, name: "value");
    var has_value = false;
    match value {
        some(_) => { has_value = true; }
        none => { }
    }
    if is_field(ui, n: n) or (node.tag.view().eq("select") and has_value) {
        out.push_str(" value=");
        match value {
            some(v) => { quoted(node.values.items()[v].view(), out: out); }
            none => { out.push_str("\"\""); }
        }
    }
    if is_checkbox(ui, n: n) or is_radio(ui, n: n) {
        if has_attr(ui, n: n, name: "checked") {
            out.push_str(" [x]");
        } else {
            out.push_str(" [ ]");
        }
    }
    if ui.focused == n {
        out.push_str(" (focused)");
    }
    if node.listens.len() > 0 {
        out.push_str(" {");
        var j: usize = 0;
        while j < node.listens.len() : (j += 1) {
            if j > 0 {
                out.push_str(" ");
            }
            out.push_str(node.listens.items()[j].view());
        }
        out.push_str("}");
    }
    out.push_str("\n");
    for x in node.children.items() {
        write_outline(ui, n: x.*, depth: depth + 1, out: out);
    }
}
