/// CSS values as Nimadir's shell reads them (host/src/dom/values.rs),
/// from tokens once var() has been put in: lengths (with calc(), min(),
/// max() and clamp()), numbers and colors. What a property does with them
/// is wasm.style's business. The arithmetic is f32's, in Nimadir's order.
import alloc;
import wasm.css;

/// What a Length is: auto, pixels, a percentage (0 to 100, as written),
/// or calc() with a percentage in it, px + percent% of the basis.
pub const AUTO: u8 = 0;
pub const PX: u8 = 1;
pub const PERCENT: u8 = 2;
pub const CALC: u8 = 3;

/// A length as layout needs it: absolute units are already pixels,
/// relative ones (em, rem, vw, ...) already resolved; only a percentage,
/// of a containing block not yet known, and auto are left.
pub type Length = struct {
    pub kind: u8,
    pub px: f32,
    pub percent: f32,
}

/// auto.
pub fn auto() -> Length {
    return Length { kind: AUTO, px: 0.0, percent: 0.0 };
}

/// v pixels.
pub fn px_length(v: f32) -> Length {
    return Length { kind: PX, px: v, percent: 0.0 };
}

/// v percent.
pub fn percent_length(v: f32) -> Length {
    return Length { kind: PERCENT, px: 0.0, percent: v };
}

/// 0px.
pub fn zero() -> Length {
    return px_length(0.0);
}

/// Whether x and y are the same length, as Rust's derived equality says.
pub fn length_eq(x: Length, y: Length) -> bool {
    if x.kind != y.kind {
        return false;
    }
    if x.kind == PX {
        return x.px == y.px;
    }
    if x.kind == PERCENT {
        return x.percent == y.percent;
    }
    if x.kind == CALC {
        return x.px == y.px and x.percent == y.percent;
    }
    return true;
}

/// l as CSS: auto, 8px, 50%, calc(100% + -32px).
pub fn write_length(l: Length, out: &mut alloc.String) {
    if l.kind == AUTO {
        out.push_str("auto");
    } else if l.kind == PX {
        css.write_number(l.px, out: out);
        out.push_str("px");
    } else if l.kind == PERCENT {
        css.write_number(l.percent, out: out);
        out.push_str("%");
    } else {
        out.push_str("calc(");
        css.write_number(l.percent, out: out);
        out.push_str("% + ");
        css.write_number(l.px, out: out);
        out.push_str("px)");
    }
}

/// Pixels, against basis for a percentage; none for auto.
pub fn resolve(l: Length, basis: f32) -> ?f32 {
    if l.kind == AUTO {
        return none;
    }
    if l.kind == PX {
        return l.px;
    }
    if l.kind == PERCENT {
        return basis * l.percent / 100.0;
    }
    return l.px + basis * l.percent / 100.0;
}

/// The largest length, in pixels or percent, a value may come to: past
/// it, layout's arithmetic runs into infinities, and nothing on a screen
/// needs it. A function: a float constant is not Arche yet.
pub fn max_length() -> f32 {
    return 1000000.0;
}

/// v limited to plus or minus max_length; NaN stays NaN.
fn bounded(v: f32) -> f32 {
    var r = v;
    if r < -max_length() {
        r = -max_length();
    }
    if r > max_length() {
        r = max_length();
    }
    return r;
}

/// v limited to lo..=hi, as Rust's f32 clamp: NaN stays NaN.
pub fn clamp(v: f32, lo: f32, hi: f32) -> f32 {
    var r = v;
    if r < lo {
        r = lo;
    }
    if r > hi {
        r = hi;
    }
    return r;
}

/// The smaller of x and y, as Rust's f32 min: a NaN gives the other.
pub fn fmin(x: f32, y: f32) -> f32 {
    if x != x {
        return y;
    }
    if y != y {
        return x;
    }
    if y < x {
        return y;
    }
    return x;
}

/// The larger of x and y, as Rust's f32 max: a NaN gives the other.
pub fn fmax(x: f32, y: f32) -> f32 {
    if x != x {
        return y;
    }
    if y != y {
        return x;
    }
    if y > x {
        return y;
    }
    return x;
}

/// x rounded to the nearest whole number, halves away from zero, as
/// Rust's f32 round.
pub fn round(x: f32) -> f32 {
    let t = x.trunc();
    let d = x - t;
    if d >= 0.5 {
        return t + 1.0;
    }
    if d <= -0.5 {
        return t - 1.0;
    }
    return t;
}

/// Whether x is neither infinite nor NaN.
pub fn finite(x: f32) -> bool {
    return x - x == 0.0;
}

/// x modulo m, never negative, as Rust's f32 rem_euclid.
pub fn rem_euclid(x: f32, m: f32) -> f32 {
    let r = x.rem(m);
    if r < 0.0 {
        return r + m.abs();
    }
    return r;
}

/// Radians as degrees, as Rust's f32 to_degrees: one multiplication by
/// 180/pi.
pub fn to_degrees(x: f32) -> f32 {
    let per: f32 = 57.2957795130823208767981548141051703;
    return x * per;
}

/// What relative units are relative to, for the element being styled: the
/// font size em means (the element's own, or for font-size itself its
/// parent's), the root's, and the viewport's size.
pub type Ctx = struct {
    pub em: f32,
    pub rem: f32,
    pub vw: f32,
    pub vh: f32,
}

/// For values with no relative units in them.
pub fn no_ctx() -> Ctx {
    return Ctx { em: 16.0, rem: 16.0, vw: 0.0, vh: 0.0 };
}

// ---- colors ----------------------------------------------------------------

/// A color is RGBA in a u32, 0xRRGGBBAA, not premultiplied.
pub const TRANSPARENT: u32 = 0;
pub const BLACK: u32 = 0x000000FF;

/// The opaque color of 0xRRGGBB.
pub fn rgb(v: u32) -> u32 {
    return (v << 8) | 0xFF;
}

/// The color of four channels.
fn rgba(r: u8, g: u8, b: u8, alpha: u8) -> u32 {
    return ((r as u32) << 24) | ((g as u32) << 16) | ((b as u32) << 8) | alpha as u32;
}

/// c as CSS: #rrggbb, or #rrggbbaa when it is not opaque.
pub fn write_color(c: u32, out: &mut alloc.String) {
    out.push_str("#");
    var shift: u32 = 24;
    var n: u32 = 3;
    if (c & 0xFF) != 0xFF {
        n = 4;
    }
    var i: u32 = 0;
    while i < n : (i += 1) {
        let byte = (c >> (shift - 8 * i)) & 0xFF;
        let digits = "0123456789abcdef";
        out.push_ascii(digits.bytes()[(byte >> 4) as usize]);
        out.push_ascii(digits.bytes()[(byte & 0xF) as usize]);
    }
}

/// c with its alpha scaled by f.
pub fn faded(c: u32, f: f32) -> u32 {
    let alpha = (c & 0xFF) as f32;
    let scaled = round(alpha * clamp(v: f, lo: 0.0, hi: 1.0)) as% u8;
    return (c & 0xFFFFFF00) | scaled as u32;
}

// ---- words and keywords ----------------------------------------------------

/// The values a property was given, split where spaces separate them
/// outside brackets: `1px solid red` is three.
pub fn words(tokens: []css.Token, a: alloc.Allocator) -> alloc.List(css.Span) {
    var out = alloc.List(css.Span).init(a);
    var depth: usize = 0;
    var started = false;
    var from: usize = 0;
    var i: usize = 0;
    while i < tokens.len() : (i += 1) {
        let k = tokens[i].kind;
        if k == css.FUNCTION or k == css.LPAREN or k == css.LBRACKET {
            depth += 1;
        } else if (k == css.RPAREN or k == css.RBRACKET) and depth > 0 {
            depth -= 1;
        }
        if k == css.SPACE and depth == 0 {
            if started {
                out.push(css.Span { from: from, to: i });
                started = false;
            }
        } else if not started {
            started = true;
            from = i;
        }
    }
    if started {
        out.push(css.Span { from: from, to: tokens.len() });
    }
    return out;
}

/// The one keyword tokens are, as written; "" when they are not one.
pub fn keyword_text(tokens: []css.Token) -> str {
    if tokens.len() == 1 and tokens[0].kind == css.IDENT {
        return tokens[0].text.view();
    }
    return "";
}

/// Whether tokens are the one keyword word (in lower case), any case.
pub fn is_keyword(tokens: []css.Token, word: str) -> bool {
    return tokens.len() == 1 and tokens[0].kind == css.IDENT and css.eq_ignore_case(x: tokens[0].text.view(), y: word);
}

/// A plain number, or calc() of one.
pub fn parse_number(tokens: []css.Token, a: alloc.Allocator) -> ?f32 {
    if tokens.len() == 1 and tokens[0].kind == css.NUMBER {
        return tokens[0].n;
    }
    if tokens.len() >= 1 and tokens[0].kind == css.FUNCTION and tokens[0].text.view().eq("calc") {
        let v = calc(tokens[1..tokens.len()], cx: no_ctx(), a: a) orelse return none;
        if not v.lin {
            return v.num;
        }
    }
    return none;
}

// ---- lengths ---------------------------------------------------------------

/// A length, a percentage, or auto.
pub fn parse_length(tokens: []css.Token, cx: Ctx, a: alloc.Allocator) -> ?Length {
    if tokens.len() == 1 and tokens[0].kind == css.IDENT and css.eq_ignore_case(x: tokens[0].text.view(), y: "auto") {
        return auto();
    }
    return parse_length_percent(tokens, cx: cx, a: a);
}

/// Whether tokens start with calc(, min(, max( or clamp(v: .
fn math_function(tokens: []css.Token) -> bool {
    if tokens.len() == 0 or tokens[0].kind != css.FUNCTION {
        return false;
    }
    let f = tokens[0].text.view();
    return f.eq("calc") or f.eq("min") or f.eq("max") or f.eq("clamp");
}

/// A length or a percentage, not auto.
pub fn parse_length_percent(tokens: []css.Token, cx: Ctx, a: alloc.Allocator) -> ?Length {
    if tokens.len() == 1 and tokens[0].kind == css.PERCENTAGE {
        return percent_length(bounded(tokens[0].n));
    }
    if math_function(tokens) {
        let v = calc_function(tokens[0].text.view(), rest: tokens[1..tokens.len()], cx: cx, a: a) orelse return none;
        if v.lin {
            if not finite(v.px) or not finite(v.percent) {
                return none;
            }
            if v.percent == 0.0 {
                return px_length(bounded(v.px));
            }
            if v.px == 0.0 {
                return percent_length(bounded(v.percent));
            }
            return Length { kind: CALC, px: bounded(v.px), percent: bounded(v.percent) };
        }
        if v.num == 0.0 {
            return zero();
        }
        return none;
    }
    let p = parse_px(tokens, cx: cx, a: a) orelse return none;
    return px_length(p);
}

/// An absolute length, in pixels: no percentage, no auto.
pub fn parse_px(tokens: []css.Token, cx: Ctx, a: alloc.Allocator) -> ?f32 {
    if tokens.len() == 1 and tokens[0].kind == css.NUMBER and tokens[0].n == 0.0 {
        return 0.0;
    }
    if tokens.len() == 1 and tokens[0].kind == css.DIMENSION {
        return unit_px(tokens[0].n, unit: tokens[0].text.view(), cx: cx);
    }
    if math_function(tokens) {
        let v = calc_function(tokens[0].text.view(), rest: tokens[1..tokens.len()], cx: cx, a: a) orelse return none;
        if v.lin and v.percent == 0.0 and finite(v.px) {
            return bounded(v.px);
        }
        if not v.lin and v.num == 0.0 {
            return 0.0;
        }
    }
    return none;
}

/// n of unit, in pixels; none for a unit this host does not know.
fn unit_px(n: f32, unit: str, cx: Ctx) -> ?f32 {
    var v: f32 = 0.0;
    if unit.eq("px") {
        v = n;
    } else if unit.eq("em") {
        v = n * cx.em;
    } else if unit.eq("rem") {
        v = n * cx.rem;
    } else if unit.eq("vw") {
        v = n * cx.vw / 100.0;
    } else if unit.eq("vh") {
        v = n * cx.vh / 100.0;
    } else if unit.eq("vmin") {
        v = n * fmin(x: cx.vw, y: cx.vh) / 100.0;
    } else if unit.eq("vmax") {
        v = n * fmax(x: cx.vw, y: cx.vh) / 100.0;
    } else if unit.eq("pt") {
        v = n * 96.0 / 72.0;
    } else if unit.eq("pc") {
        v = n * 16.0;
    } else if unit.eq("in") {
        v = n * 96.0;
    } else if unit.eq("cm") {
        v = n * 96.0 / 2.54;
    } else if unit.eq("mm") {
        v = n * 96.0 / 25.4;
    } else if unit.eq("q") {
        v = n * 96.0 / 101.6;
    } else if unit.eq("ch") or unit.eq("ex") {
        v = n * cx.em * 0.5;
    } else {
        return none;
    }
    if not finite(v) {
        return none;
    }
    return bounded(v);
}

/// What calc() works with: a length as pixels plus a percentage (lin), or
/// a plain number, for * and /.
type Value = struct {
    lin: bool,
    px: f32,
    percent: f32,
    num: f32,
}

/// A length of px pixels and percent percent.
fn lin(px: f32, percent: f32) -> Value {
    return Value { lin: true, px: px, percent: percent, num: 0.0 };
}

/// A plain number.
fn num_value(n: f32) -> Value {
    return Value { lin: false, px: 0.0, percent: 0.0, num: n };
}

/// calc(...), min(...), max(...) or clamp(v: ...), from just after the name
/// to its closing bracket.
fn calc_function(name: str, rest: []css.Token, cx: Ctx, a: alloc.Allocator) -> ?Value {
    if rest.len() == 0 or rest[rest.len() - 1].kind != css.RPAREN {
        return none;
    }
    let inner = rest[0..rest.len() - 1];
    if name.eq("calc") {
        return calc(rest, cx: cx, a: a);
    }
    // min, max and clamp: only of values that are all pixels, or all
    // numbers; a percentage cannot be compared before layout.
    let comma = css.plain(css.COMMA, a);
    let parts = css.split_top(inner, sep: &comma, a: a);
    var plain_values = alloc.List(f32).init(a);
    var lengths = false;
    var first = true;
    for p in parts.items() {
        let v = expression(css.trim(inner[p.from..p.to]), cx: cx, depth: 0, a: a) orelse return none;
        if first {
            lengths = v.lin;
            first = false;
        }
        if v.lin {
            if v.percent != 0.0 {
                return none;
            }
            plain_values.push(v.px);
        } else {
            plain_values.push(v.num);
        }
    }
    let pv = plain_values.items();
    var pick: f32 = 0.0;
    if name.eq("min") and pv.len() > 0 {
        pick = pv[0];
        for x in pv {
            pick = fmin(x: pick, y: x.*);
        }
    } else if name.eq("max") and pv.len() > 0 {
        pick = pv[0];
        for x in pv {
            pick = fmax(x: pick, y: x.*);
        }
    } else if name.eq("clamp") and pv.len() == 3 {
        pick = fmin(x: fmax(x: pv[1], y: pv[0]), y: pv[2]);
    } else {
        return none;
    }
    if lengths {
        return lin(px: pick, percent: 0.0);
    }
    return num_value(pick);
}

/// The tokens after calc(, its closing bracket included.
fn calc(rest: []css.Token, cx: Ctx, a: alloc.Allocator) -> ?Value {
    if rest.len() == 0 or rest[rest.len() - 1].kind != css.RPAREN {
        return none;
    }
    return expression(css.trim(rest[0..rest.len() - 1]), cx: cx, depth: 0, a: a);
}

/// How deep calc() may nest its brackets.
const MAX_CALC_NESTING: usize = 16;

/// a + b - c, each term x * y / z.
fn expression(tokens: []css.Token, cx: Ctx, depth: usize, a: alloc.Allocator) -> ?Value {
    if depth > MAX_CALC_NESTING or tokens.len() == 0 {
        return none;
    }
    // Split into terms at top-level + and -, keeping each one's sign.
    var total = num_value(0.0);
    var have = false;
    var sign: f32 = 1.0;
    var nest: usize = 0;
    var from: usize = 0;
    var i: usize = 0;
    while i <= tokens.len() : (i += 1) {
        var op: f32 = 0.0;
        if i < tokens.len() {
            let k = tokens[i].kind;
            if k == css.FUNCTION or k == css.LPAREN {
                nest += 1;
            } else if k == css.RPAREN and nest > 0 {
                nest -= 1;
            }
            if nest == 0 and css.is_delim(&tokens[i], ch: '+') {
                op = 1.0;
            } else if nest == 0 and css.is_delim(&tokens[i], ch: '-') {
                op = -1.0;
            } else {
                continue;
            }
        }
        let term = css.trim(tokens[from..i]);
        if term.len() > 0 {
            let p = product(term, cx: cx, depth: depth, a: a) orelse return none;
            let v = scale(p, f: sign);
            if have {
                total = add(x: total, y: v) orelse return none;
            } else {
                total = v;
                have = true;
            }
        }
        if i < tokens.len() {
            sign = op;
            from = i + 1;
        }
    }
    if not have {
        return none;
    }
    return total;
}

/// x * y / z.
fn product(tokens: []css.Token, cx: Ctx, depth: usize, a: alloc.Allocator) -> ?Value {
    var acc = num_value(0.0);
    var have = false;
    var op: u8 = '*';
    var i: usize = 0;
    while i < tokens.len() {
        let t = &tokens[i];
        if t.kind == css.SPACE {
            i += 1;
            continue;
        }
        if css.is_delim(t, ch: '*') or css.is_delim(t, ch: '/') {
            op = t.ch as u8;
            i += 1;
            continue;
        }
        // One factor: a value, or a bracketed expression.
        var v = num_value(0.0);
        var used: usize = 1;
        if t.kind == css.LPAREN or t.kind == css.FUNCTION {
            let end = close(tokens, start: i) orelse return none;
            let inside = tokens[i + 1..end];
            if t.kind == css.FUNCTION and (t.text.view().eq("calc") or t.text.view().eq("var")) {
                v = expression(css.trim(inside), cx: cx, depth: depth + 1, a: a) orelse return none;
            } else if t.kind == css.FUNCTION {
                v = calc_function(t.text.view(), rest: tokens[i + 1..end + 1], cx: cx, a: a) orelse return none;
            } else {
                v = expression(css.trim(inside), cx: cx, depth: depth + 1, a: a) orelse return none;
            }
            used = end + 1 - i;
        } else if t.kind == css.NUMBER {
            v = num_value(t.n);
        } else if t.kind == css.PERCENTAGE {
            v = lin(px: 0.0, percent: t.n);
        } else if t.kind == css.DIMENSION {
            let p = unit_px(t.n, unit: t.text.view(), cx: cx) orelse return none;
            v = lin(px: p, percent: 0.0);
        } else {
            return none;
        }
        i += used;
        if not have {
            acc = v;
            have = true;
        } else if op == '*' and not acc.lin {
            acc = scale(v, f: acc.num);
        } else if op == '*' and not v.lin {
            acc = scale(acc, f: v.num);
        } else if op == '/' and not v.lin and v.num != 0.0 {
            acc = scale(acc, f: 1.0 / v.num);
        } else {
            return none;
        }
    }
    if not have {
        return none;
    }
    return acc;
}

/// Where the bracket opened at start closes.
fn close(tokens: []css.Token, start: usize) -> ?usize {
    var depth: usize = 0;
    var i = start;
    while i < tokens.len() : (i += 1) {
        let k = tokens[i].kind;
        if k == css.FUNCTION or k == css.LPAREN {
            depth += 1;
        } else if k == css.RPAREN {
            if depth == 0 {
                return none;
            }
            depth -= 1;
            if depth == 0 {
                return i;
            }
        }
    }
    return none;
}

/// v times f.
fn scale(v: Value, f: f32) -> Value {
    if v.lin {
        return lin(px: v.px * f, percent: v.percent * f);
    }
    return num_value(v.num * f);
}

/// x + y; a bare zero is a length too (0 + 10px).
fn add(x: Value, y: Value) -> ?Value {
    if x.lin and y.lin {
        return lin(px: x.px + y.px, percent: x.percent + y.percent);
    }
    if not x.lin and not y.lin {
        return num_value(x.num + y.num);
    }
    if not x.lin and x.num == 0.0 {
        return y;
    }
    if not y.lin and y.num == 0.0 {
        return x;
    }
    return none;
}

// ---- colors ----------------------------------------------------------------

/// A color: #rgb, #rrggbbaa, rgb(), hsl(), a name, transparent, or
/// currentcolor, which is current.
pub fn parse_color(tokens: []css.Token, current: u32, a: alloc.Allocator) -> ?u32 {
    if tokens.len() == 1 and tokens[0].kind == css.HASH {
        return hex_color(tokens[0].text.view());
    }
    if tokens.len() == 1 and tokens[0].kind == css.IDENT {
        let word = tokens[0].text.view();
        if css.eq_ignore_case(x: word, y: "transparent") {
            return TRANSPARENT;
        }
        if css.eq_ignore_case(x: word, y: "currentcolor") {
            return current;
        }
        let v = named(word) orelse return none;
        return rgb(v);
    }
    if tokens.len() >= 1 and tokens[0].kind == css.FUNCTION {
        let rest = tokens[1..tokens.len()];
        if rest.len() == 0 or rest[rest.len() - 1].kind != css.RPAREN {
            return none;
        }
        let inner = rest[0..rest.len() - 1];
        let f = tokens[0].text.view();
        if f.eq("rgb") or f.eq("rgba") {
            return rgb_function(inner, a);
        }
        if f.eq("hsl") or f.eq("hsla") {
            return hsl_function(inner, a);
        }
    }
    return none;
}

/// The value of a hex digit.
fn hex_value(b: u8) -> u32 {
    if b >= '0' and b <= '9' {
        return (b - '0') as u32;
    }
    return (css.lower_byte(b) - 'a') as u32 + 10;
}

/// #rgb, #rgba, #rrggbb or #rrggbbaa.
fn hex_color(hex: str) -> ?u32 {
    let b = hex.bytes();
    for ch in b {
        let c = ch.*;
        let ok_digit = (c >= '0' and c <= '9') or (c >= 'a' and c <= 'f') or (c >= 'A' and c <= 'F');
        if not ok_digit {
            return none;
        }
    }
    if b.len() == 3 or b.len() == 4 {
        var alpha: u32 = 255;
        if b.len() == 4 {
            alpha = hex_value(b[3]) * 17;
        }
        return ((hex_value(b[0]) * 17) << 24) | ((hex_value(b[1]) * 17) << 16) | ((hex_value(b[2]) * 17) << 8) | alpha;
    }
    if b.len() == 6 or b.len() == 8 {
        var v: u32 = 0;
        for ch in b {
            v = (v << 4) | hex_value(ch.*);
        }
        if b.len() == 6 {
            v = (v << 8) | 0xFF;
        }
        return v;
    }
    return none;
}

/// The channels of rgb() or hsl(), comma- or space-separated, with an
/// optional alpha after / or as a fourth: the indices in inner of the
/// three, then of the alpha when there is one, into at; false for
/// arguments that are not that.
fn channels(inner: []css.Token, at: &mut alloc.List(usize)) -> bool {
    var slash: usize = 99;
    var i: usize = 0;
    while i < inner.len() : (i += 1) {
        let k = inner[i].kind;
        if k == css.SPACE or k == css.COMMA {
            continue;
        }
        if css.is_delim(&inner[i], ch: '/') and slash == 99 {
            slash = at.len();
        }
        at.push(i);
    }
    if slash != 99 {
        if slash == 3 and at.len() == 5 {
            let last = at.items()[4];
            _ = at.pop();
            _ = at.pop();
            at.push(last);
            return true;
        }
        return false;
    }
    return at.len() == 3 or at.len() == 4;
}

/// The alpha of rgb() or hsl(), as a channel: 1 when there is none.
fn alpha_of(inner: []css.Token, at: &alloc.List(usize)) -> ?u8 {
    var v: f32 = 1.0;
    if at.len() == 4 {
        let t = &inner[at.items()[3]];
        if t.kind == css.NUMBER {
            v = t.n;
        } else if t.kind == css.PERCENTAGE {
            v = t.n / 100.0;
        } else {
            return none;
        }
    }
    return round(clamp(v: v, lo: 0.0, hi: 1.0) * 255.0) as% u8;
}

/// rgb(r g b / a), each a number or a percentage.
fn rgb_function(inner: []css.Token, a: alloc.Allocator) -> ?u32 {
    var at = alloc.List(usize).init(a);
    if not channels(inner, at: &mut at) {
        return none;
    }
    var c: [3]u8 = [0; 3];
    var k: usize = 0;
    while k < 3 : (k += 1) {
        let t = &inner[at.items()[k]];
        var v: f32 = 0.0;
        if t.kind == css.NUMBER {
            v = t.n;
        } else if t.kind == css.PERCENTAGE {
            v = t.n * 2.55;
        } else {
            return none;
        }
        c[k] = round(clamp(v: v, lo: 0.0, hi: 255.0)) as% u8;
    }
    let alpha = alpha_of(inner, at: &at) orelse return none;
    return rgba(r: c[0], g: c[1], b: c[2], alpha: alpha);
}

/// hsl(h s l / a): a hue in degrees (or deg, turn, rad, grad), then two
/// percentages.
fn hsl_function(inner: []css.Token, a: alloc.Allocator) -> ?u32 {
    var at = alloc.List(usize).init(a);
    if not channels(inner, at: &mut at) {
        return none;
    }
    let ht = &inner[at.items()[0]];
    var hue: f32 = 0.0;
    if ht.kind == css.NUMBER {
        hue = ht.n;
    } else if ht.kind == css.DIMENSION {
        let u = ht.text.view();
        if u.eq("deg") {
            hue = ht.n;
        } else if u.eq("turn") {
            hue = ht.n * 360.0;
        } else if u.eq("rad") {
            hue = to_degrees(ht.n);
        } else if u.eq("grad") {
            hue = ht.n * 0.9;
        } else {
            return none;
        }
    } else {
        return none;
    }
    let s = fraction(&inner[at.items()[1]]) orelse return none;
    let l = fraction(&inner[at.items()[2]]) orelse return none;
    let h = rem_euclid(x: hue, m: 360.0) / 360.0;
    var q: f32 = 0.0;
    if l < 0.5 {
        q = l * (1.0 + s);
    } else {
        q = l + s - l * s;
    }
    let p = 2.0 * l - q;
    let third: f32 = 1.0 / 3.0;
    let alpha = alpha_of(inner, at: &at) orelse return none;
    return rgba(r: hue_channel(t0: h + third, p: p, q: q), g: hue_channel(t0: h, p: p, q: q), b: hue_channel(t0: h - third, p: p, q: q), alpha: alpha);
}

/// A saturation or lightness, 0 to 1: a percentage, or a number of them.
fn fraction(t: &css.Token) -> ?f32 {
    if t.kind == css.PERCENTAGE or t.kind == css.NUMBER {
        return clamp(v: t.n / 100.0, lo: 0.0, hi: 1.0);
    }
    return none;
}

/// One channel of an HSL color, at t around the hue circle.
fn hue_channel(t0: f32, p: f32, q: f32) -> u8 {
    let t = rem_euclid(x: t0, m: 1.0);
    let sixth: f32 = 1.0 / 6.0;
    let two_thirds: f32 = 2.0 / 3.0;
    var v: f32 = 0.0;
    if t < sixth {
        v = p + (q - p) * 6.0 * t;
    } else if t < 0.5 {
        v = q;
    } else if t < two_thirds {
        v = p + (q - p) * (two_thirds - t) * 6.0;
    } else {
        v = p;
    }
    return clamp(v: round(v * 255.0), lo: 0.0, hi: 255.0) as% u8;
}

/// CSS's named colors, name:rrggbb, in order.
const NAMES: str = "aliceblue:f0f8ff antiquewhite:faebd7 aqua:00ffff aquamarine:7fffd4 azure:f0ffff beige:f5f5dc bisque:ffe4c4 black:000000 blanchedalmond:ffebcd blue:0000ff blueviolet:8a2be2 brown:a52a2a burlywood:deb887 cadetblue:5f9ea0 chartreuse:7fff00 chocolate:d2691e coral:ff7f50 cornflowerblue:6495ed cornsilk:fff8dc crimson:dc143c cyan:00ffff darkblue:00008b darkcyan:008b8b darkgoldenrod:b8860b darkgray:a9a9a9 darkgreen:006400 darkgrey:a9a9a9 darkkhaki:bdb76b darkmagenta:8b008b darkolivegreen:556b2f darkorange:ff8c00 darkorchid:9932cc darkred:8b0000 darksalmon:e9967a darkseagreen:8fbc8f darkslateblue:483d8b darkslategray:2f4f4f darkslategrey:2f4f4f darkturquoise:00ced1 darkviolet:9400d3 deeppink:ff1493 deepskyblue:00bfff dimgray:696969 dimgrey:696969 dodgerblue:1e90ff firebrick:b22222 floralwhite:fffaf0 forestgreen:228b22 fuchsia:ff00ff gainsboro:dcdcdc ghostwhite:f8f8ff gold:ffd700 goldenrod:daa520 gray:808080 green:008000 greenyellow:adff2f grey:808080 honeydew:f0fff0 hotpink:ff69b4 indianred:cd5c5c indigo:4b0082 ivory:fffff0 khaki:f0e68c lavender:e6e6fa lavenderblush:fff0f5 lawngreen:7cfc00 lemonchiffon:fffacd lightblue:add8e6 lightcoral:f08080 lightcyan:e0ffff lightgoldenrodyellow:fafad2 lightgray:d3d3d3 lightgreen:90ee90 lightgrey:d3d3d3 lightpink:ffb6c1 lightsalmon:ffa07a lightseagreen:20b2aa lightskyblue:87cefa lightslategray:778899 lightslategrey:778899 lightsteelblue:b0c4de lightyellow:ffffe0 lime:00ff00 limegreen:32cd32 linen:faf0e6 magenta:ff00ff maroon:800000 mediumaquamarine:66cdaa mediumblue:0000cd mediumorchid:ba55d3 mediumpurple:9370db mediumseagreen:3cb371 mediumslateblue:7b68ee mediumspringgreen:00fa9a mediumturquoise:48d1cc mediumvioletred:c71585 midnightblue:191970 mintcream:f5fffa mistyrose:ffe4e1 moccasin:ffe4b5 navajowhite:ffdead navy:000080 oldlace:fdf5e6 olive:808000 olivedrab:6b8e23 orange:ffa500 orangered:ff4500 orchid:da70d6 palegoldenrod:eee8aa palegreen:98fb98 paleturquoise:afeeee palevioletred:db7093 papayawhip:ffefd5 peachpuff:ffdab9 peru:cd853f pink:ffc0cb plum:dda0dd powderblue:b0e0e6 purple:800080 rebeccapurple:663399 red:ff0000 rosybrown:bc8f8f royalblue:4169e1 saddlebrown:8b4513 salmon:fa8072 sandybrown:f4a460 seagreen:2e8b57 seashell:fff5ee sienna:a0522d silver:c0c0c0 skyblue:87ceeb slateblue:6a5acd slategray:708090 slategrey:708090 snow:fffafa springgreen:00ff7f steelblue:4682b4 tan:d2b48c teal:008080 thistle:d8bfd8 tomato:ff6347 turquoise:40e0d0 violet:ee82ee wheat:f5deb3 white:ffffff whitesmoke:f5f5f5 yellow:ffff00 yellowgreen:9acd32 ";

/// A named color's 0xRRGGBB, any case.
fn named(word: str) -> ?u32 {
    let t = NAMES.bytes();
    var i: usize = 0;
    while i < t.len() {
        var colon = i;
        while t[colon] != ':' {
            colon += 1;
        }
        if css.eq_ignore_case(x: NAMES[i..colon], y: word) {
            var v: u32 = 0;
            var k = colon + 1;
            while k < colon + 7 : (k += 1) {
                v = (v << 4) | hex_value(t[k]);
            }
            return v;
        }
        i = colon + 8;
    }
    return none;
}
