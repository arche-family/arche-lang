        let i = side_index(name[7..name.len()]);
        if i < 4 {
            s.margin[i] = values.parse_length(value, cx: cx, a: a) orelse s.margin[i];
        }
    } else if name.starts_with("padding-") {
        let i = side_index(name[8..name.len()]);
        if i < 4 {
            s.padding[i] = values.parse_length_percent(value, cx: cx, a: a) orelse s.padding[i];
        }
    }
}

/// text in lower case.
fn lowered(text: str, a: alloc.Allocator) -> alloc.String {
    return css.lowercase(text, a);
}

/// top, right, bottom or left as an index into inset; 4 for another name.
fn side_of_inset(name: str) -> usize {
    if name.eq("top") {
        return 0;
    }
    if name.eq("right") {
        return 1;
    }
    if name.eq("bottom") {
        return 2;
    }
    if name.eq("left") {
        return 3;
    }
    return 4;
}

/// border-top-left-radius and the like as an index into radius; 4 for
/// another name.
fn corner_of(name: str) -> usize {
    if name.eq("border-top-left-radius") {
        return 0;
    }
    if name.eq("border-top-right-radius") {
        return 1;
    }
    if name.eq("border-bottom-right-radius") {
        return 2;
    }
    if name.eq("border-bottom-left-radius") {
        return 3;
    }
    return 4;
}

/// top, inline-start, ... as an index into top, right, bottom, left; 4 for
/// another word.
fn side_index(side: str) -> usize {
    if side.eq("top") or side.eq("block-start") {
        return 0;
    }
    if side.eq("right") or side.eq("inline-end") {
        return 1;
    }
    if side.eq("bottom") or side.eq("block-end") {
        return 2;
    }
    if side.eq("left") or side.eq("inline-start") {
        return 3;
    }
    return 4;
}

/// none as auto, or a length.
fn none_or_length(t: []css.Token, cx: values.Ctx, a: alloc.Allocator) -> ?values.Length {
    if values.is_keyword(t, word: "none") {
        return values.auto();
    }
    return values.parse_length(t, cx: cx, a: a);
}

/// border-top, border-left-color, ...: rest is what follows border-.
fn border_side(s: &mut Style, rest: str, value: []css.Token, w: []css.Span, cx: values.Ctx, current: u32, a: alloc.Allocator) {
    // The side, and the part after it: border-top-width.
    var dash = rest.len();
    var i: usize = 0;
    while i < rest.len() : (i += 1) {
        if rest.bytes()[i] == '-' {
            dash = i;
            break;
        }
    }
    var side_word = rest;
    var part = "";
    var has_part = false;
    if dash < rest.len() and side_index(rest[0..dash]) < 4 {
        side_word = rest[0..dash];
        part = rest[dash + 1..rest.len()];
        has_part = true;
    }
    let k = side_index(side_word);
    if k >= 4 {
        return;
    }
    if not has_part {
        let p = border_parts(value, w: w, cx: cx, current: current, a: a) orelse return;
        s.border_width[k] = p.width;
        s.border_style[k] = p.style;
        s.border_color[k] = p.color;
        s.border_current[k] = not p.has_color;
        return;
    }
    if part.eq("width") {
        s.border_width[k] = border_width_of(value, cx: cx, a: a) orelse s.border_width[k];
    } else if part.eq("style") {
        s.border_style[k] = keyword_index(table: BORDER_STYLES, word: values.keyword_text(value)) orelse s.border_style[k];
    } else if part.eq("color") {
        match values.parse_color(value, current: current, a: a) {
            some(c) => {
                s.border_color[k] = c;
                s.border_current[k] = false;
            }
            none => { }
        }
    }
}

/// flex: none | auto | <grow> [<shrink>] [<basis>].
fn flex(s: &mut Style, value: []css.Token, w: []css.Span, cx: values.Ctx, a: alloc.Allocator) {
    if w.len() == 1 {
        let k = values.keyword_text(value[w[0].from..w[0].to]);
        if eqi(x: k, word: "none") {
            s.flex_grow = 0.0;
            s.flex_shrink = 0.0;
            s.flex_basis = values.auto();
            return;
        }
        if eqi(x: k, word: "auto") {
            s.flex_grow = 1.0;
            s.flex_shrink = 1.0;
            s.flex_basis = values.auto();
            return;
        }
    }
    var numbers = alloc.List(f32).init(a);
    var has_basis = false;
    var basis = values.zero();
    for sp in w {
        let t = value[sp.from..sp.to];
        match values.parse_number(t, a) {
            some(n) => { numbers.push(n); }
            none => {
                basis = values.parse_length(t, cx: cx, a: a) orelse return;
                has_basis = true;
            }
        }
    }
    if numbers.len() == 0 {
        return;
    }
    var shrink: f32 = 1.0;
    if numbers.len() > 1 {
        shrink = numbers.items()[1];
    }
    // flex: 1 is 1 1 0, not 1 1 auto.
    s.flex_grow = values.fmax(x: numbers.items()[0], y: 0.0);
    s.flex_shrink = values.fmax(x: shrink, y: 0.0);
    if has_basis {
        s.flex_basis = basis;
    } else {
        s.flex_basis = values.zero();
    }
}

/// One grid track: auto, min-content, max-content, Nfr, minmax(a, b),
/// fit-content(l), or a length or percentage.
fn track(t: []css.Token, cx: values.Ctx, a: alloc.Allocator) -> ?Track {
    let k = values.keyword_text(t);
    if k.len() > 0 {
        var kind: u8 = 0;
        if eqi(x: k, word: "auto") {
            kind = TRACK_AUTO;
        } else if eqi(x: k, word: "min-content") {
            kind = TRACK_MIN_CONTENT;
        } else if eqi(x: k, word: "max-content") {
            kind = TRACK_MAX_CONTENT;
        } else {
            return none;
        }
        return Track { kind: kind, len: values.auto(), fr: 0.0, sub: alloc.List(Track).init(a) };
    }
    if t.len() == 1 and t[0].kind == css.DIMENSION and t[0].text.view().eq("fr") and t[0].n >= 0.0 {
        return Track { kind: TRACK_FR, len: values.auto(), fr: t[0].n, sub: alloc.List(Track).init(a) };
    }
    if t.len() >= 2 and t[0].kind == css.FUNCTION and t[0].text.view().eq("minmax") {
        let inner = t[1..t.len() - 1];
        let comma = css.plain(css.COMMA, a);
        let parts = css.split_top(inner, sep: &comma, a: a);
        if parts.len() != 2 {
            return none;
        }
        let p0 = parts.items()[0];
        let p1 = parts.items()[1];
        let lo = track(css.trim(inner[p0.from..p0.to]), cx: cx, a: a) orelse return none;
        let hi = track(css.trim(inner[p1.from..p1.to]), cx: cx, a: a) orelse return none;
        var sub = alloc.List(Track).init(a);
        sub.push(lo);
        sub.push(hi);
        return Track { kind: TRACK_MINMAX, len: values.auto(), fr: 0.0, sub: sub };
    }
    if t.len() >= 2 and t[0].kind == css.FUNCTION and t[0].text.view().eq("fit-content") {
        let l = values.parse_length_percent(css.trim(t[1..t.len() - 1]), cx: cx, a: a) orelse return none;
        return Track { kind: TRACK_FIT_CONTENT, len: l, fr: 0.0, sub: alloc.List(Track).init(a) };
    }
    if t.len() == 1 and t[0].kind == css.FUNCTION and (t[0].text.view().eq("minmax") or t[0].text.view().eq("fit-content")) {
        // The name and nothing after it: nothing to take a bracket from.
        return none;
    }
    let l = values.parse_length_percent(t, cx: cx, a: a) orelse return none;
    return Track { kind: TRACK_FIXED, len: l, fr: 0.0, sub: alloc.List(Track).init(a) };
}

/// grid-template-columns: none, or tracks and repeat()s. Line names in
/// brackets are skipped.
fn track_list(value: []css.Token, w: []css.Span, cx: values.Ctx, a: alloc.Allocator) -> ?alloc.List(TrackEntry) {
    var out = alloc.List(TrackEntry).init(a);
    if w.len() == 1 and values.is_keyword(value[w[0].from..w[0].to], word: "none") {
        return out;
    }
    for sp in w {
        let t = value[sp.from..sp.to];
        if t[0].kind == css.LBRACKET {
            continue;
        }
        if t[0].kind == css.FUNCTION and t[0].text.view().eq("repeat") {
            if t.len() < 2 {
                return none;
            }
            let inner = t[1..t.len() - 1];
            var at = inner.len();
            var i: usize = 0;
            while i < inner.len() : (i += 1) {
                if inner[i].kind == css.COMMA {
                    at = i;
                    break;
                }
            }
            if at == inner.len() {
                return none;
            }
            let count = css.trim(inner[0..at]);
            var count_kind = REPEAT_COUNT;
            var n: u16 = 0;
            if values.is_keyword(count, word: "auto-fill") {
                count_kind = REPEAT_AUTO_FILL;
            } else if values.is_keyword(count, word: "auto-fit") {
                count_kind = REPEAT_AUTO_FIT;
            } else {
                let c = integer(count, a: a) orelse return none;
                if c < 1 or c > 1000 {
                    return none;
                }
                n = c as u16;
            }
            let body = css.trim(inner[at + 1..inner.len()]);
            let bw = values.words(body, a);
            var tracks = alloc.List(Track).init(a);
            for bs in bw.items() {
                let x = body[bs.from..bs.to];
                if x[0].kind == css.LBRACKET {
                    continue;
                }
                let one = track(x, cx: cx, a: a) orelse return none;
                tracks.push(one);
            }
            if tracks.len() == 0 {
                return none;
            }
            out.push(TrackEntry { repeat: true, count_kind: count_kind, count: n, tracks: tracks });
            continue;
        }
        let one = track(t, cx: cx, a: a) orelse return none;
        var tracks = alloc.List(Track).init(a);
        tracks.push(one);
        out.push(TrackEntry { repeat: false, count_kind: REPEAT_COUNT, count: 0, tracks: tracks });
    }
    return out;
}

/// One grid line: auto, 3, -1, span 2.
fn line(t: []css.Token, a: alloc.Allocator) -> ?Line {
    let wl = values.words(t, a);
    let w = wl.items();
    if w.len() == 1 {
        let one = t[w[0].from..w[0].to];
        if values.is_keyword(one, word: "auto") {
            return Line { kind: LINE_AUTO, n: 0 };
        }
        let n = integer(one, a: a) orelse return none;
        if n != 0 and n >= -10000 and n <= 10000 {
            return Line { kind: LINE_INDEX, n: n };
        }
        return none;
    }
    if w.len() == 2 and values.is_keyword(t[w[0].from..w[0].to], word: "span") {
        let n = integer(t[w[1].from..w[1].to], a: a) orelse return none;
        if n >= 1 and n <= 10000 {
            return Line { kind: LINE_SPAN, n: n };
        }
    }
    return none;
}

/// grid-column: 1 / 3, span 2, 2 / span 2.
fn placement(t: []css.Token, a: alloc.Allocator) -> ?Placement {
    let slash = css.Token { kind: css.DELIM, n: 0.0, ch: '/' as u32, text: alloc.String.init(a) };
    let parts = css.split_top(t, sep: &slash, a: a);
    if parts.len() == 1 {
        let p0 = parts.items()[0];
        let start = line(css.trim(t[p0.from..p0.to]), a: a) orelse return none;
        return Placement { start: start, end: Line { kind: LINE_AUTO, n: 0 } };
    }
    if parts.len() == 2 {
        let p0 = parts.items()[0];
        let p1 = parts.items()[1];
        let start = line(css.trim(t[p0.from..p0.to]), a: a) orelse return none;
        let end = line(css.trim(t[p1.from..p1.to]), a: a) orelse return none;
        return Placement { start: start, end: end };
    }
    return none;
}

/// background and background-image: a color and a gradient, wherever they
/// sit among the other background values, which this host does not draw.
fn background(s: &mut Style, name: str, value: []css.Token, w: []css.Span, kw: str, current: u32, a: alloc.Allocator) {
    let whole = name.eq("background");
    if eqi(x: kw, word: "none") {
        s.has_gradient = false;
        s.gradient.stops = alloc.List(Stop).init(a);
        if whole {
            s.background = values.TRANSPARENT;
        }
        return;
    }
    var has_col = false;
    var col: u32 = 0;
    var has_grad = false;
    var grad = Gradient { angle: 180.0, stops: alloc.List(Stop).init(a) };
    for sp in w {
        let t = value[sp.from..sp.to];
        match values.parse_color(t, current: current, a: a) {
            some(c) => {
                col = c;
                has_col = true;
            }
            none => {
                match linear_gradient(t, current: current, a: a) {
                    some(g) => {
                        grad = g;
                        has_grad = true;
                    }
                    none => { }
                }
            }
        }
    }
    if whole {
        if not has_col and not has_grad {
            return;
        }
        if has_col {
            s.background = col;
        } else {
            s.background = values.TRANSPARENT;
        }
    }
    s.has_gradient = has_grad;
    s.gradient = grad;
}

/// linear-gradient(...): an angle or `to <side>`, then color stops.
fn linear_gradient(t: []css.Token, current: u32, a: alloc.Allocator) -> ?Gradient {
    if t.len() < 2 or t[0].kind != css.FUNCTION or not t[0].text.view().eq("linear-gradient") {
        return none;
    }
    let inner = t[1..t.len() - 1];
    let comma = css.plain(css.COMMA, a);
    let parts = css.split_top(inner, sep: &comma, a: a);
    var angle: f32 = 180.0;
    var stops_from: usize = 0;
    let p0 = parts.items()[0];
    let first = css.trim(inner[p0.from..p0.to]);
    let fwl = values.words(first, a);
    let fw = fwl.items();
    if first.len() == 1 and first[0].kind == css.DIMENSION {
        let u = first[0].text.view();
        let n = first[0].n;
        if u.eq("deg") {
            angle = n;
        } else if u.eq("turn") {
            angle = n * 360.0;
        } else if u.eq("rad") {
            angle = values.to_degrees(n);
        } else if u.eq("grad") {
            angle = n * 0.9;
        } else {
            return none;
        }
        stops_from = 1;
    } else if fw.len() > 0 and values.is_keyword(first[fw[0].from..fw[0].to], word: "to") {
        var right = false;
        var left = false;
        var bottom = false;
        var top = false;
        var i: usize = 1;
        while i < fw.len() : (i += 1) {
            let k = values.keyword_text(first[fw[i].from..fw[i].to]);
            if eqi(x: k, word: "right") {
                right = true;
            } else if eqi(x: k, word: "left") {
                left = true;
            } else if eqi(x: k, word: "bottom") {
                bottom = true;
            } else if eqi(x: k, word: "top") {
                top = true;
            }
        }
        // atan2(x, -y) in degrees, x and y each -1, 0 or 1: a multiple
        // of 45 exactly, as Rust's f32 arithmetic leaves it.
        var x: i32 = 0;
        if right {
            x = 1;
        } else if left {
            x = -1;
        }
        var y: i32 = 0;
        if bottom {
            y = 1;
        } else if top {
            y = -1;
        }
        angle = 180.0;
        if x == 0 and y == -1 {
            angle = 0.0;
        } else if x == 1 and y == 0 {
            angle = 90.0;
        } else if x == -1 and y == 0 {
            angle = -90.0;
        } else if x == 1 and y == -1 {
            angle = 45.0;
        } else if x == 1 and y == 1 {
            angle = 135.0;
        } else if x == -1 and y == 1 {
            angle = -135.0;
        } else if x == -1 and y == -1 {
            angle = -45.0;
        }
        stops_from = 1;
    }
    var g = Gradient { angle: angle, stops: alloc.List(Stop).init(a) };
    var pi = stops_from;
    while pi < parts.len() : (pi += 1) {
        let p = parts.items()[pi];
        let part = css.trim(inner[p.from..p.to]);
        let pwl = values.words(part, a);
        let pw = pwl.items();
        if pw.len() == 0 {
            return none;
        }
        let c = values.parse_color(part[pw[0].from..pw[0].to], current: current, a: a) orelse return none;
        var stop = Stop { color: c, has_at: false, at: 0.0 };
        if pw.len() > 1 {
            let second = part[pw[1].from..pw[1].to];
            if second.len() == 1 and second[0].kind == css.PERCENTAGE {
                stop.has_at = true;
                stop.at = second[0].n / 100.0;
            }
        }
        g.stops.push(stop);
    }
    if g.stops.len() < 2 {
        return none;
    }
    return g;
}

/// [inset] x y [blur [spread]] [color], in any order around the lengths.
fn shadow(value: []css.Token, w: []css.Span, cx: values.Ctx, current: u32, a: alloc.Allocator) -> ?Shadow {
    var lengths: [4]f32 = [0.0; 4];
    var count: usize = 0;
    var sh = Shadow { x: 0.0, y: 0.0, blur: 0.0, spread: 0.0, has_color: false, color: 0, inset: false };
    for sp in w {
        let t = value[sp.from..sp.to];
        if values.is_keyword(t, word: "inset") {
            sh.inset = true;
            continue;
        }
        match values.parse_px(t, cx: cx, a: a) {
            some(p) => {
                if count < 4 {
                    lengths[count] = p;
                }
                count += 1;
            }
            none => {
                sh.color = values.parse_color(t, current: current, a: a) orelse return none;
                sh.has_color = true;
            }
        }
    }
    if count < 2 or count > 4 {
        return none;
    }
    sh.x = lengths[0];
    sh.y = lengths[1];
    sh.blur = values.fmax(x: lengths[2], y: 0.0);
    sh.spread = lengths[3];
    return sh;
}

/// font-size: a keyword, a percentage of the parent's, or a length (em
/// the parent's); limited to 1..=1000.
fn font_size(t: []css.Token, parent: f32, cx: values.Ctx, a: alloc.Allocator) -> ?f32 {
    let k = values.keyword_text(t);
    var size: f32 = 0.0;
    if k.len() > 0 {
        if eqi(x: k, word: "xx-small") {
            size = 9.0;
        } else if eqi(x: k, word: "x-small") {
            size = 10.0;
        } else if eqi(x: k, word: "small") {
            size = 13.0;
        } else if eqi(x: k, word: "medium") {
            size = 16.0;
        } else if eqi(x: k, word: "large") {
            size = 18.0;
        } else if eqi(x: k, word: "x-large") {
            size = 24.0;
        } else if eqi(x: k, word: "xx-large") {
            size = 32.0;
        } else if eqi(x: k, word: "xxx-large") {
            size = 48.0;
        } else if eqi(x: k, word: "smaller") {
            size = parent / 1.2;
        } else if eqi(x: k, word: "larger") {
            size = parent * 1.2;
        } else {
            return none;
        }
    } else if t.len() == 1 and t[0].kind == css.PERCENTAGE {
        size = parent * t[0].n / 100.0;
    } else {
        size = values.parse_px(t, cx: values.Ctx { em: parent, rem: cx.rem, vw: cx.vw, vh: cx.vh }, a: a) orelse return none;
    }
    // Past this a glyph is bigger than any screen; under it, invisible.
    return values.clamp(v: size, lo: 1.0, hi: 1000.0);
}

/// font-weight: a keyword, or a number from 1 to 1000.
fn font_weight(t: []css.Token, parent: u16, a: alloc.Allocator) -> ?u16 {
    let k = values.keyword_text(t);
    if k.len() > 0 {
        if eqi(x: k, word: "normal") {
            return 400;
        }
        if eqi(x: k, word: "bold") {
            return 700;
        }
        if eqi(x: k, word: "bolder") {
            if parent < 400 {
                return 400;
            }
            if parent < 600 {
                return 700;
            }
            return 900;
        }
        if eqi(x: k, word: "lighter") {
            if parent < 600 {
                return 100;
            }
            if parent < 800 {
                return 400;
            }
            return 700;
        }
        return none;
    }
    let n = values.parse_number(t, a) orelse return none;
    if n >= 1.0 and n <= 1000.0 {
        return n as u16;
    }
    return none;
}

/// Whether a family list asks for a fixed-width font: monospace, or one of
/// the names people reach for when they mean it.
fn monospace(t: []css.Token, a: alloc.Allocator) -> bool {
    let comma = css.plain(css.COMMA, a);
    let parts = css.split_top(t, sep: &comma, a: a);
    for p in parts.items() {
        var text = alloc.String.init(a);
        css.to_css(css.trim(t[p.from..p.to]), out: &mut text);
        var v = text.view();
        while v.len() > 0 and v.bytes()[0] == '"' {
            v = v[1..v.len()];
        }
        while v.len() > 0 and v.bytes()[v.len() - 1] == '"' {
            v = v[0..v.len() - 1];
        }
        let low = css.lowercase(v, a);
        let n = low.view();
        if n.eq("monospace") or n.eq("ui-monospace") or n.eq("menlo") or n.eq("monaco") or n.eq("consolas") or n.eq("courier") or n.eq("courier new") or n.eq("sf mono") or n.eq("jetbrains mono") or n.eq("fira code") or n.eq("fira mono") or n.eq("source code pro") or n.eq("roboto mono") or n.eq("dejavu sans mono") or n.eq("liberation mono") or n.eq("cascadia code") or n.eq("ubuntu mono") or n.eq("noto sans mono") {
            return true;
        }
    }
    return false;
}

/// line-height: normal, a factor, a percentage or a length (of em).
fn line_height(t: []css.Token, cx: values.Ctx, a: alloc.Allocator) -> ?LineHeight {
    if t.len() == 1 and t[0].kind == css.IDENT and eqi(x: t[0].text.view(), word: "normal") {
        return LineHeight { kind: LINE_NORMAL, v: 0.0 };
    }
    if t.len() == 1 and t[0].kind == css.NUMBER {
        if t[0].n >= 0.0 {
            return LineHeight { kind: LINE_FACTOR, v: t[0].n };
        }
        return none;
    }
    if t.len() == 1 and t[0].kind == css.PERCENTAGE {
        if t[0].n >= 0.0 {
            return LineHeight { kind: LINE_PX, v: cx.em * t[0].n / 100.0 };
        }
        return none;
    }
    let p = values.parse_px(t, cx: cx, a: a) orelse return none;
    if p >= 0.0 {
        return LineHeight { kind: LINE_PX, v: p };
    }
    return none;
}

/// font: [style] [weight] size[/line-height] family.
fn font(s: &mut Style, parent: &Style, value: []css.Token, w: []css.Span, cx: values.Ctx, a: alloc.Allocator) {
    // The size is the first word that reads as one; the family follows it.
    let slash = css.Token { kind: css.DELIM, n: 0.0, ch: '/' as u32, text: alloc.String.init(a) };
    var at = w.len();
    var i: usize = 0;
    while i < w.len() : (i += 1) {
        let t = value[w[i].from..w[i].to];
        let sp = css.split_top(t, sep: &slash, a: a);
        let head = css.trim(t[sp.items()[0].from..sp.items()[0].to]);
        match font_size(head, parent: parent.font_size, cx: cx, a: a) {
            some(_) => {
                if not values.is_keyword(head, word: "normal") {
                    at = i;
                    break;
                }
            }
            none => { }
        }
    }
    if at == w.len() {
        return;
    }
    let t = value[w[at].from..w[at].to];
    let size_parts = css.split_top(t, sep: &slash, a: a);
    let sp0 = size_parts.items()[0];
    let size = font_size(css.trim(t[sp0.from..sp0.to]), parent: parent.font_size, cx: cx, a: a) orelse return;
    s.font_size = size;
    s.italic = false;
    s.font_weight = 400;
    s.line_height = LineHeight { kind: LINE_NORMAL, v: 0.0 };
    var k: usize = 0;
    while k < at : (k += 1) {
        let word = value[w[k].from..w[k].to];
        let kw = values.keyword_text(word);
        if eqi(x: kw, word: "italic") or eqi(x: kw, word: "oblique") {
            s.italic = true;
        } else {
            s.font_weight = font_weight(word, parent: parent.font_weight, a: a) orelse s.font_weight;
        }
    }
    if size_parts.len() > 1 {
        let sp1 = size_parts.items()[1];
        let lcx = values.Ctx { em: size, rem: cx.rem, vw: cx.vw, vh: cx.vh };
        s.line_height = line_height(css.trim(t[sp1.from..sp1.to]), cx: lcx, a: a) orelse s.line_height;
    }
    s.monospace = monospace(value[w[at].to..value.len()], a: a);
}

/// Whether a property inherits.
fn is_inherited(name: str) -> bool {
    return one_of(word: name, list: "color font font-size font-weight font-style font-family line-height text-align white-space text-transform letter-spacing visibility cursor list-style list-style-type pointer-events");
}

/// A copy of a list of tracks.
fn copy_tracks(list: &alloc.List(Track), a: alloc.Allocator) -> alloc.List(Track) {
    var out = alloc.List(Track).init(a);
    for t in list.items() {
        out.push(Track { kind: t.kind, len: t.len, fr: t.fr, sub: copy_tracks(&t.sub, a: a) });
    }
    return out;
}

/// A copy of a gradient.
fn copy_gradient(g: &Gradient, a: alloc.Allocator) -> Gradient {
    var stops = alloc.List(Stop).init(a);
    for st in g.stops.items() {
        stops.push(st.*);
    }
    return Gradient { angle: g.angle, stops: stops };
}

/// name (and, for a shorthand, what it covers) copied from from: what
/// inherit, initial and unset do.
fn copy_property(s: &mut Style, from: &Style, name: str, a: alloc.Allocator) {
    if name.eq("display") {
        s.display = from.display;
    } else if name.eq("position") {
        s.position = from.position;
    } else if side_of_inset(name) < 4 {
        s.inset[side_of_inset(name)] = from.inset[side_of_inset(name)];
    } else if name.eq("inset") {
        s.inset = from.inset;
    } else if name.eq("width") {
        s.width = from.width;
    } else if name.eq("height") {
        s.height = from.height;
    } else if name.eq("min-width") {
        s.min_width = from.min_width;
    } else if name.eq("min-height") {
        s.min_height = from.min_height;
    } else if name.eq("max-width") {
        s.max_width = from.max_width;
    } else if name.eq("max-height") {
        s.max_height = from.max_height;
    } else if name.eq("margin") {
        s.margin = from.margin;
    } else if name.eq("padding") {
        s.padding = from.padding;
    } else if name.eq("border") {
        s.border_width = from.border_width;
        s.border_style = from.border_style;
        s.border_color = from.border_color;
        s.border_current = from.border_current;
    } else if name.eq("border-width") {
        s.border_width = from.border_width;
    } else if name.eq("border-style") {
        s.border_style = from.border_style;
    } else if name.eq("border-color") {
        s.border_color = from.border_color;
        s.border_current = from.border_current;
    } else if name.eq("border-radius") {
        s.radius = from.radius;
    } else if name.eq("box-sizing") {
        s.box_sizing = from.box_sizing;
    } else if name.eq("overflow") {
        s.overflow = from.overflow;
    } else if name.eq("overflow-x") {
        s.overflow[0] = from.overflow[0];
    } else if name.eq("overflow-y") {
        s.overflow[1] = from.overflow[1];
    } else if name.eq("flex-direction") {
        s.flex_direction = from.flex_direction;
    } else if name.eq("flex-wrap") {
        s.flex_wrap = from.flex_wrap;
    } else if name.eq("justify-content") {
        s.justify_content = from.justify_content;
    } else if name.eq("align-items") {
        s.align_items = from.align_items;
    } else if name.eq("align-self") {
        s.align_self = from.align_self;
    } else if name.eq("align-content") {
        s.align_content = from.align_content;
    } else if name.eq("flex") {
        s.flex_grow = from.flex_grow;
        s.flex_shrink = from.flex_shrink;
        s.flex_basis = from.flex_basis;
    } else if name.eq("flex-grow") {
        s.flex_grow = from.flex_grow;
    } else if name.eq("flex-shrink") {
        s.flex_shrink = from.flex_shrink;
    } else if name.eq("flex-basis") {
        s.flex_basis = from.flex_basis;
    } else if name.eq("gap") {
        s.gap = from.gap;
    } else if name.eq("background") or name.eq("background-color") {
        s.background = from.background;
        s.has_gradient = from.has_gradient;
        s.gradient = copy_gradient(&from.gradient, a: a);
    } else if name.eq("opacity") {
        s.opacity = from.opacity;
    } else if name.eq("box-shadow") {
        s.has_shadow = from.has_shadow;
        s.shadow = from.shadow;
    } else if name.eq("color") {
        s.color = from.color;
    } else if name.eq("font-size") {
        s.font_size = from.font_size;
    } else if name.eq("font-weight") {
        s.font_weight = from.font_weight;
    } else if name.eq("font-style") {
        s.italic = from.italic;
    } else if name.eq("font-family") {
        s.monospace = from.monospace;
    } else if name.eq("font") {
        s.font_size = from.font_size;
        s.font_weight = from.font_weight;
        s.italic = from.italic;
        s.monospace = from.monospace;
        s.line_height = from.line_height;
    } else if name.eq("line-height") {
        s.line_height = from.line_height;
    } else if name.eq("text-align") {
        s.text_align = from.text_align;
    } else if name.eq("white-space") {
        s.white_space = from.white_space;
    } else if name.eq("text-transform") {
        s.text_transform = from.text_transform;
    } else if name.eq("letter-spacing") {
        s.letter_spacing = from.letter_spacing;
    } else if name.eq("text-decoration") or name.eq("text-decoration-line") {
        s.text_decoration = from.text_decoration;
    } else if name.eq("visibility") {
        s.visibility = from.visibility;
    } else if name.eq("cursor") {
        s.cursor = from.cursor;
    } else if name.eq("list-style") or name.eq("list-style-type") {
        s.list_style = from.list_style;
    } else if name.eq("pointer-events") {
        s.pointer_events = from.pointer_events;
    } else if name.eq("z-index") {
        s.has_z_index = from.has_z_index;
        s.z_index = from.z_index;
    } else if name.eq("float") {
        s.float = from.float;
    } else if name.eq("clear") {
        s.clear = from.clear;
    } else if name.eq("order") {
        s.order = from.order;
    }
}

// ---- as the headless runner prints it --------------------------------------

/// "name: " after the ones before it, parted by "; ".
fn put(out: &mut alloc.String, first: &mut bool, name: str) {
    if not first.* {
        out.push_str("; ");
    }
    first.* = false;
    out.push_str(name);
    out.push_str(": ");
}

/// Four side values the way a shorthand writes them: 8px, 8px 16px, ...
fn short4(v: []alloc.String, out: &mut alloc.String) {
    let p = v[0].view();
    let q = v[1].view();
    let r = v[2].view();
    let t = v[3].view();
    if p.eq(q) and q.eq(r) and r.eq(t) {
        out.push_str(p);
    } else if p.eq(r) and q.eq(t) {
        out.push_str(p);
        out.push_str(" ");
        out.push_str(q);
    } else if q.eq(t) {
        out.push_str(p);
        out.push_str(" ");
        out.push_str(q);
        out.push_str(" ");
        out.push_str(r);
    } else {
        out.push_str(p);
        out.push_str(" ");
        out.push_str(q);
        out.push_str(" ");
        out.push_str(r);
        out.push_str(" ");
        out.push_str(t);
    }
}

/// Two values the way a shorthand writes them: one when they are the same.
fn short2(p: str, q: str, out: &mut alloc.String) {
    out.push_str(p);
    if not p.eq(q) {
        out.push_str(" ");
        out.push_str(q);
    }
}

/// Four lengths, shorthand.
fn quad_css(v: [4]values.Length, out: &mut alloc.String, a: alloc.Allocator) {
    var texts = alloc.List(alloc.String).init(a);
    var i: usize = 0;
    while i < 4 : (i += 1) {
        var t = alloc.String.init(a);
        values.write_length(v[i], out: &mut t);
        texts.push(t);
    }
    short4(texts.items(), out: out);
}

/// Whether four lengths are the same as four others.
fn quad_eq(x: [4]values.Length, y: [4]values.Length) -> bool {
    var i: usize = 0;
    while i < 4 : (i += 1) {
        if not values.length_eq(x: x[i], y: y[i]) {
            return false;
        }
    }
    return true;
}

/// A grid track as CSS.
fn track_css(t: &Track, out: &mut alloc.String) {
    let k = t.kind;
    if k == TRACK_FIXED {
        values.write_length(t.len, out: out);
    } else if k == TRACK_FR {
        css.write_number(t.fr, out: out);
        out.push_str("fr");
    } else if k == TRACK_AUTO {
        out.push_str("auto");
    } else if k == TRACK_MIN_CONTENT {
        out.push_str("min-content");
    } else if k == TRACK_MAX_CONTENT {
        out.push_str("max-content");
    } else if k == TRACK_MINMAX {
        out.push_str("minmax(");
        track_css(&t.sub.items()[0], out: out);
        out.push_str(", ");
        track_css(&t.sub.items()[1], out: out);
        out.push_str(")");
    } else {
        out.push_str("fit-content(");
        values.write_length(t.len, out: out);
        out.push_str(")");
    }
}

/// A track list as CSS; none when it is empty.
fn tracks_css(list: &alloc.List(TrackEntry), out: &mut alloc.String) {
    if list.len() == 0 {
        out.push_str("none");
        return;
    }
    var first = true;
    for e in list.items() {
        if not first {
            out.push_str(" ");
        }
        first = false;
        if not e.repeat {
            track_css(&e.tracks.items()[0], out: out);
            continue;
        }
        out.push_str("repeat(");
        if e.count_kind == REPEAT_AUTO_FILL {
            out.push_str("auto-fill");
        } else if e.count_kind == REPEAT_AUTO_FIT {
            out.push_str("auto-fit");
        } else {
            out.push_u64(e.count as u64);
        }
        out.push_str(", ");
        var inner_first = true;
        for t in e.tracks.items() {
            if not inner_first {
                out.push_str(" ");
            }
            inner_first = false;
            track_css(t, out: out);
        }
        out.push_str(")");
    }
}

/// A grid line as CSS.
fn line_css(l: Line, out: &mut alloc.String) {
    if l.kind == LINE_AUTO {
        out.push_str("auto");
    } else if l.kind == LINE_INDEX {
        out.push_i64(l.n as i64);
    } else {
        out.push_str("span ");
        out.push_i64(l.n as i64);
    }
}

/// A placement as CSS: start / end.
fn placement_css(p: Placement, out: &mut alloc.String) {
    line_css(p.start, out: out);
    out.push_str(" / ");
    line_css(p.end, out: out);
}

/// The properties style sets differently from where it started, what its
/// own rules did, as the headless runner prints them: for an inherited
/// property against parent, for the rest against their initial values and
/// the tag's display. "" when nothing differs.
pub fn describe(style: &Style, parent: &Style, tag: str, out: &mut alloc.String, a: alloc.Allocator) {
    let base = child_of(parent, tag: tag, a: a);
    var first = true;
    if style.display != base.display {
        put(out, first: &mut first, name: "display");
        out.push_str(keyword_name(table: DISPLAYS, k: style.display));
    }
    if style.position != base.position {
        put(out, first: &mut first, name: "position");
        out.push_str(keyword_name(table: POSITIONS, k: style.position));
    }
    if not quad_eq(x: style.inset, y: base.inset) {
        put(out, first: &mut first, name: "inset");
        quad_css(style.inset, out: out, a: a);
    }
    if not values.length_eq(x: style.width, y: base.width) {
        put(out, first: &mut first, name: "width");
        values.write_length(style.width, out: out);
    }
    if not values.length_eq(x: style.height, y: base.height) {
        put(out, first: &mut first, name: "height");
        values.write_length(style.height, out: out);
    }
    if not values.length_eq(x: style.min_width, y: base.min_width) {
        put(out, first: &mut first, name: "min-width");
        values.write_length(style.min_width, out: out);
    }
    if not values.length_eq(x: style.min_height, y: base.min_height) {
        put(out, first: &mut first, name: "min-height");
        values.write_length(style.min_height, out: out);
    }
    if not values.length_eq(x: style.max_width, y: base.max_width) {
        put(out, first: &mut first, name: "max-width");
        values.write_length(style.max_width, out: out);
    }
    if not values.length_eq(x: style.max_height, y: base.max_height) {
        put(out, first: &mut first, name: "max-height");
        values.write_length(style.max_height, out: out);
    }
    if not quad_eq(x: style.margin, y: base.margin) {
        put(out, first: &mut first, name: "margin");
        quad_css(style.margin, out: out, a: a);
    }
    if not quad_eq(x: style.padding, y: base.padding) {
        put(out, first: &mut first, name: "padding");
        quad_css(style.padding, out: out, a: a);
    }
    var widths_differ = false;
    var i: usize = 0;
    while i < 4 : (i += 1) {
        if style.border_width[i] != base.border_width[i] {
            widths_differ = true;
        }
    }
    if widths_differ {
        put(out, first: &mut first, name: "border");
        var widths = alloc.List(alloc.String).init(a);
        var styles = alloc.List(alloc.String).init(a);
        var colors = alloc.List(alloc.String).init(a);
        i = 0;
        while i < 4 : (i += 1) {
            var wt = alloc.String.init(a);
            css.write_number(style.border_width[i], out: &mut wt);
            wt.push_str("px");
            widths.push(wt);
            styles.push(alloc.String.from(keyword_name(table: BORDER_STYLES, k: style.border_style[i]), a));
            var ct = alloc.String.init(a);
            if style.border_current[i] {
                ct.push_str("currentcolor");
            } else {
                values.write_color(style.border_color[i], out: &mut ct);
            }
            colors.push(ct);
        }
        short4(widths.items(), out: out);
        out.push_str(" ");
        short4(styles.items(), out: out);
        out.push_str(" ");
        short4(colors.items(), out: out);
    }
    if not quad_eq(x: style.radius, y: base.radius) {
        put(out, first: &mut first, name: "border-radius");
        quad_css(style.radius, out: out, a: a);
    }
    if style.box_sizing != base.box_sizing {
        put(out, first: &mut first, name: "box-sizing");
        out.push_str(keyword_name(table: BOX_SIZINGS, k: style.box_sizing));
    }
    if style.overflow[0] != base.overflow[0] or style.overflow[1] != base.overflow[1] {
        put(out, first: &mut first, name: "overflow");
        short2(p: keyword_name(table: OVERFLOWS, k: style.overflow[0]), q: keyword_name(table: OVERFLOWS, k: style.overflow[1]), out: out);
    }
    if style.flex_direction != base.flex_direction {
        put(out, first: &mut first, name: "flex-direction");
        out.push_str(keyword_name(table: FLEX_DIRECTIONS, k: style.flex_direction));
    }
    if style.flex_wrap != base.flex_wrap {
        put(out, first: &mut first, name: "flex-wrap");
        out.push_str(keyword_name(table: FLEX_WRAPS, k: style.flex_wrap));
    }
    if style.justify_content != base.justify_content {
        put(out, first: &mut first, name: "justify-content");
        out.push_str(keyword_name(table: ALIGNS, k: style.justify_content));
    }
    if style.align_items != base.align_items {
        put(out, first: &mut first, name: "align-items");
        out.push_str(keyword_name(table: ALIGNS, k: style.align_items));
    }
    if style.align_self != base.align_self {
        put(out, first: &mut first, name: "align-self");
        out.push_str(keyword_name(table: ALIGNS, k: style.align_self));
    }
    if style.align_content != base.align_content {
        put(out, first: &mut first, name: "align-content");
        out.push_str(keyword_name(table: ALIGNS, k: style.align_content));
    }
    if style.justify_items != base.justify_items {
        put(out, first: &mut first, name: "justify-items");
        out.push_str(keyword_name(table: ALIGNS, k: style.justify_items));
    }
    if style.justify_self != base.justify_self {
        put(out, first: &mut first, name: "justify-self");
        out.push_str(keyword_name(table: ALIGNS, k: style.justify_self));
    }
    if style.flex_grow != base.flex_grow or style.flex_shrink != base.flex_shrink or not values.length_eq(x: style.flex_basis, y: base.flex_basis) {
        put(out, first: &mut first, name: "flex");
        css.write_number(style.flex_grow, out: out);
        out.push_str(" ");
        css.write_number(style.flex_shrink, out: out);
        out.push_str(" ");
        values.write_length(style.flex_basis, out: out);
    }
    if style.order != base.order {
        put(out, first: &mut first, name: "order");
        out.push_i64(style.order as i64);
    }
    if not values.length_eq(x: style.gap[0], y: base.gap[0]) or not values.length_eq(x: style.gap[1], y: base.gap[1]) {
        put(out, first: &mut first, name: "gap");
        var g0 = alloc.String.init(a);
        values.write_length(style.gap[0], out: &mut g0);
        var g1 = alloc.String.init(a);
        values.write_length(style.gap[1], out: &mut g1);
        short2(p: g0.view(), q: g1.view(), out: out);
    }
    if style.grid_template_columns.len() > 0 {
        put(out, first: &mut first, name: "grid-template-columns");
        tracks_css(&style.grid_template_columns, out: out);
    }
    if style.grid_template_rows.len() > 0 {
        put(out, first: &mut first, name: "grid-template-rows");
        tracks_css(&style.grid_template_rows, out: out);
    }
    if not placement_eq(x: style.grid_column, y: base.grid_column) {
        put(out, first: &mut first, name: "grid-column");
        placement_css(style.grid_column, out: out);
    }
    if not placement_eq(x: style.grid_row, y: base.grid_row) {
        put(out, first: &mut first, name: "grid-row");
        placement_css(style.grid_row, out: out);
    }
    if style.has_aspect_ratio {
        put(out, first: &mut first, name: "aspect-ratio");
        css.write_number(style.aspect_ratio, out: out);
    }
    if style.float != base.float {
        put(out, first: &mut first, name: "float");
        out.push_str(keyword_name(table: FLOATS, k: style.float));
    }
    if style.has_z_index != base.has_z_index or style.z_index != base.z_index {
        put(out, first: &mut first, name: "z-index");
        if style.has_z_index {
            out.push_i64(style.z_index as i64);
        } else {
            out.push_str("auto");
        }
    }
    if style.background != base.background {
        put(out, first: &mut first, name: "background");
        values.write_color(style.background, out: out);
    }
    if style.has_gradient {
        put(out, first: &mut first, name: "background-image");
        out.push_str("linear-gradient(");
        css.write_number(style.gradient.angle, out: out);
        out.push_str("deg");
        for st in style.gradient.stops.items() {
            out.push_str(", ");
            values.write_color(st.color, out: out);
        }
        out.push_str(")");
    }
    if style.opacity != base.opacity {
        put(out, first: &mut first, name: "opacity");
        css.write_number(style.opacity, out: out);
    }
    if style.has_shadow {
        put(out, first: &mut first, name: "box-shadow");
        let sh = style.shadow;
        if sh.inset {
            out.push_str("inset ");
        }
        css.write_number(sh.x, out: out);
        out.push_str("px ");
        css.write_number(sh.y, out: out);
        out.push_str("px ");
        css.write_number(sh.blur, out: out);
        out.push_str("px ");
        css.write_number(sh.spread, out: out);
        out.push_str("px ");
        if sh.has_color {
            values.write_color(sh.color, out: out);
        } else {
            out.push_str("currentcolor");
        }
    }
    if style.color != base.color {
        put(out, first: &mut first, name: "color");
        values.write_color(style.color, out: out);
    }
    if style.font_size != base.font_size {
        put(out, first: &mut first, name: "font-size");
        css.write_number(style.font_size, out: out);
        out.push_str("px");
    }
    if style.font_weight != base.font_weight {
        put(out, first: &mut first, name: "font-weight");
        out.push_u64(style.font_weight as u64);
    }
    if style.italic != base.italic {
        put(out, first: &mut first, name: "font-style");
        if style.italic {
            out.push_str("italic");
        } else {
            out.push_str("normal");
        }
    }
    if style.monospace != base.monospace {
        put(out, first: &mut first, name: "font-family");
        if style.monospace {
            out.push_str("monospace");
        } else {
            out.push_str("sans-serif");
        }
    }
    if not line_height_eq(x: style.line_height, y: base.line_height) {
        put(out, first: &mut first, name: "line-height");
        let lh = style.line_height;
        if lh.kind == LINE_NORMAL {
            out.push_str("normal");
        } else if lh.kind == LINE_FACTOR {
            css.write_number(lh.v, out: out);
        } else {
            css.write_number(lh.v, out: out);
            out.push_str("px");
        }
    }
    if style.text_align != base.text_align {
        put(out, first: &mut first, name: "text-align");
        out.push_str(keyword_name(table: TEXT_ALIGNS, k: style.text_align));
    }
    if style.white_space != base.white_space {
        put(out, first: &mut first, name: "white-space");
        out.push_str(keyword_name(table: WHITE_SPACES, k: style.white_space));
    }
    if style.text_transform != base.text_transform {
        put(out, first: &mut first, name: "text-transform");
        out.push_str(keyword_name(table: TEXT_TRANSFORMS, k: style.text_transform));
    }
    if style.letter_spacing != base.letter_spacing {
        put(out, first: &mut first, name: "letter-spacing");
        css.write_number(style.letter_spacing, out: out);
        out.push_str("px");
    }
    if style.text_decoration != base.text_decoration {
        put(out, first: &mut first, name: "text-decoration");
        let d = style.text_decoration;
        if d == 0 {
            out.push_str("none");
        } else {
            var started = false;
            if (d & UNDERLINE) != 0 {
                out.push_str("underline");
                started = true;
            }
            if (d & LINE_THROUGH) != 0 {
                if started {
                    out.push_str(" ");
                }
                out.push_str("line-through");
                started = true;
            }
            if (d & OVERLINE) != 0 {
                if started {
                    out.push_str(" ");
                }
                out.push_str("overline");
            }
        }
    }
    if style.visibility != base.visibility {
        put(out, first: &mut first, name: "visibility");
        out.push_str(keyword_name(table: VISIBILITIES, k: style.visibility));
    }
    if style.cursor != base.cursor {
        put(out, first: &mut first, name: "cursor");
        out.push_str(keyword_name(table: CURSORS, k: style.cursor));
    }
    if style.list_style != base.list_style {
        put(out, first: &mut first, name: "list-style");
        out.push_str(keyword_name(table: LIST_STYLES, k: style.list_style));
    }
    if style.pointer_events != base.pointer_events {
        put(out, first: &mut first, name: "pointer-events");
        out.push_str(keyword_name(table: POINTER_EVENTS, k: style.pointer_events));
    }
}
