/// The number of word in table, a space-separated list, any case; none
/// when it is not there.
pub fn keyword_index(table: str, word: str) -> ?u8 {
    if word.len() == 0 {
        return none;
    }
    let b = table.bytes();
    var i: usize = 0;
    var k: u8 = 0;
    while i < b.len() : (k += 1) {
        var end = i;
        while end < b.len() and b[end] != ' ' {
            end += 1;
        }
        if css.eq_ignore_case(x: table[i..end], y: word) {
            return k;
        }
        i = end + 1;
    }
    return none;
}

/// Keyword k of table, as CSS spells it.
pub fn keyword_name(table: str, k: u8) -> str {
    let b = table.bytes();
    var i: usize = 0;
    var n: u8 = 0;
    while i < b.len() : (n += 1) {
        var end = i;
        while end < b.len() and b[end] != ' ' {
            end += 1;
        }
        if n == k {
            return table[i..end];
        }
        i = end + 1;
    }
    return "";
}

// ---- the computed style ----------------------------------------------------

/// line-height: normal (1.25 times the font size), a multiple of the font
/// size (inherited as the multiple), or pixels.
pub const LINE_NORMAL: u8 = 0;
pub const LINE_FACTOR: u8 = 1;
pub const LINE_PX: u8 = 2;

/// A line height: its kind, and the factor or the pixels.
pub type LineHeight = struct {
    pub kind: u8,
    pub v: f32,
}

/// The line height in pixels, for a font of size pixels.
pub fn line_height_px(lh: LineHeight, size: f32) -> f32 {
    if lh.kind == LINE_NORMAL {
        return size * 1.25;
    }
    if lh.kind == LINE_FACTOR {
        return size * lh.v;
    }
    return lh.v;
}

/// Whether two line heights are the same.
fn line_height_eq(x: LineHeight, y: LineHeight) -> bool {
    return x.kind == y.kind and (x.kind == LINE_NORMAL or x.v == y.v);
}

/// One grid track's size: a length, fr, auto, min-content, max-content,
/// minmax() of two tracks (sub), fit-content() of a length.
pub const TRACK_FIXED: u8 = 0;
pub const TRACK_FR: u8 = 1;
pub const TRACK_AUTO: u8 = 2;
pub const TRACK_MIN_CONTENT: u8 = 3;
pub const TRACK_MAX_CONTENT: u8 = 4;
pub const TRACK_MINMAX: u8 = 5;
pub const TRACK_FIT_CONTENT: u8 = 6;

/// A track: its kind, the length of a fixed or fit-content one, the fr of
/// an fr one, and minmax()'s two tracks.
pub type Track = struct {
    pub kind: u8,
    pub len: values.Length,
    pub fr: f32,
    pub sub: alloc.List(Track),
}

/// repeat()'s count: a number, auto-fill or auto-fit.
pub const REPEAT_COUNT: u8 = 0;
pub const REPEAT_AUTO_FILL: u8 = 1;
pub const REPEAT_AUTO_FIT: u8 = 2;

/// One entry of grid-template-columns: one track, or repeat() of tracks.
pub type TrackEntry = struct {
    pub repeat: bool,
    pub count_kind: u8,
    pub count: u16,
    pub tracks: alloc.List(Track),
}

/// One end of a grid item's placement: auto, a line's number, span n.
pub const LINE_AUTO: u8 = 0;
pub const LINE_INDEX: u8 = 1;
pub const LINE_SPAN: u8 = 2;

/// A grid line: its kind and number.
pub type Line = struct {
    pub kind: u8,
    pub n: i32,
}

/// A grid item's placement along one axis.
pub type Placement = struct {
    pub start: Line,
    pub end: Line,
}

/// auto / auto.
pub fn auto_placement() -> Placement {
    return Placement { start: Line { kind: LINE_AUTO, n: 0 }, end: Line { kind: LINE_AUTO, n: 0 } };
}

/// Whether two placements are the same.
fn placement_eq(x: Placement, y: Placement) -> bool {
    return x.start.kind == y.start.kind and x.start.n == y.start.n and x.end.kind == y.end.kind and x.end.n == y.end.n;
}

/// One stop of a gradient: its color and, when the sheet said, where it
/// sits, 0 to 1.
pub type Stop = struct {
    pub color: u32,
    pub has_at: bool,
    pub at: f32,
}

/// linear-gradient(): CSS's angle (0 points up, 90 right) and the stops.
pub type Gradient = struct {
    pub angle: f32,
    pub stops: alloc.List(Stop),
}

/// box-shadow's first shadow; with no color of its own it is currentcolor
/// until finish puts it in.
pub type Shadow = struct {
    pub x: f32,
    pub y: f32,
    pub blur: f32,
    pub spread: f32,
    pub has_color: bool,
    pub color: u32,
    pub inset: bool,
}

/// text-decoration's lines, as flags.
pub const UNDERLINE: u8 = 1;
pub const LINE_THROUGH: u8 = 2;
pub const OVERLINE: u8 = 4;

/// An element's computed style, every field of Nimadir's Style. Sides are
/// top, right, bottom, left; corners top-left, top-right, bottom-right,
/// bottom-left (a percentage is of the box's shorter side); overflow and
/// gap are x then y, and row then column. min_width and min_height auto
/// are 0, max_width and max_height auto are none. A border color is
/// currentcolor (border_current) until finish puts the color in; has_*
/// says whether an optional one is there. The first group is the box, not
/// inherited; from color on, text, inherited; vars is the element's custom
/// properties, a scope of the styling's Vars.
pub type Style = struct {
    pub display: u8,
    pub position: u8,
    pub inset: [4]values.Length,
    pub width: values.Length,
    pub height: values.Length,
    pub min_width: values.Length,
    pub min_height: values.Length,
    pub max_width: values.Length,
    pub max_height: values.Length,
    pub margin: [4]values.Length,
    pub padding: [4]values.Length,
    pub border_width: [4]f32,
    pub border_style: [4]u8,
    pub border_color: [4]u32,
    pub border_current: [4]bool,
    pub radius: [4]values.Length,
    pub box_sizing: u8,
    pub overflow: [2]u8,
    pub flex_direction: u8,
    pub flex_wrap: u8,
    pub justify_content: u8,
    pub align_items: u8,
    pub align_self: u8,
    pub align_content: u8,
    pub justify_items: u8,
    pub justify_self: u8,
    pub flex_grow: f32,
    pub flex_shrink: f32,
    pub flex_basis: values.Length,
    pub order: i32,
    pub gap: [2]values.Length,
    pub grid_template_columns: alloc.List(TrackEntry),
    pub grid_template_rows: alloc.List(TrackEntry),
    pub grid_auto_columns: alloc.List(Track),
    pub grid_auto_rows: alloc.List(Track),
    pub grid_auto_flow_column: bool,
    pub grid_auto_flow_dense: bool,
    pub grid_column: Placement,
    pub grid_row: Placement,
    pub has_aspect_ratio: bool,
    pub aspect_ratio: f32,
    pub float: u8,
    pub clear: u8,
    pub has_z_index: bool,
    pub z_index: i32,
    pub background: u32,
    pub has_gradient: bool,
    pub gradient: Gradient,
    pub opacity: f32,
    pub has_shadow: bool,
    pub shadow: Shadow,
    pub text_overflow: u8,
    pub object_fit: u8,
    pub color: u32,
    pub font_size: f32,
    pub font_weight: u16,
    pub italic: bool,
    pub monospace: bool,
    pub line_height: LineHeight,
    pub text_align: u8,
    pub white_space: u8,
    pub text_transform: u8,
    pub letter_spacing: f32,
    pub text_decoration: u8,
    pub visibility: u8,
    pub cursor: u8,
    pub list_style: u8,
    pub pointer_events: u8,
    pub vars: u32,
}

/// Every property at its initial value.
pub fn initial(a: alloc.Allocator) -> Style {
    let z = values.zero();
    let au = values.auto();
    return Style {
        display: DISPLAY_INLINE,
        position: POSITION_STATIC,
        inset: [au; 4],
        width: au,
        height: au,
        min_width: au,
        min_height: au,
        max_width: au,
        max_height: au,
        margin: [z; 4],
        padding: [z; 4],
        border_width: [0.0; 4],
        border_style: [BORDER_NONE; 4],
        border_color: [values.BLACK; 4],
        border_current: [true; 4],
        radius: [z; 4],
        box_sizing: BOX_CONTENT,
        overflow: [OVERFLOW_VISIBLE; 2],
        flex_direction: FLEX_ROW,
        flex_wrap: WRAP_NOWRAP,
        justify_content: ALIGN_NORMAL,
        align_items: ALIGN_NORMAL,
        align_self: ALIGN_AUTO,
        align_content: ALIGN_NORMAL,
        justify_items: ALIGN_NORMAL,
        justify_self: ALIGN_AUTO,
        flex_grow: 0.0,
        flex_shrink: 1.0,
        flex_basis: au,
        order: 0,
        gap: [z; 2],
        grid_template_columns: alloc.List(TrackEntry).init(a),
        grid_template_rows: alloc.List(TrackEntry).init(a),
        grid_auto_columns: alloc.List(Track).init(a),
        grid_auto_rows: alloc.List(Track).init(a),
        grid_auto_flow_column: false,
        grid_auto_flow_dense: false,
        grid_column: auto_placement(),
        grid_row: auto_placement(),
        has_aspect_ratio: false,
        aspect_ratio: 0.0,
        float: FLOAT_NONE,
        clear: CLEAR_NONE,
        has_z_index: false,
        z_index: 0,
        background: values.TRANSPARENT,
        has_gradient: false,
        gradient: Gradient { angle: 180.0, stops: alloc.List(Stop).init(a) },
        opacity: 1.0,
        has_shadow: false,
        shadow: Shadow { x: 0.0, y: 0.0, blur: 0.0, spread: 0.0, has_color: false, color: 0, inset: false },
        text_overflow: OVERFLOW_TEXT_CLIP,
        object_fit: FIT_FILL,
        color: values.BLACK,
        font_size: 16.0,
        font_weight: 400,
        italic: false,
        monospace: false,
        line_height: LineHeight { kind: LINE_NORMAL, v: 0.0 },
        text_align: TEXT_START,
        white_space: WS_NORMAL,
        text_transform: TRANSFORM_NONE,
        letter_spacing: 0.0,
        text_decoration: 0,
        visibility: VISIBLE,
        cursor: CURSOR_AUTO,
        list_style: LIST_DISC,
        pointer_events: EVENTS_AUTO,
        vars: 0,
    };
}

/// A child of parent: inherited properties from it, the rest initial, and
/// the display its tag has before any sheet says otherwise.
pub fn child_of(parent: &Style, tag: str, a: alloc.Allocator) -> Style {
    var s = initial(a);
    copy_inherited(&mut s, from: parent);
    s.display = default_display(tag);
    return s;
}

/// The inherited properties of p into s.
fn copy_inherited(s: &mut Style, from: &Style) {
    s.color = from.color;
    s.font_size = from.font_size;
    s.font_weight = from.font_weight;
    s.italic = from.italic;
    s.monospace = from.monospace;
    s.line_height = from.line_height;
    s.text_align = from.text_align;
    s.white_space = from.white_space;
    s.text_transform = from.text_transform;
    s.letter_spacing = from.letter_spacing;
    s.text_decoration = from.text_decoration;
    s.visibility = from.visibility;
    s.cursor = from.cursor;
    s.list_style = from.list_style;
    s.pointer_events = from.pointer_events;
    s.vars = from.vars;
}

/// Whether the element flows as text rather than being laid out as a box.
pub fn is_inline(s: &Style) -> bool {
    return s.display == DISPLAY_INLINE;
}

/// What a tag is before any stylesheet: text-level tags flow inline, a tag
/// with no meaning here is a block (a div), and the rest are blocks too.
pub fn default_display(tag: str) -> u8 {
    if one_of(word: tag, list: "span a b strong i em u s del ins strike code kbd samp small sub sup mark abbr cite q time var label br") {
        return DISPLAY_INLINE;
    }
    if one_of(word: tag, list: "button input textarea select img progress") {
        return DISPLAY_INLINE_BLOCK;
    }
    if tag.eq("li") {
        return DISPLAY_LIST_ITEM;
    }
    if one_of(word: tag, list: "head script style template title meta link option optgroup") {
        return DISPLAY_NONE;
    }
    return DISPLAY_BLOCK;
}

/// Whether word is one of the space-separated words of list, exactly.
fn one_of(word: str, list: str) -> bool {
    if word.len() == 0 {
        return false;
    }
    let b = list.bytes();
    var i: usize = 0;
    while i < b.len() {
        var end = i;
        while end < b.len() and b[end] != ' ' {
            end += 1;
        }
        if list[i..end].eq(word) {
            return true;
        }
        i = end + 1;
    }
    return false;
}

// ---- custom properties -----------------------------------------------------

/// The custom properties of a styling, in scopes: an element that declares
/// some has a scope of its own, whose parent is the scope it inherited; one
/// that declares none shares its parent's. A scope's entries are together,
/// first to first + count, and a later one of a name hides an earlier one,
/// as a map's insert does. Scope 0 is the empty one at the top.
pub type Vars = struct {
    parent: alloc.List(u32),
    first: alloc.List(u32),
    count: alloc.List(u32),
    names: alloc.List(alloc.String),
    values: alloc.List(alloc.List(css.Token)),
}

/// Vars with only the empty scope.
fn new_vars(a: alloc.Allocator) -> Vars {
    var v = Vars { parent: alloc.List(u32).init(a), first: alloc.List(u32).init(a), count: alloc.List(u32).init(a), names: alloc.List(alloc.String).init(a), values: alloc.List(alloc.List(css.Token)).init(a) };
    v.parent.push(0);
    v.first.push(0);
    v.count.push(0);
    return v;
}

/// The entry of name seen from scope, if any.
fn lookup(vars: &Vars, scope: u32, name: str) -> ?usize {
    var s = scope;
    while true {
        let first = vars.first.items()[s as usize] as usize;
        var k = vars.count.items()[s as usize] as usize;
        while k > 0 : (k -= 1) {
            if vars.names.items()[first + k - 1].view().eq(name) {
                return first + k - 1;
            }
        }
        if s == 0 {
            break;
        }
        s = vars.parent.items()[s as usize];
    }
    return none;
}

/// Whether value names a variable.
fn has_var(value: []css.Token) -> bool {
    for t in value {
        if t.kind == css.FUNCTION and t.text.view().eq("var") {
            return true;
        }
    }
    return false;
}

/// value with every var(--x, fallback) put in, onto out; false if one names
/// a variable that is not set and gives no fallback, or the value grows
/// past MAX_VALUE_TOKENS.
fn substitute(value: []css.Token, vars: &Vars, scope: u32, depth: usize, out: &mut alloc.List(css.Token), a: alloc.Allocator) -> bool {
    if not has_var(value) {
        for t in value {
            out.push(css.clone_token(t));
        }
        return true;
    }
    if depth > MAX_VAR_DEPTH {
        return false;
    }
    var i: usize = 0;
    while i < value.len() {
        let t = &value[i];
        if t.kind == css.FUNCTION and t.text.view().eq("var") {
            // Its arguments, to the matching bracket.
            var nest: usize = 1;
            var j = i + 1;
            while j < value.len() {
                let k = value[j].kind;
                if k == css.FUNCTION or k == css.LPAREN {
                    nest += 1;
                } else if k == css.RPAREN {
                    nest -= 1;
                    if nest == 0 {
                        break;
                    }
                }
                j += 1;
            }
            var stop = j;
            if stop > value.len() {
                stop = value.len();
            }
            let args = value[i + 1..stop];
            let comma = css.plain(css.COMMA, a);
            let parts = css.split_top(args, sep: &comma, a: a);
            let p0 = parts.items()[0];
            let var_name = css.trim(args[p0.from..p0.to]);
            var found: usize = 0;
            var has_found = false;
            if var_name.len() == 1 and var_name[0].kind == css.IDENT {
                match lookup(vars, scope: scope, name: var_name[0].text.view()) {
                    some(k) => {
                        found = k;
                        has_found = true;
                    }
                    none => { }
                }
            }
            if has_found {
                if not substitute(vars.values.items()[found].items(), vars: vars, scope: scope, depth: depth + 1, out: out, a: a) {
                    return false;
                }
            } else if parts.len() > 1 {
                var at = args.len();
                var c: usize = 0;
                while c < args.len() : (c += 1) {
                    if args[c].kind == css.COMMA {
                        at = c;
                        break;
                    }
                }
                var from = at + 1;
                if from > args.len() {
                    from = args.len();
                }
                if not substitute(css.trim(args[from..args.len()]), vars: vars, scope: scope, depth: depth + 1, out: out, a: a) {
                    return false;
                }
            } else {
                return false;
            }
            if out.len() > MAX_VALUE_TOKENS {
                return false;
            }
            i = j + 1;
            continue;
        }
        out.push(css.clone_token(t));
        if out.len() > MAX_VALUE_TOKENS {
            return false;
        }
        i += 1;
    }
    return true;
}

// ---- the cascade -----------------------------------------------------------

/// Where a declaration stands in the cascade: important, origin,
/// specificity, order; sorted, the last wins. Then where it is: the sheet
/// (INLINE for the element's style attribute), the rule, the declaration.
type Found = struct {
    important: u8,
    origin: u8,
    spec: u32,
    order: u32,
    sheet: u32,
    rule: u32,
    decl: u32,
}

/// The origins: the host's sheet, the app's, the element's own.
const ORIGIN_UA: u8 = 0;
const ORIGIN_AUTHOR: u8 = 1;
const ORIGIN_INLINE: u8 = 2;

/// The sheet number of an element's style attribute.
const INLINE: u32 = 0xFFFFFFFF;

/// Whether x sorts after y.
fn found_after(x: Found, y: Found) -> bool {
    if x.important != y.important {
        return x.important > y.important;
    }
    if x.origin != y.origin {
        return x.origin > y.origin;
    }
    if x.spec != y.spec {
        return x.spec > y.spec;
    }
    return x.order > y.order;
}

/// found sorted, stably: equal ones keep their order.
fn sort_found(found: &mut alloc.List(Found), a: alloc.Allocator) {
    let n = found.len();
    var tmp = alloc.List(Found).init(a);
    for f in found.items() {
        tmp.push(f.*);
    }
    var width: usize = 1;
    while width < n : (width *= 2) {
        var lo: usize = 0;
        while lo < n : (lo += 2 * width) {
            var mid = lo + width;
            if mid > n {
                mid = n;
            }
            var hi = lo + 2 * width;
            if hi > n {
                hi = n;
            }
            var i = lo;
            var j = mid;
            var k = lo;
            while k < hi : (k += 1) {
                let src = found.items();
                if i < mid and (j >= hi or not found_after(x: src[i], y: src[j])) {
                    tmp.items_mut()[k] = src[i];
                    i += 1;
                } else {
                    tmp.items_mut()[k] = src[j];
                    j += 1;
                }
            }
        }
        var c: usize = 0;
        while c < n : (c += 1) {
            found.items_mut()[c] = tmp.items()[c];
        }
    }
}

/// Every element's computed style: list[at[n]] is node n's; at[n] is 0,
/// list[0] the initial style, for a node that was not styled. vars holds
/// the custom properties the styles' vars name.
pub type Styles = struct {
    pub at: alloc.List(u32),
    pub list: alloc.List(Style),
    pub vars: Vars,
}

/// Whether node n was styled: an element in the page.
pub fn has_style(styles: &Styles, n: u32) -> bool {
    return (n as usize) < styles.at.len() and styles.at.items()[n as usize] != 0;
}

/// Node n's computed style; the initial one for a node not styled.
pub fn style_of(styles: &Styles, n: u32) -> &Style {
    var k: u32 = 0;
    if (n as usize) < styles.at.len() {
        k = styles.at.items()[n as usize];
    }
    return &styles.list.items()[k as usize];
}

/// Every element of the page under node 1 styled for a page shown on env:
/// sheets[0] is the host's sheet, the rest are the app's in order.
pub fn compute(doc: &dyn select.Doc, sheets: []css.Sheet, env: css.Env, state: select.State, a: alloc.Allocator) -> Styles {
    var styles = Styles { at: alloc.List(u32).init(a), list: alloc.List(Style).init(a), vars: new_vars(a) };
    let size = doc.doc_size();
    var n: u32 = 0;
    while n < size : (n += 1) {
        styles.at.push(0);
    }
    styles.list.push(initial(a));
    let init = initial(a);
    let cx = select.Ctx { state: state, places: select.places_of(doc, a: a) };
    var rem: f32 = 16.0;
    // The page in document order, so that a parent is styled first.
    var stack = alloc.List(u32).init(a);
    stack.push(1);
    while stack.len() > 0 {
        let id = stack.pop() orelse break;
        let kids = doc.doc_children(id);
        var c = kids.len();
        while c > 0 : (c -= 1) {
            stack.push(kids[c - 1]);
        }
        if not select.is_element(doc, n: id) {
            continue;
        }
        let parent_node = doc.doc_parent(id);
        var parent_at: u32 = 0;
        if (parent_node as usize) < styles.at.len() {
            parent_at = styles.at.items()[parent_node as usize];
        }
        var style = child_of(&styles.list.items()[parent_at as usize], tag: doc.doc_tag(id), a: a);
        let parent = &styles.list.items()[parent_at as usize];

        // What applies, in cascade order.
        var found = alloc.List(Found).init(a);
        var order: u32 = 0;
        var si: usize = 0;
        while si < sheets.len() : (si += 1) {
            let sheet = &sheets[si];
            var origin = ORIGIN_AUTHOR;
            if si == 0 {
                origin = ORIGIN_UA;
            }
            var ri: usize = 0;
            while ri < sheet.rules.len() : (ri += 1) {
                let rule = &sheet.rules.items()[ri];
                let applies = css.rule_applies(sheet, rule: rule, env: &env);
                for sel in rule.selectors.items() {
                    if applies and select.matches(doc, cx: &cx, sel: sel, n: id) {
                        var di: usize = 0;
                        while di < rule.declarations.len() : (di += 1) {
                            var imp: u8 = 0;
                            if rule.declarations.items()[di].important {
                                imp = 1;
                            }
                            found.push(Found { important: imp, origin: origin, spec: sel.specificity, order: order, sheet: si as u32, rule: ri as u32, decl: di as u32 });
                        }
                    }
                    order += 1;
                }
            }
        }
        var inline_decls = alloc.List(css.Declaration).init(a);
        match select.attr_at(doc, n: id, name: "style") {
            some(k) => { inline_decls = css.inline(doc.doc_attr_value(id, k: k), a); }
            none => { }
        }
        var ii: usize = 0;
        while ii < inline_decls.len() : (ii += 1) {
            var imp: u8 = 0;
            if inline_decls.items()[ii].important {
                imp = 1;
            }
            found.push(Found { important: imp, origin: ORIGIN_INLINE, spec: 0xFFFFFFFF, order: 0, sheet: INLINE, rule: 0, decl: ii as u32 });
        }
        sort_found(&mut found, a: a);

        // Custom properties first: every other value may refer to them.
        var fresh = false;
        for f in found.items() {
            var resolved = alloc.List(css.Token).init(a);
            var custom_name = alloc.String.init(a);
            if f.sheet == INLINE {
                let d = &inline_decls.items()[f.decl as usize];
                if d.name.view().starts_with("--") {
                    custom_name = d.name.clone();
                    if not fresh {
                        open_scope(&mut styles.vars, style: &mut style);
                        fresh = true;
                    }
                    if not substitute(d.value.items(), vars: &styles.vars, scope: style.vars, depth: 0, out: &mut resolved, a: a) {
                        resolved = alloc.List(css.Token).init(a);
                    }
                }
            } else {
                let d = &sheets[f.sheet as usize].rules.items()[f.rule as usize].declarations.items()[f.decl as usize];
                if d.name.view().starts_with("--") {
                    custom_name = d.name.clone();
                    if not fresh {
                        open_scope(&mut styles.vars, style: &mut style);
                        fresh = true;
                    }
                    if not substitute(d.value.items(), vars: &styles.vars, scope: style.vars, depth: 0, out: &mut resolved, a: a) {
                        resolved = alloc.List(css.Token).init(a);
                    }
                }
            }
            if custom_name.len() > 0 {
                styles.vars.names.push(custom_name);
                styles.vars.values.push(resolved);
                styles.vars.count.items_mut()[style.vars as usize] += 1;
            }
        }

        var vcx = values.Ctx { em: parent.font_size, rem: rem, vw: env.width, vh: env.height };
        // Then what other values are relative to: the font size, for em,
        // and the color, for currentcolor.
        var pass: u32 = 0;
        while pass < 2 : (pass += 1) {
            if pass == 1 {
                vcx.em = style.font_size;
                if id == 1 {
                    rem = style.font_size;
                    vcx.rem = rem;
                }
            }
            for f in found.items() {
                if f.sheet == INLINE {
                    let d = &inline_decls.items()[f.decl as usize];
                    take(&mut style, parent: parent, init: &init, d: d, pass: pass, vars: &styles.vars, cx: vcx, a: a);
                } else {
                    let d = &sheets[f.sheet as usize].rules.items()[f.rule as usize].declarations.items()[f.decl as usize];
                    take(&mut style, parent: parent, init: &init, d: d, pass: pass, vars: &styles.vars, cx: vcx, a: a);
                }
            }
        }
        finish(&mut style);
        styles.at.items_mut()[id as usize] = styles.list.len() as u32;
        styles.list.push(style);
    }
    return styles;
}

/// A scope of its own for style's custom properties, under the one it
/// inherited.
fn open_scope(vars: &mut Vars, style: &mut Style) {
    vars.parent.push(style.vars);
    vars.first.push(vars.names.len() as u32);
    vars.count.push(0);
    style.vars = (vars.parent.len() - 1) as u32;
}

/// Whether property name is one the first pass applies: what other values
/// are relative to.
fn first_pass(name: str) -> bool {
    return name.eq("font-size") or name.eq("font") or name.eq("color");
}

/// Declaration d applied to s, if it belongs to this pass (0: font-size,
/// font and color; 1: the rest but custom properties), with its var()s put
/// in; one that names a variable not set changes nothing.
fn take(s: &mut Style, parent: &Style, init: &Style, d: &css.Declaration, pass: u32, vars: &Vars, cx: values.Ctx, a: alloc.Allocator) {
    let name = d.name.view();
    if name.starts_with("--") or first_pass(name) != (pass == 0) {
        return;
    }
    if has_var(d.value.items()) {
        var resolved = alloc.List(css.Token).init(a);
        if not substitute(d.value.items(), vars: vars, scope: s.vars, depth: 0, out: &mut resolved, a: a) {
            return;
        }
        apply(s, parent: parent, init: init, name: name, value: resolved.items(), cx: cx, a: a);
    } else {
        apply(s, parent: parent, init: init, name: name, value: d.value.items(), cx: cx, a: a);
    }
}

/// What is left once every declaration is in: currentcolor put in, and no
/// border where its style is none or hidden.
fn finish(s: &mut Style) {
    var i: usize = 0;
    while i < 4 : (i += 1) {
        if s.border_current[i] {
            s.border_color[i] = s.color;
            s.border_current[i] = false;
        }
        if s.border_style[i] == BORDER_NONE or s.border_style[i] == BORDER_HIDDEN {
            s.border_width[i] = 0.0;
        }
    }
    if s.has_shadow and not s.shadow.has_color {
        s.shadow.color = s.color;
        s.shadow.has_color = true;
    }
}

// ---- reading one declaration -----------------------------------------------

/// Whether x equals word, any case.
fn eqi(x: str, word: str) -> bool {
    return css.eq_ignore_case(x: x, y: word);
}

/// The 1 to 4 values of margin, padding and their kind, as top, right,
/// bottom, left: which value each side takes; none for another count.
fn spread(count: usize) -> ?[4]usize {
    if count == 1 {
        return [0, 0, 0, 0];
    }
    if count == 2 {
        return [0, 1, 0, 1];
    }
    if count == 3 {
        return [0, 1, 2, 1];
    }
    if count == 4 {
        return [0, 1, 2, 3];
    }
    return none;
}

/// Each word of value as a length (auto allowed when with_auto), spread to
/// four sides; none if one is not a length or there are not 1 to 4.
fn quad_lengths(value: []css.Token, w: []css.Span, with_auto: bool, cx: values.Ctx, a: alloc.Allocator) -> ?[4]values.Length {
    var got: [4]values.Length = [values.zero(); 4];
    var i: usize = 0;
    while i < w.len() : (i += 1) {
        let t = value[w[i].from..w[i].to];
        var l = values.zero();
        if with_auto {
            l = values.parse_length(t, cx: cx, a: a) orelse return none;
        } else {
            l = values.parse_length_percent(t, cx: cx, a: a) orelse return none;
        }
        if i < 4 {
            got[i] = l;
        }
    }
    let at = spread(w.len()) orelse return none;
    return [got[at[0]], got[at[1]], got[at[2]], got[at[3]]];
}

/// A border width: thin, medium, thick, or a length not below 0.
fn border_width_of(t: []css.Token, cx: values.Ctx, a: alloc.Allocator) -> ?f32 {
    let k = values.keyword_text(t);
    if eqi(x: k, word: "thin") {
        return 1.0;
    }
    if eqi(x: k, word: "medium") {
        return 3.0;
    }
    if eqi(x: k, word: "thick") {
        return 5.0;
    }
    let v = values.parse_px(t, cx: cx, a: a) orelse return none;
    if v >= 0.0 {
        return v;
    }
    return none;
}

/// The parts of `1px solid red`, in any order; what is left out is medium,
/// none and currentcolor. none if a word is none of them.
type BorderParts = struct {
    width: f32,
    style: u8,
    has_color: bool,
    color: u32,
}

/// border's words read.
fn border_parts(value: []css.Token, w: []css.Span, cx: values.Ctx, current: u32, a: alloc.Allocator) -> ?BorderParts {
    var p = BorderParts { width: 3.0, style: BORDER_NONE, has_color: false, color: 0 };
    for sp in w {
        let t = value[sp.from..sp.to];
        match keyword_index(table: BORDER_STYLES, word: values.keyword_text(t)) {
            some(st) => {
                p.style = st;
                continue;
            }
            none => { }
        }
        match border_width_of(t, cx: cx, a: a) {
            some(wd) => {
                p.width = wd;
                continue;
            }
            none => { }
        }
        p.color = values.parse_color(t, current: current, a: a) orelse return none;
        p.has_color = true;
    }
    return p;
}

/// The alignment the last word names: `safe center` keeps its center.
fn align_of(value: []css.Token, w: []css.Span) -> ?u8 {
    if w.len() == 0 {
        return none;
    }
    let last = w[w.len() - 1];
    return keyword_index(table: ALIGNS, word: values.keyword_text(value[last.from..last.to]));
}

/// A whole number, from a number or calc() of one.
fn integer(t: []css.Token, a: alloc.Allocator) -> ?i32 {
    let n = values.parse_number(t, a) orelse return none;
    if n - n.trunc() == 0.0 and n.abs() < 1000000000.0 {
        return n as i32;
    }
    return none;
}

/// normal as 0, or what read gives: a length or a percentage.
fn gap_of(t: []css.Token, cx: values.Ctx, a: alloc.Allocator) -> ?values.Length {
    if values.is_keyword(t, word: "normal") {
        return values.zero();
    }
    return values.parse_length_percent(t, cx: cx, a: a);
}

/// Declaration name: value applied to s. Unknown properties and values
/// that cannot be read change nothing, as in a browser.
fn apply(s: &mut Style, parent: &Style, init: &Style, name: str, value: []css.Token, cx: values.Ctx, a: alloc.Allocator) {
    let wl = values.words(value, a);
    let w = wl.items();
    let kw = values.keyword_text(value);
    // The global keywords, for every property.
    if eqi(x: kw, word: "inherit") {
        copy_property(s, from: parent, name: name, a: a);
        return;
    }
    if eqi(x: kw, word: "initial") {
        copy_property(s, from: init, name: name, a: a);
        return;
    }
    if eqi(x: kw, word: "unset") or eqi(x: kw, word: "revert") or eqi(x: kw, word: "revert-layer") {
        if is_inherited(name) {
            copy_property(s, from: parent, name: name, a: a);
        } else {
            copy_property(s, from: init, name: name, a: a);
        }
        return;
    }
    let current = s.color;
    if name.eq("display") {
        if kw.len() > 0 {
            if one_of(word: lowered(kw, a: a).view(), list: "flow-root table table-row-group table-header-group table-footer-group table-caption table-cell") {
                s.display = DISPLAY_BLOCK;
            } else if eqi(x: kw, word: "table-row") {
                s.display = DISPLAY_FLEX;
            } else if eqi(x: kw, word: "inline-table") {
                s.display = DISPLAY_INLINE_BLOCK;
