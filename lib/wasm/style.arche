/// The cascade, as Nimadir's shell computes it (host/src/dom/style.rs,
/// ADR-4): which declarations reach each element, in what order, and the
/// computed style they leave it with.
///
/// Three origins, as on the web: the host's user-agent sheet (ua_text),
/// the app's sheets in the order added, and each element's inline style.
/// Within them, !important first, then specificity, then order. Inherited
/// properties start from the parent's values; custom properties (--x)
/// inherit too, and var() is put in before a value is read. Relative units
/// are resolved here, so layout sees pixels, and percentages, which only
/// layout can resolve. describe says what an element's rules set, as
/// Nimadir's headless runner prints it (--styles).
import alloc;
import wasm.css;
import wasm.select;
import wasm.values;

/// The most tokens one value may grow to as var()s are put in: a custom
/// property can name another twice, which names another twice, and so on.
const MAX_VALUE_TOKENS: usize = 4096;

/// How deep var() may refer through other variables.
const MAX_VAR_DEPTH: usize = 16;

/// The host's own stylesheet, Nimadir's UA_CSS: what every element looks
/// like before the app says otherwise, in the system's light or dark
/// theme. The colors are the window's palette, exposed as variables the
/// app may use as well: --nimadir-text, --nimadir-accent, ...
pub fn ua_text(a: alloc.Allocator) -> alloc.String {
    var s = alloc.String.init(a);
    s.push_str(":root {\n");
    s.push_str("  --nimadir-bg: #ffffff; --nimadir-surface: #f1f3f4; --nimadir-border: #dadce0;\n");
    s.push_str("  --nimadir-text: #202124; --nimadir-muted: #5f6368; --nimadir-accent: #1a73e8;\n");
    s.push_str("  --nimadir-accent-text: #ffffff; --nimadir-accent-wash: #e8f0fe;\n");
    s.push_str("  --nimadir-danger: #d93025; --nimadir-field: #ffffff;\n");
    s.push_str("  color: var(--nimadir-text); font-size: 15px; line-height: 1.4;\n");
    s.push_str("}\n");
    s.push_str("@media (prefers-color-scheme: dark) {\n");
    s.push_str("  :root {\n");
    s.push_str("    --nimadir-bg: #202124; --nimadir-surface: #303134; --nimadir-border: #5f6368;\n");
    s.push_str("    --nimadir-text: #e8eaed; --nimadir-muted: #9aa0a6; --nimadir-accent: #8ab4f8;\n");
    s.push_str("    --nimadir-accent-text: #202124; --nimadir-accent-wash: #2a374f;\n");
    s.push_str("    --nimadir-danger: #f28b82; --nimadir-field: #202124;\n");
    s.push_str("  }\n");
    s.push_str("}\n");
    s.push_str("h1 { font-size: 2em; font-weight: 700; margin: 0.67em 0; line-height: 1.2; }\n");
    s.push_str("h2 { font-size: 1.5em; font-weight: 700; margin: 0.75em 0; line-height: 1.25; }\n");
    s.push_str("h3 { font-size: 1.25em; font-weight: 700; margin: 0.8em 0; }\n");
    s.push_str("h4 { font-size: 1.1em; font-weight: 700; margin: 0.9em 0; }\n");
    s.push_str("h5, h6 { font-size: 1em; font-weight: 700; margin: 1em 0; }\n");
    s.push_str("p, blockquote, figure, pre, dl { margin: 0 0 0.8em; }\n");
    s.push_str("blockquote { padding-left: 12px; border-left: 3px solid var(--nimadir-border); color: var(--nimadir-muted); }\n");
    s.push_str("ul, ol { margin: 0 0 0.8em; padding-left: 24px; }\n");
    s.push_str("ol { list-style-type: decimal; }\n");
    s.push_str("b, strong, th { font-weight: 700; }\n");
    s.push_str("i, em, cite { font-style: italic; }\n");
    s.push_str("u, ins { text-decoration: underline; }\n");
    s.push_str("s, del, strike { text-decoration: line-through; }\n");
    s.push_str("small { font-size: 0.85em; }\n");
    s.push_str("code, kbd, pre, samp { font-family: monospace; }\n");
    s.push_str("pre { white-space: pre; }\n");
    s.push_str("mark { background: #fde293; color: #202124; }\n");
    s.push_str("a { color: var(--nimadir-accent); text-decoration: underline; cursor: pointer; }\n");
    s.push_str("hr { border: none; border-top: 1px solid var(--nimadir-border); margin: 8px 0; }\n");
    s.push_str("button {\n");
    s.push_str("  padding: 8px 16px; border-radius: 8px; border: 1px solid var(--nimadir-border);\n");
    s.push_str("  background: var(--nimadir-surface); color: var(--nimadir-text);\n");
    s.push_str("  font-weight: 600; cursor: pointer; text-align: center;\n");
    s.push_str("}\n");
    s.push_str("button:hover { background: var(--nimadir-accent-wash); }\n");
    s.push_str("button:active { border-color: var(--nimadir-accent); }\n");
    s.push_str("input, textarea {\n");
    s.push_str("  padding: 8px 10px; border: 1px solid var(--nimadir-border); border-radius: 8px;\n");
    s.push_str("  background: var(--nimadir-field); color: var(--nimadir-text); cursor: text;\n");
    s.push_str("}\n");
    s.push_str("/* As in browsers: a search field set to 100% fits, padding and all. */\n");
    s.push_str("input[type=search] { box-sizing: border-box; }\n");
    s.push_str("input:focus, textarea:focus, select:focus { border-color: var(--nimadir-accent); }\n");
    s.push_str("select {\n");
    s.push_str("  padding: 8px 32px 8px 10px; border: 1px solid var(--nimadir-border); border-radius: 8px;\n");
    s.push_str("  background: var(--nimadir-field); color: var(--nimadir-text); cursor: pointer;\n");
    s.push_str("}\n");
    s.push_str("input[type=checkbox], input[type=radio] {\n");
    s.push_str("  width: 18px; height: 18px; padding: 0; margin: 0 4px 0 0; cursor: pointer;\n");
    s.push_str("  border: 2px solid var(--nimadir-muted); border-radius: 4px;\n");
    s.push_str("}\n");
    s.push_str("input[type=radio] { border-radius: 50%; }\n");
    s.push_str("input[type=checkbox]:checked, input[type=radio]:checked {\n");
    s.push_str("  background: var(--nimadir-accent); border-color: var(--nimadir-accent);\n");
    s.push_str("}\n");
    s.push_str("input[type=range] { padding: 0; border: none; height: 20px; background: transparent; }\n");
    s.push_str("textarea { min-height: 64px; }\n");
    s.push_str("progress { width: 160px; height: 8px; border-radius: 4px; background: var(--nimadir-surface); color: var(--nimadir-accent); }\n");
    s.push_str("table { border-spacing: 0; }\n");
    s.push_str("td, th { padding: 4px 8px; }\n");
    s.push_str("/* `hidden` hides, whatever display a sheet gives the element: a browser lets\n");
    s.push_str("   `.card { display: flex }` undo it, which is a trap, not a feature. */\n");
    s.push_str("[hidden] { display: none !important; }\n");
    s.push_str(":disabled { opacity: 0.5; cursor: default; }\n");
    return s;
}

