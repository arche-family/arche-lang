/// The baseline JIT's machine code for x86-64 (lib/wasm/jit.arche): the
/// module wasm.jit_arch, but on ARM64, whose is jit_arch-aarch64.arche
/// (compiler/program.arche). The frame's values are at rbx, the memory at
/// r12 and its size in r13, the context at r14; rax, rcx and rdx, xmm0 and
/// xmm1 are scratch.
import alloc;
import wasm.jit;
import wasm.module as m;
import wasm.validate as vd;

const RAX: u8 = 0;
const RCX: u8 = 1;
const RDX: u8 = 2;
const RBX: u8 = 3;
const RSP: u8 = 4;
const RBP: u8 = 5;
const RSI: u8 = 6;
const RDI: u8 = 7;
const R12: u8 = 12;
const R13: u8 = 13;
const R14: u8 = 14;
const R15: u8 = 15;

const CC_B: u8 = 0x2;
const CC_AE: u8 = 0x3;
const CC_E: u8 = 0x4;
const CC_NE: u8 = 0x5;
const CC_BE: u8 = 0x6;
const CC_A: u8 = 0x7;
const CC_P: u8 = 0xA;
const CC_NP: u8 = 0xB;
const CC_L: u8 = 0xC;
const CC_GE: u8 = 0xD;
const CC_LE: u8 = 0xE;
const CC_G: u8 = 0xF;

fn put(x: &mut jit.Asm, b: u8) {
    x.bytes.push(b);
}

fn put32(x: &mut jit.Asm, v: u32) {
    put(x, b: (v & 0xFF) as u8);
    put(x, b: ((v >> 8) & 0xFF) as u8);
    put(x, b: ((v >> 16) & 0xFF) as u8);
    put(x, b: ((v >> 24) & 0xFF) as u8);
}

fn put64(x: &mut jit.Asm, v: u64) {
    put32(x, v: (v & 0xFFFFFFFF) as u32);
    put32(x, v: (v >> 32) as u32);
}

fn here(x: &jit.Asm) -> u32 {
    return x.bytes.len() as u32;
}

/// A REX prefix when one is needed: wide, or a register above 7.
fn rex(x: &mut jit.Asm, wide: bool, reg: u8, base: u8) {
    var r: u8 = 0x40;
    if wide {
        r = r | 8;
    }
    if reg >= 8 {
        r = r | 4;
    }
    if base >= 8 {
        r = r | 1;
    }
    if r != 0x40 {
        put(x, b: r);
    }
}

/// ModRM (and SIB) for [base + disp32], reg in the reg field.
fn mem(x: &mut jit.Asm, reg: u8, base: u8, disp: u32) {
    put(x, b: 0x80 | ((reg & 7) << 3) | (base & 7));
    if base & 7 == 4 {
        put(x, b: 0x24);
    }
    put32(x, v: disp);
}

fn modrm_rr(x: &mut jit.Asm, reg: u8, rm: u8) {
    put(x, b: 0xC0 | ((reg & 7) << 3) | (rm & 7));
}

/// op reg, [base + disp]: a one- or two-byte opcode (0x0F first).
fn op_mem(x: &mut jit.Asm, wide: bool, op: u8, two: bool, reg: u8, base: u8, disp: u32) {
    rex(x, wide: wide, reg: reg, base: base);
    if two {
        put(x, b: 0x0F);
    }
    put(x, b: op);
    mem(x, reg: reg, base: base, disp: disp);
}

fn load(x: &mut jit.Asm, wide: bool, reg: u8, base: u8, disp: u32) {
    op_mem(x, wide: wide, op: 0x8B, two: false, reg: reg, base: base, disp: disp);
}

fn store(x: &mut jit.Asm, wide: bool, reg: u8, base: u8, disp: u32) {
    op_mem(x, wide: wide, op: 0x89, two: false, reg: reg, base: base, disp: disp);
}

/// The slot of the frame's value h: [rbx + 8h].
fn slot(h: u32) -> u32 {
    return 8 * h;
}

fn ctx(field: u32) -> u32 {
    return 8 * field;
}

fn mov_rr(x: &mut jit.Asm, wide: bool, dst: u8, src: u8) {
    rex(x, wide: wide, reg: src, base: dst);
    put(x, b: 0x89);
    modrm_rr(x, reg: src, rm: dst);
}

fn mov_imm32(x: &mut jit.Asm, reg: u8, v: u32) {
    rex(x, wide: false, reg: 0, base: reg);
    put(x, b: 0xB8 + (reg & 7));
    put32(x, v: v);
}

fn mov_imm64(x: &mut jit.Asm, reg: u8, v: u64) {
    rex(x, wide: true, reg: 0, base: reg);
    put(x, b: 0xB8 + (reg & 7));
    put64(x, v: v);
}

/// mov qword [base + disp], imm32 (sign-extended).
fn store_imm(x: &mut jit.Asm, base: u8, disp: u32, v: u32) {
    rex(x, wide: true, reg: 0, base: base);
    put(x, b: 0xC7);
    mem(x, reg: 0, base: base, disp: disp);
    put32(x, v: v);
}

fn push_reg(x: &mut jit.Asm, r: u8) {
    if r >= 8 {
        put(x, b: 0x41);
    }
    put(x, b: 0x50 + (r & 7));
}

fn pop_reg(x: &mut jit.Asm, r: u8) {
    if r >= 8 {
        put(x, b: 0x41);
    }
    put(x, b: 0x58 + (r & 7));
}

/// jcc to a pc of the function, patched when all of it is written.
fn jcc_pc(x: &mut jit.Asm, cc: u8, pc: u32) {
    put(x, b: 0x0F);
    put(x, b: 0x80 + cc);
    x.fixups.push(here(x));
    x.targets.push(pc);
    put32(x, v: 0);
}

fn jmp_pc(x: &mut jit.Asm, pc: u32) {
    put(x, b: 0xE9);
    x.fixups.push(here(x));
    x.targets.push(pc);
    put32(x, v: 0);
}

/// jcc forward within the code being written: the rel32's position.
fn jcc_fwd(x: &mut jit.Asm, cc: u8) -> u32 {
    put(x, b: 0x0F);
    put(x, b: 0x80 + cc);
    let at = here(x);
    put32(x, v: 0);
    return at;
}

fn jmp_fwd(x: &mut jit.Asm) -> u32 {
    put(x, b: 0xE9);
    let at = here(x);
    put32(x, v: 0);
    return at;
}

fn patch_here(x: &mut jit.Asm, at: u32) {
    let rel = here(x) -% (at + 4);
    var i: u32 = 0;
    while i < 4 : (i += 1) {
        x.bytes.items_mut()[(at + i) as usize] = ((rel >> (8 * i)) & 0xFF) as u8;
    }
}

/// jmp to an absolute offset of the region, from code that will sit at base.
fn jmp_abs(x: &mut jit.Asm, base: u32, to: u32) {
    put(x, b: 0xE9);
    let rel = to -% (base + here(x) + 4);
    put32(x, v: rel);
}

// ---- the stubs -------------------------------------------------------------------------

/// The region's start: entry(ctx in rdi) saves what the System V ABI keeps,
/// loads the context and jumps to its resume address; the exit, at the
/// returned offset, restores them and returns with rax.
pub fn stubs(x: &mut jit.Asm) -> u32 {
    push_reg(x, r: RBX);
    push_reg(x, r: RBP);
    push_reg(x, r: R12);
    push_reg(x, r: R13);
    push_reg(x, r: R14);
    push_reg(x, r: R15);
    // sub rsp, 8: aligned again.
    put(x, b: 0x48);
    put(x, b: 0x83);
    put(x, b: 0xEC);
    put(x, b: 8);
    mov_rr(x, wide: true, dst: R14, src: RDI);
    load(x, wide: true, reg: RBX, base: R14, disp: ctx(jit.CTX_FRAME));
    load(x, wide: true, reg: R12, base: R14, disp: ctx(jit.CTX_MEM));
    load(x, wide: true, reg: R13, base: R14, disp: ctx(jit.CTX_MEM_SIZE));
    // jmp [r14 + resume]
    rex(x, wide: false, reg: 0, base: R14);
    put(x, b: 0xFF);
    mem(x, reg: 4, base: R14, disp: ctx(jit.CTX_RESUME));
    let back = here(x);
    put(x, b: 0x48);
    put(x, b: 0x83);
    put(x, b: 0xC4);
    put(x, b: 8);
    pop_reg(x, r: R15);
    pop_reg(x, r: R14);
    pop_reg(x, r: R13);
    pop_reg(x, r: R12);
    pop_reg(x, r: RBP);
    pop_reg(x, r: RBX);
    put(x, b: 0xC3);
    return back;
}

// ---- compiling -------------------------------------------------------------------------

/// An exit to exec.arche: where to go on (pc), the height, and why.
fn exit(x: &mut jit.Asm, base: u32, exit_at: u32, kind: u64, pc: u32, h: u32) {
    store_imm(x, base: R14, disp: ctx(jit.CTX_PC), v: pc);
    store_imm(x, base: R14, disp: ctx(jit.CTX_SP), v: h);
    mov_imm32(x, reg: RAX, v: kind as u32);
    jmp_abs(x, base: base, to: exit_at);
}

/// Copies keep values from below h to height to (a branch's move).
fn move_values(x: &mut jit.Asm, h: u32, keep: u32, to: u32) {
    if h - keep == to {
        return;
    }
    var i: u32 = 0;
    while i < keep : (i += 1) {
        load(x, wide: true, reg: RAX, base: RBX, disp: slot(h - keep + i));
        store(x, wide: true, reg: RAX, base: RBX, disp: slot(to + i));
    }
}

/// i32 or i64 compare: cmp the two below h, setcc, zero-extended.
fn compare(x: &mut jit.Asm, wide: bool, cc: u8, h: u32) {
    load(x, wide: wide, reg: RAX, base: RBX, disp: slot(h - 2));
    op_mem(x, wide: wide, op: 0x3B, two: false, reg: RAX, base: RBX, disp: slot(h - 1));
    set_result(x, cc: cc, h: h - 2);
}

fn set_result(x: &mut jit.Asm, cc: u8, h: u32) {
    put(x, b: 0x0F);
    put(x, b: 0x90 + cc);
    put(x, b: 0xC0);
    // movzx eax, al
    put(x, b: 0x0F);
    put(x, b: 0xB6);
    put(x, b: 0xC0);
    store(x, wide: true, reg: RAX, base: RBX, disp: slot(h));
}

/// Two floats below h into xmm0 and xmm1.
fn load_floats(x: &mut jit.Asm, double: bool, h: u32) {
    sse_mem(x, prefix: float_prefix(double), op: 0x10, reg: 0, base: RBX, disp: slot(h - 2));
    sse_mem(x, prefix: float_prefix(double), op: 0x10, reg: 1, base: RBX, disp: slot(h - 1));
}

fn float_prefix(double: bool) -> u8 {
    if double {
        return 0xF2;
    }
    return 0xF3;
}

fn sse_mem(x: &mut jit.Asm, prefix: u8, op: u8, reg: u8, base: u8, disp: u32) {
    put(x, b: prefix);
    rex(x, wide: false, reg: reg, base: base);
    put(x, b: 0x0F);
    put(x, b: op);
    mem(x, reg: reg, base: base, disp: disp);
}

fn sse_rr(x: &mut jit.Asm, prefix: u8, wide: bool, op: u8, reg: u8, rm: u8) {
    if prefix != 0 {
        put(x, b: prefix);
    }
    rex(x, wide: wide, reg: reg, base: rm);
    put(x, b: 0x0F);
    put(x, b: op);
    modrm_rr(x, reg: reg, rm: rm);
}

/// xmm0, a float of either width, into the slot h, zero above an f32.
fn store_float(x: &mut jit.Asm, double: bool, h: u32) {
    // movd eax, xmm0 / movq rax, xmm0
    sse_rr(x, prefix: 0x66, wide: double, op: 0x7E, reg: 0, rm: RAX);
    store(x, wide: true, reg: RAX, base: RBX, disp: slot(h));
}

/// ucomis xmm a, xmm b.
fn ucomis(x: &mut jit.Asm, double: bool, a: u8, b: u8) {
    var prefix: u8 = 0;
    if double {
        prefix = 0x66;
    }
    sse_rr(x, prefix: prefix, wide: false, op: 0x2E, reg: a, rm: b);
}

/// Compiles function fi of an instance's module: code and heights from
/// validation, globals the store's addresses of the instance's globals, and
/// the region's offsets where this code will go and where the exit is.
pub fn compile(f: &m.Func, globals: []u32, global_stride: u32, global_value: u32, base: u32, exit_at: u32, x: &mut jit.Asm, a: alloc.Allocator) -> jit.Compiled {
    let code = f.code.items();
    let heights = f.heights.items();
    var out = jit.Compiled { resume: alloc.List(u32).init(a) };
    var i: usize = 0;
    while i < code.len() : (i += 1) {
        out.resume.push(m.UNREACHED);
    }
    x.fixups.clear();
    x.targets.clear();
    let start = here(x);
    var pc: usize = 0;
    while pc < code.len() {
        let n = jit.length(code, pc: pc);
        let h = heights[pc];
        let op = code[pc];
        let next = (pc + n) as u32;
        if h == m.UNREACHED {
            pc += n;
            continue;
        }
        out.resume.items_mut()[pc] = base + here(x);
        var done = true;
        if op == 0x41 {
            mov_imm32(x, reg: RAX, v: code[pc + 1]);
            store(x, wide: true, reg: RAX, base: RBX, disp: slot(h));
        } else if op == 0x42 {
            mov_imm64(x, reg: RAX, v: (code[pc + 1] as u64) | ((code[pc + 2] as u64) << 32));
            store(x, wide: true, reg: RAX, base: RBX, disp: slot(h));
        } else if op == 0x20 {
            load(x, wide: true, reg: RAX, base: RBX, disp: slot(code[pc + 1]));
            store(x, wide: true, reg: RAX, base: RBX, disp: slot(h));
        } else if op == 0x21 or op == 0x22 {
            load(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 1));
            store(x, wide: true, reg: RAX, base: RBX, disp: slot(code[pc + 1]));
        } else if op == 0x23 or op == 0x24 {
            let g = globals[code[pc + 1] as usize];
            load(x, wide: true, reg: RCX, base: R14, disp: ctx(jit.CTX_GLOBALS));
            let at = g * global_stride + global_value;
            if op == 0x23 {
                load(x, wide: true, reg: RAX, base: RCX, disp: at);
                store(x, wide: true, reg: RAX, base: RBX, disp: slot(h));
            } else {
                load(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 1));
                store(x, wide: true, reg: RAX, base: RCX, disp: at);
            }
        } else if op == 0x1A {
            // drop: the height is all.
        } else if op == 0x1B {
            load(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 1));
            // test eax, eax
            put(x, b: 0x85);
            put(x, b: 0xC0);
            let keep = jcc_fwd(x, cc: CC_NE);
            load(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 2));
            store(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 3));
            patch_here(x, at: keep);
        } else if op == 0xD0 {
            mov_imm64(x, reg: RAX, v: m.NULL_REF);
            store(x, wide: true, reg: RAX, base: RBX, disp: slot(h));
        } else if op == 0xD1 {
            mov_imm64(x, reg: RCX, v: m.NULL_REF);
            load(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 1));
            // cmp rax, rcx
            put(x, b: 0x48);
            put(x, b: 0x39);
            put(x, b: 0xC8);
            set_result(x, cc: CC_E, h: h - 1);
        } else if op == vd.OP_TICK {
            // dec qword [r14 + fuel]; on zero, a look at the clock.
            rex(x, wide: true, reg: 0, base: R14);
            put(x, b: 0xFF);
            mem(x, reg: 1, base: R14, disp: ctx(jit.CTX_FUEL));
            let more = jcc_fwd(x, cc: CC_NE);
            exit(x, base: base + 0, exit_at: exit_at, kind: jit.EXIT_TICK, pc: next, h: h);
            patch_here(x, at: more);
        } else if op == vd.OP_JUMP {
            jmp_pc(x, pc: code[pc + 1]);
        } else if op == vd.OP_BR {
            move_values(x, h: h, keep: code[pc + 2], to: code[pc + 3]);
            jmp_pc(x, pc: code[pc + 1]);
        } else if op == vd.OP_BR_IF or op == vd.OP_IF_FALSE {
            load(x, wide: false, reg: RAX, base: RBX, disp: slot(h - 1));
            put(x, b: 0x85);
            put(x, b: 0xC0);
            if op == vd.OP_BR_IF {
                jcc_pc(x, cc: CC_NE, pc: code[pc + 1]);
            } else {
                jcc_pc(x, cc: CC_E, pc: code[pc + 1]);
            }
        } else if op == vd.OP_BR_IF_MOVE {
            load(x, wide: false, reg: RAX, base: RBX, disp: slot(h - 1));
            put(x, b: 0x85);
            put(x, b: 0xC0);
            let skip = jcc_fwd(x, cc: CC_E);
            move_values(x, h: h - 1, keep: code[pc + 2], to: code[pc + 3]);
            jmp_pc(x, pc: code[pc + 1]);
            patch_here(x, at: skip);
        } else if op == vd.OP_RETURN {
            exit(x, base: base, exit_at: exit_at, kind: jit.EXIT_RETURN, pc: pc as u32, h: h);
        } else if op == 0x10 {
            store_imm(x, base: R14, disp: ctx(jit.CTX_ARG), v: code[pc + 1]);
            exit(x, base: base, exit_at: exit_at, kind: jit.EXIT_CALL, pc: next, h: h);
        } else if op == 0x3F {
            mov_rr(x, wide: true, dst: RAX, src: R13);
            // shr rax, 16
            put(x, b: 0x48);
            put(x, b: 0xC1);
            put(x, b: 0xE8);
            put(x, b: 16);
            store(x, wide: true, reg: RAX, base: RBX, disp: slot(h));
        } else if op >= 0x28 and op <= 0x3E {
            done = memory_op(x, op: op, offset: code[pc + 1], h: h, base: base, exit_at: exit_at, pc: pc as u32);
        } else if op >= 0x45 and op <= 0xC4 {
            done = numeric_op(x, op: op, h: h);
        } else {
            done = false;
        }
        if not done {
            // Undo what was written, and let the interpreter do it.
            exit(x, base: base, exit_at: exit_at, kind: jit.EXIT_SLOW, pc: pc as u32, h: h);
        }
        pc += n;
    }
    // Jumps to pcs, now that every pc has its place.
    var k: usize = 0;
    while k < x.fixups.len() : (k += 1) {
        let at = x.fixups.items()[k];
        let target = out.resume.items()[x.targets.items()[k] as usize] - base;
        let rel = target -% (at + 4);
        var b: u32 = 0;
        while b < 4 : (b += 1) {
            x.bytes.items_mut()[(at + b) as usize] = ((rel >> (8 * b)) & 0xFF) as u8;
        }
    }
    _ = start;
    return out;
}

/// A load or store: the address checked against the memory's size, which
/// goes back to the interpreter, to trap, when it does not fit.
fn memory_op(x: &mut jit.Asm, op: u32, offset: u32, h: u32, base: u32, exit_at: u32, pc: u32) -> bool {
    var size: u32 = 4;
    var addr_slot = h - 1;
    if op >= 0x36 {
        addr_slot = h - 2;
        if op == 0x37 or op == 0x39 {
            size = 8;
        } else if op == 0x3A or op == 0x3C {
            size = 1;
        } else if op == 0x3B or op == 0x3D {
            size = 2;
        }
    } else if op == 0x29 or op == 0x2B {
        size = 8;
    } else if op == 0x2C or op == 0x2D or op == 0x30 or op == 0x31 {
        size = 1;
    } else if op == 0x2E or op == 0x2F or op == 0x32 or op == 0x33 {
        size = 2;
    }
    // An offset past 2^31 does not fit a displacement: the interpreter's.
    if offset > 0x7FFFFFFF - 8 {
        return false;
    }
    // ecx: the address, zero-extended; rdx: its end.
    load(x, wide: false, reg: RCX, base: RBX, disp: slot(addr_slot));
    // lea rdx, [rcx + offset + size]
    put(x, b: 0x48);
    put(x, b: 0x8D);
    put(x, b: 0x91);
    put32(x, v: offset + size);
    // cmp rdx, r13; ja slow
    put(x, b: 0x4C);
    put(x, b: 0x39);
    put(x, b: 0xEA);
    let fits = jcc_fwd(x, cc: CC_BE);
    exit(x, base: base, exit_at: exit_at, kind: jit.EXIT_SLOW, pc: pc, h: h);
    patch_here(x, at: fits);
    // The access, at [r12 + rcx + offset].
    if op >= 0x36 {
        load(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 1));
        if size == 2 {
            put(x, b: 0x66);
        }
        var w = size == 8;
        put(x, b: 0x41 | bool_bit(w, bit: 8) | 0);
        // rex.b for r12 and rex.x? r12 is the base, rcx the index.
        if size == 1 {
            put(x, b: 0x88);
        } else {
            put(x, b: 0x89);
        }
        sib_access(x, offset: offset);
        _ = w;
        return true;
    }
    // Loads into rax, extended as the op says.
    if op == 0x28 or op == 0x2A or op == 0x35 {
        put(x, b: 0x41);
        put(x, b: 0x8B);
    } else if op == 0x29 or op == 0x2B {
        put(x, b: 0x49);
        put(x, b: 0x8B);
    } else if op == 0x2C {
        put(x, b: 0x41);
        put(x, b: 0x0F);
        put(x, b: 0xBE);
    } else if op == 0x2D or op == 0x31 {
        put(x, b: 0x41);
        put(x, b: 0x0F);
        put(x, b: 0xB6);
    } else if op == 0x2E {
        put(x, b: 0x41);
        put(x, b: 0x0F);
        put(x, b: 0xBF);
    } else if op == 0x2F or op == 0x33 {
        put(x, b: 0x41);
        put(x, b: 0x0F);
        put(x, b: 0xB7);
    } else if op == 0x30 {
        put(x, b: 0x49);
        put(x, b: 0x0F);
        put(x, b: 0xBE);
    } else if op == 0x32 {
        put(x, b: 0x49);
        put(x, b: 0x0F);
        put(x, b: 0xBF);
    } else {
        // i64.load32_s: movsxd
        put(x, b: 0x49);
        put(x, b: 0x63);
    }
    sib_access(x, offset: offset);
    store(x, wide: true, reg: RAX, base: RBX, disp: slot(addr_slot));
    return true;
}

fn bool_bit(b: bool, bit: u8) -> u8 {
    if b {
        return bit;
    }
    return 0;
}

/// ModRM and SIB of [r12 + rcx + disp32], rax the register.
fn sib_access(x: &mut jit.Asm, offset: u32) {
    put(x, b: 0x84);
    put(x, b: 0x0C);
    put32(x, v: offset);
}

/// The numeric instructions the JIT does itself; false for the others.
fn numeric_op(x: &mut jit.Asm, op: u32, h: u32) -> bool {
    // i32 and i64 compares.
    if op == 0x45 or op == 0x50 {
        load(x, wide: op == 0x50, reg: RAX, base: RBX, disp: slot(h - 1));
        if op == 0x50 {
            put(x, b: 0x48);
        }
        put(x, b: 0x85);
        put(x, b: 0xC0);
        set_result(x, cc: CC_E, h: h - 1);
        return true;
    }
    if (op >= 0x46 and op <= 0x4F) or (op >= 0x51 and op <= 0x5A) {
        var k = op - 0x46;
        let wide = op >= 0x51;
        if wide {
            k = op - 0x51;
        }
        var cc = CC_E;
        if k == 1 { cc = CC_NE; }
        if k == 2 { cc = CC_L; }
        if k == 3 { cc = CC_B; }
        if k == 4 { cc = CC_G; }
        if k == 5 { cc = CC_A; }
        if k == 6 { cc = CC_LE; }
        if k == 7 { cc = CC_BE; }
        if k == 8 { cc = CC_GE; }
        if k == 9 { cc = CC_AE; }
        compare(x, wide: wide, cc: cc, h: h);
        return true;
    }
    // Float compares: ucomis, NaN unordered.
    if op >= 0x5B and op <= 0x66 {
        let double = op >= 0x61;
        var k = op - 0x5B;
        if double {
            k = op - 0x61;
        }
        load_floats(x, double: double, h: h);
        if k == 0 or k == 1 {
            ucomis(x, double: double, a: 0, b: 1);
            // eq: ZF and not PF; ne: not ZF or PF.
            if k == 0 {
                put(x, b: 0x0F);
                put(x, b: 0x94);
                put(x, b: 0xC0);
                put(x, b: 0x0F);
                put(x, b: 0x9B);
                put(x, b: 0xC1);
                put(x, b: 0x20);
                put(x, b: 0xC8);
            } else {
                put(x, b: 0x0F);
                put(x, b: 0x95);
                put(x, b: 0xC0);
                put(x, b: 0x0F);
                put(x, b: 0x9A);
                put(x, b: 0xC1);
                put(x, b: 0x08);
                put(x, b: 0xC8);
            }
            put(x, b: 0x0F);
            put(x, b: 0xB6);
            put(x, b: 0xC0);
            store(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 2));
            return true;
        }
        // lt: b > a; gt: a > b; le: b >= a; ge: a >= b.
        if k == 2 or k == 4 {
            ucomis(x, double: double, a: 1, b: 0);
        } else {
            ucomis(x, double: double, a: 0, b: 1);
        }
        if k == 2 or k == 3 {
            set_result(x, cc: CC_A, h: h - 2);
        } else {
            set_result(x, cc: CC_AE, h: h - 2);
        }
        return true;
    }
    // Integer arithmetic: add, sub, mul, and, or, xor, shifts, rotates.
    if (op >= 0x6A and op <= 0x6C) or (op >= 0x71 and op <= 0x78) or (op >= 0x7C and op <= 0x7E) or (op >= 0x83 and op <= 0x8A) {
        let wide = op >= 0x7C;
        var k = op;
        if wide {
            k = op - 0x7C + 0x6A;
        }
        load(x, wide: wide, reg: RAX, base: RBX, disp: slot(h - 2));
        if k >= 0x74 {
            load(x, wide: wide, reg: RCX, base: RBX, disp: slot(h - 1));
            // shl /4, shr_s /7, shr_u /5, rotl /0, rotr /1, by cl
            var digit: u8 = 4;
            if k == 0x75 { digit = 7; }
            if k == 0x76 { digit = 5; }
            if k == 0x77 { digit = 0; }
            if k == 0x78 { digit = 1; }
            if wide {
                put(x, b: 0x48);
            }
            put(x, b: 0xD3);
            put(x, b: 0xC0 | (digit << 3));
        } else if k == 0x6C {
            op_mem(x, wide: wide, op: 0xAF, two: true, reg: RAX, base: RBX, disp: slot(h - 1));
        } else {
            var alu: u8 = 0x03;
            if k == 0x6B { alu = 0x2B; }
            if k == 0x71 { alu = 0x23; }
            if k == 0x72 { alu = 0x0B; }
            if k == 0x73 { alu = 0x33; }
            op_mem(x, wide: wide, op: alu, two: false, reg: RAX, base: RBX, disp: slot(h - 1));
        }
        store(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 2));
        return true;
    }
    // Float arithmetic: add, sub, mul, div.
    if (op >= 0x92 and op <= 0x95) or (op >= 0xA0 and op <= 0xA3) {
        let double = op >= 0xA0;
        var k = op - 0x92;
        if double {
            k = op - 0xA0;
        }
        load_floats(x, double: double, h: h);
        var o: u8 = 0x58;
        if k == 1 { o = 0x5C; }
        if k == 2 { o = 0x59; }
        if k == 3 { o = 0x5E; }
        sse_rr(x, prefix: float_prefix(double), wide: false, op: o, reg: 0, rm: 1);
        store_float(x, double: double, h: h - 2);
        return true;
    }
    // sqrt, and ceil, floor, trunc and nearest by roundss/roundsd.
    if op == 0x91 or op == 0x9F or (op >= 0x8D and op <= 0x90) or (op >= 0x9B and op <= 0x9E) {
        let double = op >= 0x99;
        sse_mem(x, prefix: float_prefix(double), op: 0x10, reg: 0, base: RBX, disp: slot(h - 1));
        if op == 0x91 or op == 0x9F {
            sse_rr(x, prefix: float_prefix(double), wide: false, op: 0x51, reg: 0, rm: 0);
        } else {
            var k = op - 0x8D;
            if double {
                k = op - 0x9B;
            }
            // ceil 2, floor 1, trunc 3, nearest 0.
            var mode: u8 = 2;
            if k == 1 { mode = 1; }
            if k == 2 { mode = 3; }
            if k == 3 { mode = 0; }
            put(x, b: 0x66);
            put(x, b: 0x0F);
            put(x, b: 0x3A);
            if double {
                put(x, b: 0x0B);
            } else {
                put(x, b: 0x0A);
            }
            put(x, b: 0xC0);
            put(x, b: mode);
        }
        store_float(x, double: double, h: h - 1);
        return true;
    }
    // abs, neg, copysign: bits.
    if op == 0x8B or op == 0x8C or op == 0x99 or op == 0x9A {
        load(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 1));
        if op == 0x8B {
            mov_imm32(x, reg: RCX, v: 0x7FFFFFFF);
            put(x, b: 0x21);
            put(x, b: 0xC8);
        } else if op == 0x8C {
            mov_imm32(x, reg: RCX, v: 0x80000000);
            put(x, b: 0x31);
            put(x, b: 0xC8);
        } else if op == 0x99 {
            mov_imm64(x, reg: RCX, v: 0x7FFFFFFFFFFFFFFF);
            put(x, b: 0x48);
            put(x, b: 0x21);
            put(x, b: 0xC8);
        } else {
            mov_imm64(x, reg: RCX, v: 0x8000000000000000);
            put(x, b: 0x48);
            put(x, b: 0x31);
            put(x, b: 0xC8);
        }
        store(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 1));
        return true;
    }
    // wrap, extend, reinterpret, and sign extension.
    if op == 0xA7 or op == 0xAD {
        load(x, wide: false, reg: RAX, base: RBX, disp: slot(h - 1));
        store(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 1));
        return true;
    }
    if op == 0xAC or op == 0xC4 {
        // movsxd rax, dword [slot]
        op_mem(x, wide: true, op: 0x63, two: false, reg: RAX, base: RBX, disp: slot(h - 1));
        store(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 1));
        return true;
    }
    if op >= 0xBC and op <= 0xBF {
        return true;
    }
    if op >= 0xC0 and op <= 0xC3 {
        // movsx eax/rax, byte/word [slot]
        let wide = op >= 0xC2;
        var o: u8 = 0xBE;
        if op == 0xC1 or op == 0xC3 {
            o = 0xBF;
        }
        op_mem(x, wide: wide, op: o, two: true, reg: RAX, base: RBX, disp: slot(h - 1));
        if not wide {
            // zero above the i32
            mov_rr(x, wide: false, dst: RAX, src: RAX);
        }
        store(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 1));
        return true;
    }
    // promote and demote.
    if op == 0xBB or op == 0xB6 {
        let double_in = op == 0xB6;
        sse_mem(x, prefix: float_prefix(double_in), op: 0x10, reg: 0, base: RBX, disp: slot(h - 1));
        sse_rr(x, prefix: float_prefix(double_in), wide: false, op: 0x5A, reg: 0, rm: 0);
        store_float(x, double: not double_in, h: h - 1);
        return true;
    }
    // Integers to floats, but u64, which the interpreter rounds.
    if op == 0xB2 or op == 0xB3 or op == 0xB4 or op == 0xB7 or op == 0xB8 or op == 0xB9 {
        let double = op >= 0xB7;
        if op == 0xB2 or op == 0xB7 {
            op_mem(x, wide: true, op: 0x63, two: false, reg: RAX, base: RBX, disp: slot(h - 1));
        } else if op == 0xB3 or op == 0xB8 {
            load(x, wide: false, reg: RAX, base: RBX, disp: slot(h - 1));
        } else {
            load(x, wide: true, reg: RAX, base: RBX, disp: slot(h - 1));
        }
        sse_rr(x, prefix: float_prefix(double), wide: true, op: 0x2A, reg: 0, rm: RAX);
        store_float(x, double: double, h: h - 1);
        return true;
    }
    return false;
}

// ---- running it ------------------------------------------------------------------------

/// Calls the entry stub at entry, the context in rdi, as the System V ABI
/// calls a function; what the machine code came back for.
pub unsafe fn enter(entry: u64, context: u64) -> u64 {
    var status: u64 = 0;
    var arg = context;
    // SAFETY: the caller's (jit.enter): entry is the region's entry stub,
    // which keeps what the System V ABI keeps and returns to here; the code
    // it runs only touches what the context names, and only rax, rcx, rdx,
    // xmm0 and xmm1 of what the ABI lets it change.
    asm("call *%1", out("rax") status, in(reg) entry, inout("rdi") arg,
        clobber("rcx"), clobber("rdx"), clobber("rsi"), clobber("r8"), clobber("r9"), clobber("r10"), clobber("r11"),
        clobber("xmm0"), clobber("xmm1"));
    return status;
}

/// Nothing: x86-64 fetches the code a thread has written as it is, once it
/// jumps to it.
pub unsafe fn sync(at: u64, size: u64) {
}
