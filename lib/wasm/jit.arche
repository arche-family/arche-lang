/// The baseline JIT: each function's compiled code (validate.arche) turned
/// into machine code that works on the same stack of values, one
/// instruction at a time, as the interpreter does. What it does not compile
/// it gives back to the interpreter one instruction at a time (an exit of
/// kind SLOW), and so does every call, return and look at the clock: frames
/// stay the interpreter's, and the interpreter and the JIT take turns within
/// one function. A trap is always the interpreter's: an access out of
/// bounds goes back to it, which traps as it would have.
///
/// This module is what every processor shares: the context, the exits, the
/// code being written and how long each instruction is. The machine code is
/// wasm.jit_arch's, whose file is the target processor's as std.linux's is
/// (compiler/program.arche): lib/wasm/jit_arch.arche for x86-64,
/// lib/wasm/jit_arch-aarch64.arche for ARM64. Both compile the same
/// instructions.
import alloc;
import wasm.jit_arch as arch;
import wasm.module as m;
import wasm.validate as vd;

// ---- what the machine code and exec.arche share -----------------------------------------

/// Slots of the context, 8 bytes each: in, the frame's values, the memory,
/// its size, where to resume, the globals and the fuel; out, the pc and the
/// height where it stopped and the function a call names.
pub const CTX_FRAME: u32 = 0;
pub const CTX_MEM: u32 = 1;
pub const CTX_MEM_SIZE: u32 = 2;
pub const CTX_RESUME: u32 = 3;
pub const CTX_PC: u32 = 4;
pub const CTX_SP: u32 = 5;
pub const CTX_ARG: u32 = 6;
pub const CTX_FUEL: u32 = 7;
pub const CTX_GLOBALS: u32 = 8;
pub const CTX_SLOTS: u32 = 16;

/// Why machine code came back.
pub const EXIT_CALL: u64 = 1;
pub const EXIT_RETURN: u64 = 2;
pub const EXIT_SLOW: u64 = 4;
pub const EXIT_TICK: u64 = 5;

/// Where the region's two stubs are: entry, and the exit every exit jumps to.
pub const ENTRY: u32 = 0;

/// Machine code being written, with the jumps still to patch.
pub type Asm = struct {
    pub bytes: alloc.List(u8),
    /// Where each jump to a pc of the function is, and the pc it jumps to.
    /// The position is the processor's to read: of the rel32 on x86-64, of
    /// the branch on ARM64.
    pub fixups: alloc.List(u32),
    pub targets: alloc.List(u32),
}

/// An empty Asm.
pub fn new_asm(a: alloc.Allocator) -> Asm {
    return Asm { bytes: alloc.List(u8).init(a), fixups: alloc.List(u32).init(a), targets: alloc.List(u32).init(a) };
}

/// The region's start: the entry stub, which enter calls with the context
/// and which jumps to its resume address, and the exit every exit jumps to,
/// at the returned offset, which returns to enter's caller.
pub fn stubs(x: &mut Asm) -> u32 {
    return arch.stubs(x);
}

/// Compiles function fi of an instance's module: code and heights from
/// validation, globals the store's addresses of the instance's globals, and
/// the region's offsets where this code will go and where the exit is.
pub fn compile(f: &m.Func, globals: []u32, global_stride: u32, global_value: u32, base: u32, exit_at: u32, x: &mut Asm, a: alloc.Allocator) -> Compiled {
    return arch.compile(f, globals: globals, global_stride: global_stride, global_value: global_value, base: base, exit_at: exit_at, x, a);
}

/// Calls the entry stub at entry with the address of the context, as the
/// platform's C calling convention calls a function; what the machine code
/// came back for. The caller vouches that entry is the entry stub of a
/// region whose code is written and synced, and that the context's
/// CTX_SLOTS slots name only what the code may touch.
pub unsafe fn enter(entry: u64, context: u64) -> u64 {
    return arch.enter(entry: entry, context: context);
}

/// Makes the size bytes of code just written at at what the processor
/// fetches, before any of it runs. The caller vouches that they are mapped.
pub unsafe fn sync(at: u64, size: u64) {
    arch.sync(at: at, size: size);
}

// ---- compiling -------------------------------------------------------------------------

/// How many words the instruction at pc takes.
pub fn length(code: []u32, pc: usize) -> usize {
    let op = code[pc];
    if op == 0x42 or op == 0x11 or op == vd.OP_FC + 12 or op == vd.OP_FC + 14 {
        return 3;
    }
    if op == vd.OP_BR or op == vd.OP_BR_IF_MOVE {
        return 4;
    }
    if op == vd.OP_BR_TABLE {
        return 2 + 3 * (code[pc + 1] as usize + 1);
    }
    if op == 0x41 or (op >= 0x20 and op <= 0x26) or (op >= 0x28 and op <= 0x3E) or op == 0x10 or op == 0xD2 or op == vd.OP_JUMP or op == vd.OP_BR_IF or op == vd.OP_IF_FALSE {
        return 2;
    }
    if op == vd.OP_FC + 8 or op == vd.OP_FC + 9 or op == vd.OP_FC + 13 or (op >= vd.OP_FC + 15 and op <= vd.OP_FC + 17) {
        return 2;
    }
    return 1;
}

/// What a compiled function needs at a pc: its region offset, per pc.
pub type Compiled = struct {
    pub resume: alloc.List(u32),
}
