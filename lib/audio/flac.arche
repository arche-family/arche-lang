/// FLAC streams (RFC 9639), the lossless music of arche-os's music app
/// (arche-os docs/sprints.md T9), decoded to the samples they were made
/// from: every subframe type (constant, verbatim, the fixed predictors and
/// LPC), Rice and Rice2 residuals with escaped partitions, wasted bits, the
/// three stereo decorrelations, any block size, fixed or variable, and any
/// depth from 4 to 32 bits. STREAMINFO is read; the other metadata blocks,
/// and an ID3v2 tag before the stream, are passed over. Every frame's
/// header CRC-8 and its CRC-16 are checked.
///
/// A file comes from outside, so every read is checked, every sample is
/// bounded by its depth, and the samples a file may give are bounded by
/// the caller: a broken file gives an error, never a panic
/// (fuzz/audio_fuzz.arche). Data after the last frame that is not a frame,
/// such as an ID3v1 tag, ends the stream.
import alloc;

/// What is wrong with a FLAC file.
pub type FlacError = error {
    /// Not a FLAC stream, or one that breaks its rules.
    Malformed,
    /// A frame whose header or whole CRC is not its own.
    BadChecksum,
    /// More samples than the caller allows.
    TooLarge,
}

/// A stream decoded: rate frames a second of channels samples each, every
/// sample a signed number of bits bits, interleaved: a frame's channels in
/// order, then the next frame's.
pub type Audio = struct {
    pub rate: u32,
    pub channels: u32,
    pub bits: u32,
    pub samples: alloc.List(i32),
}

/// What STREAMINFO says.
type Info = struct {
    max_block: u32,
    rate: u32,
    channels: u32,
    bits: u32,
}

/// The tables of the two checksums: CRC-8 with the polynomial 0x07 and
/// CRC-16 with 0x8005, both from zero, most significant bit first.
type Crcs = struct {
    crc8: [256]u8,
    crc16: [256]u16,
}

/// The two tables, made once a stream.
fn new_crcs() -> Crcs {
    var t = Crcs { crc8: [0; 256], crc16: [0; 256] };
    var i: u32 = 0;
    while i < 256 : (i += 1) {
        var c8 = i;
        var c16 = i << 8;
        var k: u32 = 0;
        while k < 8 : (k += 1) {
            if (c8 & 0x80) != 0 {
                c8 = ((c8 << 1) ^ 0x07) & 0xFF;
            } else {
                c8 = (c8 << 1) & 0xFF;
            }
            if (c16 & 0x8000) != 0 {
                c16 = ((c16 << 1) ^ 0x8005) & 0xFFFF;
            } else {
                c16 = (c16 << 1) & 0xFFFF;
            }
        }
        t.crc8[i as usize] = c8 as u8;
        t.crc16[i as usize] = c16 as u16;
    }
    return t;
}

/// The CRC-8 of data.
fn crc8_of(t: &Crcs, data: []u8) -> u32 {
    var c: u32 = 0;
    for x in data {
        c = t.crc8[((c ^ x.* as u32) & 0xFF) as usize] as u32;
    }
    return c;
}

/// The CRC-16 of data.
fn crc16_of(t: &Crcs, data: []u8) -> u32 {
    var c: u32 = 0;
    for x in data {
        c = ((c << 8) & 0xFFFF) ^ (t.crc16[(((c >> 8) ^ x.* as u32) & 0xFF) as usize] as u32);
    }
    return c;
}

/// A reader of bits, the highest of each byte first, over bytes the caller
/// passes to every read: where it is, and where the bytes end, in bits.
type Bits = struct {
    pos: usize,
    end: usize,

    /// The next n bits, n at most 56, as a number.
    fn read(self: &mut Bits, b: []u8, n: u32) -> FlacError!u64 {
        if n == 0 {
            return 0;
        }
        if self.end - self.pos < n as usize {
            return FlacError.Malformed;
        }
        let byte = self.pos >> 3;
        var w: u64 = 0;
        var k: usize = 0;
        while k < 8 : (k += 1) {
            w = w << 8;
            if byte + k < b.len() {
                w = w | (b[byte + k] as u64);
            }
        }
        let v = (w << ((self.pos & 7) as u32)) >> (64 - n);
        self.pos += n as usize;
        return v;
    }

    /// The next n bits as a two's complement number, n at most 56.
    fn signed(self: &mut Bits, b: []u8, n: u32) -> FlacError!i64 {
        if n == 0 {
            return 0;
        }
        let v = try self.read(b, n: n);
        let one: u64 = 1;
        if (v >> (n - 1)) != 0 {
            return (v as i64) - ((one << n) as i64);
        }
        return v as i64;
    }

    /// A unary number: the zeros before the next one, which is read too;
    /// at most limit of them.
    fn unary(self: &mut Bits, b: []u8, limit: u64) -> FlacError!u64 {
        var q: u64 = 0;
        while true {
            if self.pos >= self.end {
                return FlacError.Malformed;
            }
            let off = (self.pos & 7) as u32;
            let rest = ((b[self.pos >> 3] as u32) << off) & 0xFF;
            if rest == 0 {
                q += (8 - off) as u64;
                self.pos += (8 - off) as usize;
                if q > limit {
                    return FlacError.Malformed;
                }
            } else {
                var lead: u32 = 0;
                while (rest & (0x80 >> lead)) == 0 : (lead += 1) {
                }
                q += lead as u64;
                self.pos += (lead + 1) as usize;
                if q > limit or self.pos > self.end {
                    return FlacError.Malformed;
                }
                return q;
            }
        }
    }
}

/// Where the stream starts: after the ID3v2 tags in front of it, if any.
fn after_id3(bytes: []u8) -> usize {
    var at: usize = 0;
    while bytes.len() - at >= 10 and bytes[at] == 'I' and bytes[at + 1] == 'D' and bytes[at + 2] == '3' {
        var size: usize = 0;
        var i: usize = 6;
        while i < 10 : (i += 1) {
            size = (size << 7) | ((bytes[at + i] & 0x7F) as usize);
        }
        size += 10;
        if (bytes[at + 5] & 0x10) != 0 {
            size += 10;
        }
        if size > bytes.len() - at {
            return at;
        }
        at += size;
    }
    return at;
}

/// The STREAMINFO block's 34 bytes.
fn info_of(d: []u8) -> FlacError!Info {
    if d.len() != 34 {
        return FlacError.Malformed;
    }
    let min_block = ((d[0] as u32) << 8) | (d[1] as u32);
    let max_block = ((d[2] as u32) << 8) | (d[3] as u32);
    let rate = ((d[10] as u32) << 12) | ((d[11] as u32) << 4) | ((d[12] as u32) >> 4);
    let channels = (((d[12] as u32) >> 1) & 7) + 1;
    let bits = ((((d[12] as u32) & 1) << 4) | ((d[13] as u32) >> 4)) + 1;
    if max_block < 16 or min_block > max_block or rate == 0 or bits < 4 {
        return FlacError.Malformed;
    }
    return Info { max_block: max_block, rate: rate, channels: channels, bits: bits };
}

/// The stream in bytes, decoded; at most max_samples samples, counting
/// each channel's.
pub fn decode(bytes: []u8, max_samples: u64, a: alloc.Allocator) -> FlacError!Audio {
    var at = after_id3(bytes);
    if bytes.len() - at < 4 or bytes[at] != 'f' or bytes[at + 1] != 'L' or bytes[at + 2] != 'a' or bytes[at + 3] != 'C' {
        return FlacError.Malformed;
    }
    at += 4;
    var info = Info { max_block: 0, rate: 0, channels: 0, bits: 0 };
    var last = false;
    var first = true;
    while not last {
        if bytes.len() - at < 4 {
            return FlacError.Malformed;
        }
        last = (bytes[at] & 0x80) != 0;
        let kind = bytes[at] & 0x7F;
        let len = ((bytes[at + 1] as usize) << 16) | ((bytes[at + 2] as usize) << 8) | (bytes[at + 3] as usize);
        at += 4;
        if len > bytes.len() - at or kind == 127 or (first != (kind == 0)) {
            return FlacError.Malformed;
        }
        if kind == 0 {
            info = try info_of(bytes[at..at + len]);
        }
        first = false;
        at += len;
    }
    let crcs = new_crcs();
    var out = Audio { rate: info.rate, channels: info.channels, bits: info.bits, samples: alloc.List(i32).init(a) };
    // The subframes of one frame, channel after channel.
    var block = alloc.List(i64).init(a);
    block.grow_zeroed((info.max_block as usize) * (info.channels as usize));
    var frames: u64 = 0;
    while bytes.len() - at >= 2 and bytes[at] == 0xFF and (bytes[at + 1] & 0xFE) == 0xF8 {
        at = try frame(bytes, at: at, info: &info, crcs: &crcs, block: block.items_mut(), out: &mut out.samples, max_samples: max_samples);
        frames += 1;
    }
    if frames == 0 {
        return FlacError.Malformed;
    }
    return out;
}

/// Samples a block of each size code has; 0 for those that read it after
/// the header, and for the reserved one.
fn block_size_of(code: u32) -> u32 {
    if code == 1 {
        return 192;
    }
    if code >= 2 and code <= 5 {
        return 576 << (code - 2);
    }
    if code >= 8 {
        return 256 << (code - 8);
    }
    return 0;
}

/// The frame at bytes[at..], decoded onto out; where the next one starts.
fn frame(bytes: []u8, at: usize, info: &Info, crcs: &Crcs, block: []mut i64, out: &mut alloc.List(i32), max_samples: u64) -> FlacError!usize {
    var r = Bits { pos: at * 8, end: bytes.len() * 8 };
    // The sync code, a reserved zero and the blocking strategy, checked
    // by the caller but for the zero.
    if (bytes[at + 1] & 0x02) != 0 {
        return FlacError.Malformed;
    }
    r.pos += 16;
    let size_code = (try r.read(bytes, n: 4)) as u32;
    let rate_code = (try r.read(bytes, n: 4)) as u32;
    let assignment = (try r.read(bytes, n: 4)) as u32;
    let depth_code = (try r.read(bytes, n: 3)) as u32;
    if (try r.read(bytes, n: 1)) != 0 {
        return FlacError.Malformed;
    }
    // The frame's or first sample's number, coded as UTF-8 is, up to
    // seven bytes; only its form is checked.
    let lead = (try r.read(bytes, n: 8)) as u32;
    var more: u32 = 0;
    if (lead & 0x80) != 0 {
        if (lead & 0xC0) == 0x80 or lead == 0xFF {
            return FlacError.Malformed;
        }
        while (lead & (0x40 >> more)) != 0 : (more += 1) {
        }
    }
    var m: u32 = 0;
    while m < more : (m += 1) {
        if (try r.read(bytes, n: 8)) & 0xC0 != 0x80 {
            return FlacError.Malformed;
        }
    }
    var size = block_size_of(size_code);
    if size_code == 6 {
        size = (try r.read(bytes, n: 8)) as u32 + 1;
    } else if size_code == 7 {
        size = (try r.read(bytes, n: 16)) as u32 + 1;
    } else if size == 0 {
        return FlacError.Malformed;
    }
    // The rate: only read past, since STREAMINFO's is the stream's.
    if rate_code == 12 {
        _ = try r.read(bytes, n: 8);
    } else if rate_code == 13 or rate_code == 14 {
        _ = try r.read(bytes, n: 16);
    } else if rate_code == 15 {
        return FlacError.Malformed;
    }
    var channels: u32 = assignment + 1;
    if assignment > 10 {
        return FlacError.Malformed;
    } else if assignment >= 8 {
        channels = 2;
    }
    var bits = info.bits;
    if depth_code == 1 {
        bits = 8;
    } else if depth_code == 2 {
        bits = 12;
    } else if depth_code == 3 {
        return FlacError.Malformed;
    } else if depth_code >= 4 {
        bits = 16 + (depth_code - 4) * 4;
        if depth_code == 7 {
            bits = 32;
        }
    }
    if channels != info.channels or bits != info.bits or size > info.max_block {
        return FlacError.Malformed;
    }
    let header_end = r.pos / 8;
    let crc = (try r.read(bytes, n: 8)) as u32;
    if crc8_of(crcs, bytes[at..header_end]) != crc {
        return FlacError.BadChecksum;
    }
    let n = size as usize;
    var c: u32 = 0;
    while c < channels : (c += 1) {
        // A side channel has a bit more than the others.
        var depth = bits;
        if (assignment == 8 and c == 1) or (assignment == 9 and c == 0) or (assignment == 10 and c == 1) {
            depth += 1;
        }
        let from = (c as usize) * n;
        try subframe(&mut r, bytes, into: block[from..from + n], depth: depth);
    }
    // Padding to a byte, then the CRC-16 of the whole frame.
    r.pos = (r.pos + 7) / 8 * 8;
    let end = r.pos / 8;
    let crc16 = (try r.read(bytes, n: 16)) as u32;
    if crc16_of(crcs, bytes[at..end]) != crc16 {
        return FlacError.BadChecksum;
    }
    if (out.len() as u64) + (n as u64) * (channels as u64) > max_samples {
        return FlacError.TooLarge;
    }
    var i: usize = 0;
    while i < n : (i += 1) {
        if assignment < 8 {
            c = 0;
            while c < channels : (c += 1) {
                out.push(block[(c as usize) * n + i] as i32);
            }
        } else {
            let x = block[i];
            let y = block[n + i];
            var left = x;
            var right = y;
            if assignment == 8 {
                right = x - y;
            } else if assignment == 9 {
                left = x + y;
            } else {
                let mid = (x << 1) | (y & 1);
                left = (mid + y) >> 1;
                right = (mid - y) >> 1;
            }
            out.push(try fit(left, bits: bits));
            out.push(try fit(right, bits: bits));
        }
    }
    return end + 2;
}

/// v as a sample of bits bits, when it is one.
fn fit(v: i64, bits: u32) -> FlacError!i32 {
    let one: i64 = 1;
    let top = one << (bits - 1);
    if v < -top or v >= top {
        return FlacError.Malformed;
    }
    return v as i32;
}

/// One channel's subframe of depth bits, decoded into into.
fn subframe(r: &mut Bits, b: []u8, into: []mut i64, depth: u32) -> FlacError!void {
    if (try r.read(b, n: 1)) != 0 {
        return FlacError.Malformed;
    }
    let kind = (try r.read(b, n: 6)) as u32;
    var wasted: u32 = 0;
    if (try r.read(b, n: 1)) == 1 {
        wasted = (try r.unary(b, limit: depth as u64)) as u32 + 1;
        if wasted >= depth {
            return FlacError.Malformed;
        }
    }
    let bits = depth - wasted;
    let n = into.len();
    if kind == 0 {
        let v = try r.signed(b, n: bits);
        var i: usize = 0;
        while i < n : (i += 1) {
            into[i] = v;
        }
    } else if kind == 1 {
        var i: usize = 0;
        while i < n : (i += 1) {
            into[i] = try r.signed(b, n: bits);
        }
    } else if kind >= 8 and kind <= 12 {
        let order = (kind - 8) as usize;
        if order > n {
            return FlacError.Malformed;
        }
        var i: usize = 0;
        while i < order : (i += 1) {
            into[i] = try r.signed(b, n: bits);
        }
        try residual(r, b, into: into, order: order);
        try fixed(into, order: order, bits: bits);
    } else if kind >= 32 {
        let order = (kind - 31) as usize;
        if order > n {
            return FlacError.Malformed;
        }
        var i: usize = 0;
        while i < order : (i += 1) {
            into[i] = try r.signed(b, n: bits);
        }
        let precision = (try r.read(b, n: 4)) as u32 + 1;
        if precision == 16 {
            return FlacError.Malformed;
        }
        let shift = try r.signed(b, n: 5);
        if shift < 0 {
            return FlacError.Malformed;
        }
        var coefs: [32]i64 = [0; 32];
        i = 0;
        while i < order : (i += 1) {
            coefs[i] = try r.signed(b, n: precision);
        }
        try residual(r, b, into: into, order: order);
        try lpc(into, coefs: coefs, order: order, shift: shift as u32, bits: bits);
    } else {
        return FlacError.Malformed;
    }
    if wasted > 0 {
        var i: usize = 0;
        while i < n : (i += 1) {
            into[i] = into[i] << wasted;
        }
    }
}

/// The residual after order warm-up samples, into into[order..], each a
/// Rice code of its partition's parameter, or raw bits where the
/// parameter is the escape.
fn residual(r: &mut Bits, b: []u8, into: []mut i64, order: usize) -> FlacError!void {
    let method = (try r.read(b, n: 2)) as u32;
    if method > 1 {
        return FlacError.Malformed;
    }
    let param_bits: u32 = 4 + method;
    let escape: u64 = (1 << param_bits) - 1;
    let partition_order = (try r.read(b, n: 4)) as u32;
    let n = into.len();
    let parts: usize = 1 << partition_order;
    if n % parts != 0 or n / parts < order {
        return FlacError.Malformed;
    }
    let per = n / parts;
    var i = order;
    var p: usize = 0;
    while p < parts : (p += 1) {
        let k = try r.read(b, n: param_bits);
        let end = (p + 1) * per;
        if k == escape {
            let raw = (try r.read(b, n: 5)) as u32;
            while i < end : (i += 1) {
                into[i] = try r.signed(b, n: raw);
            }
        } else {
            let kk = k as u32;
            // A residual fits in 32 bits, so its zigzag code does too.
            let all: u64 = 0xFFFFFFFF;
            let limit = all >> kk;
            while i < end : (i += 1) {
                let q = try r.unary(b, limit: limit);
                let z = (q << kk) | (try r.read(b, n: kk));
                if (z & 1) != 0 {
                    into[i] = -((z >> 1) as i64) - 1;
                } else {
                    into[i] = (z >> 1) as i64;
                }
            }
        }
    }
}

/// x as a sample of bits bits, when it is one.
fn bounded(x: i64, bits: u32) -> FlacError!i64 {
    let one: i64 = 1;
    let top = one << (bits - 1);
    if x < -top or x >= top {
        return FlacError.Malformed;
    }
    return x;
}

/// The signal of a fixed predictor of order, from its warm-up samples and
/// the residual that follows them in s.
fn fixed(s: []mut i64, order: usize, bits: u32) -> FlacError!void {
    var i = order;
    while i < s.len() : (i += 1) {
        var p: i64 = 0;
        if order == 1 {
            p = s[i - 1];
        } else if order == 2 {
            p = 2 * s[i - 1] - s[i - 2];
        } else if order == 3 {
            p = 3 * s[i - 1] - 3 * s[i - 2] + s[i - 3];
        } else if order == 4 {
            p = 4 * s[i - 1] - 6 * s[i - 2] + 4 * s[i - 3] - s[i - 4];
        }
        s[i] = try bounded(p + s[i], bits: bits);
    }
}

/// The signal of an LPC predictor, the same way.
fn lpc(s: []mut i64, coefs: [32]i64, order: usize, shift: u32, bits: u32) -> FlacError!void {
    var i = order;
    while i < s.len() : (i += 1) {
        var sum: i64 = 0;
        var j: usize = 0;
        while j < order : (j += 1) {
            sum += coefs[j] * s[i - 1 - j];
        }
        s[i] = try bounded((sum >> shift) + s[i], bits: bits);
    }
}
