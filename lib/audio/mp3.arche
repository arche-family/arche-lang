/// Huffman table 10 (ISO/IEC 11172-3 table 3-B.7): for each pair x·8 + y,
/// its codeword's length in the top byte and the codeword below.
fn table10() -> [64]u32 {
    return [
        0x1000001, 0x3000002, 0x600000A, 0x8000017, 0x9000023, 0x900001E, 0x900000C, 0xA000011,
