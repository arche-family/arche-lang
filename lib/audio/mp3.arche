        0x9000009, 0x8000008, 0x9000007, 0xA000008, 0xA000004, 0xB000004, 0xB000002, 0xB000000,
    ];
}

/// Huffman table 11 (ISO/IEC 11172-3 table 3-B.7): for each pair x·8 + y,
