/// HTTP (RFC 9110): the messages, whatever the version that carries them.
/// http.h1 is HTTP/1.1 (RFC 9112), http.h2 HTTP/2 (RFC 9113) with HPACK
/// (http.hpack), and http.server serves both, in the clear or over TLS.
import alloc;
import core.mem;

/// Every way a message or a connection fails.
pub type HttpError = error {
    Malformed,
    TooLarge,
    Unsupported,
    Closed,
    Protocol,
    Compression,
    FlowControl,
}

fn lower(c: u8) -> u8 {
    if c >= 'A' and c <= 'Z' {
        return c + 32;
    }
    return c;
}

/// Whether a and b are equal but for ASCII case.
pub fn same_name(a: []u8, b: []u8) -> bool {
    if a.len() != b.len() {
        return false;
    }
    var i: usize = 0;
    while i < a.len() : (i += 1) {
        if lower(a[i]) != lower(b[i]) {
            return false;
        }
    }
    return true;
}

/// Header fields in order. Names are kept in lower case, as HTTP/2 sends
/// them; looking one up ignores case.
pub type Headers = struct {
    names: alloc.List(alloc.String),
    values: alloc.List(alloc.String),
    a: alloc.Allocator,

    pub fn init(a: alloc.Allocator) -> Headers {
        return Headers { names: alloc.List(alloc.String).init(a), values: alloc.List(alloc.String).init(a), a: a };
    }

    pub fn len(self: &Headers) -> usize {
        return self.names.len();
    }

    pub fn name(self: &Headers, i: usize) -> str {
        return self.names.items()[i].view();
    }

    pub fn value(self: &Headers, i: usize) -> str {
        return self.values.items()[i].view();
    }

    /// Adds a field; the name is stored with its ASCII letters in lower case.
    pub fn add(self: &mut Headers, name: str, value: str) {
        var bytes = alloc.List(u8).init(self.a);
        for c in name.bytes() {
            bytes.push(lower(c.*));
        }
        var n = alloc.String.init(self.a);
        unsafe {
            // SAFETY: name is UTF-8, and only ASCII bytes changed, to ASCII.
            n.push_str(mem.str_from(bytes.items()));
        }
        var v = alloc.String.init(self.a);
        v.push_str(value);
        self.names.push(n);
        self.values.push(v);
    }

    /// The index of the first field with the name, if any.
    ///
    /// ```arche
    /// var h = http.Headers.init(sys.alloc);
    /// h.add(name: "Content-Type", value: "text/plain");
    /// match h.find("content-type") {
    ///     some(i) => { assert(h.value(i).eq("text/plain") and h.name(i).eq("content-type")); }
    ///     none => { assert(false); }
    /// }
    /// ```
    pub fn find(self: &Headers, name: str) -> ?usize {
        var i: usize = 0;
        while i < self.names.len() : (i += 1) {
            if same_name(a: self.names.items()[i].view().bytes(), b: name.bytes()) {
                return i;
            }
        }
        return none;
    }

    /// Replaces every field with the name by one with the value.
    pub fn set(self: &mut Headers, name: str, value: str) {
        self.remove(name);
        self.add(name: name, value: value);
    }

    pub fn remove(self: &mut Headers, name: str) {
        var names = alloc.List(alloc.String).init(self.a);
        var values = alloc.List(alloc.String).init(self.a);
        var i: usize = 0;
        while i < self.names.len() : (i += 1) {
            if not same_name(a: self.names.items()[i].view().bytes(), b: name.bytes()) {
                var n = alloc.String.init(self.a);
                n.push_str(self.names.items()[i].view());
                var v = alloc.String.init(self.a);
                v.push_str(self.values.items()[i].view());
                names.push(n);
                values.push(v);
            }
        }
        self.names = names;
        self.values = values;
    }
}

/// A request, as either version gives it.
pub type Request = struct {
    pub method: alloc.String,
    /// The path and query, as sent: "/index.html?q=1".
    pub target: alloc.String,
    /// The host the request is for (Host, or HTTP/2's :authority).
    pub authority: alloc.String,
    pub headers: Headers,
    pub body: alloc.List(u8),
    /// 10 for HTTP/1.0, 11 for HTTP/1.1, 20 for HTTP/2.
    pub version: u8,

    pub fn init(a: alloc.Allocator) -> Request {
        return Request {
            method: alloc.String.init(a),
            target: alloc.String.init(a),
            authority: alloc.String.init(a),
            headers: Headers.init(a),
            body: alloc.List(u8).init(a),
            version: 11,
        };
    }

    /// The target without its query.
    pub fn path(self: &Request) -> str {
        let t = self.target.view();
        let b = t.bytes();
        var i: usize = 0;
        while i < b.len() and b[i] != '?' : (i += 1) {
        }
        return t[0..i];
    }
}

/// A response: the handler fills it in, and the server sends it.
pub type Response = struct {
    pub status: u16,
    pub headers: Headers,
    pub body: alloc.List(u8),
    /// HTTP/1.1 only: send the body in chunks rather than with its length.
    pub chunked: bool,
    /// The request's memory: what a handler allocates goes with it.
    pub alloc: alloc.Allocator,

    pub fn init(a: alloc.Allocator) -> Response {
        return Response { status: 200, headers: Headers.init(a), body: alloc.List(u8).init(a), chunked: false, alloc: a };
    }

    /// Appends text to the body.
    pub fn write(self: &mut Response, text: str) {
        for c in text.bytes() {
            self.body.push(c.*);
        }
    }

    pub fn write_bytes(self: &mut Response, data: []u8) {
        for c in data {
            self.body.push(c.*);
        }
    }
}

/// The reason phrase HTTP/1.1 sends after a status code.
pub fn reason(status: u16) -> str {
    if status == 100 { return "Continue"; }
    if status == 101 { return "Switching Protocols"; }
    if status == 200 { return "OK"; }
    if status == 201 { return "Created"; }
    if status == 204 { return "No Content"; }
    if status == 206 { return "Partial Content"; }
    if status == 301 { return "Moved Permanently"; }
    if status == 302 { return "Found"; }
    if status == 304 { return "Not Modified"; }
    if status == 400 { return "Bad Request"; }
    if status == 401 { return "Unauthorized"; }
    if status == 403 { return "Forbidden"; }
    if status == 404 { return "Not Found"; }
    if status == 405 { return "Method Not Allowed"; }
    if status == 408 { return "Request Timeout"; }
    if status == 411 { return "Length Required"; }
    if status == 413 { return "Content Too Large"; }
    if status == 414 { return "URI Too Long"; }
    if status == 417 { return "Expectation Failed"; }
    if status == 431 { return "Request Header Fields Too Large"; }
    if status == 500 { return "Internal Server Error"; }
    if status == 501 { return "Not Implemented"; }
    if status == 503 { return "Service Unavailable"; }
    if status == 505 { return "HTTP Version Not Supported"; }
    return "Unknown";
}

/// Whether a response with the status has no body (RFC 9110 §6.4.1).
pub fn bodiless(status: u16) -> bool {
    return status < 200 or status == 204 or status == 304;
}
