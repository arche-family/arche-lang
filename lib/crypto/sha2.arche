/// SHA-256, SHA-384 and SHA-512 (FIPS 180-4). Every operation is on all
/// of the data, whatever it holds: their time depends on its length only.

fn k256() -> [64]u32 {
    return [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ];
}

fn k512() -> [80]u64 {
    return [
        0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc, 0x3956c25bf348b538,
        0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118, 0xd807aa98a3030242, 0x12835b0145706fbe,
        0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2, 0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235,
        0xc19bf174cf692694, 0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
        0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5, 0x983e5152ee66dfab,
        0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4, 0xc6e00bf33da88fc2, 0xd5a79147930aa725,
        0x06ca6351e003826f, 0x142929670a0e6e70, 0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed,
        0x53380d139d95b3df, 0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
        0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30, 0xd192e819d6ef5218,
        0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8, 0x19a4c116b8d2d0c8, 0x1e376c085141ab53,
        0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8, 0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373,
        0x682e6ff3d6b2b8a3, 0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
        0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b, 0xca273eceea26619c,
        0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178, 0x06f067aa72176fba, 0x0a637dc5a2c898a6,
        0x113f9804bef90dae, 0x1b710b35131c471b, 0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc,
        0x431d67c49c100d4c, 0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
    ];
}

fn rotr32(x: u32, n: u32) -> u32 {
    return (x >> n) | (x << (32 - n));
}

fn rotr64(x: u64, n: u32) -> u64 {
    return (x >> n) | (x << (64 - n));
}

/// SHA-256, fed in pieces.
pub type Sha256 = struct {
    h: [8]u32,
    buf: [64]u8,
    used: usize,
    total: u64,

    pub fn init() -> Sha256 {
        return Sha256 {
            h: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19],
            buf: [0; 64],
            used: 0,
            total: 0,
        };
    }

    fn block(self: &mut Sha256, b: []u8) {
        let k = k256();
        var w: [64]u32 = [0; 64];
        var i: usize = 0;
        while i < 16 : (i += 1) {
            w[i] = ((b[4 * i] as u32) << 24) | ((b[4 * i + 1] as u32) << 16) | ((b[4 * i + 2] as u32) << 8) | b[4 * i + 3] as u32;
        }
        while i < 64 : (i += 1) {
            let s0 = rotr32(x: w[i - 15], n: 7) ^ rotr32(x: w[i - 15], n: 18) ^ (w[i - 15] >> 3);
            let s1 = rotr32(x: w[i - 2], n: 17) ^ rotr32(x: w[i - 2], n: 19) ^ (w[i - 2] >> 10);
            w[i] = w[i - 16] +% s0 +% w[i - 7] +% s1;
        }
        var a = self.h[0];
        var bb = self.h[1];
        var c = self.h[2];
        var d = self.h[3];
        var e = self.h[4];
        var f = self.h[5];
        var g = self.h[6];
        var h = self.h[7];
        i = 0;
        while i < 64 : (i += 1) {
            let s1 = rotr32(x: e, n: 6) ^ rotr32(x: e, n: 11) ^ rotr32(x: e, n: 25);
            let ch = (e & f) ^ (~e & g);
            let t1 = h +% s1 +% ch +% k[i] +% w[i];
            let s0 = rotr32(x: a, n: 2) ^ rotr32(x: a, n: 13) ^ rotr32(x: a, n: 22);
            let maj = (a & bb) ^ (a & c) ^ (bb & c);
            let t2 = s0 +% maj;
            h = g;
            g = f;
            f = e;
            e = d +% t1;
            d = c;
            c = bb;
            bb = a;
            a = t1 +% t2;
        }
        self.h[0] = self.h[0] +% a;
        self.h[1] = self.h[1] +% bb;
        self.h[2] = self.h[2] +% c;
        self.h[3] = self.h[3] +% d;
        self.h[4] = self.h[4] +% e;
        self.h[5] = self.h[5] +% f;
        self.h[6] = self.h[6] +% g;
        self.h[7] = self.h[7] +% h;
    }

    pub fn update(self: &mut Sha256, data: []u8) {
        self.total +%= data.len() as u64;
        var i: usize = 0;
        while i < data.len() {
            if self.used == 0 and data.len() - i >= 64 {
                self.block(data[i..i + 64]);
                i += 64;
                continue;
            }
            self.buf[self.used] = data[i];
            self.used += 1;
            i += 1;
            if self.used == 64 {
                let full = self.buf;
                self.block(full[0..64]);
                self.used = 0;
            }
        }
    }

    pub fn finish(self: &mut Sha256) -> [32]u8 {
        let bits = self.total *% 8;
        var pad: [72]u8 = [0; 72];
        pad[0] = 0x80;
        var n: usize = 64 - (self.used + 8) % 64;
        if n == 0 {
            n = 64;
        }
        var k: usize = 0;
        while k < 8 : (k += 1) {
            pad[n + k] = ((bits >> ((7 - k) * 8) as u32) & 0xFF) as u8;
        }
        let total = self.total;
        self.update(pad[0..n + 8]);
        self.total = total;
        var out: [32]u8 = [0; 32];
        var j: usize = 0;
        while j < 8 : (j += 1) {
            out[4 * j] = (self.h[j] >> 24) as u8;
            out[4 * j + 1] = ((self.h[j] >> 16) & 0xFF) as u8;
            out[4 * j + 2] = ((self.h[j] >> 8) & 0xFF) as u8;
            out[4 * j + 3] = (self.h[j] & 0xFF) as u8;
        }
        return out;
    }
}

/// SHA-512, and SHA-384 with its own start and a shorter result.
pub type Sha512 = struct {
    h: [8]u64,
    buf: [128]u8,
    used: usize,
    total: u64,

    pub fn init() -> Sha512 {
        return Sha512 {
            h: [0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
                0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179],
            buf: [0; 128],
            used: 0,
            total: 0,
        };
    }

    pub fn init384() -> Sha512 {
        return Sha512 {
            h: [0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
                0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4],
            buf: [0; 128],
            used: 0,
            total: 0,
        };
    }

    fn block(self: &mut Sha512, b: []u8) {
        let k = k512();
        var w: [80]u64 = [0; 80];
        var i: usize = 0;
        while i < 16 : (i += 1) {
            var v: u64 = 0;
            var j: usize = 0;
            while j < 8 : (j += 1) {
                v = (v << 8) | b[8 * i + j] as u64;
            }
            w[i] = v;
        }
        while i < 80 : (i += 1) {
            let s0 = rotr64(x: w[i - 15], n: 1) ^ rotr64(x: w[i - 15], n: 8) ^ (w[i - 15] >> 7);
            let s1 = rotr64(x: w[i - 2], n: 19) ^ rotr64(x: w[i - 2], n: 61) ^ (w[i - 2] >> 6);
            w[i] = w[i - 16] +% s0 +% w[i - 7] +% s1;
        }
        var a = self.h[0];
        var bb = self.h[1];
        var c = self.h[2];
        var d = self.h[3];
        var e = self.h[4];
        var f = self.h[5];
        var g = self.h[6];
        var h = self.h[7];
        i = 0;
        while i < 80 : (i += 1) {
            let s1 = rotr64(x: e, n: 14) ^ rotr64(x: e, n: 18) ^ rotr64(x: e, n: 41);
            let ch = (e & f) ^ (~e & g);
            let t1 = h +% s1 +% ch +% k[i] +% w[i];
            let s0 = rotr64(x: a, n: 28) ^ rotr64(x: a, n: 34) ^ rotr64(x: a, n: 39);
            let maj = (a & bb) ^ (a & c) ^ (bb & c);
            let t2 = s0 +% maj;
            h = g;
            g = f;
            f = e;
            e = d +% t1;
            d = c;
            c = bb;
            bb = a;
            a = t1 +% t2;
        }
        self.h[0] = self.h[0] +% a;
        self.h[1] = self.h[1] +% bb;
        self.h[2] = self.h[2] +% c;
        self.h[3] = self.h[3] +% d;
        self.h[4] = self.h[4] +% e;
        self.h[5] = self.h[5] +% f;
        self.h[6] = self.h[6] +% g;
        self.h[7] = self.h[7] +% h;
    }

    pub fn update(self: &mut Sha512, data: []u8) {
        self.total +%= data.len() as u64;
        var i: usize = 0;
        while i < data.len() {
            if self.used == 0 and data.len() - i >= 128 {
                self.block(data[i..i + 128]);
                i += 128;
                continue;
            }
            self.buf[self.used] = data[i];
            self.used += 1;
            i += 1;
            if self.used == 128 {
                let full = self.buf;
                self.block(full[0..128]);
                self.used = 0;
            }
        }
    }

    fn pad(self: &mut Sha512) {
        let bits = self.total *% 8;
        var pad: [144]u8 = [0; 144];
        pad[0] = 0x80;
        var n: usize = 128 - (self.used + 16) % 128;
        if n == 0 {
            n = 128;
        }
        var k: usize = 0;
        while k < 8 : (k += 1) {
            pad[n + 8 + k] = ((bits >> ((7 - k) * 8) as u32) & 0xFF) as u8;
        }
        let total = self.total;
        self.update(pad[0..n + 16]);
        self.total = total;
    }

    fn out_bytes(self: &Sha512, out: []mut u8) {
        var j: usize = 0;
        while j < out.len() : (j += 1) {
            out[j] = ((self.h[j / 8] >> ((7 - j % 8) * 8) as u32) & 0xFF) as u8;
        }
    }

    pub fn finish(self: &mut Sha512) -> [64]u8 {
        self.pad();
        var out: [64]u8 = [0; 64];
        self.out_bytes(out[0..64]);
        return out;
    }

    pub fn finish384(self: &mut Sha512) -> [48]u8 {
        self.pad();
        var out: [48]u8 = [0; 48];
        self.out_bytes(out[0..48]);
        return out;
    }
}

/// SHA-256 of data.
///
/// ```arche
/// let d = sha2.sha256("abc".bytes());
/// // FIPS 180-2's first example: ba7816bf...f20015ad.
/// assert(d[0] == 0xba and d[1] == 0x78 and d[30] == 0x15 and d[31] == 0xad);
/// ```
pub fn sha256(data: []u8) -> [32]u8 {
    var h = Sha256.init();
    h.update(data);
    return h.finish();
}

pub fn sha512(data: []u8) -> [64]u8 {
    var h = Sha512.init();
    h.update(data);
    return h.finish();
}

pub fn sha384(data: []u8) -> [48]u8 {
    var h = Sha512.init384();
    h.update(data);
    return h.finish384();
}
