/// JSON (RFC 8259): parsing text into a Value, and writing one back. An
/// object keeps its keys in the order they came, so writing what was read
/// gives the same order (docs/plan.md, determinism). A number keeps its text,
/// as written; as_i64 reads the integers.
import alloc;
import core.fmt;
import core.mem;
import core.meta;
import core.utf8;

pub type Value = enum {
    Null,
    Bool { value: bool },
    Number { text: alloc.String },
    Text { value: alloc.String },
    Array { items: alloc.List(Value) },
    Object { keys: alloc.List(alloc.String), values: alloc.List(Value) },
}

pub type JsonError = error { Syntax, TooDeep }

/// What stops decode: JsonError's two, and Mismatch, JSON that is not of
/// the shape of the type it was asked to read.
pub type DecodeError = error { Syntax, TooDeep, Mismatch }

/// How deep arrays and objects may nest: deeper text is an error, not a
/// stack overflow.
pub const MAX_DEPTH: u32 = 128;

/// The value text holds, or the error that stops it.
///
/// ```arche
/// import alloc;
/// let v = json.parse("{\"b\": [1, true, null], \"a\": \"x\"}", sys.alloc) catch json.Value.Null;
/// var out = alloc.String.init(sys.alloc);
/// json.write(&v, out: &mut out);
/// // Keys keep their order: b, then a.
/// assert(out.view().eq("{\"b\":[1,true,null],\"a\":\"x\"}"));
/// ```
pub fn parse(text: str, a: alloc.Allocator) -> JsonError!Value {
    let b = text.bytes();
    var p = Parser { at: 0, a: a };
    p.space(b);
    let v = try p.value(b, depth: 0);
    p.space(b);
    if p.at != b.len() {
        return JsonError.Syntax;
    }
    return v;
}

/// Where parsing is in the text, which each function takes as b.
type Parser = struct {
    at: usize,
    a: alloc.Allocator,

    fn peek(self: &Parser, b: []u8) -> u8 {
        if self.at < b.len() {
            return b[self.at];
        }
        return 0;
    }

    fn space(self: &mut Parser, b: []u8) {
        while self.at < b.len() {
            let c = b[self.at];
            if c != ' ' and c != '\t' and c != '\n' and c != '\r' {
                return;
            }
            self.at += 1;
        }
    }

    fn word(self: &mut Parser, b: []u8, w: str) -> bool {
        let wb = w.bytes();
        if self.at + wb.len() > b.len() {
            return false;
        }
        var i: usize = 0;
        while i < wb.len() : (i += 1) {
            if b[self.at + i] != wb[i] {
                return false;
            }
        }
        self.at += wb.len();
        return true;
    }

    fn value(self: &mut Parser, b: []u8, depth: u32) -> JsonError!Value {
        if depth > MAX_DEPTH {
            return JsonError.TooDeep;
        }
        let c = self.peek(b);
        if c == 'n' and self.word(b, w: "null") {
            return Value.Null;
        }
        if c == 't' and self.word(b, w: "true") {
            return Value.Bool { value: true };
        }
        if c == 'f' and self.word(b, w: "false") {
            return Value.Bool { value: false };
        }
        if c == '"' {
            let s = try self.string(b);
            return Value.Text { value: s };
        }
        if c == '[' {
            self.at += 1;
            var items = alloc.List(Value).init(self.a);
            self.space(b);
            if self.peek(b) == ']' {
                self.at += 1;
                return Value.Array { items: items };
            }
            while true {
                self.space(b);
                let v = try self.value(b, depth: depth + 1);
                items.push(v);
                self.space(b);
                if self.peek(b) == ',' {
                    self.at += 1;
                } else if self.peek(b) == ']' {
                    self.at += 1;
                    return Value.Array { items: items };
                } else {
                    return JsonError.Syntax;
                }
            }
        }
        if c == '{' {
            self.at += 1;
            var keys = alloc.List(alloc.String).init(self.a);
            var values = alloc.List(Value).init(self.a);
            self.space(b);
            if self.peek(b) == '}' {
                self.at += 1;
                return Value.Object { keys: keys, values: values };
            }
            while true {
                self.space(b);
                if self.peek(b) != '"' {
                    return JsonError.Syntax;
                }
                let k = try self.string(b);
                self.space(b);
                if self.peek(b) != ':' {
                    return JsonError.Syntax;
                }
                self.at += 1;
                self.space(b);
                let v = try self.value(b, depth: depth + 1);
                keys.push(k);
                values.push(v);
                self.space(b);
                if self.peek(b) == ',' {
                    self.at += 1;
                } else if self.peek(b) == '}' {
                    self.at += 1;
                    return Value.Object { keys: keys, values: values };
                } else {
                    return JsonError.Syntax;
                }
            }
        }
        if c == '-' or (c >= '0' and c <= '9') {
            let n = try self.number(b);
            return Value.Number { text: n };
        }
        return JsonError.Syntax;
    }

    fn digits(self: &mut Parser, b: []u8) -> usize {
        let start = self.at;
        while self.peek(b) >= '0' and self.peek(b) <= '9' {
            self.at += 1;
        }
        return self.at - start;
    }

    /// -? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?
    fn number(self: &mut Parser, b: []u8) -> JsonError!alloc.String {
        let start = self.at;
        if self.peek(b) == '-' {
            self.at += 1;
        }
        if self.peek(b) == '0' {
            self.at += 1;
        } else if self.digits(b) == 0 {
            return JsonError.Syntax;
        }
        if self.peek(b) == '.' {
            self.at += 1;
            if self.digits(b) == 0 {
                return JsonError.Syntax;
            }
        }
        if self.peek(b) == 'e' or self.peek(b) == 'E' {
            self.at += 1;
            if self.peek(b) == '+' or self.peek(b) == '-' {
                self.at += 1;
            }
            if self.digits(b) == 0 {
                return JsonError.Syntax;
            }
        }
        var out = alloc.String.init(self.a);
        var i = start;
        while i < self.at : (i += 1) {
            out.push_ascii(b[i]);
        }
        return out;
    }

    fn hex4(self: &mut Parser, b: []u8) -> JsonError!u32 {
        var v: u32 = 0;
        var k: u32 = 0;
        while k < 4 : (k += 1) {
            let c = self.peek(b);
            var d: u32 = 0;
            if c >= '0' and c <= '9' {
                d = (c - '0') as u32;
            } else if c >= 'a' and c <= 'f' {
                d = (c - 'a') as u32 + 10;
            } else if c >= 'A' and c <= 'F' {
                d = (c - 'A') as u32 + 10;
            } else {
                return JsonError.Syntax;
            }
            v = v * 16 + d;
            self.at += 1;
        }
        return v;
    }

    /// A string, its escapes decoded; the text must be UTF-8.
    fn string(self: &mut Parser, b: []u8) -> JsonError!alloc.String {
        self.at += 1; // "
        var bytes = alloc.List(u8).init(self.a);
        while true {
            if self.at >= b.len() {
                return JsonError.Syntax;
            }
            let c = b[self.at];
            self.at += 1;
            if c == '"' {
                break;
            }
            if c < 0x20 {
                return JsonError.Syntax;
            }
            if c != '\\' {
                bytes.push(c);
                continue;
            }
            let e = self.peek(b);
            self.at += 1;
            if e == '"' or e == '\\' or e == '/' {
                bytes.push(e);
            } else if e == 'b' {
                bytes.push(8);
            } else if e == 'f' {
                bytes.push(12);
            } else if e == 'n' {
                bytes.push('\n');
            } else if e == 'r' {
                bytes.push('\r');
            } else if e == 't' {
                bytes.push('\t');
            } else if e == 'u' {
                var cp = try self.hex4(b);
                if cp >= 0xD800 and cp <= 0xDBFF {
                    // A surrogate pair: 😀.
                    if not self.word(b, w: "\\u") {
                        return JsonError.Syntax;
                    }
                    let low = try self.hex4(b);
                    if low < 0xDC00 or low > 0xDFFF {
                        return JsonError.Syntax;
                    }
                    cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00);
                } else if cp >= 0xDC00 and cp <= 0xDFFF {
                    return JsonError.Syntax;
                }
                var enc: [4]u8 = [0; 4];
                let n = utf8.encode(cp, enc[0..4]);
                var k: usize = 0;
                while k < n : (k += 1) {
                    bytes.push(enc[k]);
                }
            } else {
                return JsonError.Syntax;
            }
        }
        if not utf8.valid(bytes.items()) {
            return JsonError.Syntax;
        }
        var out = alloc.String.init(self.a);
        unsafe {
            // SAFETY: checked to be UTF-8 just now.
            out.push_str(mem.str_from(bytes.items()));
        }
        return out;
    }
}

// ---- writing ------------------------------------------------------------------------

/// v as JSON text, without spaces, appended to out.
pub fn write(v: &Value, out: &mut alloc.String) {
    match v {
        .Null => { out.push_str("null"); }
        .Bool { value } => {
            if value.* {
                out.push_str("true");
            } else {
                out.push_str("false");
            }
        }
        .Number { text } => { out.push_str(text.view()); }
        .Text { value } => { write_string(value.view(), out); }
        .Array { items } => {
            out.push_ascii('[');
            var i: usize = 0;
            for item in items.items() {
                if i > 0 {
                    out.push_ascii(',');
                }
                write(item, out);
                i += 1;
            }
            out.push_ascii(']');
        }
        .Object { keys, values } => {
            out.push_ascii('{');
            var i: usize = 0;
            while i < keys.len() : (i += 1) {
                if i > 0 {
                    out.push_ascii(',');
                }
                write_string(keys.items()[i].view(), out);
                out.push_ascii(':');
                write(&values.items()[i], out);
            }
            out.push_ascii('}');
        }
    }
}

fn hex_digit(d: u8) -> u8 {
    if d < 10 {
        return '0' + d;
    }
    return 'a' + (d - 10);
}

/// A string with '"', '\\' and control characters escaped.
pub fn write_string(s: str, out: &mut alloc.String) {
    out.push_ascii('"');
    let b = s.bytes();
    var run: usize = 0;
    var i: usize = 0;
    while i < b.len() : (i += 1) {
        let c = b[i];
        if c != '"' and c != '\\' and c >= 0x20 {
            continue;
        }
        out.push_str(s[run..i]);
        run = i + 1;
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if c == '\t' {
            out.push_str("\\t");
        } else if c == '\r' {
            out.push_str("\\r");
        } else {
            out.push_str("\\u00");
            out.push_ascii(hex_digit(c >> 4));
            out.push_ascii(hex_digit(c & 15));
        }
    }
    out.push_str(s[run..b.len()]);
    out.push_ascii('"');
}

// ---- reading values -------------------------------------------------------------------

/// A number that is an integer that fits i64: "-12" but not "1.5" or "1e3".
pub fn as_i64(v: &Value) -> ?i64 {
    match v {
        .Number { text } => {
            let b = text.view().bytes();
            var neg = false;
            var i: usize = 0;
            if b[0] == '-' {
                neg = true;
                i = 1;
            }
            var mag: u64 = 0;
            while i < b.len() : (i += 1) {
                let c = b[i];
                if c < '0' or c > '9' {
                    return none;
                }
                if mag > (9223372036854775808 - (c - '0') as u64) / 10 {
                    return none;
                }
                mag = mag * 10 + (c - '0') as u64;
            }
            if neg {
                return (0 -% mag) as% i64;
            }
            if mag > 9223372036854775807 {
                return none;
            }
            return mag as i64;
        }
        _ => { return none; }
    }
}

/// The index of key in an object, the first one when it repeats.
pub fn key_index(v: &Value, key: str) -> ?usize {
    match v {
        .Object { keys, .. } => {
            var i: usize = 0;
            for k in keys.items() {
                if k.view().eq(key) {
                    return i;
                }
                i += 1;
            }
            return none;
        }
        _ => { return none; }
    }
}

/// A number value from an integer.
pub fn from_int(n: i64, a: alloc.Allocator) -> Value {
    var buf: [21]u8 = [0; 21];
    let len = fmt.signed(n, buf[0..21]);
    var text = alloc.String.init(a);
    var i: usize = 0;
    while i < len : (i += 1) {
        text.push_ascii(buf[i]);
    }
    return Value.Number { text: text };
}

/// A text value.
pub fn from_text(s: str, a: alloc.Allocator) -> Value {
    var value = alloc.String.init(a);
    value.push_str(s);
    return Value.Text { value: value };
}

// ---- encoding and decoding types ------------------------------------------------------
//
// encode and decode work on a type named at the call, with core.meta and
// `comptime if` (spec/arche.md §4.3, §4.4): each instance is the code for
// one type, so there is no walk over a description at run time. A struct is
// an object of its pub fields, in the order they are declared;
// alloc.String a string; bool true or false; an integer type a number; ?T
// null or a T; alloc.List(T) an array; Value itself. Any other type, a float
// for one, is a compile error that names it (E0841).

/// value as JSON text, without spaces, appended to out. A struct User with
/// `pub name: alloc.String` and `pub age: u32` is written as
/// {"name":"Ada","age":36}.
///
/// ```arche
/// var xs = alloc.List(?u32).init(sys.alloc);
/// xs.push(some(1));
/// xs.push(none);
/// var out = alloc.String.init(sys.alloc);
/// json.encode(alloc.List(?u32), &xs, out: &mut out);
/// assert(out.view().eq("[1,null]"));
/// ```
pub fn encode(comptime T: type, value: &T, out: &mut alloc.String) {
    comptime if meta.same(T, alloc.String) {
        write_string(value.view(), out);
    } else comptime if meta.same(T, Value) {
        write(value, out);
    } else comptime if meta.is_bool(T) {
        if value.* {
            out.push_str("true");
        } else {
            out.push_str("false");
        }
    } else comptime if meta.is_int(T) {
        comptime if meta.is_signed(T) {
            out.push_i64(value.* as i64);
        } else {
            out.push_u64(value.* as u64);
        }
    } else comptime if meta.is_optional(T) {
        match value {
            some(x) => { encode(meta.elem_type(T), x, out); }
            none => { out.push_str("null"); }
        }
    } else comptime if meta.is_list(T) {
        out.push_ascii('[');
        var i: usize = 0;
        for item in value.items() {
            if i > 0 {
                out.push_ascii(',');
            }
            encode(meta.elem_type(T), item, out);
            i += 1;
        }
        out.push_ascii(']');
    } else comptime if meta.is_struct(T) {
        out.push_ascii('{');
        encode_fields(T, 0, value, out);
        out.push_ascii('}');
    } else {
        meta.unsupported(T);
    }
}

/// The pub fields of struct T from I on, as "name":value pairs.
fn encode_fields(comptime T: type, comptime I: usize, value: &T, out: &mut alloc.String) {
    comptime if I < meta.field_count(T) {
        comptime if I > 0 {
            out.push_ascii(',');
        }
        write_string(meta.field_name(T, I), out);
        out.push_ascii(':');
        encode(meta.field_type(T, I), meta.field(T, I, value), out);
        encode_fields(T, I + 1, value, out);
    }
}

/// Reads text, JSON of T's shape, into `into`. An object's key that names a
/// pub field sets it; a field it does not name keeps its value, and a key
/// that names none is passed over, so `into` holds the defaults. A list is
/// replaced by the array's items. Strings, lists and the parsed text are
/// allocated with a. On an error `into` may have been changed in part.
///
/// ```arche
/// var xs = alloc.List(i8).init(sys.alloc);
/// json.decode(alloc.List(i8), "[3, -4]", into: &mut xs, sys.alloc) catch panic("not a list of i8");
/// assert(xs.len() == 2 and xs.items()[1] == -4);
/// match json.decode(alloc.List(i8), "[128]", into: &mut xs, sys.alloc) {
///     ok(_) => { panic("128 is no i8"); }
///     err(e) => { assert(e == json.DecodeError.Mismatch); }
/// }
/// ```
pub fn decode(comptime T: type, text: str, into: &mut T, a: alloc.Allocator) -> DecodeError!void {
    let v = try parse(text, a);
    try decode_value(T, &v, into, a);
}

/// Reads v into `into`, as decode does.
pub fn decode_value(comptime T: type, v: &Value, into: &mut T, a: alloc.Allocator) -> DecodeError!void {
    comptime if meta.same(T, alloc.String) {
        match v {
            .Text { value } => { into.* = value.clone(); }
            _ => { return DecodeError.Mismatch; }
        }
    } else comptime if meta.is_bool(T) {
        match v {
            .Bool { value } => { into.* = value.*; }
            _ => { return DecodeError.Mismatch; }
        }
    } else comptime if meta.is_int(T) {
        let bits = try integer(v, signed: meta.is_signed(T), bits: (mem.size_of(T) * 8) as u32);
        into.* = bits as% T;
    } else comptime if meta.is_optional(T) {
        match v {
            .Null => {
                into.* = none;
                return;
            }
            _ => { }
        }
        var x = fresh(meta.elem_type(T), a);
        try decode_value(meta.elem_type(T), v, into: &mut x, a);
        into.* = some(x);
    } else comptime if meta.is_list(T) {
        match v {
            .Array { items } => {
                into.clear();
                for item in items.items() {
                    var x = fresh(meta.elem_type(T), a);
                    try decode_value(meta.elem_type(T), item, into: &mut x, a);
                    into.push(x);
                }
            }
            _ => { return DecodeError.Mismatch; }
        }
    } else comptime if meta.is_struct(T) {
        match v {
            .Object { .. } => { try decode_fields(T, 0, v, into, a); }
            _ => { return DecodeError.Mismatch; }
        }
    } else {
        meta.unsupported(T);
    }
}

/// The pub fields of struct T from I on, from object v.
fn decode_fields(comptime T: type, comptime I: usize, v: &Value, into: &mut T, a: alloc.Allocator) -> DecodeError!void {
    comptime if I < meta.field_count(T) {
        match key_index(v, meta.field_name(T, I)) {
            some(k) => {
                match v {
                    .Object { values, .. } => {
                        try decode_value(meta.field_type(T, I), &values.items()[k], into: meta.field_mut(T, I, into), a);
                    }
                    _ => { }
                }
            }
            none => { }
        }
        try decode_fields(T, I + 1, v, into, a);
    }
}

/// A new value for an array's item or an optional's payload to be read
/// into: an empty string or list, false, 0 or none, or a struct of these
/// whose fields are all pub.
fn fresh(comptime T: type, a: alloc.Allocator) -> T {
    comptime if meta.same(T, alloc.String) {
        return alloc.String.init(a);
    } else comptime if meta.is_bool(T) {
        return false;
    } else comptime if meta.is_int(T) {
        return 0;
    } else comptime if meta.is_list(T) {
        return alloc.List(meta.elem_type(T)).init(a);
    } else comptime if meta.is_optional(T) {
        return none;
    } else comptime if meta.is_struct(T) and meta.pub_only(T) {
        unsafe {
            // SAFETY: every field of T is pub, so fresh_fields gives each
            // one a value of its own; zero bytes are only a start.
            var x = meta.zeroed(T);
            fresh_fields(T, 0, &mut x, a);
            return x;
        }
    } else {
        meta.unsupported(T);
    }
}

/// Field I on of struct T, each a new value as fresh makes them.
fn fresh_fields(comptime T: type, comptime I: usize, x: &mut T, a: alloc.Allocator) {
    comptime if I < meta.field_count(T) {
        let v = fresh(meta.field_type(T, I), a);
        meta.field_mut(T, I, x).* = v;
        fresh_fields(T, I + 1, x, a);
    }
}

/// The integer v holds, as the two's complement bits of a type of `bits`
/// bits, signed or not; Mismatch when v is not an integer or does not fit.
fn integer(v: &Value, signed: bool, bits: u32) -> DecodeError!u64 {
    match v {
        .Number { text } => {
            let b = text.view().bytes();
            var neg = false;
            var i: usize = 0;
            if b[0] == '-' {
                neg = true;
                i = 1;
            }
            var mag: u64 = 0;
            while i < b.len() : (i += 1) {
                let c = b[i];
                if c < '0' or c > '9' {
                    return DecodeError.Mismatch;
                }
                let d = (c - '0') as u64;
                if mag > (18446744073709551615 - d) / 10 {
                    return DecodeError.Mismatch;
                }
                mag = mag * 10 + d;
            }
            let one: u64 = 1;
            if signed {
                // The magnitude of the type's least value.
                let least = one << (bits - 1) as u64;
                if neg {
                    if mag > least {
                        return DecodeError.Mismatch;
                    }
                    return 0 -% mag;
                }
                if mag >= least {
                    return DecodeError.Mismatch;
                }
                return mag;
            }
            if (neg and mag != 0) or (bits < 64 and mag >= one << bits as u64) {
                return DecodeError.Mismatch;
            }
            return mag;
        }
        _ => { return DecodeError.Mismatch; }
    }
}
