/// Paths as text, as the system std is for reads them: '/' between parts,
/// and on Windows '\\' as well, with a drive first ("C:/"). On Linux those
/// are a name's ordinary characters. Nothing here reads the file system.
import alloc;
import std;

fn windows() -> bool {
    return std.SYSTEM.eq("windows");
}

fn is_separator(c: u8) -> bool {
    return c == '/' or (c == '\\' and windows());
}

/// How many bytes the drive takes: 2 for "C:" on Windows, 0 otherwise.
fn drive_of(b: []u8) -> usize {
    if b.len() >= 2 and b[1] == ':' and ((b[0] >= 'A' and b[0] <= 'Z') or (b[0] >= 'a' and b[0] <= 'z')) and windows() {
        return 2;
    }
    return 0;
}

/// Whether the path starts from the root: at a separator, or at one after
/// the drive. "C:x" is from the current directory of drive C.
pub fn is_absolute(p: str) -> bool {
    let b = p.bytes();
    let d = drive_of(b);
    return b.len() > d and is_separator(b[d]);
}

fn last_slash(p: str) -> ?usize {
    let b = p.bytes();
    var i = b.len();
    while i > 0 : (i -= 1) {
        if is_separator(b[i - 1]) {
            return i - 1;
        }
    }
    return none;
}

/// The last part: "c.txt" of "a/b/c.txt"; the whole path without a '/'.
///
/// ```arche
/// assert(path.file_name("a/b/c.txt").eq("c.txt"));
/// assert(path.file_name("c.txt").eq("c.txt"));
/// assert(path.extension("a/b/c.txt").eq("txt"));
/// assert(path.parent("a/b/c.txt").eq("a/b"));
/// ```
pub fn file_name(p: str) -> str {
    match last_slash(p) {
        some(i) => { return p[i + 1..p.len()]; }
        none => { return p; }
    }
}

/// Everything before the last part: "a/b" of "a/b/c.txt", "/" of "/c",
/// "" of "c.txt", and on Windows "C:/" of "C:/c".
pub fn parent(p: str) -> str {
    match last_slash(p) {
        some(i) => {
            if i == drive_of(p.bytes()) {
                return p[0..i + 1];
            }
            return p[0..i];
        }
        none => { return p[0..0]; }
    }
}

/// "txt" of "a/b/c.txt"; "" when the last part has no '.' after its start.
pub fn extension(p: str) -> str {
    let name = file_name(p);
    let b = name.bytes();
    var i = b.len();
    while i > 1 : (i -= 1) {
        if b[i - 1] == '.' {
            return name[i..name.len()];
        }
    }
    return name[0..0];
}

/// base and name with one '/' between; name alone when it is absolute.
///
/// ```arche
/// let p = path.join(base: "lib/", name: "core.arche", sys.alloc);
/// assert(p.view().eq("lib/core.arche"));
/// let q = path.join(base: "lib", name: "/etc/hosts", sys.alloc);
/// assert(q.view().eq("/etc/hosts"));
/// ```
pub fn join(base: str, name: str, a: alloc.Allocator) -> alloc.String {
    var out = alloc.String.init(a);
    if is_absolute(name) or base.len() == 0 {
        out.push_str(name);
        return out;
    }
    out.push_str(base);
    if not is_separator(base.bytes()[base.len() - 1]) {
        out.push_ascii('/');
    }
    out.push_str(name);
    return out;
}

/// Without "." parts, empty parts and the parts ".." takes back: "a/./b/../c"
/// is "a/c". A relative path keeps the ".." it cannot take back; "" is ".".
/// '/' separates the parts of the result, and Windows takes it; a path that
/// asks Windows not to read it ("\\\\?\\C:\\x") comes back as it is, and two
/// separators first, which name a server there, stay two.
pub fn normalize(p: str, a: alloc.Allocator) -> alloc.String {
    let b = p.bytes();
    var out = alloc.String.init(a);
    if windows() and p.starts_with("\\\\?\\") {
        out.push_str(p);
        return out;
    }
    let d = drive_of(b);
    let absolute = is_absolute(p);
    var parts = alloc.List(alloc.String).init(a);
    var start = d;
    var i = d;
    while i <= b.len() : (i += 1) {
        if i == b.len() or is_separator(b[i]) {
            let part = p[start..i];
            start = i + 1;
            if part.len() == 0 or part.eq(".") {
                continue;
            }
            if part.eq("..") {
                var can_drop = false;
                if parts.len() > 0 {
                    can_drop = not parts.items()[parts.len() - 1].view().eq("..");
                }
                if can_drop {
                    _ = parts.pop();
                    continue;
                }
                if absolute {
                    continue; // nothing is above the root
                }
            }
            var s = alloc.String.init(a);
            s.push_str(part);
            parts.push(s);
        }
    }
    out.push_str(p[0..d]);
    if absolute {
        out.push_ascii('/');
        if windows() and d == 0 and b.len() >= 2 and is_separator(b[1]) {
            out.push_ascii('/');
        }
    }
    var k: usize = 0;
    for part in parts.items() {
        if k > 0 {
            out.push_ascii('/');
        }
        out.push_str(part.view());
        k += 1;
    }
    if out.len() == 0 {
        out.push_ascii('.');
    }
    return out;
}
