/// What the first process does on Linux, PID 1 (docs/sprints.md S35): it
/// mounts the file systems the others need, starts the daemons that run
/// beside it, gathers every child that ends, its own or one whose parent
/// died, and powers the machine off. Each takes the capability it needs.
import alloc;
import core.mem;
import std;
import std.linux;

/// The runtime's: what is buffered written out, before a fork.
extern "c" fn a0rt_flush_all();

pub type InitError = error {
    /// The kernel refused: not PID 1, not allowed, or no such thing.
    Refused,
}

/// Mounts the file system of kind (proc, sysfs, devtmpfs, tmpfs...) from
/// source at target, a directory reached through fs.
pub fn mount(fs: &std.Fs, source: str, target: str, kind: str) -> InitError!void {
    var src: [256]u8 = [0; 256];
    var dst: [4096]u8 = [0; 4096];
    var typ: [64]u8 = [0; 64];
    if not linux.c_path(source, src[0..256]) or not linux.c_path(target, dst[0..4096]) or not linux.c_path(kind, typ[0..64]) {
        return InitError.Refused;
    }
    _ = fs;
    var r: i64 = 0;
    unsafe {
        // SAFETY: three NUL-terminated strings; no flags, no data.
        r = linux.syscall(linux.MOUNT, [linux.arg(u8, &src[0] as *u8), linux.arg(u8, &dst[0] as *u8), linux.arg(u8, &typ[0] as *u8), 0, 0, 0]);
    }
    if linux.errno(r) != 0 {
        return InitError.Refused;
    }
}

/// A child that ended: its process id, and its status as wait4 says it.
pub type Ended = struct {
    pub pid: u32,
    pub status: u32,
}

/// A daemon started: the program at argv[0], a path, with argv and env
/// ("NAME=value" each, and nothing more), in a process of its own that
/// this does not wait for; reap gathers it once it ends, with 127 when
/// there was no such program. Its process id; none when the system made
/// no process.
pub fn start(proc: &std.Proc, argv: &alloc.List(alloc.String), env: &alloc.List(alloc.String), a: alloc.Allocator) -> ?u32 {
    _ = proc;
    if argv.len() == 0 {
        return none;
    }
    // NUL-terminated copies, and the arrays of pointers to them.
    var texts = alloc.List(alloc.List(u8)).init(a);
    for s in argv.items() {
        texts.push(c_text(s.view(), a: a));
    }
    var vars = alloc.List(alloc.List(u8)).init(a);
    for s in env.items() {
        vars.push(c_text(s.view(), a: a));
    }
    var arg_ptrs = alloc.List(u64).init(a);
    for t in texts.items() {
        unsafe {
            // SAFETY: each copy lives until the exec.
            arg_ptrs.push(mem.slice_data(u8, t.items()).addr() as u64);
        }
    }
    arg_ptrs.push(0);
    var env_ptrs = alloc.List(u64).init(a);
    for t in vars.items() {
        unsafe {
            // SAFETY: as above.
            env_ptrs.push(mem.slice_data(u8, t.items()).addr() as u64);
        }
    }
    env_ptrs.push(0);
    var pid: i64 = 0;
    unsafe {
        // SAFETY: what is buffered is written once, by the parent.
        a0rt_flush_all();
        pid = linux.fork();
    }
    if pid < 0 {
        return none;
    }
    if pid == 0 {
        unsafe {
            // SAFETY: the child: exec, or end without the parent's buffers.
            let path = mem.slice_data(u8, texts[0].items());
            let r = linux.syscall(linux.EXECVE, [linux.arg(u8, path), linux.arg(u64, mem.slice_data(u64, arg_ptrs.items())), linux.arg(u64, mem.slice_data(u64, env_ptrs.items())), 0, 0, 0]);
            var code: i64 = 126;
            if linux.errno(r) == linux.ENOENT {
                code = 127;
            }
            _ = linux.syscall(linux.EXIT, [code, 0, 0, 0, 0, 0]);
        }
    }
    return pid as u32;
}

fn c_text(s: str, a: alloc.Allocator) -> alloc.List(u8) {
    var t = alloc.List(u8).init(a);
    for b in s.bytes() {
        t.push(b.*);
    }
    t.push(0);
    return t;
}

/// A child that has ended, gathered; none when none has. It does not
/// wait.
pub fn reap(proc: &std.Proc) -> ?Ended {
    _ = proc;
    var status: i32 = 0;
    var r: i64 = 0;
    unsafe {
        // SAFETY: any child (-1), its status into status, WNOHANG.
        r = linux.syscall(linux.WAIT4, [-1, linux.arg(i32, &status as *i32), 1, 0, 0, 0]);
    }
    if r <= 0 {
        return none;
    }
    return Ended { pid: r as u32, status: status as% u32 };
}

/// The machine powers off. As PID 1 only; else it returns.
pub fn power_off(proc: &std.Proc) {
    _ = proc;
    unsafe {
        // SAFETY: the magic numbers reboot(2) wants, and
        // LINUX_REBOOT_CMD_POWER_OFF.
        _ = linux.syscall(linux.REBOOT, [0xfee1dead, 0x28121969, 0x4321fedc, 0, 0, 0]);
    }
}
