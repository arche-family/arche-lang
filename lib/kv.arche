/// An embedded key-value store (docs/sprints.md S33): a B+ tree of 4096-byte
/// pages in one file, and a write-ahead log beside it (`<path>-wal`). Keys
/// and values are bytes, kept in key order, a key up to 512 bytes and a
/// value up to 1024.
///
/// Changes are made in memory and become durable together at commit: each
/// page a transaction changed goes to the log as a frame, its checksum
/// (CRC-32) and the log's salt in its header, the last one marked as the
/// commit; then the log is synced. A checkpoint writes the logged pages into
/// the file, syncs it, and empties the log. Opening replays the log's
/// committed transactions and stops at the first frame that is torn, short
/// or of an older log, so a crash at any moment leaves every transaction
/// whose commit returned, and nothing of one whose commit did not.
///
/// One process uses a store at a time. A delete that leaves a node less than
/// a quarter full merges it with a sibling when the two fit in one page,
/// taking the separator out of their parent, and a root left with one child
/// gives way to it; freed pages are kept in a list, and new ones come from
/// it first, so a store that shrinks and grows again does not grow its file.
import alloc;
import core.deflate;
import std;

pub const PAGE: usize = 4096;
pub const MAX_KEY: usize = 512;
pub const MAX_VALUE: usize = 1024;
/// Frames in the log past which a commit checkpoints.
pub const CHECKPOINT_FRAMES: u32 = 512;

pub type KvError = error { Io, Corrupt, TooLarge }

const LEAF: u8 = 1;
const INNER: u8 = 2;
const HEAD: usize = 16;
const FRAME_HEAD: usize = 16;

// ---- bytes ------------------------------------------------------------------------------

fn get16(b: []u8, at: usize) -> usize {
    return b[at] as usize | (b[at + 1] as usize) << 8;
}

fn get32(b: []u8, at: usize) -> u32 {
    return b[at] as u32 | (b[at + 1] as u32) << 8 | (b[at + 2] as u32) << 16 | (b[at + 3] as u32) << 24;
}

fn put16(b: []mut u8, at: usize, v: usize) {
    b[at] = (v & 0xFF) as u8;
    b[at + 1] = ((v >> 8) & 0xFF) as u8;
}

fn put32(b: []mut u8, at: usize, v: u32) {
    b[at] = (v & 0xFF) as u8;
    b[at + 1] = ((v >> 8) & 0xFF) as u8;
    b[at + 2] = ((v >> 16) & 0xFF) as u8;
    b[at + 3] = ((v >> 24) & 0xFF) as u8;
}

fn compare(x: []u8, y: []u8) -> i32 {
    var i: usize = 0;
    while i < x.len() and i < y.len() : (i += 1) {
        if x[i] != y[i] {
            if x[i] < y[i] {
                return -1;
            }
            return 1;
        }
    }
    if x.len() < y.len() {
        return -1;
    }
    if x.len() > y.len() {
        return 1;
    }
    return 0;
}

fn copy_of(b: []u8, a: alloc.Allocator) -> alloc.List(u8) {
    var out = alloc.List(u8).with_capacity(a, n: b.len());
    for x in b {
        out.push(x.*);
    }
    return out;
}

// ---- nodes: a page decoded --------------------------------------------------------------

/// A page as lists: a leaf's keys and values and the next leaf, or an inner
/// node's keys and children (one more child than keys; child i holds the
/// keys below key i, the last child the rest).
type Node = struct {
    leaf: bool,
    keys: alloc.List(alloc.List(u8)),
    values: alloc.List(alloc.List(u8)),
    children: alloc.List(u32),
    next: u32,
}

fn empty_node(leaf: bool, a: alloc.Allocator) -> Node {
    return Node { leaf: leaf, keys: alloc.List(alloc.List(u8)).init(a), values: alloc.List(alloc.List(u8)).init(a), children: alloc.List(u32).init(a), next: 0 };
}

fn decode(p: []u8, a: alloc.Allocator) -> KvError!Node {
    var n = empty_node(p[0] == LEAF, a);
    if p[0] != LEAF and p[0] != INNER {
        return KvError.Corrupt;
    }
    let count = get16(p, at: 2);
    let first = get32(p, at: 4);
    var at = HEAD;
    if n.leaf {
        n.next = first;
    } else {
        n.children.push(first);
    }
    var i: usize = 0;
    while i < count : (i += 1) {
        if at + 4 > PAGE {
            return KvError.Corrupt;
        }
        let klen = get16(p, at: at);
        let second = get16(p, at: at + 2);
        if n.leaf {
            if at + 4 + klen + second > PAGE {
                return KvError.Corrupt;
            }
            n.keys.push(copy_of(p[at + 4..at + 4 + klen], a));
            n.values.push(copy_of(p[at + 4 + klen..at + 4 + klen + second], a));
            at += 4 + klen + second;
        } else {
            if at + 6 + klen > PAGE {
                return KvError.Corrupt;
            }
            n.children.push(get32(p, at: at + 2));
            n.keys.push(copy_of(p[at + 6..at + 6 + klen], a));
            at += 6 + klen;
        }
    }
    return n;
}

/// The bytes a node takes as a page.
fn size_of(n: &Node) -> usize {
    var size = HEAD;
    var i: usize = 0;
    while i < n.keys.len() : (i += 1) {
        if n.leaf {
            size += 4 + n.keys.items()[i].len() + n.values.items()[i].len();
        } else {
            size += 6 + n.keys.items()[i].len();
        }
    }
    return size;
}

fn encode(n: &Node, p: []mut u8) {
    var i: usize = 0;
    while i < PAGE : (i += 1) {
        p[i] = 0;
    }
    if n.leaf {
        p[0] = LEAF;
        put32(p, at: 4, v: n.next);
    } else {
        p[0] = INNER;
        put32(p, at: 4, v: n.children.items()[0]);
    }
    put16(p, at: 2, v: n.keys.len());
    var at = HEAD;
    i = 0;
    while i < n.keys.len() : (i += 1) {
        let k = n.keys.items()[i].items();
        put16(p, at: at, v: k.len());
        if n.leaf {
            let v = n.values.items()[i].items();
            put16(p, at: at + 2, v: v.len());
            var j: usize = 0;
            while j < k.len() : (j += 1) {
                p[at + 4 + j] = k[j];
            }
            j = 0;
            while j < v.len() : (j += 1) {
                p[at + 4 + k.len() + j] = v[j];
            }
            at += 4 + k.len() + v.len();
        } else {
            put32(p, at: at + 2, v: n.children.items()[i + 1]);
            var j: usize = 0;
            while j < k.len() : (j += 1) {
                p[at + 6 + j] = k[j];
            }
            at += 6 + k.len();
        }
    }
}

// ---- the store ---------------------------------------------------------------------------

fn wal_path(path: str, a: alloc.Allocator) -> alloc.String {
    var p = alloc.String.from(path, a);
    p.push_str("-wal");
    return p;
}

/// An open store. Page 0 is the header: "ARCHEKV1", the number of pages,
/// the root's page, and the first free page (0 for none; each free page
/// names the next at offset 4).
pub type Db = struct {
    file: std.File,
    wal: std.File,
    /// Every page of the store; one not read from the file yet is empty.
    pages: alloc.List(alloc.List(u8)),
    /// Changed since the last commit, and in the log but not the file.
    dirty: alloc.List(bool),
    logged: alloc.List(bool),
    root: u32,
    free: u32,
    salt: u32,
    frames: u32,
    a: alloc.Allocator,

    /// One page more, not read.
    fn grow(self: &mut Db) {
        self.pages.push(alloc.List(u8).init(self.a));
        self.dirty.push(false);
        self.logged.push(false);
    }

    /// A new page, zero, already counted as changed: a freed one if there
    /// is one, else one more.
    fn new_page(self: &mut Db) -> KvError!u32 {
        if self.free != 0 {
            let n = self.free;
            try self.load(n);
            let p = self.pages.items_mut()[n as usize].items_mut();
            self.free = get32(p, at: 4);
            var i: usize = 0;
            while i < PAGE : (i += 1) {
                p[i] = 0;
            }
            self.dirty.items_mut()[n as usize] = true;
            self.write_header();
            return n;
        }
        self.grow();
        let n = self.pages.len() - 1;
        self.pages.items_mut()[n].grow_zeroed(PAGE);
        self.dirty.items_mut()[n] = true;
        self.write_header();
        return n as u32;
    }

    /// Page n onto the free list.
    fn free_page(self: &mut Db, n: u32) {
        let head = self.free;
        let p = self.pages.items_mut()[n as usize].items_mut();
        var i: usize = 0;
        while i < PAGE : (i += 1) {
            p[i] = 0;
        }
        put32(p, at: 4, v: head);
        self.free = n;
        self.dirty.items_mut()[n as usize] = true;
        self.write_header();
    }

    /// Page n in memory, from the file if it is not yet.
    fn load(self: &mut Db, n: u32) -> KvError!void {
        if self.pages.items()[n as usize].len() == PAGE {
            return;
        }
        var page = alloc.List(u8).with_capacity(self.a, n: PAGE);
        page.grow_zeroed(PAGE);
        let got = self.file.read_at((n as u64) * PAGE as u64, into: page.items_mut()) catch return KvError.Io;
        _ = got;
        self.pages.items_mut()[n as usize] = page;
    }

    fn write_header(self: &mut Db) {
        if self.pages.items()[0].len() != PAGE {
            self.pages.items_mut()[0].grow_zeroed(PAGE);
        }
        let count = self.pages.len() as u32;
        let root = self.root;
        let free = self.free;
        let h = self.pages.items_mut()[0].items_mut();
        put32(h, at: 0, v: 0x48435241);
        put32(h, at: 4, v: 0x3156454B);
        put32(h, at: 8, v: count);
        put32(h, at: 12, v: root);
        put32(h, at: 16, v: free);
        self.dirty.items_mut()[0] = true;
    }

    /// The log's committed transactions, back into the pages.
    fn replay(self: &mut Db) -> KvError!void {
        var head: [16]u8 = [0; 16];
        let got = self.wal.read_at(0, into: head[0..16]) catch return KvError.Io;
        if got < 16 or get32(head[0..16], at: 0) != 0x48435241 or get32(head[0..16], at: 4) != 0x4C415745 {
            // No log yet: one, with salt 1.
            try self.reset_log(salt: 1);
            return;
        }
        self.salt = get32(head[0..16], at: 8);
        region r {
            var frame = alloc.List(u8).with_capacity(r, n: FRAME_HEAD + PAGE);
            frame.grow_zeroed(FRAME_HEAD + PAGE);
            var pending_pages = alloc.List(u32).init(r);
            var pending = alloc.List(alloc.List(u8)).init(r);
            var at: u64 = 16;
            var count: u32 = 0;
            while true {
                let n = self.wal.read_at(at, into: frame.items_mut()) catch return KvError.Io;
                if n < FRAME_HEAD + PAGE {
                    break;
                }
                let f = frame.items();
                let page = get32(f, at: 0);
                let commit = get32(f, at: 4);
                if get32(f, at: 8) != self.salt {
                    break;
                }
                var crc = deflate.crc32(0, data: f[0..12]);
                crc = deflate.crc32(crc, data: f[FRAME_HEAD..FRAME_HEAD + PAGE]);
                if crc != get32(f, at: 12) or page > 1000000 {
                    break;
                }
                pending_pages.push(page);
                pending.push(copy_of(f[FRAME_HEAD..FRAME_HEAD + PAGE], r));
                at += (FRAME_HEAD + PAGE) as u64;
                count += 1;
                if commit != 0 {
                    // A whole transaction: its pages are the store's now.
                    var i: usize = 0;
                    while i < pending.len() : (i += 1) {
                        let pn = pending_pages.items()[i];
                        while self.pages.len() as u32 <= pn {
                            self.grow();
                        }
                        let copy = copy_of(pending.items()[i].items(), self.a);
                        self.pages.items_mut()[pn as usize] = copy;
                        self.logged.items_mut()[pn as usize] = true;
                    }
                    pending.clear();
                    pending_pages.clear();
                    self.frames = count;
                }
            }
        }
    }

    /// An empty log with this salt, on the disk.
    fn reset_log(self: &mut Db, salt: u32) -> KvError!void {
        var head: [16]u8 = [0; 16];
        put32(head[0..16], at: 0, v: 0x48435241);
        put32(head[0..16], at: 4, v: 0x4C415745);
        put32(head[0..16], at: 8, v: salt);
        self.wal.write_at(0, data: head[0..16]) catch return KvError.Io;
        self.wal.truncate(16) catch return KvError.Io;
        self.wal.sync() catch return KvError.Io;
        self.salt = salt;
        self.frames = 0;
    }

    /// Makes the changes since the last commit durable, together.
    pub fn commit(self: &mut Db) -> KvError!void {
        var last = self.pages.len();
        var n: usize = 0;
        var i: usize = 0;
        while i < self.pages.len() : (i += 1) {
            if self.dirty.items()[i] {
                last = i;
                n += 1;
            }
        }
        if n == 0 {
            return;
        }
        region r {
            var out = alloc.List(u8).with_capacity(r, n: n * (FRAME_HEAD + PAGE));
            i = 0;
            while i < self.pages.len() : (i += 1) {
                if not self.dirty.items()[i] {
                    continue;
                }
                var head: [16]u8 = [0; 16];
                put32(head[0..16], at: 0, v: i as u32);
                if i == last {
                    put32(head[0..16], at: 4, v: self.pages.len() as u32);
                }
                put32(head[0..16], at: 8, v: self.salt);
                let page = self.pages.items()[i].items();
                var crc = deflate.crc32(0, data: head[0..12]);
                crc = deflate.crc32(crc, data: page);
                put32(head[0..16], at: 12, v: crc);
                for b in head[0..16] {
                    out.push(b.*);
                }
                for b in page {
                    out.push(b.*);
                }
            }
            let at = 16 + (self.frames as u64) * (FRAME_HEAD + PAGE) as u64;
            self.wal.write_at(at, data: out.items()) catch return KvError.Io;
        }
        self.wal.sync() catch return KvError.Io;
        i = 0;
        while i < self.pages.len() : (i += 1) {
            if self.dirty.items()[i] {
                self.dirty.items_mut()[i] = false;
                self.logged.items_mut()[i] = true;
            }
        }
        self.frames += n as u32;
        if self.frames >= CHECKPOINT_FRAMES {
            try self.checkpoint();
        }
    }

    /// The logged pages into the file, synced, and the log emptied.
    pub fn checkpoint(self: &mut Db) -> KvError!void {
        var i: usize = 0;
        while i < self.pages.len() : (i += 1) {
            if self.logged.items()[i] {
                self.file.write_at((i * PAGE) as u64, data: self.pages.items()[i].items()) catch return KvError.Io;
            }
        }
        self.file.sync() catch return KvError.Io;
        i = 0;
        while i < self.pages.len() : (i += 1) {
            self.logged.items_mut()[i] = false;
        }
        try self.reset_log(salt: self.salt + 1);
    }

    /// How many pages are on the free list.
    pub fn free_count(self: &mut Db) -> KvError!u32 {
        var n: u32 = 0;
        var at = self.free;
        while at != 0 and n <= self.pages.len() as u32 {
            try self.load(at);
            at = get32(self.pages.items()[at as usize].items(), at: 4);
            n += 1;
        }
        return n;
    }

    /// Whether the tree is one leaf: what an empty or a small store is.
    pub fn root_is_leaf(self: &mut Db) -> bool {
        match self.load(self.root) {
            ok(_) => { }
            err(_) => { return false; }
        }
        return self.pages.items()[self.root as usize].items()[0] == LEAF;
    }

    /// How many pages the store has, the header's among them.
    pub fn page_count(self: &Db) -> u32 {
        return self.pages.len() as u32;
    }

    /// Commits, checkpoints and closes the files.
    pub fn close(self: &mut Db) -> KvError!void {
        try self.commit();
        try self.checkpoint();
        self.file.close();
        self.wal.close();
    }

    /// The leaf where key belongs, and the inner pages above it, root first.
    fn path_to(self: &mut Db, key: []u8, path: &mut alloc.List(u32)) -> KvError!u32 {
        var at = self.root;
        while true {
            try self.load(at);
            let p = self.pages.items()[at as usize].items();
            if p[0] == LEAF {
                return at;
            }
            if p[0] != INNER {
                return KvError.Corrupt;
            }
            path.push(at);
            // The child for key: after the last separator at or below it.
            let count = get16(p, at: 2);
            var child = get32(p, at: 4);
            var off = HEAD;
            var i: usize = 0;
            while i < count : (i += 1) {
                let klen = get16(p, at: off);
                if compare(x: p[off + 6..off + 6 + klen], y: key) > 0 {
                    break;
                }
                child = get32(p, at: off + 2);
                off += 6 + klen;
            }
            at = child;
        }
        return at;
    }

    /// The value of key, into value; false when there is none.
    pub fn get(self: &mut Db, key: []u8, value: &mut alloc.List(u8)) -> KvError!bool {
        value.clear();
        region r {
            var path = alloc.List(u32).init(r);
            let leaf = try self.path_to(key, path: &mut path);
            let p = self.pages.items()[leaf as usize].items();
            let count = get16(p, at: 2);
            var off = HEAD;
            var i: usize = 0;
            while i < count : (i += 1) {
                let klen = get16(p, at: off);
                let vlen = get16(p, at: off + 2);
                let c = compare(x: p[off + 4..off + 4 + klen], y: key);
                if c == 0 {
                    for b in p[off + 4 + klen..off + 4 + klen + vlen] {
                        value.push(b.*);
                    }
                    return true;
                }
                if c > 0 {
                    return false;
                }
                off += 4 + klen + vlen;
            }
        }
        return false;
    }

    /// Sets key to value, replacing what it had.
    pub fn put(self: &mut Db, key: []u8, value: []u8) -> KvError!void {
        if key.len() > MAX_KEY or value.len() > MAX_VALUE {
            return KvError.TooLarge;
        }
        region r {
            var path = alloc.List(u32).init(r);
            let leaf_page = try self.path_to(key, path: &mut path);
            var leaf = try decode(self.pages.items()[leaf_page as usize].items(), r);
            var at: usize = 0;
            var same = false;
            while at < leaf.keys.len() {
                let c = compare(x: leaf.keys.items()[at].items(), y: key);
                if c == 0 {
                    same = true;
                    break;
                }
                if c > 0 {
                    break;
                }
                at += 1;
            }
            if same {
                leaf.values.items_mut()[at] = copy_of(value, r);
            } else {
                insert_at(&mut leaf.keys, at: at, item: copy_of(key, r), r);
                insert_at(&mut leaf.values, at: at, item: copy_of(value, r), r);
            }
            try self.store(leaf_page, node: &mut leaf, path: &mut path, r);
        }
    }

    /// Removes key; false when it was not there.
    pub fn delete(self: &mut Db, key: []u8) -> KvError!bool {
        var found = false;
        region r {
            var path = alloc.List(u32).init(r);
            let leaf_page = try self.path_to(key, path: &mut path);
            let leaf = try decode(self.pages.items()[leaf_page as usize].items(), r);
            var kept = empty_node(true, r);
            kept.next = leaf.next;
            var i: usize = 0;
            while i < leaf.keys.len() : (i += 1) {
                if compare(x: leaf.keys.items()[i].items(), y: key) == 0 {
                    found = true;
                    continue;
                }
                kept.keys.push(copy_of(leaf.keys.items()[i].items(), r));
                kept.values.push(copy_of(leaf.values.items()[i].items(), r));
            }
            if found {
                try self.shrink(leaf_page, node: &mut kept, path: &mut path, r);
            }
        }
        return found;
    }

    /// Writes node, smaller now, to page at; merges it with a sibling when
    /// it is under a quarter full and the two fit in one page, and goes on
    /// up to the parent that lost a separator.
    fn shrink(self: &mut Db, at: u32, node: &mut Node, path: &mut alloc.List(u32), r: alloc.Allocator) -> KvError!void {
        encode(node, p: self.pages.items_mut()[at as usize].items_mut());
        self.dirty.items_mut()[at as usize] = true;
        if path.len() == 0 {
            // The root: an inner one with a single child gives way to it.
            if not node.leaf and node.keys.len() == 0 {
                self.root = node.children.items()[0];
                self.free_page(at);
                self.write_header();
            }
            return;
        }
        if size_of(node) >= PAGE / 4 {
            return;
        }
        let parent_page = path.pop() orelse 0;
        var parent = try decode(self.pages.items()[parent_page as usize].items(), r);
        var idx: usize = 0;
        while idx < parent.children.len() and parent.children.items()[idx] != at {
            idx += 1;
        }
        if idx == parent.children.len() {
            return KvError.Corrupt;
        }
        // The pair: this node and the one after it, or the one before.
        var left_idx = idx;
        if idx + 1 >= parent.children.len() {
            if idx == 0 {
                return;
            }
            left_idx = idx - 1;
        }
        let left_page = parent.children.items()[left_idx];
        let right_page = parent.children.items()[left_idx + 1];
        try self.load(left_page);
        try self.load(right_page);
        var left = try decode(self.pages.items()[left_page as usize].items(), r);
        var right = try decode(self.pages.items()[right_page as usize].items(), r);
        let separator = copy_of(parent.keys.items()[left_idx].items(), r);
        var combined = size_of(&left) + size_of(&right) - HEAD;
        if not left.leaf {
            combined += 6 + separator.len();
        }
        if combined > PAGE {
            return;
        }
        if left.leaf {
            append_all(list: &mut left.keys, from: &mut right.keys, r);
            append_all(list: &mut left.values, from: &mut right.values, r);
            left.next = right.next;
        } else {
            left.keys.push(separator);
            append_all(list: &mut left.keys, from: &mut right.keys, r);
            for c in right.children.items() {
                left.children.push(c.*);
            }
        }
        encode(&left, p: self.pages.items_mut()[left_page as usize].items_mut());
        self.dirty.items_mut()[left_page as usize] = true;
        self.free_page(right_page);
        remove_at(&mut parent.keys, at: left_idx, r);
        remove_u32(&mut parent.children, at: left_idx + 1);
        try self.shrink(parent_page, node: &mut parent, path: path, r);
    }

    /// Writes node to page at, splitting it, and its parents as need be.
    fn store(self: &mut Db, at: u32, node: &mut Node, path: &mut alloc.List(u32), r: alloc.Allocator) -> KvError!void {
        if size_of(node) <= PAGE {
            encode(node, p: self.pages.items_mut()[at as usize].items_mut());
            self.dirty.items_mut()[at as usize] = true;
            return;
        }
        // Split where the bytes are half on each side.
        var left = empty_node(node.leaf, r);
        var right = empty_node(node.leaf, r);
        let total = size_of(node);
        var half: usize = HEAD;
        var mid: usize = 0;
        while mid < node.keys.len() - 1 {
            var cell = 6 + node.keys.items()[mid].len();
            if node.leaf {
                cell = 4 + node.keys.items()[mid].len() + node.values.items()[mid].len();
            }
            if half + cell > total / 2 + HEAD and mid > 0 {
                break;
            }
            half += cell;
            mid += 1;
        }
        var separator = alloc.List(u8).init(r);
        let right_page = try self.new_page();
        if node.leaf {
            var i: usize = 0;
            while i < node.keys.len() : (i += 1) {
                if i < mid {
                    left.keys.push(copy_of(node.keys.items()[i].items(), r));
                    left.values.push(copy_of(node.values.items()[i].items(), r));
                } else {
                    right.keys.push(copy_of(node.keys.items()[i].items(), r));
                    right.values.push(copy_of(node.values.items()[i].items(), r));
                }
            }
            right.next = node.next;
            left.next = right_page;
            separator = copy_of(right.keys.items()[0].items(), r);
        } else {
            // The middle key goes up; its children stay on each side.
            left.children.push(node.children.items()[0]);
            var i: usize = 0;
            while i < node.keys.len() : (i += 1) {
                if i < mid {
                    left.keys.push(copy_of(node.keys.items()[i].items(), r));
                    left.children.push(node.children.items()[i + 1]);
                } else if i == mid {
                    separator = copy_of(node.keys.items()[i].items(), r);
                    right.children.push(node.children.items()[i + 1]);
                } else {
                    right.keys.push(copy_of(node.keys.items()[i].items(), r));
                    right.children.push(node.children.items()[i + 1]);
                }
            }
        }
        encode(&left, p: self.pages.items_mut()[at as usize].items_mut());
        self.dirty.items_mut()[at as usize] = true;
        encode(&right, p: self.pages.items_mut()[right_page as usize].items_mut());
        if path.len() == 0 {
            // The root split: a new root above the two.
            let root = try self.new_page();
            var top = empty_node(false, r);
            top.children.push(at);
            top.children.push(right_page);
            top.keys.push(separator);
            encode(&top, p: self.pages.items_mut()[root as usize].items_mut());
            self.root = root;
            self.write_header();
            return;
        }
        let parent_page = path.pop() orelse 0;
        var parent = try decode(self.pages.items()[parent_page as usize].items(), r);
        var k: usize = 0;
        while k < parent.keys.len() and compare(x: parent.keys.items()[k].items(), y: separator.items()) < 0 {
            k += 1;
        }
        insert_at(&mut parent.keys, at: k, item: separator, r);
        insert_u32(&mut parent.children, at: k + 1, item: right_page);
        try self.store(parent_page, node: &mut parent, path: path, r);
    }

    /// The first key above after (or at it, when inclusive) and its value;
    /// false when there is none. Walks the leaves in order.
    pub fn next(self: &mut Db, after: []u8, inclusive: bool, key: &mut alloc.List(u8), value: &mut alloc.List(u8)) -> KvError!bool {
        key.clear();
        value.clear();
        var leaf: u32 = 0;
        region r {
            var path = alloc.List(u32).init(r);
            leaf = try self.path_to(after, path: &mut path);
        }
        while leaf != 0 {
            try self.load(leaf);
            let p = self.pages.items()[leaf as usize].items();
            let count = get16(p, at: 2);
            var off = HEAD;
            var i: usize = 0;
            while i < count : (i += 1) {
                let klen = get16(p, at: off);
                let vlen = get16(p, at: off + 2);
                let c = compare(x: p[off + 4..off + 4 + klen], y: after);
                if c > 0 or (c == 0 and inclusive) {
                    for b in p[off + 4..off + 4 + klen] {
                        key.push(b.*);
                    }
                    for b in p[off + 4 + klen..off + 4 + klen + vlen] {
                        value.push(b.*);
                    }
                    return true;
                }
                off += 4 + klen + vlen;
            }
            leaf = get32(p, at: 4);
        }
        return false;
    }
}

/// item into list at at: the ones after it move up, by being moved out and
/// back, since a list of bytes is not copied.
fn insert_at(list: &mut alloc.List(alloc.List(u8)), at: usize, item: alloc.List(u8), a: alloc.Allocator) {
    var tail = alloc.List(alloc.List(u8)).init(a);
    while list.len() > at {
        match list.pop() {
            some(x) => { tail.push(x); }
            none => { break; }
        }
    }
    list.push(item);
    while tail.len() > 0 {
        match tail.pop() {
            some(x) => { list.push(x); }
            none => { break; }
        }
    }
}

/// Opens the store at path, made when it is not there; the log's committed
/// transactions are replayed and checkpointed first.
pub fn open(fs: &std.Fs, path: str, a: alloc.Allocator) -> KvError!Db {
    let file = fs.open(path, create: true) catch return KvError.Io;
    let wp = wal_path(path, a);
    let wal = fs.open(wp.view(), create: true) catch return KvError.Io;
    var db = Db {
        file: file,
        wal: wal,
        pages: alloc.List(alloc.List(u8)).init(a),
        dirty: alloc.List(bool).init(a),
        logged: alloc.List(bool).init(a),
        root: 1,
        free: 0,
        salt: 1,
        frames: 0,
        a: a,
    };
    let size = db.file.size() catch return KvError.Io;
    var count = (size / PAGE as u64) as u32;
    while (db.pages.len() as u32) < count {
        db.grow();
    }
    try db.replay();
    if db.pages.len() == 0 {
        // A new store: the header, and an empty leaf for the root.
        db.grow();
        db.grow();
        db.pages.items_mut()[1].grow_zeroed(PAGE);
        region r {
            let leaf = empty_node(true, r);
            encode(&leaf, p: db.pages.items_mut()[1].items_mut());
        }
        db.dirty.items_mut()[1] = true;
        db.write_header();
        try db.commit();
    }
    // The header, from the log or the file.
    try db.load(0);
    let h = db.pages.items()[0].items();
    if get32(h, at: 0) != 0x48435241 or get32(h, at: 4) != 0x3156454B {
        return KvError.Corrupt;
    }
    count = get32(h, at: 8);
    db.root = get32(h, at: 12);
    db.free = get32(h, at: 16);
    while (db.pages.len() as u32) < count {
        db.grow();
    }
    if db.frames > 0 {
        try db.checkpoint();
    }
    return db;
}

/// The items of from, in order, moved onto the end of list.
fn append_all(list: &mut alloc.List(alloc.List(u8)), from: &mut alloc.List(alloc.List(u8)), a: alloc.Allocator) {
    var reversed = alloc.List(alloc.List(u8)).init(a);
    while from.len() > 0 {
        match from.pop() {
            some(x) => { reversed.push(x); }
            none => { break; }
        }
    }
    while reversed.len() > 0 {
        match reversed.pop() {
            some(x) => { list.push(x); }
            none => { break; }
        }
    }
}

/// The item at at taken out of list; the ones after it move down.
fn remove_at(list: &mut alloc.List(alloc.List(u8)), at: usize, a: alloc.Allocator) {
    var tail = alloc.List(alloc.List(u8)).init(a);
    while list.len() > at + 1 {
        match list.pop() {
            some(x) => { tail.push(x); }
            none => { break; }
        }
    }
    _ = list.pop();
    while tail.len() > 0 {
        match tail.pop() {
            some(x) => { list.push(x); }
            none => { break; }
        }
    }
}

fn remove_u32(list: &mut alloc.List(u32), at: usize) {
    var i = at;
    while i + 1 < list.len() : (i += 1) {
        let x = list.items()[i + 1];
        list.items_mut()[i] = x;
    }
    _ = list.pop();
}

fn insert_u32(list: &mut alloc.List(u32), at: usize, item: u32) {
    list.push(item);
    var i = list.len() - 1;
    while i > at {
        let x = list.items()[i - 1];
        list.items_mut()[i] = x;
        i -= 1;
    }
    list.items_mut()[at] = item;
}
