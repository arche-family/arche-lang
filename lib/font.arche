/// TrueType fonts (docs/sprints.md S35): the tables a glyph's outline and
/// metrics come from, and a rasterizer that turns an outline into
/// antialiased coverage.
///
/// Everything is integer arithmetic, so a text is drawn the same, bit for
/// bit, on every platform: coordinates are in 1/256 of a pixel, and a
/// pixel's coverage is how much of it 16 rows of samples find inside the
/// outline, each measured exactly along the row. The fill rule is
/// TrueType's: a point is inside when the outline winds around it.
///
/// A font comes from outside, so every read is checked: a font that is
/// cut, or whose tables say what cannot be, gives an error, never a panic
/// (fuzz/font_fuzz.arche). Outlines are TrueType's quadratic ones (glyf),
/// simple and composite; CFF outlines, hinting and kerning are not read.
import alloc;
import core.utf8;

pub type FontError = error {
    /// A table is missing, cut short, or says what cannot be.
    Malformed,
    /// A font, or a table it needs, in a form this reader does not know.
    Unsupported,
}

/// A font: its bytes, copied, and where in them its tables are.
pub type Font = struct {
    data: alloc.List(u8),
    /// Font units in an em: a glyph drawn at size n pixels is this many
    /// units across n pixels.
    pub units_per_em: u32,
    pub glyphs: u32,
    /// Above the baseline, below it (negative), and between lines, in
    /// font units.
    pub ascender: i32,
    pub descender: i32,
    pub line_gap: i32,
    loca: usize,
    loca_long: bool,
    glyf: usize,
    glyf_len: usize,
    hmtx: usize,
    hmetrics: u32,
    cmap: usize,
    cmap_format: u32,
}

/// A glyph drawn: coverage, 0 to 255, a byte a pixel, row by row. left is
/// where its first column is, from the pen, and top where its first row
/// is, from the baseline, down; so a glyph above the baseline has a
/// negative top.
pub type Bitmap = struct {
    pub width: u32,
    pub height: u32,
    pub left: i32,
    pub top: i32,
    pub alpha: alloc.List(u8),
}

/// Coverage that text is drawn into, a byte a pixel, row by row.
pub type Canvas = struct {
    pub width: u32,
    pub height: u32,
    pub alpha: alloc.List(u8),
}

/// A blank canvas.
pub fn new_canvas(width: u32, height: u32, a: alloc.Allocator) -> Canvas {
    var alpha = alloc.List(u8).init(a);
    alpha.grow_zeroed((width as usize) * (height as usize));
    return Canvas { width: width, height: height, alpha: alpha };
}

/// Glyphs drawn before, by glyph and size, so a text draws each once.
pub type Cache = struct {
    index: alloc.Map(u64, u32),
    bitmaps: alloc.List(Bitmap),
}

pub fn new_cache(a: alloc.Allocator) -> Cache {
    return Cache { index: alloc.Map(u64, u32).init(a), bitmaps: alloc.List(Bitmap).init(a) };
}

// ---- reading -----------------------------------------------------------------

fn u8_at(b: []u8, at: usize) -> FontError!u32 {
    if at >= b.len() {
        return FontError.Malformed;
    }
    return b[at] as u32;
}

fn u16_at(b: []u8, at: usize) -> FontError!u32 {
    if at > b.len() or b.len() - at < 2 {
        return FontError.Malformed;
    }
    return ((b[at] as u32) << 8) | (b[at + 1] as u32);
}

fn i16_at(b: []u8, at: usize) -> FontError!i32 {
    let v = try u16_at(b, at: at);
    if v >= 0x8000 {
        return (v as i32) - 0x10000;
    }
    return v as i32;
}

fn u32_at(b: []u8, at: usize) -> FontError!u32 {
    let hi = try u16_at(b, at: at);
    let lo = try u16_at(b, at: at + 2);
    return (hi << 16) | lo;
}

/// Where a table is in the font's bytes.
type Table = struct {
    offset: usize,
    len: usize,
}

fn find_table(b: []u8, tag: str) -> FontError!Table {
    let count = try u16_at(b, at: 4);
    let t = tag.bytes();
    var i: u32 = 0;
    while i < count : (i += 1) {
        let rec = 12 + (i as usize) * 16;
        if rec + 16 > b.len() {
            return FontError.Malformed;
        }
        if b[rec] == t[0] and b[rec + 1] == t[1] and b[rec + 2] == t[2] and b[rec + 3] == t[3] {
            let off = (try u32_at(b, at: rec + 8)) as usize;
            let len = (try u32_at(b, at: rec + 12)) as usize;
            if off > b.len() or b.len() - off < len {
                return FontError.Malformed;
            }
            return Table { offset: off, len: len };
        }
    }
    return FontError.Malformed;
}

/// The cmap subtable code points are looked up in: its offset and format.
type Mapping = struct {
    offset: usize,
    format: u32,
}

/// The best Unicode subtable: format 12 (all of Unicode) before format 4
/// (the first 65536 code points).
fn choose_cmap(b: []u8, cmap: Table) -> FontError!Mapping {
    let n = try u16_at(b, at: cmap.offset + 2);
    var best = Mapping { offset: 0, format: 0 };
    var best_rank: u32 = 0;
    var i: u32 = 0;
    while i < n : (i += 1) {
        let rec = cmap.offset + 4 + (i as usize) * 8;
        let platform = try u16_at(b, at: rec);
        let encoding = try u16_at(b, at: rec + 2);
        let off = (try u32_at(b, at: rec + 4)) as usize;
        if off >= cmap.len {
            continue;
        }
        let sub = cmap.offset + off;
        let format = try u16_at(b, at: sub);
        var rank: u32 = 0;
        let unicode = platform == 0 or (platform == 3 and (encoding == 1 or encoding == 10));
        if unicode and format == 12 {
            rank = 2;
        } else if unicode and format == 4 {
            rank = 1;
        }
        if rank > best_rank {
            best_rank = rank;
            best = Mapping { offset: sub, format: format };
        }
    }
    if best_rank == 0 {
        return FontError.Unsupported;
    }
    return best;
}

/// The font in bytes: its tables found and checked enough that drawing
/// never reads outside them.
pub fn parse(bytes: []u8, a: alloc.Allocator) -> FontError!Font {
    let version = try u32_at(bytes, at: 0);
    if version != 0x00010000 and version != 0x74727565 {
        return FontError.Unsupported;
    }
    let head = try find_table(bytes, tag: "head");
    if head.len < 54 {
        return FontError.Malformed;
    }
    let upem = try u16_at(bytes, at: head.offset + 18);
    if upem < 16 or upem > 16384 {
        return FontError.Malformed;
    }
    let loc_format = try i16_at(bytes, at: head.offset + 50);
    if loc_format != 0 and loc_format != 1 {
        return FontError.Malformed;
    }
    let maxp = try find_table(bytes, tag: "maxp");
    if maxp.len < 6 {
        return FontError.Malformed;
    }
    let count = try u16_at(bytes, at: maxp.offset + 4);
    if count == 0 {
        return FontError.Malformed;
    }
    let hhea = try find_table(bytes, tag: "hhea");
    if hhea.len < 36 {
        return FontError.Malformed;
    }
    let hmetrics = try u16_at(bytes, at: hhea.offset + 34);
    if hmetrics == 0 or hmetrics > count {
        return FontError.Malformed;
    }
    let hmtx = try find_table(bytes, tag: "hmtx");
    if hmtx.len < (hmetrics as usize) * 4 + ((count - hmetrics) as usize) * 2 {
        return FontError.Malformed;
    }
    let loca = try find_table(bytes, tag: "loca");
    var entry: usize = 2;
    if loc_format == 1 {
        entry = 4;
    }
    if loca.len < ((count as usize) + 1) * entry {
        return FontError.Malformed;
    }
    let glyf = find_table(bytes, tag: "glyf") catch return FontError.Unsupported;
    let cmap = try find_table(bytes, tag: "cmap");
    let m = try choose_cmap(bytes, cmap: cmap);
    var data = alloc.List(u8).with_capacity(a, bytes.len());
    for x in bytes {
        data.push(x.*);
    }
    return Font {
        data: data,
        units_per_em: upem,
        glyphs: count,
        ascender: try i16_at(bytes, at: hhea.offset + 4),
        descender: try i16_at(bytes, at: hhea.offset + 6),
        line_gap: try i16_at(bytes, at: hhea.offset + 8),
        loca: loca.offset,
        loca_long: loc_format == 1,
        glyf: glyf.offset,
        glyf_len: glyf.len,
        hmtx: hmtx.offset,
        hmetrics: hmetrics,
        cmap: m.offset,
        cmap_format: m.format,
    };
}

// ---- code points and metrics -------------------------------------------------------

/// The glyph of code point cp; 0, the font's .notdef, when it has none.
pub fn glyph_of(f: &Font, cp: u32) -> u32 {
    match lookup(f, cp: cp) {
        ok(g) => {
            if g >= f.glyphs {
                return 0;
            }
            return g;
        }
        err(_) => { return 0; }
    }
}

fn lookup(f: &Font, cp: u32) -> FontError!u32 {
    let b = f.data.items();
    let sub = f.cmap;
    if f.cmap_format == 12 {
        let n = try u32_at(b, at: sub + 12);
        var lo: u32 = 0;
        var hi = n;
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            let at = sub + 16 + (mid as usize) * 12;
            let first = try u32_at(b, at: at);
            let last = try u32_at(b, at: at + 4);
            if cp < first {
                hi = mid;
            } else if cp > last {
                lo = mid + 1;
            } else {
                let start = try u32_at(b, at: at + 8);
                return start + (cp - first);
            }
        }
        return 0;
    }
    if cp > 0xFFFF {
        return 0;
    }
    let seg2 = (try u16_at(b, at: sub + 6)) as usize;
    let ends = sub + 14;
    let starts = ends + seg2 + 2;
    let deltas = starts + seg2;
    let ranges = deltas + seg2;
    var s: usize = 0;
    while s < seg2 : (s += 2) {
        let last = try u16_at(b, at: ends + s);
        if cp <= last {
            let first = try u16_at(b, at: starts + s);
            if cp < first {
                return 0;
            }
            let delta = try u16_at(b, at: deltas + s);
            let ro = (try u16_at(b, at: ranges + s)) as usize;
            if ro == 0 {
                return (cp + delta) & 0xFFFF;
            }
            let g = try u16_at(b, at: ranges + s + ro + 2 * ((cp - first) as usize));
            if g == 0 {
                return 0;
            }
            return (g + delta) & 0xFFFF;
        }
    }
    return 0;
}

/// How far glyph g moves the pen, in font units.
pub fn advance(f: &Font, g: u32) -> i32 {
    var i = g;
    if i >= f.hmetrics {
        i = f.hmetrics - 1;
    }
    let v = u16_at(f.data.items(), at: f.hmtx + (i as usize) * 4) catch return 0;
    return v as i32;
}

/// A length in font units, at size pixels to the em, in 1/256 of a pixel.
fn scale(f: &Font, v: i64, size: u32) -> i64 {
    return round_div(n: v * (size as i64) * 256, d: f.units_per_em as i64);
}

/// n / d to the nearest integer, halves away from zero; d > 0.
fn round_div(n: i64, d: i64) -> i64 {
    if n >= 0 {
        return (n + d / 2) / d;
    }
    return -((d / 2 - n) / d);
}

/// The distance between baselines, at size pixels to the em, in pixels.
pub fn line_height(f: &Font, size: u32) -> i32 {
    let units = (f.ascender - f.descender + f.line_gap) as i64;
    return ((scale(f, units, size: size) + 255) / 256) as i32;
}

/// The ascender at size, in pixels, rounded up: where the first baseline
/// goes below the top of a line.
pub fn ascent(f: &Font, size: u32) -> i32 {
    return ((scale(f, f.ascender as i64, size: size) + 255) / 256) as i32;
}

/// How wide text is at size, in pixels, rounded up.
pub fn width_of(f: &Font, text: str, size: u32) -> i32 {
    let b = text.bytes();
    var pen: i64 = 0;
    var at: usize = 0;
    while at < b.len() {
        var cp: u32 = 0xFFFD;
        var len: usize = 1;
        match utf8.decode(b, at) {
            some(d) => {
                cp = d.code;
                len = d.len;
            }
            none => { }
        }
        pen += scale(f, advance(f, g: glyph_of(f, cp: cp)) as i64, size: size);
        at += len;
    }
    return ((pen + 255) / 256) as i32;
}

// ---- outlines ----------------------------------------------------------------------

/// A point of an outline, in font units; on the curve, or a quadratic
/// curve's control point.
type Point = struct {
    x: i32,
    y: i32,
    on: bool,
}

type Outline = struct {
    points: alloc.List(Point),
    /// Where each contour ends: one past its last point.
    ends: alloc.List(u32),
}

fn outline(a: alloc.Allocator) -> Outline {
    return Outline { points: alloc.List(Point).init(a), ends: alloc.List(u32).init(a) };
}

/// Glyph g's bytes in glyf.
fn glyph_range(f: &Font, g: u32) -> FontError!Table {
    if g >= f.glyphs {
        return FontError.Malformed;
    }
    let b = f.data.items();
    var start: usize = 0;
    var end: usize = 0;
    if f.loca_long {
        start = (try u32_at(b, at: f.loca + (g as usize) * 4)) as usize;
        end = (try u32_at(b, at: f.loca + (g as usize) * 4 + 4)) as usize;
    } else {
        start = (try u16_at(b, at: f.loca + (g as usize) * 2)) as usize * 2;
        end = (try u16_at(b, at: f.loca + (g as usize) * 2 + 2)) as usize * 2;
    }
    if end < start or end > f.glyf_len {
        return FontError.Malformed;
    }
    return Table { offset: f.glyf + start, len: end - start };
}

/// Most points an outline may have: more is a font that lies.
const MAX_POINTS: usize = 0x10000;

/// Glyph g's outline, added to out; composites through components, at
/// most 8 deep.
fn load(f: &Font, g: u32, depth: u32, out: &mut Outline, a: alloc.Allocator) -> FontError!void {
    if depth > 8 {
        return FontError.Malformed;
    }
    let r = try glyph_range(f, g: g);
    if r.len == 0 {
        return; // no outline: a space
    }
    let all = f.data.items();
    let b = all[r.offset..r.offset + r.len];
    let contours = try i16_at(b, at: 0);
    if contours >= 0 {
        try load_simple(b, contours: contours as u32, out: out, a: a);
        return;
    }
    try load_composite(f, b, depth: depth, out: out, a: a);
}

fn load_simple(b: []u8, contours: u32, out: &mut Outline, a: alloc.Allocator) -> FontError!void {
    let base = out.points.len();
    var count: usize = 0;
    var c: u32 = 0;
    while c < contours : (c += 1) {
        let end = (try u16_at(b, at: 10 + (c as usize) * 2)) as usize + 1;
        if end <= count and c > 0 {
            return FontError.Malformed;
        }
        count = end;
    }
    if base + count > MAX_POINTS {
        return FontError.Malformed;
    }
    let instructions = (try u16_at(b, at: 10 + (contours as usize) * 2)) as usize;
    var at = 10 + (contours as usize) * 2 + 2 + instructions;
    var flags = alloc.List(u8).with_capacity(a, count);
    while flags.len() < count {
        let fl = (try u8_at(b, at: at)) as u8;
        at += 1;
        flags.push(fl);
        if (fl & 8) != 0 {
            var repeat = try u8_at(b, at: at);
            at += 1;
            while repeat > 0 and flags.len() < count : (repeat -= 1) {
                flags.push(fl);
            }
        }
    }
    let fs = flags.items();
    var xs = alloc.List(i32).with_capacity(a, count);
    var x: i32 = 0;
    for fl in fs {
        if (fl.* & 2) != 0 {
            let d = (try u8_at(b, at: at)) as i32;
            at += 1;
            if (fl.* & 16) != 0 {
                x += d;
            } else {
                x -= d;
            }
        } else if (fl.* & 16) == 0 {
            x += try i16_at(b, at: at);
            at += 2;
        }
        xs.push(x);
    }
    var y: i32 = 0;
    var i: usize = 0;
    for fl in fs {
        if (fl.* & 4) != 0 {
            let d = (try u8_at(b, at: at)) as i32;
            at += 1;
            if (fl.* & 32) != 0 {
                y += d;
            } else {
                y -= d;
            }
        } else if (fl.* & 32) == 0 {
            y += try i16_at(b, at: at);
            at += 2;
        }
        out.points.push(Point { x: xs.items()[i], y: y, on: (fl.* & 1) != 0 });
        i += 1;
    }
    c = 0;
    while c < contours : (c += 1) {
        let end = (try u16_at(b, at: 10 + (c as usize) * 2)) as usize + 1;
        out.ends.push((base + end) as u32);
    }
}

/// A component's transform: a 2x2 matrix in F2Dot14 and an offset in font
/// units.
type Transform = struct {
    xx: i64,
    yx: i64,
    xy: i64,
    yy: i64,
    dx: i64,
    dy: i64,
}

fn apply(t: Transform, p: Point) -> Point {
    let x = round_div(n: t.xx * (p.x as i64) + t.xy * (p.y as i64), d: 16384) + t.dx;
    let y = round_div(n: t.yx * (p.x as i64) + t.yy * (p.y as i64), d: 16384) + t.dy;
    return Point { x: x as i32, y: y as i32, on: p.on };
}

fn load_composite(f: &Font, b: []u8, depth: u32, out: &mut Outline, a: alloc.Allocator) -> FontError!void {
    let base = out.points.len();
    var at: usize = 10;
    while true {
        let flags = try u16_at(b, at: at);
        let component = try u16_at(b, at: at + 2);
        at += 4;
        var arg1: i32 = 0;
        var arg2: i32 = 0;
        if (flags & 1) != 0 {
            arg1 = try i16_at(b, at: at);
            arg2 = try i16_at(b, at: at + 2);
            at += 4;
        } else {
            arg1 = (try u8_at(b, at: at)) as i32;
            arg2 = (try u8_at(b, at: at + 1)) as i32;
            if (flags & 2) != 0 {
                // Offsets, signed; else point numbers.
                if arg1 >= 128 {
                    arg1 -= 256;
                }
                if arg2 >= 128 {
                    arg2 -= 256;
                }
            }
            at += 2;
        }
        var t = Transform { xx: 16384, yx: 0, xy: 0, yy: 16384, dx: 0, dy: 0 };
        if (flags & 8) != 0 {
            let s = (try i16_at(b, at: at)) as i64;
            t.xx = s;
            t.yy = s;
            at += 2;
        } else if (flags & 0x40) != 0 {
            t.xx = (try i16_at(b, at: at)) as i64;
            t.yy = (try i16_at(b, at: at + 2)) as i64;
            at += 4;
        } else if (flags & 0x80) != 0 {
            t.xx = (try i16_at(b, at: at)) as i64;
            t.yx = (try i16_at(b, at: at + 2)) as i64;
            t.xy = (try i16_at(b, at: at + 4)) as i64;
            t.yy = (try i16_at(b, at: at + 6)) as i64;
            at += 8;
        }
        var part = outline(a);
        try load(f, g: component, depth: depth + 1, out: &mut part, a: a);
        if (flags & 2) != 0 {
            t.dx = arg1 as i64;
            t.dy = arg2 as i64;
        } else {
            // The component moves so that its point arg2 lies on the
            // glyph's point arg1, both counted from the composite's start.
            let mine = base + (arg1 as usize);
            let theirs = arg2 as usize;
            if mine >= out.points.len() or theirs >= part.points.len() {
                return FontError.Malformed;
            }
            let p = out.points.items()[mine];
            let q = apply(t, p: part.points.items()[theirs]);
            t.dx = (p.x - q.x) as i64;
            t.dy = (p.y - q.y) as i64;
        }
        let first = out.points.len();
        if first + part.points.len() > MAX_POINTS {
            return FontError.Malformed;
        }
        for p in part.points.items() {
            out.points.push(apply(t, p: p.*));
        }
        for e in part.ends.items() {
            out.ends.push(e.* + first as u32);
        }
        if (flags & 0x20) == 0 {
            break;
        }
    }
}

// ---- rasterizing --------------------------------------------------------------

/// A line of an outline, in 1/256 of a pixel, y down.
type Edge = struct {
    x0: i64,
    y0: i64,
    x1: i64,
    y1: i64,
}

/// Where a row of samples crosses an edge, and which way the edge goes.
type Crossing = struct {
    x: i64,
    wind: i32,
}

fn line_to(edges: &mut alloc.List(Edge), x0: i64, y0: i64, x1: i64, y1: i64) {
    if y0 != y1 {
        edges.push(Edge { x0: x0, y0: y0, x1: x1, y1: y1 });
    }
}

fn isqrt(n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    var r: i64 = 0;
    var bit: i64 = 1 << 62;
    var m = n;
    while bit > m {
        bit = bit >> 2;
    }
    while bit != 0 {
        if m >= r + bit {
            m -= r + bit;
            r = (r >> 1) + bit;
        } else {
            r = r >> 1;
        }
        bit = bit >> 2;
    }
    return r;
}

/// A quadratic curve as lines: more of them the more it bends.
fn quad_to(edges: &mut alloc.List(Edge), p0: [2]i64, p1: [2]i64, p2: [2]i64) {
    var bend_x = p0[0] - 2 * p1[0] + p2[0];
    var bend_y = p0[1] - 2 * p1[1] + p2[1];
    if bend_x < 0 {
        bend_x = -bend_x;
    }
    if bend_y < 0 {
        bend_y = -bend_y;
    }
    // A tenth of a pixel off at most: the curve leaves a chord by a
    // quarter of its bend, divided by the square of the pieces.
    var n = 1 + isqrt((bend_x + bend_y) * 10 / 1024);
    if n > 64 {
        n = 64;
    }
    var px = p0[0];
    var py = p0[1];
    var k: i64 = 1;
    while k <= n : (k += 1) {
        let u = n - k;
        let x = round_div(n: u * u * p0[0] + 2 * k * u * p1[0] + k * k * p2[0], d: n * n);
        let y = round_div(n: u * u * p0[1] + 2 * k * u * p1[1] + k * k * p2[1], d: n * n);
        line_to(edges, x0: px, y0: py, x1: x, y1: y);
        px = x;
        py = y;
    }
}

/// A point scaled, in 1/256 of a pixel, y down.
type Scaled = struct {
    at: [2]i64,
    on: bool,
}

/// The outline's contours as edges, scaled to size and flipped, y down.
fn edges_of(f: &Font, o: &Outline, size: u32, a: alloc.Allocator) -> alloc.List(Edge) {
    var edges = alloc.List(Edge).init(a);
    let pts = o.points.items();
    var start: usize = 0;
    for e in o.ends.items() {
        let end = e.* as usize;
        if end > pts.len() or end <= start {
            start = end;
            continue;
        }
        let n = end - start;
        // Scaled points, y down.
        var sp = alloc.List(Scaled).with_capacity(a, n);
        var i: usize = 0;
        while i < n : (i += 1) {
            let p = pts[start + i];
            sp.push(Scaled { at: [scale(f, p.x as i64, size: size), -scale(f, p.y as i64, size: size)], on: p.on });
        }
        let sps = sp.items();
        // Begin on a point on the curve; when the contour has none, between
        // its first two points, which are both control points then.
        var first = n;
        i = 0;
        while i < n and first == n : (i += 1) {
            if sps[i].on {
                first = i;
            }
        }
        var begin: [2]i64 = [0, 0];
        if first == n {
            begin = [(sps[0].at[0] + sps[1 % n].at[0]) / 2, (sps[0].at[1] + sps[1 % n].at[1]) / 2];
            first = 0;
        } else {
            begin = sps[first].at;
        }
        var cur = begin;
        var control: [2]i64 = [0, 0];
        var pending = false;
        // Every point after the first, then the first again.
        var k: usize = 1;
        while k <= n : (k += 1) {
            let j = (first + k) % n;
            let p = sps[j].at;
            if sps[j].on {
                if pending {
                    quad_to(&mut edges, p0: cur, p1: control, p2: p);
                } else {
                    line_to(&mut edges, x0: cur[0], y0: cur[1], x1: p[0], y1: p[1]);
                }
                cur = p;
                pending = false;
            } else if pending {
                // Two control points in a row: a point on the curve
                // halfway between them.
                let mid: [2]i64 = [(control[0] + p[0]) / 2, (control[1] + p[1]) / 2];
                quad_to(&mut edges, p0: cur, p1: control, p2: mid);
                cur = mid;
                control = p;
            } else {
                control = p;
                pending = true;
            }
        }
        if pending {
            quad_to(&mut edges, p0: cur, p1: control, p2: begin);
        } else if cur[0] != begin[0] or cur[1] != begin[1] {
            line_to(&mut edges, x0: cur[0], y0: cur[1], x1: begin[0], y1: begin[1]);
        }
        start = end;
    }
    return edges;
}

/// Rows of samples a pixel has.
const SAMPLES: i64 = 16;

/// Coverage of each pixel of a width x height box, from edges placed in it.
fn fill(edges: []Edge, width: u32, height: u32, out: &mut alloc.List(u8), a: alloc.Allocator) {
    let w = width as usize;
    out.grow_zeroed(w * (height as usize));
    var acc = alloc.List(i64).init(a);
    acc.grow_zeroed(w);
    var crossings = alloc.List(Crossing).init(a);
    var row: usize = 0;
    while row < height as usize : (row += 1) {
        for v in acc.items_mut() {
            v.* = 0;
        }
        var s: i64 = 0;
        while s < SAMPLES : (s += 1) {
            let ys = (row as i64) * 256 + s * (256 / SAMPLES) + 256 / SAMPLES / 2;
            crossings.clear();
            for e in edges {
                var top = e.y0;
                var bottom = e.y1;
                var wind: i32 = 1;
                if e.y1 < e.y0 {
                    top = e.y1;
                    bottom = e.y0;
                    wind = -1;
                }
                if ys >= top and ys < bottom {
                    let x = e.x0 + (ys - e.y0) * (e.x1 - e.x0) / (e.y1 - e.y0);
                    crossings.push(Crossing { x: x, wind: wind });
                }
            }
            // In order along the row; few, so by insertion.
            let cs = crossings.items_mut();
            var i: usize = 1;
            while i < cs.len() : (i += 1) {
                let c = cs[i];
                var j = i;
                while j > 0 and cs[j - 1].x > c.x : (j -= 1) {
                    cs[j] = cs[j - 1];
                }
                cs[j] = c;
            }
            var wind: i32 = 0;
            var from: i64 = 0;
            for c in crossings.items() {
                let before = wind;
                wind += c.wind;
                if before == 0 and wind != 0 {
                    from = c.x;
                } else if before != 0 and wind == 0 {
                    span(acc.items_mut(), from: from, to: c.x);
                }
            }
        }
        let base = row * w;
        var x: usize = 0;
        while x < w : (x += 1) {
            var v = (acc.items()[x] * 255 + 2048) / 4096;
            if v > 255 {
                v = 255;
            }
            out.items_mut()[base + x] = v as u8;
        }
    }
}

/// A row of samples inside the outline from from to to: each pixel it
/// touches gets how much of its width that is, 256 for all of it.
fn span(acc: []mut i64, from: i64, to: i64) {
    let limit = (acc.len() as i64) * 256;
    var a0 = from;
    var b0 = to;
    if a0 < 0 {
        a0 = 0;
    }
    if b0 > limit {
        b0 = limit;
    }
    if a0 >= b0 {
        return;
    }
    let pa = a0 / 256;
    let pb = b0 / 256;
    if pa == pb {
        acc[pa as usize] += b0 - a0;
        return;
    }
    acc[pa as usize] += (pa + 1) * 256 - a0;
    var p = pa + 1;
    while p < pb : (p += 1) {
        acc[p as usize] += 256;
    }
    if pb < acc.len() as i64 {
        acc[pb as usize] += b0 - pb * 256;
    }
}

/// Glyph g drawn at size pixels to the em.
pub fn render(f: &Font, g: u32, size: u32, a: alloc.Allocator) -> FontError!Bitmap {
    if size == 0 or size > 2048 {
        return FontError.Unsupported;
    }
    var o = outline(a);
    try load(f, g: g, depth: 0, out: &mut o, a: a);
    var edges = edges_of(f, o: &o, size: size, a: a);
    if edges.len() == 0 {
        return Bitmap { width: 0, height: 0, left: 0, top: 0, alpha: alloc.List(u8).init(a) };
    }
    var min_x = edges.items()[0].x0;
    var max_x = min_x;
    var min_y = edges.items()[0].y0;
    var max_y = min_y;
    for e in edges.items() {
        min_x = least(x: least(x: min_x, y: e.x0), y: e.x1);
        max_x = most(x: most(x: max_x, y: e.x0), y: e.x1);
        min_y = least(x: least(x: min_y, y: e.y0), y: e.y1);
        max_y = most(x: most(x: max_y, y: e.y0), y: e.y1);
    }
    let left = floor_div(n: min_x, d: 256);
    let top = floor_div(n: min_y, d: 256);
    let right = floor_div(n: max_x + 255, d: 256);
    let bottom = floor_div(n: max_y + 255, d: 256);
    let width = right - left;
    let height = bottom - top;
    if width <= 0 or height <= 0 or width > 4096 or height > 4096 {
        return Bitmap { width: 0, height: 0, left: 0, top: 0, alpha: alloc.List(u8).init(a) };
    }
    for e in edges.items_mut() {
        e.x0 -= left * 256;
        e.x1 -= left * 256;
        e.y0 -= top * 256;
        e.y1 -= top * 256;
    }
    var alpha = alloc.List(u8).init(a);
    fill(edges.items(), width: width as u32, height: height as u32, out: &mut alpha, a: a);
    return Bitmap { width: width as u32, height: height as u32, left: left as i32, top: top as i32, alpha: alpha };
}

fn least(x: i64, y: i64) -> i64 {
    if x < y {
        return x;
    }
    return y;
}

fn most(x: i64, y: i64) -> i64 {
    if x > y {
        return x;
    }
    return y;
}

fn floor_div(n: i64, d: i64) -> i64 {
    if n >= 0 {
        return n / d;
    }
    return -((d - 1 - n) / d);
}

// ---- text --------------------------------------------------------------------------

/// Glyph g at size, from the cache, drawn the first time it is asked for:
/// its number in the cache.
fn cached(f: &Font, c: &mut Cache, g: u32, size: u32, a: alloc.Allocator) -> FontError!u32 {
    let key = ((g as u64) << 16) | (size as u64);
    match c.index.get(key) {
        some(i) => { return i; }
        none => { }
    }
    let b = try render(f, g: g, size: size, a: a);
    let i = c.bitmaps.len() as u32;
    c.bitmaps.push(b);
    c.index.put(key, i);
    return i;
}

/// Coverage v over what is there: as glass over glass, so overlapping
/// glyphs do not add up past full.
fn over(dst: u8, src: u8) -> u8 {
    let d = dst as u32;
    let s = src as u32;
    return (s + d - (s * d + 127) / 255) as u8;
}

/// Draws text at size into c, its baseline at y, from x; text that is not
/// UTF-8 draws U+FFFD where it is not. Where the pen ends, in pixels.
pub fn draw(f: &Font, cache: &mut Cache, text: str, size: u32, x: i32, y: i32, into: &mut Canvas, a: alloc.Allocator) -> FontError!i32 {
    let b = text.bytes();
    var pen = (x as i64) * 256;
    var at: usize = 0;
    while at < b.len() {
        var cp: u32 = 0xFFFD;
        var len: usize = 1;
        match utf8.decode(b, at) {
            some(d) => {
                cp = d.code;
                len = d.len;
            }
            none => { }
        }
        at += len;
        let g = glyph_of(f, cp: cp);
        let i = try cached(f, c: cache, g: g, size: size, a: a);
        let gx = round_div(n: pen, d: 256) as i32;
        blit(&cache.bitmaps.items()[i as usize], x: gx, y: y, into: into);
        pen += scale(f, advance(f, g: g) as i64, size: size);
    }
    return round_div(n: pen, d: 256) as i32;
}

/// A glyph's coverage onto the canvas, its pen at (x, y), clipped.
fn blit(g: &Bitmap, x: i32, y: i32, into: &mut Canvas) {
    let src = g.alpha.items();
    var row: i32 = 0;
    while row < g.height as i32 : (row += 1) {
        let cy = y + g.top + row;
        if cy < 0 or cy >= into.height as i32 {
            continue;
        }
        var col: i32 = 0;
        while col < g.width as i32 : (col += 1) {
            let cx = x + g.left + col;
            if cx < 0 or cx >= into.width as i32 {
                continue;
            }
            let s = src[(row as usize) * (g.width as usize) + col as usize];
            if s != 0 {
                let at = (cy as usize) * (into.width as usize) + cx as usize;
                let dst = into.alpha.items()[at];
                into.alpha.items_mut()[at] = over(dst: dst, src: s);
            }
        }
    }
}
