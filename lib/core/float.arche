/// A float and its bits: IEEE 754's encoding, every bit kept, a NaN's payload
/// too (spec/arche.md §2.3). The compiler provides these functions itself,
/// which is why they have no bodies. Every pattern of bits is some float, so
/// none of them is unsafe or can fail.

/// The encoding of an f64.
pub fn bits64(x: f64) -> u64;

/// The encoding of an f32.
pub fn bits32(x: f32) -> u32;

/// The f64 whose encoding is bits.
pub fn from_bits64(bits: u64) -> f64;

/// The f32 whose encoding is bits.
pub fn from_bits32(bits: u32) -> f32;
