/// Repeatable randomness (docs/plan.md, determinism): the same seed gives
/// the same numbers on every run and target. xoshiro256**, seeded with
/// splitmix64. For the kernel's randomness, std.Rand.

pub type Seeded = struct {
    s0: u64,
    s1: u64,
    s2: u64,
    s3: u64,

    pub fn init(seed: u64) -> Seeded {
        var x = seed;
        let a = splitmix(&mut x);
        let b = splitmix(&mut x);
        let c = splitmix(&mut x);
        let d = splitmix(&mut x);
        return Seeded { s0: a, s1: b, s2: c, s3: d };
    }

    pub fn next_u64(self: &mut Seeded) -> u64 {
        let result = rotl(self.s1 *% 5, k: 7) *% 9;
        let t = self.s1 << 17;
        self.s2 = self.s2 ^ self.s0;
        self.s3 = self.s3 ^ self.s1;
        self.s1 = self.s1 ^ self.s2;
        self.s0 = self.s0 ^ self.s3;
        self.s2 = self.s2 ^ t;
        self.s3 = rotl(self.s3, k: 45);
        return result;
    }

    /// A number in 0..n, each as likely, for n > 0: rejection, not modulo.
    pub fn below(self: &mut Seeded, n: u64) -> u64 {
        if n == 0 {
            panic("below(0) has no number to give");
        }
        let limit = 18446744073709551615 - (18446744073709551615 % n);
        while true {
            let v = self.next_u64();
            if v < limit {
                return v % n;
            }
        }
        return 0;
    }

    /// A number in lo..=hi.
    pub fn between(self: &mut Seeded, lo: i64, hi: i64) -> i64 {
        if hi < lo {
            panic("between needs lo <= hi");
        }
        let span = (hi -% lo) as% u64;
        if span == 18446744073709551615 {
            return self.next_u64() as% i64;
        }
        return lo +% self.below(span + 1) as% i64;
    }

    pub fn chance(self: &mut Seeded, percent: u32) -> bool {
        return self.below(100) < percent as u64;
    }
}

fn splitmix(x: &mut u64) -> u64 {
    x.* = x.* +% 0x9E3779B97F4A7C15;
    var z = x.*;
    z = (z ^ (z >> 30)) *% 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) *% 0x94D049BB133111EB;
    return z ^ (z >> 31);
}

fn rotl(x: u64, k: u32) -> u64 {
    return (x << k) | (x >> (64 - k));
}
