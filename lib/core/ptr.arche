/// Raw pointers from and to addresses (spec/arche.md §10.1, §10.2). The
/// compiler provides these functions. Pointers also have methods: p.add(n),
/// p.as_ref(), p.as_mut(), p.read_volatile(), p.write_volatile(v) and
/// p.addr().

/// The pointer to address addr: memory-mapped registers, firmware tables.
pub unsafe fn from_addr(comptime T: type, addr: usize) -> *mut T;
