/// std for a component's program (wasm32-component, docs/sprints.md S38):
/// no operating system, only the host its world gives. It holds the
/// runtime (std.wasi_rt, whose WASI calls the compiler's backend refuses
/// here) and the exports a component's world calls: init makes the app's
/// state with the root module's init and keeps it, update gives it to the
/// root module's update. The world's bindings import std, so that a
/// program built on them has these.
import core;
import core.ptr;
import std.wasi_rt as rt;

/// The compiler's: the root module's init and update, called with the
/// host's address, and the state's (compiler/lower/lower.arche).
extern "c" fn a0_component_init(host: *mut u8) -> u64;
extern "c" fn a0_component_update(made: u64, host: *mut u8);

/// The host a world's functions are reached through: nothing but a token
/// that a program holds, for the bindings' functions to take.
pub type Host = struct {
    unique: core.Unique,
}

export("init") fn init() {
    rt.start();
    let host = rt.take_zeroed(16);
    var made: u64 = 0;
    unsafe {
        // SAFETY: memory just taken for the host, which lasts the run.
        made = a0_component_init(ptr.from_addr(u8, host as usize) as *mut u8);
    }
    rt.keep_app(made: made, host: host);
}

/// The canonical ABI's allocator: memory for what the host gives the
/// program, a string or a list, in the program's own memory, which lasts
/// the run as the program's allocator's does. A grown block keeps what
/// was in it. align is at most 16, which every block has.
export("cabi_realloc") fn cabi_realloc(old: u32, old_size: u32, align: u32, new_size: u32) -> u32 {
    if new_size == 0 {
        return align;
    }
    let at = rt.take_zeroed(new_size as u64);
    var keep = old_size;
    if keep > new_size {
        keep = new_size;
    }
    if old != 0 and keep > 0 {
        unsafe {
            // SAFETY: old is a block this function gave, old_size long, and
            // at a new one, new_size long; they do not overlap.
            let from = ptr.from_addr(u8, old as usize);
            let to = ptr.from_addr(u8, at as usize) as *mut u8;
            var i: usize = 0;
            while i < keep as usize : (i += 1) {
                to.add(i).* = from.add(i).*;
            }
        }
    }
    return at as u32;
}

export("update") fn update() {
    unsafe {
        // SAFETY: what init kept.
        a0_component_update(rt.app_state(), ptr.from_addr(u8, rt.app_host() as usize) as *mut u8);
    }
}
