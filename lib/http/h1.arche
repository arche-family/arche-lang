/// HTTP/1.1 (RFC 9112) without I/O: finding and parsing a message's head,
/// the rules for its body (length, chunked, or until the close), the
/// chunked coding both ways, and writing heads.
import alloc;
import core.mem;
import core.utf8;
import http;

/// The most a head may take, and how many fields it may have.
pub const MAX_HEAD: usize = 65536;
pub const MAX_FIELDS: usize = 100;

/// Where the head in b ends, just after its empty line, once it does.
pub fn head_end(b: []u8) -> ?usize {
    var i: usize = 0;
    while i < b.len() : (i += 1) {
        if b[i] == '\n' {
            if i + 1 < b.len() and b[i + 1] == '\n' {
                return i + 2;
            }
            if i + 2 < b.len() and b[i + 1] == '\r' and b[i + 2] == '\n' {
                return i + 3;
            }
        }
    }
    return none;
}

/// A token character (RFC 9110 §5.6.2), what methods and names are made of.
fn tchar(c: u8) -> bool {
    if (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') {
        return true;
    }
    for t in "!#$%&'*+-.^_`|~".bytes() {
        if c == t.* {
            return true;
        }
    }
    return false;
}

fn text_of(b: []u8) -> http.HttpError!void {
    if not utf8.valid(b) {
        return http.HttpError.Malformed;
    }
}

fn unchecked(b: []u8) -> str {
    unsafe {
        // SAFETY: every caller checks b with text_of first.
        return mem.str_from(b);
    }
}

/// The lines of a head: each without its CR LF.
type Lines = struct {
    at: usize,
    end: usize,

    /// The next line as start and end, or none at the empty line.
    fn next(self: &mut Lines, b: []u8) -> ?[2]usize {
        let start = self.at;
        var i = start;
        while i < self.end and b[i] != '\n' : (i += 1) {
        }
        if i >= self.end {
            return none;
        }
        self.at = i + 1;
        var e = i;
        if e > start and b[e - 1] == '\r' {
            e -= 1;
        }
        if e == start {
            return none;
        }
        return [start, e];
    }
}

/// The header fields of a head after its first line, into h.
fn fields(b: []u8, lines: &mut Lines, h: &mut http.Headers) -> http.HttpError!void {
    while true {
        var line: [2]usize = [0, 0];
        match lines.next(b) {
            some(l) => { line = l; }
            none => { return; }
        }
        if h.len() >= MAX_FIELDS {
            return http.HttpError.TooLarge;
        }
        let start = line[0];
        let end = line[1];
        // No obsolete line folding: a field starts with its name.
        if b[start] == ' ' or b[start] == '\t' {
            return http.HttpError.Malformed;
        }
        var colon = start;
        while colon < end and b[colon] != ':' : (colon += 1) {
            if not tchar(b[colon]) {
                return http.HttpError.Malformed;
            }
        }
        if colon == start or colon == end {
            return http.HttpError.Malformed;
        }
        var vs = colon + 1;
        var ve = end;
        while vs < ve and (b[vs] == ' ' or b[vs] == '\t') : (vs += 1) {
        }
        while ve > vs and (b[ve - 1] == ' ' or b[ve - 1] == '\t') : (ve -= 1) {
        }
        var i = vs;
        while i < ve : (i += 1) {
            let c = b[i];
            if c == '\r' or c == 0 or (c < 0x20 and c != '\t') or c == 0x7f {
                return http.HttpError.Malformed;
            }
        }
        try text_of(b[vs..ve]);
        h.add(name: unchecked(b[start..colon]), value: unchecked(b[vs..ve]));
    }
}

fn version(b: []u8) -> http.HttpError!u8 {
    if b.len() != 8 or b[0] != 'H' or b[1] != 'T' or b[2] != 'T' or b[3] != 'P' or b[4] != '/' or b[6] != '.' or b[5] != '1' {
        return http.HttpError.Malformed;
    }
    if b[7] == '0' {
        return 10;
    }
    if b[7] == '1' {
        return 11;
    }
    return http.HttpError.Unsupported;
}

/// Parses a request head, b[0..end] with end from head_end, into req.
pub fn parse_request(b: []u8, end: usize, req: &mut http.Request) -> http.HttpError!void {
    var lines = Lines { at: 0, end: end };
    // Empty lines before the request line are ignored (RFC 9112 §2.2).
    var first: [2]usize = [0, 0];
    var found = false;
    while not found {
        match lines.next(b) {
            some(l) => {
                first = l;
                found = true;
            }
            none => {
                if lines.at >= end {
                    return http.HttpError.Malformed;
                }
            }
        }
    }
    let ls = first[0];
    let le = first[1];
    var sp1 = ls;
    while sp1 < le and b[sp1] != ' ' : (sp1 += 1) {
        if not tchar(b[sp1]) {
            return http.HttpError.Malformed;
        }
    }
    var sp2 = sp1 + 1;
    while sp2 < le and b[sp2] != ' ' : (sp2 += 1) {
        if b[sp2] <= 0x20 or b[sp2] >= 0x7f {
            return http.HttpError.Malformed;
        }
    }
    if sp1 == ls or sp1 >= le or sp2 >= le or sp2 == sp1 + 1 {
        return http.HttpError.Malformed;
    }
    req.version = try version(b[sp2 + 1..le]);
    req.method.push_str(unchecked(b[ls..sp1]));
    req.target.push_str(unchecked(b[sp1 + 1..sp2]));
    try fields(b, lines: &mut lines, h: &mut req.headers);
    match req.headers.find("host") {
        some(i) => { req.authority.push_str(req.headers.value(i)); }
        none => {
            if req.version == 11 {
                return http.HttpError.Malformed;
            }
        }
    }
}

/// How a body is delimited.
pub type Body = enum {
    Empty,
    Length { n: usize },
    Chunked,
    UntilClose,
}

fn number(v: str) -> http.HttpError!usize {
    let b = v.bytes();
    if b.len() == 0 or b.len() > 15 {
        return http.HttpError.Malformed;
    }
    var n: usize = 0;
    for c in b {
        if c.* < '0' or c.* > '9' {
            return http.HttpError.Malformed;
        }
        n = n * 10 + (c.* - '0') as usize;
    }
    return n;
}

/// The body framing of a message with these fields (RFC 9112 §6.3): a
/// request with both Transfer-Encoding and Content-Length, or differing
/// lengths, is refused, so no two readers can see different messages.
pub fn framing(h: &http.Headers, request: bool) -> http.HttpError!Body {
    var te = false;
    var length: ?usize = none;
    var i: usize = 0;
    while i < h.len() : (i += 1) {
        let name = h.name(i);
        if name.eq("transfer-encoding") {
            // Only chunked, as the last coding, is understood.
            if not http.same_name(a: h.value(i).bytes(), b: "chunked".bytes()) {
                return http.HttpError.Unsupported;
            }
            if te {
                return http.HttpError.Malformed;
            }
            te = true;
        } else if name.eq("content-length") {
            let n = try number(h.value(i));
            match length {
                some(m) => {
                    if m != n {
                        return http.HttpError.Malformed;
                    }
                }
                none => { length = some(n); }
            }
        }
    }
    if te {
        match length {
            some(_) => { return http.HttpError.Malformed; }
            none => { return Body.Chunked; }
        }
    }
    match length {
        some(n) => {
            if n == 0 {
                return Body.Empty;
            }
            return Body.Length { n: n };
        }
        none => { }
    }
    if request {
        return Body.Empty;
    }
    return Body.UntilClose;
}

/// The chunked coding, decoded as bytes arrive.
pub type Chunks = struct {
    state: u8,
    left: usize,
    digits: u32,
    pub done: bool,

    pub fn init() -> Chunks {
        return Chunks { state: 0, left: 0, digits: 0, done: false };
    }

    /// Decodes from b into body, at most max bytes of body in all; how
    /// many bytes of b it used. Once done, the rest of b is the next
    /// message's.
    pub fn feed(self: &mut Chunks, b: []u8, body: &mut alloc.List(u8), max: usize) -> http.HttpError!usize {
        var i: usize = 0;
        while i < b.len() and not self.done {
            let c = b[i];
            if self.state == 0 {
                // The size, in hex.
                var d: usize = 0;
                if c >= '0' and c <= '9' {
                    d = (c - '0') as usize;
                } else if c >= 'a' and c <= 'f' {
                    d = (c - 'a' + 10) as usize;
                } else if c >= 'A' and c <= 'F' {
                    d = (c - 'A' + 10) as usize;
                } else if self.digits > 0 and (c == ';' or c == ' ' or c == '\t') {
                    self.state = 1;
                    i += 1;
                    continue;
                } else if self.digits > 0 and (c == '\r' or c == '\n') {
                    self.state = 1;
                    continue;
                } else {
                    return http.HttpError.Malformed;
                }
                self.digits += 1;
                if self.digits > 8 {
                    return http.HttpError.TooLarge;
                }
                self.left = self.left * 16 + d;
                i += 1;
            } else if self.state == 1 {
                // Extensions, ignored, to the end of the line.
                if c == '\n' {
                    self.digits = 0;
                    if self.left == 0 {
                        self.state = 4;
                    } else {
                        if body.len() + self.left > max {
                            return http.HttpError.TooLarge;
                        }
                        self.state = 2;
                    }
                }
                i += 1;
            } else if self.state == 2 {
                // Data.
                var n = b.len() - i;
                if n > self.left {
                    n = self.left;
                }
                for x in b[i..i + n] {
                    body.push(x.*);
                }
                self.left -= n;
                i += n;
                if self.left == 0 {
                    self.state = 3;
                }
            } else if self.state == 3 {
                // The CR LF after the data.
                if c == '\r' {
                    i += 1;
                } else if c == '\n' {
                    self.state = 0;
                    i += 1;
                } else {
                    return http.HttpError.Malformed;
                }
            } else {
                // Trailer fields, ignored, up to an empty line. State 4 is
                // at a line's start, 5 inside one.
                if c == '\n' {
                    if self.state == 4 {
                        self.done = true;
                    }
                    self.state = 4;
                } else if c != '\r' {
                    self.state = 5;
                }
                i += 1;
            }
        }
        return i;
    }
}

/// Appends data as one chunk.
pub fn put_chunk(out: &mut alloc.List(u8), data: []u8) {
    if data.len() == 0 {
        return;
    }
    let hex = "0123456789abcdef".bytes();
    var digits: [16]u8 = [0; 16];
    var n = data.len();
    var k: usize = 0;
    while n > 0 : (n = n / 16) {
        digits[k] = hex[n % 16];
        k += 1;
    }
    while k > 0 : (k -= 1) {
        out.push(digits[k - 1]);
    }
    put(out, text: "\r\n");
    for x in data {
        out.push(x.*);
    }
    put(out, text: "\r\n");
}

fn put(out: &mut alloc.List(u8), text: str) {
    for c in text.bytes() {
        out.push(c.*);
    }
}

fn put_number(out: &mut alloc.List(u8), v: u64) {
    var digits: [20]u8 = [0; 20];
    var n = v;
    var k: usize = 0;
    while true {
        digits[k] = '0' + (n % 10) as u8;
        k += 1;
        n = n / 10;
        if n == 0 {
            break;
        }
    }
    while k > 0 : (k -= 1) {
        out.push(digits[k - 1]);
    }
}

/// Whether a field is about this connection only, which a server sets.
fn hop_by_hop(name: str) -> bool {
    return name.eq("connection") or name.eq("keep-alive") or name.eq("transfer-encoding") or name.eq("content-length");
}

/// Appends a response: the head, then the body unless head_only (for HEAD).
/// keep_alive says whether the connection stays open after it.
pub fn write_response(resp: &http.Response, head_only: bool, keep_alive: bool, out: &mut alloc.List(u8)) {
    put(out, text: "HTTP/1.1 ");
    put_number(out, v: resp.status as u64);
    put(out, text: " ");
    put(out, text: http.reason(resp.status));
    put(out, text: "\r\n");
    var i: usize = 0;
    while i < resp.headers.len() : (i += 1) {
        if not hop_by_hop(resp.headers.name(i)) {
            put(out, text: resp.headers.name(i));
            put(out, text: ": ");
            put(out, text: resp.headers.value(i));
            put(out, text: "\r\n");
        }
    }
    let has_body = not http.bodiless(resp.status);
    if has_body and resp.chunked {
        put(out, text: "transfer-encoding: chunked\r\n");
    } else if has_body {
        put(out, text: "content-length: ");
        put_number(out, v: resp.body.len() as u64);
        put(out, text: "\r\n");
    }
    if not keep_alive {
        put(out, text: "connection: close\r\n");
    }
    put(out, text: "\r\n");
    if head_only or not has_body {
        return;
    }
    if resp.chunked {
        let body = resp.body.items();
        var at: usize = 0;
        while at < body.len() {
            var n = body.len() - at;
            if n > 16384 {
                n = 16384;
            }
            put_chunk(out, data: body[at..at + n]);
            at += n;
        }
        put(out, text: "0\r\n\r\n");
    } else {
        for x in resp.body.items() {
            out.push(x.*);
        }
    }
}

/// Whether the connection stays open after this request (RFC 9112 §9.3).
pub fn keeps_alive(req: &http.Request) -> bool {
    var close = req.version == 10;
    var i: usize = 0;
    while i < req.headers.len() : (i += 1) {
        if req.headers.name(i).eq("connection") {
            let v = req.headers.value(i).bytes();
            if http.same_name(a: v, b: "close".bytes()) {
                return false;
            }
            if http.same_name(a: v, b: "keep-alive".bytes()) {
                close = false;
            }
        }
    }
    return not close;
}

/// Appends a request: the head, with Host and the length, then the body.
pub fn write_request(req: &http.Request, out: &mut alloc.List(u8)) {
    put(out, text: req.method.view());
    put(out, text: " ");
    put(out, text: req.target.view());
    put(out, text: " HTTP/1.1\r\nhost: ");
    put(out, text: req.authority.view());
    put(out, text: "\r\n");
    var i: usize = 0;
    while i < req.headers.len() : (i += 1) {
        let name = req.headers.name(i);
        if not hop_by_hop(name) and not name.eq("host") {
            put(out, text: name);
            put(out, text: ": ");
            put(out, text: req.headers.value(i));
            put(out, text: "\r\n");
        }
    }
    if req.body.len() > 0 {
        put(out, text: "content-length: ");
        put_number(out, v: req.body.len() as u64);
        put(out, text: "\r\n");
    }
    put(out, text: "\r\n");
    for x in req.body.items() {
        out.push(x.*);
    }
}

/// Parses a response head, b[0..end], into resp: the status and fields.
pub fn parse_response(b: []u8, end: usize, resp: &mut http.Response) -> http.HttpError!void {
    var lines = Lines { at: 0, end: end };
    var first: [2]usize = [0, 0];
    match lines.next(b) {
        some(l) => { first = l; }
        none => { return http.HttpError.Malformed; }
    }
    let ls = first[0];
    let le = first[1];
    if le - ls < 12 or b[ls + 8] != ' ' {
        return http.HttpError.Malformed;
    }
    _ = try version(b[ls..ls + 8]);
    var status: u16 = 0;
    var i = ls + 9;
    while i < ls + 12 : (i += 1) {
        if b[i] < '0' or b[i] > '9' {
            return http.HttpError.Malformed;
        }
        status = status * 10 + (b[i] - '0') as u16;
    }
    resp.status = status;
    try fields(b, lines: &mut lines, h: &mut resp.headers);
}
