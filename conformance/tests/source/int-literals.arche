// test: run
// spec: 2.2
// stdout: 0 42 1000000 255 255 15 10 18446744073709551615 9223372036854775807
import std;

fn main(sys: &mut std.System) -> !void {
    sys.stdout.write_u64(0);
    sys.stdout.write_byte(' ');
    sys.stdout.write_u64(42);
    sys.stdout.write_byte(' ');
    sys.stdout.write_u64(1_000_000);
    sys.stdout.write_byte(' ');
    sys.stdout.write_u64(0xFF);
    sys.stdout.write_byte(' ');
    sys.stdout.write_u64(0xf_f);
    sys.stdout.write_byte(' ');
    sys.stdout.write_u64(0o17);
    sys.stdout.write_byte(' ');
    sys.stdout.write_u64(0b1010);
    sys.stdout.write_byte(' ');
    sys.stdout.write_u64(0xFFFF_FFFF_FFFF_FFFF);
    sys.stdout.write_byte(' ');
    sys.stdout.write_i64(9223372036854775807);
    sys.stdout.write_byte('\n');
}
