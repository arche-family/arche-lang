// test: run
// spec: 2.2
// stdout: a
// stdout: 'A\"	~
import std;

fn main(sys: &mut std.System) -> !void {
    sys.stdout.write_byte('a');
    sys.stdout.write_byte('\n');
    sys.stdout.write_byte('\'');
    sys.stdout.write_byte('\x41');
    sys.stdout.write_byte('\\');
    sys.stdout.write_byte('"');
    sys.stdout.write_byte('\t');
    sys.stdout.write_byte('~');
    sys.stdout.write_byte('\n');
}
