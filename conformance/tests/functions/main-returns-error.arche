// test: run
// spec: 10
// exit: 1
// stdout: 12
// stdout: deferred
// stderr: error: Empty
import std;

type ParseError = error { Empty, BadDigit }

fn parse(text: str) -> ParseError!u32 {
    if text.len() == 0 {
        return ParseError.Empty;
    }
    var n: u32 = 0;
    var i: usize = 0;
    while i < text.len() : (i += 1) {
        let c = text[i];
        if c < '0' or c > '9' {
            return ParseError.BadDigit;
        }
        n = n * 10 + (c - '0') as u32;
    }
    return n;
}

fn main(sys: &mut std.System) -> !void {
    defer sys.stdout.write("deferred\n");
    let n = try parse("12");
    sys.stdout.write_u64(n as u64);
    sys.stdout.write("\n");
    _ = try parse("");
    sys.stdout.write("not reached\n");
}
