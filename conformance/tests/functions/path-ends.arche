// test: run
// spec: 10
// stdout: zero other 8
import std;

fn pick(n: u32) -> str {
    if n == 0 {
        return "zero";
    } else {
        return "other";
    }
}

fn find(limit: u32) -> u32 {
    var i: u32 = 0;
    while true : (i += 1) {
        if i * i >= limit {
            return i;
        }
    }
}

fn fail() -> u32 {
    panic("never returns");
}

fn main(sys: &mut std.System) -> !void {
    sys.stdout.write(pick(0));
    sys.stdout.write(" ");
    sys.stdout.write(pick(1));
    sys.stdout.write(" ");
    sys.stdout.write_u64(find(50) as u64);
    sys.stdout.write("\n");
    if false {
        _ = fail();
    }
}
