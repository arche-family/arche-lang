// test: run
// spec: 7.5
// stdout: hi, Ada
// stdout: hi, Alan
import std;

fn greet(out: &mut std.Output, name: str) {
    out.write("hi, ");
    out.write(name);
    out.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    greet(&mut sys.stdout, "Ada");
    greet(out: &mut sys.stdout, name: "Alan");
}
