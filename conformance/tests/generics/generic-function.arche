// test: run
// spec: arche/4.1
// stage0: skip
// stdout: 7 -3 200
import std;

fn max(comptime T: type, a: T, b: T) -> T {
    if a > b {
        return a;
    }
    return b;
}

fn main(sys: &mut std.System) -> !void {
    sys.stdout.write_u64(max(u64, a: 3, b: 7));
    sys.stdout.write(" ");
    sys.stdout.write_i64(max(i32, a: -3, b: -7) as i64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(max(u8, a: 200, b: 100) as u64);
    sys.stdout.write("\n");
}
