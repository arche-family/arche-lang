// test: run
// spec: arche/4.3
// stage0: skip
// stdout: 6765 25 21 144 8 55
import std;

fn fib(n: u64) -> u64 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn primes_below(limit: u32) -> u32 {
    var count: u32 = 0;
    var n: u32 = 2;
    while n < limit : (n += 1) {
        var d: u32 = 2;
        var prime = true;
        while d * d <= n : (d += 1) {
            if n % d == 0 {
                prime = false;
                break;
            }
        }
        if prime {
            count += 1;
        }
    }
    return count;
}

fn classify(x: i32) -> u8 {
    match x {
        -1 => { return 1; }
        0..=9 => { return 2; }
        _ => { return 3; }
    }
}

fn square(comptime T: type, x: T) -> T {
    return x * x;
}

const FIB: u64 = fib(20);
const PRIMES: u32 = primes_below(100);
const KIND: u8 = classify(5) * 10 + classify(-1);
const SQ: u16 = square(u16, 12);
const LEN: usize = fib(6) as usize;

fn main(sys: &mut std.System) -> !void {
    let table: [LEN]u8 = [1, 2, 3, 4, 5, 6, 7, 8];
    sys.stdout.write_u64(FIB);
    sys.stdout.write(" ");
    sys.stdout.write_u64(PRIMES as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(KIND as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(SQ as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(table.len() as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(fib(10));
    sys.stdout.write("\n");
}
