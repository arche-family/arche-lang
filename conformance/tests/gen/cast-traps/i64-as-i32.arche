// test: run
// spec: 7.4
// exit: 101
// stderr: panic: value does not fit in i32
import std;

fn pass(x: i64) -> i64 {
    return x;
}

fn main(sys: &mut std.System) -> !void {
    let x: i64 = pass(-9223372036854775807 - 1);
    sys.stdout.write_i64((x as i32) as i64);
    sys.stdout.write("\n");
}
