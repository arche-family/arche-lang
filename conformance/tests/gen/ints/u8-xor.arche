// test: run
// spec: 7.2
// stdout: 183
// stdout: 48
// stdout: 91
// stdout: 78
// stdout: 177
// stdout: 0
// stdout: 6
// stdout: 0
import std;

// u8 ^ on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: u8 = 7;
    let b0: u8 = 176;
    sys.stdout.write_u64((a0 ^ b0) as u64);
    sys.stdout.write("\n");
    let a1: u8 = 176;
    let b1: u8 = 128;
    sys.stdout.write_u64((a1 ^ b1) as u64);
    sys.stdout.write("\n");
    let a2: u8 = 2;
    let b2: u8 = 89;
    sys.stdout.write_u64((a2 ^ b2) as u64);
    sys.stdout.write("\n");
    let a3: u8 = 254;
    let b3: u8 = 176;
    sys.stdout.write_u64((a3 ^ b3) as u64);
    sys.stdout.write("\n");
    let a4: u8 = 176;
    let b4: u8 = 1;
    sys.stdout.write_u64((a4 ^ b4) as u64);
    sys.stdout.write("\n");
    let a5: u8 = 254;
    let b5: u8 = 254;
    sys.stdout.write_u64((a5 ^ b5) as u64);
    sys.stdout.write("\n");
    let a6: u8 = 7;
    let b6: u8 = 1;
    sys.stdout.write_u64((a6 ^ b6) as u64);
    sys.stdout.write("\n");
    let a7: u8 = 3;
    let b7: u8 = 3;
    sys.stdout.write_u64((a7 ^ b7) as u64);
    sys.stdout.write("\n");
}
