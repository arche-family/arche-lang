import std;

// i64 >> on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: i64 = 7;
    let b0: u32 = 3;
    sys.stdout.write_i64((a0 >> b0) as i64);
    sys.stdout.write("\n");
    let a1: i64 = 9223372036854775807;
    let b1: u32 = 16;
    sys.stdout.write_i64((a1 >> b1) as i64);
    sys.stdout.write("\n");
    let a2: i64 = 7;
    let b2: u32 = 47;
    sys.stdout.write_i64((a2 >> b2) as i64);
    sys.stdout.write("\n");
    let a3: i64 = -7548373693128998889;
    let b3: u32 = 23;
    sys.stdout.write_i64((a3 >> b3) as i64);
    sys.stdout.write("\n");
    let a4: i64 = -9223372036854775807 - 1;
    let b4: u32 = 62;
    sys.stdout.write_i64((a4 >> b4) as i64);
    sys.stdout.write("\n");
    let a5: i64 = -2;
    let b5: u32 = 21;
    sys.stdout.write_i64((a5 >> b5) as i64);
    sys.stdout.write("\n");
    let a6: i64 = -1;
    let b6: u32 = 49;
    sys.stdout.write_i64((a6 >> b6) as i64);
    sys.stdout.write("\n");
    let a7: i64 = -1;
    let b7: u32 = 63;
    sys.stdout.write_i64((a7 >> b7) as i64);
    sys.stdout.write("\n");
}
