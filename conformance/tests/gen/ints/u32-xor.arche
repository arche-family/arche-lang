// test: run
// spec: 7.2
// stdout: 4294967289
// stdout: 0
// stdout: 4294967294
// stdout: 4294967295
// stdout: 394530140
// stdout: 2147483655
// stdout: 394530141
// stdout: 2147483651
import std;

// u32 ^ on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: u32 = 4294967294;
    let b0: u32 = 7;
    sys.stdout.write_u64((a0 ^ b0) as u64);
    sys.stdout.write("\n");
    let a1: u32 = 0;
    let b1: u32 = 0;
    sys.stdout.write_u64((a1 ^ b1) as u64);
    sys.stdout.write("\n");
    let a2: u32 = 1;
    let b2: u32 = 4294967295;
    sys.stdout.write_u64((a2 ^ b2) as u64);
    sys.stdout.write("\n");
    let a3: u32 = 4294967294;
    let b3: u32 = 1;
    sys.stdout.write_u64((a3 ^ b3) as u64);
    sys.stdout.write("\n");
    let a4: u32 = 394530142;
    let b4: u32 = 2;
    sys.stdout.write_u64((a4 ^ b4) as u64);
    sys.stdout.write("\n");
    let a5: u32 = 7;
    let b5: u32 = 2147483648;
    sys.stdout.write_u64((a5 ^ b5) as u64);
    sys.stdout.write("\n");
    let a6: u32 = 3;
    let b6: u32 = 394530142;
    sys.stdout.write_u64((a6 ^ b6) as u64);
    sys.stdout.write("\n");
    let a7: u32 = 2147483648;
    let b7: u32 = 3;
    sys.stdout.write_u64((a7 ^ b7) as u64);
    sys.stdout.write("\n");
}
