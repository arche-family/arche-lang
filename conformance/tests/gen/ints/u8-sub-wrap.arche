// test: run
// spec: 7.2
// stdout: 129
// stdout: 0
// stdout: 248
// stdout: 126
// stdout: 126
// stdout: 251
// stdout: 128
// stdout: 1
import std;

// u8 -% on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: u8 = 1;
    let b0: u8 = 128;
    sys.stdout.write_u64((a0 -% b0) as u64);
    sys.stdout.write("\n");
    let a1: u8 = 2;
    let b1: u8 = 2;
    sys.stdout.write_u64((a1 -% b1) as u64);
    sys.stdout.write("\n");
    let a2: u8 = 255;
    let b2: u8 = 7;
    sys.stdout.write_u64((a2 -% b2) as u64);
    sys.stdout.write("\n");
    let a3: u8 = 254;
    let b3: u8 = 128;
    sys.stdout.write_u64((a3 -% b3) as u64);
    sys.stdout.write("\n");
    let a4: u8 = 128;
    let b4: u8 = 2;
    sys.stdout.write_u64((a4 -% b4) as u64);
    sys.stdout.write("\n");
    let a5: u8 = 254;
    let b5: u8 = 3;
    sys.stdout.write_u64((a5 -% b5) as u64);
    sys.stdout.write("\n");
    let a6: u8 = 128;
    let b6: u8 = 0;
    sys.stdout.write_u64((a6 -% b6) as u64);
    sys.stdout.write("\n");
    let a7: u8 = 1;
    let b7: u8 = 0;
    sys.stdout.write_u64((a7 -% b7) as u64);
    sys.stdout.write("\n");
}
