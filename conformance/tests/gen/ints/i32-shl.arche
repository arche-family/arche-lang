// test: run
// spec: 7.2
// stdout: 0
// stdout: 128
// stdout: -917504
// stdout: -65536
// stdout: -1140850688
// stdout: 67108864
// stdout: 0
// stdout: 0
import std;

// i32 << on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: i32 = 1073741824;
    let b0: u32 = 30;
    sys.stdout.write_i64((a0 << b0) as i64);
    sys.stdout.write("\n");
    let a1: i32 = -2147483647;
    let b1: u32 = 7;
    sys.stdout.write_i64((a1 << b1) as i64);
    sys.stdout.write("\n");
    let a2: i32 = -7;
    let b2: u32 = 17;
    sys.stdout.write_i64((a2 << b2) as i64);
    sys.stdout.write("\n");
    let a3: i32 = -2;
    let b3: u32 = 15;
    sys.stdout.write_i64((a3 << b3) as i64);
    sys.stdout.write("\n");
    let a4: i32 = 941779320;
    let b4: u32 = 23;
    sys.stdout.write_i64((a4 << b4) as i64);
    sys.stdout.write("\n");
    let a5: i32 = -2147483647;
    let b5: u32 = 26;
    sys.stdout.write_i64((a5 << b5) as i64);
    sys.stdout.write("\n");
    let a6: i32 = 0;
    let b6: u32 = 23;
    sys.stdout.write_i64((a6 << b6) as i64);
    sys.stdout.write("\n");
    let a7: i32 = -2147483647 - 1;
    let b7: u32 = 26;
    sys.stdout.write_i64((a7 << b7) as i64);
    sys.stdout.write("\n");
}
