// test: run
// spec: 7.2
// stdout: 3
// stdout: 4
// stdout: 8191
// stdout: 4095
// stdout: -1
// stdout: -1
// stdout: -8192
// stdout: -1024
import std;

// i16 >> on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: i16 = 32767;
    let b0: u32 = 13;
    sys.stdout.write_i64((a0 >> b0) as i64);
    sys.stdout.write("\n");
    let a1: i16 = 16384;
    let b1: u32 = 12;
    sys.stdout.write_i64((a1 >> b1) as i64);
    sys.stdout.write("\n");
    let a2: i16 = 32766;
    let b2: u32 = 2;
    sys.stdout.write_i64((a2 >> b2) as i64);
    sys.stdout.write("\n");
    let a3: i16 = 32767;
    let b3: u32 = 3;
    sys.stdout.write_i64((a3 >> b3) as i64);
    sys.stdout.write("\n");
    let a4: i16 = -2;
    let b4: u32 = 12;
    sys.stdout.write_i64((a4 >> b4) as i64);
    sys.stdout.write("\n");
    let a5: i16 = -7;
    let b5: u32 = 11;
    sys.stdout.write_i64((a5 >> b5) as i64);
    sys.stdout.write("\n");
    let a6: i16 = -32767;
    let b6: u32 = 2;
    sys.stdout.write_i64((a6 >> b6) as i64);
    sys.stdout.write("\n");
    let a7: i16 = -32767 - 1;
    let b7: u32 = 5;
    sys.stdout.write_i64((a7 >> b7) as i64);
    sys.stdout.write("\n");
}
