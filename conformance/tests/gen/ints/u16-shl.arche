// test: run
// spec: 7.2
// stdout: 49152
// stdout: 112
// stdout: 65024
// stdout: 3072
// stdout: 16
// stdout: 3584
// stdout: 49152
// stdout: 0
import std;

// u16 << on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: u16 = 7;
    let b0: u32 = 14;
    sys.stdout.write_u64((a0 << b0) as u64);
    sys.stdout.write("\n");
    let a1: u16 = 7;
    let b1: u32 = 4;
    sys.stdout.write_u64((a1 << b1) as u64);
    sys.stdout.write("\n");
    let a2: u16 = 65534;
    let b2: u32 = 8;
    sys.stdout.write_u64((a2 << b2) as u64);
    sys.stdout.write("\n");
    let a3: u16 = 3;
    let b3: u32 = 10;
    sys.stdout.write_u64((a3 << b3) as u64);
    sys.stdout.write("\n");
    let a4: u16 = 2;
    let b4: u32 = 3;
    sys.stdout.write_u64((a4 << b4) as u64);
    sys.stdout.write("\n");
    let a5: u16 = 7;
    let b5: u32 = 9;
    sys.stdout.write_u64((a5 << b5) as u64);
    sys.stdout.write("\n");
    let a6: u16 = 65535;
    let b6: u32 = 14;
    sys.stdout.write_u64((a6 << b6) as u64);
    sys.stdout.write("\n");
    let a7: u16 = 32768;
    let b7: u32 = 12;
    sys.stdout.write_u64((a7 << b7) as u64);
    sys.stdout.write("\n");
}
