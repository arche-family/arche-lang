// test: run
// spec: 7.2
// stdout: -2147483646
// stdout: 0
// stdout: -3
// stdout: 1609711457
// stdout: 0
// stdout: -49
// stdout: 2
// stdout: -2147483648
import std;

// i32 *% on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: i32 = -1;
    let b0: i32 = 2147483646;
    sys.stdout.write_i64((a0 *% b0) as i64);
    sys.stdout.write("\n");
    let a1: i32 = -1695449352;
    let b1: i32 = 0;
    sys.stdout.write_i64((a1 *% b1) as i64);
    sys.stdout.write("\n");
    let a2: i32 = 3;
    let b2: i32 = -1;
    sys.stdout.write_i64((a2 *% b2) as i64);
    sys.stdout.write("\n");
    let a3: i32 = 2147483647;
    let b3: i32 = 537772191;
    sys.stdout.write_i64((a3 *% b3) as i64);
    sys.stdout.write("\n");
    let a4: i32 = 0;
    let b4: i32 = 537772191;
    sys.stdout.write_i64((a4 *% b4) as i64);
    sys.stdout.write("\n");
    let a5: i32 = -7;
    let b5: i32 = 7;
    sys.stdout.write_i64((a5 *% b5) as i64);
    sys.stdout.write("\n");
    let a6: i32 = 1;
    let b6: i32 = 2;
    sys.stdout.write_i64((a6 *% b6) as i64);
    sys.stdout.write("\n");
    let a7: i32 = 2147483646;
    let b7: i32 = 1073741824;
    sys.stdout.write_i64((a7 *% b7) as i64);
    sys.stdout.write("\n");
}
