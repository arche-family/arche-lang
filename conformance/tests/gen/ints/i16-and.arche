// test: run
// spec: 7.2
// stdout: 3
// stdout: -32768
// stdout: 6
// stdout: 29605
// stdout: 3
// stdout: 16384
// stdout: 0
// stdout: 0
import std;

// i16 & on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: i16 = 3;
    let b0: i16 = 7;
    sys.stdout.write_i64((a0 & b0) as i64);
    sys.stdout.write("\n");
    let a1: i16 = -2;
    let b1: i16 = -32767 - 1;
    sys.stdout.write_i64((a1 & b1) as i64);
    sys.stdout.write("\n");
    let a2: i16 = 7;
    let b2: i16 = -2;
    sys.stdout.write_i64((a2 & b2) as i64);
    sys.stdout.write("\n");
    let a3: i16 = 32767;
    let b3: i16 = -3163;
    sys.stdout.write_i64((a3 & b3) as i64);
    sys.stdout.write("\n");
    let a4: i16 = 3;
    let b4: i16 = 32767;
    sys.stdout.write_i64((a4 & b4) as i64);
    sys.stdout.write("\n");
    let a5: i16 = -2;
    let b5: i16 = 16384;
    sys.stdout.write_i64((a5 & b5) as i64);
    sys.stdout.write("\n");
    let a6: i16 = 1;
    let b6: i16 = -2;
    sys.stdout.write_i64((a6 & b6) as i64);
    sys.stdout.write("\n");
    let a7: i16 = 1;
    let b7: i16 = 2;
    sys.stdout.write_i64((a7 & b7) as i64);
    sys.stdout.write("\n");
}
