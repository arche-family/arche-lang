// test: run
// spec: 7.2
// stdout: 65536
// stdout: 252201579132747776
// stdout: 7881299347898368
// stdout: 9007199254740992
// stdout: 2097152
// stdout: -2097152
// stdout: 0
// stdout: 3185667456479789056
import std;

// i64 << on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: i64 = -9223372036854775807;
    let b0: u32 = 16;
    sys.stdout.write_i64((a0 << b0) as i64);
    sys.stdout.write("\n");
    let a1: i64 = 7;
    let b1: u32 = 55;
    sys.stdout.write_i64((a1 << b1) as i64);
    sys.stdout.write("\n");
    let a2: i64 = 7;
    let b2: u32 = 50;
    sys.stdout.write_i64((a2 << b2) as i64);
    sys.stdout.write("\n");
    let a3: i64 = 1;
    let b3: u32 = 53;
    sys.stdout.write_i64((a3 << b3) as i64);
    sys.stdout.write("\n");
    let a4: i64 = 2;
    let b4: u32 = 20;
    sys.stdout.write_i64((a4 << b4) as i64);
    sys.stdout.write("\n");
    let a5: i64 = 9223372036854775807;
    let b5: u32 = 21;
    sys.stdout.write_i64((a5 << b5) as i64);
    sys.stdout.write("\n");
    let a6: i64 = 0;
    let b6: u32 = 11;
    sys.stdout.write_i64((a6 << b6) as i64);
    sys.stdout.write("\n");
    let a7: i64 = -5230449191217288100;
    let b7: u32 = 24;
    sys.stdout.write_i64((a7 << b7) as i64);
    sys.stdout.write("\n");
}
