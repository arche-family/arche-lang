// test: run
// spec: 7.2
// stdout: 64
// stdout: 0
// stdout: 0
// stdout: 1
// stdout: 7
// stdout: 75
// stdout: -2
// stdout: 75
import std;

// i8 % on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: i8 = 64;
    let b0: i8 = -127 - 1;
    sys.stdout.write_i64((a0 % b0) as i64);
    sys.stdout.write("\n");
    let a1: i8 = -127;
    let b1: i8 = 1;
    sys.stdout.write_i64((a1 % b1) as i64);
    sys.stdout.write("\n");
    let a2: i8 = 126;
    let b2: i8 = 1;
    sys.stdout.write_i64((a2 % b2) as i64);
    sys.stdout.write("\n");
    let a3: i8 = 1;
    let b3: i8 = 7;
    sys.stdout.write_i64((a3 % b3) as i64);
    sys.stdout.write("\n");
    let a4: i8 = 7;
    let b4: i8 = -44;
    sys.stdout.write_i64((a4 % b4) as i64);
    sys.stdout.write("\n");
    let a5: i8 = 75;
    let b5: i8 = -127 - 1;
    sys.stdout.write_i64((a5 % b5) as i64);
    sys.stdout.write("\n");
    let a6: i8 = -2;
    let b6: i8 = 75;
    sys.stdout.write_i64((a6 % b6) as i64);
    sys.stdout.write("\n");
    let a7: i8 = 75;
    let b7: i8 = -127;
    sys.stdout.write_i64((a7 % b7) as i64);
    sys.stdout.write("\n");
}
