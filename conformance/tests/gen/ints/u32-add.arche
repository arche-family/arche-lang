// test: run
// spec: 7.2
// stdout: 560919252
// stdout: 3
// stdout: 8
// stdout: 2627282310
// stdout: 4294967295
// stdout: 1
// stdout: 560919254
// stdout: 9
import std;

// u32 + on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: u32 = 560919252;
    let b0: u32 = 0;
    sys.stdout.write_u64((a0 + b0) as u64);
    sys.stdout.write("\n");
    let a1: u32 = 0;
    let b1: u32 = 3;
    sys.stdout.write_u64((a1 + b1) as u64);
    sys.stdout.write("\n");
    let a2: u32 = 1;
    let b2: u32 = 7;
    sys.stdout.write_u64((a2 + b2) as u64);
    sys.stdout.write("\n");
    let a3: u32 = 3;
    let b3: u32 = 2627282307;
    sys.stdout.write_u64((a3 + b3) as u64);
    sys.stdout.write("\n");
    let a4: u32 = 1;
    let b4: u32 = 4294967294;
    sys.stdout.write_u64((a4 + b4) as u64);
    sys.stdout.write("\n");
    let a5: u32 = 0;
    let b5: u32 = 1;
    sys.stdout.write_u64((a5 + b5) as u64);
    sys.stdout.write("\n");
    let a6: u32 = 2;
    let b6: u32 = 560919252;
    sys.stdout.write_u64((a6 + b6) as u64);
    sys.stdout.write("\n");
    let a7: u32 = 2;
    let b7: u32 = 7;
    sys.stdout.write_u64((a7 + b7) as u64);
    sys.stdout.write("\n");
}
