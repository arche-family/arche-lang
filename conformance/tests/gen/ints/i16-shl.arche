// test: run
// spec: 7.2
// stdout: -14764
// stdout: -112
// stdout: 64
// stdout: -14
// stdout: -16384
// stdout: 0
// stdout: 0
// stdout: 0
import std;

// i16 << on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: i16 = 25386;
    let b0: u32 = 1;
    sys.stdout.write_i64((a0 << b0) as i64);
    sys.stdout.write("\n");
    let a1: i16 = -7;
    let b1: u32 = 4;
    sys.stdout.write_i64((a1 << b1) as i64);
    sys.stdout.write("\n");
    let a2: i16 = 1;
    let b2: u32 = 6;
    sys.stdout.write_i64((a2 << b2) as i64);
    sys.stdout.write("\n");
    let a3: i16 = -7;
    let b3: u32 = 1;
    sys.stdout.write_i64((a3 << b3) as i64);
    sys.stdout.write("\n");
    let a4: i16 = -1;
    let b4: u32 = 14;
    sys.stdout.write_i64((a4 << b4) as i64);
    sys.stdout.write("\n");
    let a5: i16 = -32767 - 1;
    let b5: u32 = 6;
    sys.stdout.write_i64((a5 << b5) as i64);
    sys.stdout.write("\n");
    let a6: i16 = -32767 - 1;
    let b6: u32 = 9;
    sys.stdout.write_i64((a6 << b6) as i64);
    sys.stdout.write("\n");
    let a7: i16 = 2;
    let b7: u32 = 15;
    sys.stdout.write_i64((a7 << b7) as i64);
    sys.stdout.write("\n");
}
