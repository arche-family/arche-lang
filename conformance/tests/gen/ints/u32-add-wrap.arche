// test: run
// spec: 7.2
// stdout: 4294967294
// stdout: 3208973117
// stdout: 1
// stdout: 1393731276
// stdout: 1393731284
// stdout: 2
// stdout: 1
// stdout: 2147483649
import std;

// u32 +% on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: u32 = 4294967294;
    let b0: u32 = 0;
    sys.stdout.write_u64((a0 +% b0) as u64);
    sys.stdout.write("\n");
    let a1: u32 = 3208973117;
    let b1: u32 = 0;
    sys.stdout.write_u64((a1 +% b1) as u64);
    sys.stdout.write("\n");
    let a2: u32 = 0;
    let b2: u32 = 1;
    sys.stdout.write_u64((a2 +% b2) as u64);
    sys.stdout.write("\n");
    let a3: u32 = 1393731277;
    let b3: u32 = 4294967295;
    sys.stdout.write_u64((a3 +% b3) as u64);
    sys.stdout.write("\n");
    let a4: u32 = 7;
    let b4: u32 = 1393731277;
    sys.stdout.write_u64((a4 +% b4) as u64);
    sys.stdout.write("\n");
    let a5: u32 = 0;
    let b5: u32 = 2;
    sys.stdout.write_u64((a5 +% b5) as u64);
    sys.stdout.write("\n");
    let a6: u32 = 4294967294;
    let b6: u32 = 3;
    sys.stdout.write_u64((a6 +% b6) as u64);
    sys.stdout.write("\n");
    let a7: u32 = 1;
    let b7: u32 = 2147483648;
    sys.stdout.write_u64((a7 +% b7) as u64);
    sys.stdout.write("\n");
}
