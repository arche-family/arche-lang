// test: run
// spec: 7.2
// stdout: 7
// stdout: -1
// stdout: -2
// stdout: -3466476301630911960
// stdout: 6616495476703322762
// stdout: 1
// stdout: 6932952603261823920
// stdout: -14
import std;

// i64 * on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: i64 = -1;
    let b0: i64 = -7;
    sys.stdout.write_i64((a0 * b0) as i64);
    sys.stdout.write("\n");
    let a1: i64 = 1;
    let b1: i64 = -1;
    sys.stdout.write_i64((a1 * b1) as i64);
    sys.stdout.write("\n");
    let a2: i64 = 2;
    let b2: i64 = -1;
    sys.stdout.write_i64((a2 * b2) as i64);
    sys.stdout.write("\n");
    let a3: i64 = -1;
    let b3: i64 = 3466476301630911960;
    sys.stdout.write_i64((a3 * b3) as i64);
    sys.stdout.write("\n");
    let a4: i64 = 3308247738351661381;
    let b4: i64 = 2;
    sys.stdout.write_i64((a4 * b4) as i64);
    sys.stdout.write("\n");
    let a5: i64 = 1;
    let b5: i64 = 1;
    sys.stdout.write_i64((a5 * b5) as i64);
    sys.stdout.write("\n");
    let a6: i64 = 3466476301630911960;
    let b6: i64 = 2;
    sys.stdout.write_i64((a6 * b6) as i64);
    sys.stdout.write("\n");
    let a7: i64 = 7;
    let b7: i64 = -2;
    sys.stdout.write_i64((a7 * b7) as i64);
    sys.stdout.write("\n");
}
