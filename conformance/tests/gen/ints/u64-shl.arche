import std;

// u64 << on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: u64 = 1;
    let b0: u32 = 28;
    sys.stdout.write_u64((a0 << b0) as u64);
    sys.stdout.write("\n");
    let a1: u64 = 5672961346766666143;
    let b1: u32 = 9;
    sys.stdout.write_u64((a1 << b1) as u64);
    sys.stdout.write("\n");
    let a2: u64 = 9223372036854775808;
    let b2: u32 = 10;
    sys.stdout.write_u64((a2 << b2) as u64);
    sys.stdout.write("\n");
    let a3: u64 = 18446744073709551615;
    let b3: u32 = 33;
    sys.stdout.write_u64((a3 << b3) as u64);
    sys.stdout.write("\n");
    let a4: u64 = 5672961346766666143;
    let b4: u32 = 54;
    sys.stdout.write_u64((a4 << b4) as u64);
    sys.stdout.write("\n");
    let a5: u64 = 18446744073709551615;
    let b5: u32 = 39;
    sys.stdout.write_u64((a5 << b5) as u64);
    sys.stdout.write("\n");
    let a6: u64 = 3;
    let b6: u32 = 23;
    sys.stdout.write_u64((a6 << b6) as u64);
    sys.stdout.write("\n");
    let a7: u64 = 18446744073709551614;
    let b7: u32 = 53;
    sys.stdout.write_u64((a7 << b7) as u64);
    sys.stdout.write("\n");
}
