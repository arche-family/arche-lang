// test: run
// spec: 7.2
// stdout: 8
// stdout: 2
// stdout: 16826558629845013672
// stdout: 18446744073709551614
// stdout: 16826558629845013674
// stdout: 7
// stdout: 3
// stdout: 3
import std;

// u64 + on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: u64 = 1;
    let b0: u64 = 7;
    sys.stdout.write_u64((a0 + b0) as u64);
    sys.stdout.write("\n");
    let a1: u64 = 2;
    let b1: u64 = 0;
    sys.stdout.write_u64((a1 + b1) as u64);
    sys.stdout.write("\n");
    let a2: u64 = 1;
    let b2: u64 = 16826558629845013671;
    sys.stdout.write_u64((a2 + b2) as u64);
    sys.stdout.write("\n");
    let a3: u64 = 18446744073709551614;
    let b3: u64 = 0;
    sys.stdout.write_u64((a3 + b3) as u64);
    sys.stdout.write("\n");
    let a4: u64 = 3;
    let b4: u64 = 16826558629845013671;
    sys.stdout.write_u64((a4 + b4) as u64);
    sys.stdout.write("\n");
    let a5: u64 = 0;
    let b5: u64 = 7;
    sys.stdout.write_u64((a5 + b5) as u64);
    sys.stdout.write("\n");
    let a6: u64 = 1;
    let b6: u64 = 2;
    sys.stdout.write_u64((a6 + b6) as u64);
    sys.stdout.write("\n");
    let a7: u64 = 3;
    let b7: u64 = 0;
    sys.stdout.write_u64((a7 + b7) as u64);
    sys.stdout.write("\n");
}
