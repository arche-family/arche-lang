import std;

// u64 / on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: u64 = 2;
    let b0: u64 = 9223372036854775808;
    sys.stdout.write_u64((a0 / b0) as u64);
    sys.stdout.write("\n");
    let a1: u64 = 9729871378016716436;
    let b1: u64 = 18446744073709551615;
    sys.stdout.write_u64((a1 / b1) as u64);
    sys.stdout.write("\n");
    let a2: u64 = 7;
    let b2: u64 = 2;
    sys.stdout.write_u64((a2 / b2) as u64);
    sys.stdout.write("\n");
    let a3: u64 = 1;
    let b3: u64 = 1;
    sys.stdout.write_u64((a3 / b3) as u64);
    sys.stdout.write("\n");
    let a4: u64 = 3;
    let b4: u64 = 2345948812818307689;
    sys.stdout.write_u64((a4 / b4) as u64);
    sys.stdout.write("\n");
    let a5: u64 = 9729871378016716436;
    let b5: u64 = 1;
    sys.stdout.write_u64((a5 / b5) as u64);
    sys.stdout.write("\n");
    let a6: u64 = 9223372036854775808;
    let b6: u64 = 7;
    sys.stdout.write_u64((a6 / b6) as u64);
    sys.stdout.write("\n");
    let a7: u64 = 9729871378016716436;
    let b7: u64 = 9729871378016716436;
    sys.stdout.write_u64((a7 / b7) as u64);
    sys.stdout.write("\n");
}
