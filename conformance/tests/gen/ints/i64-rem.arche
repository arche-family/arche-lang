    sys.stdout.write("\n");
    let a4: i64 = 9223372036854775806;
    let b4: i64 = 3;
    sys.stdout.write_i64((a4 % b4) as i64);
    sys.stdout.write("\n");
    let a5: i64 = -2;
    let b5: i64 = 6349436664967172773;
    sys.stdout.write_i64((a5 % b5) as i64);
    sys.stdout.write("\n");
    let a6: i64 = 9223372036854775806;
