// test: run
// spec: 7.2
// stdout: 41113
// stdout: 23165
// stdout: 55934
// stdout: 32767
// stdout: 1
// stdout: 24421
// stdout: 32770
// stdout: 23161
import std;

// u16 ^ on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: u16 = 3;
    let b0: u16 = 41114;
    sys.stdout.write_u64((a0 ^ b0) as u64);
    sys.stdout.write("\n");
    let a1: u16 = 3;
    let b1: u16 = 23166;
    sys.stdout.write_u64((a1 ^ b1) as u64);
    sys.stdout.write("\n");
    let a2: u16 = 23166;
    let b2: u16 = 32768;
    sys.stdout.write_u64((a2 ^ b2) as u64);
    sys.stdout.write("\n");
    let a3: u16 = 65535;
    let b3: u16 = 32768;
    sys.stdout.write_u64((a3 ^ b3) as u64);
    sys.stdout.write("\n");
    let a4: u16 = 3;
    let b4: u16 = 2;
    sys.stdout.write_u64((a4 ^ b4) as u64);
    sys.stdout.write("\n");
    let a5: u16 = 41114;
    let b5: u16 = 65535;
    sys.stdout.write_u64((a5 ^ b5) as u64);
    sys.stdout.write("\n");
    let a6: u16 = 2;
    let b6: u16 = 32768;
    sys.stdout.write_u64((a6 ^ b6) as u64);
    sys.stdout.write("\n");
    let a7: u16 = 7;
    let b7: u16 = 23166;
    sys.stdout.write_u64((a7 ^ b7) as u64);
    sys.stdout.write("\n");
}
