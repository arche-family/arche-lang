// test: run
// spec: 7.2
// stdout: 4294967295
// stdout: 4294967295
// stdout: 4294967295
// stdout: 1185909763
// stdout: 4294967295
// stdout: 4294967294
// stdout: 159902735
// stdout: 2
import std;

// u32 | on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: u32 = 4294967295;
    let b0: u32 = 0;
    sys.stdout.write_u64((a0 | b0) as u64);
    sys.stdout.write("\n");
    let a1: u32 = 1;
    let b1: u32 = 4294967294;
    sys.stdout.write_u64((a1 | b1) as u64);
    sys.stdout.write("\n");
    let a2: u32 = 2147483648;
    let b2: u32 = 4294967295;
    sys.stdout.write_u64((a2 | b2) as u64);
    sys.stdout.write("\n");
    let a3: u32 = 1;
    let b3: u32 = 1185909763;
    sys.stdout.write_u64((a3 | b3) as u64);
    sys.stdout.write("\n");
    let a4: u32 = 4294967295;
    let b4: u32 = 2147483648;
    sys.stdout.write_u64((a4 | b4) as u64);
    sys.stdout.write("\n");
    let a5: u32 = 4294967294;
    let b5: u32 = 0;
    sys.stdout.write_u64((a5 | b5) as u64);
    sys.stdout.write("\n");
    let a6: u32 = 2;
    let b6: u32 = 159902735;
    sys.stdout.write_u64((a6 | b6) as u64);
    sys.stdout.write("\n");
    let a7: u32 = 2;
    let b7: u32 = 0;
    sys.stdout.write_u64((a7 | b7) as u64);
    sys.stdout.write("\n");
}
