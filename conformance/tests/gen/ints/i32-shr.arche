// test: run
// spec: 7.2
// stdout: -128
// stdout: -536870912
// stdout: -528905762
// stdout: -827640
// stdout: -2
// stdout: -26484469
// stdout: -1
// stdout: -256
import std;

// i32 >> on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: i32 = -2147483647;
    let b0: u32 = 24;
    sys.stdout.write_i64((a0 >> b0) as i64);
    sys.stdout.write("\n");
    let a1: i32 = -2147483647;
    let b1: u32 = 2;
    sys.stdout.write_i64((a1 >> b1) as i64);
    sys.stdout.write("\n");
    let a2: i32 = -1057811523;
    let b2: u32 = 1;
    sys.stdout.write_i64((a2 >> b2) as i64);
    sys.stdout.write("\n");
    let a3: i32 = -1695005977;
    let b3: u32 = 11;
    sys.stdout.write_i64((a3 >> b3) as i64);
    sys.stdout.write("\n");
    let a4: i32 = -2;
    let b4: u32 = 0;
    sys.stdout.write_i64((a4 >> b4) as i64);
    sys.stdout.write("\n");
    let a5: i32 = -1695005977;
    let b5: u32 = 6;
    sys.stdout.write_i64((a5 >> b5) as i64);
    sys.stdout.write("\n");
    let a6: i32 = -2;
    let b6: u32 = 10;
    sys.stdout.write_i64((a6 >> b6) as i64);
    sys.stdout.write("\n");
    let a7: i32 = -2147483647 - 1;
    let b7: u32 = 23;
    sys.stdout.write_i64((a7 >> b7) as i64);
    sys.stdout.write("\n");
}
