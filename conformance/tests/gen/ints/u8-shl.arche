// test: run
// spec: 7.2
// stdout: 192
// stdout: 0
// stdout: 0
// stdout: 64
// stdout: 248
// stdout: 16
// stdout: 112
// stdout: 252
import std;

// u8 << on edge values; the expected results are gen.py's.
fn main(sys: &mut std.System) -> !void {
    let a0: u8 = 254;
    let b0: u32 = 5;
    sys.stdout.write_u64((a0 << b0) as u64);
    sys.stdout.write("\n");
    let a1: u8 = 128;
    let b1: u32 = 2;
    sys.stdout.write_u64((a1 << b1) as u64);
    sys.stdout.write("\n");
    let a2: u8 = 0;
    let b2: u32 = 5;
    sys.stdout.write_u64((a2 << b2) as u64);
    sys.stdout.write("\n");
    let a3: u8 = 2;
    let b3: u32 = 5;
    sys.stdout.write_u64((a3 << b3) as u64);
    sys.stdout.write("\n");
    let a4: u8 = 255;
    let b4: u32 = 3;
    sys.stdout.write_u64((a4 << b4) as u64);
    sys.stdout.write("\n");
    let a5: u8 = 1;
    let b5: u32 = 4;
    sys.stdout.write_u64((a5 << b5) as u64);
    sys.stdout.write("\n");
    let a6: u8 = 7;
    let b6: u32 = 4;
    sys.stdout.write_u64((a6 << b6) as u64);
    sys.stdout.write("\n");
    let a7: u8 = 255;
    let b7: u32 = 2;
    sys.stdout.write_u64((a7 << b7) as u64);
    sys.stdout.write("\n");
}
