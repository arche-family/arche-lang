    sys.stdout.write("\n");
    xs.push(496801);
    xs.push(22776);
    sys.stdout.write_u64(xs.items()[13]);
    sys.stdout.write("\n");
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
