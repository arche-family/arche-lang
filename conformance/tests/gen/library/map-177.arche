import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var m = alloc.Map(u64, u64).init(sys.alloc);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    match m.get(0) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
