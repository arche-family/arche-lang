// test: run
// spec: 11
// stdout: 939054
// stdout: 528901
// stdout: 30842
// stdout: 370050
// stdout: 3973485
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(375085);
    xs.push(939054);
    sys.stdout.write_u64(xs.items()[1]);
    sys.stdout.write("\n");
    xs.push(420328);
    xs.push(528901);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(370050);
    xs.push(30842);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(582817);
    xs.push(664407);
    xs.push(555248);
    xs.push(38081);
    xs.push(398465);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
