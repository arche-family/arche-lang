// test: run
// spec: 11
// stdout: 304916
// stdout: 3
// stdout: 282817
// stdout: 282817
// stdout: 5
// stdout: 7
// stdout: 326202
// stdout: 6139121
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(578799);
    xs.push(304916);
    sys.stdout.write_u64(xs.items()[1]);
    sys.stdout.write("\n");
    xs.push(282817);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[2]);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(991694);
    xs.push(500192);
    xs.push(634190);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(67181);
    xs.push(344004);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(601609);
    xs.push(523289);
    xs.push(326202);
    xs.push(309217);
    sys.stdout.write_u64(xs.items()[9]);
    sys.stdout.write("\n");
    xs.push(254714);
    xs.push(142155);
    xs.push(560959);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
