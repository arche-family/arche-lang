// test: run
// spec: 11
// stdout: 6
// stdout: 9
// stdout: 12
// stdout: 286405
// stdout: 13
// stdout: 993544
// stdout: 312305
// stdout: 8311940
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(656023);
    xs.push(592951);
    xs.push(309057);
    xs.push(133800);
    xs.push(42271);
    xs.push(490706);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(872999);
    xs.push(507932);
    xs.push(383126);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(61211);
    xs.push(794225);
    xs.push(38993);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(286405);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(647955);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(360107);
    xs.push(490915);
    xs.push(993544);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(17972);
    xs.push(312305);
    sys.stdout.write_u64(xs.items()[16]);
    sys.stdout.write("\n");
    xs.push(606073);
    xs.push(993319);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
