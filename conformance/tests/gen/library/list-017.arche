// test: run
// spec: 11
// stdout: 771977
// stdout: 737242
// stdout: 10
// stdout: 821631
// stdout: 12
// stdout: 12
// stdout: 821631
// stdout: 5461623
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(771977);
    xs.push(155887);
    xs.push(99012);
    sys.stdout.write_u64(xs.items()[0]);
    sys.stdout.write("\n");
    xs.push(737242);
    xs.push(114362);
    xs.push(286394);
    xs.push(721579);
    xs.push(311272);
    xs.push(821631);
    xs.push(202377);
    sys.stdout.write_u64(xs.items()[3]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(150318);
    xs.push(774747);
    sys.stdout.write_u64(xs.items()[8]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(314825);
    sys.stdout.write_u64(xs.items()[8]);
    sys.stdout.write("\n");
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
