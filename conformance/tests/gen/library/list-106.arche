// test: run
// spec: 11
// stdout: 669489
// stdout: 109314
// stdout: 10
// stdout: 10
// stdout: 614856
// stdout: 6381205
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(669489);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(313594);
    xs.push(130195);
    xs.push(549325);
    xs.push(683972);
    xs.push(697479);
    xs.push(430754);
    xs.push(109314);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(959346);
    xs.push(48238);
    xs.push(106726);
    xs.push(614856);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(679191);
    xs.push(205897);
    xs.push(685317);
    xs.push(795749);
    xs.push(95422);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
