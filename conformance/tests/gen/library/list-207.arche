    sys.stdout.write_u64(xs.items()[0]);
    sys.stdout.write("\n");
    xs.push(104254);
    xs.push(614483);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
