import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var m = alloc.Map(u64, u64).init(sys.alloc);
    match m.get(2) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    match m.remove(2) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match m.get(28) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match m.remove(43) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match m.get(2) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 25, value: 408776);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    m.put(key: 14, value: 865546);
    m.put(key: 12, value: 166029);
    match m.remove(14) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 32, value: 103716);
    m.put(key: 5, value: 618834);
    m.put(key: 2, value: 112295);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    match m.get(2) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 12, value: 494764);
}
