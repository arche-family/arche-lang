// test: run
// spec: 11
// stdout: none
// stdout: 3
// stdout: 4
// stdout: 4
// stdout: 808327
// stdout: 7
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var m = alloc.Map(u64, u64).init(sys.alloc);
    m.put(key: 27, value: 935927);
    m.put(key: 26, value: 648624);
    m.put(key: 16, value: 144620);
    m.put(key: 27, value: 475037);
    match m.get(45) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    m.put(key: 23, value: 755991);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    m.put(key: 23, value: 279384);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    m.put(key: 3, value: 808327);
    m.put(key: 40, value: 156939);
    m.put(key: 16, value: 206174);
    m.put(key: 27, value: 365682);
    m.put(key: 16, value: 654821);
    m.put(key: 47, value: 159008);
    m.put(key: 40, value: 850100);
    match m.get(3) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
}
