import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(401411);
    sys.stdout.write_u64(xs.items()[0]);
    sys.stdout.write("\n");
    xs.push(667102);
    xs.push(372252);
    xs.push(598525);
    xs.push(995974);
    xs.push(411042);
    xs.push(502664);
    match xs.pop() {
