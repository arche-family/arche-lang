import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(208332);
    xs.push(988331);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(842443);
    xs.push(666720);
    xs.push(246095);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(895901);
    sys.stdout.write_u64(xs.items()[1]);
    sys.stdout.write("\n");
    xs.push(174007);
    xs.push(853642);
    xs.push(868155);
    xs.push(441989);
    sys.stdout.write_u64(xs.items()[7]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[5]);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(325416);
    xs.push(819211);
    sys.stdout.write_u64(xs.items()[0]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[8]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[5]);
    sys.stdout.write("\n");
    xs.push(450703);
    sys.stdout.write_u64(xs.items()[8]);
    sys.stdout.write("\n");
    xs.push(140250);
    sys.stdout.write_u64(xs.items()[5]);
    sys.stdout.write("\n");
    xs.push(219700);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
