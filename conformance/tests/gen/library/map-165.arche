import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var m = alloc.Map(u64, u64).init(sys.alloc);
    m.put(key: 42, value: 794461);
    m.put(key: 42, value: 910252);
    match m.remove(42) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 40, value: 768122);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    m.put(key: 35, value: 511492);
    m.put(key: 3, value: 577608);
    match m.remove(11) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 30, value: 928861);
    m.put(key: 40, value: 201349);
    m.put(key: 35, value: 256400);
    m.put(key: 11, value: 152585);
    match m.get(42) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 40, value: 29392);
    match m.remove(30) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 2, value: 647673);
    match m.remove(35) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    match m.remove(9) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match m.get(40) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
}
