// test: run
// spec: 11
// stdout: 2
// stdout: 4
// stdout: 755345
// stdout: 267297
// stdout: 241670
// stdout: 511089
// stdout: 145407
// stdout: 949916
// stdout: 9
// stdout: 369173
// stdout: 3443213
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(891389);
    xs.push(145407);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(118194);
    xs.push(497698);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(755345);
    xs.push(511089);
    sys.stdout.write_u64(xs.items()[4]);
    sys.stdout.write("\n");
    xs.push(267297);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(241670);
    sys.stdout.write_u64(xs.items()[6]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[5]);
    sys.stdout.write("\n");
    xs.push(282421);
    sys.stdout.write_u64(xs.items()[1]);
    sys.stdout.write("\n");
    xs.push(369173);
    xs.push(949916);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
