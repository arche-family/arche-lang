import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(557917);
    xs.push(956251);
    sys.stdout.write_u64(xs.items()[1]);
    sys.stdout.write("\n");
    xs.push(618958);
    xs.push(218088);
    xs.push(635223);
    xs.push(892565);
    sys.stdout.write_u64(xs.items()[4]);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(991439);
    xs.push(383498);
    xs.push(476);
    xs.push(564465);
    xs.push(485104);
    xs.push(839163);
    xs.push(598365);
    xs.push(948405);
    sys.stdout.write_u64(xs.items()[2]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[11]);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(64478);
    xs.push(1445);
    xs.push(424438);
    xs.push(957009);
    xs.push(708153);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[5]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[3]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(308565);
    xs.push(687149);
    sys.stdout.write_u64(xs.items()[7]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[3]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
