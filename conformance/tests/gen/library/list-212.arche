    xs.push(917428);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(106958);
    xs.push(499629);
    xs.push(353358);
    xs.push(517642);
    xs.push(943405);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
