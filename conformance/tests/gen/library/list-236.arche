// test: run
// spec: 11
// stdout: 3
// stdout: 9
// stdout: 26169
// stdout: 8
// stdout: 140953
// stdout: 53032
// stdout: 7159606
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(477475);
    xs.push(577442);
    xs.push(873230);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(687452);
    xs.push(602611);
    xs.push(317910);
    xs.push(387177);
    xs.push(832069);
    xs.push(26169);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(53032);
    xs.push(47065);
    xs.push(140953);
    xs.push(349711);
    xs.push(325207);
    sys.stdout.write_u64(xs.items()[10]);
    sys.stdout.write("\n");
    xs.push(175294);
    sys.stdout.write_u64(xs.items()[8]);
    sys.stdout.write("\n");
    xs.push(468617);
    xs.push(844361);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
