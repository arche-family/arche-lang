    sys.stdout.write("\n");
    xs.push(976619);
    xs.push(156010);
    xs.push(961072);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(515057);
    sys.stdout.write_u64(xs.len() as u64);
