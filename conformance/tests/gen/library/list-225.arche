// test: run
// spec: 11
// stdout: 848341
// stdout: 810158
// stdout: 12
// stdout: 712652
// stdout: 401916
// stdout: 9655055
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(577429);
    xs.push(810158);
    xs.push(848341);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(740532);
    xs.push(677005);
    xs.push(732126);
    xs.push(909637);
    xs.push(427602);
    xs.push(530968);
    sys.stdout.write_u64(xs.items()[1]);
    sys.stdout.write("\n");
    xs.push(784351);
    xs.push(113718);
    xs.push(401916);
    xs.push(638480);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(712652);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(928840);
    sys.stdout.write_u64(xs.items()[10]);
    sys.stdout.write("\n");
    xs.push(535781);
    xs.push(511674);
    xs.push(334838);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
