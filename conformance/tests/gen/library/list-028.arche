import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(84312);
    xs.push(503248);
    xs.push(57121);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(865968);
    xs.push(795736);
    xs.push(487136);
    xs.push(615020);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(725465);
    xs.push(910482);
    xs.push(25363);
    sys.stdout.write_u64(xs.items()[0]);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(350882);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(911000);
    sys.stdout.write_u64(xs.items()[6]);
    sys.stdout.write("\n");
    xs.push(203749);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(706695);
    xs.push(556994);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
