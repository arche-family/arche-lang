import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var m = alloc.Map(u64, u64).init(sys.alloc);
    match m.remove(2) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 48, value: 28710);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    match m.remove(15) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match m.get(2) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match m.remove(40) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    m.put(key: 5, value: 948805);
    m.put(key: 2, value: 33322);
    match m.remove(41) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match m.get(48) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    m.put(key: 14, value: 379162);
    match m.remove(15) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match m.remove(2) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 4, value: 850349);
    match m.get(4) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 2, value: 204456);
    m.put(key: 14, value: 597689);
    m.put(key: 14, value: 873372);
}
