    match m.remove(4) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 19, value: 53144);
    m.put(key: 40, value: 711724);
    m.put(key: 41, value: 309436);
    match m.remove(42) {
        some(v) => { sys.stdout.write_u64(v); }
