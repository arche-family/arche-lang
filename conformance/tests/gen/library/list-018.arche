// test: run
// spec: 11
// stdout: 3
// stdout: 833323
// stdout: 238080
// stdout: 175655
// stdout: 681382
// stdout: 175655
// stdout: 175655
// stdout: 655664
// stdout: 4144259
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(86056);
    xs.push(526586);
    xs.push(175655);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(580573);
    xs.push(833323);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(919939);
    xs.push(681382);
    xs.push(238080);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[2]);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[2]);
    sys.stdout.write("\n");
    xs.push(285146);
    xs.push(46791);
    sys.stdout.write_u64(xs.items()[2]);
    sys.stdout.write("\n");
    xs.push(256967);
    xs.push(655664);
    xs.push(610882);
    sys.stdout.write_u64(xs.items()[8]);
    sys.stdout.write("\n");
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
