// test: run
// spec: 11
// stdout: 220102
// stdout: 143308
// stdout: 192991
// stdout: 5
// stdout: 11
// stdout: 838291
// stdout: 272702
// stdout: 11205
// stdout: 743332
// stdout: 6461328
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(578142);
    xs.push(192991);
    xs.push(143308);
    xs.push(220102);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[2]);
    sys.stdout.write("\n");
    xs.push(11205);
    xs.push(272702);
    sys.stdout.write_u64(xs.items()[1]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(863394);
    xs.push(582462);
    xs.push(42868);
    xs.push(877980);
    xs.push(838291);
    xs.push(600945);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[9]);
    sys.stdout.write("\n");
    xs.push(439455);
    xs.push(477145);
    sys.stdout.write_u64(xs.items()[4]);
    sys.stdout.write("\n");
    xs.push(743332);
    sys.stdout.write_u64(xs.items()[3]);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(451236);
    xs.push(89204);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
