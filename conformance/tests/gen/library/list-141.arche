import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(129532);
    xs.push(18058);
    xs.push(813291);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[0]);
    sys.stdout.write("\n");
    xs.push(338884);
    xs.push(218993);
    xs.push(997308);
    xs.push(391439);
    xs.push(67247);
    xs.push(5574);
    xs.push(753339);
    xs.push(255107);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(30070);
    xs.push(259857);
    xs.push(99666);
    sys.stdout.write_u64(xs.items()[8]);
    sys.stdout.write("\n");
    xs.push(41239);
    xs.push(98580);
    xs.push(195740);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[8]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(256370);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
