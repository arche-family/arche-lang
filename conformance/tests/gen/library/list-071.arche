// test: run
// spec: 11
// stdout: 501089
// stdout: 894367
// stdout: 501089
// stdout: 6
// stdout: 4293364
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(715399);
    xs.push(894367);
    xs.push(87437);
    xs.push(501089);
    sys.stdout.write_u64(xs.items()[3]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[1]);
    sys.stdout.write("\n");
    xs.push(360172);
    sys.stdout.write_u64(xs.items()[3]);
    sys.stdout.write("\n");
    xs.push(959574);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(466774);
    xs.push(109879);
    xs.push(198673);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
