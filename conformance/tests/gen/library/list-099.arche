import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(926031);
    xs.push(329676);
    xs.push(641393);
    xs.push(650893);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(848384);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[0]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[1]);
    sys.stdout.write("\n");
    xs.push(226068);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(62886);
    sys.stdout.write_u64(xs.items()[5]);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(251332);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(321129);
    xs.push(926504);
    sys.stdout.write_u64(xs.items()[3]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[1]);
    sys.stdout.write("\n");
    xs.push(407422);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(333665);
    xs.push(42856);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
