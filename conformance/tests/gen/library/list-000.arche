// test: run
// spec: 11
// stdout: 100594
// stdout: 7
// stdout: 5122461
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(100594);
    xs.push(897518);
    xs.push(236493);
    xs.push(988763);
    xs.push(723229);
    sys.stdout.write_u64(xs.items()[0]);
    sys.stdout.write("\n");
    xs.push(226070);
    xs.push(906878);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(100979);
    xs.push(941937);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
