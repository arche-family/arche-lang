import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(641577);
    xs.push(467135);
    sys.stdout.write_u64(xs.items()[1]);
    sys.stdout.write("\n");
    xs.push(360176);
    xs.push(863799);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[2]);
    sys.stdout.write("\n");
    xs.push(858619);
    xs.push(363407);
    sys.stdout.write_u64(xs.items()[4]);
    sys.stdout.write("\n");
    xs.push(406046);
    sys.stdout.write_u64(xs.items()[6]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[4]);
    sys.stdout.write("\n");
    xs.push(437724);
    xs.push(748509);
    xs.push(375789);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(816592);
    xs.push(808438);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
