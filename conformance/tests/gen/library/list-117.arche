import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(655619);
    xs.push(646815);
    xs.push(849509);
    xs.push(637812);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(42222);
    xs.push(24489);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(937426);
    xs.push(252934);
    sys.stdout.write_u64(xs.items()[4]);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(623728);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(454866);
    xs.push(133730);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(725491);
    xs.push(146068);
    xs.push(939555);
    xs.push(883310);
    xs.push(178228);
    sys.stdout.write_u64(xs.items()[10]);
    sys.stdout.write("\n");
    xs.push(780188);
    xs.push(512808);
    xs.push(422071);
    xs.push(46916);
    xs.push(477186);
    xs.push(213538);
    xs.push(133864);
    xs.push(496669);
    xs.push(50);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(372507);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
