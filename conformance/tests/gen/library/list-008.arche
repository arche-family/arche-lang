// test: run
// spec: 11
// stdout: 2
// stdout: 674597
// stdout: 123648
// stdout: 882906
// stdout: 376466
// stdout: 2
// stdout: 155717
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(123648);
    xs.push(674597);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(376466);
    xs.push(882906);
    sys.stdout.write_u64(xs.items()[0]);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(32069);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
