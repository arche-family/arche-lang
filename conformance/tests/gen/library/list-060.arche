// test: run
// spec: 11
// stdout: 2
// stdout: 210763
// stdout: 996954
// stdout: 500120
// stdout: 996954
// stdout: 4
// stdout: 520619
// stdout: 970649
// stdout: 617357
// stdout: 34737
// stdout: 1031691
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(996954);
    xs.push(210763);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[0]);
    sys.stdout.write("\n");
    xs.push(500120);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(34737);
    sys.stdout.write_u64(xs.items()[0]);
    sys.stdout.write("\n");
    xs.push(617357);
    xs.push(520619);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(970649);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(xs.items()[1]);
    sys.stdout.write("\n");
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
