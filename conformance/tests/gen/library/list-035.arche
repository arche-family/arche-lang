    sys.stdout.write_u64(xs.items()[8]);
    sys.stdout.write("\n");
    xs.push(767092);
    xs.push(88381);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(188171);
