    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(647905);
    xs.push(556524);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(663859);
    xs.push(837252);
