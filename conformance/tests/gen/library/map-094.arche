import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var m = alloc.Map(u64, u64).init(sys.alloc);
    match m.remove(5) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 18, value: 6945);
    m.put(key: 26, value: 278283);
    match m.get(18) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 5, value: 613016);
    m.put(key: 26, value: 543545);
    m.put(key: 26, value: 868069);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    match m.remove(33) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 48, value: 661941);
    m.put(key: 33, value: 508602);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    m.put(key: 7, value: 938596);
    m.put(key: 7, value: 446210);
    match m.get(24) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 0, value: 445263);
    m.put(key: 26, value: 839708);
    m.put(key: 48, value: 242045);
    match m.remove(48) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
}
