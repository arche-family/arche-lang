// test: run
// spec: 11
// stdout: none
// stdout: none
// stdout: 2
// stdout: 4
// stdout: none
// stdout: none
// stdout: 7
// stdout: none
// stdout: 488168
// stdout: 36678
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var m = alloc.Map(u64, u64).init(sys.alloc);
    m.put(key: 45, value: 513883);
    match m.remove(15) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 27, value: 36678);
    match m.get(10) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    m.put(key: 12, value: 675859);
    m.put(key: 16, value: 418746);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    m.put(key: 9, value: 488168);
    m.put(key: 45, value: 28307);
    m.put(key: 10, value: 216271);
    m.put(key: 12, value: 740716);
    match m.get(14) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match m.get(14) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 2, value: 951832);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    m.put(key: 45, value: 94534);
    m.put(key: 16, value: 809195);
    match m.get(15) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 12, value: 971303);
    match m.get(9) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match m.get(27) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
}
