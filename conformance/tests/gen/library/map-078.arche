        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 19, value: 196036);
    m.put(key: 10, value: 451160);
    m.put(key: 10, value: 179540);
    m.put(key: 5, value: 115385);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    match m.remove(32) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 7, value: 12080);
    match m.remove(38) {
