import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var m = alloc.Map(u64, u64).init(sys.alloc);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    match m.get(1) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 11, value: 939961);
    m.put(key: 38, value: 600334);
    m.put(key: 48, value: 871371);
    m.put(key: 10, value: 322463);
    match m.remove(29) {
