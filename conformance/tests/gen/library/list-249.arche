    xs.push(560084);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(261382);
    xs.push(673870);
    xs.push(594525);
    var total: u64 = 0;
