import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var m = alloc.Map(u64, u64).init(sys.alloc);
    m.put(key: 19, value: 387751);
    m.put(key: 25, value: 607805);
    match m.remove(49) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 18, value: 555143);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    m.put(key: 9, value: 984185);
    sys.stdout.write_u64(m.len() as u64);
    sys.stdout.write("\n");
    m.put(key: 44, value: 797336);
    m.put(key: 18, value: 787776);
    m.put(key: 20, value: 366858);
    m.put(key: 19, value: 891489);
    match m.get(41) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 9, value: 204363);
    m.put(key: 25, value: 20168);
    m.put(key: 25, value: 626114);
    m.put(key: 9, value: 489175);
    m.put(key: 25, value: 418073);
    match m.get(25) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match m.remove(50) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    match m.remove(13) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
}
