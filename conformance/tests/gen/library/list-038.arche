// test: run
// spec: 11
// stdout: 978684
// stdout: 698231
// stdout: 914200
// stdout: 9
// stdout: 6124446
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    xs.push(978684);
    sys.stdout.write_u64(xs.items()[0]);
    sys.stdout.write("\n");
    xs.push(214036);
    xs.push(698231);
    match xs.pop() {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    xs.push(581383);
    xs.push(326467);
    xs.push(542377);
    xs.push(519241);
    xs.push(12975);
    xs.push(914200);
    sys.stdout.write_u64(xs.items()[7]);
    sys.stdout.write("\n");
    xs.push(667387);
    sys.stdout.write_u64(xs.len() as u64);
    sys.stdout.write("\n");
    xs.push(870806);
    xs.push(496890);
    var total: u64 = 0;
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        total = total +% xs.items()[i];
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
