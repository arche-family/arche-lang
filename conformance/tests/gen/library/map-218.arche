    m.put(key: 32, value: 863634);
    match m.remove(32) {
        some(v) => { sys.stdout.write_u64(v); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
    m.put(key: 34, value: 988549);
