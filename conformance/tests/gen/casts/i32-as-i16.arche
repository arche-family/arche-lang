// test: run
// spec: 7.4
// stdout: -32768
// stdout: -32767
// stdout: -7
// stdout: -2
// stdout: -1
// stdout: 0
// stdout: 1
// stdout: 2
import std;

fn main(sys: &mut std.System) -> !void {
    let x0: i32 = -32768;
    sys.stdout.write_i64((x0 as i16) as i64);
    sys.stdout.write("\n");
    let x1: i32 = -32767;
    sys.stdout.write_i64((x1 as i16) as i64);
    sys.stdout.write("\n");
    let x2: i32 = -7;
    sys.stdout.write_i64((x2 as i16) as i64);
    sys.stdout.write("\n");
    let x3: i32 = -2;
    sys.stdout.write_i64((x3 as i16) as i64);
    sys.stdout.write("\n");
    let x4: i32 = -1;
    sys.stdout.write_i64((x4 as i16) as i64);
    sys.stdout.write("\n");
    let x5: i32 = 0;
    sys.stdout.write_i64((x5 as i16) as i64);
    sys.stdout.write("\n");
    let x6: i32 = 1;
    sys.stdout.write_i64((x6 as i16) as i64);
    sys.stdout.write("\n");
    let x7: i32 = 2;
    sys.stdout.write_i64((x7 as i16) as i64);
    sys.stdout.write("\n");
}
