// stdout: 7
// stdout: 128
// stdout: 173
// stdout: 247
import std;

fn main(sys: &mut std.System) -> !void {
    let x0: i16 = 0;
    sys.stdout.write_u64((x0 as u8) as u64);
    sys.stdout.write("\n");
    let x1: i16 = 1;
    sys.stdout.write_u64((x1 as u8) as u64);
    sys.stdout.write("\n");
    let x2: i16 = 2;
    sys.stdout.write_u64((x2 as u8) as u64);
    sys.stdout.write("\n");
    let x3: i16 = 3;
    sys.stdout.write_u64((x3 as u8) as u64);
    sys.stdout.write("\n");
    let x4: i16 = 7;
    sys.stdout.write_u64((x4 as u8) as u64);
    sys.stdout.write("\n");
    let x5: i16 = 128;
    sys.stdout.write_u64((x5 as u8) as u64);
    sys.stdout.write("\n");
    let x6: i16 = 173;
    sys.stdout.write_u64((x6 as u8) as u64);
    sys.stdout.write("\n");
    let x7: i16 = 247;
    sys.stdout.write_u64((x7 as u8) as u64);
    sys.stdout.write("\n");
}
