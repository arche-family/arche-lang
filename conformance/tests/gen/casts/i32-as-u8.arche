// test: run
// spec: 7.4
// stdout: 0
// stdout: 1
// stdout: 2
// stdout: 3
// stdout: 7
// stdout: 96
// stdout: 111
// stdout: 128
import std;

fn main(sys: &mut std.System) -> !void {
    let x0: i32 = 0;
    sys.stdout.write_u64((x0 as u8) as u64);
    sys.stdout.write("\n");
    let x1: i32 = 1;
    sys.stdout.write_u64((x1 as u8) as u64);
    sys.stdout.write("\n");
    let x2: i32 = 2;
    sys.stdout.write_u64((x2 as u8) as u64);
    sys.stdout.write("\n");
    let x3: i32 = 3;
    sys.stdout.write_u64((x3 as u8) as u64);
    sys.stdout.write("\n");
    let x4: i32 = 7;
    sys.stdout.write_u64((x4 as u8) as u64);
    sys.stdout.write("\n");
    let x5: i32 = 96;
    sys.stdout.write_u64((x5 as u8) as u64);
    sys.stdout.write("\n");
    let x6: i32 = 111;
    sys.stdout.write_u64((x6 as u8) as u64);
    sys.stdout.write("\n");
    let x7: i32 = 128;
    sys.stdout.write_u64((x7 as u8) as u64);
    sys.stdout.write("\n");
}
