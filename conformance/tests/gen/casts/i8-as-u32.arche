// test: run
// spec: 7.4
// stdout: 0
// stdout: 1
// stdout: 2
// stdout: 3
// stdout: 7
// stdout: 64
// stdout: 126
// stdout: 127
import std;

fn main(sys: &mut std.System) -> !void {
    let x0: i8 = 0;
    sys.stdout.write_u64((x0 as u32) as u64);
    sys.stdout.write("\n");
    let x1: i8 = 1;
    sys.stdout.write_u64((x1 as u32) as u64);
    sys.stdout.write("\n");
    let x2: i8 = 2;
    sys.stdout.write_u64((x2 as u32) as u64);
    sys.stdout.write("\n");
    let x3: i8 = 3;
    sys.stdout.write_u64((x3 as u32) as u64);
    sys.stdout.write("\n");
    let x4: i8 = 7;
    sys.stdout.write_u64((x4 as u32) as u64);
    sys.stdout.write("\n");
    let x5: i8 = 64;
    sys.stdout.write_u64((x5 as u32) as u64);
    sys.stdout.write("\n");
    let x6: i8 = 126;
    sys.stdout.write_u64((x6 as u32) as u64);
    sys.stdout.write("\n");
    let x7: i8 = 127;
    sys.stdout.write_u64((x7 as u32) as u64);
    sys.stdout.write("\n");
}
