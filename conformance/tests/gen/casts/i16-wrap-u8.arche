import std;

fn main(sys: &mut std.System) -> !void {
    let x0: i16 = -32767 - 1;
    sys.stdout.write_u64((x0 as% u8) as u64);
    sys.stdout.write("\n");
    let x1: i16 = -32767;
    sys.stdout.write_u64((x1 as% u8) as u64);
    sys.stdout.write("\n");
    let x2: i16 = -7;
    sys.stdout.write_u64((x2 as% u8) as u64);
    sys.stdout.write("\n");
    let x3: i16 = -2;
    sys.stdout.write_u64((x3 as% u8) as u64);
    sys.stdout.write("\n");
    let x4: i16 = -1;
    sys.stdout.write_u64((x4 as% u8) as u64);
    sys.stdout.write("\n");
    let x5: i16 = 0;
    sys.stdout.write_u64((x5 as% u8) as u64);
    sys.stdout.write("\n");
    let x6: i16 = 1;
    sys.stdout.write_u64((x6 as% u8) as u64);
    sys.stdout.write("\n");
    let x7: i16 = 2;
    sys.stdout.write_u64((x7 as% u8) as u64);
    sys.stdout.write("\n");
}
