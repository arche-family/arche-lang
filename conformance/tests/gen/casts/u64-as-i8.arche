// test: run
// spec: 7.4
// stdout: 0
// stdout: 1
// stdout: 2
// stdout: 3
// stdout: 7
// stdout: 64
// stdout: 126
// stdout: 127
import std;

fn main(sys: &mut std.System) -> !void {
    let x0: u64 = 0;
    sys.stdout.write_i64((x0 as i8) as i64);
    sys.stdout.write("\n");
    let x1: u64 = 1;
    sys.stdout.write_i64((x1 as i8) as i64);
    sys.stdout.write("\n");
    let x2: u64 = 2;
    sys.stdout.write_i64((x2 as i8) as i64);
    sys.stdout.write("\n");
    let x3: u64 = 3;
    sys.stdout.write_i64((x3 as i8) as i64);
    sys.stdout.write("\n");
    let x4: u64 = 7;
    sys.stdout.write_i64((x4 as i8) as i64);
    sys.stdout.write("\n");
    let x5: u64 = 64;
    sys.stdout.write_i64((x5 as i8) as i64);
    sys.stdout.write("\n");
    let x6: u64 = 126;
    sys.stdout.write_i64((x6 as i8) as i64);
    sys.stdout.write("\n");
    let x7: u64 = 127;
    sys.stdout.write_i64((x7 as i8) as i64);
    sys.stdout.write("\n");
}
