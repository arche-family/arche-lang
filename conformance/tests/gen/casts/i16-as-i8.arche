// test: run
// spec: 7.4
// stdout: -128
// stdout: -127
// stdout: -7
// stdout: -5
// stdout: -2
// stdout: -1
// stdout: 0
// stdout: 1
import std;

fn main(sys: &mut std.System) -> !void {
    let x0: i16 = -128;
    sys.stdout.write_i64((x0 as i8) as i64);
    sys.stdout.write("\n");
    let x1: i16 = -127;
    sys.stdout.write_i64((x1 as i8) as i64);
    sys.stdout.write("\n");
    let x2: i16 = -7;
    sys.stdout.write_i64((x2 as i8) as i64);
    sys.stdout.write("\n");
    let x3: i16 = -5;
    sys.stdout.write_i64((x3 as i8) as i64);
    sys.stdout.write("\n");
    let x4: i16 = -2;
    sys.stdout.write_i64((x4 as i8) as i64);
    sys.stdout.write("\n");
    let x5: i16 = -1;
    sys.stdout.write_i64((x5 as i8) as i64);
    sys.stdout.write("\n");
    let x6: i16 = 0;
    sys.stdout.write_i64((x6 as i8) as i64);
    sys.stdout.write("\n");
    let x7: i16 = 1;
    sys.stdout.write_i64((x7 as i8) as i64);
    sys.stdout.write("\n");
}
