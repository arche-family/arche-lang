// test: run
// spec: 7.4
// stdout: 0
// stdout: 1
// stdout: 2
// stdout: 3
// stdout: 7
// stdout: 34
// stdout: 118
// stdout: 128
import std;

fn main(sys: &mut std.System) -> !void {
    let x0: u32 = 0;
    sys.stdout.write_u64((x0 as u8) as u64);
    sys.stdout.write("\n");
    let x1: u32 = 1;
    sys.stdout.write_u64((x1 as u8) as u64);
    sys.stdout.write("\n");
    let x2: u32 = 2;
    sys.stdout.write_u64((x2 as u8) as u64);
    sys.stdout.write("\n");
    let x3: u32 = 3;
    sys.stdout.write_u64((x3 as u8) as u64);
    sys.stdout.write("\n");
    let x4: u32 = 7;
    sys.stdout.write_u64((x4 as u8) as u64);
    sys.stdout.write("\n");
    let x5: u32 = 34;
    sys.stdout.write_u64((x5 as u8) as u64);
    sys.stdout.write("\n");
    let x6: u32 = 118;
    sys.stdout.write_u64((x6 as u8) as u64);
    sys.stdout.write("\n");
    let x7: u32 = 128;
    sys.stdout.write_u64((x7 as u8) as u64);
    sys.stdout.write("\n");
}
