// test: run
// spec: 7.4
// stdout: 0
// stdout: 1
// stdout: 2
// stdout: 3
// stdout: 7
// stdout: 59
// stdout: 128
// stdout: 165
import std;

fn main(sys: &mut std.System) -> !void {
    let x0: u8 = 0;
    sys.stdout.write_u64((x0 as u64) as u64);
    sys.stdout.write("\n");
    let x1: u8 = 1;
    sys.stdout.write_u64((x1 as u64) as u64);
    sys.stdout.write("\n");
    let x2: u8 = 2;
    sys.stdout.write_u64((x2 as u64) as u64);
    sys.stdout.write("\n");
    let x3: u8 = 3;
    sys.stdout.write_u64((x3 as u64) as u64);
    sys.stdout.write("\n");
    let x4: u8 = 7;
    sys.stdout.write_u64((x4 as u64) as u64);
    sys.stdout.write("\n");
    let x5: u8 = 59;
    sys.stdout.write_u64((x5 as u64) as u64);
    sys.stdout.write("\n");
    let x6: u8 = 128;
    sys.stdout.write_u64((x6 as u64) as u64);
    sys.stdout.write("\n");
    let x7: u8 = 165;
    sys.stdout.write_u64((x7 as u64) as u64);
    sys.stdout.write("\n");
}
