// test: run
// spec: 7.4
// stdout: -32768
// stdout: -32767
// stdout: -7
// stdout: -2
// stdout: -1
// stdout: 0
// stdout: 1
// stdout: 2
import std;

fn main(sys: &mut std.System) -> !void {
    let x0: i16 = -32767 - 1;
    sys.stdout.write_i64((x0 as% i32) as i64);
    sys.stdout.write("\n");
    let x1: i16 = -32767;
    sys.stdout.write_i64((x1 as% i32) as i64);
    sys.stdout.write("\n");
    let x2: i16 = -7;
    sys.stdout.write_i64((x2 as% i32) as i64);
    sys.stdout.write("\n");
    let x3: i16 = -2;
    sys.stdout.write_i64((x3 as% i32) as i64);
    sys.stdout.write("\n");
    let x4: i16 = -1;
    sys.stdout.write_i64((x4 as% i32) as i64);
    sys.stdout.write("\n");
    let x5: i16 = 0;
    sys.stdout.write_i64((x5 as% i32) as i64);
    sys.stdout.write("\n");
    let x6: i16 = 1;
    sys.stdout.write_i64((x6 as% i32) as i64);
    sys.stdout.write("\n");
    let x7: i16 = 2;
    sys.stdout.write_i64((x7 as% i32) as i64);
    sys.stdout.write("\n");
}
