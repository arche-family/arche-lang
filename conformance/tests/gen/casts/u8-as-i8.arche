// test: run
// spec: 7.4
// stdout: 0
// stdout: 1
// stdout: 2
// stdout: 3
// stdout: 7
// stdout: 36
// stdout: 41
// stdout: 64
import std;

fn main(sys: &mut std.System) -> !void {
    let x0: u8 = 0;
    sys.stdout.write_i64((x0 as i8) as i64);
    sys.stdout.write("\n");
    let x1: u8 = 1;
    sys.stdout.write_i64((x1 as i8) as i64);
    sys.stdout.write("\n");
    let x2: u8 = 2;
    sys.stdout.write_i64((x2 as i8) as i64);
    sys.stdout.write("\n");
    let x3: u8 = 3;
    sys.stdout.write_i64((x3 as i8) as i64);
    sys.stdout.write("\n");
    let x4: u8 = 7;
    sys.stdout.write_i64((x4 as i8) as i64);
    sys.stdout.write("\n");
    let x5: u8 = 36;
    sys.stdout.write_i64((x5 as i8) as i64);
    sys.stdout.write("\n");
    let x6: u8 = 41;
    sys.stdout.write_i64((x6 as i8) as i64);
    sys.stdout.write("\n");
    let x7: u8 = 64;
    sys.stdout.write_i64((x7 as i8) as i64);
    sys.stdout.write("\n");
}
