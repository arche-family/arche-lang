// test: run
// spec: 7.4
// stdout: 0
// stdout: 1
// stdout: 2
// stdout: 3
// stdout: 7
// stdout: 128
// stdout: 129
// stdout: 253
import std;

fn main(sys: &mut std.System) -> !void {
    let x0: i64 = 0;
    sys.stdout.write_u64((x0 as u8) as u64);
    sys.stdout.write("\n");
    let x1: i64 = 1;
    sys.stdout.write_u64((x1 as u8) as u64);
    sys.stdout.write("\n");
    let x2: i64 = 2;
    sys.stdout.write_u64((x2 as u8) as u64);
    sys.stdout.write("\n");
    let x3: i64 = 3;
    sys.stdout.write_u64((x3 as u8) as u64);
    sys.stdout.write("\n");
    let x4: i64 = 7;
    sys.stdout.write_u64((x4 as u8) as u64);
    sys.stdout.write("\n");
    let x5: i64 = 128;
    sys.stdout.write_u64((x5 as u8) as u64);
    sys.stdout.write("\n");
    let x6: i64 = 129;
    sys.stdout.write_u64((x6 as u8) as u64);
    sys.stdout.write("\n");
    let x7: i64 = 253;
    sys.stdout.write_u64((x7 as u8) as u64);
    sys.stdout.write("\n");
}
