// test: run
// spec: 7.4
// stdout: -128
// stdout: -127
// stdout: -76
// stdout: -7
// stdout: -2
// stdout: -1
// stdout: 0
// stdout: 1
import std;

fn main(sys: &mut std.System) -> !void {
    let x0: i8 = -127 - 1;
    sys.stdout.write_i64((x0 as i64) as i64);
    sys.stdout.write("\n");
    let x1: i8 = -127;
    sys.stdout.write_i64((x1 as i64) as i64);
    sys.stdout.write("\n");
    let x2: i8 = -76;
    sys.stdout.write_i64((x2 as i64) as i64);
    sys.stdout.write("\n");
    let x3: i8 = -7;
    sys.stdout.write_i64((x3 as i64) as i64);
    sys.stdout.write("\n");
    let x4: i8 = -2;
    sys.stdout.write_i64((x4 as i64) as i64);
    sys.stdout.write("\n");
    let x5: i8 = -1;
    sys.stdout.write_i64((x5 as i64) as i64);
    sys.stdout.write("\n");
    let x6: i8 = 0;
    sys.stdout.write_i64((x6 as i64) as i64);
    sys.stdout.write("\n");
    let x7: i8 = 1;
    sys.stdout.write_i64((x7 as i64) as i64);
    sys.stdout.write("\n");
}
