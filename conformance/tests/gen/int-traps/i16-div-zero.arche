// test: run
// spec: 7.2
// exit: 101
// stderr: panic: division by zero
import std;

fn pass(x: i16) -> i16 {
    return x;
}

fn main(sys: &mut std.System) -> !void {
    let a: i16 = pass(7);
    let b: i16 = 0;
    let c = a / b;
    sys.stdout.write_i64(c as i64);
    sys.stdout.write("\n");
}
