// test: run
// spec: 7.2
// exit: 101
// stderr: panic: integer overflow
// stage0: skip
import std;

fn pass(x: u64) -> u64 {
    return x;
}

fn main(sys: &mut std.System) -> !void {
    let a: u64 = pass(18446744073709551615);
    let b: u64 = 1;
    let c = a + b;
    sys.stdout.write_u64(c as u64);
    sys.stdout.write("\n");
}
