// test: run
// spec: 7.2
// exit: 101
// stderr: panic: shift amount too large
import std;

fn pass(x: u64) -> u64 {
    return x;
}

fn main(sys: &mut std.System) -> !void {
    let a: u64 = pass(1);
    let b: u32 = 64;
    let c = a << b;
    sys.stdout.write_u64(c as u64);
    sys.stdout.write("\n");
}
