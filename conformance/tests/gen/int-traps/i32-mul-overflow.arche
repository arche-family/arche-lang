// test: run
// spec: 7.2
// exit: 101
// stderr: panic: integer overflow
// stage0: skip
import std;

fn pass(x: i32) -> i32 {
    return x;
}

fn main(sys: &mut std.System) -> !void {
    let a: i32 = pass(2147483647);
    let b: i32 = 2;
    let c = a * b;
    sys.stdout.write_i64(c as i64);
    sys.stdout.write("\n");
}
