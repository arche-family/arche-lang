// test: run
// spec: 7.2
// exit: 101
// stderr: panic: integer overflow
// stage0: skip
import std;

fn pass(x: u16) -> u16 {
    return x;
}

fn main(sys: &mut std.System) -> !void {
    let a: u16 = pass(0);
    let b: u16 = 1;
    let c = a - b;
    sys.stdout.write_u64(c as u64);
    sys.stdout.write("\n");
}
