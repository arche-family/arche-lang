// test: run
// spec: 7.2
// exit: 101
// stderr: panic: division by zero
import std;

fn pass(x: u32) -> u32 {
    return x;
}

fn main(sys: &mut std.System) -> !void {
    let a: u32 = pass(7);
    let b: u32 = 0;
    let c = a / b;
    sys.stdout.write_u64(c as u64);
    sys.stdout.write("\n");
}
