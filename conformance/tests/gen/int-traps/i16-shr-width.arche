// test: run
// spec: 7.2
// exit: 101
// stderr: panic: shift amount too large
import std;

fn pass(x: i16) -> i16 {
    return x;
}

fn main(sys: &mut std.System) -> !void {
    let a: i16 = pass(1);
    let b: u32 = 17;
    let c = a >> b;
    sys.stdout.write_i64(c as i64);
    sys.stdout.write("\n");
}
