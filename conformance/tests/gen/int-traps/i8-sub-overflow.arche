// test: run
// spec: 7.2
// exit: 101
// stderr: panic: integer overflow
// stage0: skip
import std;

fn pass(x: i8) -> i8 {
    return x;
}

fn main(sys: &mut std.System) -> !void {
    let a: i8 = pass(-127 - 1);
    let b: i8 = 1;
    let c = a - b;
    sys.stdout.write_i64(c as i64);
    sys.stdout.write("\n");
}
