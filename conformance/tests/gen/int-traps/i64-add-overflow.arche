// test: run
// spec: 7.2
// exit: 101
// stderr: panic: integer overflow
// stage0: skip
import std;

fn pass(x: i64) -> i64 {
    return x;
}

fn main(sys: &mut std.System) -> !void {
    let a: i64 = pass(9223372036854775807);
    let b: i64 = 1;
    let c = a + b;
    sys.stdout.write_i64(c as i64);
    sys.stdout.write("\n");
}
