// test: run
// spec: std.json
// stage0: skip
// stdout: [[[],[[-0.25,null],-0.25,["0","back\\slash"]]],false,false,{"z":{"a":[798529721,null,"0"]},"a":[],"b":"end"}]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[[[],[[-0.25,null],-0.25,[\"0\", \"back\\\\slash\"]]],false,false,{\"z\":{\"a\":[798529721,null, \"0\"]}, \"a\":[], \"b\":\"end\"}]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
