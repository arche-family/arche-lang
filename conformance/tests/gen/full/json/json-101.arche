// test: run
// spec: std.json
// stage0: skip
// stdout: [{"list":17480435,"z":[{},true,{"b":"data","id":null,"z":"q\"uote","a":true}]},{"key":{"b":true,"id":{"id":3e8,"key":false}},"a":"x","b":true},{}]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[{\"list\":17480435, \"z\":[{},true,{\"b\":\"data\", \"id\":null, \"z\":\"q\\\"uote\", \"a\":true}]},{\"key\":{\"b\":true, \"id\":{\"id\":3e8, \"key\":false}}, \"a\":\"x\", \"b\":true},{}]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
