// test: run
// spec: std.json
// stage0: skip
// stdout: {"name":{},"b":[[[107239009,1.5,null,"a b"]],{"b":[3e8,null,null,834458367],"list":{"list":false,"key":"end","id":null,"a":true},"a":[null,3e8,""]}]}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"name\":{}, \"b\":[[[107239009,1.5,null, \"a b\"]],{\"b\":[3e8,null,null,834458367], \"list\":{\"list\":false, \"key\":\"end\", \"id\":null, \"a\":true}, \"a\":[null,3e8, \"\"]}]}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
