// stage0: skip
// stdout: [[867986418,[["kent",true]]],3e8,[[87696913,[true,3e8,910338195],{"id":-0.25,"z":"arche","name":3e8}],{"b":false,"z":{"a":"end","key":"data"}}],[null,[],{}]]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[[867986418,[[\"kent\",true]]],3e8,[[87696913,[true,3e8,910338195],{\"id\":-0.25, \"z\":\"arche\", \"name\":3e8}],{\"b\":false, \"z\":{\"a\":\"end\", \"key\":\"data\"}}],[null,[],{}]]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
