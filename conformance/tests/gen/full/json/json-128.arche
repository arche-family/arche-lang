// stage0: skip
// stdout: [{"name":"arche"},[[200826422],{"id":{"a":994418151},"a":[true,null,false,null],"z":["zz","arche","arche"]}],305999219]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[{\"name\":\"arche\"},[[200826422],{\"id\":{\"a\":994418151}, \"a\":[true,null,false,null], \"z\":[\"zz\", \"arche\", \"arche\"]}],305999219]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
