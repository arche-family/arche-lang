// test: run
// spec: std.json
// stage0: skip
// stdout: {"b":[{"z":false},{"name":{"key":-0.25,"id":null},"b":{"a":false,"id":397868644,"list":"0"}},[],{"id":575321640}]}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"b\":[{\"z\":false},{\"name\":{\"key\":-0.25, \"id\":null}, \"b\":{\"a\":false, \"id\":397868644, \"list\":\"0\"}},[],{\"id\":575321640}]}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
