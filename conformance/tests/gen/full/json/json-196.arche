// test: run
// spec: std.json
// stage0: skip
// stdout: [[],{"z":[319743382],"a":{},"list":"arche"},{"id":[],"b":{},"list":{"id":{"key":false,"id":983591368}}},3e8]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[[],{\"z\":[319743382], \"a\":{}, \"list\":\"arche\"},{\"id\":[], \"b\":{}, \"list\":{\"id\":{\"key\":false, \"id\":983591368}}},3e8]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
