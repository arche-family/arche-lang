// test: run
// spec: std.json
// stage0: skip
// stdout: [{"name":[[false,118522784],{"list":"end","b":-0.25,"id":true,"z":false}]}]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[{\"name\":[[false,118522784],{\"list\":\"end\", \"b\":-0.25, \"id\":true, \"z\":false}]}]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
