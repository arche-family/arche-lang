// test: run
// spec: std.json
// stage0: skip
// stdout: [[[[false],[],[]],[true,null,{},{}],{"b":"line\nbreak","key":{},"a":[3e8,"a b"]}],false]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[[[[false],[],[]],[true,null,{},{}],{\"b\":\"line\\nbreak\", \"key\":{}, \"a\":[3e8, \"a b\"]}],false]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
