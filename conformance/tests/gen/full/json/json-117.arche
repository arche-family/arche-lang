// test: run
// spec: std.json
// stage0: skip
// stdout: [{"z":3e8,"a":null,"key":{"a":true},"name":[]},{"b":[]},[null,true],[[[false,503902361,false,true],{"id":""},{},245288755],[[424314573,"q\"uote"],{"id":555419993},{}]]]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[{\"z\":3e8, \"a\":null, \"key\":{\"a\":true}, \"name\":[]},{\"b\":[]},[null,true],[[[false,503902361,false,true],{\"id\":\"\"},{},245288755],[[424314573, \"q\\\"uote\"],{\"id\":555419993},{}]]]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
