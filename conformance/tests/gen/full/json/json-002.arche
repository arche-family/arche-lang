// test: run
// spec: std.json
// stage0: skip
// stdout: {"key":[907365978,true],"a":{},"name":1.5}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"key\":[907365978,true], \"a\":{}, \"name\":1.5}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
