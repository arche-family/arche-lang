// test: run
// spec: std.json
// stage0: skip
// stdout: {"b":[],"id":3e8,"key":true,"z":[{"a":525236820,"key":[]},{},null]}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"b\":[], \"id\":3e8, \"key\":true, \"z\":[{\"a\":525236820, \"key\":[]},{},null]}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
