// test: run
// spec: std.json
// stage0: skip
// stdout: [{"id":[],"z":[{"id":null},[true,true]],"list":{"a":{"b":true,"id":null}},"name":[null,true]}]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[{\"id\":[], \"z\":[{\"id\":null},[true,true]], \"list\":{\"a\":{\"b\":true, \"id\":null}}, \"name\":[null,true]}]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
