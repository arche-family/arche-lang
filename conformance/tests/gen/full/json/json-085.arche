// test: run
// spec: std.json
// stage0: skip
// stdout: [[{"id":{"b":false,"name":false,"a":null,"z":826907754},"name":false,"a":{"a":true}}],[]]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[[{\"id\":{\"b\":false, \"name\":false, \"a\":null, \"z\":826907754}, \"name\":false, \"a\":{\"a\":true}}],[]]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
