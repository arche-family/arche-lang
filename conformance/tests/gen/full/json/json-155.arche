// test: run
// spec: std.json
// stage0: skip
// stdout: [false,{"a":1.5,"id":{},"name":{"z":["data","longer word",true,"tosh"],"a":false},"z":623540882}]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[false,{\"a\":1.5, \"id\":{}, \"name\":{\"z\":[\"data\", \"longer word\",true, \"tosh\"], \"a\":false}, \"z\":623540882}]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
