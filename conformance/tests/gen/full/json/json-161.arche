// test: run
// spec: std.json
// stage0: skip
// stdout: [[[{"list":null},{"id":"end","key":false,"a":3e8,"b":false},[],[]],{"z":{"z":null,"id":18666702,"name":null},"key":{"a":false,"b":false,"name":false,"list":false},"list":[]},476631684,{}],3e8]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[[[{\"list\":null},{\"id\":\"end\", \"key\":false, \"a\":3e8, \"b\":false},[],[]],{\"z\":{\"z\":null, \"id\":18666702, \"name\":null}, \"key\":{\"a\":false, \"b\":false, \"name\":false, \"list\":false}, \"list\":[]},476631684,{}],3e8]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
