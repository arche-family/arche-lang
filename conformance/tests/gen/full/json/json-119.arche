// test: run
// spec: std.json
// stage0: skip
// stdout: {"name":{"z":[[-0.25,true,1.5]],"name":null,"id":990330115}}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"name\":{\"z\":[[-0.25,true,1.5]], \"name\":null, \"id\":990330115}}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
