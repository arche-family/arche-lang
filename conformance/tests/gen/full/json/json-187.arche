// test: run
// spec: std.json
// stage0: skip
// stdout: {"a":[{},{"key":[918146330,null],"a":{"list":-0.25}}],"key":[1.5,{"a":1.5,"z":[true,3e8,164568061,1.5]},{},null]}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"a\":[{},{\"key\":[918146330,null], \"a\":{\"list\":-0.25}}], \"key\":[1.5,{\"a\":1.5, \"z\":[true,3e8,164568061,1.5]},{},null]}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
