// test: run
// spec: std.json
// stage0: skip
// stdout: {"name":{"b":[true,[true,"longer word",null],[null,false]]},"a":true}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"name\":{\"b\":[true,[true, \"longer word\",null],[null,false]]}, \"a\":true}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
