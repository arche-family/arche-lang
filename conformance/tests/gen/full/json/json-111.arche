// test: run
// spec: std.json
// stage0: skip
// stdout: [true,[["data",[],{"list":null,"a":false},[]],null,[]],{"b":true,"name":false,"key":[[null],"",{"list":1.5,"name":false,"z":false,"key":false},null],"z":null},true]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[true,[[\"data\",[],{\"list\":null, \"a\":false},[]],null,[]],{\"b\":true, \"name\":false, \"key\":[[null], \"\",{\"list\":1.5, \"name\":false, \"z\":false, \"key\":false},null], \"z\":null},true]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
