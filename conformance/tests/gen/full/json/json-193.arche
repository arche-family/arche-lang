// test: run
// spec: std.json
// stage0: skip
// stdout: [{"b":768629084,"name":3e8,"id":"line\nbreak"},{"key":{"key":[null],"name":false,"b":{"list":1.5,"b":"end","id":false}},"z":[]},[[{"name":598774657,"a":null,"list":1.5}]]]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[{\"b\":768629084, \"name\":3e8, \"id\":\"line\\nbreak\"},{\"key\":{\"key\":[null], \"name\":false, \"b\":{\"list\":1.5, \"b\":\"end\", \"id\":false}}, \"z\":[]},[[{\"name\":598774657, \"a\":null, \"list\":1.5}]]]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
