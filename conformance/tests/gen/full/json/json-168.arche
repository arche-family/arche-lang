// test: run
// spec: std.json
// stage0: skip
// stdout: [{},{"name":false,"id":[],"b":{"a":null},"key":false}]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[{},{\"name\":false, \"id\":[], \"b\":{\"a\":null}, \"key\":false}]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
