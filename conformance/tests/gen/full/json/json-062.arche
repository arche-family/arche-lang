// test: run
// spec: std.json
// stage0: skip
// stdout: [{"list":[1.5,"tosh",-0.25,[null]]},904791632,[null],false]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[{\"list\":[1.5, \"tosh\",-0.25,[null]]},904791632,[null],false]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
