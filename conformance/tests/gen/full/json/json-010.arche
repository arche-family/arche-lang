// test: run
// spec: std.json
// stage0: skip
// stdout: [false,[[[864208222],[false,1.5]]],true,"end"]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[false,[[[864208222],[false,1.5]]],true, \"end\"]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
