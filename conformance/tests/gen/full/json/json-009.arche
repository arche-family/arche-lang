// test: run
// spec: std.json
// stage0: skip
// stdout: {"list":271097133,"z":{"id":{"name":{"key":"data"}}}}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"list\":271097133, \"z\":{\"id\":{\"name\":{\"key\":\"data\"}}}}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
