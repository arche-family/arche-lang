// test: run
// spec: std.json
// stage0: skip
// stdout: [false,[{"a":{"z":null,"a":"tosh"},"id":[3e8]},{"list":{"list":false,"b":-0.25,"name":96137464,"z":false},"z":false,"name":[3e8,-0.25]}]]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[false,[{\"a\":{\"z\":null, \"a\":\"tosh\"}, \"id\":[3e8]},{\"list\":{\"list\":false, \"b\":-0.25, \"name\":96137464, \"z\":false}, \"z\":false, \"name\":[3e8,-0.25]}]]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
