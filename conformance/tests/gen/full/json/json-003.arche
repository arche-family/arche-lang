// test: run
// spec: std.json
// stage0: skip
// stdout: {"b":"longer word","key":[440978957,[[3e8,"0","data"]],{"b":"tosh","a":[null]},false]}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"b\":\"longer word\", \"key\":[440978957,[[3e8, \"0\", \"data\"]],{\"b\":\"tosh\", \"a\":[null]},false]}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
