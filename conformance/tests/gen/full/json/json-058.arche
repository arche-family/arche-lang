// test: run
// spec: std.json
// stage0: skip
// stdout: {"list":{"list":{"key":{"z":true,"name":1.5},"a":[false],"name":[null,"zz",1.5]},"z":[["arche",null,true]],"id":247177245},"a":{"key":[],"z":[{},{"z":570574505,"b":"zz","a":null}],"a":[]}}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"list\":{\"list\":{\"key\":{\"z\":true, \"name\":1.5}, \"a\":[false], \"name\":[null, \"zz\",1.5]}, \"z\":[[\"arche\",null,true]], \"id\":247177245}, \"a\":{\"key\":[], \"z\":[{},{\"z\":570574505, \"b\":\"zz\", \"a\":null}], \"a\":[]}}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
