// test: run
// spec: std.json
// stage0: skip
// stdout: {"id":{"id":[true,{"b":null},null],"key":"kent"}}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"id\":{\"id\":[true,{\"b\":null},null], \"key\":\"kent\"}}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
