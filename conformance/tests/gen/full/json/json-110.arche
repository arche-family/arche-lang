import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[{\"key\":[null,[3e8,336853402,783791349,-0.25]]},[],{\"list\":[-0.25,-0.25,[392891902]]},575561720]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
