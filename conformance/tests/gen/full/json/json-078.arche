// test: run
// spec: std.json
// stage0: skip
// stdout: {"z":[[[null,null],["0",3e8,null,1.5],true],[{"key":true,"a":null,"list":1.5},{"name":1.5},[1.5]]],"a":"line\nbreak","id":false}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"z\":[[[null,null],[\"0\",3e8,null,1.5],true],[{\"key\":true, \"a\":null, \"list\":1.5},{\"name\":1.5},[1.5]]], \"a\":\"line\\nbreak\", \"id\":false}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
