// test: run
// spec: std.json
// stage0: skip
// stdout: [[{"list":["kent"],"id":true},{"a":[682430746],"id":["end",false]},{"z":{"a":-0.25,"key":-0.25}}]]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[[{\"list\":[\"kent\"], \"id\":true},{\"a\":[682430746], \"id\":[\"end\",false]},{\"z\":{\"a\":-0.25, \"key\":-0.25}}]]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
