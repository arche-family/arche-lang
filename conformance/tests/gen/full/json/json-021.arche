// test: run
// spec: std.json
// stage0: skip
// stdout: [{"id":{"name":{"id":false,"b":"0","list":"longer word"},"z":[],"b":{"key":-0.25,"b":"q\"uote","a":false},"id":{"list":true,"id":true,"b":3e8,"name":null}},"a":[591177491,["q\"uote"]],"b":{},"list":false},false,{},[true]]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[{\"id\":{\"name\":{\"id\":false, \"b\":\"0\", \"list\":\"longer word\"}, \"z\":[], \"b\":{\"key\":-0.25, \"b\":\"q\\\"uote\", \"a\":false}, \"id\":{\"list\":true, \"id\":true, \"b\":3e8, \"name\":null}}, \"a\":[591177491,[\"q\\\"uote\"]], \"b\":{}, \"list\":false},false,{},[true]]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
