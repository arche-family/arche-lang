// test: run
// spec: std.json
// stage0: skip
// stdout: {"a":[[[false,true,false,"x"],false]],"id":{"z":210228335,"list":629650506,"key":[{},[],957667783]},"name":{"list":1.5}}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"a\":[[[false,true,false, \"x\"],false]], \"id\":{\"z\":210228335, \"list\":629650506, \"key\":[{},[],957667783]}, \"name\":{\"list\":1.5}}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
