// test: run
// spec: std.json
// stage0: skip
// stdout: ["line\nbreak",[549204483,[[true,null,"longer word"],334405385],{},[false,[null],[],-0.25]]]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[\"line\\nbreak\",[549204483,[[true,null, \"longer word\"],334405385],{},[false,[null],[],-0.25]]]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
