// test: run
// spec: std.json
// stage0: skip
// stdout: [true,{"a":[true]},{"id":"data","a":{"key":{}},"list":[{"name":"tosh","z":3e8,"key":820986871},null,[null,false,true,1.5]]},[]]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[true,{\"a\":[true]},{\"id\":\"data\", \"a\":{\"key\":{}}, \"list\":[{\"name\":\"tosh\", \"z\":3e8, \"key\":820986871},null,[null,false,true,1.5]]},[]]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
