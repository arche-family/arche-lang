// test: run
// spec: std.json
// stage0: skip
// stdout: {"z":{"b":false},"b":[{},{"b":[1.5,-0.25,"","0"],"list":{"name":995748800,"key":null}}]}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"z\":{\"b\":false}, \"b\":[{},{\"b\":[1.5,-0.25, \"\", \"0\"], \"list\":{\"name\":995748800, \"key\":null}}]}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
