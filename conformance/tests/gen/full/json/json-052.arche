// test: run
// spec: std.json
// stage0: skip
// stdout: {"z":{"a":[{}],"name":null,"b":[null,null],"id":[["tosh",false],[]]},"id":{}}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"z\":{\"a\":[{}], \"name\":null, \"b\":[null,null], \"id\":[[\"tosh\",false],[]]}, \"id\":{}}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
