// test: run
// spec: std.json
// stage0: skip
// stdout: {"list":[[{"key":null}],[[true,null,null],{"key":"longer word"},{"b":-0.25,"key":true,"list":true},{"b":null,"list":null,"id":true}],[]]}
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("{\"list\":[[{\"key\":null}],[[true,null,null],{\"key\":\"longer word\"},{\"b\":-0.25, \"key\":true, \"list\":true},{\"b\":null, \"list\":null, \"id\":true}],[]]}", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
