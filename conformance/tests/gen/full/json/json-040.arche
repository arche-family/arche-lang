// test: run
// spec: std.json
// stage0: skip
// stdout: [[{"b":{"key":true},"key":[false,"",367893881,false],"z":true}],{"key":"x","a":[]}]
import alloc;
import std;
import std.json;

fn main(sys: &mut std.System) -> !void {
    let v = try json.parse("[[{\"b\":{\"key\":true}, \"key\":[false, \"\",367893881,false], \"z\":true}],{\"key\":\"x\", \"a\":[]}]", sys.alloc);
    var out = alloc.String.init(sys.alloc);
    json.write(&v, out: &mut out);
    sys.stdout.write(out.view());
    sys.stdout.write("\n");
}
