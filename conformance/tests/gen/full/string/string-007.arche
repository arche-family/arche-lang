// test: run
// spec: 11
// stage0: skip
// stdout: 4
// stdout: 5
// stdout: no
// stdout: no
// stdout: no
// stdout: 31
// stdout: 32
// stdout: [a byz-9167end47150longer word_0xkent]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("a b");
    s.push_ascii('y');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('z');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('-');
    s.push_u64(9167);
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("");
    s.push_str("");
    s.push_str("end");
    s.push_u64(4715);
    s.push_str("");
    s.push_str("0");
    s.push_str("longer word");
    s.push_str("");
    s.push_ascii('_');
    s.push_str("0");
    if s.view().starts_with("tosh") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("0") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("x");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("kent");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
