// test: run
// spec: 11
// stage0: skip
// stdout: 20
// stdout: 20
// stdout: 25
// stdout: no
// stdout: 40
// stdout: yes
// stdout: [longer worddataarche8765xa bx622.end150_end9458longer word]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("longer word");
    s.push_str("data");
    s.push_str("arche");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_u64(8765);
    s.push_ascii('x');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    if s.view().starts_with("data") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("a b");
    s.push_str("x");
    s.push_u64(622);
    s.push_ascii('.');
    s.push_str("end");
    s.push_u64(150);
    s.push_ascii('_');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("end");
    if s.view().starts_with("longer word") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_u64(9458);
    s.push_str("longer word");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
