import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("0");
    s.push_ascii('x');
    s.push_ascii('x');
    s.push_ascii('c');
    s.push_ascii('z');
    s.push_u64(2635);
    s.push_str("data");
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("");
    s.push_u64(9713);
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("0");
    s.push_str("data");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
