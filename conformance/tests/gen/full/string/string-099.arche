// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: 13
// stdout: [kent4403arche_kenttosh614x]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("kent");
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_u64(4403);
    s.push_str("arche");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('_');
    s.push_str("kent");
    s.push_str("tosh");
    s.push_u64(614);
    s.push_ascii('x');
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
