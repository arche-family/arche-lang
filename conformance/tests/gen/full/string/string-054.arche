// test: run
// spec: 11
// stage0: skip
// stdout: 45
// stdout: [a b67709666a blonger worda b1674a b5621arche0]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("a b");
    s.push_u64(6770);
    s.push_u64(9666);
    s.push_str("a b");
    s.push_str("longer word");
    s.push_str("a b");
    s.push_u64(1674);
    s.push_str("a b");
    s.push_str("");
    s.push_u64(5621);
    s.push_str("");
    s.push_str("arche");
    s.push_str("0");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
