// stdout: 26
// stdout: 35
// stdout: 46
// stdout: [zzzztosharchekentzza b6202tosha b0za b92519003tosh]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("zz");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("zz");
    s.push_str("tosh");
    s.push_str("arche");
    s.push_str("kent");
    s.push_str("zz");
    s.push_str("a b");
    if s.view().starts_with("x") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_u64(6202);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("tosh");
    s.push_str("a b");
    s.push_str("0");
    s.push_ascii('z');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("a b");
    s.push_u64(9251);
    s.push_u64(9003);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("tosh");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
