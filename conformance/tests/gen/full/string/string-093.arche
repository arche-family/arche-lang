// test: run
// spec: 11
// stage0: skip
// stdout: 8
// stdout: [9248a bcarche0yaa4386archelonger worda bkentdata]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_u64(9248);
    s.push_str("a b");
    s.push_ascii('c');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("arche");
    s.push_str("0");
    s.push_ascii('y');
    s.push_str("");
    s.push_ascii('a');
    s.push_ascii('a');
    s.push_u64(4386);
    s.push_str("arche");
    s.push_str("longer word");
    s.push_str("a b");
    s.push_str("kent");
    s.push_str("data");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
