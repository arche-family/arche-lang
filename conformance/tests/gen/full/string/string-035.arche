// test: run
// spec: 11
// stage0: skip
// stdout: 5
// stdout: 5
// stdout: 11
// stdout: 18
// stdout: yes
// stdout: [archedatabxbendend8659]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("arche");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("data");
    s.push_ascii('b');
    s.push_str("x");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('b');
    s.push_str("end");
    s.push_str("end");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_u64(8659);
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
