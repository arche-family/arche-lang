// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: 29
// stdout: [archeb06069toshzzarchea b2623a bx]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("arche");
    s.push_ascii('b');
    if s.view().starts_with("x") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("");
    s.push_str("0");
    s.push_u64(6069);
    s.push_str("tosh");
    s.push_str("zz");
    s.push_str("arche");
    s.push_str("a b");
    s.push_u64(2623);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("a b");
    s.push_str("x");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
