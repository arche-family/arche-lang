// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: no
// stdout: 6
// stdout: no
// stdout: [zz7077zz00kent72403299zz]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    if s.view().starts_with("arche") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("zz");
    if s.view().starts_with("a b") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_u64(7077);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("zz");
    s.push_str("0");
    s.push_str("0");
    if s.view().starts_with("kent") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("kent");
    s.push_u64(7240);
    s.push_u64(3299);
    s.push_str("zz");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
