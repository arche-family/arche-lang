// test: run
// spec: 11
// stage0: skip
// stdout: 4
// stdout: yes
// stdout: 4
// stdout: no
// stdout: [toshxenddatakentkentytosh9508zendendlonger wordtosh]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("tosh");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("x");
    s.push_str("end");
    s.push_str("data");
    s.push_str("kent");
    s.push_str("kent");
    s.push_ascii('y');
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("tosh");
    s.push_u64(9508);
    s.push_ascii('z');
    s.push_str("end");
    s.push_str("end");
    s.push_str("longer word");
    s.push_str("tosh");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
