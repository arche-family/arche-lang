// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: no
// stdout: no
// stdout: [end3512archez24835290datazzx]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    if s.view().starts_with("arche") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("arche") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("end");
    s.push_u64(3512);
    s.push_str("arche");
    s.push_ascii('z');
    s.push_u64(2483);
    s.push_u64(5290);
    s.push_str("data");
    s.push_str("zz");
    s.push_ascii('x');
    if s.view().starts_with("0") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
