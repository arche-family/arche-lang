// test: run
// spec: 11
// stage0: skip
// stdout: 24
// stdout: 25
// stdout: 45
// stdout: no
// stdout: [dataarchekentlonger wordxdata-xzzlonger wordy7526]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("data");
    s.push_str("arche");
    s.push_str("kent");
    s.push_str("longer word");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("x");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("data");
    s.push_ascii('-');
    s.push_str("");
    s.push_ascii('x');
    s.push_str("zz");
    s.push_str("longer word");
    s.push_ascii('y');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    if s.view().starts_with("longer word") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_u64(7526);
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
