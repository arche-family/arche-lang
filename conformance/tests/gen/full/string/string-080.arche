// test: run
// spec: 11
// stage0: skip
// stdout: yes
// stdout: [.toshzzzarcheendxdatabxzz52813963a]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_ascii('.');
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("tosh");
    s.push_ascii('z');
    s.push_str("zz");
    s.push_str("arche");
    s.push_str("end");
    s.push_str("x");
    s.push_str("data");
    s.push_ascii('b');
    s.push_str("x");
    s.push_str("zz");
    s.push_u64(5281);
    s.push_u64(3963);
    s.push_ascii('a');
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
