// test: run
// spec: 11
// stage0: skip
// stdout: [longer word2661428707259tosh6358a b]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("longer word");
    s.push_u64(2661);
    s.push_u64(4287);
    s.push_str("0");
    s.push_u64(7259);
    s.push_str("tosh");
    s.push_u64(6358);
    s.push_str("a b");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
