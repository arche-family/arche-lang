// test: run
// spec: 11
// stage0: skip
// stdout: 22
// stdout: no
// stdout: [xxend44403989x31180a bx]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_ascii('x');
    s.push_str("x");
    s.push_str("end");
    s.push_u64(4440);
    s.push_u64(3989);
    s.push_ascii('x');
    s.push_u64(3118);
    s.push_str("0");
    s.push_str("a b");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("x");
    if s.view().starts_with("longer word") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
