import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    if s.view().starts_with("a b") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('z');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("arche");
    s.push_u64(4855);
    s.push_str("end");
    s.push_u64(6997);
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('z');
    s.push_str("arche");
    s.push_str("data");
    s.push_ascii('-');
    s.push_ascii('y');
    s.push_u64(2064);
    s.push_str("kent");
    s.push_str("");
    if s.view().starts_with("tosh") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("0");
    if s.view().starts_with("end") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_u64(2961);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    if s.view().starts_with("data") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("arche") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("zz");
    s.push_str("a b");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
