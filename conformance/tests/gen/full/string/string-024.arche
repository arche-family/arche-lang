// test: run
// spec: 11
// stage0: skip
// stdout: 9
// stdout: 16
// stdout: no
// stdout: no
// stdout: 20
// stdout: 42
// stdout: 47
// stdout: 49
// stdout: no
// stdout: [archea bzendtoshtoshlonger wordendtosh9671-3523azaarche]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("arche");
    s.push_str("a b");
    s.push_ascii('z');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("end");
    s.push_str("tosh");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    if s.view().starts_with("kent") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("longer word") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("tosh");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("longer word");
    s.push_str("end");
    s.push_str("tosh");
    s.push_u64(9671);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('-');
    s.push_u64(3523);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('a');
    s.push_ascii('z');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('a');
    s.push_str("arche");
    if s.view().starts_with("data") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
