// test: run
// spec: 11
// stage0: skip
// stdout: 20
// stdout: 42
// stdout: [datakentkentenddatablonger wordlonger wordczza b7490]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("data");
    s.push_str("kent");
    s.push_str("kent");
    s.push_str("end");
    s.push_str("data");
    s.push_ascii('b');
    s.push_str("");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("longer word");
    s.push_str("longer word");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('c');
    s.push_str("zz");
    s.push_str("a b");
    s.push_u64(7490);
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
