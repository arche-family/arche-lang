// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: no
// stdout: 28
// stdout: 38
// stdout: [longer word.3735kenttoshend.4278archeakent]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("longer word");
    if s.view().starts_with("arche") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('.');
    s.push_u64(3735);
    s.push_str("kent");
    s.push_str("tosh");
    s.push_str("end");
    s.push_ascii('.');
    s.push_str("");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_u64(4278);
    s.push_str("arche");
    s.push_ascii('a');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("kent");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
