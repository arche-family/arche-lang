// test: run
// spec: 11
// stage0: skip
// stdout: yes
// stdout: no
// stdout: [ca bendaendxzztoshzz3324]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('c');
    s.push_str("a b");
    s.push_str("end");
    s.push_ascii('a');
    s.push_str("end");
    if s.view().starts_with("end") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("x");
    s.push_str("zz");
    s.push_str("tosh");
    s.push_str("zz");
    s.push_u64(3324);
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
