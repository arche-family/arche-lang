// test: run
// spec: 11
// stage0: skip
// stdout: 12
// stdout: yes
// stdout: no
// stdout: 27
// stdout: 52
// stdout: 59
// stdout: [alonger wordlonger wordx0zz9105a btosh69alonger worda bkent]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_ascii('a');
    s.push_str("longer word");
    s.push_str("");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("longer word");
    s.push_str("x");
    if s.view().starts_with("al") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("0");
    s.push_str("zz");
    if s.view().starts_with("a b") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_u64(9105);
    s.push_str("a b");
    s.push_str("tosh");
    s.push_u64(69);
    s.push_ascii('a');
    s.push_str("longer word");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("a b");
    s.push_str("kent");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
