// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: no
// stdout: [y439107420024543longer wordkent-06902kentarche-end]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_ascii('y');
    s.push_u64(439);
    if s.view().starts_with("end") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_u64(1074);
    s.push_u64(2002);
    s.push_u64(4543);
    s.push_str("longer word");
    s.push_str("kent");
    s.push_ascii('-');
    s.push_str("0");
    s.push_u64(6902);
    s.push_str("kent");
    s.push_str("arche");
    if s.view().starts_with("a b") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('-');
    s.push_str("end");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
