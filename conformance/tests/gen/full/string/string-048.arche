// stdout: [bzzendzxb_dataarche72192478toshx217toshkentend]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    if s.view().starts_with("tosh") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('b');
    s.push_str("zz");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("end");
    if s.view().starts_with("a b") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('z');
    s.push_str("x");
    s.push_ascii('b');
    s.push_ascii('_');
    s.push_str("");
    s.push_str("data");
    s.push_str("arche");
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_u64(7219);
    s.push_u64(2478);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("tosh");
    s.push_ascii('x');
    s.push_u64(217);
    s.push_str("tosh");
    s.push_str("kent");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("end");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
