// stdout: [kent02687a b943arche2190blonger wordxbkent8089archelonger wordlonger word]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("kent");
    s.push_str("0");
    s.push_u64(2687);
    s.push_str("a b");
    s.push_u64(943);
    s.push_str("arche");
    s.push_u64(2190);
    if s.view().starts_with("end") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('b');
    s.push_str("longer word");
    s.push_str("x");
    s.push_ascii('b');
    s.push_str("kent");
    s.push_u64(8089);
    s.push_str("arche");
    s.push_str("longer word");
    if s.view().starts_with("x") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("arche") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("longer word");
    if s.view().starts_with("end") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
