// test: run
// spec: 11
// stage0: skip
// stdout: 3
// stdout: no
// stdout: 4
// stdout: 16
// stdout: [__ycxdataendkentca bkent]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_ascii('_');
    s.push_ascii('_');
    s.push_ascii('y');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    if s.view().starts_with("arche") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('c');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('x');
    s.push_str("data");
    s.push_str("end");
    s.push_str("kent");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('c');
    s.push_str("a b");
    s.push_str("kent");
    s.push_str("");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
