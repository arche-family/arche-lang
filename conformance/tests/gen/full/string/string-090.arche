// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: 13
// stdout: no
// stdout: [6217kentkentbx_zzz]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_u64(6217);
    s.push_str("kent");
    s.push_str("kent");
    if s.view().starts_with("x") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('b');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('x');
    s.push_ascii('_');
    s.push_ascii('z');
    if s.view().starts_with("data") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("zz");
    s.push_str("");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
