// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: no
// stdout: [cxlonger wordzz3255toshendtosh0xz]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    if s.view().starts_with("0") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('c');
    s.push_str("");
    s.push_str("x");
    if s.view().starts_with("tosh") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("longer word");
    s.push_str("");
    s.push_str("zz");
    s.push_u64(3255);
    s.push_str("tosh");
    s.push_str("end");
    s.push_str("tosh");
    s.push_str("0");
    s.push_str("x");
    s.push_ascii('z');
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
