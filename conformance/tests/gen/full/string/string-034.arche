// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: no
// stdout: 10
// stdout: 10
// stdout: 10
// stdout: 30
// stdout: yes
// stdout: [xbdatakentc8621828arche_zzxendtosh]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("x");
    s.push_ascii('b');
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("0") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("data");
    s.push_str("kent");
    s.push_str("");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('c');
    s.push_u64(862);
    s.push_u64(1828);
    s.push_str("arche");
    s.push_ascii('_');
    s.push_str("zz");
    s.push_str("x");
    s.push_str("end");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    if s.view().starts_with("xbdatakentc") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("tosh");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
