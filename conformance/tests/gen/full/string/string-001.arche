import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_ascii('z');
    if s.view().starts_with("longer word") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("a b");
    s.push_str("data");
    s.push_str("tosh");
    s.push_str("end");
    s.push_str("end");
    s.push_str("0");
    s.push_ascii('_');
    s.push_ascii('y');
    s.push_str("zz");
    s.push_str("");
    s.push_str("");
    s.push_str("arche");
    s.push_u64(5422);
    s.push_u64(5881);
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
