// test: run
// spec: 11
// stage0: skip
// stdout: yes
// stdout: no
// stdout: no
// stdout: [bbarche8343arche2674end167kentarchezztosh]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_ascii('b');
    s.push_ascii('b');
    s.push_str("");
    s.push_str("arche");
    s.push_u64(8343);
    s.push_str("arche");
    s.push_u64(2674);
    if s.view().starts_with("bbarche8343ar") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("end");
    s.push_u64(167);
    if s.view().starts_with("tosh") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("kent");
    s.push_str("arche");
    if s.view().starts_with("end") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("zz");
    s.push_str("tosh");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
