// test: run
// spec: 11
// stage0: skip
// stdout: 5
// stdout: yes
// stdout: 22
// stdout: 22
// stdout: 22
// stdout: [4755x_longer wordx8183data9014315y6825.c]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_u64(4755);
    s.push_str("x");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('_');
    s.push_str("longer word");
    if s.view().starts_with("47") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("x");
    s.push_u64(8183);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("data");
    s.push_u64(901);
    s.push_u64(4315);
    s.push_ascii('y');
    s.push_u64(6825);
    s.push_ascii('.');
    s.push_ascii('c');
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
