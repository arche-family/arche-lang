// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: 1
// stdout: [y-enda bdatac]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    if s.view().starts_with("x") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('y');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('-');
    s.push_str("end");
    s.push_str("a b");
    s.push_str("");
    s.push_str("data");
    s.push_ascii('c');
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
