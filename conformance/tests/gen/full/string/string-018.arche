// test: run
// spec: 11
// stage0: skip
// stdout: 5
// stdout: yes
// stdout: yes
// stdout: 22
// stdout: 32
// stdout: [archea b0-endarchetoshendzzarche]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("arche");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("a b");
    s.push_str("0");
    s.push_str("");
    s.push_ascii('-');
    if s.view().starts_with("arche") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("end");
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("arche");
    s.push_str("tosh");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("end");
    s.push_str("zz");
    s.push_str("arche");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
