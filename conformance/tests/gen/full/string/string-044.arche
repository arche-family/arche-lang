// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: no
// stdout: 36
// stdout: yes
// stdout: no
// stdout: [archez3080longer word_a bkentend7789zzczz0data]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("arche");
    s.push_ascii('z');
    s.push_u64(3080);
    s.push_str("longer word");
    if s.view().starts_with("longer word") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('_');
    s.push_str("a b");
    if s.view().starts_with("x") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("kent");
    s.push_str("end");
    s.push_u64(7789);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("");
    s.push_str("zz");
    s.push_ascii('c');
    s.push_str("");
    s.push_str("zz");
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("x") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("0");
    s.push_str("data");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
