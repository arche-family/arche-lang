// test: run
// spec: 11
// stage0: skip
// stdout: 0
// stdout: [8861cdataarchelonger word066202610toshdata5734]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_u64(8861);
    s.push_ascii('c');
    s.push_str("data");
    s.push_str("arche");
    s.push_str("longer word");
    s.push_str("0");
    s.push_u64(6620);
    s.push_u64(2610);
    s.push_str("tosh");
    s.push_str("data");
    s.push_u64(5734);
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
