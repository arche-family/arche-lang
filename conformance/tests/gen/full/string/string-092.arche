// test: run
// spec: 11
// stage0: skip
// stdout: 0
// stdout: 4
// stdout: 8
// stdout: no
// stdout: yes
// stdout: [3630kentxendz3269kent0kentarche]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_u64(3630);
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("kent");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    if s.view().starts_with("longer word") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('x');
    s.push_str("end");
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('z');
    s.push_u64(3269);
    s.push_str("kent");
    s.push_str("0");
    s.push_str("");
    s.push_str("kent");
    s.push_str("arche");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
