// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: no
// stdout: 9
// stdout: no
// stdout: yes
// stdout: 39
// stdout: [7481xcendc9710arche4116zzlonger wordend]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_u64(7481);
    s.push_str("x");
    s.push_ascii('c');
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("end");
    if s.view().starts_with("end") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('c');
    if s.view().starts_with("x") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_u64(9710);
    s.push_str("arche");
    s.push_u64(4116);
    s.push_str("zz");
    s.push_str("longer word");
    s.push_str("end");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
