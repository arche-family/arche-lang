// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: yes
// stdout: no
// stdout: [datay.arche5565zz95432873_xcarchekentz126end]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("data");
    s.push_ascii('y');
    s.push_ascii('.');
    s.push_str("arche");
    s.push_u64(5565);
    s.push_str("zz");
    s.push_u64(9543);
    s.push_u64(2873);
    s.push_str("");
    s.push_ascii('_');
    if s.view().starts_with("end") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("x");
    s.push_ascii('c');
    if s.view().starts_with("datay.arche5565zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("0") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("arche");
    s.push_str("kent");
    s.push_ascii('z');
    s.push_u64(126);
    s.push_str("end");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
