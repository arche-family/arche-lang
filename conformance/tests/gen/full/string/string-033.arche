// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: [end3829-1605arche0a bc1243zz]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("end");
    s.push_u64(3829);
    s.push_ascii('-');
    s.push_u64(1605);
    s.push_str("arche");
    s.push_str("0");
    s.push_str("a b");
    s.push_ascii('c');
    s.push_u64(1243);
    s.push_str("zz");
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
