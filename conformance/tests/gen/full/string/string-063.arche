// test: run
// spec: 11
// stage0: skip
// stdout: 3
// stdout: yes
// stdout: [a bend65833553longer word0]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("a b");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("end");
    s.push_u64(6583);
    s.push_u64(3553);
    s.push_str("longer word");
    if s.view().starts_with("a bend") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("0");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
