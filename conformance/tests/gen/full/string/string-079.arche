// test: run
// spec: 11
// stage0: skip
// stdout: [zz2447zz0--yzz45491949yzz]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("zz");
    s.push_u64(2447);
    s.push_str("zz");
    s.push_str("0");
    s.push_ascii('-');
    s.push_ascii('-');
    s.push_ascii('y');
    s.push_str("zz");
    s.push_u64(4549);
    s.push_u64(1949);
    s.push_ascii('y');
    s.push_str("zz");
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
