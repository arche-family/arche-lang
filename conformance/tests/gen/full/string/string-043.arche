import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("");
    if s.view().starts_with("kent") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_u64(2674);
    s.push_str("tosh");
    s.push_str("data");
    s.push_str("arche");
    s.push_str("data");
    if s.view().starts_with("a b") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("");
    s.push_ascii('.');
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("x");
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_u64(1149);
    s.push_str("0");
    s.push_u64(5137);
    sys.stdout.write("[");
    sys.stdout.write(s.view());
