// test: run
// spec: 11
// stage0: skip
// stdout: yes
// stdout: no
// stdout: no
// stdout: no
// stdout: no
// stdout: no
// stdout: yes
// stdout: [longer worda5554a btosh28778200zzyendzzarchetosh]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("longer word") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("longer word");
    s.push_str("");
    if s.view().starts_with("0") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('a');
    s.push_u64(5554);
    s.push_str("a b");
    s.push_str("tosh");
    s.push_u64(2877);
    s.push_u64(8200);
    s.push_str("zz");
    s.push_ascii('y');
    s.push_str("end");
    if s.view().starts_with("end") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("zz");
    s.push_str("arche");
    s.push_str("tosh");
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
