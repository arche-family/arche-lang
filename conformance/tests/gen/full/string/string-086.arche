// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: 9
// stdout: no
// stdout: [endarche_a b5404]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("");
    s.push_str("end");
    s.push_str("arche");
    s.push_ascii('_');
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("a b");
    if s.view().starts_with("data") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_u64(5404);
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
