// test: run
// spec: 11
// stage0: skip
// stdout: no
// stdout: no
// stdout: 14
// stdout: 14
// stdout: 34
// stdout: [_255c655b185905950longer wordarche5981]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_ascii('_');
    s.push_u64(255);
    s.push_ascii('c');
    s.push_u64(655);
    s.push_ascii('b');
    if s.view().starts_with("0") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("arche") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_u64(1859);
    s.push_str("0");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("");
    s.push_u64(5950);
    s.push_str("longer word");
    s.push_str("arche");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_u64(5981);
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
