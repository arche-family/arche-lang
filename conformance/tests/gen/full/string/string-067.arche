// stdout: [x1574zz--_4319xa barchexalonger wordarchezxa2737]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    if s.view().starts_with("x") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("x");
    s.push_u64(1574);
    s.push_str("zz");
    s.push_ascii('-');
    s.push_ascii('-');
    s.push_ascii('_');
    s.push_u64(4319);
    s.push_str("x");
    s.push_str("a b");
    s.push_str("arche");
    s.push_ascii('x');
    s.push_ascii('a');
    s.push_str("longer word");
    s.push_str("arche");
    if s.view().starts_with("longer word") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    if s.view().starts_with("0") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('z');
    if s.view().starts_with("arche") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_ascii('x');
    if s.view().starts_with("zz") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_ascii('a');
    s.push_u64(2737);
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
