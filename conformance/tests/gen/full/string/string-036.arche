// test: run
// spec: 11
// stage0: skip
// stdout: 3
// stdout: 3
// stdout: yes
// stdout: no
// stdout: [a b0zz8647archezzlonger wordtoshdataa b]
import alloc;
import std;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    s.push_str("a b");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
    s.push_str("0");
    s.push_str("zz");
    s.push_u64(8647);
    s.push_str("arche");
    s.push_str("zz");
    s.push_str("longer word");
    s.push_str("tosh");
    s.push_str("data");
    if s.view().starts_with("") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    s.push_str("a b");
    if s.view().starts_with("tosh") { sys.stdout.write("yes\n"); } else { sys.stdout.write("no\n"); }
    sys.stdout.write("[");
    sys.stdout.write(s.view());
    sys.stdout.write("]\n");
}
