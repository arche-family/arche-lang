// test: run
// spec: web
// stage0: skip
// stdout: 4 p0=users rest=api
// stdout: 405
// stdout: 405
// stdout: 2
// stdout: 2
// stdout: 405
import http;
import std;
import web;

fn show(sys: &mut std.System, found: web.Found, params: &web.Params) {
    match found {
        .Route { route } => {
            sys.stdout.write_u64(route as u64);
            var i: usize = 0;
            while i < params.len() : (i += 1) {
                sys.stdout.write(" ");
                sys.stdout.write(params.names_at(i));
                sys.stdout.write("=");
                sys.stdout.write(params.value(i));
            }
        }
        .WrongMethod => { sys.stdout.write("405"); }
        .NotFound => { sys.stdout.write("404"); }
    }
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    var r = web.Router.init(sys.alloc);
    _ = r.add(method: "GET", pattern: "/:p0/b/*rest");
    _ = r.add(method: "GET", pattern: "/v1");
    _ = r.add(method: "POST", pattern: "/v1");
    _ = r.add(method: "GET", pattern: "/api/b/:p2");
    _ = r.add(method: "GET", pattern: "/:p0/*rest");
    _ = r.add(method: "GET", pattern: "/a/:p1/b");
    var params = web.Params.init(sys.alloc);
    var q0 = http.Request.init(sys.alloc);
    q0.method.push_str("GET");
    q0.target.push_str("/users/api");
    show(sys, found: r.find(&q0, params: &mut params), params: &params);
    var q1 = http.Request.init(sys.alloc);
    q1.method.push_str("POST");
    q1.target.push_str("/v1/v1");
    show(sys, found: r.find(&q1, params: &mut params), params: &params);
    var q2 = http.Request.init(sys.alloc);
    q2.method.push_str("POST");
    q2.target.push_str("/a/users");
    show(sys, found: r.find(&q2, params: &mut params), params: &params);
    var q3 = http.Request.init(sys.alloc);
    q3.method.push_str("POST");
    q3.target.push_str("/v1");
    show(sys, found: r.find(&q3, params: &mut params), params: &params);
    var q4 = http.Request.init(sys.alloc);
    q4.method.push_str("POST");
    q4.target.push_str("/v1");
    show(sys, found: r.find(&q4, params: &mut params), params: &params);
    var q5 = http.Request.init(sys.alloc);
    q5.method.push_str("PUT");
    q5.target.push_str("/7/b/deep/er");
    show(sys, found: r.find(&q5, params: &mut params), params: &params);
}
