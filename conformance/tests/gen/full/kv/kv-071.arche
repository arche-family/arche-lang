// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: v865756
// stdout: v865756
// stdout: none
// stdout: v387950
// stdout: v200749
// stdout: v387950
// stdout: k12
// stdout: k24
// stdout: k39
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-071-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.put(key: "k25".bytes(), value: "v396628".bytes());
    try db.put(key: "k00".bytes(), value: "v615397".bytes());
    try db.put(key: "k20".bytes(), value: "v904069".bytes());
    try db.put(key: "k00".bytes(), value: "v739202".bytes());
    try db.put(key: "k24".bytes(), value: "v239520".bytes());
    try db.put(key: "k12".bytes(), value: "v387950".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.commit();
    try db.put(key: "k00".bytes(), value: "v706432".bytes());
    try db.put(key: "k20".bytes(), value: "v196868".bytes());
    try db.put(key: "k20".bytes(), value: "v387824".bytes());
    _ = try db.delete("k20".bytes());
    try db.put(key: "k39".bytes(), value: "v865756".bytes());
    if try db.get("k39".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k39".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k39".bytes());
    try db.put(key: "k25".bytes(), value: "v525011".bytes());
    try db.put(key: "k39".bytes(), value: "v895717".bytes());
    if try db.get("k08".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k00".bytes(), value: "v741474".bytes());
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k25".bytes(), value: "v200749".bytes());
    if try db.get("k25".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k25".bytes(), value: "v578185".bytes());
    _ = try db.delete("k00".bytes());
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k19".bytes());
    _ = try db.delete("k25".bytes());
    try db.put(key: "k04".bytes(), value: "v313728".bytes());
    _ = try db.delete("k04".bytes());
    try db.commit();
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
