// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: v359017
// stdout: v342226
// stdout: v342226
// stdout: v359017
// stdout: v342226
// stdout: v100473
// stdout: none
// stdout: k14
// stdout: k23
// stdout: k25
// stdout: k30
// stdout: k32
// stdout: k34
// stdout: k35
// stdout: k39
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-069-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k01".bytes(), value: "v100473".bytes());
    try db.put(key: "k25".bytes(), value: "v342226".bytes());
    try db.put(key: "k30".bytes(), value: "v523080".bytes());
    if try db.get("k08".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k38".bytes(), value: "v94490".bytes());
    try db.put(key: "k38".bytes(), value: "v684977".bytes());
    try db.put(key: "k32".bytes(), value: "v81069".bytes());
    try db.put(key: "k34".bytes(), value: "v922264".bytes());
    _ = try db.delete("k08".bytes());
    try db.put(key: "k39".bytes(), value: "v359017".bytes());
    try db.put(key: "k30".bytes(), value: "v168703".bytes());
    try db.put(key: "k38".bytes(), value: "v694770".bytes());
    try db.commit();
    try db.put(key: "k23".bytes(), value: "v105658".bytes());
    _ = try db.delete("k38".bytes());
    if try db.get("k39".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k35".bytes(), value: "v872770".bytes());
    try db.put(key: "k30".bytes(), value: "v515990".bytes());
    if try db.get("k25".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k32".bytes());
    if try db.get("k25".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k39".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.put(key: "k30".bytes(), value: "v708480".bytes());
    try db.put(key: "k30".bytes(), value: "v264024".bytes());
    try db.put(key: "k34".bytes(), value: "v299343".bytes());
    if try db.get("k25".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k01".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k01".bytes());
    try db.put(key: "k25".bytes(), value: "v31189".bytes());
    if try db.get("k29".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k23".bytes(), value: "v598686".bytes());
    try db.put(key: "k32".bytes(), value: "v873188".bytes());
    try db.put(key: "k14".bytes(), value: "v776046".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
