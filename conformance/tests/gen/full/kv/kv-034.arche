// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: v325176
// stdout: v210654
// stdout: none
// stdout: v657157
// stdout: k01
// stdout: k06
// stdout: k12
// stdout: k14
// stdout: k18
// stdout: k19
// stdout: k21
// stdout: k31
// stdout: k40
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-034-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    _ = try db.delete("k18".bytes());
    try db.put(key: "k21".bytes(), value: "v325176".bytes());
    if try db.get("k21".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k30".bytes(), value: "v255296".bytes());
    try db.commit();
    try db.put(key: "k14".bytes(), value: "v930161".bytes());
    try db.put(key: "k19".bytes(), value: "v210654".bytes());
    if try db.get("k19".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k18".bytes(), value: "v768902".bytes());
    try db.put(key: "k21".bytes(), value: "v983049".bytes());
    try db.put(key: "k31".bytes(), value: "v403279".bytes());
    try db.put(key: "k30".bytes(), value: "v564478".bytes());
    try db.put(key: "k40".bytes(), value: "v885765".bytes());
    _ = try db.delete("k12".bytes());
    try db.put(key: "k30".bytes(), value: "v168842".bytes());
    if try db.get("k37".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k30".bytes(), value: "v406555".bytes());
    try db.put(key: "k01".bytes(), value: "v954792".bytes());
    try db.put(key: "k30".bytes(), value: "v958160".bytes());
    try db.put(key: "k40".bytes(), value: "v998646".bytes());
    _ = try db.delete("k21".bytes());
    try db.put(key: "k21".bytes(), value: "v123153".bytes());
    try db.put(key: "k30".bytes(), value: "v13871".bytes());
    try db.put(key: "k19".bytes(), value: "v265820".bytes());
    try db.put(key: "k12".bytes(), value: "v657157".bytes());
    _ = try db.delete("k30".bytes());
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k19".bytes(), value: "v728083".bytes());
    try db.put(key: "k21".bytes(), value: "v246273".bytes());
    try db.put(key: "k06".bytes(), value: "v9900".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
