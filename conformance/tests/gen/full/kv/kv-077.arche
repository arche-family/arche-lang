    try db.put(key: "k38".bytes(), value: "v35218".bytes());
    try db.put(key: "k35".bytes(), value: "v643875".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k25".bytes(), value: "v612540".bytes());
    try db.put(key: "k06".bytes(), value: "v352666".bytes());
    try db.put(key: "k22".bytes(), value: "v331126".bytes());
    try db.put(key: "k04".bytes(), value: "v844193".bytes());
    try db.commit();
    if try db.get("k35".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k35".bytes(), value: "v811303".bytes());
    try db.put(key: "k37".bytes(), value: "v124926".bytes());
    try db.commit();
    _ = try db.delete("k06".bytes());
    try db.commit();
    try db.put(key: "k23".bytes(), value: "v872487".bytes());
    try db.commit();
    try db.commit();
    _ = try db.delete("k04".bytes());
    try db.put(key: "k38".bytes(), value: "v698648".bytes());
    _ = try db.delete("k39".bytes());
