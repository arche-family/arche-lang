// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: v95732
// stdout: none
// stdout: none
// stdout: none
// stdout: v939311
// stdout: v559983
// stdout: v559983
// stdout: v241179
// stdout: none
// stdout: v939311
// stdout: k13
// stdout: k15
// stdout: k20
// stdout: k21
// stdout: k27
// stdout: k33
// stdout: k34
// stdout: k37
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-074-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k15".bytes(), value: "v413221".bytes());
    try db.put(key: "k13".bytes(), value: "v95732".bytes());
    try db.put(key: "k27".bytes(), value: "v178305".bytes());
    if try db.get("k13".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.commit();
    try db.put(key: "k20".bytes(), value: "v559983".bytes());
    try db.put(key: "k27".bytes(), value: "v415104".bytes());
    _ = try db.delete("k27".bytes());
    if try db.get("k27".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k04".bytes(), value: "v704604".bytes());
    try db.put(key: "k13".bytes(), value: "v856491".bytes());
    if try db.get("k33".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k15".bytes(), value: "v241179".bytes());
    _ = try db.delete("k21".bytes());
    if try db.get("k27".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k04".bytes());
    try db.put(key: "k27".bytes(), value: "v939311".bytes());
    try db.put(key: "k37".bytes(), value: "v454685".bytes());
    if try db.get("k27".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k20".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k37".bytes());
    if try db.get("k20".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k15".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.put(key: "k33".bytes(), value: "v350959".bytes());
    if try db.get("k04".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k27".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k37".bytes(), value: "v352528".bytes());
    try db.put(key: "k21".bytes(), value: "v740153".bytes());
    try db.put(key: "k34".bytes(), value: "v802482".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
