// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: none
// stdout: v977557
// stdout: none
// stdout: none
// stdout: v230102
// stdout: k16
// stdout: k17
// stdout: k20
// stdout: k24
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-022-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.commit();
    if try db.get("k25".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k36".bytes());
    if try db.get("k30".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.commit();
    try db.put(key: "k36".bytes(), value: "v977557".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.commit();
    if try db.get("k36".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k17".bytes(), value: "v116639".bytes());
    try db.put(key: "k16".bytes(), value: "v418265".bytes());
    _ = try db.delete("k36".bytes());
    try db.put(key: "k24".bytes(), value: "v197537".bytes());
    _ = try db.delete("k30".bytes());
    _ = try db.delete("k24".bytes());
    try db.commit();
    try db.put(key: "k17".bytes(), value: "v589747".bytes());
    if try db.get("k38".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k36".bytes());
    _ = try db.delete("k20".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k36".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k20".bytes(), value: "v472452".bytes());
    try db.put(key: "k24".bytes(), value: "v230102".bytes());
    if try db.get("k24".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k17".bytes(), value: "v375134".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
