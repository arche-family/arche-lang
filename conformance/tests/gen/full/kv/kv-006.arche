// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: none
// stdout: none
// stdout: none
// stdout: none
// stdout: v736325
// stdout: k01
// stdout: k02
// stdout: k19
// stdout: k23
// stdout: k37
// stdout: k40
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-006-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    if try db.get("k35".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k35".bytes(), value: "v40651".bytes());
    if try db.get("k02".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k40".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k02".bytes(), value: "v703591".bytes());
    _ = try db.delete("k38".bytes());
    if try db.get("k40".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k35".bytes(), value: "v574667".bytes());
    try db.put(key: "k19".bytes(), value: "v212248".bytes());
    try db.commit();
    if try db.get("k01".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k18".bytes(), value: "v863284".bytes());
    try db.commit();
    try db.put(key: "k35".bytes(), value: "v991061".bytes());
    try db.put(key: "k37".bytes(), value: "v806483".bytes());
    if try db.get("k21".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k01".bytes(), value: "v736325".bytes());
    try db.put(key: "k40".bytes(), value: "v44608".bytes());
    try db.put(key: "k18".bytes(), value: "v105037".bytes());
    try db.put(key: "k35".bytes(), value: "v897073".bytes());
    try db.put(key: "k35".bytes(), value: "v100406".bytes());
    _ = try db.delete("k40".bytes());
    if try db.get("k01".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k35".bytes(), value: "v661162".bytes());
    try db.put(key: "k40".bytes(), value: "v272084".bytes());
    try db.commit();
    _ = try db.delete("k35".bytes());
    _ = try db.delete("k35".bytes());
    try db.put(key: "k01".bytes(), value: "v927185".bytes());
    try db.commit();
    _ = try db.delete("k18".bytes());
    try db.put(key: "k23".bytes(), value: "v707786".bytes());
    try db.put(key: "k40".bytes(), value: "v549365".bytes());
    try db.put(key: "k19".bytes(), value: "v408525".bytes());
    _ = try db.delete("k18".bytes());
    try db.put(key: "k23".bytes(), value: "v673617".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
