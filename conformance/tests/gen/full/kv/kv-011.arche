// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: none
// stdout: none
// stdout: v770529
// stdout: k02
// stdout: k06
// stdout: k10
// stdout: k16
// stdout: k17
// stdout: k20
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-011-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.commit();
    try db.commit();
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k06".bytes(), value: "v105901".bytes());
    try db.put(key: "k10".bytes(), value: "v424225".bytes());
    if try db.get("k19".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k06".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k16".bytes(), value: "v913355".bytes());
    if try db.get("k06".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k06".bytes());
    try db.put(key: "k16".bytes(), value: "v293143".bytes());
    try db.put(key: "k20".bytes(), value: "v276061".bytes());
    try db.put(key: "k02".bytes(), value: "v919254".bytes());
    _ = try db.delete("k20".bytes());
    try db.put(key: "k20".bytes(), value: "v631114".bytes());
    try db.put(key: "k20".bytes(), value: "v149840".bytes());
    try db.put(key: "k06".bytes(), value: "v612755".bytes());
    if try db.get("k11".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k29".bytes(), value: "v984904".bytes());
    try db.put(key: "k33".bytes(), value: "v988296".bytes());
    try db.put(key: "k10".bytes(), value: "v913123".bytes());
    try db.put(key: "k17".bytes(), value: "v826385".bytes());
    try db.commit();
    try db.put(key: "k06".bytes(), value: "v770529".bytes());
    try db.put(key: "k29".bytes(), value: "v330596".bytes());
    _ = try db.delete("k15".bytes());
    try db.commit();
    _ = try db.delete("k20".bytes());
    try db.put(key: "k17".bytes(), value: "v637061".bytes());
    try db.put(key: "k16".bytes(), value: "v926585".bytes());
    _ = try db.delete("k33".bytes());
    if try db.get("k06".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k29".bytes());
    try db.put(key: "k20".bytes(), value: "v951346".bytes());
    try db.put(key: "k20".bytes(), value: "v498188".bytes());
    try db.put(key: "k02".bytes(), value: "v838858".bytes());
    try db.put(key: "k20".bytes(), value: "v524693".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
