import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-003-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.put(key: "k25".bytes(), value: "v756537".bytes());
    try db.put(key: "k25".bytes(), value: "v370480".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k07".bytes(), value: "v894909".bytes());
    try db.put(key: "k01".bytes(), value: "v210457".bytes());
    try db.commit();
    _ = try db.delete("k07".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k07".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k28".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    if try db.get("k00".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k04".bytes());
    try db.put(key: "k01".bytes(), value: "v457129".bytes());
    try db.put(key: "k26".bytes(), value: "v336588".bytes());
    try db.put(key: "k28".bytes(), value: "v586350".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k33".bytes(), value: "v550694".bytes());
    try db.put(key: "k34".bytes(), value: "v24680".bytes());
    _ = try db.delete("k04".bytes());
    if try db.get("k07".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k33".bytes(), value: "v317472".bytes());
    try db.put(key: "k07".bytes(), value: "v553225".bytes());
    try db.put(key: "k02".bytes(), value: "v42609".bytes());
    try db.put(key: "k34".bytes(), value: "v696394".bytes());
    try db.put(key: "k07".bytes(), value: "v359101".bytes());
    try db.commit();
    _ = try db.delete("k02".bytes());
    try db.commit();
    try db.put(key: "k09".bytes(), value: "v636964".bytes());
    try db.commit();
    try db.put(key: "k28".bytes(), value: "v257210".bytes());
    if try db.get("k03".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k33".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k25".bytes());
    try db.put(key: "k01".bytes(), value: "v833748".bytes());
    try db.put(key: "k01".bytes(), value: "v467512".bytes());
    try db.put(key: "k07".bytes(), value: "v367661".bytes());
    if try db.get("k40".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.put(key: "k31".bytes(), value: "v903584".bytes());
    if try db.get("k03".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k07".bytes(), value: "v789104".bytes());
    try db.put(key: "k33".bytes(), value: "v59868".bytes());
    try db.put(key: "k01".bytes(), value: "v762331".bytes());
    try db.put(key: "k40".bytes(), value: "v410298".bytes());
    try db.put(key: "k28".bytes(), value: "v25984".bytes());
    if try db.get("k04".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k34".bytes(), value: "v388937".bytes());
    try db.put(key: "k40".bytes(), value: "v520607".bytes());
    try db.put(key: "k31".bytes(), value: "v102460".bytes());
    try db.put(key: "k09".bytes(), value: "v461403".bytes());
    if try db.get("k33".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k34".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k03".bytes(), value: "v278788".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
