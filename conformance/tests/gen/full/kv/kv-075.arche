// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: none
// stdout: none
// stdout: none
// stdout: v515086
// stdout: v274994
// stdout: v720009
// stdout: none
// stdout: v438926
// stdout: k05
// stdout: k08
// stdout: k10
// stdout: k13
// stdout: k14
// stdout: k30
// stdout: k32
// stdout: k37
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-075-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.put(key: "k30".bytes(), value: "v16741".bytes());
    try db.put(key: "k30".bytes(), value: "v782633".bytes());
    try db.commit();
    try db.commit();
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k14".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k31".bytes(), value: "v567241".bytes());
    _ = try db.delete("k27".bytes());
    if try db.get("k10".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k10".bytes(), value: "v515086".bytes());
    _ = try db.delete("k31".bytes());
    if try db.get("k32".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k05".bytes(), value: "v774699".bytes());
    try db.put(key: "k14".bytes(), value: "v178236".bytes());
    try db.put(key: "k30".bytes(), value: "v530381".bytes());
    if try db.get("k31".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k13".bytes(), value: "v274994".bytes());
    try db.put(key: "k08".bytes(), value: "v126232".bytes());
    try db.put(key: "k14".bytes(), value: "v666042".bytes());
    if try db.get("k10".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k30".bytes(), value: "v788175".bytes());
    try db.put(key: "k31".bytes(), value: "v720009".bytes());
    try db.put(key: "k32".bytes(), value: "v4187".bytes());
    if try db.get("k13".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k31".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k05".bytes(), value: "v540371".bytes());
    try db.put(key: "k31".bytes(), value: "v357464".bytes());
    try db.put(key: "k31".bytes(), value: "v544929".bytes());
    try db.put(key: "k37".bytes(), value: "v600227".bytes());
    _ = try db.delete("k31".bytes());
    try db.put(key: "k05".bytes(), value: "v438926".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k31".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k05".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
