    try db.put(key: "k40".bytes(), value: "v528142".bytes());
    try db.put(key: "k30".bytes(), value: "v780221".bytes());
    if try db.get("k29".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k03".bytes(), value: "v848442".bytes());
    try db.put(key: "k40".bytes(), value: "v901054".bytes());
    try db.put(key: "k22".bytes(), value: "v820583".bytes());
    try db.put(key: "k20".bytes(), value: "v430204".bytes());
    if try db.get("k14".bytes(), value: &mut value) {
