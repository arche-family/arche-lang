    try db.put(key: "k16".bytes(), value: "v653282".bytes());
    _ = try db.delete("k11".bytes());
    _ = try db.delete("k15".bytes());
    if try db.get("k29".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k36".bytes());
    if try db.get("k36".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k15".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k02".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k02".bytes(), value: "v871195".bytes());
    if try db.get("k20".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k15".bytes(), value: "v515658".bytes());
    _ = try db.delete("k17".bytes());
    if try db.get("k36".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k20".bytes(), value: "v868824".bytes());
    try db.put(key: "k15".bytes(), value: "v177250".bytes());
    if try db.get("k20".bytes(), value: &mut value) {
