    try db.put(key: "k02".bytes(), value: "v499543".bytes());
    try db.put(key: "k15".bytes(), value: "v629226".bytes());
    try db.put(key: "k40".bytes(), value: "v755281".bytes());
    if try db.get("k16".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.put(key: "k02".bytes(), value: "v835033".bytes());
    _ = try db.delete("k22".bytes());
    try db.commit();
    try db.put(key: "k20".bytes(), value: "v424815".bytes());
    try db.put(key: "k16".bytes(), value: "v885341".bytes());
    if try db.get("k17".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
