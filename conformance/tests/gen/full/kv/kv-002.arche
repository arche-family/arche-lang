import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-002-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    _ = try db.delete("k07".bytes());
    try db.put(key: "k39".bytes(), value: "v648821".bytes());
    _ = try db.delete("k02".bytes());
    try db.put(key: "k37".bytes(), value: "v74889".bytes());
    if try db.get("k31".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k37".bytes(), value: "v761193".bytes());
    _ = try db.delete("k18".bytes());
    try db.put(key: "k20".bytes(), value: "v50993".bytes());
    if try db.get("k07".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k21".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k08".bytes(), value: "v607445".bytes());
    if try db.get("k16".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k16".bytes(), value: "v162905".bytes());
    try db.put(key: "k20".bytes(), value: "v624819".bytes());
    try db.put(key: "k07".bytes(), value: "v416474".bytes());
    _ = try db.delete("k10".bytes());
    try db.commit();
    try db.commit();
    if try db.get("k31".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k37".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k21".bytes());
    try db.put(key: "k07".bytes(), value: "v401306".bytes());
    try db.put(key: "k02".bytes(), value: "v490891".bytes());
    _ = try db.delete("k37".bytes());
    try db.put(key: "k31".bytes(), value: "v181033".bytes());
    try db.put(key: "k18".bytes(), value: "v598553".bytes());
    try db.put(key: "k18".bytes(), value: "v920408".bytes());
    try db.put(key: "k07".bytes(), value: "v263593".bytes());
    try db.put(key: "k22".bytes(), value: "v500992".bytes());
    try db.put(key: "k07".bytes(), value: "v642882".bytes());
    try db.put(key: "k39".bytes(), value: "v15865".bytes());
    try db.put(key: "k39".bytes(), value: "v145499".bytes());
    if try db.get("k02".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k18".bytes(), value: "v769772".bytes());
    if try db.get("k18".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k10".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k16".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k08".bytes(), value: "v632427".bytes());
    try db.put(key: "k39".bytes(), value: "v941694".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k02".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    if try db.get("k21".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
