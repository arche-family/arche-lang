// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: v194813
// stdout: v241322
// stdout: k06
// stdout: k10
// stdout: k19
// stdout: k21
// stdout: k23
// stdout: k26
// stdout: k29
// stdout: k32
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-016-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.put(key: "k19".bytes(), value: "v801723".bytes());
    try db.put(key: "k05".bytes(), value: "v962936".bytes());
    try db.put(key: "k29".bytes(), value: "v276479".bytes());
    if try db.get("k23".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k26".bytes(), value: "v723699".bytes());
    _ = try db.delete("k32".bytes());
    try db.put(key: "k23".bytes(), value: "v968319".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k29".bytes(), value: "v155804".bytes());
    try db.put(key: "k21".bytes(), value: "v261039".bytes());
    try db.commit();
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k23".bytes(), value: "v417598".bytes());
    try db.put(key: "k10".bytes(), value: "v194813".bytes());
    if try db.get("k10".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k29".bytes(), value: "v241322".bytes());
    try db.put(key: "k06".bytes(), value: "v53330".bytes());
    try db.put(key: "k32".bytes(), value: "v480497".bytes());
    try db.put(key: "k32".bytes(), value: "v904320".bytes());
    try db.put(key: "k26".bytes(), value: "v333152".bytes());
    _ = try db.delete("k05".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k29".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k23".bytes(), value: "v98531".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
