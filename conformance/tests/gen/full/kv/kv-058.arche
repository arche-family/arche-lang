import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-058-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k21".bytes(), value: "v828831".bytes());
    try db.commit();
    if try db.get("k21".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k27".bytes(), value: "v845428".bytes());
    if try db.get("k28".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    if try db.get("k10".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k23".bytes(), value: "v778718".bytes());
    try db.put(key: "k10".bytes(), value: "v666450".bytes());
    try db.put(key: "k10".bytes(), value: "v650024".bytes());
    try db.put(key: "k28".bytes(), value: "v711844".bytes());
    try db.put(key: "k35".bytes(), value: "v929271".bytes());
    if try db.get("k35".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k08".bytes(), value: "v913135".bytes());
    _ = try db.delete("k23".bytes());
    try db.commit();
    if try db.get("k10".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k30".bytes());
    try db.put(key: "k10".bytes(), value: "v878935".bytes());
    try db.put(key: "k23".bytes(), value: "v733198".bytes());
    try db.put(key: "k02".bytes(), value: "v868613".bytes());
    if try db.get("k02".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k23".bytes());
    try db.put(key: "k08".bytes(), value: "v133098".bytes());
    try db.put(key: "k10".bytes(), value: "v587144".bytes());
    if try db.get("k28".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    if try db.get("k08".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k10".bytes(), value: "v294571".bytes());
    if try db.get("k10".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k10".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
