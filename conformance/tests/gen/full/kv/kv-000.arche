    try db.put(key: "k10".bytes(), value: "v726559".bytes());
    try db.put(key: "k08".bytes(), value: "v519214".bytes());
    if try db.get("k07".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k10".bytes());
    _ = try db.delete("k00".bytes());
    if try db.get("k08".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k15".bytes());
    try db.put(key: "k11".bytes(), value: "v744112".bytes());
    if try db.get("k08".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k13".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k08".bytes(), value: "v974906".bytes());
    if try db.get("k03".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k03".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
