        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k11".bytes(), value: "v600005".bytes());
    try db.put(key: "k08".bytes(), value: "v909658".bytes());
    try db.put(key: "k11".bytes(), value: "v45778".bytes());
    _ = try db.delete("k03".bytes());
