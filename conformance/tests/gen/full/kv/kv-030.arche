import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-030-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    if try db.get("k14".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k30".bytes(), value: "v636633".bytes());
    if try db.get("k14".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k19".bytes(), value: "v886502".bytes());
    try db.put(key: "k25".bytes(), value: "v499443".bytes());
    try db.commit();
    try db.put(key: "k02".bytes(), value: "v540933".bytes());
    try db.put(key: "k30".bytes(), value: "v11564".bytes());
    try db.put(key: "k15".bytes(), value: "v745741".bytes());
    _ = try db.delete("k09".bytes());
    _ = try db.delete("k06".bytes());
    try db.put(key: "k19".bytes(), value: "v192861".bytes());
    try db.put(key: "k19".bytes(), value: "v839041".bytes());
    if try db.get("k06".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k15".bytes());
    if try db.get("k33".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k19".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k33".bytes(), value: "v755770".bytes());
    try db.put(key: "k25".bytes(), value: "v931092".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k32".bytes());
    if try db.get("k11".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k32".bytes(), value: "v330410".bytes());
    try db.commit();
    try db.put(key: "k30".bytes(), value: "v778269".bytes());
    _ = try db.delete("k30".bytes());
    try db.put(key: "k11".bytes(), value: "v25786".bytes());
    try db.put(key: "k32".bytes(), value: "v686295".bytes());
    try db.put(key: "k18".bytes(), value: "v566586".bytes());
    try db.put(key: "k18".bytes(), value: "v183500".bytes());
    try db.put(key: "k25".bytes(), value: "v764683".bytes());
    try db.put(key: "k19".bytes(), value: "v376916".bytes());
    try db.put(key: "k06".bytes(), value: "v832624".bytes());
    try db.put(key: "k19".bytes(), value: "v769862".bytes());
    try db.put(key: "k30".bytes(), value: "v315076".bytes());
    if try db.get("k14".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k33".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k32".bytes());
    if try db.get("k10".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k06".bytes(), value: "v460561".bytes());
    try db.put(key: "k02".bytes(), value: "v694530".bytes());
    try db.commit();
    if try db.get("k14".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k06".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k18".bytes(), value: "v282747".bytes());
    try db.commit();
    _ = try db.delete("k15".bytes());
    try db.put(key: "k14".bytes(), value: "v861139".bytes());
    try db.put(key: "k10".bytes(), value: "v493674".bytes());
    if try db.get("k19".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k15".bytes(), value: "v362291".bytes());
    try db.put(key: "k11".bytes(), value: "v446163".bytes());
    try db.put(key: "k19".bytes(), value: "v260467".bytes());
    try db.put(key: "k06".bytes(), value: "v605163".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k25".bytes(), value: "v40138".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
