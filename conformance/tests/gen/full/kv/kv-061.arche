    }
    try db.put(key: "k23".bytes(), value: "v553081".bytes());
    _ = try db.delete("k22".bytes());
    try db.put(key: "k27".bytes(), value: "v249716".bytes());
    try db.put(key: "k19".bytes(), value: "v256700".bytes());
    _ = try db.delete("k27".bytes());
    try db.put(key: "k20".bytes(), value: "v109271".bytes());
    try db.commit();
    _ = try db.delete("k19".bytes());
    try db.put(key: "k18".bytes(), value: "v580239".bytes());
    if try db.get("k19".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    if try db.get("k27".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k27".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k18".bytes(), value: "v370633".bytes());
    try db.commit();
    try db.put(key: "k27".bytes(), value: "v761610".bytes());
    if try db.get("k18".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k02".bytes());
    try db.put(key: "k35".bytes(), value: "v666788".bytes());
    _ = try db.delete("k18".bytes());
    if try db.get("k19".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k33".bytes(), value: "v485615".bytes());
    if try db.get("k02".bytes(), value: &mut value) {
