    }
    try db.commit();
    try db.put(key: "k20".bytes(), value: "v896107".bytes());
    try db.put(key: "k19".bytes(), value: "v308902".bytes());
    try db.put(key: "k27".bytes(), value: "v381461".bytes());
    if try db.get("k35".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k09".bytes(), value: "v861172".bytes());
    try db.put(key: "k22".bytes(), value: "v647618".bytes());
