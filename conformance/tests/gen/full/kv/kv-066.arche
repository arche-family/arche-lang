// stdout: k20
// stdout: k21
// stdout: k24
// stdout: k25
// stdout: k28
// stdout: k33
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-066-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    _ = try db.delete("k20".bytes());
    try db.commit();
    try db.put(key: "k28".bytes(), value: "v817315".bytes());
    try db.put(key: "k20".bytes(), value: "v434720".bytes());
    if try db.get("k14".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k11".bytes(), value: "v581013".bytes());
    try db.put(key: "k18".bytes(), value: "v988050".bytes());
    try db.put(key: "k33".bytes(), value: "v825005".bytes());
    if try db.get("k11".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k25".bytes());
    if try db.get("k11".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k09".bytes(), value: "v363866".bytes());
    try db.put(key: "k24".bytes(), value: "v277345".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k33".bytes());
    try db.put(key: "k25".bytes(), value: "v187010".bytes());
    try db.put(key: "k11".bytes(), value: "v130488".bytes());
    try db.put(key: "k11".bytes(), value: "v592444".bytes());
    _ = try db.delete("k28".bytes());
    if try db.get("k11".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k27".bytes());
    try db.put(key: "k18".bytes(), value: "v806393".bytes());
    try db.put(key: "k28".bytes(), value: "v360843".bytes());
    try db.put(key: "k28".bytes(), value: "v919852".bytes());
    _ = try db.delete("k14".bytes());
    try db.put(key: "k25".bytes(), value: "v710740".bytes());
    if try db.get("k09".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k33".bytes());
    try db.put(key: "k28".bytes(), value: "v17819".bytes());
    if try db.get("k27".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k28".bytes(), value: "v637292".bytes());
    try db.put(key: "k33".bytes(), value: "v353378".bytes());
    try db.put(key: "k21".bytes(), value: "v281032".bytes());
    try db.put(key: "k28".bytes(), value: "v440768".bytes());
    try db.put(key: "k20".bytes(), value: "v584433".bytes());
    if try db.get("k33".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
