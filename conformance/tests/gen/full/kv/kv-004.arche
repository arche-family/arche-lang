import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-004-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.put(key: "k39".bytes(), value: "v385838".bytes());
    if try db.get("k35".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k00".bytes(), value: "v402305".bytes());
    try db.put(key: "k01".bytes(), value: "v744477".bytes());
    try db.put(key: "k35".bytes(), value: "v558560".bytes());
    try db.put(key: "k35".bytes(), value: "v258248".bytes());
    if try db.get("k09".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k39".bytes());
    if try db.get("k08".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k13".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k07".bytes(), value: "v743703".bytes());
    if try db.get("k33".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k01".bytes(), value: "v993083".bytes());
    try db.put(key: "k11".bytes(), value: "v689583".bytes());
    try db.put(key: "k39".bytes(), value: "v851985".bytes());
    try db.put(key: "k01".bytes(), value: "v223626".bytes());
    try db.put(key: "k13".bytes(), value: "v236005".bytes());
    try db.put(key: "k39".bytes(), value: "v214424".bytes());
    try db.put(key: "k29".bytes(), value: "v36602".bytes());
    _ = try db.delete("k29".bytes());
    if try db.get("k27".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k39".bytes(), value: "v3501".bytes());
    if try db.get("k00".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k27".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k07".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    if try db.get("k35".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.put(key: "k08".bytes(), value: "v121418".bytes());
    try db.put(key: "k01".bytes(), value: "v432075".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k33".bytes(), value: "v665027".bytes());
    try db.put(key: "k05".bytes(), value: "v782869".bytes());
    _ = try db.delete("k19".bytes());
    try db.put(key: "k29".bytes(), value: "v192550".bytes());
    _ = try db.delete("k09".bytes());
    try db.put(key: "k35".bytes(), value: "v945786".bytes());
    _ = try db.delete("k02".bytes());
    try db.put(key: "k02".bytes(), value: "v147135".bytes());
    _ = try db.delete("k27".bytes());
    try db.commit();
    try db.put(key: "k39".bytes(), value: "v940118".bytes());
    try db.put(key: "k29".bytes(), value: "v258651".bytes());
    try db.put(key: "k35".bytes(), value: "v514738".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
