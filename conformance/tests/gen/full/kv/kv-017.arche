// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: none
// stdout: none
// stdout: none
// stdout: v267014
// stdout: v206484
// stdout: v252572
// stdout: v273016
// stdout: v900808
// stdout: k05
// stdout: k09
// stdout: k12
// stdout: k18
// stdout: k19
// stdout: k23
// stdout: k30
// stdout: k31
// stdout: k33
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-017-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    if try db.get("k09".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k12".bytes(), value: "v206484".bytes());
    try db.put(key: "k33".bytes(), value: "v290039".bytes());
    if try db.get("k31".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k23".bytes(), value: "v454480".bytes());
    _ = try db.delete("k30".bytes());
    try db.put(key: "k05".bytes(), value: "v267014".bytes());
    if try db.get("k17".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k09".bytes(), value: "v244855".bytes());
    _ = try db.delete("k18".bytes());
    try db.put(key: "k17".bytes(), value: "v163393".bytes());
    _ = try db.delete("k17".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k18".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k05".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k18".bytes(), value: "v273016".bytes());
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k30".bytes(), value: "v212855".bytes());
    try db.put(key: "k33".bytes(), value: "v618193".bytes());
    try db.put(key: "k23".bytes(), value: "v252572".bytes());
    try db.commit();
    try db.commit();
    try db.put(key: "k19".bytes(), value: "v900808".bytes());
    try db.commit();
    if try db.get("k23".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k18".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.commit();
    try db.put(key: "k05".bytes(), value: "v5651".bytes());
    try db.put(key: "k31".bytes(), value: "v370155".bytes());
    try db.put(key: "k18".bytes(), value: "v559371".bytes());
    try db.put(key: "k31".bytes(), value: "v940934".bytes());
    if try db.get("k19".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
