// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: none
// stdout: none
// stdout: none
// stdout: none
// stdout: v224590
// stdout: none
// stdout: none
// stdout: k00
// stdout: k16
// stdout: k29
// stdout: k31
// stdout: k36
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-027-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    if try db.get("k06".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k00".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k11".bytes());
    _ = try db.delete("k16".bytes());
    try db.put(key: "k00".bytes(), value: "v626878".bytes());
    if try db.get("k31".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.put(key: "k38".bytes(), value: "v939706".bytes());
    try db.put(key: "k29".bytes(), value: "v402360".bytes());
    try db.put(key: "k38".bytes(), value: "v680002".bytes());
    try db.commit();
    _ = try db.delete("k16".bytes());
    try db.put(key: "k36".bytes(), value: "v873870".bytes());
    _ = try db.delete("k38".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k38".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k01".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k16".bytes(), value: "v908319".bytes());
    try db.put(key: "k11".bytes(), value: "v486097".bytes());
    try db.put(key: "k11".bytes(), value: "v724529".bytes());
    _ = try db.delete("k00".bytes());
    try db.put(key: "k16".bytes(), value: "v224590".bytes());
    _ = try db.delete("k32".bytes());
    if try db.get("k16".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k31".bytes(), value: "v648124".bytes());
    try db.put(key: "k11".bytes(), value: "v617390".bytes());
    _ = try db.delete("k11".bytes());
    if try db.get("k08".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k29".bytes(), value: "v554299".bytes());
    _ = try db.delete("k08".bytes());
    try db.commit();
    try db.commit();
    try db.put(key: "k36".bytes(), value: "v458108".bytes());
    try db.put(key: "k00".bytes(), value: "v62993".bytes());
    if try db.get("k32".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
