    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k18".bytes(), value: "v867302".bytes());
    _ = try db.delete("k30".bytes());
    try db.put(key: "k30".bytes(), value: "v353674".bytes());
    _ = try db.delete("k00".bytes());
    _ = try db.delete("k29".bytes());
    try db.put(key: "k18".bytes(), value: "v148495".bytes());
    if try db.get("k18".bytes(), value: &mut value) {
