    }
    try db.commit();
    if try db.get("k21".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k30".bytes());
    try db.put(key: "k12".bytes(), value: "v241283".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k20".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k35".bytes());
    try db.put(key: "k12".bytes(), value: "v468926".bytes());
    try db.commit();
    try db.put(key: "k25".bytes(), value: "v968431".bytes());
    try db.put(key: "k21".bytes(), value: "v595649".bytes());
    if try db.get("k04".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k12".bytes(), value: "v332656".bytes());
    if try db.get("k30".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k35".bytes());
    try db.commit();
    try db.put(key: "k39".bytes(), value: "v733701".bytes());
    _ = try db.delete("k21".bytes());
    try db.put(key: "k39".bytes(), value: "v320465".bytes());
    if try db.get("k20".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k35".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
