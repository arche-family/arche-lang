    try db.commit();
    try db.put(key: "k29".bytes(), value: "v414705".bytes());
    try db.put(key: "k25".bytes(), value: "v41151".bytes());
    try db.commit();
    try db.put(key: "k21".bytes(), value: "v765319".bytes());
    _ = try db.delete("k29".bytes());
    try db.put(key: "k11".bytes(), value: "v845213".bytes());
    try db.put(key: "k11".bytes(), value: "v402441".bytes());
