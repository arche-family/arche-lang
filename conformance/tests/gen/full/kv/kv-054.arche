// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: none
// stdout: v848358
// stdout: none
// stdout: none
// stdout: v90214
// stdout: v780829
// stdout: k04
// stdout: k07
// stdout: k15
// stdout: k17
// stdout: k20
// stdout: k24
// stdout: k35
// stdout: k38
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-054-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.put(key: "k24".bytes(), value: "v90214".bytes());
    try db.put(key: "k11".bytes(), value: "v570806".bytes());
    _ = try db.delete("k11".bytes());
    _ = try db.delete("k27".bytes());
    if try db.get("k27".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k04".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k20".bytes(), value: "v211188".bytes());
    try db.commit();
    try db.put(key: "k22".bytes(), value: "v848358".bytes());
    try db.commit();
    if try db.get("k22".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k07".bytes());
    if try db.get("k26".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k22".bytes(), value: "v231432".bytes());
    _ = try db.delete("k35".bytes());
    _ = try db.delete("k04".bytes());
    try db.put(key: "k38".bytes(), value: "v385590".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k15".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k27".bytes(), value: "v959566".bytes());
    _ = try db.delete("k15".bytes());
    _ = try db.delete("k07".bytes());
    try db.put(key: "k22".bytes(), value: "v874538".bytes());
    try db.put(key: "k07".bytes(), value: "v394835".bytes());
    _ = try db.delete("k27".bytes());
    try db.put(key: "k11".bytes(), value: "v860449".bytes());
    try db.put(key: "k35".bytes(), value: "v579459".bytes());
    try db.put(key: "k15".bytes(), value: "v272133".bytes());
    _ = try db.delete("k11".bytes());
    try db.put(key: "k07".bytes(), value: "v391084".bytes());
    try db.put(key: "k04".bytes(), value: "v780829".bytes());
    try db.put(key: "k17".bytes(), value: "v893745".bytes());
    _ = try db.delete("k22".bytes());
    if try db.get("k22".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k24".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k35".bytes(), value: "v111764".bytes());
    try db.put(key: "k17".bytes(), value: "v712912".bytes());
    if try db.get("k04".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
