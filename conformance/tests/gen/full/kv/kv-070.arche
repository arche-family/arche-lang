import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-070-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k11".bytes());
    try db.put(key: "k19".bytes(), value: "v209519".bytes());
    try db.put(key: "k00".bytes(), value: "v87856".bytes());
    try db.put(key: "k38".bytes(), value: "v628638".bytes());
    try db.put(key: "k07".bytes(), value: "v245326".bytes());
    try db.put(key: "k13".bytes(), value: "v95293".bytes());
    try db.put(key: "k15".bytes(), value: "v785052".bytes());
    if try db.get("k08".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k26".bytes());
    try db.put(key: "k07".bytes(), value: "v911592".bytes());
    _ = try db.delete("k13".bytes());
    if try db.get("k14".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k26".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k36".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k26".bytes(), value: "v10879".bytes());
    if try db.get("k32".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k38".bytes(), value: "v144034".bytes());
    if try db.get("k36".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k38".bytes(), value: "v531029".bytes());
    try db.put(key: "k36".bytes(), value: "v916044".bytes());
    try db.put(key: "k36".bytes(), value: "v116064".bytes());
    try db.put(key: "k08".bytes(), value: "v710506".bytes());
    _ = try db.delete("k08".bytes());
    try db.put(key: "k07".bytes(), value: "v675236".bytes());
    _ = try db.delete("k07".bytes());
    try db.put(key: "k07".bytes(), value: "v787836".bytes());
    try db.put(key: "k08".bytes(), value: "v374606".bytes());
    if try db.get("k25".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k19".bytes(), value: "v433056".bytes());
    if try db.get("k07".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k26".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k26".bytes(), value: "v962139".bytes());
    try db.put(key: "k36".bytes(), value: "v590157".bytes());
    try db.commit();
    try db.put(key: "k26".bytes(), value: "v256281".bytes());
    _ = try db.delete("k38".bytes());
    try db.put(key: "k00".bytes(), value: "v618993".bytes());
    if try db.get("k38".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k08".bytes());
    if try db.get("k25".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k14".bytes(), value: "v648716".bytes());
    _ = try db.delete("k11".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k08".bytes(), value: "v150081".bytes());
    try db.put(key: "k26".bytes(), value: "v195055".bytes());
    _ = try db.delete("k07".bytes());
    try db.put(key: "k11".bytes(), value: "v159404".bytes());
    try db.put(key: "k11".bytes(), value: "v874877".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k26".bytes(), value: "v502763".bytes());
    try db.put(key: "k25".bytes(), value: "v311415".bytes());
    try db.put(key: "k08".bytes(), value: "v246746".bytes());
    try db.put(key: "k26".bytes(), value: "v387775".bytes());
    try db.put(key: "k14".bytes(), value: "v270511".bytes());
    try db.put(key: "k07".bytes(), value: "v319206".bytes());
    try db.put(key: "k26".bytes(), value: "v57812".bytes());
    try db.put(key: "k25".bytes(), value: "v8464".bytes());
    try db.commit();
    _ = try db.delete("k19".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
