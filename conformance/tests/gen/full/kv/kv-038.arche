import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-038-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.put(key: "k24".bytes(), value: "v905119".bytes());
    if try db.get("k23".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k18".bytes(), value: "v903226".bytes());
    _ = try db.delete("k18".bytes());
    try db.put(key: "k12".bytes(), value: "v42534".bytes());
    try db.commit();
    try db.put(key: "k13".bytes(), value: "v203033".bytes());
    _ = try db.delete("k29".bytes());
    _ = try db.delete("k27".bytes());
    try db.put(key: "k23".bytes(), value: "v170104".bytes());
    _ = try db.delete("k26".bytes());
    if try db.get("k26".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k13".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k12".bytes(), value: "v527140".bytes());
    try db.put(key: "k32".bytes(), value: "v193660".bytes());
    try db.put(key: "k13".bytes(), value: "v293203".bytes());
    try db.put(key: "k23".bytes(), value: "v869404".bytes());
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k14".bytes());
    try db.put(key: "k18".bytes(), value: "v159921".bytes());
    try db.put(key: "k00".bytes(), value: "v693599".bytes());
    _ = try db.delete("k27".bytes());
    try db.put(key: "k06".bytes(), value: "v280435".bytes());
    try db.commit();
    try db.commit();
    if try db.get("k32".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k23".bytes(), value: "v476259".bytes());
    _ = try db.delete("k26".bytes());
    try db.put(key: "k12".bytes(), value: "v726829".bytes());
    _ = try db.delete("k06".bytes());
    try db.put(key: "k23".bytes(), value: "v72240".bytes());
    try db.commit();
    try db.put(key: "k26".bytes(), value: "v264685".bytes());
    if try db.get("k06".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k18".bytes(), value: "v255259".bytes());
    try db.put(key: "k13".bytes(), value: "v157730".bytes());
    try db.commit();
    if try db.get("k24".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k12".bytes());
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k13".bytes(), value: "v707285".bytes());
    _ = try db.delete("k32".bytes());
    _ = try db.delete("k12".bytes());
    if try db.get("k14".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k00".bytes(), value: "v400960".bytes());
    try db.put(key: "k06".bytes(), value: "v310755".bytes());
    try db.put(key: "k13".bytes(), value: "v722057".bytes());
    if try db.get("k18".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k12".bytes(), value: "v479031".bytes());
    try db.put(key: "k12".bytes(), value: "v790600".bytes());
    _ = try db.delete("k24".bytes());
    if try db.get("k23".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
