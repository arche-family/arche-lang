    _ = try db.delete("k33".bytes());
    try db.put(key: "k17".bytes(), value: "v777511".bytes());
    try db.put(key: "k03".bytes(), value: "v826919".bytes());
    if try db.get("k18".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k09".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k06".bytes(), value: "v484805".bytes());
    if try db.get("k34".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k33".bytes());
    _ = try db.delete("k18".bytes());
    if try db.get("k24".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k24".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k12".bytes(), value: "v132634".bytes());
    try db.put(key: "k24".bytes(), value: "v752332".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k33".bytes(), value: "v387426".bytes());
    try db.put(key: "k04".bytes(), value: "v526563".bytes());
    try db.put(key: "k24".bytes(), value: "v918883".bytes());
    try db.put(key: "k24".bytes(), value: "v637396".bytes());
    try db.put(key: "k34".bytes(), value: "v159954".bytes());
    _ = try db.delete("k24".bytes());
    if try db.get("k25".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k03".bytes(), value: "v263526".bytes());
    try db.commit();
    if try db.get("k17".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k09".bytes(), value: "v570323".bytes());
    try db.put(key: "k34".bytes(), value: "v631939".bytes());
    try db.put(key: "k24".bytes(), value: "v529219".bytes());
    if try db.get("k03".bytes(), value: &mut value) {
