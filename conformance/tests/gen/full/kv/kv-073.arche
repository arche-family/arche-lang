    try db.put(key: "k24".bytes(), value: "v436205".bytes());
    try db.put(key: "k24".bytes(), value: "v853424".bytes());
    try db.commit();
    _ = try db.delete("k25".bytes());
    try db.put(key: "k34".bytes(), value: "v790939".bytes());
    if try db.get("k24".bytes(), value: &mut value) {
