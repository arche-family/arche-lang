// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: none
// stdout: none
// stdout: v194145
// stdout: none
// stdout: none
// stdout: none
// stdout: v724155
// stdout: none
// stdout: k04
// stdout: k08
// stdout: k12
// stdout: k24
// stdout: k33
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-053-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    _ = try db.delete("k04".bytes());
    if try db.get("k25".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k05".bytes(), value: "v873166".bytes());
    try db.put(key: "k04".bytes(), value: "v700225".bytes());
    try db.put(key: "k33".bytes(), value: "v194145".bytes());
    _ = try db.delete("k05".bytes());
    if try db.get("k39".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k05".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k33".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k24".bytes(), value: "v724155".bytes());
    try db.commit();
    try db.put(key: "k12".bytes(), value: "v480360".bytes());
    try db.commit();
    if try db.get("k05".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k12".bytes(), value: "v588891".bytes());
    if try db.get("k08".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k33".bytes(), value: "v69508".bytes());
    try db.put(key: "k33".bytes(), value: "v67498".bytes());
    if try db.get("k07".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k24".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k08".bytes(), value: "v597805".bytes());
    if try db.get("k25".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
