    }
    if try db.get("k19".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k27".bytes());
    if try db.get("k07".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k19".bytes(), value: "v351307".bytes());
    try db.put(key: "k07".bytes(), value: "v666530".bytes());
    try db.put(key: "k12".bytes(), value: "v707482".bytes());
    try db.put(key: "k37".bytes(), value: "v842301".bytes());
    try db.put(key: "k07".bytes(), value: "v652223".bytes());
    try db.put(key: "k23".bytes(), value: "v326675".bytes());
    if try db.get("k05".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k23".bytes());
    try db.put(key: "k19".bytes(), value: "v258448".bytes());
    if try db.get("k23".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
