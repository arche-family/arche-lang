import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-013-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.put(key: "k23".bytes(), value: "v466736".bytes());
    try db.commit();
    try db.put(key: "k20".bytes(), value: "v973799".bytes());
    if try db.get("k16".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k05".bytes(), value: "v712603".bytes());
    if try db.get("k06".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k23".bytes(), value: "v492746".bytes());
    try db.put(key: "k20".bytes(), value: "v925204".bytes());
    try db.put(key: "k25".bytes(), value: "v860050".bytes());
    try db.put(key: "k15".bytes(), value: "v311206".bytes());
    try db.commit();
    if try db.get("k27".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k33".bytes(), value: "v867534".bytes());
    try db.put(key: "k15".bytes(), value: "v5466".bytes());
    try db.put(key: "k16".bytes(), value: "v359223".bytes());
    _ = try db.delete("k19".bytes());
    try db.put(key: "k23".bytes(), value: "v266469".bytes());
    if try db.get("k37".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k07".bytes(), value: "v822157".bytes());
    _ = try db.delete("k25".bytes());
    try db.put(key: "k12".bytes(), value: "v884469".bytes());
    if try db.get("k05".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k07".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k25".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
