    try db.put(key: "k04".bytes(), value: "v889032".bytes());
    try db.put(key: "k04".bytes(), value: "v805398".bytes());
    _ = try db.delete("k15".bytes());
    try db.put(key: "k33".bytes(), value: "v746550".bytes());
    try db.put(key: "k16".bytes(), value: "v639018".bytes());
    _ = try db.delete("k16".bytes());
    try db.put(key: "k27".bytes(), value: "v826688".bytes());
    try db.commit();
    try db.put(key: "k04".bytes(), value: "v948458".bytes());
    try db.put(key: "k07".bytes(), value: "v989100".bytes());
    try db.commit();
    try db.put(key: "k37".bytes(), value: "v342150".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
