// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: v290977
// stdout: none
// stdout: v184988
// stdout: v168417
// stdout: k03
// stdout: k08
// stdout: k09
// stdout: k12
// stdout: k17
// stdout: k18
// stdout: k22
// stdout: k25
// stdout: k26
// stdout: k28
// stdout: k39
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-005-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.put(key: "k03".bytes(), value: "v290977".bytes());
    _ = try db.delete("k18".bytes());
    try db.commit();
    try db.put(key: "k18".bytes(), value: "v967964".bytes());
    try db.put(key: "k25".bytes(), value: "v939145".bytes());
    try db.put(key: "k09".bytes(), value: "v242159".bytes());
    try db.put(key: "k38".bytes(), value: "v52568".bytes());
    try db.commit();
    if try db.get("k03".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k38".bytes(), value: "v376970".bytes());
    if try db.get("k07".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k38".bytes(), value: "v701952".bytes());
    try db.put(key: "k08".bytes(), value: "v113716".bytes());
    _ = try db.delete("k17".bytes());
    try db.put(key: "k17".bytes(), value: "v216954".bytes());
    _ = try db.delete("k24".bytes());
    try db.put(key: "k26".bytes(), value: "v33936".bytes());
    try db.put(key: "k28".bytes(), value: "v296852".bytes());
    _ = try db.delete("k09".bytes());
    _ = try db.delete("k38".bytes());
    try db.put(key: "k39".bytes(), value: "v426271".bytes());
    try db.commit();
    try db.put(key: "k08".bytes(), value: "v329242".bytes());
    try db.put(key: "k25".bytes(), value: "v184988".bytes());
    try db.commit();
    try db.put(key: "k09".bytes(), value: "v168417".bytes());
    try db.put(key: "k22".bytes(), value: "v219346".bytes());
    try db.put(key: "k03".bytes(), value: "v322883".bytes());
    try db.put(key: "k12".bytes(), value: "v491300".bytes());
    try db.commit();
    if try db.get("k25".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k09".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k09".bytes(), value: "v608646".bytes());
    _ = try db.delete("k22".bytes());
    try db.put(key: "k22".bytes(), value: "v738561".bytes());
    try db.commit();
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
