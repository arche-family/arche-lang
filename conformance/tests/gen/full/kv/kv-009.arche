// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: v809046
// stdout: none
// stdout: none
// stdout: none
// stdout: none
// stdout: none
// stdout: v153049
// stdout: none
// stdout: k11
// stdout: k12
// stdout: k16
// stdout: k21
// stdout: k31
// stdout: k34
// stdout: k37
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-009-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    if try db.get("k21".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k21".bytes(), value: "v809046".bytes());
    if try db.get("k21".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k35".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k13".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k21".bytes());
    try db.commit();
    try db.put(key: "k16".bytes(), value: "v993794".bytes());
    try db.put(key: "k11".bytes(), value: "v607442".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k31".bytes());
    try db.commit();
    if try db.get("k34".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k37".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k11".bytes(), value: "v608608".bytes());
    try db.put(key: "k34".bytes(), value: "v297334".bytes());
    try db.put(key: "k16".bytes(), value: "v153049".bytes());
    if try db.get("k16".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k12".bytes(), value: "v874143".bytes());
    if try db.get("k21".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.put(key: "k21".bytes(), value: "v824326".bytes());
    try db.put(key: "k37".bytes(), value: "v46746".bytes());
    try db.put(key: "k31".bytes(), value: "v938136".bytes());
    try db.put(key: "k31".bytes(), value: "v415470".bytes());
    try db.put(key: "k12".bytes(), value: "v207333".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
