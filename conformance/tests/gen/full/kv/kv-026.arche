import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-026-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.put(key: "k11".bytes(), value: "v120191".bytes());
    _ = try db.delete("k25".bytes());
    try db.commit();
    if try db.get("k31".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k26".bytes(), value: "v798247".bytes());
    _ = try db.delete("k16".bytes());
    _ = try db.delete("k22".bytes());
    if try db.get("k18".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k09".bytes(), value: "v170977".bytes());
    _ = try db.delete("k25".bytes());
    if try db.get("k34".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k25".bytes(), value: "v425031".bytes());
    try db.put(key: "k02".bytes(), value: "v623791".bytes());
    try db.put(key: "k26".bytes(), value: "v472918".bytes());
    try db.put(key: "k16".bytes(), value: "v964167".bytes());
    if try db.get("k31".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k02".bytes(), value: "v844093".bytes());
    try db.put(key: "k31".bytes(), value: "v523303".bytes());
    if try db.get("k02".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k26".bytes(), value: "v249198".bytes());
    try db.put(key: "k16".bytes(), value: "v651934".bytes());
    try db.put(key: "k16".bytes(), value: "v363648".bytes());
    try db.put(key: "k25".bytes(), value: "v628919".bytes());
    _ = try db.delete("k16".bytes());
    _ = try db.delete("k25".bytes());
    try db.put(key: "k25".bytes(), value: "v808553".bytes());
    try db.put(key: "k25".bytes(), value: "v83556".bytes());
    _ = try db.delete("k11".bytes());
    try db.commit();
    if try db.get("k11".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k11".bytes(), value: "v857933".bytes());
    _ = try db.delete("k16".bytes());
    try db.commit();
    try db.put(key: "k16".bytes(), value: "v173296".bytes());
    if try db.get("k22".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k16".bytes());
    if try db.get("k16".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k31".bytes(), value: "v663133".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k31".bytes(), value: "v120397".bytes());
    try db.put(key: "k07".bytes(), value: "v921280".bytes());
    if try db.get("k26".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k18".bytes(), value: "v139144".bytes());
    _ = try db.delete("k01".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
