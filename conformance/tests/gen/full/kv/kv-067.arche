import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-067-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.put(key: "k04".bytes(), value: "v90041".bytes());
    try db.commit();
    _ = try db.delete("k04".bytes());
    try db.put(key: "k14".bytes(), value: "v782436".bytes());
    try db.put(key: "k14".bytes(), value: "v802474".bytes());
    try db.put(key: "k29".bytes(), value: "v290740".bytes());
    _ = try db.delete("k27".bytes());
    _ = try db.delete("k23".bytes());
    try db.put(key: "k19".bytes(), value: "v537060".bytes());
    try db.put(key: "k12".bytes(), value: "v599931".bytes());
    _ = try db.delete("k31".bytes());
    try db.put(key: "k14".bytes(), value: "v223976".bytes());
    try db.put(key: "k14".bytes(), value: "v60198".bytes());
    try db.put(key: "k09".bytes(), value: "v570674".bytes());
    _ = try db.delete("k08".bytes());
    _ = try db.delete("k29".bytes());
    if try db.get("k19".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k29".bytes(), value: "v745101".bytes());
    try db.commit();
    if try db.get("k31".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k04".bytes(), value: "v882804".bytes());
    try db.commit();
    try db.put(key: "k27".bytes(), value: "v888611".bytes());
    _ = try db.delete("k09".bytes());
    try db.put(key: "k12".bytes(), value: "v35139".bytes());
    try db.put(key: "k29".bytes(), value: "v571614".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    if try db.get("k14".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k04".bytes());
    try db.put(key: "k19".bytes(), value: "v198549".bytes());
    if try db.get("k04".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k34".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k23".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k14".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k04".bytes(), value: "v522744".bytes());
    if try db.get("k40".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k08".bytes(), value: "v549983".bytes());
    try db.put(key: "k08".bytes(), value: "v813227".bytes());
    if try db.get("k34".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k14".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k09".bytes());
    try db.put(key: "k08".bytes(), value: "v796457".bytes());
    try db.put(key: "k40".bytes(), value: "v748732".bytes());
    try db.put(key: "k14".bytes(), value: "v498968".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k08".bytes());
    try db.put(key: "k27".bytes(), value: "v784936".bytes());
    try db.put(key: "k34".bytes(), value: "v440328".bytes());
    if try db.get("k04".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k14".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k23".bytes(), value: "v767776".bytes());
    try db.put(key: "k37".bytes(), value: "v672911".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
