    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k38".bytes());
    try db.put(key: "k38".bytes(), value: "v864719".bytes());
    _ = try db.delete("k09".bytes());
    _ = try db.delete("k29".bytes());
    try db.put(key: "k26".bytes(), value: "v762262".bytes());
    if try db.get("k26".bytes(), value: &mut value) {
