    try db.put(key: "k23".bytes(), value: "v631029".bytes());
    try db.put(key: "k00".bytes(), value: "v299617".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k13".bytes(), value: "v348881".bytes());
    try db.put(key: "k08".bytes(), value: "v42645".bytes());
    try db.put(key: "k38".bytes(), value: "v796628".bytes());
    try db.put(key: "k38".bytes(), value: "v104471".bytes());
    _ = try db.delete("k00".bytes());
    if try db.get("k38".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
