    try db.put(key: "k10".bytes(), value: "v192904".bytes());
    if try db.get("k23".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k27".bytes(), value: "v644806".bytes());
    try db.put(key: "k38".bytes(), value: "v853269".bytes());
    _ = try db.delete("k26".bytes());
    try db.put(key: "k12".bytes(), value: "v304835".bytes());
    _ = try db.delete("k10".bytes());
    try db.put(key: "k27".bytes(), value: "v612056".bytes());
    if try db.get("k08".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
