// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: none
// stdout: none
// stdout: v251790
// stdout: none
// stdout: none
// stdout: k00
// stdout: k11
// stdout: k12
// stdout: k17
// stdout: k19
// stdout: k22
// stdout: k31
// stdout: k40
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-012-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.put(key: "k00".bytes(), value: "v909953".bytes());
    if try db.get("k17".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k31".bytes());
    try db.put(key: "k26".bytes(), value: "v296785".bytes());
    try db.put(key: "k40".bytes(), value: "v521199".bytes());
    if try db.get("k17".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k26".bytes(), value: "v490153".bytes());
    try db.put(key: "k12".bytes(), value: "v866704".bytes());
    try db.commit();
    _ = try db.delete("k26".bytes());
    _ = try db.delete("k17".bytes());
    try db.put(key: "k12".bytes(), value: "v158256".bytes());
    try db.put(key: "k35".bytes(), value: "v542362".bytes());
    try db.put(key: "k35".bytes(), value: "v863972".bytes());
    try db.put(key: "k31".bytes(), value: "v647366".bytes());
    if try db.get("k26".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k17".bytes());
    try db.put(key: "k00".bytes(), value: "v251790".bytes());
    try db.put(key: "k40".bytes(), value: "v291815".bytes());
    try db.put(key: "k31".bytes(), value: "v539973".bytes());
    try db.put(key: "k40".bytes(), value: "v372139".bytes());
    if try db.get("k00".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k38".bytes());
    try db.commit();
    try db.commit();
    if try db.get("k26".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k31".bytes(), value: "v932553".bytes());
    try db.put(key: "k11".bytes(), value: "v477777".bytes());
    if try db.get("k19".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k35".bytes());
    _ = try db.delete("k16".bytes());
    try db.put(key: "k22".bytes(), value: "v816524".bytes());
    try db.put(key: "k17".bytes(), value: "v539275".bytes());
    try db.put(key: "k19".bytes(), value: "v152672".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
