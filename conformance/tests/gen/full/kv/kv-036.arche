import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-036-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    _ = try db.delete("k27".bytes());
    try db.put(key: "k24".bytes(), value: "v612724".bytes());
    try db.put(key: "k28".bytes(), value: "v712458".bytes());
    try db.put(key: "k14".bytes(), value: "v636392".bytes());
    if try db.get("k33".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k24".bytes());
    try db.put(key: "k24".bytes(), value: "v750332".bytes());
    if try db.get("k26".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k14".bytes());
    try db.put(key: "k33".bytes(), value: "v218660".bytes());
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k23".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k23".bytes(), value: "v285137".bytes());
    _ = try db.delete("k16".bytes());
    _ = try db.delete("k24".bytes());
    try db.put(key: "k12".bytes(), value: "v211615".bytes());
    if try db.get("k23".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    if try db.get("k14".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k24".bytes(), value: "v783348".bytes());
    try db.put(key: "k28".bytes(), value: "v932488".bytes());
    try db.put(key: "k12".bytes(), value: "v651160".bytes());
    if try db.get("k24".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k14".bytes());
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k14".bytes(), value: "v333548".bytes());
    if try db.get("k27".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k24".bytes());
    if try db.get("k32".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k14".bytes(), value: "v635200".bytes());
    try db.put(key: "k32".bytes(), value: "v123456".bytes());
    _ = try db.delete("k23".bytes());
    try db.put(key: "k24".bytes(), value: "v129905".bytes());
    try db.put(key: "k23".bytes(), value: "v858757".bytes());
    if try db.get("k39".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    if try db.get("k23".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k23".bytes(), value: "v374340".bytes());
    try db.put(key: "k23".bytes(), value: "v31033".bytes());
    _ = try db.delete("k27".bytes());
    _ = try db.delete("k23".bytes());
    try db.commit();
    try db.put(key: "k23".bytes(), value: "v294921".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k26".bytes());
    try db.put(key: "k14".bytes(), value: "v528527".bytes());
    try db.put(key: "k14".bytes(), value: "v634418".bytes());
    try db.put(key: "k14".bytes(), value: "v353395".bytes());
    try db.put(key: "k33".bytes(), value: "v42264".bytes());
    try db.put(key: "k33".bytes(), value: "v482931".bytes());
    try db.put(key: "k27".bytes(), value: "v355582".bytes());
    try db.put(key: "k12".bytes(), value: "v264677".bytes());
    if try db.get("k32".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
