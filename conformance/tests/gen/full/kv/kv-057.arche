// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: none
// stdout: none
// stdout: none
// stdout: none
// stdout: v196753
// stdout: k01
// stdout: k03
// stdout: k09
// stdout: k10
// stdout: k15
// stdout: k17
// stdout: k21
// stdout: k30
// stdout: k33
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-057-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    try db.put(key: "k13".bytes(), value: "v737540".bytes());
    if try db.get("k21".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k28".bytes());
    try db.put(key: "k15".bytes(), value: "v548499".bytes());
    try db.put(key: "k30".bytes(), value: "v257480".bytes());
    if try db.get("k08".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k17".bytes());
    if try db.get("k01".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    _ = try db.delete("k09".bytes());
    try db.put(key: "k30".bytes(), value: "v672783".bytes());
    _ = try db.delete("k15".bytes());
    try db.put(key: "k05".bytes(), value: "v196753".bytes());
    try db.put(key: "k33".bytes(), value: "v105490".bytes());
    _ = try db.delete("k01".bytes());
    _ = try db.delete("k13".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k03".bytes(), value: "v722490".bytes());
    _ = try db.delete("k30".bytes());
    if try db.get("k21".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.put(key: "k03".bytes(), value: "v942092".bytes());
    if try db.get("k28".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k10".bytes(), value: "v629892".bytes());
    _ = try db.delete("k30".bytes());
    try db.put(key: "k15".bytes(), value: "v975555".bytes());
    try db.put(key: "k33".bytes(), value: "v938162".bytes());
    _ = try db.delete("k10".bytes());
    if try db.get("k05".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k17".bytes(), value: "v924562".bytes());
    try db.put(key: "k01".bytes(), value: "v377472".bytes());
    try db.put(key: "k09".bytes(), value: "v437020".bytes());
    try db.put(key: "k30".bytes(), value: "v371958".bytes());
    try db.put(key: "k09".bytes(), value: "v759693".bytes());
    try db.put(key: "k21".bytes(), value: "v520890".bytes());
    try db.put(key: "k09".bytes(), value: "v550822".bytes());
    try db.put(key: "k10".bytes(), value: "v737945".bytes());
    _ = try db.delete("k05".bytes());
    try db.put(key: "k17".bytes(), value: "v899743".bytes());
    try db.put(key: "k21".bytes(), value: "v821718".bytes());
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
