// test: run
// spec: kv
// stage0: skip
// wasm: skip
// stdout: none
// stdout: none
// stdout: none
// stdout: none
// stdout: v98646
// stdout: v524736
// stdout: v524736
// stdout: k01
// stdout: k07
// stdout: k08
// stdout: k12
// stdout: k16
// stdout: k19
// stdout: k28
// stdout: k29
// stdout: k34
import alloc;
import kv;
import std;

fn print_bytes(sys: &mut std.System, b: []u8) {
    var s = alloc.String.init(sys.alloc);
    _ = s.push_utf8(b);
    sys.stdout.write(s.view());
    sys.stdout.write("\n");
}

fn main(sys: &mut std.System) -> !void {
    let tmp = try sys.fs.temp_dir(&sys.env, sys.alloc);
    var path = alloc.String.from(tmp.view(), sys.alloc);
    path.push_str("/arche-gen-kv-042-");
    path.push_u64(sys.proc.pid() as u64);
    var wal = alloc.String.from(path.view(), sys.alloc);
    wal.push_str("-wal");
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
    var db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var value = alloc.List(u8).init(sys.alloc);
    _ = try db.delete("k16".bytes());
    if try db.get("k13".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k19".bytes());
    if try db.get("k28".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k07".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k12".bytes(), value: "v329757".bytes());
    try db.commit();
    try db.put(key: "k34".bytes(), value: "v394592".bytes());
    if try db.get("k26".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    _ = try db.delete("k34".bytes());
    _ = try db.delete("k12".bytes());
    try db.put(key: "k29".bytes(), value: "v857564".bytes());
    _ = try db.delete("k12".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    _ = try db.delete("k13".bytes());
    if try db.get("k26".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k08".bytes(), value: "v700739".bytes());
    try db.commit();
    try db.put(key: "k28".bytes(), value: "v818597".bytes());
    try db.put(key: "k29".bytes(), value: "v98646".bytes());
    try db.put(key: "k28".bytes(), value: "v921124".bytes());
    try db.put(key: "k16".bytes(), value: "v611548".bytes());
    if try db.get("k29".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k12".bytes(), value: "v493485".bytes());
    try db.put(key: "k01".bytes(), value: "v865190".bytes());
    try db.put(key: "k34".bytes(), value: "v239478".bytes());
    try db.commit();
    try db.put(key: "k19".bytes(), value: "v946576".bytes());
    try db.put(key: "k12".bytes(), value: "v712827".bytes());
    try db.put(key: "k28".bytes(), value: "v930336".bytes());
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    try db.put(key: "k12".bytes(), value: "v524736".bytes());
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.put(key: "k07".bytes(), value: "v547373".bytes());
    try db.put(key: "k19".bytes(), value: "v577815".bytes());
    _ = try db.delete("k13".bytes());
    if try db.get("k12".bytes(), value: &mut value) {
        print_bytes(sys, value.items());
    } else {
        sys.stdout.write("none\n");
    }
    try db.commit();
    try db.close();
    db = try kv.open(&sys.fs, path.view(), sys.alloc);
    var key = alloc.List(u8).init(sys.alloc);
    var at = alloc.List(u8).init(sys.alloc);
    var first = true;
    while try db.next(at.items(), inclusive: first, key: &mut key, value: &mut value) {
        print_bytes(sys, key.items());
        at.clear();
        for b in key.items() {
            at.push(b.*);
        }
        first = false;
    }
    try db.close();
    _ = sys.fs.remove(path.view());
    _ = sys.fs.remove(wal.view());
}
