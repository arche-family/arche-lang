// A package with two vendored dependencies (spec/arche.md §1.1): shapes,
// edition 2026, which needs nothing, and clock, which needs the clock.
import std.build;

const PACKAGE: build.Package = build.Package {
    name: "dependencies",
    version: "1.0.0",
    edition: 2027,
    needs: [build.Capability.Clock],
    dependencies: [build.dep("shapes", "1.0.0"), build.dep("clock", "1.0.0")],
};
