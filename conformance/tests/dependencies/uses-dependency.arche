// test: run
// spec: arche/1.1
// stage0: skip
// stdout: 16 16 3 clock
import std;
import shapes;
import shapes.geometry.area;
import clock;

fn main(sys: &mut std.System) -> !void {
    let s = shapes.Square { side: 4 };
    sys.stdout.write_u64(shapes.surface(s) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(area.square(4) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(shapes.checked(6) as u64);
    if clock.now(&sys.clock) > 0 {
        sys.stdout.write(" clock");
    }
    sys.stdout.write("\n");
}
