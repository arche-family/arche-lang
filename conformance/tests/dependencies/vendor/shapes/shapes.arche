import std;
import geometry.area;

pub type Square = struct {
    pub side: u32,
}

pub fn surface(s: Square) -> u32 {
    return area.square(s.side);
}

/// Edition 2026: ok(…) is the pattern, whatever edition its user has.
pub fn checked(n: u32) -> u32 {
    match half(n) {
        ok(v) => { return v; }
        err(_) => { return 0; }
    }
}

fn half(n: u32) -> std.IoError!u32 {
    if n % 2 == 1 {
        return std.IoError.IoFailed;
    }
    return n / 2;
}
