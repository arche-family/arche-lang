// test: run
// spec: arche/1.3
// stage0: skip
// stdout: listed
import std;

fn now(c: &std.Clock) -> u64 {
    return c.monotonic_ns();
}

fn main(sys: &mut std.System) -> !void {
    let t = now(&sys.clock);
    if sys.fs.exists("listed.arche") and t > 0 {
        sys.stdout.write("listed\n");
    }
}
