// test: run
// spec: 11
// exit: 101
// stderr: panic: push_ascii takes ASCII, a byte up to 0x7F
// stderr:   at string-push-ascii-traps.arche:12:
import std;
import alloc;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    let byte: u8 = 0xC3;
    s.push_ascii(byte);
}
