// test: run
// spec: 11
// stdout: text 7 7 18446744073709551615
// stderr: to stderr
import std;

fn main(sys: &mut std.System) -> !void {
    sys.stdout.write("text ");
    sys.stdout.write_u64(7);
    sys.stdout.write_byte(' ');
    sys.stdout.write_i64(7);
    sys.stdout.write_byte(' ');
    sys.stdout.write_u64(18446744073709551615);
    sys.stdout.write_byte('\n');
    sys.stderr.write("to stderr\n");
}
