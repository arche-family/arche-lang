// test: run
// spec: 11
// stdout: 0 héllo, ababab 14
import std;
import alloc;

fn main(sys: &mut std.System) -> !void {
    var s = alloc.String.init(sys.alloc);
    sys.stdout.write_u64(s.len() as u64);
    s.push_str("héllo");
    s.push_ascii(',');
    s.push_ascii(' ');
    var i: u32 = 0;
    while i < 3 : (i += 1) {
        s.push_str("ab");
    }
    sys.stdout.write(" ");
    sys.stdout.write(s.view());
    sys.stdout.write(" ");
    sys.stdout.write_u64(s.len() as u64);
    sys.stdout.write("\n");
}
