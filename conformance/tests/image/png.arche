        while c < changes : (c += 1) {
            let at = g.below(copy.len() as u64) as usize;
            copy.items_mut()[at] = (g.next_u64() & 0xFF) as u8;
        }
        match png.decode(copy.items(), max_pixels: 1 << 20, sys.alloc) {
            ok(_) => { decoded += 1; }
            err(_) => { }
        }
    }
    out.write("changed: ");
    out.write_u64(decoded);
    out.write(" decoded of 2000\n");
}
