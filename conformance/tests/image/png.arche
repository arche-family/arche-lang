fn hash(b: []u8) -> u64 {
    var h: u64 = 0xcbf29ce484222325;
    for x in b {
        h = (h ^ (x.* as u64)) *% 0x100000001b3;
    }
    return h;
}

fn show(out: &mut std.Output, name: str, bytes: []u8, a: alloc.Allocator) {
    out.write(name);
    match png.decode(bytes, max_pixels: 1 << 20, a) {
        ok(img) => {
            out.write(" ");
            out.write_u64(img.width as u64);
            out.write("x");
            out.write_u64(img.height as u64);
            out.write(" ");
            out.write_u64(hash(img.rgba.items()));
        }
        err(e) => {
            if e == png.PngError.BadChecksum {
                out.write(" refused: checksum");
            } else {
                out.write(" refused");
            }
        }
    }
    out.write("\n");
}

