import std;
import alloc;

fn take(xs: alloc.List(u32)) -> usize {
    return xs.len();
}

fn main(sys: &mut std.System) -> !void {
    let xs = alloc.List(u32).init(sys.alloc);
    var i: u32 = 0;
    while i < 2 : (i += 1) {
        _ = take(xs);
    }
}
