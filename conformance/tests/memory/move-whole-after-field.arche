type Pair = struct { a: alloc.String, b: alloc.String }

fn main(sys: &mut std.System) -> !void {
    let p = Pair { a: alloc.String.init(sys.alloc), b: alloc.String.init(sys.alloc) };
    let a = p.a;
    let q = p;
    _ = a;
    _ = q;
}
