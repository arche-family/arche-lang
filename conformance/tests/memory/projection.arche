// test: run
// spec: 5.4
// stdout: azero2
import std;
import alloc;

type Words = struct {
    text: alloc.String,

    fn first(self: &Words) -> str {
        let all = self.text.view();
        return all[0..1];
    }
}

fn name(n: u32) -> str {
    if n == 0 {
        return "zero";
    }
    return "other";
}

fn middle(xs: []u32) -> []u32 {
    return xs[1..xs.len() - 1];
}

fn main(sys: &mut std.System) -> !void {
    var t = alloc.String.init(sys.alloc);
    t.push_str("abc");
    let w = Words { text: t };
    sys.stdout.write(w.first());
    sys.stdout.write(name(0));
    let a: [4]u32 = [1, 2, 3, 4];
    sys.stdout.write_u64(middle(a[0..4]).len() as u64);
    sys.stdout.write("\n");
}
