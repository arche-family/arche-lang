import std;
import alloc;

fn main(sys: &mut std.System) -> !void {
    let s = alloc.String.init(sys.alloc);
    var t = alloc.String.init(sys.alloc);
    if sys.args.len() > 5 {
        t = s;
    }
    sys.stdout.write(s.view());
    sys.stdout.write(t.view());
}
