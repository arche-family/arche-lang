import std;
import alloc;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u32).init(sys.alloc);
    xs.push(1);
    let items = xs.items();
    var i: u32 = 0;
    while i < 3 : (i += 1) {
        sys.stdout.write_u64(items[0] as u64);
        xs.push(i);
    }
}
