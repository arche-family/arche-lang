import std;
import alloc;

fn numbers(a: alloc.Allocator, out: &std.Output) -> []u32 {
    var xs = alloc.List(u32).init(a);
    xs.push(1);
    return xs.items();
}

fn main(sys: &mut std.System) -> !void {
    sys.stdout.write_u64(numbers(sys.alloc, &sys.stdout).len() as u64);
}
