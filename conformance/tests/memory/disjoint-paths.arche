// test: run
// spec: 5.4
// stdout: 1133
import std;

type Pair = struct { a: u32, b: u32 }

fn bump(x: &mut u32) {
    x.* += 1;
}

fn main(sys: &mut std.System) -> !void {
    let args = &sys.args;
    let out = &mut sys.stdout;
    out.write_u64(args.len() as u64);
    var p = Pair { a: 1, b: 2 };
    let ra = &mut p.a;
    p.b = 5;
    ra.* = 7;
    let rb = &p.b;
    bump(&mut p.a);
    sys.stdout.write_u64((p.a + rb.*) as u64);
    var n: u32 = 1;
    let r = &mut n;
    r.* += 1;
    n += 1;
    sys.stdout.write_u64(n as u64);
    sys.stdout.write("\n");
}
