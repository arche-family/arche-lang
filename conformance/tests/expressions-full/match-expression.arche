// test: run
// spec: arche/3.1
// stage0: skip
// stdout: 8 3 1
import std;
import alloc;

type Shape = enum {
    Rect { w: u32, h: u32 },
    Circle { radius: u32 },
    Dot,
}

fn width(s: Shape) -> u32 {
    let w: u32 = match s {
        .Rect { w, .. } => { w }
        .Circle { radius } => { 2 * radius }
        .Dot => { 0 }
    };
    return w;
}

fn pick(c: bool, a: alloc.List(u32), b: alloc.List(u32)) -> alloc.List(u32) {
    return match c {
        true => { a }
        false => { b }
    };
}

fn main(sys: &mut std.System) -> !void {
    sys.stdout.write_u64(width(Shape.Circle { radius: 4 }) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(width(Shape.Rect { w: 3, h: 1 }) as u64);
    var a = alloc.List(u32).init(sys.alloc);
    a.push(1);
    let b = alloc.List(u32).init(sys.alloc);
    let p = pick(true, a: a, b: b);
    sys.stdout.write(" ");
    sys.stdout.write_u64(p.len() as u64);
    sys.stdout.write("\n");
}
