import std;

type E = error { Bad }

fn half(n: u32) -> E!u32 {
    if n % 2 == 1 {
        return E.Bad;
    }
    return n / 2;
}

fn f(n: u32) -> u32 {
    let h = half(n) catch break;
    return h;
}

