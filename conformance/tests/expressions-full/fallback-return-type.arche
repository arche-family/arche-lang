import std;

type E = error { Bad }

fn half(n: u32) -> E!u32 {
    if n % 2 == 1 {
        return E.Bad;
    }
    return n / 2;
}

// The return is the function's: its value has the function's type.
fn f(n: u32) -> u32 {
    let h = half(n) catch return "none";
    return h;
}

fn main(sys: &mut std.System) -> !void {
}
