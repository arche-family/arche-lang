// test: run
// spec: web (docs/sprints.md S32)
// stage0: skip
// stdout: plain 2000
// stdout: gzip gzip accept-encoding true 2000
// stdout: refused plain
// stdout: small plain
// stdout: types text/css; charset=utf-8 application/wasm application/octet-stream
import alloc;
import core.deflate;
import http;
import std;
import web;

fn answer(accept: str, length: usize, a: alloc.Allocator) -> http.Response {
    var req = http.Request.init(a);
    req.method.push_str("GET");
    req.target.push_str("/");
    if accept.len() > 0 {
        req.headers.add(name: "accept-encoding", value: accept);
    }
    var resp = http.Response.init(a);
    resp.headers.add(name: "content-type", value: "text/html");
    var i: usize = 0;
    while i < length : (i += 1) {
        resp.body.push('a' + (i % 7) as u8);
    }
    var g = web.gzip();
    web.around(&mut g, req: &req, resp: &mut resp, next: fn [](q: &http.Request, r: &mut http.Response) { });
    return resp;
}

fn encoding(resp: &http.Response) -> str {
    match resp.headers.find("content-encoding") {
        some(i) => { return resp.headers.value(i); }
        none => { return "plain"; }
    }
}

fn main(sys: &mut std.System) -> !void {
    let plain = answer("", length: 2000, sys.alloc);
    sys.stdout.write(encoding(&plain));
    sys.stdout.write(" ");
    sys.stdout.write_u64(plain.body.len() as u64);
    sys.stdout.write("\n");
    let packed = answer("br, gzip;q=0.8", length: 2000, sys.alloc);
    sys.stdout.write("gzip ");
    sys.stdout.write(encoding(&packed));
    sys.stdout.write(" ");
    match packed.headers.find("vary") {
        some(i) => { sys.stdout.write(packed.headers.value(i)); }
        none => { sys.stdout.write("no vary"); }
    }
    var back = alloc.List(u8).init(sys.alloc);
    let fine = match deflate.gunzip(packed.body.items(), out: &mut back, limit: 1 << 20) {
        ok(_) => { true }
        err(_) => { false }
    };
    sys.stdout.write(if fine and packed.body.len() < 200 { " true " } else { " false " });
    sys.stdout.write_u64(back.len() as u64);
    sys.stdout.write("\n");
    let refused = answer("gzip;q=0", length: 2000, sys.alloc);
    sys.stdout.write("refused ");
    sys.stdout.write(encoding(&refused));
    sys.stdout.write("\n");
    let small = answer("gzip", length: 100, sys.alloc);
    sys.stdout.write("small ");
    sys.stdout.write(encoding(&small));
    sys.stdout.write("\n");
    sys.stdout.write("types ");
    sys.stdout.write(web.content_type("/a/b/style.css"));
    sys.stdout.write(" ");
    sys.stdout.write(web.content_type("app.wasm"));
    sys.stdout.write(" ");
    sys.stdout.write(web.content_type("/dir.d/noext"));
    sys.stdout.write("\n");
}
