// test: run
// spec: arche/1.3
// stage0: skip
// stdout: 6
import std;

// Code with nothing unsafe in it needs nothing in the manifest.
fn main(sys: &mut std.System) -> !void {
    var total: u64 = 0;
    var x: u64 = 1;
    while x < 4 : (x += 1) {
        total += x;
    }
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
