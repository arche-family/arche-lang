import std;

fn half(n: u32) -> std.IoError!u32 {
    return n / 2;
}

fn main(sys: &mut std.System) -> !void {
    match half(4) {
        .ok(v) => { sys.stdout.write_u64(v as u64); }
        err(_) => { }
    }
}
