// test: run
// spec: arche/9
// stage0: skip
// exit: 101
// stderr: panic: deadlock: every task is waiting
import std;
import std.task;

fn main(sys: &mut std.System) -> !void {
    let ch = task.Channel(u32).init(1, sys.alloc);
    try task.scope(&sys.proc, fn [&ch](s: &mut task.Scope) -> !void {
        s.spawn(fn [&ch]() -> !void {
            let v = ch.recv(); // no one sends, and no one closes
            _ = v;
        });
    });
}
