// test: run
// spec: 6.3
// stdout: 1234
import std;

fn main(sys: &mut std.System) -> !void {

    {
        let x: u32 = 1;
        sys.stdout.write_u64(x as u64);
    }
    {
        let x: u32 = 2;
        sys.stdout.write_u64(x as u64);
    }
    var i: u32 = 0;
    while i < 2 : (i += 1) {
        let x: u32 = i + 3;
        sys.stdout.write_u64(x as u64);
    }
    sys.stdout.write("\n");
}
