// test: run
// spec: 6.1
// stdout: 8 1
import std;

fn main(sys: &mut std.System) -> !void {

    let fixed: u32 = 7;
    var count = fixed;
    count += 1;
    let n = sys.args.len();
    sys.stdout.write_u64(count as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(n as u64);
    sys.stdout.write("\n");
}
