// Random flex trees (seed 82) with absolute and fixed boxes and relative
// containers: every property mixed, nested up to three
// levels, in definite, min-content and max-content space, so that the
// port meets the combinations no hand-written case thought of.
// The expected lines are taffy 0.15's own, from the same cases in Rust
// (/tmp/layout-port/oracle-flex).
import std;
import _tree_flex;

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    _tree_flex.run(&mut sys.stdout, name: "Z11", spec: "avail=800,600 (flex dir=column-reverse wrap=wrap jc=start ai=self-end w=250.5 h=200 (flex dir=row wrap=wrap gap=4,8 jc=stretch w=calc(7.5+10%) minw=0 minh=auto maxh=calc(7.5+10%) m=auto (leaf w=100 shrink=2 p=2,4,6,8 text=75,10) (leaf maxw=200 shrink=0.3 basis=100% text=250,12.5) (leaf w=10 h=200 m=10 box=content text=30,10) (leaf minh=40 shrink=0.3 ar=1.5 fixed=10,20)) (leaf w=0 minh=25% p=3 b=1 as=self-start pos=absolute il=calc(7.5+25%) text=250,10) (flex dir=row wrap=wrap gap=10% jc=flex-end ai=safe-center shrink=2 basis=10% box=content pos=relative (leaf minh=120 grow=0.5 shrink=0.3 text=75,10)))", a);
    _tree_flex.run(&mut sys.stdout, name: "Z12", spec: "avail=800,600 round (flex dir=row wrap=wrap ac=space-around (leaf basis=100% fixed=60.5,35) (leaf w=25% maxw=10 shrink=0 m=0,5,5%,10 p=5 ar=0.5 fixed=60.5,10) (flex dir=row-reverse jc=flex-end ai=baseline p=10% (leaf w=40 h=10 grow=2 p=5 as=safe-center oy=scroll sw=5 dirn=rtl fixed=40,20)) (leaf w=50 h=25% grow=0.5 shrink=0.3 text=250,12.5) (leaf h=25% basis=max-content ar=2 fixed=10,20))", a);
    _tree_flex.run(&mut sys.stdout, name: "Z13", spec: "avail=min,max round (flex dir=column-reverse ac=flex-end (flex dir=row wrap=balance-reverse gap=5 w=12.5 h=min-content b=1 as=flex-start ox=scroll (leaf h=120 basis=25% ar=1.5 fixed=25,10) (leaf text=30,12.5) (flex dir=row w=33% shrink=0.3 m=auto (leaf w=50 h=33% m=5% ox=scroll pos=relative il=100% it=auto fixed=60.5,20) (leaf h=33.3 shrink=0 p=3 pos=absolute ir=40 text=30,12.5)) (leaf maxh=150.5 m=auto) (leaf w=33.3 maxh=12.5 shrink=1 basis=calc(7.5+10%) dirn=rtl) (leaf maxw=auto grow=0 shrink=2 m=3 pos=absolute ir=33.3 text=30,10)) (flex dir=row gap=4,8 jc=center ai=normal ac=normal minw=20 minh=150.5 grow=0 shrink=0 box=content as=center pos=relative (leaf basis=auto text=400,12.5) (leaf basis=auto p=2,4,6,8 pos=absolute it=50%) (leaf w=64 minw=33% basis=min-content as=self-start text=250,12.5)) (flex dir=row lines=3 ai=start ac=end minw=120 shrink=1 (leaf w=20 grow=3 m=auto,5,0,5% b=1 box=content as=safe-center fixed=10,35)) (flex dir=column jc=normal ai=safe-end ac=space-around grow=0.5 basis=150.5 m=-5 pos=relative il=33% it=0 (leaf basis=min-content p=2,4,6,8 fixed=25,35) (leaf maxh=150.5 m=0 p=5 fixed=40,35) (leaf h=calc(10+25%) b=1.5,2.5,3,4 pos=relative il=75% it=75.75 fixed=40,10) (leaf minw=0 minh=10% shrink=0 as=flex-end) (leaf maxw=33% grow=2 basis=stretch fixed=40,20)))", a);
    _tree_flex.run(&mut sys.stdout, name: "Z14", spec: "avail=max,max round (flex dir=row-reverse gap=5 jc=normal ai=start dirn=rtl (flex dir=row lines=3 gap=7.5 ac=stretch w=stretch shrink=1 (leaf w=calc(-5+10%) shrink=0 p=10% text=75,12.5) (leaf grow=0 shrink=0 basis=64 oy=scroll sw=10) (leaf w=75% m=5 p=3 dirn=rtl text=75,10) (leaf w=fit-content(40) shrink=2 basis=calc(7.5+10%) m=5,0,10,-5 p=10% as=center oy=scroll sw=10 text=30,10) (leaf grow=0.5 pos=fixed il=0 fixed=25,10) (leaf w=calc(7.5+50%) h=50 grow=3 basis=0 m=10 text=30,10)) (flex dir=row wrap=wrap-reverse minw=auto grow=2 shrink=0.3 basis=calc(-5+10%) pos=relative il=auto it=40 (leaf w=64 m=3 fixed=60.5,35) (leaf grow=1 shrink=1 m=5 as=self-end text=250,12.5) (leaf grow=0 text=30,12.5) (flex dir=row ai=stretch ac=space-evenly h=calc(7.5+25%) grow=0.5 p=5 ar=1 (leaf w=33% h=33.3 minh=100 b=2 fixed=40,10) (leaf w=calc(-5+50%) h=0 maxh=40 m=-5 text=30,12.5) (leaf h=200 maxw=75.75 shrink=0 box=content as=center))) (flex dir=row wrap=wrap ai=start grow=1 m=3,5%,5,auto pos=relative (leaf grow=0 box=content pos=relative il=auto it=25% text=75,10) (leaf h=12.5 grow=0.5 shrink=0 basis=5 p=3 text=250,10) (flex dir=row gap=4,8 jc=stretch ac=safe-center dirn=rtl w=12.5 minw=10% p=10% box=content ox=hidden (leaf h=100% grow=0.5 fixed=60.5,20) (leaf w=33.3 shrink=2 m=auto pos=absolute it=10% text=120,10) (leaf h=33% grow=2 shrink=2 text=250,12.5)) (leaf w=max-content maxw=12.5 maxh=0 m=-5 text=75,12.5) (leaf p=5 box=content text=30,12.5)) (leaf w=calc(10+10%) maxh=100% shrink=0 as=baseline pos=relative il=auto it=10% text=30,12.5))", a);
    _tree_flex.run(&mut sys.stdout, name: "Z15", spec: "avail=800,600 (flex dir=row-reverse w=250.5 h=50% (leaf w=stretch basis=fit-content m=5% p=10% as=baseline fixed=10,20) (flex dir=row wrap=balance-reverse jc=start minw=33% maxw=75% minh=12.5 shrink=0.3 basis=calc(0+50%) as=flex-end oy=hidden sw=5 (leaf w=20 h=33% m=5% p=2,4,6,8 b=2 fixed=40,20)))", a);
    _tree_flex.run(&mut sys.stdout, name: "Z16", spec: "avail=800,600 (flex dir=column wrap=wrap lines=2 dirn=rtl w=400 h=50% (leaf w=75% minw=20 grow=0 shrink=1 m=auto b=1.5,2.5,3,4 text=120,12.5) (leaf w=calc(0+25%) h=100% maxw=10 maxh=64 grow=0 box=content as=safe-center fixed=25,20))", a);
