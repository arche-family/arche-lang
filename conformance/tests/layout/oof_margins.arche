    _show.layout_line(out, "M5.2r", t.final_of(n2));
    _show.layout_line(out, "M5.3r", t.final_of(n3));
    _show.layout_line(out, "M5.4r", t.final_of(n4));
    _show.layout_line(out, "M5.5r", t.final_of(n5));
}

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    case_m1(&mut sys.stdout, a);
    case_m2(&mut sys.stdout, a);
    case_m3(&mut sys.stdout, a);
    case_m4(&mut sys.stdout, a);
    case_m5(&mut sys.stdout, a);
}
