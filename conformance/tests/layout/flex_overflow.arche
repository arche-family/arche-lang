// Overflow: scrollable overflow of items that overflow their container
// and of nested contents, scroll containers with scrollbar gutters (in
// ltr and rtl), hidden and clip, contain, items' automatic minimum size
// as scroll containers, and their scrollbar sizes.
// The expected lines are taffy 0.15's own, from the same cases in Rust
// (/tmp/layout-port/oracle-flex).
import std;
import _tree_flex;

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    _tree_flex.run(&mut sys.stdout, name: "V1", spec: "(flex w=100 h=50 (leaf w=150 h=80 shrink=0) (leaf w=30 h=20))", a);
    _tree_flex.run(&mut sys.stdout, name: "V2", spec: "(flex w=100 h=50 oy=scroll ox=scroll sw=10 p=5 (leaf w=150 h=80 shrink=0) (leaf w=30 h=20))", a);
    _tree_flex.run(&mut sys.stdout, name: "V3", spec: "(flex w=100 h=50 oy=scroll sw=10 dirn=rtl p=5,7,3,2 b=1 (leaf w=150 h=80 shrink=0) (leaf w=30 h=20))", a);
    _tree_flex.run(&mut sys.stdout, name: "V4", spec: "(flex w=100 h=50 ox=hidden oy=hidden (leaf w=150 h=80 shrink=0))", a);
    _tree_flex.run(&mut sys.stdout, name: "V5", spec: "(flex w=200 h=100 (flex w=50 h=50 ox=clip (leaf w=150 h=80 shrink=0)) (flex w=50 h=50 (leaf w=150 h=80 shrink=0)) (flex w=50 h=50 contain=paint (leaf w=150 h=80 shrink=0)))", a);
    _tree_flex.run(&mut sys.stdout, name: "V6", spec: "(flex w=200 h=100 (leaf text=500,10 ox=hidden) (leaf text=500,10))", a);
    _tree_flex.run(&mut sys.stdout, name: "V7", spec: "(flex w=200 h=100 (leaf w=50 oy=scroll ox=scroll sw=8) (leaf w=50 oy=scroll sw=8))", a);
    _tree_flex.run(&mut sys.stdout, name: "V8", spec: "(flex dir=column w=100 h=100 oy=scroll sw=15 (leaf h=60 text=200,10) (leaf h=60))", a);
    _tree_flex.run(&mut sys.stdout, name: "V9", spec: "(flex w=100 h=100 dir=column (leaf h=150 shrink=1 oy=hidden) (leaf h=150 shrink=1))", a);
    _tree_flex.run(&mut sys.stdout, name: "V10", spec: "(flex w=100 h=50 m=10 (leaf w=150 h=80 shrink=0 m=-30) (leaf w=30 h=20 pos=relative il=-40 it=-10))", a);
    _tree_flex.run(&mut sys.stdout, name: "V11", spec: "(flex w=100 h=50 dirn=rtl (leaf w=150 h=80 shrink=0) (leaf w=30 h=20))", a);
    _tree_flex.run(&mut sys.stdout, name: "V12", spec: "mode=direct (flex w=100 h=50 oy=scroll sw=10 ai=baseline (leaf w=30 h=20 fixed=10,40) (flex w=30 h=20 oy=hidden ai=baseline (leaf h=60 w=10 mt=50) (leaf h=60 w=10)))", a);
}
