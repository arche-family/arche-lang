// stdout: I6.6r at 385.0 205.0 size 10.0 120.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 10.0 0.0 120.0 | sb 0.0 0.0 | order 5
// Out-of-flow boxes against a relative container (its positioning area
// 390x290 at 5,5): every combination of auto and set insets, in pixels,
// percentages of the area and calc(); stretch-fit sizes when both insets of
// an axis are set, fit-content otherwise; overconstrained and negative
// insets; an rtl container. The expected lines are taffy 0.15's own, from
// the same trees in Rust (/tmp/layout-port/oracle-oof).
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import _show;
import _tree_oof;

/// one inset or none in each axis.
fn case_i1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_oof.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.position = sty.Position.Relative;
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.length(300.0) };
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(10.0), right: sty.LengthPercentage.length(10.0), top: sty.LengthPercentage.length(10.0), bottom: sty.LengthPercentage.length(10.0) };
    s0.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(5.0), right: sty.LengthPercentage.length(5.0), top: sty.LengthPercentage.length(5.0), bottom: sty.LengthPercentage.length(5.0) };
    let n0 = t.add(s0, _tree_oof.Content.Stack);
    var s1 = sty.Style.default(a);
    s1.position = sty.Position.Absolute;
    s1.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(20.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(30.0), bottom: sty.LengthPercentageAuto.auto() };
    let n1 = t.add(s1, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    s2.position = sty.Position.Absolute;
    s2.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.length(20.0), top: sty.LengthPercentageAuto.auto(), bottom: sty.LengthPercentageAuto.length(30.0) };
    let n2 = t.add(s2, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n2);
    var s3 = sty.Style.default(a);
    s3.position = sty.Position.Absolute;
    s3.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(20.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.auto(), bottom: sty.LengthPercentageAuto.length(7.0) };
    let n3 = t.add(s3, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n3);
    var s4 = sty.Style.default(a);
    s4.position = sty.Position.Absolute;
    s4.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.length(15.0), top: sty.LengthPercentageAuto.length(3.0), bottom: sty.LengthPercentageAuto.auto() };
    let n4 = t.add(s4, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n4);
    var s5 = sty.Style.default(a);
    s5.position = sty.Position.Absolute;
    let n5 = t.add(s5, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n5);
    var s6 = sty.Style.default(a);
    s6.position = sty.Position.Absolute;
    s6.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(12.0), bottom: sty.LengthPercentageAuto.auto() };
    let n6 = t.add(s6, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n6);
    var s7 = sty.Style.default(a);
    s7.position = sty.Position.Absolute;
    s7.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.length(12.0), top: sty.LengthPercentageAuto.auto(), bottom: sty.LengthPercentageAuto.auto() };
    let n7 = t.add(s7, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n7);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _show.layout_line(out, "I1.0", t.unrounded_of(n0));
    _show.layout_line(out, "I1.1", t.unrounded_of(n1));
    _show.layout_line(out, "I1.2", t.unrounded_of(n2));
    _show.layout_line(out, "I1.3", t.unrounded_of(n3));
    _show.layout_line(out, "I1.4", t.unrounded_of(n4));
    _show.layout_line(out, "I1.5", t.unrounded_of(n5));
    _show.layout_line(out, "I1.6", t.unrounded_of(n6));
    _show.layout_line(out, "I1.7", t.unrounded_of(n7));
    t.hoisted_line(out, "I1.0", n0);
    compute.round_layout(&mut t, n0);
    _show.layout_line(out, "I1.0r", t.final_of(n0));
    _show.layout_line(out, "I1.1r", t.final_of(n1));
    _show.layout_line(out, "I1.2r", t.final_of(n2));
    _show.layout_line(out, "I1.3r", t.final_of(n3));
    _show.layout_line(out, "I1.4r", t.final_of(n4));
    _show.layout_line(out, "I1.5r", t.final_of(n5));
    _show.layout_line(out, "I1.6r", t.final_of(n6));
    _show.layout_line(out, "I1.7r", t.final_of(n7));
}

