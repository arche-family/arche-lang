// Margins and relative positions: fixed and percentage margins in both
// axes, auto margins in the main axis (sharing free space, none when
// overflowing) and the cross axis (centring, start, end, overflow), and
// position: relative insets in rows, columns, reversed and rtl.
// The expected lines are taffy 0.15's own, from the same cases in Rust
// (/tmp/layout-port/oracle-flex).
import std;
import _tree_flex;

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    _tree_flex.run(&mut sys.stdout, name: "M1", spec: "(flex w=300 h=100 (leaf w=50 m=10) (leaf w=50 m=5,15,20,0))", a);
    _tree_flex.run(&mut sys.stdout, name: "M2", spec: "(flex w=300 h=100 (leaf w=50 ml=auto) (leaf w=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "M3", spec: "(flex w=300 h=100 (leaf w=50 ml=auto mr=auto) (leaf w=50 ml=auto))", a);
    _tree_flex.run(&mut sys.stdout, name: "M4", spec: "(flex w=300 h=100 jc=center (leaf w=50 mr=auto) (leaf w=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "M5", spec: "(flex w=100 h=100 (leaf w=80 ml=auto shrink=0) (leaf w=80 shrink=0))", a);
    _tree_flex.run(&mut sys.stdout, name: "M6", spec: "(flex w=300 h=100 (leaf w=50 h=20 mt=auto) (leaf w=50 h=20 mb=auto) (leaf w=50 h=20 mt=auto mb=auto))", a);
    _tree_flex.run(&mut sys.stdout, name: "M7", spec: "(flex w=300 h=100 (leaf w=50 mt=auto) (leaf w=50 h=150 mt=auto mb=auto) (leaf w=50 h=150 mt=auto))", a);
    _tree_flex.run(&mut sys.stdout, name: "M8", spec: "(flex dir=column w=300 h=100 (leaf w=50 h=20 ml=auto) (leaf w=50 h=20 mr=auto ml=auto) (leaf h=20 ml=auto))", a);
    _tree_flex.run(&mut sys.stdout, name: "M9", spec: "(flex dir=column w=300 h=300 (leaf h=50 mt=auto) (leaf h=50 mb=auto) (leaf h=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "M10", spec: "(flex w=300 h=100 (leaf w=50 m=10%) (leaf w=50 mt=5% mb=calc(1+1%)))", a);
    _tree_flex.run(&mut sys.stdout, name: "M11", spec: "(flex w=300 h=100 (leaf w=50 pos=relative il=10 it=5) (leaf w=50 pos=relative ir=10 ib=5) (leaf w=50 pos=relative il=10 ir=99 it=5 ib=99))", a);
    _tree_flex.run(&mut sys.stdout, name: "M12", spec: "(flex w=300 h=100 dir=column (leaf h=30 pos=relative il=10% it=10%) (leaf h=30 pos=relative ir=20 ib=calc(5+5%)))", a);
    _tree_flex.run(&mut sys.stdout, name: "M13", spec: "(flex w=300 h=100 dirn=rtl (leaf w=50 pos=relative il=10 ir=20) (leaf w=50 pos=relative il=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "M14", spec: "(flex w=300 h=100 dir=column dirn=rtl (leaf h=30 w=50 pos=relative il=10 ir=20) (leaf h=30 w=50 pos=relative ir=7))", a);
    _tree_flex.run(&mut sys.stdout, name: "M15", spec: "(flex w=300 h=100 dir=row-reverse (leaf w=50 ml=auto) (leaf w=50 m=5))", a);
    _tree_flex.run(&mut sys.stdout, name: "M16", spec: "(flex w=300 h=100 wrap=wrap (leaf w=200 h=20 ml=auto) (leaf w=200 h=30 mt=auto mr=auto))", a);
    _tree_flex.run(&mut sys.stdout, name: "M17", spec: "(flex w=300 h=100 (leaf w=50 m=-10) (leaf w=50 ml=-20 mt=-5))", a);
    _tree_flex.run(&mut sys.stdout, name: "M18", spec: "(flex w=300 dir=column (leaf h=20 m=auto) (leaf h=20 w=100 m=auto))", a);
    _tree_flex.run(&mut sys.stdout, name: "M19", spec: "(flex w=300 h=100 dirn=rtl (leaf w=50 ml=auto m=5,auto,5,5) (leaf w=60 m=7))", a);
    _tree_flex.run(&mut sys.stdout, name: "M20", spec: "(flex w=300 h=100 pos=relative il=10 it=20 (leaf w=50 pos=relative il=5))", a);
}
