    var t = _tree_grid.TestTree.init(a);
    var s0 = sty.Style.default(a);
    var rt1 = alloc.List(sgrid.TrackSizingFunction).init(a);
    rt1.push(sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(500.0), max: sgrid.MaxTrackSizingFunction.length(500.0) });
    var rn2 = alloc.List(alloc.List(alloc.Symbol)).init(a);
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Repeat { repetition: sgrid.GridTemplateRepetition { count: sgrid.RepetitionCount.AutoFill, tracks: rt1, line_names: rn2 } });
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(200.0), height: sty.Dimension.auto() };
    s0.display = sty.Display.Grid;
    let n0 = t.add(s0, _tree_grid.Content.Empty);
    var s1 = sty.Style.default(a);
    let n1 = t.add(s1, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n1);
    let avail = geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) };
    compute.compute_root_layout(&mut t, n0, avail);
    _show.layout_line(out, "R14.0", t.unrounded_of(n0));
    _show.layout_line(out, "R14.1", t.unrounded_of(n1));
    _tree_grid.counts_line(out, "R14", &t);
}

/// R15
fn case_r15(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_grid.TestTree.init(a);
    var s0 = sty.Style.default(a);
    var rt1 = alloc.List(sgrid.TrackSizingFunction).init(a);
    rt1.push(sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(30.0), max: sgrid.MaxTrackSizingFunction.length(30.0) });
    rt1.push(sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) });
    var rn2 = alloc.List(alloc.List(alloc.Symbol)).init(a);
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Repeat { repetition: sgrid.GridTemplateRepetition { count: sgrid.RepetitionCount.AutoFit, tracks: rt1, line_names: rn2 } });
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(200.0), height: sty.Dimension.auto() };
    s0.gap = geo.Size(sty.LengthPercentage) { width: sty.LengthPercentage.length(8.0), height: sty.LengthPercentage.length(8.0) };
    s0.justify_content = sty.AlignContent { keyword: sty.AlignContentKeyword.Center, safety: sty.AlignmentSafety.Default };
    s0.display = sty.Display.Grid;
    let n0 = t.add(s0, _tree_grid.Content.Empty);
    var s1 = sty.Style.default(a);
    let n1 = t.add(s1, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    let n2 = t.add(s2, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n2);
    var s3 = sty.Style.default(a);
    let n3 = t.add(s3, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n3);
    let avail = geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) };
    compute.compute_root_layout(&mut t, n0, avail);
    _show.layout_line(out, "R15.0", t.unrounded_of(n0));
    _show.layout_line(out, "R15.1", t.unrounded_of(n1));
    _show.layout_line(out, "R15.2", t.unrounded_of(n2));
    _show.layout_line(out, "R15.3", t.unrounded_of(n3));
    _tree_grid.counts_line(out, "R15", &t);
}

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    case_r1(&mut sys.stdout, a);
    case_r2(&mut sys.stdout, a);
    case_r3(&mut sys.stdout, a);
    case_r4(&mut sys.stdout, a);
    case_r5(&mut sys.stdout, a);
    case_r6(&mut sys.stdout, a);
    case_r7(&mut sys.stdout, a);
    case_r8(&mut sys.stdout, a);
    case_r9(&mut sys.stdout, a);
    case_r10(&mut sys.stdout, a);
    case_r11(&mut sys.stdout, a);
    case_r12(&mut sys.stdout, a);
    case_r13(&mut sys.stdout, a);
    case_r14(&mut sys.stdout, a);
    case_r15(&mut sys.stdout, a);
}
