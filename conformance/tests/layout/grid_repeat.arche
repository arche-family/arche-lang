// repeat(): a count, auto-fill and auto-fit against a size, a max size and a
// min size, with gaps, auto-fit tracks without items collapsing (also at the
// end of the list), templates repeat() makes invalid, auto rows.
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import layout.style.grid as sgrid;
import layout.tree as lt;
import _show;
import _tree_grid;

/// R1
fn case_r1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_grid.TestTree.init(a);
    var s0 = sty.Style.default(a);
    var rt1 = alloc.List(sgrid.TrackSizingFunction).init(a);
    rt1.push(sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(40.0), max: sgrid.MaxTrackSizingFunction.length(40.0) });
    rt1.push(sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) });
    var rn2 = alloc.List(alloc.List(alloc.Symbol)).init(a);
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Repeat { repetition: sgrid.GridTemplateRepetition { count: sgrid.RepetitionCount.Count { count: 3 }, tracks: rt1, line_names: rn2 } });
    var rt3 = alloc.List(sgrid.TrackSizingFunction).init(a);
    rt3.push(sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(15.0), max: sgrid.MaxTrackSizingFunction.length(15.0) });
    var rn4 = alloc.List(alloc.List(alloc.Symbol)).init(a);
    s0.grid_template_rows.push(sgrid.GridTemplateComponent.Repeat { repetition: sgrid.GridTemplateRepetition { count: sgrid.RepetitionCount.Count { count: 2 }, tracks: rt3, line_names: rn4 } });
    s0.display = sty.Display.Grid;
    let n0 = t.add(s0, _tree_grid.Content.Empty);
    var s1 = sty.Style.default(a);
    let n1 = t.add(s1, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    let n2 = t.add(s2, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n2);
    var s3 = sty.Style.default(a);
    let n3 = t.add(s3, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n3);
    var s4 = sty.Style.default(a);
    let n4 = t.add(s4, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n4);
    var s5 = sty.Style.default(a);
    let n5 = t.add(s5, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n5);
    var s6 = sty.Style.default(a);
    let n6 = t.add(s6, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n6);
    var s7 = sty.Style.default(a);
    let n7 = t.add(s7, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n7);
    let avail = geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) };
    compute.compute_root_layout(&mut t, n0, avail);
    _show.layout_line(out, "R1.0", t.unrounded_of(n0));
    _show.layout_line(out, "R1.1", t.unrounded_of(n1));
    _show.layout_line(out, "R1.2", t.unrounded_of(n2));
    _show.layout_line(out, "R1.3", t.unrounded_of(n3));
    _show.layout_line(out, "R1.4", t.unrounded_of(n4));
    _show.layout_line(out, "R1.5", t.unrounded_of(n5));
    _show.layout_line(out, "R1.6", t.unrounded_of(n6));
    _show.layout_line(out, "R1.7", t.unrounded_of(n7));
    _tree_grid.counts_line(out, "R1", &t);
}

/// R2
fn case_r2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_grid.TestTree.init(a);
    var s0 = sty.Style.default(a);
    var rt1 = alloc.List(sgrid.TrackSizingFunction).init(a);
    rt1.push(sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(50.0), max: sgrid.MaxTrackSizingFunction.length(50.0) });
    var rn2 = alloc.List(alloc.List(alloc.Symbol)).init(a);
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Repeat { repetition: sgrid.GridTemplateRepetition { count: sgrid.RepetitionCount.AutoFill, tracks: rt1, line_names: rn2 } });
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(230.0), height: sty.Dimension.auto() };
    s0.display = sty.Display.Grid;
    let n0 = t.add(s0, _tree_grid.Content.Empty);
    var s1 = sty.Style.default(a);
    let n1 = t.add(s1, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    let n2 = t.add(s2, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n2);
    var s3 = sty.Style.default(a);
    let n3 = t.add(s3, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n3);
    var s4 = sty.Style.default(a);
    let n4 = t.add(s4, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n4);
    var s5 = sty.Style.default(a);
    let n5 = t.add(s5, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n5);
    let avail = geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) };
    compute.compute_root_layout(&mut t, n0, avail);
    _show.layout_line(out, "R2.0", t.unrounded_of(n0));
    _show.layout_line(out, "R2.1", t.unrounded_of(n1));
    _show.layout_line(out, "R2.2", t.unrounded_of(n2));
    _show.layout_line(out, "R2.3", t.unrounded_of(n3));
    _show.layout_line(out, "R2.4", t.unrounded_of(n4));
    _show.layout_line(out, "R2.5", t.unrounded_of(n5));
    _tree_grid.counts_line(out, "R2", &t);
}

