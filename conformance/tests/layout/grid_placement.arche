fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    case_p1(&mut sys.stdout, a);
    case_p2(&mut sys.stdout, a);
    case_p3(&mut sys.stdout, a);
    case_p4(&mut sys.stdout, a);
    case_p5(&mut sys.stdout, a);
    case_p6(&mut sys.stdout, a);
    case_p7(&mut sys.stdout, a);
    case_p8(&mut sys.stdout, a);
    case_p9(&mut sys.stdout, a);
    case_p10(&mut sys.stdout, a);
    case_p11(&mut sys.stdout, a);
    case_p12(&mut sys.stdout, a);
    case_p13(&mut sys.stdout, a);
}
