    _show.layout_line(out, "P11.1", t.unrounded_of(n1));
    _show.layout_line(out, "P11.2", t.unrounded_of(n2));
    _show.layout_line(out, "P11.3", t.unrounded_of(n3));
    _tree_grid.counts_line(out, "P11", &t);
}

/// P12
fn case_p12(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_grid.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) } });
    s0.grid_template_rows.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(10.0), max: sgrid.MaxTrackSizingFunction.length(10.0) } });
    s0.display = sty.Display.Grid;
    let n0 = t.add(s0, _tree_grid.Content.Empty);
    var s1 = sty.Style.default(a);
    s1.grid_column = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.from_line_index(0), end: sgrid.GridPlacement.from_line_index(2) };
    let n1 = t.add(s1, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    s2.grid_row = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.from_line_index(0), end: sgrid.GridPlacement.Auto };
    let n2 = t.add(s2, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n2);
    let avail = geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) };
    compute.compute_root_layout(&mut t, n0, avail);
    _show.layout_line(out, "P12.0", t.unrounded_of(n0));
    _show.layout_line(out, "P12.1", t.unrounded_of(n1));
    _show.layout_line(out, "P12.2", t.unrounded_of(n2));
    _tree_grid.counts_line(out, "P12", &t);
}

