// Placement: definite lines and spans, negative lines, lines past the
// explicit grid, items definite in one axis, grid-auto-flow row, column
// and dense, an item spanning every column, start lines after end lines.
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import layout.style.grid as sgrid;
import layout.tree as lt;
import _show;
import _tree_grid;

/// P1
fn case_p1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_grid.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(30.0), max: sgrid.MaxTrackSizingFunction.length(30.0) } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(30.0), max: sgrid.MaxTrackSizingFunction.length(30.0) } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(30.0), max: sgrid.MaxTrackSizingFunction.length(30.0) } });
    s0.grid_template_rows.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) } });
    s0.grid_template_rows.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) } });
    s0.grid_template_rows.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) } });
    s0.display = sty.Display.Grid;
    let n0 = t.add(s0, _tree_grid.Content.Empty);
    var s1 = sty.Style.default(a);
    s1.grid_row = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.from_line_index(2), end: sgrid.GridPlacement.from_line_index(3) };
    s1.grid_column = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.from_line_index(2), end: sgrid.GridPlacement.from_line_index(4) };
    let n1 = t.add(s1, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    let n2 = t.add(s2, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n2);
    var s3 = sty.Style.default(a);
    s3.grid_column = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.from_span(2), end: sgrid.GridPlacement.Auto };
    let n3 = t.add(s3, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n3);
    var s4 = sty.Style.default(a);
    let n4 = t.add(s4, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n4);
    let avail = geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) };
    compute.compute_root_layout(&mut t, n0, avail);
    _show.layout_line(out, "P1.0", t.unrounded_of(n0));
    _show.layout_line(out, "P1.1", t.unrounded_of(n1));
    _show.layout_line(out, "P1.2", t.unrounded_of(n2));
    _show.layout_line(out, "P1.3", t.unrounded_of(n3));
    _show.layout_line(out, "P1.4", t.unrounded_of(n4));
    _tree_grid.counts_line(out, "P1", &t);
}

/// P2
fn case_p2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_grid.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(30.0), max: sgrid.MaxTrackSizingFunction.length(30.0) } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(30.0), max: sgrid.MaxTrackSizingFunction.length(30.0) } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(30.0), max: sgrid.MaxTrackSizingFunction.length(30.0) } });
    s0.grid_template_rows.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) } });
    s0.grid_template_rows.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) } });
    s0.display = sty.Display.Grid;
    let n0 = t.add(s0, _tree_grid.Content.Empty);
    var s1 = sty.Style.default(a);
    s1.grid_column = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.from_line_index(-1), end: sgrid.GridPlacement.from_line_index(-3) };
    let n1 = t.add(s1, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    s2.grid_row = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.from_line_index(-2), end: sgrid.GridPlacement.Auto };
    s2.grid_column = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.from_line_index(1), end: sgrid.GridPlacement.Auto };
    let n2 = t.add(s2, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n2);
    var s3 = sty.Style.default(a);
    let n3 = t.add(s3, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n3);
    let avail = geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) };
    compute.compute_root_layout(&mut t, n0, avail);
    _show.layout_line(out, "P2.0", t.unrounded_of(n0));
    _show.layout_line(out, "P2.1", t.unrounded_of(n1));
    _show.layout_line(out, "P2.2", t.unrounded_of(n2));
    _show.layout_line(out, "P2.3", t.unrounded_of(n3));
    _tree_grid.counts_line(out, "P2", &t);
}

