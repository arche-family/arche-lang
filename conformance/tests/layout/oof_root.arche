    let n2 = t.add(s2, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n2);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _show.layout_line(out, "R9.0", t.unrounded_of(n0));
    _show.layout_line(out, "R9.1", t.unrounded_of(n1));
    _show.layout_line(out, "R9.2", t.unrounded_of(n2));
    t.hoisted_line(out, "R9.0", n0);
    compute.round_layout(&mut t, n0);
    _show.layout_line(out, "R9.0r", t.final_of(n0));
    _show.layout_line(out, "R9.1r", t.final_of(n1));
    _show.layout_line(out, "R9.2r", t.final_of(n2));
}

/// a fixed leaf root with a min-content viewport width is laid out in flow.
fn case_r10(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_oof.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.position = sty.Position.Fixed;
    s0.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(10.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.auto(), bottom: sty.LengthPercentageAuto.auto() };
    let n0 = t.add(s0, _tree_oof.Content.Text { width: 300.0, line: 20.0 });
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MinContent, height: sty.AvailableSpace.definite(300.0) });
    _show.layout_line(out, "R10.0", t.unrounded_of(n0));
    t.hoisted_line(out, "R10.0", n0);
    compute.round_layout(&mut t, n0);
    _show.layout_line(out, "R10.0r", t.final_of(n0));
}

/// a fixed leaf root sized by aspect ratio and min size.
fn case_r11(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_oof.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.position = sty.Position.Fixed;
    s0.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.length(20.0), top: sty.LengthPercentageAuto.auto(), bottom: sty.LengthPercentageAuto.length(20.0) };
    s0.aspect_ratio = some(2.0);
    s0.min_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.length(90.0), height: sty.LengthPercentageAuto.auto() };
    let n0 = t.add(s0, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _show.layout_line(out, "R11.0", t.unrounded_of(n0));
    t.hoisted_line(out, "R11.0", n0);
    compute.round_layout(&mut t, n0);
    _show.layout_line(out, "R11.0r", t.final_of(n0));
}

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    case_r1(&mut sys.stdout, a);
    case_r2(&mut sys.stdout, a);
    case_r3(&mut sys.stdout, a);
    case_r4(&mut sys.stdout, a);
    case_r5(&mut sys.stdout, a);
    case_r6(&mut sys.stdout, a);
    case_r7(&mut sys.stdout, a);
    case_r8(&mut sys.stdout, a);
    case_r9(&mut sys.stdout, a);
    case_r10(&mut sys.stdout, a);
    case_r11(&mut sys.stdout, a);
}
