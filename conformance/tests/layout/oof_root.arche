// compute_root_layout with out-of-flow boxes: an absolute or fixed root,
// laid out as any out-of-flow box against the viewport when both axes are
// definite and in flow otherwise; the initial containing block of the last
// pass, the viewport at the canvas origin, or the root's padding box in an
// indefinite axis; relative and block roots; a scrollbar on the root; and
// a second layout of the same tree, whose cached root keeps its hoisted
// list. The expected lines are taffy 0.15's own, from the same trees in
// Rust (/tmp/layout-port/oracle-oof).
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import _show;
import _tree_oof;

/// an absolute root with insets and auto margins, its children.
fn case_r1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_oof.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.position = sty.Position.Absolute;
    s0.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(100.0), right: sty.LengthPercentageAuto.length(100.0), top: sty.LengthPercentageAuto.length(50.0), bottom: sty.LengthPercentageAuto.auto() };
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.length(200.0) };
    s0.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(5.0), right: sty.LengthPercentage.length(5.0), top: sty.LengthPercentage.length(5.0), bottom: sty.LengthPercentage.length(5.0) };
    let n0 = t.add(s0, _tree_oof.Content.Stack);
    var s1 = sty.Style.default(a);
    s1.position = sty.Position.Absolute;
    s1.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(10.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.auto() };
    let n1 = t.add(s1, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n1);
