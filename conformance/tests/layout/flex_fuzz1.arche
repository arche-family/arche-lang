// Random flex trees (seed 11): every property mixed, nested up to three
// levels, in definite, min-content and max-content space, so that the
// port meets the combinations no hand-written case thought of.
// The expected lines are taffy 0.15's own, from the same cases in Rust
// (/tmp/layout-port/oracle-flex).
import std;
import _tree_flex;

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    _tree_flex.run(&mut sys.stdout, name: "F11", spec: "avail=max,max (flex dir=row-reverse wrap=balance-reverse jc=normal ac=center dirn=rtl w=300 (flex dir=column-reverse jc=start ai=flex-end w=12.5 ar=0.5 dirn=rtl (flex dir=row wrap=balance jc=safe-center ai=end ac=start h=0 ar=1.5 ox=hidden (leaf w=20 minw=10% p=5 fixed=10,20)) (leaf w=120 grow=0 shrink=2 as=center pos=relative il=10 it=auto text=400,10)) (flex dir=row wrap=wrap-reverse jc=safe-center ai=end h=100% maxw=5 (flex dir=column-reverse wrap=balance gap=7.5 jc=normal ai=start ac=end maxw=25% grow=2 basis=100 (leaf minw=calc(10+25%) m=3 text=75,10) (flex dir=row wrap=balance-reverse ac=space-around maxw=75% b=1.5,2.5,3,4 as=start (leaf h=stretch as=normal) (leaf w=25%)) (flex dir=column-reverse wrap=wrap ai=self-start ac=start w=fit-content(40) maxh=auto (flex dir=row gap=10 jc=safe-center ai=safe-end ac=normal shrink=2 (flex dir=column gap=10 ai=flex-end ac=end w=fit-content grow=3 p=10% as=end ox=clip (leaf maxw=auto box=content text=400,10)) (leaf w=stretch grow=1 shrink=0 text=250,10)))) (leaf w=25% h=max-content grow=2 b=1.5,2.5,3,4 display=none text=120,12.5) (flex dir=column-reverse lines=3 jc=normal basis=64 m=auto,-5,5%,5% b=1 oy=scroll sw=10 pos=relative il=calc(-5+10%) it=150.5 (flex dir=row jc=normal ai=end ac=start w=40 b=2 (leaf w=min-content minw=auto grow=3 shrink=0 m=-5 as=end text=120,12.5)) (leaf w=calc(7.5+25%) grow=1 shrink=0 ar=1.5 text=75,10) (leaf minw=100 grow=1 shrink=0.3 basis=auto)) (leaf w=75.75 h=50% minw=10% grow=0 basis=stretch fixed=10,35)) (flex dir=row wrap=wrap-reverse m=10 (leaf h=12.5 text=75,12.5)) (leaf basis=33.3 fixed=10,10))", a);
