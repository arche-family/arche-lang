// stdout: X5.5 at 25.0 50.0 size 250.0 10.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 0.0 0.0 0.0 | sb 0.0 0.0 | order 4
// stdout: X5.6 at 240.0 60.0 size 60.0 10.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 60.0 0.0 10.0 | sb 0.0 0.0 | order 5
// stdout: X6.0 at 0.0 0.0 size 300.0 50.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 300.0 0.0 50.0 | sb 0.0 0.0 | order 0
// stdout: X6.1 at 200.0 0.0 size 100.0 50.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 0.0 0.0 0.0 | sb 0.0 0.0 | order 0
// stdout: X6.2 at 0.0 0.0 size 200.0 30.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 200.0 0.0 20.0 | sb 0.0 0.0 | order 1
// stdout: X6.3 at 0.0 10.0 size 200.0 10.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 0.0 0.0 0.0 | sb 0.0 0.0 | order 0
// stdout: X6.4 at 0.0 30.0 size 200.0 20.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 200.0 0.0 20.0 | sb 0.0 0.0 | order 2
// stdout: X6.5 at 0.0 0.0 size 20.0 20.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 0.0 0.0 0.0 | sb 0.0 0.0 | order 0
// stdout: X6.6 at 0.0 0.0 size 200.0 5.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 0.0 0.0 0.0 | sb 0.0 0.0 | order 1
// Block layout's remaining paths: children that are not block boxes (a flex
// leaf, a table) beside floats, a container whose min and max decide its
// size or whose aspect ratio gives its height, percentage padding without
// a parent size, a size-only run for the height alone, and justify-self
// beside a float. The expected lines are taffy 0.15's own, from the same
// trees in Rust.
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import layout.tree as lt;
import _tree_block;

/// Case X1: a flex leaf and a table beside floats
fn case_x1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.float = sty.Float.Left;
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(40.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.display = sty.Display.Flex;
    let n2 = t.add(s2, _tree_block.Content.Text { width: 150.0, line: 10.0 });
    var s3 = _tree_block.blk(a);
    s3.item_is_table = true;
    let n3 = t.add(s3, _tree_block.Content.Fixed { width: 80.0, height: 10.0 });
    var s4 = _tree_block.blk(a);
    s4.display = sty.Display.Flex;
    let n4 = t.add(s4, _tree_block.Content.Fixed { width: 250.0, height: 10.0 });
    var s5 = _tree_block.blk(a);
    s5.item_is_table = true;
    s5.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(5.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    let n5 = t.add(s5, _tree_block.Content.Fixed { width: 350.0, height: 10.0 });
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    t.add_child(parent: n0, child: n5);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "X1");
}

/// Case X2: min over max decides, and an aspect ratio gives the height
fn case_x2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.min_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.length(150.0), height: sty.LengthPercentageAuto.length(60.0) };
    s1.max_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.length(100.0), height: sty.LengthPercentageAuto.length(20.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.aspect_ratio = some(4.0);
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(200.0), height: sty.Dimension.auto() };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.aspect_ratio = some(4.0);
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(200.0), height: sty.Dimension.auto() };
    s5.max_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.auto(), height: sty.LengthPercentageAuto.length(30.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    var s6 = _tree_block.blk(a);
    s6.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(100.0) };
    let n6 = t.add(s6, _tree_block.Content.Empty);
    t.add_child(parent: n1, child: n2);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n3, child: n4);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n5, child: n6);
    t.add_child(parent: n0, child: n5);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "X2");
}

/// Case X3: percentage padding with no parent size
fn case_x3(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.percent(0.05), right: sty.LengthPercentage.percent(0.05), top: sty.LengthPercentage.percent(0.05), bottom: sty.LengthPercentage.percent(0.05) };
    s0.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.calc(sty.Calc { px: 1.0, percent: 1.0 }), right: sty.LengthPercentage.calc(sty.Calc { px: 1.0, percent: 1.0 }), top: sty.LengthPercentage.calc(sty.Calc { px: 1.0, percent: 1.0 }), bottom: sty.LengthPercentage.calc(sty.Calc { px: 1.0, percent: 1.0 }) };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.percent(0.1), right: sty.LengthPercentage.percent(0.1), top: sty.LengthPercentage.percent(0.1), bottom: sty.LengthPercentage.percent(0.1) };
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MaxContent, height: sty.AvailableSpace.MaxContent });
    _tree_block.show_nodes(out, &t, "X3");
}

/// Case X4: a size-only run for the height alone
fn case_x4(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(150.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(5.0), bottom: sty.LengthPercentageAuto.length(5.0) };
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    let n2 = t.add(s2, _tree_block.Content.Text { width: 300.0, line: 10.0 });
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    let o_x4 = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: some(150.0), height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Vertical, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "X4", &o_x4);
    let o_x4b = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(120.0), height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Vertical, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "X4b", &o_x4b);
}

/// Case X5: justify-self and auto margins beside a float
fn case_x5(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.float = sty.Float.Left;
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(50.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Hidden, y: sty.Overflow.Hidden };
    s2.justify_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.Center, safety: sty.AlignmentSafety.Default });
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(50.0), height: sty.Dimension.length(10.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Hidden, y: sty.Overflow.Hidden };
    s3.justify_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.End, safety: sty.AlignmentSafety.Default });
    s3.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(5.0), right: sty.LengthPercentageAuto.length(10.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(50.0), height: sty.Dimension.length(10.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Hidden, y: sty.Overflow.Hidden };
    s4.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(50.0), height: sty.Dimension.length(10.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Hidden, y: sty.Overflow.Hidden };
    s5.justify_self = some(sty.AlignItems.safe(sty.AlignItemsKeyword.Center));
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(250.0), height: sty.Dimension.length(10.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    var s6 = _tree_block.blk(a);
    s6.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Hidden, y: sty.Overflow.Hidden };
    s6.justify_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.End, safety: sty.AlignmentSafety.Default });
    s6.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n6 = t.add(s6, _tree_block.Content.Text { width: 60.0, line: 10.0 });
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    t.add_child(parent: n0, child: n5);
    t.add_child(parent: n0, child: n6);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "X5");
}

/// Case X6: a container with align-content beside a float, and its children
fn case_x6(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.float = sty.Float.Right;
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(50.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.align_content = sty.AlignContent { keyword: sty.AlignContentKeyword.Center, safety: sty.AlignmentSafety.Default };
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(30.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.align_content = sty.AlignContent { keyword: sty.AlignContentKeyword.Start, safety: sty.AlignmentSafety.Default };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.float = sty.Float.Left;
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(20.0), height: sty.Dimension.length(20.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    var s6 = _tree_block.blk(a);
    s6.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(5.0) };
    let n6 = t.add(s6, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n2, child: n3);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n4, child: n5);
    t.add_child(parent: n4, child: n6);
    t.add_child(parent: n0, child: n4);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "X6");
}

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    case_x1(&mut sys.stdout, a);
    case_x2(&mut sys.stdout, a);
    case_x3(&mut sys.stdout, a);
    case_x4(&mut sys.stdout, a);
    case_x5(&mut sys.stdout, a);
    case_x6(&mut sys.stdout, a);
}
