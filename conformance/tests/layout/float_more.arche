    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.float = sty.Float.Left;
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(120.0), height: sty.Dimension.length(0.6) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    var s6 = _tree_block.blk(a);
    s6.float = sty.Float.Right;
    s6.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(0.3) };
    let n6 = t.add(s6, _tree_block.Content.Empty);
    var s7 = _tree_block.blk(a);
    s7.float = sty.Float.Left;
    s7.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(140.0), height: sty.Dimension.length(1.1) };
    let n7 = t.add(s7, _tree_block.Content.Empty);
    var s8 = _tree_block.blk(a);
    s8.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Hidden, y: sty.Overflow.Hidden };
    s8.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(90.0), height: sty.Dimension.length(0.4) };
    let n8 = t.add(s8, _tree_block.Content.Empty);
    var s9 = _tree_block.blk(a);
    s9.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Hidden, y: sty.Overflow.Hidden };
    s9.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(180.0), height: sty.Dimension.length(0.4) };
    let n9 = t.add(s9, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    t.add_child(parent: n0, child: n5);
    t.add_child(parent: n0, child: n6);
    t.add_child(parent: n0, child: n7);
    t.add_child(parent: n0, child: n8);
    t.add_child(parent: n0, child: n9);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "Q2");
