/// Case Q3: a box with a formatting context searching the segments
fn case_q3(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.float = sty.Float.Left;
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(200.0), height: sty.Dimension.length(10.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.float = sty.Float.Left;
    s2.clear = sty.Clear.Left;
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(150.0), height: sty.Dimension.length(10.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.float = sty.Float.Left;
    s3.clear = sty.Clear.Left;
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.float = sty.Float.Right;
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(60.0), height: sty.Dimension.length(40.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Hidden, y: sty.Overflow.Hidden };
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(150.0), height: sty.Dimension.length(5.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    var s6 = _tree_block.blk(a);
