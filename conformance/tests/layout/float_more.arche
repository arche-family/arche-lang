// More floats in block layout: widths that add up to exactly 100% (the fit
// tolerance), staircases of fractional heights (segments split and the end
// segment walked back), a box with a formatting context searching segment
// after segment, floats with auto margins, percentage and stretch heights,
// min-content and max-content widths, clearance forced by a float in a
// child's unresolved strut, and a flow-root root. The expected lines are
// taffy 0.15's own, from the same trees in Rust.
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import _tree_block;

/// Case Q1: three floats of a third each, and 100% in fractions
fn case_q1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(301.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.float = sty.Float.Left;
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.percent(0.333333), height: sty.Dimension.length(10.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.float = sty.Float.Left;
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.percent(0.333333), height: sty.Dimension.length(10.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.float = sty.Float.Left;
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.percent(0.333334), height: sty.Dimension.length(10.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.float = sty.Float.Left;
    s4.clear = sty.Clear.Left;
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.percent(0.125), height: sty.Dimension.length(10.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.float = sty.Float.Left;
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.percent(0.875), height: sty.Dimension.length(10.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    var s6 = _tree_block.blk(a);
    s6.float = sty.Float.Right;
    s6.clear = sty.Clear.Both;
    s6.size = geo.Size(sty.Dimension) { width: sty.Dimension.percent(0.701), height: sty.Dimension.length(10.0) };
    let n6 = t.add(s6, _tree_block.Content.Empty);
    var s7 = _tree_block.blk(a);
    s7.float = sty.Float.Right;
    s7.size = geo.Size(sty.Dimension) { width: sty.Dimension.percent(0.299), height: sty.Dimension.length(10.0) };
    let n7 = t.add(s7, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    t.add_child(parent: n0, child: n5);
    t.add_child(parent: n0, child: n6);
    t.add_child(parent: n0, child: n7);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "Q1");
}

