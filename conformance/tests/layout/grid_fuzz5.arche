    _tree_grid.run(&mut sys.stdout, name: "G299", spec: "avail=123.5,77 (grid cols=[b.hd-end],repeat(auto-fill,33%),[y.main-end],50,[y.b] rows=repeat(2,1fr,1fr,minmax(calc(-5+25%),40)),[],repeat(3,50),[hd-end] flow=column-dense gap=40 h=12.5 (grid cols=1fr,repeat(3,minmax(50,10%)),100% rows=[a.x],repeat(auto-fit,30),[main-start],repeat(1,2fr,50,fit-content(30)),auto,[main-start.a],min-content ai=flex-end ac=end w=150.5 ar=1.5 col=-5/4 js=self-start pos=absolute ib=50 (leaf minw=0 col=1/-2 pos=absolute it=0 ib=auto text=120,12.5) (grid cols=repeat(auto-fit,minmax(25%,50%)),fit-content(30),25% rows=minmax(100%,1fr),repeat(1,40),repeat(auto-fill,20,60),2fr acols=minmax(20,30) minw=auto oy=hidden col=main-start:1/a:1 js=safe-self-end pos=absolute il=calc(10+10%) (leaf h=100 maxh=150.5 ox=clip dirn=rtl row=span-1/span-1 as=self-end fixed=5,20) (leaf w=fit-content(40) fixed=25,15) (leaf minw=10% maxw=5 m=5,0,5%,auto p=10 col=auto/1 row=span-1/auto js=self-start text=400,10))) (leaf dirn=rtl row=hd-end:1/-2 as=unsafe-self-end fixed=5,35) (leaf h=calc(-5+25%) p=5% col=span-1/b:0 row=auto/hd-end:2 as=start js=baseline fixed=5,30) (leaf h=20 minw=calc(-5+25%) ar=0.5 p=10 sw=15 row=-1/ft:-1) (leaf p=calc(1+2%) box=content js=center text=40,10) (leaf maxw=150.5 maxh=0 col=auto/main-end:1 text=250,12.5))", a);
    _tree_grid.run(&mut sys.stdout, name: "G300", spec: "avail=max,max (grid cols=[side],minmax(20,2fr),repeat(1,[y],auto,[b],min-content,[y.side]),repeat(auto-fill,[hd-end.hd-start],100%,[main-start]) rows=[a],repeat(auto-fill,[side.x],10,[a]),[],50,[],30,[hd-end],40,[main-start] w=fit-content(40) h=150.5 minh=40 ar=1.5 (leaf js=flex-start display=none fixed=10,10) (leaf col=span-3/span-1 row=main-start:-1/span-2 pos=absolute ir=calc(0+50%) fixed=40,30) (leaf minw=auto minh=calc(-5+25%) maxw=auto p=10 oy=scroll fixed=20,20))", a);
}
