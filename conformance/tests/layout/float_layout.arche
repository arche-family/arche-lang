// stdout: F10.3 at 8.0 8.0 size 224.0 10.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 200.0 0.0 10.0 | sb 0.0 0.0 | order 1
// stdout: F10.4 at 0.0 68.0 size 300.0 5.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 0.0 0.0 0.0 | sb 0.0 0.0 | order 1
// Floats in block layout, taffy's compute/float.rs through
// compute_block_layout: left and right floats side by side and wrapping
// below, floats among in-flow blocks, float margins, floats beside boxes
// that establish a formatting context (and must not overlap them), floats
// in nested blocks raising the root's height, percentages, right to left,
// and shrink-to-fit widths. The expected lines are taffy 0.15's own, from
// the same trees in Rust.
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import _tree_block;

/// Case F1: left and right floats, side by side and wrapping
fn case_f1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.float = sty.Float.Left;
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(50.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.float = sty.Float.Left;
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(150.0), height: sty.Dimension.length(30.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.float = sty.Float.Right;
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(40.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.float = sty.Float.Left;
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(200.0), height: sty.Dimension.length(20.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.float = sty.Float.Right;
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(250.0), height: sty.Dimension.length(10.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    t.add_child(parent: n0, child: n5);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "F1");
}

/// Case F2: floats beside in-flow blocks and text
fn case_f2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(10.0), right: sty.LengthPercentage.length(10.0), top: sty.LengthPercentage.length(10.0), bottom: sty.LengthPercentage.length(10.0) };
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.float = sty.Float.Left;
    s1.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(5.0), right: sty.LengthPercentageAuto.length(5.0), top: sty.LengthPercentageAuto.length(5.0), bottom: sty.LengthPercentageAuto.length(5.0) };
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(50.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    let n2 = t.add(s2, _tree_block.Content.Text { width: 500.0, line: 10.0 });
    var s3 = _tree_block.blk(a);
    s3.float = sty.Float.Right;
    s3.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(10.0), top: sty.LengthPercentageAuto.length(3.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(80.0), height: sty.Dimension.length(30.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(20.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "F2");
}

/// Case F3: boxes with a formatting context of their own avoid floats
fn case_f3(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.float = sty.Float.Left;
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(50.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Hidden, y: sty.Overflow.Hidden };
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(20.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.display = sty.Display.FlowRoot;
    s3.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(10.0), right: sty.LengthPercentageAuto.length(10.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(20.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.display = sty.Display.FlowRoot;
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(350.0), height: sty.Dimension.length(20.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.display = sty.Display.FlowRoot;
    s5.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(-30.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(20.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    t.add_child(parent: n0, child: n5);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "F3");
}

/// Case F4: floats in nested blocks raise the root
fn case_f4(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
