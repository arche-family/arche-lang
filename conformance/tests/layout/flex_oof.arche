// Out-of-flow children: the candidates compute_flexbox_layout gives its
// containing block, with static positions by justify-content and
// align-self in rows, columns, reverses, wrap-reverse and rtl, safe
// alignment, display: none and candidates bubbled up from in-flow items,
// in document order; and the positioning area with borders and
// scrollbar gutters.
// The expected lines are taffy 0.15's own, from the same cases in Rust
// (/tmp/layout-port/oracle-flex).
import std;
import _tree_flex;

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    _tree_flex.run(&mut sys.stdout, name: "O1", spec: "mode=direct (flex w=300 h=100 p=10 (leaf w=50) (leaf pos=absolute w=20 h=20) (leaf w=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "O2", spec: "mode=direct (flex w=300 h=100 jc=center ai=center (leaf pos=absolute) (leaf pos=fixed as=end) (leaf pos=absolute as=safe-center))", a);
    _tree_flex.run(&mut sys.stdout, name: "O3", spec: "mode=direct (flex w=300 h=100 dir=row-reverse jc=flex-start ai=flex-end (leaf pos=absolute) (leaf pos=absolute as=start) (leaf pos=absolute as=baseline))", a);
    _tree_flex.run(&mut sys.stdout, name: "O4", spec: "mode=direct (flex w=300 h=100 dir=column jc=flex-end ai=stretch (leaf pos=absolute) (leaf pos=absolute as=flex-start) (leaf pos=absolute as=self-end dirn=rtl))", a);
    _tree_flex.run(&mut sys.stdout, name: "O5", spec: "mode=direct (flex w=300 h=100 wrap=wrap-reverse jc=space-between (leaf pos=absolute) (leaf pos=absolute as=flex-end) (leaf pos=absolute as=end))", a);
    _tree_flex.run(&mut sys.stdout, name: "O6", spec: "mode=direct (flex w=300 h=100 dirn=rtl jc=start (leaf pos=absolute) (leaf pos=absolute as=start) (leaf pos=absolute as=flex-start))", a);
    _tree_flex.run(&mut sys.stdout, name: "O7", spec: "mode=direct (flex w=300 h=100 dir=column dirn=rtl jc=end wrap=wrap (leaf pos=absolute) (leaf pos=absolute as=start) (leaf pos=absolute as=flex-start) (leaf pos=absolute as=baseline))", a);
    _tree_flex.run(&mut sys.stdout, name: "O8", spec: "mode=direct (flex w=300 h=100 jc=space-around (leaf pos=absolute) (leaf pos=absolute display=none) (leaf w=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "O9", spec: "mode=direct (flex w=300 h=100 jc=space-evenly dir=column-reverse (leaf pos=absolute) (leaf pos=absolute as=center))", a);
    _tree_flex.run(&mut sys.stdout, name: "O10", spec: "mode=direct (flex w=300 h=100 b=3 p=7 oy=scroll ox=scroll sw=12 (leaf pos=absolute) (leaf w=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "O11", spec: "mode=direct (flex w=300 h=100 b=3 dirn=rtl oy=scroll sw=12 (leaf pos=absolute) (leaf w=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "O12", spec: "mode=direct (flex w=300 h=100 p=5 (flex w=100 m=10 p=4 (leaf w=10) (leaf pos=absolute) (flex w=40 (leaf pos=fixed))) (leaf pos=absolute) (flex w=50 m=3 (leaf pos=absolute)))", a);
    _tree_flex.run(&mut sys.stdout, name: "O13", spec: "mode=direct (flex w=300 h=100 dir=column ai=center (flex h=50 (leaf pos=absolute) (leaf h=10 w=10)) (leaf pos=absolute as=safe-end) (leaf pos=absolute as=unsafe-end))", a);
    _tree_flex.run(&mut sys.stdout, name: "O14", spec: "mode=direct (flex w=300 h=100 jc=stretch ai=normal (leaf pos=absolute) (leaf w=20))", a);
    _tree_flex.run(&mut sys.stdout, name: "O15", spec: "mode=direct (flex w=300 h=100 jc=flex-end dir=row-reverse dirn=rtl (leaf pos=absolute) (leaf pos=absolute as=end) (leaf pos=absolute as=flex-end))", a);
}
