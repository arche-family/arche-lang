// Multi-line flex containers: wrap and wrap-reverse in rows and columns,
// flex-wrap: balance with flex-line-count, align-content in every mode,
// gaps between lines, wrapping against max sizes, and min- and
// max-content sizing of wrapping containers.
// The expected lines are taffy 0.15's own, from the same cases in Rust
// (/tmp/layout-port/oracle-flex).
import std;
import _tree_flex;

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    _tree_flex.run(&mut sys.stdout, name: "W1", spec: "(flex w=200 h=300 wrap=wrap (leaf w=80 h=30) (leaf w=80 h=40) (leaf w=80 h=50) (leaf w=80 h=20))", a);
    _tree_flex.run(&mut sys.stdout, name: "W2", spec: "(flex w=200 h=300 wrap=wrap-reverse (leaf w=80 h=30) (leaf w=80 h=40) (leaf w=80 h=50) (leaf w=80 h=20))", a);
    _tree_flex.run(&mut sys.stdout, name: "W3", spec: "(flex dir=column w=300 h=200 wrap=wrap (leaf w=30 h=80) (leaf w=40 h=80) (leaf w=50 h=80) (leaf w=20 h=80))", a);
    _tree_flex.run(&mut sys.stdout, name: "W4", spec: "(flex dir=column-reverse w=300 h=200 wrap=wrap-reverse (leaf w=30 h=80) (leaf w=40 h=80) (leaf w=50 h=80))", a);
    _tree_flex.run(&mut sys.stdout, name: "W5", spec: "(flex w=200 h=300 wrap=wrap gap=10,20 (leaf w=60 h=30) (leaf w=60 h=40) (leaf w=60 h=50) (leaf w=60 h=20) (leaf w=60 h=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "W6", spec: "(flex w=200 h=300 wrap=wrap ac=flex-start (leaf w=80 h=30) (leaf w=80 h=40) (leaf w=80 h=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "W7", spec: "(flex w=200 h=300 wrap=wrap ac=flex-end (leaf w=80 h=30) (leaf w=80 h=40) (leaf w=80 h=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "W8", spec: "(flex w=200 h=300 wrap=wrap ac=center (leaf w=80 h=30) (leaf w=80 h=40) (leaf w=80 h=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "W9", spec: "(flex w=200 h=300 wrap=wrap ac=space-between (leaf w=80 h=30) (leaf w=80 h=40) (leaf w=80 h=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "W10", spec: "(flex w=200 h=300 wrap=wrap ac=space-around (leaf w=80 h=30) (leaf w=80 h=40) (leaf w=80 h=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "W11", spec: "(flex w=200 h=300 wrap=wrap ac=space-evenly (leaf w=80 h=30) (leaf w=80 h=40) (leaf w=80 h=50))", a);
