/// Case C12: a height of 0, max-height 0, and min-height in percent of an auto parent
fn case_c12(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.length(10.0) };
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(0.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(20.0), bottom: sty.LengthPercentageAuto.length(4.0) };
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(1.0) };
    s2.max_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.auto(), height: sty.LengthPercentageAuto.length(0.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(7.0), bottom: sty.LengthPercentageAuto.length(7.0) };
    s3.min_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.auto(), height: sty.LengthPercentageAuto.percent(0.1) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "C12");
}

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    case_c1(&mut sys.stdout, a);
    case_c2(&mut sys.stdout, a);
    case_c3(&mut sys.stdout, a);
    case_c4(&mut sys.stdout, a);
    case_c5(&mut sys.stdout, a);
    case_c6(&mut sys.stdout, a);
    case_c7(&mut sys.stdout, a);
    case_c8(&mut sys.stdout, a);
    case_c9(&mut sys.stdout, a);
    case_c10(&mut sys.stdout, a);
    case_c11(&mut sys.stdout, a);
    case_c12(&mut sys.stdout, a);
}
