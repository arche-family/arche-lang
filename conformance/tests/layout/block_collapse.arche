    t.add_child(parent: n1, child: n2);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n3);
    let o_c11 = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: some(300.0), height: none }, parent: geo.Size(?f32) { width: some(800.0), height: some(600.0) }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) }, lt.RequestedAxis.Both, geo.Line(bool) { start: true, end: true }));
    _tree_block.show_output(out, "C11", &o_c11);
    let o_c11b = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.PerformLayout, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: some(300.0), height: none }, parent: geo.Size(?f32) { width: some(800.0), height: some(600.0) }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) }, lt.RequestedAxis.Both, geo.Line(bool) { start: true, end: true }));
    _tree_block.show_output(out, "C11b", &o_c11b);
