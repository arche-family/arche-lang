// Block layout's margin collapsing, taffy's compute_block_layout over the
// block test tree: adjoining sibling margins, positive and negative; a
// parent's top and bottom margins with its first and last child's; boxes
// margins collapse through; border, padding, a set height, min-height and a
// new formatting context stopping it. The expected lines are taffy 0.15's
// own, from the same trees in Rust (/tmp/layout-port/oracle-block).
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import layout.tree as lt;
import _tree_block;

/// Case C1: sibling margins, the larger wins
fn case_c1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(20.0), bottom: sty.LengthPercentageAuto.length(30.0) };
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(50.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.length(25.0) };
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(40.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(30.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "C1");
}

/// Case C2: negative and mixed sibling margins
fn case_c2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(5.0), right: sty.LengthPercentage.length(5.0), top: sty.LengthPercentage.length(5.0), bottom: sty.LengthPercentage.length(5.0) };
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.length(-20.0) };
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(50.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(15.0), bottom: sty.LengthPercentageAuto.length(-5.0) };
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(40.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(-30.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(30.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(-10.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(20.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "C2");
