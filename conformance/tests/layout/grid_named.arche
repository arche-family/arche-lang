/// N4
fn case_n4(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_grid.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(50.0), max: sgrid.MaxTrackSizingFunction.length(50.0) } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(100.0), max: sgrid.MaxTrackSizingFunction.length(100.0) } });
    s0.grid_template_rows.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) } });
    s0.grid_template_rows.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(60.0), max: sgrid.MaxTrackSizingFunction.length(60.0) } });
    s0.grid_template_rows.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) } });
    var ar1 = alloc.List(sgrid.GridTemplateArea).init(a);
    ar1.push(sgrid.GridTemplateArea { name: t.names.intern("hd"), row_start: 1, row_end: 2, column_start: 1, column_end: 3 });
    ar1.push(sgrid.GridTemplateArea { name: t.names.intern("side"), row_start: 2, row_end: 3, column_start: 1, column_end: 2 });
    ar1.push(sgrid.GridTemplateArea { name: t.names.intern("main"), row_start: 2, row_end: 3, column_start: 2, column_end: 3 });
    ar1.push(sgrid.GridTemplateArea { name: t.names.intern("ft"), row_start: 3, row_end: 4, column_start: 1, column_end: 3 });
    s0.grid_template_areas = some(sgrid.GridTemplateAreas { areas: ar1, row_count: 3, column_count: 2 });
    s0.display = sty.Display.Grid;
    let n0 = t.add(s0, _tree_grid.Content.Empty);
    var s1 = sty.Style.default(a);
