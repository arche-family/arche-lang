import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import layout.style.grid as sgrid;
import layout.tree as lt;
import _show;
import _tree_grid;

/// N1
fn case_n1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_grid.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(30.0), max: sgrid.MaxTrackSizingFunction.length(30.0) } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(40.0), max: sgrid.MaxTrackSizingFunction.length(40.0) } });
    var ln1 = alloc.List(alloc.List(alloc.Symbol)).init(a);
    var g2 = alloc.List(alloc.Symbol).init(a);
    g2.push(t.names.intern("a"));
    ln1.push(g2);
    var g3 = alloc.List(alloc.Symbol).init(a);
    g3.push(t.names.intern("b"));
    ln1.push(g3);
    var g4 = alloc.List(alloc.Symbol).init(a);
    g4.push(t.names.intern("c"));
    ln1.push(g4);
    var g5 = alloc.List(alloc.Symbol).init(a);
    g5.push(t.names.intern("d"));
    ln1.push(g5);
    s0.grid_template_column_names = ln1;
    s0.display = sty.Display.Grid;
    let n0 = t.add(s0, _tree_grid.Content.Empty);
    var s1 = sty.Style.default(a);
    s1.grid_column = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.NamedLine { name: t.names.intern("a"), index: 0 }, end: sgrid.GridPlacement.NamedLine { name: t.names.intern("c"), index: 0 } };
    let n1 = t.add(s1, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    s2.grid_column = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.NamedLine { name: t.names.intern("b"), index: 0 }, end: sgrid.GridPlacement.Auto };
    let n2 = t.add(s2, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n2);
    var s3 = sty.Style.default(a);
    s3.grid_column = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.NamedLine { name: t.names.intern("b"), index: 0 }, end: sgrid.GridPlacement.from_span(1) };
    let n3 = t.add(s3, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n3);
    let avail = geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) };
    compute.compute_root_layout(&mut t, n0, avail);
    _show.layout_line(out, "N1.0", t.unrounded_of(n0));
    _show.layout_line(out, "N1.1", t.unrounded_of(n1));
    _show.layout_line(out, "N1.2", t.unrounded_of(n2));
    _show.layout_line(out, "N1.3", t.unrounded_of(n3));
    _tree_grid.counts_line(out, "N1", &t);
}

/// N2
fn case_n2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_grid.TestTree.init(a);
    var s0 = sty.Style.default(a);
    var rt1 = alloc.List(sgrid.TrackSizingFunction).init(a);
    rt1.push(sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) });
    var rn2 = alloc.List(alloc.List(alloc.Symbol)).init(a);
    var g3 = alloc.List(alloc.Symbol).init(a);
    g3.push(t.names.intern("x"));
    rn2.push(g3);
    var g4 = alloc.List(alloc.Symbol).init(a);
    rn2.push(g4);
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Repeat { repetition: sgrid.GridTemplateRepetition { count: sgrid.RepetitionCount.Count { count: 3 }, tracks: rt1, line_names: rn2 } });
    var ln5 = alloc.List(alloc.List(alloc.Symbol)).init(a);
    var g6 = alloc.List(alloc.Symbol).init(a);
    ln5.push(g6);
    var g7 = alloc.List(alloc.Symbol).init(a);
    ln5.push(g7);
    s0.grid_template_column_names = ln5;
    s0.display = sty.Display.Grid;
    let n0 = t.add(s0, _tree_grid.Content.Empty);
    var s1 = sty.Style.default(a);
    s1.grid_column = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.NamedLine { name: t.names.intern("x"), index: 2 }, end: sgrid.GridPlacement.NamedLine { name: t.names.intern("x"), index: 3 } };
    let n1 = t.add(s1, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    s2.grid_column = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.NamedLine { name: t.names.intern("x"), index: -1 }, end: sgrid.GridPlacement.Auto };
    let n2 = t.add(s2, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n2);
    var s3 = sty.Style.default(a);
    s3.grid_column = geo.Line(sgrid.GridPlacement) { start: sgrid.GridPlacement.NamedLine { name: t.names.intern("x"), index: 5 }, end: sgrid.GridPlacement.Auto };
    let n3 = t.add(s3, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n3);
    let avail = geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) };
    compute.compute_root_layout(&mut t, n0, avail);
    _show.layout_line(out, "N2.0", t.unrounded_of(n0));
    _show.layout_line(out, "N2.1", t.unrounded_of(n1));
    _show.layout_line(out, "N2.2", t.unrounded_of(n2));
    _show.layout_line(out, "N2.3", t.unrounded_of(n3));
    _tree_grid.counts_line(out, "N2", &t);
}

