    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(20.0), max: sgrid.MaxTrackSizingFunction.length(20.0) } });
