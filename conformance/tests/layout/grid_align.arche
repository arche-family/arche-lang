import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import layout.style.grid as sgrid;
import layout.tree as lt;
import _show;
import _tree_grid;

/// A1
fn case_a1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_grid.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(60.0), max: sgrid.MaxTrackSizingFunction.length(60.0) } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(60.0), max: sgrid.MaxTrackSizingFunction.length(60.0) } });
    s0.grid_template_rows.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(30.0), max: sgrid.MaxTrackSizingFunction.length(30.0) } });
    s0.grid_template_rows.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.length(30.0), max: sgrid.MaxTrackSizingFunction.length(30.0) } });
    s0.justify_items = sty.AlignItems { keyword: sty.AlignItemsKeyword.Start, safety: sty.AlignmentSafety.Default };
    s0.align_items = sty.AlignItems { keyword: sty.AlignItemsKeyword.Center, safety: sty.AlignmentSafety.Default };
    s0.display = sty.Display.Grid;
    let n0 = t.add(s0, _tree_grid.Content.Empty);
    var s1 = sty.Style.default(a);
    let n1 = t.add(s1, _tree_grid.Content.Fixed { width: 20.0, height: 10.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    s2.justify_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.End, safety: sty.AlignmentSafety.Default });
    let n2 = t.add(s2, _tree_grid.Content.Fixed { width: 20.0, height: 10.0 });
    t.add_child(parent: n0, child: n2);
    var s3 = sty.Style.default(a);
    s3.justify_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.Center, safety: sty.AlignmentSafety.Default });
    s3.align_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.End, safety: sty.AlignmentSafety.Default });
    let n3 = t.add(s3, _tree_grid.Content.Fixed { width: 20.0, height: 10.0 });
    t.add_child(parent: n0, child: n3);
    var s4 = sty.Style.default(a);
    s4.align_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.Stretch, safety: sty.AlignmentSafety.Default });
    let n4 = t.add(s4, _tree_grid.Content.Fixed { width: 20.0, height: 10.0 });
    t.add_child(parent: n0, child: n4);
    let avail = geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) };
    compute.compute_root_layout(&mut t, n0, avail);
    _show.layout_line(out, "A1.0", t.unrounded_of(n0));
    _show.layout_line(out, "A1.1", t.unrounded_of(n1));
    _show.layout_line(out, "A1.2", t.unrounded_of(n2));
    _show.layout_line(out, "A1.3", t.unrounded_of(n3));
    _show.layout_line(out, "A1.4", t.unrounded_of(n4));
    _tree_grid.counts_line(out, "A1", &t);
}

