    s3.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(10.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.auto() };
    let n3 = t.add(s3, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n2, child: n3);
    var s4 = sty.Style.default(a);
    s4.position = sty.Position.Absolute;
    s4.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.percent(0.1), top: sty.LengthPercentageAuto.auto(), bottom: sty.LengthPercentageAuto.percent(0.1) };
    let n4 = t.add(s4, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n2, child: n4);
    var s5 = sty.Style.default(a);
    s5.position = sty.Position.Fixed;
    s5.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(10.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.auto() };
    let n5 = t.add(s5, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n2, child: n5);
    var s6 = sty.Style.default(a);
    s6.position = sty.Position.Fixed;
    let n6 = t.add(s6, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n2, child: n6);
    let s7 = sty.Style.default(a);
    let n7 = t.add(s7, _tree_oof.Content.Stack);
    t.add_child(parent: n2, child: n7);
    var s8 = sty.Style.default(a);
    s8.position = sty.Position.Absolute;
    s8.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    let n8 = t.add(s8, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n7, child: n8);
    let s9 = sty.Style.default(a);
    let n9 = t.add(s9, _tree_oof.Content.Fixed { width: 30.0, height: 5.0 });
    t.add_child(parent: n7, child: n9);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _show.layout_line(out, "N2.0", t.unrounded_of(n0));
    _show.layout_line(out, "N2.1", t.unrounded_of(n1));
    _show.layout_line(out, "N2.2", t.unrounded_of(n2));
    _show.layout_line(out, "N2.3", t.unrounded_of(n3));
    _show.layout_line(out, "N2.4", t.unrounded_of(n4));
    _show.layout_line(out, "N2.5", t.unrounded_of(n5));
    _show.layout_line(out, "N2.6", t.unrounded_of(n6));
    _show.layout_line(out, "N2.7", t.unrounded_of(n7));
    _show.layout_line(out, "N2.8", t.unrounded_of(n8));
    _show.layout_line(out, "N2.9", t.unrounded_of(n9));
