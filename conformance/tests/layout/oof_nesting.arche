// Hoisting through the tree: absolute boxes bubble past static containers
// to the nearest positioned one and are recorded as its hoisted children;
// fixed boxes bubble to the root's last pass, the initial containing block;
// an absolute box is itself the containing block of its absolute
// descendants; a fixed box inside an absolute one is surfaced by its layout
// and swept again; rounding visits each box from its containing block.
// The expected lines are taffy 0.15's own, from the same trees in Rust
// (/tmp/layout-port/oracle-oof).
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import _show;
import _tree_oof;

/// absolute boxes inside static containers reach the relative root.
fn case_n1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_oof.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.position = sty.Position.Relative;
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.length(300.0) };
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(10.0), right: sty.LengthPercentage.length(10.0), top: sty.LengthPercentage.length(10.0), bottom: sty.LengthPercentage.length(10.0) };
    s0.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(5.0), right: sty.LengthPercentage.length(5.0), top: sty.LengthPercentage.length(5.0), bottom: sty.LengthPercentage.length(5.0) };
    let n0 = t.add(s0, _tree_oof.Content.Stack);
    let s1 = sty.Style.default(a);
    let n1 = t.add(s1, _tree_oof.Content.Fixed { width: 100.0, height: 30.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    s2.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(6.0), right: sty.LengthPercentage.length(6.0), top: sty.LengthPercentage.length(6.0), bottom: sty.LengthPercentage.length(6.0) };
    s2.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(2.0), right: sty.LengthPercentage.length(2.0), top: sty.LengthPercentage.length(2.0), bottom: sty.LengthPercentage.length(2.0) };
    let n2 = t.add(s2, _tree_oof.Content.Stack);
    t.add_child(parent: n0, child: n2);
    let s3 = sty.Style.default(a);
    let n3 = t.add(s3, _tree_oof.Content.Fixed { width: 50.0, height: 12.0 });
    t.add_child(parent: n2, child: n3);
    var s4 = sty.Style.default(a);
    s4.position = sty.Position.Absolute;
    s4.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(10.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.auto() };
    let n4 = t.add(s4, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n2, child: n4);
    var s5 = sty.Style.default(a);
    s5.position = sty.Position.Absolute;
    let n5 = t.add(s5, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n2, child: n5);
    var s6 = sty.Style.default(a);
    s6.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(4.0), right: sty.LengthPercentage.length(4.0), top: sty.LengthPercentage.length(4.0), bottom: sty.LengthPercentage.length(4.0) };
    let n6 = t.add(s6, _tree_oof.Content.Stack);
    t.add_child(parent: n2, child: n6);
    var s7 = sty.Style.default(a);
    s7.position = sty.Position.Absolute;
    s7.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.auto(), bottom: sty.LengthPercentageAuto.length(0.0) };
    let n7 = t.add(s7, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n6, child: n7);
    let s8 = sty.Style.default(a);
    let n8 = t.add(s8, _tree_oof.Content.Fixed { width: 20.0, height: 20.0 });
    t.add_child(parent: n6, child: n8);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _show.layout_line(out, "N1.0", t.unrounded_of(n0));
    _show.layout_line(out, "N1.1", t.unrounded_of(n1));
    _show.layout_line(out, "N1.2", t.unrounded_of(n2));
    _show.layout_line(out, "N1.3", t.unrounded_of(n3));
    _show.layout_line(out, "N1.4", t.unrounded_of(n4));
    _show.layout_line(out, "N1.5", t.unrounded_of(n5));
    _show.layout_line(out, "N1.6", t.unrounded_of(n6));
    _show.layout_line(out, "N1.7", t.unrounded_of(n7));
    _show.layout_line(out, "N1.8", t.unrounded_of(n8));
    t.hoisted_line(out, "N1.0", n0);
    t.hoisted_line(out, "N1.2", n2);
    t.hoisted_line(out, "N1.6", n6);
    compute.round_layout(&mut t, n0);
    _show.layout_line(out, "N1.0r", t.final_of(n0));
    _show.layout_line(out, "N1.1r", t.final_of(n1));
    _show.layout_line(out, "N1.2r", t.final_of(n2));
    _show.layout_line(out, "N1.3r", t.final_of(n3));
    _show.layout_line(out, "N1.4r", t.final_of(n4));
    _show.layout_line(out, "N1.5r", t.final_of(n5));
    _show.layout_line(out, "N1.6r", t.final_of(n6));
    _show.layout_line(out, "N1.7r", t.final_of(n7));
    _show.layout_line(out, "N1.8r", t.final_of(n8));
}

/// a relative in-flow container claims its absolute descendants; fixed ones go on.
fn case_n2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_oof.TestTree.init(a);
