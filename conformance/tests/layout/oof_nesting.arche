    t.hoisted_line(out, "N2.2", n2);
    t.hoisted_line(out, "N2.7", n7);
    compute.round_layout(&mut t, n0);
    _show.layout_line(out, "N2.0r", t.final_of(n0));
    _show.layout_line(out, "N2.1r", t.final_of(n1));
    _show.layout_line(out, "N2.2r", t.final_of(n2));
    _show.layout_line(out, "N2.3r", t.final_of(n3));
    _show.layout_line(out, "N2.4r", t.final_of(n4));
    _show.layout_line(out, "N2.5r", t.final_of(n5));
    _show.layout_line(out, "N2.6r", t.final_of(n6));
    _show.layout_line(out, "N2.7r", t.final_of(n7));
    _show.layout_line(out, "N2.8r", t.final_of(n8));
    _show.layout_line(out, "N2.9r", t.final_of(n9));
}

/// absolute boxes inside absolute boxes, and a fixed box inside them.
fn case_n3(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_oof.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.position = sty.Position.Relative;
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.length(300.0) };
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(10.0), right: sty.LengthPercentage.length(10.0), top: sty.LengthPercentage.length(10.0), bottom: sty.LengthPercentage.length(10.0) };
    s0.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(5.0), right: sty.LengthPercentage.length(5.0), top: sty.LengthPercentage.length(5.0), bottom: sty.LengthPercentage.length(5.0) };
