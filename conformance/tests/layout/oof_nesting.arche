    s3.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.length(5.0), top: sty.LengthPercentageAuto.auto(), bottom: sty.LengthPercentageAuto.length(5.0) };
    let n3 = t.add(s3, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
