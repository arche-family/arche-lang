    s1.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(5.0), right: sty.LengthPercentage.length(5.0), top: sty.LengthPercentage.length(5.0), bottom: sty.LengthPercentage.length(5.0) };
    s1.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(1.0), right: sty.LengthPercentage.length(1.0), top: sty.LengthPercentage.length(1.0), bottom: sty.LengthPercentage.length(1.0) };
    let n1 = t.add(s1, _tree_oof.Content.Stack);
    t.add_child(parent: n0, child: n1);
    let s2 = sty.Style.default(a);
    let n2 = t.add(s2, _tree_oof.Content.Fixed { width: 60.0, height: 20.0 });
    t.add_child(parent: n1, child: n2);
    var s3 = sty.Style.default(a);
