    let n4 = t.add(s4, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n1, child: n4);
    var s5 = sty.Style.default(a);
    s5.position = sty.Position.Absolute;
    s5.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(100.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.auto() };
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(80.0), height: sty.Dimension.length(80.0) };
    s5.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(3.0), right: sty.LengthPercentage.length(3.0), top: sty.LengthPercentage.length(3.0), bottom: sty.LengthPercentage.length(3.0) };
    let n5 = t.add(s5, _tree_oof.Content.Stack);
    t.add_child(parent: n1, child: n5);
    var s6 = sty.Style.default(a);
    s6.position = sty.Position.Absolute;
