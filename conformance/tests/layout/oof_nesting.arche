    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(200.0), height: sty.Dimension.length(100.0) };
    let n2 = t.add(s2, _tree_oof.Content.Stack);
    t.add_child(parent: n0, child: n2);
    var s3 = sty.Style.default(a);
