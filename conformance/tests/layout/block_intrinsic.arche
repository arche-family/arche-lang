// test: run
// spec: layout
// stage0: skip
// stdout: I1 out 124.0 50.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I1b out 214.0 40.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I1c out 150.0 50.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I1d out 150.0 50.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I2 out 100.0 85.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I2b out 320.0 55.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I2c out 320.0 55.0 | over 0.0 320.0 0.0 55.0 | margins 0.0 0.0 | through false | base none | area 320.0 55.0 0.0 0.0 | cands 0
// stdout: I2c.0 at 0.0 0.0 size 0.0 0.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 0.0 0.0 0.0 | sb 0.0 0.0 | order 0
// stdout: I2c.1 at 0.0 0.0 size 320.0 15.0 | pad 10.0 10.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 310.0 0.0 15.0 | sb 0.0 0.0 | order 0
// stdout: I2c.2 at 10.0 0.0 size 300.0 10.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 300.0 0.0 10.0 | sb 0.0 0.0 | order 0
// stdout: I2c.3 at 10.0 10.0 size 80.0 5.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 0.0 0.0 0.0 | sb 0.0 0.0 | order 1
// stdout: I2c.4 at 0.0 15.0 size 90.0 5.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 0.0 0.0 0.0 | sb 0.0 0.0 | order 1
// stdout: I2c.5 at 0.0 20.0 size 320.0 5.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 0.0 0.0 0.0 | sb 0.0 0.0 | order 2
// stdout: I2c.6 at 0.0 25.0 size 40.0 30.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 40.0 0.0 30.0 | sb 0.0 0.0 | order 3
// stdout: I3 out 100.0 40.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I3b out 240.0 20.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I3c out 200.0 30.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I3d out 100.0 40.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I4 out 120.0 50.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I4b out 120.0 50.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I4c out 70.0 50.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I4d out 120.0 30.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// stdout: I5.0 at 0.0 0.0 size 300.0 20.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 300.0 0.0 20.0 | sb 0.0 0.0 | order 0
// stdout: I5.1 at 0.0 0.0 size 140.0 20.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 140.0 0.0 20.0 | sb 0.0 0.0 | order 0
// stdout: I5.2 at 0.0 0.0 size 140.0 10.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 140.0 0.0 10.0 | sb 0.0 0.0 | order 0
// stdout: I5.3 at 0.0 10.0 size 30.0 10.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 30.0 0.0 10.0 | sb 0.0 0.0 | order 1
// stdout: I5.4 at 0.0 0.0 size 300.0 20.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 300.0 0.0 20.0 | sb 0.0 0.0 | order 1
// stdout: I6.0 at 0.0 0.0 size 260.0 30.0 | pad 5.0 5.0 5.0 5.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 255.0 0.0 25.0 | sb 0.0 0.0 | order 0
// stdout: I6.1 at 5.0 5.0 size 250.0 10.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 250.0 0.0 10.0 | sb 0.0 0.0 | order 0
// stdout: I6.2 at 5.0 15.0 size 40.0 10.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 0.0 0.0 0.0 | sb 0.0 0.0 | order 1
// Block layout's intrinsic sizes: min-content and max-content widths of
// block containers over text and fixed leaves, margins and padding, nested
// containers, floats (side by side, cleared, under a definite space), the
// short cuts of a size-only run, and a container sized by its content in
// the root. The expected lines are taffy 0.15's own, from the same trees in
// Rust.
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import layout.tree as lt;
import _tree_block;

/// Case I1: min-content and max-content of text and fixed leaves
fn case_i1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(2.0), right: sty.LengthPercentage.length(2.0), top: sty.LengthPercentage.length(2.0), bottom: sty.LengthPercentage.length(2.0) };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(5.0), right: sty.LengthPercentageAuto.length(5.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    let n1 = t.add(s1, _tree_block.Content.Text { width: 200.0, line: 10.0 });
    var s2 = _tree_block.blk(a);
    let n2 = t.add(s2, _tree_block.Content.Fixed { width: 120.0, height: 10.0 });
    var s3 = _tree_block.blk(a);
    s3.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(3.0), right: sty.LengthPercentage.length(3.0), top: sty.LengthPercentage.length(3.0), bottom: sty.LengthPercentage.length(3.0) };
    let n3 = t.add(s3, _tree_block.Content.Text { width: 60.0, line: 10.0 });
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    let o_i1 = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MinContent, height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I1", &o_i1);
    let o_i1b = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MaxContent, height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I1b", &o_i1b);
    let o_i1c = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(150.0), height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I1c", &o_i1c);
    let o_i1d = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(150.0), height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Horizontal, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I1d", &o_i1d);
}

/// Case I2: nested containers and sized children
fn case_i2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(10.0), right: sty.LengthPercentage.length(10.0), top: sty.LengthPercentage.length(0.0), bottom: sty.LengthPercentage.length(0.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    let n2 = t.add(s2, _tree_block.Content.Text { width: 300.0, line: 10.0 });
    var s3 = _tree_block.blk(a);
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(80.0), height: sty.Dimension.length(5.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(50.0), height: sty.Dimension.length(5.0) };
    s4.min_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.length(90.0), height: sty.LengthPercentageAuto.auto() };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.percent(0.5), height: sty.Dimension.length(5.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    var s6 = _tree_block.blk(a);
    s6.max_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.length(40.0), height: sty.LengthPercentageAuto.auto() };
    let n6 = t.add(s6, _tree_block.Content.Text { width: 100.0, line: 10.0 });
    t.add_child(parent: n1, child: n2);
    t.add_child(parent: n1, child: n3);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n4);
    t.add_child(parent: n0, child: n5);
    t.add_child(parent: n0, child: n6);
    let o_i2 = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MinContent, height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I2", &o_i2);
    let o_i2b = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MaxContent, height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I2b", &o_i2b);
    let o_i2c = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.PerformLayout, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MaxContent, height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I2c", &o_i2c);
    _tree_block.show_nodes(out, &t, "I2c");
}

/// Case I3: floats in the intrinsic width
fn case_i3(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.float = sty.Float.Left;
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.float = sty.Float.Left;
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(80.0), height: sty.Dimension.length(10.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.float = sty.Float.Right;
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(60.0), height: sty.Dimension.length(10.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.float = sty.Float.Left;
    s4.clear = sty.Clear.Left;
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(50.0), height: sty.Dimension.length(10.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    let n5 = t.add(s5, _tree_block.Content.Text { width: 90.0, line: 10.0 });
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    t.add_child(parent: n0, child: n5);
    let o_i3 = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MinContent, height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I3", &o_i3);
    let o_i3b = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MaxContent, height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I3b", &o_i3b);
    let o_i3c = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(200.0), height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I3c", &o_i3c);
    let o_i3d = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(50.0), height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I3d", &o_i3d);
}

/// Case I4: size-only short cuts
fn case_i4(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(50.0) };
    s0.min_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.length(120.0), height: sty.LengthPercentageAuto.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    let o_i4 = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MaxContent, height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I4", &o_i4);
    let o_i4b = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MaxContent, height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Horizontal, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I4b", &o_i4b);
    let o_i4c = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: some(70.0), height: none }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MaxContent, height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Horizontal, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I4c", &o_i4c);
    let o_i4d = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: none, height: some(30.0) }, parent: geo.Size(?f32) { width: none, height: none }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MaxContent, height: sty.AvailableSpace.MaxContent }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "I4d", &o_i4d);
}

/// Case I5: a float and a sizing keyword measured in the container width
fn case_i5(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.float = sty.Float.Left;
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.max_content(), height: sty.Dimension.auto() };
    let n2 = t.add(s2, _tree_block.Content.Text { width: 140.0, line: 10.0 });
    var s3 = _tree_block.blk(a);
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.fit_content(), height: sty.Dimension.auto() };
    let n3 = t.add(s3, _tree_block.Content.Text { width: 30.0, line: 10.0 });
    var s4 = _tree_block.blk(a);
    let n4 = t.add(s4, _tree_block.Content.Text { width: 500.0, line: 10.0 });
    t.add_child(parent: n1, child: n2);
    t.add_child(parent: n1, child: n3);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n4);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "I5");
}

/// Case I6: a root sized by its content under an indefinite viewport
fn case_i6(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(5.0), right: sty.LengthPercentage.length(5.0), top: sty.LengthPercentage.length(5.0), bottom: sty.LengthPercentage.length(5.0) };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    let n1 = t.add(s1, _tree_block.Content.Text { width: 250.0, line: 10.0 });
    var s2 = _tree_block.blk(a);
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(40.0), height: sty.Dimension.length(10.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.MaxContent, height: sty.AvailableSpace.MaxContent });
    _tree_block.show_nodes(out, &t, "I6");
}

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    case_i1(&mut sys.stdout, a);
    case_i2(&mut sys.stdout, a);
    case_i3(&mut sys.stdout, a);
    case_i4(&mut sys.stdout, a);
    case_i5(&mut sys.stdout, a);
    case_i6(&mut sys.stdout, a);
}
