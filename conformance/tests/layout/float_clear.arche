/// Case K8: clearance in a nested block below floats of the root
fn case_k8(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.float = sty.Float.Left;
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(60.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s2.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(0.0), right: sty.LengthPercentage.length(0.0), top: sty.LengthPercentage.length(2.0), bottom: sty.LengthPercentage.length(0.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.clear = sty.Clear.Both;
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.clear = sty.Clear.Both;
    s5.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(5.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n2, child: n3);
    t.add_child(parent: n2, child: n4);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n5);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "K8");
}

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    case_k1(&mut sys.stdout, a);
    case_k2(&mut sys.stdout, a);
    case_k3(&mut sys.stdout, a);
    case_k4(&mut sys.stdout, a);
    case_k5(&mut sys.stdout, a);
    case_k6(&mut sys.stdout, a);
    case_k7(&mut sys.stdout, a);
    case_k8(&mut sys.stdout, a);
}
