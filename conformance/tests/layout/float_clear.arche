    s4.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(5.0), bottom: sty.LengthPercentageAuto.length(0.0) };
