    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.position = sty.Position.Absolute;
    let n2 = t.add(s2, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    let o_a4 = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.PerformLayout, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: some(200.0), height: some(100.0) }, parent: geo.Size(?f32) { width: some(800.0), height: some(600.0) }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "A4", &o_a4);
    _tree_block.show_nodes(out, &t, "A4");
}

/// Case A5: an absolute child after margins that collapse through
fn case_a5(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(200.0), height: sty.Dimension.auto() };
