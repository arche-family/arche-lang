// stdout: A6 out 200.0 10.0 | over 0.0 0.0 0.0 0.0 | margins 0.0 0.0 | through false | base none | area none | cands 0
// Block layout's out-of-flow children: their static positions as
// candidates for compute.oof (inline area, block position, justify-self and
// align-self, right to left, after collapsed margins), candidates surfaced
// from in-flow children and moved to the container's box, the positioning
// area, and align-content moving them. The out-of-flow pass itself is not
// run here. The expected lines are taffy 0.15's own, from the same trees in
// Rust.
import std;
import alloc;
import layout.geometry as geo;
import layout.style as sty;
import layout.tree as lt;
import _tree_block;

/// Case A1: absolute children among in-flow ones
fn case_a1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(5.0), right: sty.LengthPercentage.length(7.0), top: sty.LengthPercentage.length(3.0), bottom: sty.LengthPercentage.length(1.0) };
    s0.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(2.0), right: sty.LengthPercentage.length(2.0), top: sty.LengthPercentage.length(2.0), bottom: sty.LengthPercentage.length(2.0) };
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(20.0) };
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(30.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.position = sty.Position.Absolute;
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(10.0), height: sty.Dimension.length(10.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(30.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.position = sty.Position.Fixed;
    s4.justify_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.Center, safety: sty.AlignmentSafety.Default });
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(10.0), height: sty.Dimension.length(10.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    let o_a1 = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.PerformLayout, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: some(300.0), height: none }, parent: geo.Size(?f32) { width: some(800.0), height: some(600.0) }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "A1", &o_a1);
    _tree_block.show_nodes(out, &t, "A1");
}

/// Case A2: candidates surfaced from nested in-flow children
fn case_a2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Scroll, y: sty.Overflow.Scroll };
    s0.scrollbar_width = 12.0;
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(3.0), right: sty.LengthPercentage.length(3.0), top: sty.LengthPercentage.length(3.0), bottom: sty.LengthPercentage.length(3.0) };
    s1.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(10.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(20.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(6.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(40.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.position = sty.Position.Absolute;
    s3.justify_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.End, safety: sty.AlignmentSafety.Default });
    s3.align_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.Center, safety: sty.AlignmentSafety.Default });
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.float = sty.Float.Left;
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(50.0), height: sty.Dimension.length(50.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    var s6 = _tree_block.blk(a);
    s6.position = sty.Position.Absolute;
    let n6 = t.add(s6, _tree_block.Content.Empty);
    t.add_child(parent: n2, child: n3);
    t.add_child(parent: n1, child: n2);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n4);
    t.add_child(parent: n5, child: n6);
    t.add_child(parent: n0, child: n5);
    let o_a2 = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.PerformLayout, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: some(300.0), height: none }, parent: geo.Size(?f32) { width: some(800.0), height: some(600.0) }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "A2", &o_a2);
    _tree_block.show_nodes(out, &t, "A2");
}

/// Case A3: static positions in right to left, and justify-items
fn case_a3(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.direction = sty.Direction.Rtl;
    s0.justify_items = sty.AlignItems { keyword: sty.AlignItemsKeyword.Center, safety: sty.AlignmentSafety.Default };
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(4.0), right: sty.LengthPercentage.length(8.0), top: sty.LengthPercentage.length(0.0), bottom: sty.LengthPercentage.length(0.0) };
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.position = sty.Position.Absolute;
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.position = sty.Position.Absolute;
    s3.justify_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.Start, safety: sty.AlignmentSafety.Default });
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.position = sty.Position.Absolute;
    s4.justify_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.SelfEnd, safety: sty.AlignmentSafety.Default });
    s4.direction = sty.Direction.Ltr;
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.position = sty.Position.Absolute;
    s5.justify_self = some(sty.AlignItems.safe(sty.AlignItemsKeyword.End));
    let n5 = t.add(s5, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    t.add_child(parent: n0, child: n5);
    let o_a3 = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.PerformLayout, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: some(300.0), height: none }, parent: geo.Size(?f32) { width: some(800.0), height: some(600.0) }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "A3", &o_a3);
    _tree_block.show_nodes(out, &t, "A3");
}

/// Case A4: align-content moves the static positions
fn case_a4(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.align_content = sty.AlignContent { keyword: sty.AlignContentKeyword.Center, safety: sty.AlignmentSafety.Default };
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(200.0), height: sty.Dimension.length(100.0) };
