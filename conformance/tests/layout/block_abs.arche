    var s1 = _tree_block.blk(a);
    s1.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.length(20.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.position = sty.Position.Absolute;
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(15.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    let o_a5 = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.PerformLayout, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: some(200.0), height: none }, parent: geo.Size(?f32) { width: some(800.0), height: some(600.0) }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "A5", &o_a5);
    _tree_block.show_nodes(out, &t, "A5");
}

/// Case A6: a size-only run has no candidates
fn case_a6(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(200.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.position = sty.Position.Absolute;
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    let o_a6 = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: some(200.0), height: none }, parent: geo.Size(?f32) { width: some(800.0), height: some(600.0) }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "A6", &o_a6);
}

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    case_a1(&mut sys.stdout, a);
    case_a2(&mut sys.stdout, a);
    case_a3(&mut sys.stdout, a);
    case_a4(&mut sys.stdout, a);
    case_a5(&mut sys.stdout, a);
    case_a6(&mut sys.stdout, a);
}
