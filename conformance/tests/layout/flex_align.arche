// Alignment: justify-content in every mode (space-* with one item and
// with overflow, safe and unsafe, reversed and rtl), align-items and
// align-self (start, end, flex-start, flex-end, center, stretch,
// baseline, self-start, self-end, safe), baselines of nested containers
// and of scroll containers, and the container's own first baseline.
// The expected lines are taffy 0.15's own, from the same cases in Rust
// (/tmp/layout-port/oracle-flex).
import std;
import _tree_flex;

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    _tree_flex.run(&mut sys.stdout, name: "A1", spec: "(flex w=300 h=100 jc=flex-start (leaf w=50) (leaf w=60))", a);
    _tree_flex.run(&mut sys.stdout, name: "A2", spec: "(flex w=300 h=100 jc=flex-end (leaf w=50) (leaf w=60))", a);
    _tree_flex.run(&mut sys.stdout, name: "A3", spec: "(flex w=300 h=100 jc=center (leaf w=50) (leaf w=60))", a);
    _tree_flex.run(&mut sys.stdout, name: "A4", spec: "(flex w=300 h=100 jc=space-between (leaf w=50) (leaf w=60) (leaf w=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "A5", spec: "(flex w=300 h=100 jc=space-around (leaf w=50) (leaf w=60) (leaf w=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "A6", spec: "(flex w=300 h=100 jc=space-evenly (leaf w=50) (leaf w=60) (leaf w=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "A7", spec: "(flex w=300 h=100 jc=space-between (leaf w=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "A8", spec: "(flex w=300 h=100 jc=space-around (leaf w=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "A9", spec: "(flex w=100 h=100 jc=center (leaf w=80 shrink=0) (leaf w=60 shrink=0))", a);
    _tree_flex.run(&mut sys.stdout, name: "A10", spec: "(flex w=100 h=100 jc=safe-center (leaf w=80 shrink=0) (leaf w=60 shrink=0))", a);
    _tree_flex.run(&mut sys.stdout, name: "A11", spec: "(flex w=100 h=100 jc=space-evenly (leaf w=80 shrink=0) (leaf w=60 shrink=0))", a);
    _tree_flex.run(&mut sys.stdout, name: "A12", spec: "(flex w=300 h=100 dir=row-reverse jc=flex-start (leaf w=50) (leaf w=60))", a);
    _tree_flex.run(&mut sys.stdout, name: "A13", spec: "(flex w=300 h=100 dir=row-reverse jc=start (leaf w=50) (leaf w=60))", a);
    _tree_flex.run(&mut sys.stdout, name: "A14", spec: "(flex w=300 h=100 dir=row-reverse jc=end (leaf w=50) (leaf w=60))", a);
    _tree_flex.run(&mut sys.stdout, name: "A15", spec: "(flex w=300 h=100 dirn=rtl jc=flex-start (leaf w=50) (leaf w=60))", a);
    _tree_flex.run(&mut sys.stdout, name: "A16", spec: "(flex w=300 h=100 dirn=rtl jc=space-between gap=5 (leaf w=50 ml=3) (leaf w=60 mr=4) (leaf w=20))", a);
    _tree_flex.run(&mut sys.stdout, name: "A17", spec: "(flex dir=column w=100 h=300 jc=center gap=10 (leaf h=50) (leaf h=60))", a);
    _tree_flex.run(&mut sys.stdout, name: "A18", spec: "(flex dir=column-reverse w=100 h=300 jc=space-around (leaf h=50) (leaf h=60))", a);
    _tree_flex.run(&mut sys.stdout, name: "A19", spec: "(flex w=300 h=100 ai=flex-start (leaf w=50 h=20) (leaf w=50) (leaf w=50 fixed=10,30))", a);
    _tree_flex.run(&mut sys.stdout, name: "A20", spec: "(flex w=300 h=100 ai=flex-end (leaf w=50 h=20) (leaf w=50) (leaf w=50 fixed=10,30))", a);
    _tree_flex.run(&mut sys.stdout, name: "A21", spec: "(flex w=300 h=100 ai=center (leaf w=50 h=20) (leaf w=50) (leaf w=50 fixed=10,35))", a);
    _tree_flex.run(&mut sys.stdout, name: "A22", spec: "(flex w=300 h=100 ai=stretch (leaf w=50 h=20) (leaf w=50) (leaf w=50 maxh=40))", a);
    _tree_flex.run(&mut sys.stdout, name: "A23", spec: "(flex w=300 h=100 ai=start (leaf w=50 h=20 as=end) (leaf w=50 as=center) (leaf w=50 h=30 as=self-end))", a);
    _tree_flex.run(&mut sys.stdout, name: "A24", spec: "(flex w=300 h=100 ai=baseline (leaf w=50 fixed=10,20) (leaf w=50 fixed=10,40 mt=10) (leaf w=50 fixed=10,30))", a);
    _tree_flex.run(&mut sys.stdout, name: "A25", spec: "(flex w=300 ai=baseline (leaf w=50 fixed=10,20) (leaf w=50 fixed=10,40 mt=10) (leaf w=50 fixed=10,30 mb=5))", a);
    _tree_flex.run(&mut sys.stdout, name: "A26", spec: "(flex w=300 h=100 ai=baseline (flex w=80 dir=column (leaf h=15) (leaf h=25)) (flex w=80 p=10 (leaf h=30 as=baseline) (leaf h=10 as=baseline)) (leaf w=50 h=12))", a);
    _tree_flex.run(&mut sys.stdout, name: "A27", spec: "(flex w=300 h=100 ai=baseline (flex w=80 oy=hidden h=20 (leaf h=60)) (leaf w=50 h=30))", a);
    _tree_flex.run(&mut sys.stdout, name: "A28", spec: "(flex w=300 h=100 dir=column ai=center (leaf w=50 h=20) (leaf h=20) (leaf w=250 h=20 as=safe-center) (leaf w=350 h=20 as=safe-center) (leaf w=350 h=20 as=center))", a);
    _tree_flex.run(&mut sys.stdout, name: "A29", spec: "(flex w=300 h=100 dir=column dirn=rtl ai=start (leaf w=50 h=20) (leaf w=50 h=20 as=flex-start) (leaf w=50 h=20 as=end) (leaf w=50 h=20 as=stretch) (leaf h=20 as=baseline))", a);
    _tree_flex.run(&mut sys.stdout, name: "A30", spec: "(flex w=300 h=100 dir=column ai=self-start (leaf w=50 h=20 dirn=rtl) (leaf w=50 h=20 as=self-end dirn=rtl) (leaf w=50 h=20))", a);
    _tree_flex.run(&mut sys.stdout, name: "A31", spec: "(flex w=200 h=200 wrap=wrap-reverse ai=baseline (leaf w=80 fixed=10,20) (leaf w=80 fixed=10,40 mt=10) (leaf w=80 fixed=10,30))", a);
    _tree_flex.run(&mut sys.stdout, name: "A32", spec: "mode=direct (flex w=200 ai=baseline (leaf w=50 fixed=10,20 mt=5) (leaf w=50 fixed=10,40))", a);
    _tree_flex.run(&mut sys.stdout, name: "A33", spec: "mode=direct (flex w=200 dir=column (leaf h=50 fixed=10,20) (leaf h=50 fixed=10,40))", a);
    _tree_flex.run(&mut sys.stdout, name: "A34", spec: "mode=direct (flex w=200 dir=column-reverse (leaf h=50 fixed=10,20) (leaf h=50 fixed=10,40))", a);
    _tree_flex.run(&mut sys.stdout, name: "A35", spec: "mode=direct (flex w=200 wrap=wrap-reverse (leaf w=150 fixed=10,20) (leaf w=150 fixed=10,40))", a);
    _tree_flex.run(&mut sys.stdout, name: "A36", spec: "mode=direct (flex w=200 contain=layout (leaf w=50 fixed=10,20))", a);
    _tree_flex.run(&mut sys.stdout, name: "A37", spec: "(flex w=300 h=100 dir=column ai=baseline (leaf w=50 h=20) (leaf w=50 h=20 mt=5))", a);
    _tree_flex.run(&mut sys.stdout, name: "A38", spec: "(flex w=300 h=100 dir=column wrap=wrap ai=baseline dirn=rtl (leaf w=50 h=20) (leaf w=50 h=20 mt=5))", a);
    _tree_flex.run(&mut sys.stdout, name: "A39", spec: "(flex w=300 h=50 ai=safe-end (leaf w=50 h=80) (leaf w=50 h=20 as=safe-flex-end) (leaf w=50 h=80 as=unsafe-end))", a);
    _tree_flex.run(&mut sys.stdout, name: "A40", spec: "(flex w=300 h=100 jc=normal ac=normal ai=normal (leaf w=50) (leaf w=60))", a);
}
