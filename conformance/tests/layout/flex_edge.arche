// Edge cases: containers without items (empty, every child display: none
// or out of flow, balanced), a flex-line-count of zero, zero and negative
// sizes, relative insets of zero, items larger than the space in every
// direction, and deep nesting through min- and max-content space.
// The expected lines are taffy 0.15's own, from the same cases in Rust
// (/tmp/layout-port/oracle-flex).
import std;
import _tree_flex;

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    _tree_flex.run(&mut sys.stdout, name: "E1", spec: "(flex w=100 h=50)", a);
    _tree_flex.run(&mut sys.stdout, name: "E2", spec: "(flex w=100 h=50 (leaf display=none w=10) (leaf display=none h=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "E3", spec: "(flex wrap=balance (leaf display=none w=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "E4", spec: "mode=direct (flex wrap=balance gap=10 (leaf pos=absolute w=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "E5", spec: "mode=direct avail=min,min (flex dir=column wrap=wrap-reverse gap=10 jc=space-around ac=space-evenly (leaf pos=absolute w=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "E6", spec: "(flex w=100 wrap=wrap lines=0 (leaf w=60 h=10) (leaf w=60 h=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "E7", spec: "(flex w=0 h=0 (leaf w=0 h=0) (leaf grow=1) (leaf shrink=1 w=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "E8", spec: "(flex w=100 h=50 (leaf w=-20 h=-5) (leaf basis=-30 grow=1) (leaf m=-0))", a);
    _tree_flex.run(&mut sys.stdout, name: "E9", spec: "(flex w=100 h=50 (leaf w=30 pos=relative ir=0) (leaf w=30 pos=relative ib=0 dirn=rtl) (leaf w=30 pos=relative il=-0))", a);
    _tree_flex.run(&mut sys.stdout, name: "E10", spec: "(flex w=100 h=50 dirn=rtl (leaf w=30 pos=relative ir=0) (leaf w=30 pos=relative ib=0))", a);
    _tree_flex.run(&mut sys.stdout, name: "E11", spec: "(flex dir=column w=100 h=50 dirn=rtl (leaf w=30 h=10 pos=relative ir=0 ib=0) (leaf w=30 h=10 pos=relative il=0))", a);
    _tree_flex.run(&mut sys.stdout, name: "E12", spec: "(flex w=50 h=50 dir=row-reverse wrap=wrap-reverse (leaf w=80 h=80 shrink=0) (leaf w=80 h=80 shrink=0))", a);
    _tree_flex.run(&mut sys.stdout, name: "E13", spec: "(flex w=50 h=50 dir=column-reverse wrap=wrap-reverse dirn=rtl (leaf w=80 h=80 shrink=0) (leaf w=80 h=80 shrink=0))", a);
    _tree_flex.run(&mut sys.stdout, name: "E14", spec: "avail=min,min (flex (flex dir=column (flex wrap=wrap (leaf text=100,10) (leaf text=50,10)) (leaf text=70,10)) (flex basis=content (leaf text=30,10)))", a);
    _tree_flex.run(&mut sys.stdout, name: "E15", spec: "avail=max,max (flex (flex dir=column (flex wrap=wrap (leaf text=100,10) (leaf text=50,10)) (leaf text=70,10)) (flex basis=content (leaf text=30,10)))", a);
    _tree_flex.run(&mut sys.stdout, name: "E16", spec: "avail=0,0 (flex (leaf text=100,10) (leaf fixed=20,20))", a);
    _tree_flex.run(&mut sys.stdout, name: "E17", spec: "(flex w=100 h=100 ai=baseline (leaf w=10 h=10) (leaf w=10 h=20 display=none) (leaf w=10 h=30 mt=auto) (leaf w=10 h=5))", a);
    _tree_flex.run(&mut sys.stdout, name: "E18", spec: "(flex w=100 h=100 gap=200 (leaf grow=1) (leaf grow=1))", a);
    _tree_flex.run(&mut sys.stdout, name: "E19", spec: "(flex w=100 h=100 wrap=wrap gap=200 ac=center (leaf w=60 h=10) (leaf w=60 h=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "E20", spec: "round (flex w=100.4 h=100.6 p=0.3 b=0.2 m=0.1 (leaf grow=1 m=0.45) (leaf grow=1 p=0.55) (leaf grow=1 b=0.35))", a);
}
