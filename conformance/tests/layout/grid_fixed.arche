    t.add_child(parent: n0, child: n3);
    var s4 = sty.Style.default(a);
    let n4 = t.add(s4, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n4);
    let avail = geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(333.3), height: sty.AvailableSpace.definite(222.2) };
    compute.compute_root_layout(&mut t, n0, avail);
    _show.layout_line(out, "F12.0", t.unrounded_of(n0));
    _show.layout_line(out, "F12.1", t.unrounded_of(n1));
    _show.layout_line(out, "F12.2", t.unrounded_of(n2));
    _show.layout_line(out, "F12.3", t.unrounded_of(n3));
    _show.layout_line(out, "F12.4", t.unrounded_of(n4));
    _tree_grid.counts_line(out, "F12", &t);
}

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    case_f1(&mut sys.stdout, a);
    case_f2(&mut sys.stdout, a);
    case_f3(&mut sys.stdout, a);
    case_f4(&mut sys.stdout, a);
    case_f5(&mut sys.stdout, a);
    case_f6(&mut sys.stdout, a);
    case_f7(&mut sys.stdout, a);
    case_f8(&mut sys.stdout, a);
    case_f9(&mut sys.stdout, a);
    case_f10(&mut sys.stdout, a);
    case_f11(&mut sys.stdout, a);
    case_f12(&mut sys.stdout, a);
}
