fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    case_s1(&mut sys.stdout, a);
    case_s2(&mut sys.stdout, a);
    case_s3(&mut sys.stdout, a);
    case_s4(&mut sys.stdout, a);
    case_s5(&mut sys.stdout, a);
    case_s6(&mut sys.stdout, a);
    case_s7(&mut sys.stdout, a);
}
