// Static positions: boxes with both insets of an axis auto stay where the
// container recorded them. A Stack container records a block's static
// position (its content box across, aligned by justify-self or the
// container's justify-items, and a line at the box's place in the flow
// down); an Area container records the content box in both axes, aligned
// by justify-self and align-self or justify-items and align-items, as flex
// and grid containers do. Start, center and end, safe fallbacks, rtl and
// self-start and self-end against the box's own direction. The expected
// lines are taffy 0.15's own, from the same trees in Rust
// (/tmp/layout-port/oracle-oof).
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import _show;
import _tree_oof;

/// a Stack: absolute boxes between in-flow ones keep their place in the flow.
fn case_s1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_oof.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.position = sty.Position.Relative;
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.length(300.0) };
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(10.0), right: sty.LengthPercentage.length(10.0), top: sty.LengthPercentage.length(10.0), bottom: sty.LengthPercentage.length(10.0) };
    s0.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(5.0), right: sty.LengthPercentage.length(5.0), top: sty.LengthPercentage.length(5.0), bottom: sty.LengthPercentage.length(5.0) };
    let n0 = t.add(s0, _tree_oof.Content.Stack);
    let s1 = sty.Style.default(a);
    let n1 = t.add(s1, _tree_oof.Content.Fixed { width: 100.0, height: 30.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    s2.position = sty.Position.Absolute;
    let n2 = t.add(s2, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n2);
    let s3 = sty.Style.default(a);
    let n3 = t.add(s3, _tree_oof.Content.Fixed { width: 80.0, height: 25.0 });
    t.add_child(parent: n0, child: n3);
    var s4 = sty.Style.default(a);
    s4.position = sty.Position.Absolute;
    s4.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(100.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.auto(), bottom: sty.LengthPercentageAuto.auto() };
    let n4 = t.add(s4, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n4);
    var s5 = sty.Style.default(a);
    s5.position = sty.Position.Absolute;
    s5.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.auto() };
    let n5 = t.add(s5, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n5);
    let s6 = sty.Style.default(a);
    let n6 = t.add(s6, _tree_oof.Content.Fixed { width: 120.0, height: 35.0 });
    t.add_child(parent: n0, child: n6);
    var s7 = sty.Style.default(a);
    s7.position = sty.Position.Absolute;
    let n7 = t.add(s7, _tree_oof.Content.Text { width: 300.0, line: 20.0 });
    t.add_child(parent: n0, child: n7);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _show.layout_line(out, "S1.0", t.unrounded_of(n0));
    _show.layout_line(out, "S1.1", t.unrounded_of(n1));
    _show.layout_line(out, "S1.2", t.unrounded_of(n2));
    _show.layout_line(out, "S1.3", t.unrounded_of(n3));
    _show.layout_line(out, "S1.4", t.unrounded_of(n4));
    _show.layout_line(out, "S1.5", t.unrounded_of(n5));
    _show.layout_line(out, "S1.6", t.unrounded_of(n6));
    _show.layout_line(out, "S1.7", t.unrounded_of(n7));
    t.hoisted_line(out, "S1.0", n0);
    compute.round_layout(&mut t, n0);
    _show.layout_line(out, "S1.0r", t.final_of(n0));
    _show.layout_line(out, "S1.1r", t.final_of(n1));
    _show.layout_line(out, "S1.2r", t.final_of(n2));
    _show.layout_line(out, "S1.3r", t.final_of(n3));
    _show.layout_line(out, "S1.4r", t.final_of(n4));
    _show.layout_line(out, "S1.5r", t.final_of(n5));
    _show.layout_line(out, "S1.6r", t.final_of(n6));
    _show.layout_line(out, "S1.7r", t.final_of(n7));
}

/// a Stack: justify-self and justify-items, safe and unsafe, against the content box.
fn case_s2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_oof.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.position = sty.Position.Relative;
