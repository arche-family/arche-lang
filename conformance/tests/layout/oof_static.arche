    t.add_child(parent: n0, child: n4);
    var s5 = sty.Style.default(a);
    s5.position = sty.Position.Absolute;
    s5.justify_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.End, safety: sty.AlignmentSafety.Safe });
    let n5 = t.add(s5, _tree_oof.Content.Fixed { width: 500.0, height: 40.0 });
    t.add_child(parent: n0, child: n5);
    var s6 = sty.Style.default(a);
    s6.position = sty.Position.Absolute;
    s6.justify_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.End, safety: sty.AlignmentSafety.Unsafe });
    let n6 = t.add(s6, _tree_oof.Content.Fixed { width: 500.0, height: 40.0 });
    t.add_child(parent: n0, child: n6);
    var s7 = sty.Style.default(a);
    s7.position = sty.Position.Absolute;
    s7.justify_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.Center, safety: sty.AlignmentSafety.Safe });
    let n7 = t.add(s7, _tree_oof.Content.Fixed { width: 500.0, height: 40.0 });
    t.add_child(parent: n0, child: n7);
    var s8 = sty.Style.default(a);
    s8.position = sty.Position.Absolute;
    s8.justify_self = some(sty.AlignItems { keyword: sty.AlignItemsKeyword.FlexEnd, safety: sty.AlignmentSafety.Default });
    s8.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(5.0), right: sty.LengthPercentageAuto.length(20.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    let n8 = t.add(s8, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n8);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _show.layout_line(out, "S2.0", t.unrounded_of(n0));
    _show.layout_line(out, "S2.1", t.unrounded_of(n1));
    _show.layout_line(out, "S2.2", t.unrounded_of(n2));
    _show.layout_line(out, "S2.3", t.unrounded_of(n3));
    _show.layout_line(out, "S2.4", t.unrounded_of(n4));
    _show.layout_line(out, "S2.5", t.unrounded_of(n5));
    _show.layout_line(out, "S2.6", t.unrounded_of(n6));
    _show.layout_line(out, "S2.7", t.unrounded_of(n7));
    _show.layout_line(out, "S2.8", t.unrounded_of(n8));
    t.hoisted_line(out, "S2.0", n0);
    compute.round_layout(&mut t, n0);
    _show.layout_line(out, "S2.0r", t.final_of(n0));
    _show.layout_line(out, "S2.1r", t.final_of(n1));
