// Block layout's scroll containers and overflow: scrollbar gutters, the
// scrollable overflow of children (escaping, clipped, contained), right to
// left, align-content on a block container, baselines of scroll containers,
// and the containment of layout and paint. The expected lines are taffy
// 0.15's own, from the same trees in Rust.
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import layout.tree as lt;
import _tree_block;

/// Case O1: a scroll container with scrollbars and overflowing children
fn case_o1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(600.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Scroll, y: sty.Overflow.Scroll };
    s1.scrollbar_width = 15.0;
    s1.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(10.0), right: sty.LengthPercentage.length(10.0), top: sty.LengthPercentage.length(10.0), bottom: sty.LengthPercentage.length(10.0) };
    s1.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(2.0), right: sty.LengthPercentage.length(2.0), top: sty.LengthPercentage.length(2.0), bottom: sty.LengthPercentage.length(2.0) };
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(200.0), height: sty.Dimension.length(150.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.length(50.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(300.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    t.add_child(parent: n1, child: n2);
    t.add_child(parent: n1, child: n3);
    t.add_child(parent: n0, child: n1);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "O1");
}

/// Case O2: overflow escapes visible children, not hidden or contained ones
fn case_o2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(-10.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(500.0), height: sty.Dimension.length(20.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Hidden, y: sty.Overflow.Hidden };
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(500.0), height: sty.Dimension.length(20.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.contain = sty.Contain.paint();
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    var s6 = _tree_block.blk(a);
    s6.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(500.0), height: sty.Dimension.length(20.0) };
    let n6 = t.add(s6, _tree_block.Content.Empty);
    var s7 = _tree_block.blk(a);
    s7.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Visible, y: sty.Overflow.Clip };
    s7.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n7 = t.add(s7, _tree_block.Content.Empty);
    var s8 = _tree_block.blk(a);
    s8.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(500.0), height: sty.Dimension.length(20.0) };
    let n8 = t.add(s8, _tree_block.Content.Empty);
    t.add_child(parent: n1, child: n2);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n3, child: n4);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n5, child: n6);
    t.add_child(parent: n0, child: n5);
    t.add_child(parent: n7, child: n8);
    t.add_child(parent: n0, child: n7);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "O2");
}

/// Case O3: a right to left scroll container
fn case_o3(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(600.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Scroll, y: sty.Overflow.Scroll };
    s1.scrollbar_width = 15.0;
    s1.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(3.0), right: sty.LengthPercentage.length(9.0), top: sty.LengthPercentage.length(1.0), bottom: sty.LengthPercentage.length(1.0) };
    s1.direction = sty.Direction.Rtl;
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(200.0), height: sty.Dimension.length(150.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.length(50.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(50.0), height: sty.Dimension.length(300.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    t.add_child(parent: n1, child: n2);
    t.add_child(parent: n1, child: n3);
    t.add_child(parent: n0, child: n1);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "O3");
}

/// Case O4: align-content on a block container
fn case_o4(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.align_content = sty.AlignContent { keyword: sty.AlignContentKeyword.Center, safety: sty.AlignmentSafety.Default };
    s1.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(4.0), right: sty.LengthPercentage.length(4.0), top: sty.LengthPercentage.length(4.0), bottom: sty.LengthPercentage.length(4.0) };
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(200.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(20.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.length(5.0) };
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(30.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.align_content = sty.AlignContent { keyword: sty.AlignContentKeyword.End, safety: sty.AlignmentSafety.Default };
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(200.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(20.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
