// The scrollable overflow out-of-flow boxes add to their containing block:
// boxes past its edges, boxes before its origin (dropped by a scroll
// container), boxes that clip, contain or scroll their own overflow, rtl
// containers measuring from the right, and scrollbar gutters that shrink the
// positioning area. The expected lines are taffy 0.15's own, from the same
// trees in Rust (/tmp/layout-port/oracle-oof).
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import _show;
import _tree_oof;

/// boxes past the edges of a visible container.
fn case_o1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_oof.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.position = sty.Position.Relative;
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.length(300.0) };
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(10.0), right: sty.LengthPercentage.length(10.0), top: sty.LengthPercentage.length(10.0), bottom: sty.LengthPercentage.length(10.0) };
    s0.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(5.0), right: sty.LengthPercentage.length(5.0), top: sty.LengthPercentage.length(5.0), bottom: sty.LengthPercentage.length(5.0) };
    let n0 = t.add(s0, _tree_oof.Content.Stack);
    var s1 = sty.Style.default(a);
    s1.position = sty.Position.Absolute;
    s1.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(380.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(280.0), bottom: sty.LengthPercentageAuto.auto() };
    let n1 = t.add(s1, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    s2.position = sty.Position.Absolute;
    s2.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(-40.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(-30.0), bottom: sty.LengthPercentageAuto.auto() };
    let n2 = t.add(s2, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n2);
    var s3 = sty.Style.default(a);
    s3.position = sty.Position.Absolute;
    s3.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(300.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.auto() };
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(20.0), height: sty.Dimension.length(20.0) };
    let n3 = t.add(s3, _tree_oof.Content.Stack);
    t.add_child(parent: n0, child: n3);
    var s4 = sty.Style.default(a);
    s4.position = sty.Position.Absolute;
    s4.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(100.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(100.0), bottom: sty.LengthPercentageAuto.auto() };
    let n4 = t.add(s4, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n3, child: n4);
    let s5 = sty.Style.default(a);
    let n5 = t.add(s5, _tree_oof.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n5);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _show.layout_line(out, "O1.0", t.unrounded_of(n0));
    _show.layout_line(out, "O1.1", t.unrounded_of(n1));
    _show.layout_line(out, "O1.2", t.unrounded_of(n2));
    _show.layout_line(out, "O1.3", t.unrounded_of(n3));
    _show.layout_line(out, "O1.4", t.unrounded_of(n4));
    _show.layout_line(out, "O1.5", t.unrounded_of(n5));
    t.hoisted_line(out, "O1.0", n0);
    t.hoisted_line(out, "O1.3", n3);
    compute.round_layout(&mut t, n0);
    _show.layout_line(out, "O1.0r", t.final_of(n0));
    _show.layout_line(out, "O1.1r", t.final_of(n1));
    _show.layout_line(out, "O1.2r", t.final_of(n2));
    _show.layout_line(out, "O1.3r", t.final_of(n3));
    _show.layout_line(out, "O1.4r", t.final_of(n4));
    _show.layout_line(out, "O1.5r", t.final_of(n5));
}

/// a scroll container drops boxes wholly before its origin.
fn case_o2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_oof.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.position = sty.Position.Relative;
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.length(300.0) };
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(10.0), right: sty.LengthPercentage.length(10.0), top: sty.LengthPercentage.length(10.0), bottom: sty.LengthPercentage.length(10.0) };
    s0.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(5.0), right: sty.LengthPercentage.length(5.0), top: sty.LengthPercentage.length(5.0), bottom: sty.LengthPercentage.length(5.0) };
    s0.overflow = geo.Point(sty.Overflow) { x: sty.Overflow.Hidden, y: sty.Overflow.Hidden };
    let n0 = t.add(s0, _tree_oof.Content.Stack);
    var s1 = sty.Style.default(a);
    s1.position = sty.Position.Absolute;
    s1.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(380.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(280.0), bottom: sty.LengthPercentageAuto.auto() };
    let n1 = t.add(s1, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    s2.position = sty.Position.Absolute;
    s2.inset = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(-100.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(10.0), bottom: sty.LengthPercentageAuto.auto() };
    let n2 = t.add(s2, _tree_oof.Content.Fixed { width: 50.0, height: 40.0 });
