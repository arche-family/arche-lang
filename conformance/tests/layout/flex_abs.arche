// Absolutely positioned children laid out end to end: flex containers
// (relative, or the root) are their containing blocks, so the static
// positions compute_flexbox_layout gives go through compute.oof's pass,
// with insets, auto insets at the static position, padding, borders and
// scrollbar gutters, rtl, and boxes bubbled up from static descendants.
// The expected lines are taffy 0.15's own, from the same cases in Rust
// (/tmp/layout-port/oracle-flex).
import std;
import _tree_flex;

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    _tree_flex.run(&mut sys.stdout, name: "X1", spec: "(flex w=300 h=200 pos=relative p=10 (leaf w=50 h=20) (leaf pos=absolute w=30 h=30) (leaf w=50 h=20))", a);
    _tree_flex.run(&mut sys.stdout, name: "X2", spec: "(flex w=300 h=200 pos=relative jc=center ai=center (leaf pos=absolute w=30 h=30) (leaf pos=absolute w=40 h=10 as=flex-end))", a);
    _tree_flex.run(&mut sys.stdout, name: "X3", spec: "(flex w=300 h=200 pos=relative dir=column-reverse jc=flex-start ai=flex-end b=5 (leaf pos=absolute w=30 h=30) (leaf pos=absolute w=30 h=30 il=10 it=20))", a);
    _tree_flex.run(&mut sys.stdout, name: "X4", spec: "(flex w=300 h=200 pos=relative dirn=rtl jc=space-between oy=scroll sw=12 (leaf pos=absolute w=30 h=30) (leaf w=20 h=20) (leaf pos=absolute ir=5 ib=5 w=10 h=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "X5", spec: "(flex w=300 h=200 pos=relative p=7 (flex w=100 h=100 m=10 (leaf pos=absolute w=30 h=30) (flex (leaf pos=absolute il=0 it=0 w=5 h=5))) (leaf pos=absolute il=50% it=25% w=10% h=10%))", a);
    _tree_flex.run(&mut sys.stdout, name: "X6", spec: "(flex w=300 h=200 pos=relative wrap=wrap-reverse ai=stretch (leaf w=200 h=20) (leaf pos=absolute w=30) (leaf w=200 h=20))", a);
    _tree_flex.run(&mut sys.stdout, name: "X7", spec: "(flex w=300 h=200 jc=flex-end (leaf pos=absolute w=30 h=30) (flex w=100 h=50 pos=relative jc=center (leaf pos=absolute w=20 h=20 as=safe-center)))", a);
    _tree_flex.run(&mut sys.stdout, name: "X8", spec: "(flex w=100 h=100 pos=relative ai=center (leaf pos=absolute w=150 h=150 as=safe-center) (leaf pos=absolute w=150 h=150 as=center))", a);
}
