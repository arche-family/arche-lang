// Flexible tracks: fr in a definite container, fr against items that do not
// fit, fr in an indefinite container and under min and max sizes, 0fr and
// fractions summing below one, items spanning flexible and inflexible
// tracks, fr rows.
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import layout.style.grid as sgrid;
import layout.tree as lt;
import _show;
import _tree_grid;

/// X1
fn case_x1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_grid.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.auto(), max: sgrid.MaxTrackSizingFunction.fr(1.0) } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.auto(), max: sgrid.MaxTrackSizingFunction.fr(2.0) } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.auto(), max: sgrid.MaxTrackSizingFunction.fr(1.0) } });
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.length(100.0) };
    s0.display = sty.Display.Grid;
    let n0 = t.add(s0, _tree_grid.Content.Empty);
    var s1 = sty.Style.default(a);
    let n1 = t.add(s1, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    let n2 = t.add(s2, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n2);
    var s3 = sty.Style.default(a);
    let n3 = t.add(s3, _tree_grid.Content.Fixed { width: 10.0, height: 10.0 });
    t.add_child(parent: n0, child: n3);
    let avail = geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) };
    compute.compute_root_layout(&mut t, n0, avail);
    _show.layout_line(out, "X1.0", t.unrounded_of(n0));
    _show.layout_line(out, "X1.1", t.unrounded_of(n1));
    _show.layout_line(out, "X1.2", t.unrounded_of(n2));
    _show.layout_line(out, "X1.3", t.unrounded_of(n3));
    _tree_grid.counts_line(out, "X1", &t);
}

