// Random grid trees (seed 21, leaning to mixed cases): templates with
// fixed, fr, auto, min-content, max-content, minmax and fit-content
// tracks, repeat counts, auto-fill and auto-fit, implicit tracks, every
// auto-flow, line, negative, span, named and area placements, gaps,
// every alignment value, percentages and calc, min, max and aspect
// ratio, nested grids and out-of-flow children, so that the port meets
// the combinations no hand-written case thought of. The expected lines
// are taffy 0.15's own, from the same cases in Rust: _oracle/grid
// (gen.py made this file).
import std;
import _tree_grid;

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    _tree_grid.run(&mut sys.stdout, name: "G1", spec: "avail=300,200 (grid cols=fit-content(50%),1fr,auto,repeat(3,fit-content(calc(10+20%))) ac=safe-start maxw=12.5 (leaf ar=0.5 box=content ox=clip row=auto/4 text=120,10) (leaf as=flex-end js=safe-flex-start text=40,12.5))", a);
    _tree_grid.run(&mut sys.stdout, name: "G2", spec: "avail=300,200 mode=sizeh (grid rows=fit-content(30),[hd-start.x],25,repeat(3,[],60,[b],2fr,[a]) arows=2fr flow=row-dense ji=self-end minh=5 (leaf h=100% oy=clip col=x:-1/span-1 creplaced=1 fixed=25,35) (leaf m=10% row=-1/-2) (leaf w=75.75 row=span-1/auto text=75,12.5) (leaf w=min-content h=fit-content(25%) minh=100 p=5% ox=hidden col=auto/-1 row=span-3/span-a:1 as=unsafe-flex-start fixed=25,20) (leaf minh=auto p=3 sw=10 fixed=50,20) (grid cols=minmax(auto,fit-content(20)),calc(0+50%),1fr,40 rows=repeat(2,100),0.5fr arows=100,0.5fr,auto jc=space-evenly col=x:0/auto row=auto/auto as=stretch (leaf w=min-content row=-3/auto fixed=5,30) (leaf ar=2 m=5%,5%,auto,0 col=main:0/-1) (leaf h=20 maxh=100 col=y:-1/span-1 row=span-3/span-1 text=40,12.5) (leaf h=auto row=hd-start:1/3 text=250,10)) (leaf h=20 maxh=12.5 col=span-1/span-2 row=-3/auto))", a);
