import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import layout.style.grid as sgrid;
import layout.tree as lt;
import _show;
import _tree_grid;

/// I1
fn case_i1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_grid.TestTree.init(a);
    var s0 = sty.Style.default(a);
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.auto(), max: sgrid.MaxTrackSizingFunction.auto() } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.auto(), max: sgrid.MaxTrackSizingFunction.auto() } });
    s0.grid_template_columns.push(sgrid.GridTemplateComponent.Single { track: sgrid.TrackSizingFunction { min: sgrid.MinTrackSizingFunction.auto(), max: sgrid.MaxTrackSizingFunction.auto() } });
    s0.display = sty.Display.Grid;
    let n0 = t.add(s0, _tree_grid.Content.Empty);
    var s1 = sty.Style.default(a);
    let n1 = t.add(s1, _tree_grid.Content.Text { width: 120.0, line: 10.0 });
    t.add_child(parent: n0, child: n1);
    var s2 = sty.Style.default(a);
    let n2 = t.add(s2, _tree_grid.Content.Text { width: 60.0, line: 10.0 });
    t.add_child(parent: n0, child: n2);
    var s3 = sty.Style.default(a);
    let n3 = t.add(s3, _tree_grid.Content.Fixed { width: 30.0, height: 30.0 });
    t.add_child(parent: n0, child: n3);
    let avail = geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) };
    compute.compute_root_layout(&mut t, n0, avail);
    _show.layout_line(out, "I1.0", t.unrounded_of(n0));
    _show.layout_line(out, "I1.1", t.unrounded_of(n1));
    _show.layout_line(out, "I1.2", t.unrounded_of(n2));
    _show.layout_line(out, "I1.3", t.unrounded_of(n3));
    _tree_grid.counts_line(out, "I1", &t);
}

