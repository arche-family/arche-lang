fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    case_i1(&mut sys.stdout, a);
    case_i2(&mut sys.stdout, a);
    case_i3(&mut sys.stdout, a);
    case_i4(&mut sys.stdout, a);
    case_i5(&mut sys.stdout, a);
    case_i6(&mut sys.stdout, a);
    case_i7(&mut sys.stdout, a);
    case_i8(&mut sys.stdout, a);
    case_i9(&mut sys.stdout, a);
    case_i10(&mut sys.stdout, a);
    case_i11(&mut sys.stdout, a);
    case_i12(&mut sys.stdout, a);
    case_i13(&mut sys.stdout, a);
    case_i14(&mut sys.stdout, a);
    case_i15(&mut sys.stdout, a);
    case_i16(&mut sys.stdout, a);
}
