// Block layout's sizes: lengths, percentages and calc() of the container,
// min and max, box-sizing, padding and border in percent, aspect ratio,
// stretch and the sizing keywords of width, tables and replaced items,
// display none among the children. The expected lines are taffy 0.15's own,
// from the same trees in Rust.
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import layout.tree as lt;
import _tree_block;

/// Case S1: percentages against a definite and an auto parent height
fn case_s1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(200.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.percent(0.5), height: sty.Dimension.percent(0.25) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.percent(0.5), height: sty.Dimension.percent(0.25) };
    let n4 = t.add(s4, _tree_block.Content.Fixed { width: 5.0, height: 5.0 });
    t.add_child(parent: n1, child: n2);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n3, child: n4);
    t.add_child(parent: n0, child: n3);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "S1");
}

/// Case S2: calc() widths, heights and margins
fn case_s2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(333.0), height: sty.Dimension.length(150.0) };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.calc(sty.Calc { px: 2.0, percent: 5.0 }), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.calc(sty.Calc { px: 10.0, percent: 50.0 }), height: sty.Dimension.calc(sty.Calc { px: 5.0, percent: 10.0 }) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.calc(sty.Calc { px: -20.0, percent: 100.0 }), height: sty.Dimension.length(10.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "S2");
}

/// Case S3: min and max width and height
fn case_s3(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(500.0), height: sty.Dimension.length(10.0) };
    s1.max_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.length(200.0), height: sty.LengthPercentageAuto.auto() };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(50.0), height: sty.Dimension.length(10.0) };
    s2.min_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.length(120.0), height: sty.LengthPercentageAuto.auto() };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(10.0) };
    s3.min_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.length(300.0), height: sty.LengthPercentageAuto.auto() };
    s3.max_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.length(100.0), height: sty.LengthPercentageAuto.auto() };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.min_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.percent(0.1), height: sty.LengthPercentageAuto.auto() };
    s4.max_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.auto(), height: sty.LengthPercentageAuto.length(15.0) };
    let n4 = t.add(s4, _tree_block.Content.Text { width: 500.0, line: 10.0 });
    var s5 = _tree_block.blk(a);
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(5.0) };
    s5.min_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.auto(), height: sty.LengthPercentageAuto.length(25.0) };
    s5.max_size = geo.Size(sty.LengthPercentageAuto) { width: sty.LengthPercentageAuto.auto(), height: sty.LengthPercentageAuto.length(20.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    t.add_child(parent: n0, child: n5);
