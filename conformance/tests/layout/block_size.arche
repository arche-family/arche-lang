    case_s7(&mut sys.stdout, a);
    case_s8(&mut sys.stdout, a);
    case_s9(&mut sys.stdout, a);
    case_s10(&mut sys.stdout, a);
    case_s11(&mut sys.stdout, a);
    case_s12(&mut sys.stdout, a);
}
