// Sizes: min and max sizes of items and containers, percentages and
// calc() against definite and indefinite containers, aspect ratios, the
// sizing keywords (min-content, max-content, fit-content, stretch) as
// sizes and as flex-basis, and size-only runs in one axis or both.
// The expected lines are taffy 0.15's own, from the same cases in Rust
// (/tmp/layout-port/oracle-flex).
import std;
import _tree_flex;

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    _tree_flex.run(&mut sys.stdout, name: "S1", spec: "(flex w=300 h=100 (leaf w=50% h=50%) (leaf w=calc(10+20%) h=calc(-5+50%)))", a);
    _tree_flex.run(&mut sys.stdout, name: "S2", spec: "(flex h=100 (leaf w=50% h=50% fixed=20,20) (leaf w=100))", a);
    _tree_flex.run(&mut sys.stdout, name: "S3", spec: "(flex w=300 h=200 p=5% (leaf w=10% p=10% m=5%) (leaf grow=1 b=2%))", a);
    _tree_flex.run(&mut sys.stdout, name: "S4", spec: "(flex w=300 h=100 (leaf minw=120 grow=1) (leaf maxw=40 grow=1) (leaf grow=1))", a);
    _tree_flex.run(&mut sys.stdout, name: "S5", spec: "(flex w=300 h=100 minh=150 (leaf w=50))", a);
    _tree_flex.run(&mut sys.stdout, name: "S6", spec: "(flex w=300 h=300 maxh=100 (leaf w=50 h=200))", a);
