/// Case N8: a size-only run that places floats, then the full layout
fn case_n8(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(250.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.float = sty.Float.Left;
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(60.0), height: sty.Dimension.length(40.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
