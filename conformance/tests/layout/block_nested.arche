// Block layout in depth: nested containers with fractional percentages,
// padding and borders (every f32 operation in taffy's order, then rounded),
// floats placed by the subtree of an in-flow child (its block context's
// offset and insets, the root's height, later siblings avoiding them),
// right to left nesting, laying the same tree out again (the cache), signed
// zeros, and position: sticky (no offset in block layout). The expected
// lines are taffy 0.15's own, from the same trees in Rust.
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import layout.tree as lt;
import _tree_block;

/// Case N1: four levels of fractional percentages, rounded
fn case_n1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(0.5), right: sty.LengthPercentage.length(0.5), top: sty.LengthPercentage.length(0.5), bottom: sty.LengthPercentage.length(0.5) };
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(333.3), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(1.5), right: sty.LengthPercentage.length(0.5), top: sty.LengthPercentage.length(0.25), bottom: sty.LengthPercentage.length(0.75) };
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.percent(0.777), height: sty.Dimension.auto() };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.percent(0.025), right: sty.LengthPercentageAuto.percent(0.015), top: sty.LengthPercentageAuto.length(1.1), bottom: sty.LengthPercentageAuto.length(0.9) };
    s2.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(1.3), right: sty.LengthPercentage.length(2.7), top: sty.LengthPercentage.length(0.4), bottom: sty.LengthPercentage.length(0.2) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.percent(0.033), right: sty.LengthPercentage.percent(0.033), top: sty.LengthPercentage.percent(0.033), bottom: sty.LengthPercentage.percent(0.033) };
    s3.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(0.6), right: sty.LengthPercentage.length(0.6), top: sty.LengthPercentage.length(0.6), bottom: sty.LengthPercentage.length(0.6) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.7), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(0.35), bottom: sty.LengthPercentageAuto.length(0.15) };
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.percent(0.333), height: sty.Dimension.length(10.1) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(3.33), bottom: sty.LengthPercentageAuto.length(0.0) };
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(7.77) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    t.add_child(parent: n3, child: n4);
    t.add_child(parent: n2, child: n3);
    t.add_child(parent: n1, child: n2);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n5);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "N1");
    compute.round_layout(&mut t, n0);
    _tree_block.show_final(out, &t, "N1");
}

/// Case N2: floats in nested blocks, their offsets and insets
fn case_n2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(300.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.auto(), height: sty.Dimension.length(15.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(10.0), right: sty.LengthPercentageAuto.length(20.0), top: sty.LengthPercentageAuto.length(6.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s2.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(4.0), right: sty.LengthPercentage.length(4.0), top: sty.LengthPercentage.length(4.0), bottom: sty.LengthPercentage.length(4.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(5.0), right: sty.LengthPercentage.length(7.0), top: sty.LengthPercentage.length(2.0), bottom: sty.LengthPercentage.length(0.0) };
    s3.border = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(1.0), right: sty.LengthPercentage.length(1.0), top: sty.LengthPercentage.length(1.0), bottom: sty.LengthPercentage.length(1.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.float = sty.Float.Left;
    s4.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(3.0), right: sty.LengthPercentageAuto.length(3.0), top: sty.LengthPercentageAuto.length(3.0), bottom: sty.LengthPercentageAuto.length(3.0) };
