    var s3 = _tree_block.blk(a);
    s3.display = sty.Display.FlowRoot;
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(200.0), height: sty.Dimension.length(10.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    let o_n8 = t.compute_child_layout(n0, _tree_block.layout_input(lt.RunMode.ComputeSize, lt.SizingMode.InherentSize, known: geo.Size(?f32) { width: some(250.0), height: none }, parent: geo.Size(?f32) { width: some(800.0), height: some(600.0) }, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) }, lt.RequestedAxis.Both, geo.Line(bool) { start: false, end: false }));
    _tree_block.show_output(out, "N8", &o_n8);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "N8b");
}

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    case_n1(&mut sys.stdout, a);
    case_n2(&mut sys.stdout, a);
    case_n3(&mut sys.stdout, a);
    case_n4(&mut sys.stdout, a);
    case_n5(&mut sys.stdout, a);
    case_n6(&mut sys.stdout, a);
    case_n7(&mut sys.stdout, a);
    case_n8(&mut sys.stdout, a);
}
