    _tree_grid.run(&mut sys.stdout, name: "G117", spec: "avail=800,600 (grid cols=100,[hd-start.x],25%,[a],minmax(min-content,calc(-5+25%)),[],1.5fr acols=minmax(25,min-content),1fr,0.5fr arows=25 gap=0 w=40 h=10 minh=33.3 p=calc(1+2%) oy=hidden (grid rows=25%,minmax(10,10),repeat(auto-fill,20),repeat(2,50%) gap=100%,calc(10+10%) ac=flex-start h=33.3 minw=0 col=hd-start:1/-3 row=a:1/4 (grid cols=[],33%,[hd-start.main-end],50,[hd-start],2fr acols=20,calc(0+50%) gap=75.75 ai=baseline m=3 as=unsafe-start (leaf h=10% row=5/hd-start:3) (leaf h=12.5 minw=40 minh=5 b=2 ox=clip row=auto/auto text=40,12.5)) (leaf as=center text=120,12.5) (leaf w=max-content oy=hidden pos=absolute ib=5 display=none fixed=10,35) (leaf w=fit-content minw=50% m=-5,5%,auto,0 ox=scroll as=baseline text=40,12.5)) (leaf p=calc(1+2%)) (leaf maxw=40 js=stretch fixed=10,15) (grid cols=minmax(min-content,fit-content(calc(5+10%))),75.5 rows=[hd-start.x],30,[main-start],repeat(auto-fill,[side.main-end],50,[],50,[x]),[side],minmax(25,30) acols=minmax(auto,2fr),fit-content(50%) arows=minmax(10%,100%),fit-content(calc(10+20%)) flow=row-dense areas=2,3,main:1:3:1:4 ac=flex-start jc=flex-start row=2/auto (leaf h=100% row=auto/-1 as=flex-start pos=absolute il=calc(10+10%) it=calc(0+50%) fixed=5,35) (leaf w=10 oy=clip js=end text=40,12.5) (leaf w=100% col=-3/auto display=none text=400,10) (leaf js=self-end text=400,12.5)) (leaf m=auto fixed=20,15))", a);
    _tree_grid.run(&mut sys.stdout, name: "G118", spec: "avail=300,200 mode=sizew (grid cols=calc(10+10%),[hd-end],repeat(auto-fit,[],30,[y]),[] rows=calc(0+50%),fit-content(30),1.5fr,fit-content(30) acols=0.5fr,1.5fr,min-content flow=column-dense ac=center minh=12.5 ar=1.5 p=calc(1+2%) (leaf minw=auto p=3 b=1 text=250,10) (leaf b=1.5,2.5,3,4 sw=10 text=40,10))", a);
    _tree_grid.run(&mut sys.stdout, name: "G119", spec: "avail=123.5,77 (grid rows=100,[main-end],1.5fr,100 flow=row gap=10%,40 ac=normal maxh=20 m=0,5,5,0 p=2,4,6,8 (grid cols=25,33%,60 rows=repeat(auto-fill,minmax(10,40)),25,max-content arows=fit-content(50%),auto,100 flow=column areas=2,3,ft:1:3:2:4,main:1:2:3:4,hd:1:2:1:3 p=2,4,6,8 ox=clip col=main-end:2/auto (leaf w=100 ar=1 p=calc(1+2%) b=2) (leaf w=min-content h=12.5 ox=clip col=span-3/auto row=3/span-2 fixed=10,10) (leaf h=20 ar=1.5 b=1.5,2.5,3,4 oy=scroll col=hd-start:1/auto row=auto/ft-start:0 text=40,12.5) (leaf row=-5/-2)) (grid ai=baseline ac=normal jc=space-between w=stretch minh=auto maxh=5 m=0,5%,0,auto ox=clip sw=10 col=hd-start:2/3 row=main-end:1/auto (leaf creplaced=1) (leaf h=40 box=content col=span-1/b:0 js=baseline fixed=10,35) (leaf as=self-end fixed=40,20) (leaf m=auto b=1.5,2.5,3,4 text=75,12.5)) (grid cols=60 acols=minmax(25%,3fr) flow=column ai=flex-start ji=normal h=fit-content js=flex-end (leaf sw=15 col=auto/span-2 row=0/auto fixed=10,15)) (leaf h=5 ar=2 ox=scroll col=-5/-5 text=40,10) (leaf w=fit-content col=span-b:3/span-3 row=span-2/main-end:1 text=400,10) (leaf h=75.75 contain=paint fixed=25,30))", a);
