// stdout: B30.1 at 0.0 0.0 size 60.0 100.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 60.0 0.0 10.0 | sb 0.0 0.0 | order 0
