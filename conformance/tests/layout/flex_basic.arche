// stdout: B30.3 at 100.0 0.0 size 40.0 100.0 | pad 0.0 0.0 0.0 0.0 | border 0.0 0.0 0.0 0.0 | margin 0.0 0.0 0.0 0.0 | over 0.0 60.0 0.0 10.0 | sb 0.0 0.0 | order 2
// Flexbox basics: rows and columns and their reverses, flex-grow,
// flex-shrink and flex-basis, gaps, padding and border with both
// box-sizings, display: none children, nested containers, and rounding.
// The expected lines are taffy 0.15's own, from the same cases in Rust
// (/tmp/layout-port/oracle-flex).
import std;
import _tree_flex;

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    _tree_flex.run(&mut sys.stdout, name: "B1", spec: "(flex w=300 h=100 (leaf fixed=50,20) (leaf fixed=30,10 grow=1))", a);
    _tree_flex.run(&mut sys.stdout, name: "B2", spec: "(flex dir=column w=200 h=300 (leaf fixed=50,20) (leaf fixed=30,10 grow=1) (leaf h=40))", a);
    _tree_flex.run(&mut sys.stdout, name: "B3", spec: "(flex dir=row-reverse w=300 h=100 (leaf w=50) (leaf w=60) (leaf w=70))", a);
    _tree_flex.run(&mut sys.stdout, name: "B4", spec: "(flex dir=column-reverse w=100 h=300 (leaf h=50) (leaf h=60) (leaf h=70))", a);
    _tree_flex.run(&mut sys.stdout, name: "B5", spec: "(flex w=400 h=100 (leaf grow=1) (leaf grow=2) (leaf grow=3))", a);
    _tree_flex.run(&mut sys.stdout, name: "B6", spec: "(flex w=400 h=100 (leaf basis=100 grow=1) (leaf basis=50 grow=3) (leaf w=80))", a);
    _tree_flex.run(&mut sys.stdout, name: "B7", spec: "(flex w=200 h=100 (leaf w=150) (leaf w=150 shrink=2) (leaf w=100 shrink=0))", a);
    _tree_flex.run(&mut sys.stdout, name: "B8", spec: "(flex w=200 h=100 (leaf basis=150 p=10) (leaf basis=150 b=5) (leaf basis=0 p=20))", a);
    _tree_flex.run(&mut sys.stdout, name: "B9", spec: "(flex w=333 h=100 gap=7 (leaf grow=1) (leaf grow=1) (leaf grow=1))", a);
    _tree_flex.run(&mut sys.stdout, name: "B10", spec: "(flex dir=column w=100 h=333 gap=11 (leaf grow=1) (leaf grow=2) (leaf fixed=10,10))", a);
    _tree_flex.run(&mut sys.stdout, name: "B11", spec: "(flex w=300 h=200 p=10 b=3 (leaf grow=1 p=5) (leaf w=100 b=2,4,6,8))", a);
    _tree_flex.run(&mut sys.stdout, name: "B12", spec: "(flex w=300 h=200 p=10 b=3 box=content (leaf grow=1 p=5 box=content) (leaf w=100 b=2,4,6,8 box=content))", a);
    _tree_flex.run(&mut sys.stdout, name: "B13", spec: "(flex w=300 h=100 (leaf w=50) (leaf w=60 display=none) (leaf w=70))", a);
    _tree_flex.run(&mut sys.stdout, name: "B14", spec: "(flex w=300 h=100 display=none (leaf w=50) (leaf w=60))", a);
    _tree_flex.run(&mut sys.stdout, name: "B15", spec: "(flex w=500 h=300 p=10 (flex dir=column grow=1 p=5 (leaf fixed=40,40) (leaf text=200,20)) (flex w=150 (leaf grow=1) (leaf text=90,10)))", a);
    _tree_flex.run(&mut sys.stdout, name: "B16", spec: "(flex (leaf fixed=50,20) (leaf fixed=30,40))", a);
    _tree_flex.run(&mut sys.stdout, name: "B17", spec: "(flex dir=column (leaf fixed=50,20) (leaf fixed=30,40))", a);
    _tree_flex.run(&mut sys.stdout, name: "B18", spec: "(flex w=100 (leaf text=300,10) (leaf text=50,10))", a);
    _tree_flex.run(&mut sys.stdout, name: "B19", spec: "(flex dir=column w=100 (leaf text=300,10) (leaf text=50,10))", a);
    _tree_flex.run(&mut sys.stdout, name: "B20", spec: "round (flex w=301.7 h=100.3 p=1.3 (leaf grow=1) (leaf grow=1) (leaf grow=1.5))", a);
    _tree_flex.run(&mut sys.stdout, name: "B21", spec: "(flex w=300 h=100 (leaf basis=50% grow=1) (leaf basis=25%) (leaf basis=calc(10+20%)))", a);
    _tree_flex.run(&mut sys.stdout, name: "B22", spec: "(flex w=250 h=100 (leaf grow=0.3) (leaf grow=0.2))", a);
    _tree_flex.run(&mut sys.stdout, name: "B23", spec: "(flex w=100 h=100 (leaf basis=100 shrink=0.3) (leaf basis=100 shrink=0.2))", a);
    _tree_flex.run(&mut sys.stdout, name: "B24", spec: "(flex w=100 h=100 (leaf basis=80 shrink=1 minw=70) (leaf basis=80 shrink=1) (leaf basis=80 shrink=3 maxw=10))", a);
    _tree_flex.run(&mut sys.stdout, name: "B25", spec: "(flex w=600 h=100 (leaf basis=100 grow=1 maxw=150) (leaf basis=100 grow=1) (leaf basis=100 grow=1 minw=300))", a);
    _tree_flex.run(&mut sys.stdout, name: "B26", spec: "avail=max,max (flex (leaf grow=1 fixed=20,20) (leaf basis=40 fixed=10,10) (leaf text=70,10))", a);
    _tree_flex.run(&mut sys.stdout, name: "B27", spec: "avail=min,min (flex (leaf grow=1 fixed=20,20) (leaf basis=40 fixed=10,10) (leaf text=70,10))", a);
    _tree_flex.run(&mut sys.stdout, name: "B28", spec: "(flex dir=column h=200 (leaf text=150,10) (leaf grow=1 text=40,10))", a);
    _tree_flex.run(&mut sys.stdout, name: "B29", spec: "(flex w=400 h=200 (flex grow=1 dir=column (flex grow=1 (leaf grow=1) (leaf grow=2 fixed=10,30))) (leaf w=100))", a);
    _tree_flex.run(&mut sys.stdout, name: "B30", spec: "(flex w=300 h=100 (leaf basis=content fixed=60,10) (leaf basis=auto w=40 fixed=60,10) (leaf basis=10 w=40 fixed=60,10))", a);
}
