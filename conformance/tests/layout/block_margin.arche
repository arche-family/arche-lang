// Block layout's horizontal placement: auto margins, legacy text-align,
// justify-items and justify-self (safe too), right-to-left containers,
// relative insets and negative margins. The expected lines are taffy
// 0.15's own, from the same trees in Rust.
import std;
import alloc;
import layout.compute as compute;
import layout.geometry as geo;
import layout.style as sty;
import _tree_block;

/// Case M1: auto margins centre and push a fixed-width child
fn case_m1(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(10.0), right: sty.LengthPercentage.length(10.0), top: sty.LengthPercentage.length(10.0), bottom: sty.LengthPercentage.length(10.0) };
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(0.0), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.auto(), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s4.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(500.0), height: sty.Dimension.length(10.0) };
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.length(30.0), top: sty.LengthPercentageAuto.auto(), bottom: sty.LengthPercentageAuto.length(0.0) };
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n0, child: n2);
    t.add_child(parent: n0, child: n3);
    t.add_child(parent: n0, child: n4);
    t.add_child(parent: n0, child: n5);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "M1");
}

/// Case M2: legacy text-align left, right and centre
fn case_m2(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.text_align = sty.TextAlign.LegacyCenter;
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(10.0), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.text_align = sty.TextAlign.LegacyRight;
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
    var s6 = _tree_block.blk(a);
    s6.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s6.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n6 = t.add(s6, _tree_block.Content.Empty);
    var s7 = _tree_block.blk(a);
    s7.text_align = sty.TextAlign.LegacyLeft;
    let n7 = t.add(s7, _tree_block.Content.Empty);
    var s8 = _tree_block.blk(a);
    s8.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n8 = t.add(s8, _tree_block.Content.Empty);
    t.add_child(parent: n1, child: n2);
    t.add_child(parent: n1, child: n3);
    t.add_child(parent: n0, child: n1);
    t.add_child(parent: n4, child: n5);
    t.add_child(parent: n4, child: n6);
    t.add_child(parent: n0, child: n4);
    t.add_child(parent: n7, child: n8);
    t.add_child(parent: n0, child: n7);
    compute.compute_root_layout(&mut t, n0, geo.Size(sty.AvailableSpace) { width: sty.AvailableSpace.definite(800.0), height: sty.AvailableSpace.definite(600.0) });
    _tree_block.show_nodes(out, &t, "M2");
}

/// Case M3: right to left
fn case_m3(out: &mut std.Output, a: alloc.Allocator) {
    var t = _tree_block.TestTree.init(a);
    var s0 = _tree_block.blk(a);
    s0.direction = sty.Direction.Rtl;
    s0.padding = geo.Rect(sty.LengthPercentage) { left: sty.LengthPercentage.length(5.0), right: sty.LengthPercentage.length(15.0), top: sty.LengthPercentage.length(0.0), bottom: sty.LengthPercentage.length(0.0) };
    s0.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(400.0), height: sty.Dimension.auto() };
    let n0 = t.add(s0, _tree_block.Content.Empty);
    var s1 = _tree_block.blk(a);
    s1.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n1 = t.add(s1, _tree_block.Content.Empty);
    var s2 = _tree_block.blk(a);
    s2.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.length(10.0), right: sty.LengthPercentageAuto.length(20.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s2.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n2 = t.add(s2, _tree_block.Content.Empty);
    var s3 = _tree_block.blk(a);
    s3.margin = geo.Rect(sty.LengthPercentageAuto) { left: sty.LengthPercentageAuto.auto(), right: sty.LengthPercentageAuto.length(0.0), top: sty.LengthPercentageAuto.length(0.0), bottom: sty.LengthPercentageAuto.length(0.0) };
    s3.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(100.0), height: sty.Dimension.length(10.0) };
    let n3 = t.add(s3, _tree_block.Content.Empty);
    var s4 = _tree_block.blk(a);
    s4.text_align = sty.TextAlign.LegacyLeft;
    let n4 = t.add(s4, _tree_block.Content.Empty);
    var s5 = _tree_block.blk(a);
    s5.size = geo.Size(sty.Dimension) { width: sty.Dimension.length(50.0), height: sty.Dimension.length(10.0) };
    let n5 = t.add(s5, _tree_block.Content.Empty);
