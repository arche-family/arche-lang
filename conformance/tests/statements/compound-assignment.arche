// test: run
// spec: 8
// stdout: 2 39 156
import std;

fn main(sys: &mut std.System) -> !void {

    var a: u32 = 10;
    a += 5;
    a -= 3;
    a *= 2;
    a /= 4;
    a %= 4;
    sys.stdout.write_u64(a as u64);
    sys.stdout.write(" ");
    var b: u8 = 0xF0;
    b &= 0x3C;
    b |= 0x01;
    b ^= 0xFF;
    b <<= 1;
    b >>= 2;
    sys.stdout.write_u64(b as u64);
    sys.stdout.write(" ");
    var c: u8 = 250;
    c +%= 10;
    c -%= 5;
    c *%= 100;
    sys.stdout.write_u64(c as u64);
    sys.stdout.write("\n");
}
