// test: run
// spec: 8
// stdout: 6 4
import std;

fn main(sys: &mut std.System) -> !void {

    var i: u32 = 0;
    var seen: u32 = 0;
    while i < 6 : (i += 1) {
        if i % 3 == 0 {
            continue;
        }
        seen += 1;
    }
    sys.stdout.write_u64(i as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(seen as u64);
    sys.stdout.write("\n");
}
