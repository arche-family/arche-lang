// test: run
// spec: 8
// stdout: x;;x;;
import std;

fn main(sys: &mut std.System) -> !void {

    var i: u32 = 0;
    while i < 4 : (i += 1) {
        defer sys.stdout.write(";");
        if i == 1 {
            continue;
        }
        if i == 3 {
            break;
        }
        sys.stdout.write("x");
    }
    sys.stdout.write("\n");
}
