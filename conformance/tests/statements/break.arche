// test: run
// spec: 8
// stdout: 3 6
import std;

fn main(sys: &mut std.System) -> !void {

    var outer: u32 = 0;
    var total: u32 = 0;
    while outer < 3 : (outer += 1) {
        var inner: u32 = 0;
        while true : (inner += 1) {
            if inner == 2 {
                break;
            }
            total += 1;
        }
    }
    sys.stdout.write_u64(outer as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(total as u64);
    sys.stdout.write("\n");
}
