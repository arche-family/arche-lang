// test: run
// spec: 8
// stdout: negative zero small large 
import std;

fn describe(out: &mut std.Output, n: i32) {
    if n < 0 {
        out.write("negative ");
    } else if n == 0 {
        out.write("zero ");
    } else if n < 10 {
        out.write("small ");
    } else {
        out.write("large ");
    }
}

fn main(sys: &mut std.System) -> !void {
    describe(&mut sys.stdout, -3);
    describe(&mut sys.stdout, 0);
    describe(&mut sys.stdout, 5);
    describe(&mut sys.stdout, 50);
    if false {
        sys.stdout.write("never");
    }
    sys.stdout.write("\n");
}
