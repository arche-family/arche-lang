// test: run
// spec: 8
// stdout: 55 0
import std;

fn main(sys: &mut std.System) -> !void {

    var sum: u32 = 0;
    var i: u32 = 1;
    while i <= 10 : (i += 1) {
        sum += i;
    }
    var j: u32 = 3;
    while j > 0 {
        j -= 1;
    }
    sys.stdout.write_u64(sum as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(j as u64);
    sys.stdout.write("\n");
}
