// test: run
// spec: 8
// stdout: main ddd
import std;

fn main(sys: &mut std.System) -> !void {

    defer {
        var i: u32 = 0;
        while true : (i += 1) {
            if i == 3 {
                break;
            }
            sys.stdout.write("d");
        }
        sys.stdout.write("\n");
    }
    sys.stdout.write("main ");
}
