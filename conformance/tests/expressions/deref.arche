// test: run
// spec: 7.6
// stdout: 42
import std;

fn bump(x: &mut u32) {
    x.* += 1;
    x.* = x.* * 2;
}

fn get(x: &u32) -> u32 {
    return x.*;
}

fn main(sys: &mut std.System) -> !void {
    var n: u32 = 20;
    bump(&mut n);
    sys.stdout.write_u64(get(&n) as u64);
    sys.stdout.write("\n");
}
