// test: run
// spec: 7.3
// stdout: LR RL 12 1
import std;

fn left(out: &mut std.Output) -> u32 {
    out.write("L");
    return 1;
}

fn right(out: &mut std.Output) -> u32 {
    out.write("R");
    return 2;
}

fn pair(a: u32, b: u32) -> u32 {
    return a * 10 + b;
}

fn main(sys: &mut std.System) -> !void {
    let v: u32 = pair(a: left(&mut sys.stdout), b: right(&mut sys.stdout));
    sys.stdout.write(" ");
    let w: u32 = right(&mut sys.stdout) - left(&mut sys.stdout);
    sys.stdout.write(" ");
    sys.stdout.write_u64(v as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(w as u64);
    sys.stdout.write("\n");
}
