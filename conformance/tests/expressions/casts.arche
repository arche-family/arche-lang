// test: run
// spec: 7.2
// stdout: -1 255 44 -56 200 200 300
import std;

fn main(sys: &mut std.System) -> !void {

    let m: i32 = -1;
    let big: u64 = 300;
    let small: u8 = 200;
    sys.stdout.write_i64(m as i64);
    sys.stdout.write(" ");
    sys.stdout.write_u64((m as% u8) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64((big as% u8) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_i64((small as% i8) as i64);
    sys.stdout.write(" ");
    sys.stdout.write_u64((small as u16) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_i64((small as i64));
    sys.stdout.write(" ");
    sys.stdout.write_u64((big as u16) as u64);
    sys.stdout.write("\n");
}
