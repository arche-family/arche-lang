// test: run
// spec: 7.2
// stdout: 8 8 -4 1 240 -128
import std;

fn main(sys: &mut std.System) -> !void {

    let one: u32 = 1;
    let n: u8 = 3;
    sys.stdout.write_u64((one << 3) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64((one << n) as u64);
    sys.stdout.write(" ");
    let neg: i32 = -8;
    sys.stdout.write_i64((neg >> 1) as i64);
    sys.stdout.write(" ");
    let high: u8 = 0x80;
    sys.stdout.write_u64((high >> 7) as u64);
    sys.stdout.write(" ");
    let ff: u8 = 0xFF;
    sys.stdout.write_u64((ff << 4) as u64);
    sys.stdout.write(" ");
    let small: i8 = 1;
    sys.stdout.write_i64((small << 7) as i64);
    sys.stdout.write("\n");
}
