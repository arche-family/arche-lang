// test: run
// spec: 7.1
// stdout: 255 -6 6 8 15
import std;

fn main(sys: &mut std.System) -> !void {

    let z: u8 = 0;
    let five: i32 = 5;
    let a: u32 = 0b1100;
    sys.stdout.write_u64((~z) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_i64((~five) as i64);
    sys.stdout.write(" ");
    sys.stdout.write_u64((a ^ 0b1010) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64((a & 0b1010) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64((a | 0b0011) as u64);
    sys.stdout.write("\n");
}
