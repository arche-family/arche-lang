// test: run
// spec: 7.1
// stdout: or side and side not
import std;

fn side(out: &mut std.Output, v: bool) -> bool {
    out.write("side ");
    return v;
}

fn main(sys: &mut std.System) -> !void {
    if false and side(&mut sys.stdout, true) {
        sys.stdout.write("no ");
    }
    if true or side(&mut sys.stdout, true) {
        sys.stdout.write("or ");
    }
    if true and side(&mut sys.stdout, true) {
        sys.stdout.write("and ");
    }
    if not side(&mut sys.stdout, false) {
        sys.stdout.write("not");
    }
    sys.stdout.write("\n");
}
