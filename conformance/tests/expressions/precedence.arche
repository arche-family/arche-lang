// test: run
// spec: 7.1
// stdout: 7 9 3 2 8 2 bitwise-before-comparison
import std;

fn main(sys: &mut std.System) -> !void {

    let a: u32 = 1 + 2 * 3;
    let b: u32 = (1 + 2) * 3;
    let c: u32 = 10 - 4 - 3;
    let d: u32 = 2 * 3 % 4;
    let e: u32 = 1 << 2 + 1;
    let f: u32 = 0x12 & 0xF0 >> 4;
    let x: u32 = 6;
    sys.stdout.write_u64(a as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(b as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(c as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(d as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(e as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(f as u64);
    if x & 3 == 2 and not (x | 1 == 6) {
        sys.stdout.write(" bitwise-before-comparison");
    }
    sys.stdout.write("\n");
}
