// test: run
// spec: 7.2
// stdout: -3 -1 -3 1 3 2
import std;

fn main(sys: &mut std.System) -> !void {

    let a: i32 = -7;
    let b: i32 = 2;
    sys.stdout.write_i64((a / b) as i64);
    sys.stdout.write(" ");
    sys.stdout.write_i64((a % b) as i64);
    sys.stdout.write(" ");
    sys.stdout.write_i64((7 / -b) as i64);
    sys.stdout.write(" ");
    sys.stdout.write_i64((7 % -b) as i64);
    sys.stdout.write(" ");
    let u: u32 = 17;
    sys.stdout.write_u64((u / 5) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64((u % 5) as u64);
    sys.stdout.write("\n");
}
