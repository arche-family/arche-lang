// test: run
// spec: 11
// stdout: 5 ok ok
import std;

fn main(sys: &mut std.System) -> !void {

    let s: str = "hello";
    sys.stdout.write_u64(s.len() as u64);
    if s.eq("hello") and not s.eq("hell") and s.starts_with("he") and s.starts_with("") {
        sys.stdout.write(" ok");
    }
    if not s.starts_with("hello!") and "".eq("") {
        sys.stdout.write(" ok");
    }
    sys.stdout.write("\n");
}
