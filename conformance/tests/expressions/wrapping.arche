// test: run
// spec: 7.2
// stdout: 4 254 144 -128 127 0 0
import std;

fn main(sys: &mut std.System) -> !void {

    let a: u8 = 250;
    let b: u8 = 3;
    let c: u8 = 200;
    sys.stdout.write_u64((a +% 10) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64((b -% 5) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64((c *% 2) as u64);
    sys.stdout.write(" ");
    let m: i8 = 127;
    let n: i8 = -128;
    let q: i8 = 64;
    sys.stdout.write_i64((m +% 1) as i64);
    sys.stdout.write(" ");
    sys.stdout.write_i64((n -% 1) as i64);
    sys.stdout.write(" ");
    sys.stdout.write_i64((q *% 4) as i64);
    sys.stdout.write(" ");
    let top: u64 = 18446744073709551615;
    sys.stdout.write_u64(top +% 1);
    sys.stdout.write("\n");
}
