// test: run
// spec: 7.1
// stdout: 110111101
import std;

fn yes(out: &mut std.Output, v: bool) {
    if v {
        out.write("1");
    } else {
        out.write("0");
    }
}

fn main(sys: &mut std.System) -> !void {
    let a: i32 = -1;
    let b: i32 = 1;
    let u: u64 = 18446744073709551615;
    yes(&mut sys.stdout, a < b);
    yes(&mut sys.stdout, a <= a);
    yes(&mut sys.stdout, a > b);
    yes(&mut sys.stdout, b >= a);
    yes(&mut sys.stdout, a == -1);
    yes(&mut sys.stdout, a != b);
    yes(&mut sys.stdout, u > 0);
    yes(&mut sys.stdout, true == false);
    yes(&mut sys.stdout, true != false);
    sys.stdout.write("\n");
}
