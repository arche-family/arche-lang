import std;

type Color = enum { Red, Green, Blue }

fn name(c: Color) -> str {
    match c {
        .Red => { return "red"; }
        .Green => { return "green"; }
    }
    return "?";
}

fn main(sys: &mut std.System) -> !void {
    sys.stdout.write(name(Color.Blue));
}
