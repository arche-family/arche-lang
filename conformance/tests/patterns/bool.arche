// test: run
// spec: 9
// stdout: yes no 
import std;

fn main(sys: &mut std.System) -> !void {

    let flags: [2]bool = [true, false];
    var i: usize = 0;
    while i < 2 : (i += 1) {
        match flags[i] {
            true => { sys.stdout.write("yes "); }
            false => { sys.stdout.write("no "); }
        }
    }
    sys.stdout.write("\n");
}
