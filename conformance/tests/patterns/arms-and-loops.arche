// test: run
// spec: 9
// stdout: 0..2.3..
import std;

fn main(sys: &mut std.System) -> !void {

    var i: u32 = 0;
    while i < 6 : (i += 1) {
        defer sys.stdout.write(".");
        match i {
            1 => { continue; }
            4 => { break; }
            n => {
                sys.stdout.write_u64(n as u64);
            }
        }
    }
    sys.stdout.write("\n");
}
