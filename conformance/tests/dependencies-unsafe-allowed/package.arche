// A dependency that has unsafe code, which this package allows by its name.
import std.build;

const PACKAGE: build.Package = build.Package {
    name: "dependencies_unsafe_allowed",
    version: "1.0.0",
    edition: 2026,
    needs: [],
    dependencies: [build.dep("rawbits", "1.0.0")],
    allow_unsafe: ["rawbits"],
};
