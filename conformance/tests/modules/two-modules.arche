// test: run
// spec: 3
// stdout: 11 green 11
import std;
import _support.shapes;

fn main(sys: &mut std.System) -> !void {
    let p = shapes.Point.at(x: 1, y: 2).moved(10);
    sys.stdout.write_i64(p.x as i64);
    sys.stdout.write(" ");
    sys.stdout.write(shapes.name(shapes.Color.Green));
    sys.stdout.write(" ");
    sys.stdout.write_u64((shapes.SIDES + shapes.secret()) as u64);
    sys.stdout.write("\n");
}
