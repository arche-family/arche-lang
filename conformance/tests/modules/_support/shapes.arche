import std;

pub const SIDES: u32 = 4;
const SECRET: u32 = 7;

pub type Point = struct {
    pub x: i32,
    pub y: i32,
    hidden: u8,

    pub fn at(x: i32, y: i32) -> Point {
        return Point { x: x, y: y, hidden: 0 };
    }

    pub fn moved(self: Point, dx: i32) -> Point {
        return Point { x: self.x + dx, y: self.y, hidden: self.hidden };
    }
}

pub type Color = enum { Red, Green }

pub fn name(c: Color) -> str {
    match c {
        .Red => { return "red"; }
        .Green => { return "green"; }
    }
}

fn private_helper() -> u32 {
    return SECRET;
}

pub fn secret() -> u32 {
    return private_helper();
}
