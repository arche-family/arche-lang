// test: run
// spec: arche/8.1
// stage0: skip
// exit: 101
// stderr: panic: contract failed: n % 2 == 0
// stderr:   at requires-fails.arche:10:
import std;

fn half(n: u32) -> u32
    requires n % 2 == 0
{
    return n / 2;
}

fn main(sys: &mut std.System) -> !void {
    sys.stdout.write_u64(half(7) as u64);
}
