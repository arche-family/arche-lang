import std;
import alloc;

fn wrap(a: alloc.Allocator) -> alloc.String {
    return alloc.String.init(a);
}

fn main(sys: &mut std.System) -> !void {
    var keep = alloc.String.init(sys.alloc);
    region r {
        keep = wrap(r);
    }
}
