// test: run
// spec: arche/5.1
// stage0: skip
// stdout: 16 18 18
import std;

type Shape = interface {
    fn area(self: &Self) -> u64;
    fn grow(self: &mut Self, by: u64);
}

type Square = struct { side: u64 }

type Rect = struct {
    w: u64,
    h: u64,

    fn perimeter(self: &Rect) -> u64 {
        return 2 * (self.w + self.h);
    }
}

impl Shape for Square {
    fn area(self: &Square) -> u64 {
        return self.side * self.side;
    }
    fn grow(self: &mut Square, by: u64) {
        self.side += by;
    }
}

// Self in an impl is its type.
impl Shape for Rect {
    fn area(self: &Self) -> u64 {
        return self.w * self.h;
    }
    fn grow(self: &mut Self, by: u64) {
        self.w += by;
        self.h += by;
    }
}

fn main(sys: &mut std.System) -> !void {
    var s = Square { side: 3 };
    s.grow(1);
    sys.stdout.write_u64(s.area());
    sys.stdout.write(" ");
    var r = Rect { w: 2, h: 5 };
    r.grow(by: 1);
    sys.stdout.write_u64(r.area());
    sys.stdout.write(" ");
    sys.stdout.write_u64(r.perimeter());
    sys.stdout.write("\n");
}
