// test: run
// spec: arche/2.2
// stage0: skip
// stdout: 9223372036854775808 12157665459056928801 overflow 12 16 9 1.4142135623730951 1.5 5.551115123125783e-17 -3.0 -2.0 0.0
import std;
import core;
import core.math;

fn main(sys: &mut std.System) -> !void {
    sys.stdout.write_u64(math.abs(-9223372036854775807 - 1));
    sys.stdout.write(" ");
    sys.stdout.write_u64(core.or_else(u64, math.pow(3, exp: 40), fallback: 0));
    sys.stdout.write(" ");
    match math.pow(3, exp: 41) {
        some(_) => { sys.stdout.write("fits"); }
        none => { sys.stdout.write("overflow"); }
    }
    sys.stdout.write(" ");
    sys.stdout.write_u64(math.gcd(a: 84, b: 36));
    sys.stdout.write(" ");
    sys.stdout.write_u64(core.or_else(u64, math.align_up(x: 13, align: 8), fallback: 0));
    sys.stdout.write(" ");
    sys.stdout.write_u64(core.or_else(u32, math.log2(1000), fallback: 99) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_f64(math.sqrt(2.0));
    sys.stdout.write(" ");
    sys.stdout.write_f64(math.rem(a: 7.5, b: 2.0));
    sys.stdout.write(" ");
    sys.stdout.write_f64(math.fma(a: 0.1, b: 10.0, c: -1.0));
    sys.stdout.write(" ");
    sys.stdout.write_f64(math.floor(-2.5));
    sys.stdout.write(" ");
    sys.stdout.write_f64(math.ceil(-2.5));
    sys.stdout.write(" ");
    sys.stdout.write_f64(math.fabs(-0.0));
    sys.stdout.write("\n");
}
