// test: run
// spec: 4
// stdout: 42
import std;

type Index = u32;
type Pair = struct { a: Index, b: u32 }
type Count = Index;

fn twice(n: u32) -> Count {
    return n * 2;
}

fn main(sys: &mut std.System) -> !void {
    let i: Index = 21;
    let p = Pair { a: i, b: twice(i) };
    sys.stdout.write_u64(p.b as u64);
    sys.stdout.write("\n");
}
