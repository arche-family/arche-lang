// test: run
// spec: 5.6
// stdout: -128 -9223372036854775808 -5
import std;

fn main(sys: &mut std.System) -> !void {

    let a: i8 = -128;
    let b: i64 = -9223372036854775808;
    let c: i32 = -(5);
    sys.stdout.write_i64(a as i64);
    sys.stdout.write(" ");
    sys.stdout.write_i64(b);
    sys.stdout.write(" ");
    sys.stdout.write_i64(c as i64);
    sys.stdout.write("\n");
}
