// test: run
// spec: 5.2
// stdout: 10 31 99 6 9 3
import std;

const N: usize = 3;

type Cell = struct { v: u8 }

fn main(sys: &mut std.System) -> !void {
    var a: [N]u32 = [10, 20, 30];
    var b = a;
    b[0] = 99;
    a[2] += 1;
    let grid: [2][3]u8 = [[1, 2, 3], [4, 5, 6]];
    var cells: [2]Cell = [Cell { v: 7 }, Cell { v: 8 }];
    cells[1].v = 9;
    sys.stdout.write_u64(a[0] as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(a[2] as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(b[0] as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(grid[1][2] as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(cells[1].v as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(a.len() as u64);
    sys.stdout.write("\n");
}
