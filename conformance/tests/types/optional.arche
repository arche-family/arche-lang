// test: run
// spec: 7.8
// stdout: 2 99 5 x
import std;

fn find(xs: []u32, want: u32) -> ?usize {
    var i: usize = 0;
    while i < xs.len() : (i += 1) {
        if xs[i] == want {
            return i;
        }
    }
    return none;
}

fn first(xs: []u32) -> ?u32 {
    if xs.len() == 0 {
        return none;
    }
    return some(xs[0]);
}

fn main(sys: &mut std.System) -> !void {
    let a: [3]u32 = [5, 6, 7];
    let xs = a[0..3];
    sys.stdout.write_u64((find(xs, 7) orelse 99) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64((find(xs, 8) orelse 99) as u64);
    sys.stdout.write(" ");
    let empty = a[0..0];
    sys.stdout.write_u64((first(empty) orelse first(xs) orelse 0) as u64);
    var maybe: ?u8 = none;
    maybe = some('x');
    sys.stdout.write(" ");
    sys.stdout.write_byte(maybe orelse '?');
    sys.stdout.write("\n");
}
