// test: run
// spec: 5.2
// stdout: 1 7 10 7 -1
import std;

type Point = struct { x: i32, y: i32 }

type Line = struct {
    from: Point,
    to: Point,
}

fn main(sys: &mut std.System) -> !void {
    var p = Point { x: 1, y: 2 };
    var copy = p;
    copy.x = 10;
    p.y += 5;
    var l = Line { from: p, to: copy };
    l.to.y = -1;
    sys.stdout.write_i64(p.x as i64);
    sys.stdout.write(" ");
    sys.stdout.write_i64(p.y as i64);
    sys.stdout.write(" ");
    sys.stdout.write_i64(copy.x as i64);
    sys.stdout.write(" ");
    sys.stdout.write_i64(l.from.y as i64);
    sys.stdout.write(" ");
    sys.stdout.write_i64(l.to.y as i64);
    sys.stdout.write("\n");
}
