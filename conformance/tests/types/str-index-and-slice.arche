// test: run
// spec: 7.7
// stdout: 104 195 hé llo 6111
import std;

fn main(sys: &mut std.System) -> !void {

    let s = "héllo";
    sys.stdout.write_u64(s[0] as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(s[1] as u64);
    sys.stdout.write(" ");
    sys.stdout.write(s[0..3]);
    sys.stdout.write(" ");
    sys.stdout.write(s[3..6]);
    sys.stdout.write(" ");
    let b = s.bytes();
    sys.stdout.write_u64(b.len() as u64);
    sys.stdout.write_u64(b[5] as u64);
    sys.stdout.write("\n");
}
