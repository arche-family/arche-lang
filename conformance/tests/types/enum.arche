// test: run
// spec: 5.2
// stdout: green blue eq
import std;

type Color = enum { Red, Green, Blue }

fn name(c: Color) -> str {
    match c {
        .Red => { return "red"; }
        .Green => { return "green"; }
        .Blue => { return "blue"; }
    }
}

fn main(sys: &mut std.System) -> !void {
    let c = Color.Green;
    sys.stdout.write(name(c));
    sys.stdout.write(" ");
    sys.stdout.write(name(Color.Blue));
    if c == Color.Green and c != Color.Red {
        sys.stdout.write(" eq");
    }
    sys.stdout.write("\n");
}
