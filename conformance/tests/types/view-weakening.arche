// test: run
// spec: 5.4
// stdout: 6 7
import std;

fn read(x: &u32) -> u32 {
    return x.*;
}

fn total(xs: []u32) -> u32 {
    return xs[0] + xs[1];
}

fn main(sys: &mut std.System) -> !void {
    var n: u32 = 5;
    let r = &mut n;
    r.* += 1;
    var a: [2]u32 = [3, 4];
    let s = a[0..2];
    sys.stdout.write_u64(read(r) as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(total(s) as u64);
    sys.stdout.write("\n");
}
