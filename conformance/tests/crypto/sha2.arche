import std;
import crypto.sha2;
import _hex;

fn main(sys: &mut std.System) -> !void {
    let abc = "abc".bytes();
    let two = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".bytes();
    let long = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu".bytes();
    let a = sha2.sha256(abc);
    _hex.hex(&mut sys.stdout, a[0..32]);
    let b = sha2.sha256(two);
    _hex.hex(&mut sys.stdout, b[0..32]);
    let c = sha2.sha384(abc);
    _hex.hex(&mut sys.stdout, c[0..48]);
    let d = sha2.sha512(abc);
    _hex.hex(&mut sys.stdout, d[0..64]);
    let e = sha2.sha512(long);
    _hex.hex(&mut sys.stdout, e[0..64]);
    let f = sha2.sha384(long);
    _hex.hex(&mut sys.stdout, f[0..48]);
    // A million 'a's, fed a thousand at a time.
    var h = sha2.Sha256.init();
    let chunk: [1000]u8 = [0x61; 1000];
    var i: u32 = 0;
    while i < 1000 : (i += 1) {
        h.update(chunk[0..1000]);
    }
    let g = h.finish();
    _hex.hex(&mut sys.stdout, g[0..32]);
}
