// test: run
// spec: crypto (FIPS 186-5 ECDSA P-256, RFC 6979)
// stage0: skip
// stdout: 0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299
// stdout: efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8
// stdout: f1abb023518351cd71d881567b1ea663ed3efcf6c5132b354f28d3b0b7d38367019f4113742a2b14bd25926b49c649155f267e60d3814b4c0cc84250e46f0083
// stdout: valid
// stdout: other digest rejected
// stdout: off-curve key rejected
import std;
import crypto.p256;
import crypto.sha2;
import _hex;

fn unhex(text: str, out: []mut u8) {
    let b = text.bytes();
    var i: usize = 0;
    while i < out.len() : (i += 1) {
        out[i] = nibble(b[2 * i]) * 16 + nibble(b[2 * i + 1]);
    }
}

fn nibble(c: u8) -> u8 {
    if c >= 'a' {
        return c - 'a' + 10;
    }
    return c - '0';
}

fn main(sys: &mut std.System) -> !void {
    // RFC 6979 A.2.5
    var d: [32]u8 = [0; 32];
    unhex("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721", d[0..32]);
    let pk = p256.public_key(d[0..32]);
    _hex.hex(&mut sys.stdout, pk[0..65]);
    let h1 = sha2.sha256("sample".bytes());
    let s1 = p256.sign(private: d[0..32], digest: h1[0..32]);
    _hex.hex(&mut sys.stdout, s1[0..64]);
    let h2 = sha2.sha256("test".bytes());
    let s2 = p256.sign(private: d[0..32], digest: h2[0..32]);
    _hex.hex(&mut sys.stdout, s2[0..64]);
    if p256.verify(key: pk[0..65], digest: h1[0..32], sig: s1[0..64]) {
        sys.stdout.write("valid\n");
    }
    if not p256.verify(key: pk[0..65], digest: h2[0..32], sig: s1[0..64]) {
        sys.stdout.write("other digest rejected\n");
    }
    var bad = pk;
    bad[64] ^= 1;
    if not p256.verify(key: bad[0..65], digest: h1[0..32], sig: s1[0..64]) {
        sys.stdout.write("off-curve key rejected\n");
    }
}
