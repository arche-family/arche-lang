// test: run
// spec: crypto (RFC 7748)
// stage0: skip
// stdout: c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552
// stdout: 8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a
// stdout: 4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742
// stdout: 4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742
import std;
import crypto.x25519;
import _hex;

fn unhex(text: str, out: []mut u8) {
    let b = text.bytes();
    var i: usize = 0;
    while i < out.len() : (i += 1) {
        out[i] = nibble(b[2 * i]) * 16 + nibble(b[2 * i + 1]);
    }
}

fn nibble(c: u8) -> u8 {
    if c >= 'a' {
        return c - 'a' + 10;
    }
    return c - '0';
}

fn main(sys: &mut std.System) -> !void {
    // RFC 7748 5.2
    var k: [32]u8 = [0; 32];
    var u: [32]u8 = [0; 32];
    unhex("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4", k[0..32]);
    unhex("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c", u[0..32]);
    let r = x25519.scalarmult(k: k[0..32], u: u[0..32]);
    _hex.hex(&mut sys.stdout, r[0..32]);
    // RFC 7748 6.1: Alice and Bob agree.
    var a: [32]u8 = [0; 32];
    var b: [32]u8 = [0; 32];
    unhex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a", a[0..32]);
    unhex("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb", b[0..32]);
    let pa = x25519.public_key(a[0..32]);
    _hex.hex(&mut sys.stdout, pa[0..32]);
    let pb = x25519.public_key(b[0..32]);
    let s1 = x25519.scalarmult(k: a[0..32], u: pb[0..32]);
    let s2 = x25519.scalarmult(k: b[0..32], u: pa[0..32]);
    _hex.hex(&mut sys.stdout, s1[0..32]);
    _hex.hex(&mut sys.stdout, s2[0..32]);
}
