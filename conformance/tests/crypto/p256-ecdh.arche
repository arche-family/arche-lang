// test: run
// spec: crypto (RFC 5903 ECDH P-256)
// stage0: skip
// stdout: d6840f6b42f6edafd13116e0e12565202fef8e9ece7dce03812464d04b9442de
// stdout: d6840f6b42f6edafd13116e0e12565202fef8e9ece7dce03812464d04b9442de
// stdout: bad point rejected
import std;
import crypto.p256;
import _hex;

fn unhex(text: str, out: []mut u8) {
    let b = text.bytes();
    var i: usize = 0;
    while i < out.len() : (i += 1) {
        out[i] = nibble(b[2 * i]) * 16 + nibble(b[2 * i + 1]);
    }
}

fn nibble(c: u8) -> u8 {
    if c >= 'a' {
        return c - 'a' + 10;
    }
    return c - '0';
}

fn main(sys: &mut std.System) -> !void {
    // RFC 5903 section 8.1
    var i: [32]u8 = [0; 32];
    var r: [32]u8 = [0; 32];
    unhex("c88f01f510d9ac3f70a292daa2316de544e9aab8afe84049c62a9c57862d1433", out: i[0..32]);
    unhex("c6ef9c5d78ae012a011164acb397ce2088685d8f06bf9be0b283ab46476bee53", out: r[0..32]);
    let gi = p256.public_key(i[0..32]);
    let gr = p256.public_key(r[0..32]);
    match p256.shared_secret(private: i[0..32], peer: gr[0..65]) {
        some(z) => { _hex.hex(&mut sys.stdout, z[0..32]); }
        none => { sys.stdout.write("none\n"); }
    }
    match p256.shared_secret(private: r[0..32], peer: gi[0..65]) {
        some(z) => { _hex.hex(&mut sys.stdout, z[0..32]); }
        none => { sys.stdout.write("none\n"); }
    }
    var bad = gi;
    bad[64] = bad[64] ^ 1;
    match p256.shared_secret(private: r[0..32], peer: bad[0..65]) {
        some(_) => { sys.stdout.write("accepted a bad point\n"); }
        none => { sys.stdout.write("bad point rejected\n"); }
    }
}
