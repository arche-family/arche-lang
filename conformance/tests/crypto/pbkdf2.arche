import std;
import crypto.hmac;
import _hex;

// PBKDF2-HMAC-SHA-256 as RFC 7914 gives it: one round, and 80000; then a
// PIN's key, 50000 rounds, its first 16 bytes, as Python's hashlib says.
fn main(sys: &mut std.System) -> !void {
    var a: [64]u8 = [0; 64];
    hmac.pbkdf2_sha256(password: "passwd".bytes(), salt: "salt".bytes(), iterations: 1, a[0..64]);
    _hex.hex(&mut sys.stdout, a[0..64]);
    var b: [64]u8 = [0; 64];
    hmac.pbkdf2_sha256(password: "Password".bytes(), salt: "NaCl".bytes(), iterations: 80000, b[0..64]);
    _hex.hex(&mut sys.stdout, b[0..64]);
    var c: [16]u8 = [0; 16];
    hmac.pbkdf2_sha256(password: "1234".bytes(), salt: "arche-pin-salt".bytes(), iterations: 50000, c[0..16]);
    _hex.hex(&mut sys.stdout, c[0..16]);
}
