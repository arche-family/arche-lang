// A helper of the crypto tests: bytes as lowercase hex, one line.
import std;

pub fn hex(out: &mut std.Output, b: []u8) {
    let digits = "0123456789abcdef".bytes();
    for x in b {
        out.write_byte(digits[(x.* >> 4) as usize]);
        out.write_byte(digits[(x.* & 15) as usize]);
    }
    out.write("\n");
}
