// test: run
// spec: 7.5
// stdout: right
import std;

type Dir = enum {
    Left,
    Right,

    fn flip(self: Dir) -> Dir {
        match self {
            .Left => { return Dir.Right; }
            .Right => { return Dir.Left; }
        }
    }

    fn name(self: &Dir) -> str {
        match self {
            .Left => { return "left"; }
            .Right => { return "right"; }
        }
    }
}

fn main(sys: &mut std.System) -> !void {
    let d = Dir.Left.flip();
    sys.stdout.write(d.name());
    sys.stdout.write("\n");
}
