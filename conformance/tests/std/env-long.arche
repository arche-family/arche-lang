// test: run
// spec: std
// stage0: skip
// system: windows
// stdout: 10000
import alloc;
import core.mem;
import std;
import std.win32 as win;

extern "c" fn SetEnvironmentVariableW(name: *u16, value: *u16) -> i32;

// A value longer than a path comes back whole: a PATH can be one.
fn main(sys: &mut std.System) -> !void {
    var text = alloc.String.init(sys.alloc);
    var i: usize = 0;
    while i < 10000 : (i += 1) {
        text.push_str("v");
    }
    var name: [16]u16 = [0; 16];
    var value = alloc.List(u16).init(sys.alloc);
    i = 0;
    while i <= 10000 : (i += 1) {
        value.push(0);
    }
    if not win.wide("ARCHE_LONG", name[0..16]) or not win.wide(text.view(), value.items_mut()) {
        sys.proc.exit(2);
    }
    unsafe {
        // SAFETY: both are NUL-terminated UTF-16, read during the call only.
        if SetEnvironmentVariableW(name: mem.slice_data(u16, name[0..16]), value: mem.slice_data(u16, value.items())) == 0 {
            sys.proc.exit(3);
        }
    }
    match sys.env.get("ARCHE_LONG", sys.alloc) {
        some(v) => { sys.stdout.write_u64(v.len() as u64); }
        none => { sys.stdout.write("none"); }
    }
    sys.stdout.write("\n");
}
