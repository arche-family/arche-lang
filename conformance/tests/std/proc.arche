// test: run
// spec: std
// stage0: skip
// exit: 4
// stdout: before child
// stdout: status 3 not-found
import std;
import alloc;

// The child is this program again, with an argument: no program for a
// shell is on every system, and the ones that are write their lines
// differently (docs/sprints.md S19).
fn main(sys: &mut std.System) -> !void {
    if sys.args.len() > 1 and sys.args.get(1).eq("child") {
        sys.stdout.write("child\n");
        sys.proc.exit(3);
    }
    sys.stdout.write("before ");
    var argv = alloc.List(alloc.String).init(sys.alloc);
    var program = alloc.String.init(sys.alloc);
    program.push_str(sys.args.get(0));
    argv.push(program);
    var word = alloc.String.init(sys.alloc);
    word.push_str("child");
    argv.push(word);
    let status = try sys.proc.run(&argv, env: &sys.env, sys.alloc);
    sys.stdout.write("status ");
    sys.stdout.write_u64(status as u64);
    var missing = alloc.List(alloc.String).init(sys.alloc);
    var path = alloc.String.init(sys.alloc);
    path.push_str("/no/such/program");
    missing.push(path);
    match sys.proc.run(&missing, env: &sys.env, sys.alloc) {
        ok(_) => { sys.stdout.write(" ran"); }
        err(.NotFound) => { sys.stdout.write(" not-found"); }
        err(_) => { sys.stdout.write(" failed"); }
    }
    sys.stdout.write("\n");
    sys.proc.exit(4);
}
