// test: run
// spec: arche/2.3
// stage0: skip
// stdout: 2 -2 2147483647 -2147483648 0 -3.5 18446744073709552000.0 16777216.0 0.10000000149011612 255
import std;

fn main(sys: &mut std.System) -> !void {

    let p: f64 = 2.9;
    let q: f64 = -2.9;
    sys.stdout.write_i64(p as i64);
    sys.stdout.write(" ");
    sys.stdout.write_i64(q as i64);
    sys.stdout.write(" ");
    let big: f64 = 1.0e20;
    sys.stdout.write_i64(big as% i32 as i64);
    sys.stdout.write(" ");
    sys.stdout.write_i64(-big as% i32 as i64);
    sys.stdout.write(" ");
    let zero: f64 = 0.0;
    sys.stdout.write_u64((zero / zero) as% u8 as u64);
    sys.stdout.write(" ");
    let n: i32 = -7;
    sys.stdout.write_f64(n as f64 / 2.0);
    sys.stdout.write(" ");
    let u: u64 = 18446744073709551615;
    sys.stdout.write_f64(u as f64);
    sys.stdout.write(" ");
    let wide: f64 = 16777217.0;
    sys.stdout.write_f32(wide as f32);
    sys.stdout.write(" ");
    let small: f32 = 0.1;
    sys.stdout.write_f64(small as f64);
    sys.stdout.write(" ");
    let edge: f64 = 255.9;
    sys.stdout.write_u64(edge as u8 as u64);
    sys.stdout.write("\n");
}
