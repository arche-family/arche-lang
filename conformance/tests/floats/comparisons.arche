// test: run
// spec: arche/2.2
// stage0: skip
// stdout: abcde
import std;

fn main(sys: &mut std.System) -> !void {

    let zero: f64 = 0.0;
    let nan = zero / zero;
    let one: f64 = 1.0;
    if nan != nan { sys.stdout.write("a"); }
    if not (nan == nan) { sys.stdout.write("b"); }
    if not (nan < one) and not (nan > one) and not (nan <= one) and not (nan >= one) { sys.stdout.write("c"); }
    if zero == -zero { sys.stdout.write("d"); }
    if one > zero and zero < one and one >= one and one <= one { sys.stdout.write("e"); }
    sys.stdout.write("\n");
}
