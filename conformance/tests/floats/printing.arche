// test: run
// spec: arche/2.4
// stage0: skip
// stdout: 1.0 0.5 123456789.0 1e21 1e22 0.000001 1.5e-7 5e-324 1.7976931348623157e308 3.4028235e38
import std;

fn main(sys: &mut std.System) -> !void {

    let values: [8]f64 = [1.0, 0.5, 123456789.0, 1.0e21, 1.0e22, 0.000001, 1.5e-7, 5.0e-324];
    var i: usize = 0;
    while i < 8 : (i += 1) {
        sys.stdout.write_f64(values[i]);
        sys.stdout.write(" ");
    }
    sys.stdout.write_f64(1.7976931348623157e308);
    sys.stdout.write(" ");
    sys.stdout.write_f32(3.4028235e38);
    sys.stdout.write("\n");
}
