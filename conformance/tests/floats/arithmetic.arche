// test: run
// spec: arche/2.2
// stage0: skip
// stdout: 1.75 1.0 6.0 -1.5 0.30000000000000004 0.3 inf nan -0.0
import std;

fn main(sys: &mut std.System) -> !void {

    let a: f64 = 1.5;
    let b: f64 = 0.25;
    sys.stdout.write_f64(a + b);
    sys.stdout.write(" ");
    sys.stdout.write_f64(a - b * 2.0);
    sys.stdout.write(" ");
    sys.stdout.write_f64(a / b);
    sys.stdout.write(" ");
    sys.stdout.write_f64(-a);
    sys.stdout.write(" ");
    let tenth: f64 = 0.1;
    sys.stdout.write_f64(tenth + 0.2);
    sys.stdout.write(" ");
    let h: f32 = 0.1;
    sys.stdout.write_f32(h + 0.2);
    sys.stdout.write(" ");
    let big: f64 = 1.0e300;
    sys.stdout.write_f64(big * big);
    sys.stdout.write(" ");
    let zero: f64 = 0.0;
    sys.stdout.write_f64(zero / zero);
    sys.stdout.write(" ");
    sys.stdout.write_f64(-zero);
    sys.stdout.write("\n");
}
