// test: run
// spec: arche/3.2
// stage0: skip
// stdout: 10 6 -2-1012 024
import std;

fn main(sys: &mut std.System) -> !void {

    var sum: u32 = 0;
    for i: u32 in 0..5 {
        sum += i;
    }
    sys.stdout.write_u64(sum as u64);
    sys.stdout.write(" ");
    var steps: u32 = 0;
    for b: u8 in 250..=255 {
        steps += 1;
    }
    sys.stdout.write_u64(steps as u64);
    sys.stdout.write(" ");
    let n: i32 = -2;
    for i in n..=2 {
        sys.stdout.write_i64(i as i64);
    }
    sys.stdout.write(" ");
    for i: u32 in 5..2 {
        sys.stdout.write("never");
    }
    for i: u32 in 0..10 {
        if i == 6 {
            break;
        }
        if i % 2 == 1 {
            continue;
        }
        sys.stdout.write_u64(i as u64);
    }
    sys.stdout.write("\n");
}
