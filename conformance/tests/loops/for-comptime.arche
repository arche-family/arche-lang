// test: run
// spec: arche/4.3
// stage0: skip
// stdout: 55 0 10
import std;

fn triangle(n: u32) -> u32 {
    var total: u32 = 0;
    for i in 1..=n {
        total += i;
    }
    return total;
}

const T10: u32 = triangle(10);
const T0: u32 = triangle(0);

fn main(sys: &mut std.System) -> !void {
    sys.stdout.write_u64(T10 as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(T0 as u64);
    sys.stdout.write(" ");
    sys.stdout.write_u64(triangle(4) as u64);
    sys.stdout.write("\n");
}
