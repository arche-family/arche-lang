/// Fuzzes lib/image/png (docs/sprints.md S35): PngSuite's images with
/// bytes changed, cut, or noise written over a run, and then, mostly,
/// every chunk's CRC made right again, so the changes reach the header,
/// the palette, the zlib stream and the filters rather than stopping at
/// the checksum. Every input must give an error or an image; a panic is a
/// bug.
///
/// usage: png_fuzz <seconds> [seed] <file.png>... The seed printed first
/// repeats a run with the same files.
import alloc;
import core.deflate;
import core.rand;
import image.png;
import std;

fn number(s: str) -> u64 {
    var n: u64 = 0;
    for c in s.bytes() {
        if c.* >= '0' and c.* <= '9' {
            n = n * 10 + (c.* - '0') as u64;
        }
    }
    return n;
}

fn be32(b: []u8, at: usize) -> u64 {
    return ((b[at] as u64) << 24) | ((b[at + 1] as u64) << 16) | ((b[at + 2] as u64) << 8) | (b[at + 3] as u64);
}

/// Every whole chunk's CRC, as it should be for what it now holds.
fn fix_crcs(b: []mut u8) {
    var at: usize = 8;
    while at + 12 <= b.len() {
        let len = be32(b, at: at) as usize;
        if len > b.len() - at - 12 {
            return;
        }
        let crc = deflate.crc32(0, b[at + 4..at + 8 + len]);
        let c = at + 8 + len;
        b[c] = (crc >> 24) as u8;
        b[c + 1] = ((crc >> 16) & 0xFF) as u8;
        b[c + 2] = ((crc >> 8) & 0xFF) as u8;
        b[c + 3] = (crc & 0xFF) as u8;
        at = c + 4;
    }
}

fn mangle(data: []u8, g: &mut rand.Seeded, a: alloc.Allocator) -> alloc.List(u8) {
    var out = alloc.List(u8).with_capacity(a, data.len());
    for x in data {
        out.push(x.*);
    }
    let rounds = g.below(4) + 1;
    var k: u64 = 0;
    while k < rounds and out.len() > 8 : (k += 1) {
        let n = out.len() as u64;
        let how = g.below(10);
        if how < 7 {
            let at = 8 + g.below(n - 8) as usize;
            out.items_mut()[at] = (g.next_u64() & 0xff) as u8;
        } else if how == 7 {
            let at = 8 + g.below(n - 8) as usize;
            let one: u8 = 1;
            let flipped = out.items()[at] ^ (one << (g.below(8) as u32));
            out.items_mut()[at] = flipped;
        } else if how == 8 {
            let at = g.below(n) as usize;
            let len = g.below(32) as usize;
            var i = at;
            while i < at + len and i < out.len() : (i += 1) {
                out.items_mut()[i] = (g.next_u64() & 0xff) as u8;
            }
        } else {
            let keep = g.below(n + 1);
            while out.len() as u64 > keep {
                _ = out.pop();
            }
        }
    }
    if g.below(10) < 9 {
        fix_crcs(out.items_mut());
    }
    return out;
}

fn main(sys: &mut std.System) -> !void {
    if sys.args.len() < 3 {
        sys.stderr.write("usage: png_fuzz <seconds> [seed] <file.png>...\n");
        sys.proc.exit(2);
    }
    let seconds = number(sys.args.get(1));
    var seed = sys.rand.next_u64() % 1000000000;
    var first: usize = 2;
    let second = sys.args.get(2).bytes();
    if second.len() > 0 and second[0] >= '0' and second[0] <= '9' {
        seed = number(sys.args.get(2));
        first = 3;
    }
    var files = alloc.List(alloc.List(u8)).init(sys.alloc);
    var i = first;
    while i < sys.args.len() : (i += 1) {
        files.push(try sys.fs.read_bytes(sys.args.get(i), sys.alloc));
    }
    if files.len() == 0 {
        sys.stderr.write("png_fuzz: no files\n");
        sys.proc.exit(2);
    }
    sys.stdout.write("seed ");
    sys.stdout.write_u64(seed);
    sys.stdout.write("\n");
    sys.stdout.flush();
    var g = rand.Seeded.init(seed);
    let start = sys.clock.monotonic_ns();
    var cases: u64 = 0;
    var decoded: u64 = 0;
    while sys.clock.monotonic_ns() - start < seconds * 1000000000 : (cases += 1) {
        let which = g.below(files.len() as u64) as usize;
        region r {
            let input = mangle(files.items()[which].items(), g: &mut g, r);
            match png.decode(input.items(), max_pixels: 1 << 22, r) {
                ok(_) => { decoded += 1; }
                err(_) => { }
            }
        }
    }
    sys.stdout.write_u64(cases);
    sys.stdout.write(" cases, ");
    sys.stdout.write_u64(decoded);
    sys.stdout.write(" decoded, no panic\n");
}
