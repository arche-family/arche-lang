/// Fuzzes lib/image/jpeg (arche-os docs/sprints.md T9): the JPEG files of
/// conformance/tests/image/_jpeg (baseline, progressive, grey, every
/// sampling, restart markers, Exif) with bytes changed, cut, or noise
/// written over a run, mostly in the header's segments, where a change
/// reaches the frame, the tables and the scans' bands rather than only the
/// pixels; and markers put in at random. Every input must give an error
/// or an image; a panic is a bug. Now and then the encoder too: pictures
/// of random sizes, qualities and samplings, encoded and decoded back to
/// their size.
///
/// usage: jpeg_fuzz <seconds> [seed] <file.jpg>... The seed printed first
/// repeats a run with the same files.
import alloc;
import core.rand;
import image.jpeg;
import image.png;
import std;

fn number(s: str) -> u64 {
    var n: u64 = 0;
    for c in s.bytes() {
        if c.* >= '0' and c.* <= '9' {
            n = n * 10 + (c.* - '0') as u64;
        }
    }
    return n;
}

/// Where the header ends: after the first scan's header, or at the end.
fn header_end(b: []u8) -> usize {
    var at: usize = 2;
    while at + 4 <= b.len() {
        let len = ((b[at + 2] as usize) << 8) + (b[at + 3] as usize);
        if b[at + 1] == 0xDA {
            return at + 2 + len;
        }
        at += 2 + len;
    }
    return b.len();
}

fn mangle(data: []u8, g: &mut rand.Seeded, a: alloc.Allocator) -> alloc.List(u8) {
    var out = alloc.List(u8).with_capacity(a, data.len() + 64);
    for x in data {
        out.push(x.*);
    }
    let rounds = g.below(4) + 1;
    var k: u64 = 0;
    while k < rounds and out.len() > 4 : (k += 1) {
        let n = out.len() as u64;
        var head = header_end(out.items()) as u64;
        if head > n {
            head = n;
        }
        let how = g.below(10);
        if how < 4 and head > 2 {
            // A byte of the header's segments.
            let at = 2 + g.below(head - 2) as usize;
            if g.below(2) == 0 {
                out.items_mut()[at] = (g.next_u64() & 0xff) as u8;
            } else {
                let small = g.below(5) as u8;
                let nudged = out.items()[at] +% small -% 2;
                out.items_mut()[at] = nudged;
            }
        } else if how < 6 {
            let at = 2 + g.below(n - 2) as usize;
            out.items_mut()[at] = (g.next_u64() & 0xff) as u8;
        } else if how == 6 {
            let at = 2 + g.below(n - 2) as usize;
            let one: u8 = 1;
            let flipped = out.items()[at] ^ (one << (g.below(8) as u32));
            out.items_mut()[at] = flipped;
        } else if how == 7 {
            let at = g.below(n) as usize;
            let len = g.below(32) as usize;
            var i = at;
            while i < at + len and i < out.len() : (i += 1) {
                out.items_mut()[i] = (g.next_u64() & 0xff) as u8;
            }
        } else if how == 8 {
            let keep = g.below(n + 1);
            while out.len() as u64 > keep {
                _ = out.pop();
            }
        } else {
            // A marker: a restart, EOI, SOS, DHT, DQT, DRI, or any.
            let codes: [8]u8 = [0xD0, 0xD3, 0xD9, 0xDA, 0xC4, 0xDB, 0xDD, 0];
            var code = codes[g.below(8) as usize];
            if code == 0 {
                code = (g.next_u64() & 0xff) as u8;
            }
            let at = 2 + g.below(n - 2) as usize;
            out.items_mut()[at] = 0xFF;
            if at + 1 < out.len() {
                out.items_mut()[at + 1] = code;
            }
        }
    }
    return out;
}

/// A picture of random size and content encoded at a random quality and
/// sampling and decoded back: false when it does not come back its size.
fn round_trip(g: &mut rand.Seeded, a: alloc.Allocator) -> bool {
    let w = (g.below(300) + 1) as u32;
    let h = (g.below(300) + 1) as u32;
    var img = png.Image { width: w, height: h, rgba: alloc.List(u8).with_capacity(a, (w as usize) * (h as usize) * 4) };
    let smooth = g.below(2) == 0;
    var i: u64 = 0;
    while i < (w as u64) * (h as u64) * 4 : (i += 1) {
        if smooth {
            img.rgba.push(((i / 4) % (w as u64) * 255 / (w as u64)) as u8);
        } else {
            img.rgba.push((g.next_u64() & 0xff) as u8);
        }
    }
    let quality = (g.below(100) + 1) as u32;
    var sampling = jpeg.Subsampling.S420;
    let which = g.below(3);
    if which == 1 {
        sampling = jpeg.Subsampling.S422;
    } else if which == 2 {
        sampling = jpeg.Subsampling.S444;
    }
    var e = jpeg.Encoder.init(quality, sampling: sampling, a: a);
    var data = alloc.List(u8).init(a);
    match e.encode(&img, out: &mut data) {
        ok(_) => { }
        err(_) => {
            return false;
        }
    }
    match jpeg.decode(data.items(), max_pixels: 1 << 20, a) {
        ok(back) => {
            return back.width == w and back.height == h;
        }
        err(_) => {
            return false;
        }
    }
}

fn main(sys: &mut std.System) -> !void {
    if sys.args.len() < 3 {
        sys.stderr.write("usage: jpeg_fuzz <seconds> [seed] <file.jpg>...\n");
        sys.proc.exit(2);
    }
    let seconds = number(sys.args.get(1));
    var seed = sys.rand.next_u64() % 1000000000;
    var first: usize = 2;
    let second = sys.args.get(2).bytes();
    if second.len() > 0 and second[0] >= '0' and second[0] <= '9' {
        seed = number(sys.args.get(2));
        first = 3;
    }
    var files = alloc.List(alloc.List(u8)).init(sys.alloc);
    var i = first;
    while i < sys.args.len() : (i += 1) {
        files.push(try sys.fs.read_bytes(sys.args.get(i), sys.alloc));
    }
    if files.len() == 0 {
        sys.stderr.write("jpeg_fuzz: no files\n");
        sys.proc.exit(2);
    }
    sys.stdout.write("seed ");
    sys.stdout.write_u64(seed);
    sys.stdout.write("\n");
    sys.stdout.flush();
    var g = rand.Seeded.init(seed);
    let start = sys.clock.monotonic_ns();
    var cases: u64 = 0;
    var decoded: u64 = 0;
    var trips: u64 = 0;
    while sys.clock.monotonic_ns() - start < seconds * 1000000000 : (cases += 1) {
        if g.below(64) == 0 {
            region r {
                if not round_trip(&mut g, r) {
                    sys.stderr.write("jpeg_fuzz: an encoded picture did not decode to its size\n");
                    sys.proc.exit(1);
                }
            }
            trips += 1;
            continue;
        }
        let which = g.below(files.len() as u64) as usize;
        region r {
            let input = mangle(files.items()[which].items(), g: &mut g, r);
            match jpeg.info(input.items()) {
                ok(_) => { }
                err(_) => { }
            }
            match jpeg.decode(input.items(), max_pixels: 1 << 22, r) {
                ok(_) => { decoded += 1; }
                err(_) => { }
            }
        }
    }
    sys.stdout.write_u64(cases);
    sys.stdout.write(" cases, ");
    sys.stdout.write_u64(decoded);
    sys.stdout.write(" decoded, ");
    sys.stdout.write_u64(trips);
    sys.stdout.write(" encoded and decoded back, no panic\n");
}
