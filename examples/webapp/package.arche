// A web application on lib/web (docs/sprints.md S32): it serves files and
// answers an API over the network, reads its certificate and its files,
// and starts a worker per processor.
import std.build;

const PACKAGE: build.Package = build.Package {
    name: "webapp",
    version: "0.1.0",
    edition: 2026,
    needs: [build.Capability.Fs, build.Capability.Net, build.Capability.Proc, build.Capability.Rand],
};
