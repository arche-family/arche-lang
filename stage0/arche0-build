#!/bin/sh
# Builds an Arche-0 program with stage0: Arche-0 → C11 → executable.
# This is the compiler command the conformance runner calls.
#
# Usage: arche0-build <source.arche> <output>
# CC selects the C compiler (default: cc, and clang on Windows, which has
# no cc).

set -eu

if [ $# -ne 2 ]; then
    echo "usage: arche0-build <source.arche> <output>" >&2
    exit 2
fi

case $(uname -s) in
MINGW* | MSYS* | CYGWIN*) : "${CC:=clang}" ;;
*) : "${CC:=cc}" ;;
esac

here=$(cd "$(dirname "$0")" && pwd)
c_file="$2.c"

"$here/build/arche0" "$1" -o "$c_file"
# The C library of Windows deprecates fopen and strerror, which C11 keeps;
# the macro says so, and means nothing to the other systems.
$CC -std=c11 ${A0_CFLAGS:--O2} -D_CRT_SECURE_NO_WARNINGS -I"$here/runtime" -o "$2" "$c_file" "$here/runtime/arche0_rt.c"
