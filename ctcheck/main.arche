/// Constant-time check of the crypto library (docs/sprints.md S20), in the
/// manner of dudect (Reparaz, Balasch, Verbauwhede, 2017): each function
/// runs on a fixed secret and on random ones, in random order, and Welch's
/// t-test asks whether the two classes of timings differ. |t| above 10 is
/// a leak. A function that leaks on purpose must be caught, or the check
/// itself is broken.
import std;
import alloc;
import core.rand;
import core.slice;
import crypto.aes;
import crypto.chacha20poly1305 as cc;
import crypto.ct;
import crypto.ed25519;
import crypto.p256;
import crypto.x25519;

fn cycles() -> u64 {
    var lo: u32 = 0;
    var hi: u32 = 0;
    unsafe {
        // SAFETY: lfence orders the read; rdtsc reads the time stamp counter.
        asm("lfence\n rdtsc", out("eax") lo, out("edx") hi);
    }
    return ((hi as u64) << 32) | lo as u64;
}

/// What is measured: one call, its secret chosen by class and generator.
type Target = enum { Leaky, CtEq, X25519, Ed25519Sign, P256Sign, AesBlock, ChaChaOpen }

fn secret(class: u32, g: &mut rand.Seeded, out: []mut u8) {
    var i: usize = 0;
    while i < out.len() : (i += 1) {
        if class == 0 {
            out[i] = 0x5a;
        } else {
            out[i] = (g.next_u64() & 0xff) as u8;
        }
    }
}

/// A comparison that stops at the first difference: it leaks on purpose.
fn leaky_eq(a: []u8, b: []u8) -> bool {
    var i: usize = 0;
    while i < a.len() : (i += 1) {
        if a[i] != b[i] {
            return false;
        }
    }
    return true;
}

/// Results go to sink, and a bool to flag: storing it does not branch on
/// it, so the caller looks at it only after the clock is read.
fn run_once(t: Target, s: []u8, sink: &mut u64, flag: &mut bool) {
    let fixed: [32]u8 = [0x5a; 32];
    match t {
        .Leaky => {
            flag.* = leaky_eq(a: s, b: fixed[0..32]);
        }
        .CtEq => {
            flag.* = ct.eq(a: s, b: fixed[0..32]);
        }
        .X25519 => {
            let r = x25519.public_key(s);
            sink.* += r[0] as u64;
        }
        .Ed25519Sign => {
            let sig = ed25519.sign(seed: s, message: fixed[0..16]);
            sink.* += sig[0] as u64;
        }
        .P256Sign => {
            let sig = p256.sign(private: s, digest: fixed[0..32]);
            sink.* += sig[0] as u64;
        }
        .AesBlock => {
            let a = aes.Aes.init(s[0..16]);
            let block: [16]u8 = [7; 16];
            let c = a.encrypt(block);
            sink.* += c[0] as u64;
        }
        .ChaChaOpen => {
            // A wrong tag: open must take as long whatever bytes differ.
            var sealed: [48]u8 = [0; 48];
            var i: usize = 0;
            while i < 32 : (i += 1) {
                sealed[i] = fixed[i];
                sealed[16 + i] = s[i];
            }
            var out: [32]u8 = [0; 32];
            flag.* = cc.open(key: fixed[0..32], nonce: fixed[0..12], aad: fixed[0..0], sealed: sealed[0..48], out: out[0..32]);
        }
    }
}

fn name(t: Target) -> str {
    match t {
        .Leaky => { return "early-exit compare (must leak)"; }
        .CtEq => { return "ct.eq"; }
        .X25519 => { return "x25519"; }
        .Ed25519Sign => { return "ed25519.sign"; }
        .P256Sign => { return "p256.sign"; }
        .AesBlock => { return "aes key and block"; }
        .ChaChaOpen => { return "chacha20poly1305.open"; }
    }
}

/// Welch's t for the timings of the two classes, after dropping the
/// slowest tenth (interrupts and the like) by one cutoff for both.
fn welch(times: []u64, classes: []u32, a: alloc.Allocator) -> f64 {
    var sorted = alloc.List(u64).init(a);
    for x in times {
        sorted.push(x.*);
    }
    slice.sort(u64, sorted.items_mut());
    let cutoff = sorted[sorted.len() * 9 / 10];
    var n: [2]f64 = [0.0, 0.0];
    var mean: [2]f64 = [0.0, 0.0];
    var m2: [2]f64 = [0.0, 0.0];
    var i: usize = 0;
    while i < times.len() : (i += 1) {
        let x = times[i];
        if x > cutoff {
            continue;
        }
        let c = classes[i] as usize;
        n[c] = n[c] + 1.0;
        let v = x as f64;
        let d = v - mean[c];
        mean[c] = mean[c] + d / n[c];
        m2[c] = m2[c] + d * (v - mean[c]);
    }
    if n[0] < 2.0 or n[1] < 2.0 {
        return 0.0;
    }
    let var0 = m2[0] / (n[0] - 1.0);
    let var1 = m2[1] / (n[1] - 1.0);
    let se = (var0 / n[0] + var1 / n[1]).sqrt();
    if se == 0.0 {
        return 0.0;
    }
    return (mean[0] - mean[1]) / se;
}

fn measure(sys: &mut std.System, t: Target, samples: u32, g: &mut rand.Seeded) -> f64 {
    // Every input is made before any is timed, so making them does not
    // leave the two classes different caches or branch histories.
    var inputs = alloc.List(u8).init(sys.alloc);
    var classes = alloc.List(u32).init(sys.alloc);
    var s: [32]u8 = [0; 32];
    var k: u32 = 0;
    while k < samples : (k += 1) {
        let class = (g.next_u64() & 1) as u32;
        secret(class, g: g, out: s[0..32]);
        for b in s[0..32] {
            inputs.push(b.*);
        }
        classes.push(class);
    }
    var times = alloc.List(u64).init(sys.alloc);
    var sink: u64 = 0;
    var flag = false;
    let all = inputs.items();
    var at: usize = 0;
    k = 0;
    while k < samples : (k += 1) {
        let t0 = cycles();
        run_once(t, s: all[at..at + 32], sink: &mut sink, flag: &mut flag);
        let t1 = cycles();
        if flag {
            sink += 1;
        }
        times.push(t1 - t0);
        at += 32;
    }
    if sink == 12345678 {
        sys.stdout.write("");
    }
    return welch(times.items(), classes: classes.items(), sys.alloc);
}

fn abs(x: f64) -> f64 {
    if x < 0.0 {
        return -x;
    }
    return x;
}

fn main(sys: &mut std.System) -> !void {
    var g = rand.Seeded.init(sys.rand.next_u64());
    var failed = false;
    for i: u32 in 0..7 {
        var t = Target.Leaky;
        var samples: u32 = 200000;
        if i == 1 { t = Target.CtEq; }
        if i == 2 { t = Target.X25519; samples = 6000; }
        if i == 3 { t = Target.Ed25519Sign; samples = 3000; }
        if i == 4 { t = Target.P256Sign; samples = 1000; }
        if i == 5 { t = Target.AesBlock; samples = 20000; }
        if i == 6 { t = Target.ChaChaOpen; samples = 100000; }
        let tv = abs(measure(sys, t: t, samples: samples, g: &mut g));
        let leaks = tv > 10.0;
        sys.stdout.write(name(t));
        sys.stdout.write(": |t| = ");
        sys.stdout.write_u64(tv as u64);
        if t == Target.Leaky {
            if leaks {
                sys.stdout.write("  caught, as it should be\n");
            } else {
                sys.stdout.write("  NOT caught: the check cannot see a leak\n");
                failed = true;
            }
        } else if leaks {
            sys.stdout.write("  LEAKS\n");
            failed = true;
        } else {
            sys.stdout.write("  constant time\n");
        }
    }
    if failed {
        sys.proc.exit(1);
    }
}
