/// arche-wasm: runs WebAssembly.
///
///   arche-wasm spec [--jit] <script.json>...   the spec's tests (wast2json's output)
///   arche-wasm nimadir <app.component.wasm> [--jit] [--frames n] [--click text]...
///       [--type selector text] [--deny func]... [--tree]
///                                        a Nimadir mini-app, with no window
import alloc;
import component;
import exec;
import nimadir;
import std;
import std.linux;
import spec;

fn usage(sys: &mut std.System) -> !void {
    sys.stderr.write("usage: arche-wasm spec [--jit] <script.json>...\n");
    sys.stderr.write("       arche-wasm nimadir <app.component.wasm> [--jit] [--frames n] [--click text]... [--type selector text] [--deny func]... [--tree]\n");
    sys.proc.exit(2);
}

/// The JIT's machine code: 64 MiB, readable, writable and executable; 0
/// when the system gives none.
const JIT_SIZE: u64 = 64 << 20;

fn code_region() -> u64 {
    var at: i64 = 0;
    unsafe {
        // SAFETY: mmap of fresh anonymous memory; nothing else holds it.
        // 9 is mmap; 7 read, write and execute; 0x22 private and anonymous.
        at = linux.syscall(9, [0, JIT_SIZE as i64, 7, 0x22, -1, 0]);
    }
    if at < 0 {
        return 0;
    }
    return at as u64;
}

fn dir_of(path: str) -> str {
    var cut: usize = 0;
    var found = false;
    var i: usize = 0;
    let b = path.bytes();
    while i < b.len() : (i += 1) {
        if b[i] == '/' {
            cut = i;
            found = true;
        }
    }
    if not found {
        return ".";
    }
    return path[0..cut];
}

fn main(sys: &mut std.System) -> !void {
    if sys.args.len() < 2 {
        try usage(sys);
    }
    let cmd = sys.args.get(1);
    if cmd.eq("spec") {
        var total = spec.Tally { passed: 0, failed: 0, skipped: 0, jit_runs: 0, jit_slow: 0 };
        var i: usize = 2;
        var jit_base: u64 = 0;
        var jit_size: u64 = 0;
        if sys.args.len() > 2 and sys.args.get(2).eq("--jit") {
            jit_base = code_region();
            if jit_base != 0 {
                jit_size = JIT_SIZE;
            }
            i = 3;
        }
        while i < sys.args.len() : (i += 1) {
            let file = sys.args.get(i);
            var t = spec.Tally { passed: 0, failed: 0, skipped: 0, jit_runs: 0, jit_slow: 0 };
            region r {
                spec.run_file(&sys.fs, out: &mut sys.stdout, file: file, dir: dir_of(file), tally: &mut t, jit_base: jit_base, jit_size: jit_size, a: r);
            }
            if t.failed > 0 {
                sys.stdout.write(file);
                sys.stdout.write(": ");
                sys.stdout.write_u64(t.failed);
                sys.stdout.write(" failed\n");
            }
            total.passed += t.passed;
            total.failed += t.failed;
            total.skipped += t.skipped;
            total.jit_runs += t.jit_runs;
            total.jit_slow += t.jit_slow;
        }
        sys.stdout.write("passed ");
        sys.stdout.write_u64(total.passed);
        sys.stdout.write(", failed ");
        sys.stdout.write_u64(total.failed);
        sys.stdout.write(", skipped ");
        sys.stdout.write_u64(total.skipped);
        sys.stdout.write("\n");
        if jit_size > 0 {
            sys.stdout.write("machine code ran ");
            sys.stdout.write_u64(total.jit_runs);
            sys.stdout.write(" times, and gave the interpreter ");
            sys.stdout.write_u64(total.jit_slow);
            sys.stdout.write(" instructions\n");
        }
        if total.failed > 0 {
            sys.proc.exit(1);
        }
        return;
    }
    if cmd.eq("nimadir") and sys.args.len() >= 3 {
        try run_app(sys);
        return;
    }
    try usage(sys);
}

fn number(s: str) -> u32 {
    var n: u32 = 0;
    for c in s.bytes() {
        if c.* >= '0' and c.* <= '9' and n < 100000 {
            n = n * 10 + (c.* - '0') as u32;
        }
    }
    return n;
}

/// Runs an app: init, then frames, each one's drawing written out. A limit
/// that stops it is written too, and the status is 3.
fn run_app(sys: &mut std.System) -> !void {
    let path = sys.args.get(2);
    var frames: u32 = 2;
    var tree = false;
    var clicks = alloc.List(alloc.String).init(sys.alloc);
    var type_sel = alloc.String.init(sys.alloc);
    var type_text = alloc.String.init(sys.alloc);
    var denied = alloc.List(alloc.String).init(sys.alloc);
    var use_jit = false;
    var i: usize = 3;
    while i < sys.args.len() : (i += 1) {
        let arg = sys.args.get(i);
        if arg.eq("--frames") and i + 1 < sys.args.len() {
            frames = number(sys.args.get(i + 1));
            i += 1;
        } else if arg.eq("--click") and i + 1 < sys.args.len() {
            clicks.push(alloc.String.from(sys.args.get(i + 1), sys.alloc));
            i += 1;
        } else if arg.eq("--type") and i + 2 < sys.args.len() {
            type_sel = alloc.String.from(sys.args.get(i + 1), sys.alloc);
            type_text = alloc.String.from(sys.args.get(i + 2), sys.alloc);
            i += 2;
        } else if arg.eq("--deny") and i + 1 < sys.args.len() {
            denied.push(alloc.String.from(sys.args.get(i + 1), sys.alloc));
            i += 1;
        } else if arg.eq("--jit") {
            use_jit = true;
        } else if arg.eq("--tree") {
            tree = true;
        } else {
            try usage(sys);
        }
    }
    let bytes = match sys.fs.read_bytes(path, sys.alloc) {
        ok(x) => { x }
        err(_) => {
            sys.stderr.write("arche-wasm: cannot read the component\n");
            sys.proc.exit(1);
        }
    };
    let clock = &sys.clock;
    let now = fn [clock] () -> u64 { return clock.monotonic_ns(); };
    var store = exec.new_store(nimadir.limits(), sys.alloc);
    if use_jit {
        let code = code_region();
        if code != 0 {
            exec.enable_jit(&mut store, base: code, size: JIT_SIZE);
        }
    }
    var ui = nimadir.new_ui(sys.alloc);
    for d in denied.items() {
        nimadir.deny(&mut ui, func: d.view());
    }
    let comp = match component.instantiate(&mut store, &now, bytes.items(), imports: &ui, sys.alloc) {
        ok(x) => { x }
        err(e) => {
            sys.stderr.write("arche-wasm: the component did not instantiate: ");
            sys.stderr.write(component_error(e));
            sys.stderr.write("\n");
            sys.proc.exit(1);
        }
    };
    var app = nimadir.App { comp: comp, ui: ui };
    var frame: u32 = 0;
    while frame <= frames : (frame += 1) {
        nimadir.begin_frame(&mut app.ui);
        app.ui.now_ms = (sys.clock.unix_ns() / 1000000) as i64;
        var name = "update";
        var budget = nimadir.FRAME_BUDGET_NS;
        if frame == 0 {
            name = "init";
            budget = nimadir.INIT_BUDGET_NS;
            sys.stdout.write("init\n");
        } else {
            if frame == 2 {
                for c in clicks.items() {
                    nimadir.click(&mut app.ui, text: c.view());
                }
                if type_sel.len() > 0 {
                    nimadir.type_into(&mut app.ui, sel: type_sel.view(), text: type_text.view());
                }
            }
            sys.stdout.write("frame ");
            sys.stdout.write_u64(frame as u64);
            sys.stdout.write("\n");
        }
        let r = nimadir.run(&mut app, &mut store, &now, name: name, budget_ns: budget);
        sys.stdout.write(app.ui.out.view());
        match r {
            ok(_) => { }
            err(e) => {
                sys.stdout.write("stopped: ");
                sys.stdout.write(exec.message(e));
                sys.stdout.write("\n");
                sys.proc.exit(3);
            }
        }
    }
    if tree {
        var out = alloc.String.init(sys.alloc);
        nimadir.write_tree(&app.ui, n: 1, depth: 0, out: &mut out);
        sys.stdout.write(out.view());
    }
}

fn component_error(e: component.ComponentError) -> str {
    match e {
        .Malformed => { return "malformed"; }
        .Unsupported => { return "uses what this runtime does not support yet"; }
        .Invalid => { return "invalid"; }
        .Unlinkable => { return "imports what the shell does not give"; }
        .Trapped => { return "trapped while starting"; }
    }
}
