/// arche-wasm: runs WebAssembly.
///
///   arche-wasm spec [--jit] <script.json>...   the spec's tests (wast2json's output)
///   arche-wasm nimadir <app.component.wasm> [--jit] [--frames n] [--script f:b,...]
///       [--input f:i=text]... [--submit f:i,...] [--click f:n,...] [--type f:n=text]...
///       [--enter f:n,...] [--registry apps.list] [--confirm] [--deny func]...
///       [--locale tag] [--time-zone name] [--utc-offset minutes]
///                                        a Nimadir mini-app, with no window, as
///                                        Nimadir's headless runner runs it
///   arche-wasm component <core.wasm> <world.wit> <world> <out.wasm>
///                                        the component of a core module built
///                                        for a WIT world (lib/wasm/encode.arche)
///   arche-wasm bindgen <world.wit> <world> <out-dir>
///                                        Arche modules through which an app
///                                        calls what the world imports
///                                        (bindgen.arche)
///   arche-wasm echo <component.wasm>
///                                        a component of bindgen's tests, its
///                                        imports giving back what they are
///                                        given (echo.arche)
///   arche-wasm core <component.wasm> <out.wasm>
///                                        a component's first core module, the
///                                        program's, as wit-component lays it out
///   arche-wasm serve <handler.wasm> <port> (<certificate chain> <key> | --plain) [workers]
///                                        HTTPS, each request answered by the
///                                        module's handle (serve.arche)
import alloc;
import bindgen;
import echo;
import wasm.component;
import wasm.encode;
import wasm.exec;
import wasm.wit;
import crypto.random;
import http;
import http.server;
import wasm.nimadir;
import serve;
import spec;
import std;
import std.linux;
import tls;

fn usage(sys: &mut std.System) -> !void {
    sys.stderr.write("usage: arche-wasm spec [--jit] <script.json>...\n");
    sys.stderr.write("       arche-wasm component <core.wasm> <world.wit> <world> <out.wasm>\n");
    sys.stderr.write("       arche-wasm bindgen <world.wit> <world> <out-dir>\n");
    sys.stderr.write("       arche-wasm echo <component.wasm>\n");
    sys.stderr.write("       arche-wasm nimadir <app.component.wasm> [--jit] [--frames n] [--script f:b,...] [--input f:i=text]... [--submit f:i,...] [--click f:n,...] [--type f:n=text]... [--enter f:n,...] [--registry apps.list] [--confirm] [--deny func]... [--add instance#func[=numbered|true|false|n|[]|none]]... [--locale tag] [--time-zone name] [--utc-offset minutes] [--now-millis ms] [--share instance=folder]\n");
    sys.proc.exit(2);
}

/// The JIT's machine code: 64 MiB, readable, writable and executable; 0
/// when the system gives none.
const JIT_SIZE: u64 = 64 << 20;

fn code_region() -> u64 {
    var at: i64 = 0;
    unsafe {
        // SAFETY: mmap of fresh anonymous memory; nothing else holds it.
        // 9 is mmap; 7 read, write and execute; 0x22 private and anonymous.
        at = linux.syscall(9, [0, JIT_SIZE as i64, 7, 0x22, -1, 0]);
    }
    if at < 0 {
        return 0;
    }
    return at as u64;
}

fn dir_of(path: str) -> str {
    var cut: usize = 0;
    var found = false;
    var i: usize = 0;
    let b = path.bytes();
    while i < b.len() : (i += 1) {
        if b[i] == '/' {
            cut = i;
            found = true;
        }
    }
    if not found {
        return ".";
    }
    return path[0..cut];
}

fn main(sys: &mut std.System) -> !void {
    if sys.args.len() < 2 {
        try usage(sys);
    }
    let cmd = sys.args.get(1);
    if cmd.eq("spec") {
        var total = spec.Tally { passed: 0, failed: 0, skipped: 0, jit_runs: 0, jit_slow: 0 };
        var i: usize = 2;
        var jit_base: u64 = 0;
        var jit_size: u64 = 0;
        if sys.args.len() > 2 and sys.args.get(2).eq("--jit") {
            jit_base = code_region();
            if jit_base != 0 {
                jit_size = JIT_SIZE;
            }
            i = 3;
        }
        while i < sys.args.len() : (i += 1) {
            let file = sys.args.get(i);
            var t = spec.Tally { passed: 0, failed: 0, skipped: 0, jit_runs: 0, jit_slow: 0 };
            region r {
                spec.run_file(&sys.fs, out: &mut sys.stdout, file: file, dir: dir_of(file), tally: &mut t, jit_base: jit_base, jit_size: jit_size, a: r);
            }
            if t.failed > 0 {
                sys.stdout.write(file);
                sys.stdout.write(": ");
                sys.stdout.write_u64(t.failed);
                sys.stdout.write(" failed\n");
            }
            total.passed += t.passed;
            total.failed += t.failed;
            total.skipped += t.skipped;
            total.jit_runs += t.jit_runs;
            total.jit_slow += t.jit_slow;
        }
        sys.stdout.write("passed ");
        sys.stdout.write_u64(total.passed);
        sys.stdout.write(", failed ");
        sys.stdout.write_u64(total.failed);
        sys.stdout.write(", skipped ");
        sys.stdout.write_u64(total.skipped);
        sys.stdout.write("\n");
        if jit_size > 0 {
            sys.stdout.write("machine code ran ");
            sys.stdout.write_u64(total.jit_runs);
            sys.stdout.write(" times, and gave the interpreter ");
            sys.stdout.write_u64(total.jit_slow);
            sys.stdout.write(" instructions\n");
        }
        if total.failed > 0 {
            sys.proc.exit(1);
        }
        return;
    }
    if cmd.eq("serve") and sys.args.len() >= 5 {
        try serve_handler(sys);
        return;
    }
    if cmd.eq("nimadir") and sys.args.len() >= 3 {
        try run_app(sys);
        return;
    }
    if cmd.eq("core") and sys.args.len() == 4 {
        try first_core_module(sys);
        return;
    }
    if cmd.eq("component") and sys.args.len() == 6 {
        try make_component(sys);
        return;
    }
    if cmd.eq("bindgen") and sys.args.len() == 5 {
        try make_bindings(sys);
        return;
    }
    if cmd.eq("echo") and sys.args.len() == 3 {
        try run_echo(sys);
        return;
    }
    try usage(sys);
}

/// arche-wasm echo: the component's init run, what it says written out.
fn run_echo(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    let clock = &sys.clock;
    let now = fn [clock] () -> u64 { return clock.monotonic_ns(); };
    var why = alloc.String.init(a);
    if not echo.run(&sys.fs, path: sys.args.get(2), now: &now, out: &mut sys.stdout, why: &mut why, a: a) {
        sys.stdout.flush();
        sys.stderr.write("arche-wasm: ");
        sys.stderr.write(why.view());
        sys.stderr.write("\n");
        sys.proc.exit(1);
    }
}

fn number(s: str) -> u32 {
    var n: u32 = 0;
    for c in s.bytes() {
        if c.* >= '0' and c.* <= '9' and n < 100000 {
            n = n * 10 + (c.* - '0') as u32;
        }
    }
    return n;
}

/// Something to do at a frame: to button, field or node n, with text.
type At = struct {
    frame: u32,
    n: u32,
    text: alloc.String,
}

/// "f:n,f:n" onto out.
fn pairs(s: str, out: &mut alloc.List(At), a: alloc.Allocator) {
    let b = s.bytes();
    var at: usize = 0;
    while at < b.len() {
        var e = at;
        while e < b.len() and b[e] != ',' {
            e += 1;
        }
        var colon = at;
        while colon < e and b[colon] != ':' {
            colon += 1;
        }
        if colon < e {
            out.push(At { frame: number(s[at..colon]), n: number(s[colon + 1..e]), text: alloc.String.init(a) });
        }
        at = e + 1;
    }
}

/// "f:n=text" onto out: all after the first = is the text.
fn typed(s: str, out: &mut alloc.List(At), a: alloc.Allocator) {
    let b = s.bytes();
    var eq: usize = 0;
    while eq < b.len() and b[eq] != '=' {
        eq += 1;
    }
    var colon: usize = 0;
    while colon < eq and b[colon] != ':' {
        colon += 1;
    }
    if eq < b.len() and colon < eq {
        out.push(At { frame: number(s[0..colon]), n: number(s[colon + 1..eq]), text: alloc.String.from(s[eq + 1..b.len()], a) });
    }
}

/// An app the registry lists: its name, where it lives, what it is.
type Entry = struct {
    name: alloc.String,
    source: alloc.String,
    about: alloc.String,
}

fn trimmed(s: str) -> str {
    let b = s.bytes();
    var i: usize = 0;
    var j = b.len();
    while i < j and (b[i] == ' ' or b[i] == '\t' or b[i] == '\r') {
        i += 1;
    }
    while j > i and (b[j - 1] == ' ' or b[j - 1] == '\t' or b[j - 1] == '\r') {
        j -= 1;
    }
    return s[i..j];
}

/// The registry in Nimadir's apps.list: "name | source | description" a
/// line, # for a comment.
fn read_registry(text: str, a: alloc.Allocator) -> alloc.List(Entry) {
    var out = alloc.List(Entry).init(a);
    let b = text.bytes();
    var at: usize = 0;
    while at < b.len() {
        var e = at;
        while e < b.len() and b[e] != '\n' {
            e += 1;
        }
        let line = trimmed(text[at..e]);
        at = e + 1;
        if line.len() == 0 or line.bytes()[0] == '#' {
            continue;
        }
        let lb = line.bytes();
        var p1: usize = 0;
        while p1 < lb.len() and lb[p1] != '|' {
            p1 += 1;
        }
        var p2 = p1 + 1;
        while p2 < lb.len() and lb[p2] != '|' {
            p2 += 1;
        }
        if p2 >= lb.len() {
            continue;
        }
        out.push(Entry { name: alloc.String.from(trimmed(line[0..p1]), a), source: alloc.String.from(trimmed(line[p1 + 1..p2]), a), about: alloc.String.from(trimmed(line[p2 + 1..lb.len()]), a) });
    }
    return out;
}

/// What an address resolves to, as Nimadir's registry resolves it: a name
/// or source it lists; a host, which gets https://; else itself. The
/// title, the listed app's name, into title.
fn resolve(target: str, registry: &alloc.List(Entry), title: &mut alloc.String, a: alloc.Allocator) -> alloc.String {
    let t = trimmed(target);
    for e in registry.items() {
        if e.name.view().eq(t) or e.source.view().eq(t) {
            title.push_str(e.name.view());
            return alloc.String.from(e.source.view(), a);
        }
    }
    title.push_str(t);
    var out = alloc.String.init(a);
    if looks_like_host(t) {
        out.push_str("https://");
    }
    out.push_str(t);
    return out;
}

/// Whether typed text is a web address missing its scheme: a dot in the
/// part before the first / ? or #, which is not a file's name.
fn looks_like_host(s: str) -> bool {
    let b = s.bytes();
    if b.len() == 0 or b[0] == '/' or b[0] == '.' {
        return false;
    }
    var end: usize = 0;
    var dot = false;
    while end < b.len() and b[end] != '/' and b[end] != '?' and b[end] != '#' : (end += 1) {
        if b[end] == '.' {
            dot = true;
        }
        if b[end] == ' ' or b[end] == '\\' {
            return false;
        }
        if b[end] == ':' and end + 2 < b.len() and b[end + 1] == '/' and b[end + 2] == '/' {
            return false;
        }
    }
    let host = s[0..end];
    if ends(s: host, tail: ".wasm") or ends(s: host, tail: ".html") or ends(s: host, tail: ".htm") or ends(s: host, tail: ".json") {
        return false;
    }
    return dot;
}

fn ends(s: str, tail: str) -> bool {
    return s.len() >= tail.len() and s[s.len() - tail.len()..s.len()].eq(tail);
}

/// An app started: read from source, its imports given, its init run;
/// what it is and how many bytes it was, or why not.
type Started = struct {
    app: nimadir.App,
    size: u64,
}

/// Who the user is, as the shell says to the app: locale, time-zone and
/// utc-offset's answers; and a folder shared with the app.
type Who = struct {
    locale: alloc.String,
    time_zone: alloc.String,
    utc_offset: i32,
    /// A folder shared with the app (--share), as "instance=folder";
    /// empty for none.
    share: alloc.String,
}

/// A function added to Nimadir's world, as --add says it:
/// instance#func, answered with nothing; =numbered, with each call's
/// number; =true, =false or =n, with that; =[] with an empty list, =none
/// with an option's none.
fn add_spec(ui: &mut nimadir.Ui, given: str, a: alloc.Allocator) -> bool {
    let b = given.bytes();
    var hash: usize = 0;
    while hash < b.len() and b[hash] != '#' {
        hash += 1;
    }
    if hash == 0 or hash == b.len() {
        return false;
    }
    var eq = hash + 1;
    while eq < b.len() and b[eq] != '=' {
        eq += 1;
    }
    let instance = given[0..hash];
    let func = given[hash + 1..eq];
    if eq == b.len() {
        nimadir.add(ui, instance: instance, func: func, numbered: false, answer: component.Val.Unit);
        return true;
    }
    let value = given[eq + 1..b.len()];
    if value.eq("numbered") {
        nimadir.add(ui, instance: instance, func: func, numbered: true, answer: component.Val.Unit);
    } else if value.eq("[]") {
        nimadir.add(ui, instance: instance, func: func, numbered: false, answer: component.Val.List { items: alloc.List(component.Val).init(a) });
    } else if value.eq("none") {
        nimadir.add(ui, instance: instance, func: func, numbered: false, answer: component.Val.Variant { case: 0, payload: alloc.List(component.Val).init(a) });
    } else if value.eq("true") or value.eq("false") {
        nimadir.add(ui, instance: instance, func: func, numbered: false, answer: component.Val.Bool { v: value.eq("true") });
    } else {
        nimadir.add(ui, instance: instance, func: func, numbered: false, answer: component.Val.Int { v: number(value) as u64 });
    }
    return true;
}

/// A value an app gave an added function, as a frame's report says it.
fn say_val(v: &component.Val, out: &mut alloc.String) {
    match v {
        .Str { v: text } => { quote(text.view(), out: out); }
        .Int { v: n } => { out.push_u64(n.*); }
        .Bool { v: x } => {
            if x.* {
                out.push_str("true");
            } else {
                out.push_str("false");
            }
        }
        .Unit => { out.push_str("()"); }
        _ => { out.push_str("..."); }
    }
}

fn start_app(fs: &std.Fs, source: str, store: &mut exec.Store, now: &dyn fn() -> u64, now_ms: i64, who: &Who, registry: &alloc.List(Entry), denied: &alloc.List(alloc.String), added: &alloc.List(alloc.String), why: &mut alloc.String, a: alloc.Allocator) -> ?Started {
    let bytes = match fs.read_bytes(source, a) {
        ok(x) => { x }
        err(_) => {
            why.push_str("cannot read the component");
            return none;
        }
    };
    var ui = nimadir.new_ui(a);
    ui.now_ms = now_ms;
    ui.locale = alloc.String.from(who.locale.view(), a);
    ui.time_zone = alloc.String.from(who.time_zone.view(), a);
    ui.utc_offset = who.utc_offset;
    for d in denied.items() {
        nimadir.deny(&mut ui, func: d.view());
    }
    for g in added.items() {
        if not add_spec(&mut ui, given: g.view(), a: a) {
            why.push_str("not instance#func[=answer]: ");
            why.push_str(g.view());
            return none;
        }
    }
    // A folder shared as an interface of files (nimadir.share): through an
    // Fs of its own.
    if who.share.len() > 0 {
        let given = who.share.view();
        var eq: usize = 0;
        while eq < given.len() and given.bytes()[eq] != '=' {
            eq += 1;
        }
        if eq == 0 or eq + 1 >= given.len() {
            why.push_str("not instance=folder: ");
            why.push_str(given);
            return none;
        }
        match fs.open_folder(given[eq + 1..given.len()]) {
            ok(folder) => { nimadir.share(&mut ui, instance: given[0..eq], folder: folder); }
            err(_) => {
                why.push_str("cannot open the folder to share: ");
                why.push_str(given[eq + 1..given.len()]);
                return none;
            }
        }
    }
    // The registry, but the start page: it is how the shell finds home,
    // not somewhere to go.
    for e in registry.items() {
        if not e.name.view().eq("store") {
            nimadir.add_app(&mut ui, name: e.name.view(), source: e.source.view(), about: e.about.view());
        }
    }
    let comp = match component.instantiate(store, now, bytes.items(), imports: &ui, a) {
        ok(x) => { x }
        err(e) => {
            why.push_str("the component did not instantiate: ");
            why.push_str(component_error(e));
            return none;
        }
    };
    var app = nimadir.App { comp: comp, ui: ui };
    nimadir.begin_frame(&mut app.ui);
    match nimadir.run(&mut app, store, now, name: "init", budget_ns: nimadir.INIT_BUDGET_NS) {
        ok(_) => { }
        err(e) => {
            why.push_str("stopped: ");
            why.push_str(exec.message(e));
            return none;
        }
    }
    return Started { app: app, size: bytes.len() as u64 };
}

fn write_logs(out: &mut std.Output, ui: &mut nimadir.Ui, indent: str) {
    for l in nimadir.logs_of(ui) {
        out.write(indent);
        out.write("[wasm log] ");
        out.write(l.view());
        out.write("\n");
    }
    nimadir.clear_logs(ui);
}

/// The n of the ats at frame, in order, each once.
fn at_frame(ats: &alloc.List(At), frame: u32, a: alloc.Allocator) -> alloc.List(u32) {
    var out = alloc.List(u32).init(a);
    for x in ats.items() {
        if x.frame == frame {
            var seen = false;
            for y in out.items() {
                if y.* == x.n {
                    seen = true;
                }
            }
            if not seen {
                out.push(x.n);
                // Into order: back while the one before is larger.
                var k = out.len() - 1;
                while k > 0 and out.items()[k - 1] > out.items()[k] : (k -= 1) {
                    let t = out.items()[k];
                    let before = out.items()[k - 1];
                    out.items_mut()[k] = before;
                    out.items_mut()[k - 1] = t;
                }
            }
        }
    }
    return out;
}

/// The ms since 1970 s says, at most 15 digits of them.
fn millis_of(s: str) -> i64 {
    var n: i64 = 0;
    var digits: u32 = 0;
    for c in s.bytes() {
        if c.* >= '0' and c.* <= '9' and digits < 15 {
            n = n * 10 + (c.* - '0') as i64;
            digits += 1;
        }
    }
    return n;
}

/// The app's now-millis: fixed, when it is not -1; else the clock's.
fn millis_now(clock: &std.Clock, fixed: i64) -> i64 {
    if fixed >= 0 {
        return fixed;
    }
    return (clock.unix_ns() / 1000000) as i64;
}

/// Runs an app as Nimadir's headless runner does, and says the same: its
/// init's logs, then each frame's input, page, widgets, logs, the frame it
/// asks for, and where it goes. A limit that stops it is said, and the
/// status is 3.
fn run_app(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    let path = sys.args.get(2);
    var frames: u32 = 2;
    var script = alloc.List(At).init(a);
    var inputs = alloc.List(At).init(a);
    var submits = alloc.List(At).init(a);
    var dom_clicks = alloc.List(At).init(a);
    var dom_typed = alloc.List(At).init(a);
    var dom_enters = alloc.List(At).init(a);
    var denied = alloc.List(alloc.String).init(a);
    var added = alloc.List(alloc.String).init(a);
    var registry = alloc.List(Entry).init(a);
    var use_jit = false;
    var confirm = false;
    var who = Who { locale: alloc.String.from("en-US", a), time_zone: alloc.String.init(a), utc_offset: 0, share: alloc.String.init(a) };
    // The app's now-millis, the time of day standing still at it, as a
    // phone's tests have it (arche-os docs/sprints.md T7): a calendar's
    // month the same whenever the run is; -1 for the clock's.
    var fixed_ms: i64 = -1;
    var i: usize = 3;
    while i < sys.args.len() : (i += 1) {
        let arg = sys.args.get(i);
        let more = i + 1 < sys.args.len();
        if arg.eq("--frames") and more {
            frames = number(sys.args.get(i + 1));
            i += 1;
        } else if arg.eq("--script") and more {
            pairs(sys.args.get(i + 1), out: &mut script, a);
            i += 1;
        } else if arg.eq("--input") and more {
            typed(sys.args.get(i + 1), out: &mut inputs, a);
            i += 1;
        } else if arg.eq("--submit") and more {
            pairs(sys.args.get(i + 1), out: &mut submits, a);
            i += 1;
        } else if arg.eq("--click") and more {
            pairs(sys.args.get(i + 1), out: &mut dom_clicks, a);
            i += 1;
        } else if arg.eq("--type") and more {
            typed(sys.args.get(i + 1), out: &mut dom_typed, a);
            i += 1;
        } else if arg.eq("--enter") and more {
            pairs(sys.args.get(i + 1), out: &mut dom_enters, a);
            i += 1;
        } else if arg.eq("--registry") and more {
            let text = match sys.fs.read_file(sys.args.get(i + 1), a) {
                ok(x) => { x }
                err(_) => {
                    sys.stderr.write("arche-wasm: cannot read the registry\n");
                    sys.proc.exit(1);
                }
            };
            registry = read_registry(text.view(), a: a);
            i += 1;
        } else if arg.eq("--deny") and more {
            denied.push(alloc.String.from(sys.args.get(i + 1), a));
            i += 1;
        } else if arg.eq("--add") and more {
            added.push(alloc.String.from(sys.args.get(i + 1), a));
            i += 1;
        } else if arg.eq("--locale") and more {
            who.locale = alloc.String.from(sys.args.get(i + 1), a);
            i += 1;
        } else if arg.eq("--time-zone") and more {
            who.time_zone = alloc.String.from(sys.args.get(i + 1), a);
            i += 1;
        } else if arg.eq("--utc-offset") and more {
            let text = sys.args.get(i + 1);
            if text.starts_with("-") {
                who.utc_offset = 0 - number(text[1..text.len()]) as i32;
            } else {
                who.utc_offset = number(text) as i32;
            }
            i += 1;
        } else if arg.eq("--share") and more {
            who.share = alloc.String.from(sys.args.get(i + 1), a);
            i += 1;
        } else if arg.eq("--now-millis") and more {
            fixed_ms = millis_of(sys.args.get(i + 1));
            i += 1;
        } else if arg.eq("--jit") {
            use_jit = true;
        } else if arg.eq("--confirm") {
            confirm = true;
        } else {
            try usage(sys);
        }
    }
    let clock = &sys.clock;
    let now = fn [clock] () -> u64 { return clock.monotonic_ns(); };
    let out = &mut sys.stdout;
    var store = new_store(use_jit, a: a);
    var why = alloc.String.init(a);
    var title = alloc.String.init(a);
    var source = resolve(path, registry: &registry, title: &mut title, a: a);
    if not sys.fs.exists(source.view()) {
        source = alloc.String.from(path, a);
    }
    var app = match start_app(&sys.fs, source: source.view(), store: &mut store, now: &now, now_ms: millis_now(&sys.clock, fixed: fixed_ms), who: &who, registry: &registry, denied: &denied, added: &added, why: &mut why, a: a) {
        some(s) => {
            out.write("loaded ");
            out.write_u64(s.size);
            out.write(" bytes of wasm from ");
            out.write(source.view());
            out.write("\n");
            s.app
        }
        none => {
            out.flush();
            if why.view().starts_with("stopped: ") {
                out.write(why.view());
                out.write("\n");
                out.flush();
                sys.proc.exit(3);
            }
            sys.stderr.write("arche-wasm: ");
            sys.stderr.write(why.view());
            sys.stderr.write("\n");
            sys.proc.exit(1);
        }
    };
    write_logs(out, ui: &mut app.ui, indent: "");
    out.write("\n=== headless run: ");
    out.write_u64(frames as u64);
    out.write(" frames ===\n");
    var frame: u32 = 0;
    while frame < frames : (frame += 1) {
        // What the user does to the tree comes before the frame, so the app
        // finds it in events() as it runs.
        var acted = alloc.String.init(a);
        for n in at_frame(&dom_clicks, frame: frame, a: a).items() {
            nimadir.click_node(&mut app.ui, n: n.*);
            acted.push_str("   [tap] #");
            acted.push_u64(n.* as u64);
            acted.push_str("\n");
        }
        for t in dom_typed.items() {
            if t.frame == frame {
                nimadir.type_text(&mut app.ui, n: t.n, text: t.text.view());
                acted.push_str("   [type] #");
                acted.push_u64(t.n as u64);
                acted.push_str(" = ");
                quote(t.text.view(), out: &mut acted);
                acted.push_str("\n");
            }
        }
        for n in at_frame(&dom_enters, frame: frame, a: a).items() {
            nimadir.submit_node(&mut app.ui, n: n.*);
            acted.push_str("   [enter] #");
            acted.push_u64(n.* as u64);
            acted.push_str("\n");
        }
        for t in inputs.items() {
            if t.frame == frame {
                nimadir.set_field(&mut app.ui, i: t.n, text: t.text.view());
            }
        }
        let clicks = at_frame(&script, frame: frame, a: a);
        for b in clicks.items() {
            nimadir.tap(&mut app.ui, i: b.*);
        }
        for f in at_frame(&submits, frame: frame, a: a).items() {
            nimadir.submit_field(&mut app.ui, i: f.*);
        }
        nimadir.begin_frame(&mut app.ui);
        app.ui.now_ms = millis_now(&sys.clock, fixed: fixed_ms);
        match nimadir.run(&mut app, &mut store, &now, name: "update", budget_ns: nimadir.FRAME_BUDGET_NS) {
            ok(_) => { }
            err(e) => {
                out.write("stopped: ");
                out.write(exec.message(e));
                out.write("\n");
                out.flush();
                sys.proc.exit(3);
            }
        }
        // Where the app asked to go, or the link it was tapped on.
        var asks = alloc.String.init(a);
        var nav = alloc.String.init(a);
        var drawn = alloc.String.init(a);
        nimadir.write_frame(&app.ui, out: &mut drawn);
        let frame_after = app.ui.frame_after;
        var logs = alloc.String.init(a);
        for l in nimadir.logs_of(&app.ui) {
            logs.push_str("   [wasm log] ");
            logs.push_str(l.view());
            logs.push_str("\n");
        }
        nimadir.clear_logs(&mut app.ui);
        // What the app asked of the functions added to its world.
        for k in nimadir.take_calls(&mut app.ui, a: a).items() {
            logs.push_str("   [call] ");
            logs.push_str(k.instance.view());
            logs.push_str("#");
            logs.push_str(k.func.view());
            logs.push_str("(");
            var first = true;
            for v in k.args.items() {
                if not first {
                    logs.push_str(", ");
                }
                first = false;
                say_val(v, out: &mut logs);
            }
            logs.push_str(")\n");
        }
        if app.ui.open_request.len() > 0 {
            let asked = alloc.String.from(app.ui.open_request.view(), a);
            app.ui.open_request = alloc.String.init(a);
            var to_title = alloc.String.init(a);
            let target = resolve(asked.view(), registry: &registry, title: &mut to_title, a: a);
            var listed = false;
            for e in registry.items() {
                if e.source.view().eq(target.view()) {
                    listed = true;
                }
            }
            // The start page goes where its user typed; anywhere else, an app
            // does not take the user somewhere unlisted on its own say.
            var go = listed or title.view().eq("store");
            if not go {
                asks.push_str("   [asks] ");
                asks.push_str(title.view());
                asks.push_str(" wants to open ");
                asks.push_str(target.view());
                asks.push_str("\n");
                if confirm {
                    asks.push_str("   [opened]\n");
                    go = true;
                } else {
                    asks.push_str("   [declined]\n");
                }
            }
            if go {
                var next_store = new_store(use_jit, a: a);
                var no = alloc.String.init(a);
                match start_app(&sys.fs, source: target.view(), store: &mut next_store, now: &now, now_ms: millis_now(&sys.clock, fixed: fixed_ms), who: &who, registry: &registry, denied: &denied, added: &added, why: &mut no, a: a) {
                    some(s) => {
                        app = s.app;
                        store = next_store;
                        title = to_title;
                        // The frame drawn was the app that left's.
                        drawn = alloc.String.init(a);
                        logs = alloc.String.init(a);
                        for l in nimadir.logs_of(&app.ui) {
                            logs.push_str("   [wasm log] ");
                            logs.push_str(l.view());
                            logs.push_str("\n");
                        }
                        nimadir.clear_logs(&mut app.ui);
                        nav.push_str("   [nav] loaded ");
                        nav.push_u64(s.size);
                        nav.push_str(" bytes of wasm from ");
                        nav.push_str(target.view());
                        nav.push_str("\n");
                    }
                    none => {
                        nav.push_str("   [nav failed] ");
                        nav.push_str(no.view());
                        nav.push_str("\n");
                    }
                }
            }
        }
        out.write("\n--- frame ");
        out.write_u64(frame as u64);
        out.write("  (clicks fed to guest: [");
        var k: usize = 0;
        while k < clicks.len() : (k += 1) {
            if k > 0 {
                out.write(", ");
            }
            out.write_u64(clicks.items()[k] as u64);
        }
        out.write("]) ---\n");
        out.write(acted.view());
        if nimadir.has_page(&app.ui) {
            out.write("   [page] ");
            out.write_u64(nimadir.live_nodes(&app.ui) as u64);
            out.write(" nodes\n");
            var page = alloc.String.init(a);
            nimadir.write_outline(&app.ui, n: 1, depth: 0, out: &mut page);
            out.write(page.view());
        }
        out.write(drawn.view());
        out.write(logs.view());
        if frame_after != nimadir.NONE and nav.len() == 0 {
            out.write("   [next frame in ");
            out.write_u64(frame_after as u64);
            out.write(" ms]\n");
        }
        out.write(asks.view());
        out.write(nav.view());
    }
    out.flush();
}

fn new_store(use_jit: bool, a: alloc.Allocator) -> exec.Store {
    var store = exec.new_store(nimadir.limits(), a);
    if use_jit {
        let code = code_region();
        if code != 0 {
            exec.enable_jit(&mut store, base: code, size: JIT_SIZE);
        }
    }
    return store;
}

/// s in quotes, as Rust's Debug quotes it.
fn quote(s: str, out: &mut alloc.String) {
    out.push_str("\"");
    let b = s.bytes();
    var at: usize = 0;
    var i: usize = 0;
    while i < b.len() : (i += 1) {
        if b[i] == '"' or b[i] == '\\' or b[i] == '\n' {
            out.push_str(s[at..i]);
            if b[i] == '\n' {
                out.push_str("\\n");
            } else {
                out.push_str("\\");
                out.push_ascii(b[i]);
            }
            at = i + 1;
        }
    }
    out.push_str(s[at..b.len()]);
    out.push_str("\"");
}

/// A component's first core module, written out: its sections walked, the
/// first of id 1 taken.
fn first_core_module(sys: &mut std.System) -> !void {
    let bytes = try sys.fs.read_bytes(sys.args.get(2), sys.alloc);
    let b = bytes.items();
    var at: usize = 8;
    while at < b.len() {
        let id = b[at];
        at += 1;
        var size: u64 = 0;
        var shift: u64 = 0;
        while at < b.len() {
            let x = b[at];
            at += 1;
            size = size | (((x & 0x7F) as u64) << shift);
            shift += 7;
            if (x & 0x80) == 0 {
                break;
            }
        }
        if at + size as usize > b.len() {
            break;
        }
        if id == 1 {
            try sys.fs.write_bytes(sys.args.get(3), b[at..at + size as usize]);
            return;
        }
        at += size as usize;
    }
    sys.stderr.write("arche-wasm: no core module in the component\n");
    sys.proc.exit(1);
}

fn is_wit(name: str) -> bool {
    return name.len() > 4 and name[name.len() - 4..name.len()].eq(".wit");
}

/// The .wit files of dir, in order of their names, onto texts.
fn wit_files(fs: &std.Fs, dir: str, texts: &mut alloc.List(alloc.String), a: alloc.Allocator) -> !void {
    let names = try fs.list(dir, a);
    for n in names.items() {
        if is_wit(n.view()) {
            var path = alloc.String.from(dir, a);
            path.push_str("/");
            path.push_str(n.view());
            texts.push(try fs.read_file(path.view(), a));
        }
    }
}

/// The WIT at path: a file, or a directory as wit-bindgen reads one: what
/// its deps/ has first, a directory of .wit files or one, then its own
/// .wit files.
fn wit_texts(fs: &std.Fs, path: str, a: alloc.Allocator) -> !alloc.List(alloc.String) {
    var texts = alloc.List(alloc.String).init(a);
    match fs.list(path, a) {
        ok(_) => { }
        err(_) => {
            texts.push(try fs.read_file(path, a));
            return texts;
        }
    }
    var deps = alloc.String.from(path, a);
    deps.push_str("/deps");
    match fs.list(deps.view(), a) {
        ok(names) => {
            for n in names.items() {
                var sub = alloc.String.from(deps.view(), a);
                sub.push_str("/");
                sub.push_str(n.view());
                match fs.list(sub.view(), a) {
                    ok(_) => { try wit_files(fs, dir: sub.view(), texts: &mut texts, a: a); }
                    err(_) => {
                        if is_wit(n.view()) {
                            texts.push(try fs.read_file(sub.view(), a));
                        }
                    }
                }
            }
        }
        err(_) => { }
    }
    try wit_files(fs, dir: path, texts: &mut texts, a: a);
    return texts;
}

/// The component of a core module built for a world of a WIT package.
fn make_component(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    let core = try sys.fs.read_bytes(sys.args.get(2), a);
    let texts = try wit_texts(&sys.fs, path: sys.args.get(3), a: a);
    var why = alloc.String.init(a);
    let w = match wit.parse_all(&texts, why: &mut why, a: a) {
        some(x) => { x }
        none => {
            sys.stderr.write("arche-wasm: ");
            sys.stderr.write(sys.args.get(3));
            sys.stderr.write(": ");
            sys.stderr.write(why.view());
            sys.stderr.write("\n");
            sys.proc.exit(1);
        }
    };
    let world = wit.world_named(&w, name: sys.args.get(4));
    if world == component.NONE {
        sys.stderr.write("arche-wasm: no world of that name\n");
        sys.proc.exit(1);
    }
    let out = encode.component(core.items(), w: &w, world: world, why: &mut why, a: a);
    if why.len() > 0 {
        sys.stderr.write("arche-wasm: ");
        sys.stderr.write(why.view());
        sys.stderr.write("\n");
        sys.proc.exit(1);
    }
    try sys.fs.write_bytes(sys.args.get(5), out.items());
}

/// The modules of what a world imports, written into a directory, made
/// if need be.
fn make_bindings(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    let texts = try wit_texts(&sys.fs, path: sys.args.get(2), a: a);
    var why = alloc.String.init(a);
    let w = match wit.parse_all(&texts, why: &mut why, a: a) {
        some(x) => { x }
        none => {
            sys.stderr.write("arche-wasm: ");
            sys.stderr.write(sys.args.get(2));
            sys.stderr.write(": ");
            sys.stderr.write(why.view());
            sys.stderr.write("\n");
            sys.proc.exit(1);
        }
    };
    let world = wit.world_named(&w, name: sys.args.get(3));
    if world == component.NONE {
        sys.stderr.write("arche-wasm: no world of that name\n");
        sys.proc.exit(1);
    }
    let files = bindgen.generate(&w, world: world, why: &mut why, a: a);
    if why.len() > 0 {
        sys.stderr.write("arche-wasm: ");
        sys.stderr.write(why.view());
        sys.stderr.write("\n");
        sys.proc.exit(1);
    }
    let dir = sys.args.get(4);
    if not sys.fs.exists(dir) {
        try sys.fs.make_dir(dir);
    }
    for f in files.items() {
        var path = alloc.String.from(dir, a);
        path.push_str("/");
        path.push_str(f.name.view());
        try sys.fs.write_file(path: path.view(), data: f.text.view());
    }
}

fn component_error(e: component.ComponentError) -> str {
    match e {
        .Malformed => { return "malformed"; }
        .Unsupported => { return "uses what this runtime does not support yet"; }
        .Invalid => { return "invalid"; }
        .Unlinkable => { return "imports what the shell does not give"; }
        .Trapped => { return "trapped while starting"; }
    }
}

/// Serves HTTPS, each request answered by the handler module (serve.arche),
/// a worker per processor, each with its own instance.
fn serve_handler(sys: &mut std.System) -> !void {
    let bytes = try sys.fs.read_bytes(sys.args.get(2), sys.alloc);
    let port = number(sys.args.get(3)) as u16;
    let plain = sys.args.get(4).eq("--plain");
    var rest: usize = 6;
    if plain {
        rest = 5;
    }
    if sys.args.len() != rest and sys.args.len() != rest + 1 {
        try usage(sys);
    }
    var listener = try sys.net.listen(std.Address { ip: [127, 0, 0, 1], port: port });
    var config = tls.ServerConfig.init(sys.alloc);
    if not plain {
        let chain = try sys.fs.read_file(sys.args.get(4), sys.alloc);
        try config.certificates_pem(chain.view(), sys.alloc);
        let key = try sys.fs.read_file(sys.args.get(5), sys.alloc);
        try config.private_key_pem(key.view(), sys.alloc);
        config.accept_protocol("h2");
        config.accept_protocol("http/1.1");
    }
    var workers = sys.proc.cpu_count();
    if sys.args.len() == rest + 1 {
        workers = number(sys.args.get(rest));
    }
    // The module is checked before any worker starts.
    var first = match serve.load(bytes.items(), sys.alloc) {
        ok(h) => { h }
        err(e) => {
            sys.stderr.write("arche-wasm: the handler cannot be loaded: ");
            if e == serve.LoadError.Unlinkable {
                sys.stderr.write("it imports what the server does not give");
            } else if e == serve.LoadError.NoExports {
                sys.stderr.write("it does not export memory, alloc and handle");
            } else {
                sys.stderr.write("it is not a valid module");
            }
            sys.stderr.write("\n");
            sys.proc.exit(1);
        }
    };
    sys.proc.ignore_broken_pipe();
    let worker = sys.proc.workers(workers);
    _ = worker;
    if worker == 0 {
        sys.stdout.write("ready\n");
        sys.stdout.flush();
    }
    let clock = &sys.clock;
    let now = fn [clock] () -> u64 { return clock.monotonic_ns(); };
    var handler = first;
    var restarts: u64 = 0;
    let module = bytes.items();
    let out = &mut sys.stderr;
    let a = sys.alloc;
    let answer = fn [&mut handler, &now, clock, module, &mut restarts, out, a](req: &http.Request, resp: &mut http.Response) {
        handler.imports.now_ms = (clock.unix_ns() / 1000000) as i64;
        let got = serve.run(&mut handler, now: &now, method: req.method.view(), target: req.target.view(), body: req.body.items(), a: resp.alloc);
        if handler.imports.log.len() > 0 {
            out.write(handler.imports.log.view());
            out.flush();
            handler.imports.log = alloc.String.init(a);
        }
        if got.trapped {
            resp.status = 503;
            resp.headers.add(name: "content-type", value: "text/plain");
            resp.write("the handler stopped: ");
            resp.write(got.why.view());
            resp.write("\n");
            // A new instance: what the stopped one was in the middle of is
            // not to be trusted.
            match serve.load(module, a) {
                ok(h) => { handler = h; }
                err(_) => { }
            }
            restarts += 1;
            return;
        }
        resp.status = got.status;
        resp.headers.add(name: "content-type", value: got.content_type.view());
        resp.write_bytes(got.body.items());
    };
    if plain {
        try server.serve(&listener, handler: &answer, options: server.Options.init(), proc: &sys.proc, sys.alloc);
        return;
    }
    try server.serve_tls(&listener, config: &config, handler: &answer, options: server.Options.init(), proc: &sys.proc, seeds: random.Csprng.init(&mut sys.rand), sys.alloc);
}
