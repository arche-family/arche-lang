/// The store, instantiation and the interpreter (the spec's "Execution"
/// chapter). A store holds everything instances make: functions, tables,
/// memories and globals, each by its address. The interpreter runs the code
/// validate.arche compiled, on one stack of values.
import alloc;
import core.mem as raw;
import core.ptr;
import decode;
import jit;
import module as m;
import num;
import validate as v;

/// Why a guest stopped. The first ten are the spec's traps; Deadline,
/// MemoryLimit and HostLimit are the embedder's limits (Limits); Unlinkable
/// is an import that does not fit.
pub type Trap = error {
    Unreachable,
    MemoryOutOfBounds,
    TableOutOfBounds,
    UndefinedElement,
    UninitializedElement,
    IndirectCallType,
    DivideByZero,
    IntegerOverflow,
    InvalidConversion,
    StackExhausted,
    Deadline,
    MemoryLimit,
    HostLimit,
    HostTrap,
    Unlinkable,
}

/// The spec's message for a trap, as its tests write it.
pub fn message(t: Trap) -> str {
    match t {
        .Unreachable => { return "unreachable"; }
        .MemoryOutOfBounds => { return "out of bounds memory access"; }
        .TableOutOfBounds => { return "out of bounds table access"; }
        .UndefinedElement => { return "undefined element"; }
        .UninitializedElement => { return "uninitialized element"; }
        .IndirectCallType => { return "indirect call type mismatch"; }
        .DivideByZero => { return "integer divide by zero"; }
        .IntegerOverflow => { return "integer overflow"; }
        .InvalidConversion => { return "invalid conversion to integer"; }
        .StackExhausted => { return "call stack exhausted"; }
        .Deadline => { return "deadline exceeded"; }
        .MemoryLimit => { return "memory limit exceeded"; }
        .HostLimit => { return "host limit exceeded"; }
        .HostTrap => { return "host error"; }
        .Unlinkable => { return "incompatible import"; }
    }
}

/// What the embedder gives a guest beyond itself: the bodies of the host
/// functions it imports. A guest reaches nothing else.
pub type Host = interface {
    /// Runs host function id: args are its params, results to be filled.
    fn call(self: &mut Self, store: &mut Store, id: u32, args: []u64, results: []mut u64) -> Trap!void;
}

// A deadline's clock is the embedder's: invoke takes it as a closure that
// gives nanoseconds, and looks every Limits.tick_every calls and loop turns.
// The engine reads no clock itself.

/// What one store allows its guests.
pub type Limits = struct {
    /// The most bytes one memory may hold. memory.grow past it traps with
    /// MemoryLimit when trap is set, and gives -1 otherwise.
    pub memory_bytes: u64,
    pub trap: bool,
    /// The most table elements one table may hold.
    pub table_elems: u64,
    /// Slots of the value stack, and calls deep.
    pub stack_values: u32,
    pub frames: u32,
    /// Calls and loop turns between two looks at the clock.
    pub tick_every: u32,
}

pub fn default_limits() -> Limits {
    return Limits { memory_bytes: 1 << 30, trap: false, table_elems: 10000000, stack_values: 1 << 20, frames: 30000, tick_every: 10000 };
}

/// An import or export: what kind of thing, and its address.
pub type Extern = struct {
    pub kind: u8,
    pub addr: u32,
}

pub type FuncInst = struct {
    pub type_id: u32,
    pub host: bool,
    /// A guest's: its instance and its index in that module. A host's: the
    /// id Host.call is given.
    pub instance: u32,
    pub index: u32,
}

pub type TableInst = struct {
    pub elem: u8,
    pub items: alloc.List(u64),
    pub max: u64,
    pub has_max: bool,
}

pub type MemInst = struct {
    pub data: alloc.List(u8),
    /// The most pages it may have: its type's, or the store's limit.
    pub max_pages: u64,
    pub type_max: u64,
    pub has_max: bool,
}

pub type GlobalInst = struct {
    pub ty: u8,
    pub mutable: bool,
    pub value: u64,
}

pub type Instance = struct {
    pub module: u32,
    pub types: alloc.List(u32),
    pub funcs: alloc.List(u32),
    pub tables: alloc.List(u32),
    pub memories: alloc.List(u32),
    pub globals: alloc.List(u32),
    pub elems: alloc.List(alloc.List(u64)),
    pub dropped: alloc.List(bool),
    pub exports: alloc.List(Extern),
}

/// A call the interpreter will return to.
type Frame = struct {
    instance: u32,
    func: u32,
    pc: u32,
    fp: u32,
}

pub type Store = struct {
    pub modules: alloc.List(m.Module),
    pub instances: alloc.List(Instance),
    pub types: alloc.List(m.FuncType),
    pub funcs: alloc.List(FuncInst),
    pub tables: alloc.List(TableInst),
    pub memories: alloc.List(MemInst),
    pub globals: alloc.List(GlobalInst),
    pub limits: Limits,
    stack: alloc.List(u64),
    sp: usize,
    frames: alloc.List(Frame),
    fuel: u32,
    /// When the guest must have stopped, by the clock invoke is given; 0 for
    /// never. The embedder sets it before a call.
    pub deadline_ns: u64,
    /// The JIT's: the region of machine code (its address, size and what is
    /// used), the exit stub's offset, the context, and for each function of
    /// the store its compiled code's index, or NONE.
    jit_on: bool,
    jit_base: u64,
    jit_size: u64,
    jit_used: u64,
    jit_exit: u32,
    jit_ctx: alloc.List(u64),
    jit_index: alloc.List(u32),
    jit_code: alloc.List(jit.Compiled),
    /// How often machine code ran, and how many instructions it gave back
    /// to the interpreter.
    pub jit_runs: u64,
    pub jit_slow: u64,
    a: alloc.Allocator,
}

const NONE: u32 = 0xFFFFFFFF;

pub fn new_store(limits: Limits, a: alloc.Allocator) -> Store {
    var s = Store {
        modules: alloc.List(m.Module).init(a),
        instances: alloc.List(Instance).init(a),
        types: alloc.List(m.FuncType).init(a),
        funcs: alloc.List(FuncInst).init(a),
        tables: alloc.List(TableInst).init(a),
        memories: alloc.List(MemInst).init(a),
        globals: alloc.List(GlobalInst).init(a),
        limits: limits,
        stack: alloc.List(u64).with_capacity(a, n: limits.stack_values as usize),
        sp: 0,
        frames: alloc.List(Frame).init(a),
        fuel: limits.tick_every,
        deadline_ns: 0,
        jit_on: false,
        jit_base: 0,
        jit_size: 0,
        jit_used: 0,
        jit_exit: 0,
        jit_ctx: alloc.List(u64).init(a),
        jit_index: alloc.List(u32).init(a),
        jit_code: alloc.List(jit.Compiled).init(a),
        jit_runs: 0,
        jit_slow: 0,
        a: a,
    };
    s.stack.grow_zeroed(limits.stack_values as usize);
    // Memory 0 is no memory: what an instance without one reads.
    s.memories.push(MemInst { data: alloc.List(u8).init(a), max_pages: 0, type_max: 0, has_max: true });
    return s;
}

/// Loads, validates and keeps a module; its index in the store.
pub fn add_module(s: &mut Store, bytes: []u8) -> m.LoadError!u32 {
    var mod = try decode.decode(bytes, s.a);
    try v.validate(&mut mod, s.a);
    s.modules.push(mod);
    return (s.modules.len() - 1) as u32;
}

fn intern(s: &mut Store, params: []u8, results: []u8) -> u32 {
    var i: usize = 0;
    while i < s.types.len() : (i += 1) {
        let t = &s.types.items()[i];
        if m.same_types(x: t.params.items(), y: params) and m.same_types(x: t.results.items(), y: results) {
            return i as u32;
        }
    }
    var t = m.FuncType { params: alloc.List(u8).init(s.a), results: alloc.List(u8).init(s.a) };
    for p in params {
        t.params.push(p.*);
    }
    for r in results {
        t.results.push(r.*);
    }
    s.types.push(t);
    return (s.types.len() - 1) as u32;
}

/// A host function of this type; Host.call runs it with id.
pub fn add_host_func(s: &mut Store, params: []u8, results: []u8, id: u32) -> u32 {
    let t = intern(s, params: params, results: results);
    s.funcs.push(FuncInst { type_id: t, host: true, instance: 0, index: id });
    s.jit_index.push(NONE);
    return (s.funcs.len() - 1) as u32;
}

pub fn add_table(s: &mut Store, elem: u8, limits: m.Limits, init: u64) -> u32 {
    var items = alloc.List(u64).init(s.a);
    var i: u64 = 0;
    while i < limits.min : (i += 1) {
        items.push(init);
    }
    var max: u64 = 0xFFFFFFFF;
    if limits.has_max {
        max = limits.max;
    }
    s.tables.push(TableInst { elem: elem, items: items, max: max, has_max: limits.has_max });
    return (s.tables.len() - 1) as u32;
}

pub fn add_memory(s: &mut Store, limits: m.Limits) -> Trap!u32 {
    var type_max = m.MAX_PAGES;
    if limits.has_max {
        type_max = limits.max;
    }
    var max = type_max;
    let cap = s.limits.memory_bytes / m.PAGE;
    if max > cap {
        max = cap;
    }
    if limits.min > max {
        return Trap.MemoryLimit;
    }
    // Room for all it may grow to, taken from the system as it is used.
    var data = alloc.List(u8).with_capacity(s.a, n: (max * m.PAGE) as usize);
    data.grow_zeroed((limits.min * m.PAGE) as usize);
    s.memories.push(MemInst { data: data, max_pages: max, type_max: type_max, has_max: limits.has_max });
    return (s.memories.len() - 1) as u32;
}

pub fn add_global(s: &mut Store, ty: u8, mutable: bool, value: u64) -> u32 {
    s.globals.push(GlobalInst { ty: ty, mutable: mutable, value: value });
    return (s.globals.len() - 1) as u32;
}

pub fn func_type(s: &Store, addr: u32) -> &m.FuncType {
    return &s.types.items()[s.funcs.items()[addr as usize].type_id as usize];
}

/// The export of this name of an instance.
pub fn export_of(s: &Store, instance: u32, name: str) -> ?Extern {
    let inst = &s.instances.items()[instance as usize];
    let mod = &s.modules.items()[inst.module as usize];
    var i: usize = 0;
    while i < mod.exports.len() : (i += 1) {
        if mod.exports.items()[i].name.view().eq(name) {
            return inst.exports.items()[i];
        }
    }
    return none;
}

fn table_limits_match(t: &TableInst, want: m.Table) -> bool {
    if t.elem != want.elem or (t.items.len() as u64) < want.limits.min {
        return false;
    }
    if want.limits.has_max and (not t.has_max or t.max > want.limits.max) {
        return false;
    }
    return true;
}

fn eval_const(s: &Store, instance: u32, c: m.Const) -> u64 {
    let inst = &s.instances.items()[instance as usize];
    if c.op == 0xD0 {
        return m.NULL_REF;
    }
    if c.op == 0xD2 {
        return inst.funcs.items()[c.value as usize] as u64;
    }
    if c.op == 0x23 {
        return s.globals.items()[inst.globals.items()[c.value as usize] as usize].value;
    }
    return c.value;
}

/// An instance of module, its imports given in the order the module lists
/// them; its index. Elements and data are written in order, then start
/// runs; a trap on the way leaves what was written before it.
pub fn instantiate(s: &mut Store, host: &mut dyn Host, now: &dyn fn() -> u64, module: u32, imports: []Extern) -> Trap!u32 {
    let a = s.a;
    var inst = Instance {
        module: module,
        types: alloc.List(u32).init(a),
        funcs: alloc.List(u32).init(a),
        tables: alloc.List(u32).init(a),
        memories: alloc.List(u32).init(a),
        globals: alloc.List(u32).init(a),
        elems: alloc.List(alloc.List(u64)).init(a),
        dropped: alloc.List(bool).init(a),
        exports: alloc.List(Extern).init(a),
    };
    let index = s.instances.len() as u32;
    // Types, as the store's.
    let ntypes = s.modules.items()[module as usize].types.len();
    var k: usize = 0;
    while k < ntypes : (k += 1) {
        var params = alloc.List(u8).init(a);
        var results = alloc.List(u8).init(a);
        for p in s.modules.items()[module as usize].types.items()[k].params.items() {
            params.push(p.*);
        }
        for r in s.modules.items()[module as usize].types.items()[k].results.items() {
            results.push(r.*);
        }
        inst.types.push(intern(s, params: params.items(), results: results.items()));
    }
    // Imports, each checked against what the module wants.
    let nimports = s.modules.items()[module as usize].imports.len();
    if imports.len() != nimports {
        return Trap.Unlinkable;
    }
    k = 0;
    while k < nimports : (k += 1) {
        let imp = &s.modules.items()[module as usize].imports.items()[k];
        let given = imports[k];
        if given.kind != imp.kind {
            return Trap.Unlinkable;
        }
        let mod = &s.modules.items()[module as usize];
        if imp.kind == m.EXTERN_FUNC {
            let want = inst.types.items()[mod.funcs.items()[imp.index as usize].type_index as usize];
            if s.funcs.items()[given.addr as usize].type_id != want {
                return Trap.Unlinkable;
            }
            inst.funcs.push(given.addr);
        } else if imp.kind == m.EXTERN_TABLE {
            if not table_limits_match(&s.tables.items()[given.addr as usize], want: mod.tables.items()[imp.index as usize]) {
                return Trap.Unlinkable;
            }
            inst.tables.push(given.addr);
        } else if imp.kind == m.EXTERN_MEMORY {
            let have = &s.memories.items()[given.addr as usize];
            let want = mod.memories.items()[imp.index as usize].limits;
            if (have.data.len() as u64) / m.PAGE < want.min {
                return Trap.Unlinkable;
            }
            if want.has_max and (not have.has_max or have.type_max > want.max) {
                return Trap.Unlinkable;
            }
            inst.memories.push(given.addr);
        } else {
            let g = s.globals.items()[given.addr as usize];
            let want = mod.globals.items()[imp.index as usize];
            if g.ty != want.ty or g.mutable != want.mutable {
                return Trap.Unlinkable;
            }
            inst.globals.push(given.addr);
        }
    }
    // The module's own functions, tables, memories and globals.
    let nfuncs = s.modules.items()[module as usize].funcs.len();
    k = 0;
    while k < nfuncs : (k += 1) {
        let f = &s.modules.items()[module as usize].funcs.items()[k];
        if not f.imported {
            let t = inst.types.items()[f.type_index as usize];
            s.funcs.push(FuncInst { type_id: t, host: false, instance: index, index: k as u32 });
            s.jit_index.push(NONE);
            inst.funcs.push((s.funcs.len() - 1) as u32);
        }
    }
    let ntables = s.modules.items()[module as usize].tables.len();
    k = 0;
    while k < ntables : (k += 1) {
        let t = s.modules.items()[module as usize].tables.items()[k];
        if not t.imported {
            if t.limits.min > s.limits.table_elems {
                return Trap.HostLimit;
            }
            inst.tables.push(add_table(s, elem: t.elem, t.limits, init: m.NULL_REF));
        }
    }
    let nmems = s.modules.items()[module as usize].memories.len();
    k = 0;
    while k < nmems : (k += 1) {
        let mem = s.modules.items()[module as usize].memories.items()[k];
        if not mem.imported {
            inst.memories.push(try add_memory(s, mem.limits));
        }
    }
    // Globals: imported ones are all an initializer may read.
    s.instances.push(inst);
    let nglobals = s.modules.items()[module as usize].globals.len();
    k = 0;
    while k < nglobals : (k += 1) {
        let g = s.modules.items()[module as usize].globals.items()[k];
        if not g.imported {
            let value = eval_const(s, instance: index, g.init);
            let addr = add_global(s, ty: g.ty, mutable: g.mutable, value: value);
            s.instances.items_mut()[index as usize].globals.push(addr);
        }
    }
    // Exports.
    let nexports = s.modules.items()[module as usize].exports.len();
    k = 0;
    while k < nexports : (k += 1) {
        let e = &s.modules.items()[module as usize].exports.items()[k];
        let inst_ref = &s.instances.items()[index as usize];
        var addr: u32 = 0;
        if e.kind == m.EXTERN_FUNC {
            addr = inst_ref.funcs.items()[e.index as usize];
        } else if e.kind == m.EXTERN_TABLE {
            addr = inst_ref.tables.items()[e.index as usize];
        } else if e.kind == m.EXTERN_MEMORY {
            addr = inst_ref.memories.items()[e.index as usize];
        } else {
            addr = inst_ref.globals.items()[e.index as usize];
        }
        let kind = e.kind;
        s.instances.items_mut()[index as usize].exports.push(Extern { kind: kind, addr: addr });
    }
    if s.jit_on {
        compile_instance(s, instance: index);
    }
    // Element segments, evaluated; then the active ones written, in order.
    let nelems = s.modules.items()[module as usize].elems.len();
    k = 0;
    while k < nelems : (k += 1) {
        var values = alloc.List(u64).init(a);
        let count = s.modules.items()[module as usize].elems.items()[k].items.len();
        var i: usize = 0;
        while i < count : (i += 1) {
            let c = s.modules.items()[module as usize].elems.items()[k].items.items()[i];
            values.push(eval_const(s, instance: index, c));
        }
        s.instances.items_mut()[index as usize].elems.push(values);
    }
    let ndatas = s.modules.items()[module as usize].datas.len();
    k = 0;
    while k < ndatas : (k += 1) {
        s.instances.items_mut()[index as usize].dropped.push(false);
    }
    k = 0;
    while k < nelems : (k += 1) {
        let e = &s.modules.items()[module as usize].elems.items()[k];
        let mode = e.mode;
        if mode == m.ACTIVE {
            let offset = eval_const(s, instance: index, e.offset);
            let n = e.items.len() as u64;
            let table = e.table;
            try table_init(s, instance: index, table: table, elem: k as u32, dst: offset, src: 0, n: n);
        }
        if mode != m.PASSIVE {
            s.instances.items_mut()[index as usize].elems.items_mut()[k].clear();
        }
    }
    k = 0;
    while k < ndatas : (k += 1) {
        let d = s.modules.items()[module as usize].datas.items()[k];
        if d.mode == m.ACTIVE {
            let offset = eval_const(s, instance: index, d.offset);
            try memory_init(s, instance: index, data: k as u32, dst: offset, src: 0, n: d.len as u64);
            s.instances.items_mut()[index as usize].dropped.items_mut()[k] = true;
        }
    }
    if s.modules.items()[module as usize].has_start {
        let f = s.instances.items()[index as usize].funcs.items()[s.modules.items()[module as usize].start as usize];
        var results = alloc.List(u64).init(a);
        let none_args: [0]u64 = [];
        try invoke(s, host, now, func: f, none_args[0..0], &mut results);
    }
    return index;
}

fn table_init(s: &mut Store, instance: u32, table: u32, elem: u32, dst: u64, src: u64, n: u64) -> Trap!void {
    let taddr = s.instances.items()[instance as usize].tables.items()[table as usize];
    let seg_len = s.instances.items()[instance as usize].elems.items()[elem as usize].len() as u64;
    let tlen = s.tables.items()[taddr as usize].items.len() as u64;
    if src + n > seg_len or dst + n > tlen {
        return Trap.TableOutOfBounds;
    }
    var i: u64 = 0;
    while i < n : (i += 1) {
        let value = s.instances.items()[instance as usize].elems.items()[elem as usize].items()[(src + i) as usize];
        s.tables.items_mut()[taddr as usize].items.items_mut()[(dst + i) as usize] = value;
    }
}

fn memory_init(s: &mut Store, instance: u32, data: u32, dst: u64, src: u64, n: u64) -> Trap!void {
    let maddr = s.instances.items()[instance as usize].memories.items()[0];
    let inst = &s.instances.items()[instance as usize];
    let d = s.modules.items()[inst.module as usize].datas.items()[data as usize];
    var len = d.len as u64;
    if inst.dropped.items()[data as usize] {
        len = 0;
    }
    let mem = s.memories.items_mut()[maddr as usize].data.items_mut();
    if src + n > len or dst + n > mem.len() as u64 {
        return Trap.MemoryOutOfBounds;
    }
    let bytes = s.modules.items()[inst.module as usize].bytes.items();
    var i: u64 = 0;
    while i < n : (i += 1) {
        mem[(dst + i) as usize] = bytes[d.start + (src + i) as usize];
    }
}

/// Runs function addr with args, its results into results.
pub fn invoke(s: &mut Store, host: &mut dyn Host, now: &dyn fn() -> u64, func: u32, args: []u64, results: &mut alloc.List(u64)) -> Trap!void {
    results.clear();
    let base_sp = s.sp;
    let base_frames = s.frames.len();
    let t = s.funcs.items()[func as usize].type_id;
    let np = s.types.items()[t as usize].params.len();
    let nr = s.types.items()[t as usize].results.len();
    if base_sp + np + nr + 1 >= s.stack.len() {
        return Trap.StackExhausted;
    }
    var i: usize = 0;
    while i < np : (i += 1) {
        s.stack.items_mut()[base_sp + i] = args[i];
    }
    s.sp = base_sp + np;
    match run(s, host, now, func: func) {
        ok(_) => { }
        err(e) => {
            s.sp = base_sp;
            while s.frames.len() > base_frames {
                _ = s.frames.pop();
            }
            return e;
        }
    }
    i = 0;
    while i < nr : (i += 1) {
        results.push(s.stack.items()[base_sp + i]);
    }
    s.sp = base_sp;
}

/// A host function's call: its args are the top of the stack, its results
/// take their place.
fn call_host(s: &mut Store, host: &mut dyn Host, func: u32) -> Trap!void {
    let f = s.funcs.items()[func as usize];
    let np = s.types.items()[f.type_id as usize].params.len();
    let nr = s.types.items()[f.type_id as usize].results.len();
    var args = alloc.List(u64).init(s.a);
    var results = alloc.List(u64).init(s.a);
    let base = s.sp - np;
    var i: usize = 0;
    while i < np : (i += 1) {
        args.push(s.stack.items()[base + i]);
    }
    results.grow_zeroed(nr);
    if base + nr >= s.stack.len() {
        return Trap.StackExhausted;
    }
    try host.call(s, id: f.index, args.items(), results.items_mut());
    i = 0;
    while i < nr : (i += 1) {
        s.stack.items_mut()[base + i] = results.items()[i];
    }
    s.sp = base + nr;
}

const EVENT_CALL: u32 = 1;
const EVENT_RETURN: u32 = 2;
const EVENT_GROW: u32 = 3;
const EVENT_TICK: u32 = 4;
const EVENT_TABLE: u32 = 5;
const EVENT_MEMORY: u32 = 6;

fn load(mem: []u8, at: u64, size: u32) -> Trap!u64 {
    if at + size as u64 > mem.len() as u64 {
        return Trap.MemoryOutOfBounds;
    }
    let p = at as usize;
    var r: u64 = 0;
    var i: u32 = 0;
    while i < size : (i += 1) {
        r = r | ((mem[p + i as usize] as u64) << (8 * i));
    }
    return r;
}

fn store_le(mem: []mut u8, at: u64, size: u32, value: u64) -> Trap!void {
    if at + size as u64 > mem.len() as u64 {
        return Trap.MemoryOutOfBounds;
    }
    let p = at as usize;
    var i: u32 = 0;
    while i < size : (i += 1) {
        mem[p + i as usize] = ((value >> (8 * i)) & 0xFF) as u8;
    }
}

fn sext(x: u64, bits: u32) -> u64 {
    let shift = 64 - bits;
    return ((x << shift) as% i64 >> shift) as% u64;
}

/// Calls func, whose args are on the stack, and runs until it returns.
fn run(s: &mut Store, host: &mut dyn Host, now: &dyn fn() -> u64, func: u32) -> Trap!void {
    let base = s.frames.len();
    var event = EVENT_CALL;
    var target = func;
    var inst: u32 = 0;
    var fi: u32 = 0;
    var pc: usize = 0;
    var fp: usize = 0;
    var sp = s.sp;
    var grow_by: u64 = 0;
    // One instruction in the interpreter, then back to machine code.
    var single = false;
    while true {
        if event == EVENT_CALL {
            let f = s.funcs.items()[target as usize];
            if f.host {
                s.sp = sp;
                try call_host(s, host, func: target);
                sp = s.sp;
                if s.frames.len() == base {
                    return;
                }
                let back = s.frames.pop() orelse Frame { instance: 0, func: 0, pc: 0, fp: 0 };
                inst = back.instance;
                fi = back.func;
                pc = back.pc as usize;
                fp = back.fp as usize;
            } else {
                if s.frames.len() >= s.limits.frames as usize + base {
                    return Trap.StackExhausted;
                }
                let cmod = &s.modules.items()[s.instances.items()[f.instance as usize].module as usize];
                let mf = &cmod.funcs.items()[f.index as usize];
                let np = cmod.types.items()[mf.type_index as usize].params.len();
                let nl = mf.locals.len();
                if sp + nl + mf.max_height as usize + 8 >= s.stack.len() {
                    return Trap.StackExhausted;
                }
                fp = sp - np;
                var i: usize = 0;
                while i < nl : (i += 1) {
                    s.stack.items_mut()[sp + i] = 0;
                }
                sp += nl;
                inst = f.instance;
                fi = f.index;
                pc = 0;
            }
        } else if event == EVENT_RETURN {
            let rmod = &s.modules.items()[s.instances.items()[inst as usize].module as usize];
            let rf = &rmod.funcs.items()[fi as usize];
            let nr = rmod.types.items()[rf.type_index as usize].results.len();
            var i: usize = 0;
            while i < nr : (i += 1) {
                let x = s.stack.items()[sp - nr + i];
                s.stack.items_mut()[fp + i] = x;
            }
            sp = fp + nr;
            if s.frames.len() == base {
                s.sp = sp;
                return;
            }
            let back = s.frames.pop() orelse Frame { instance: 0, func: 0, pc: 0, fp: 0 };
            inst = back.instance;
            fi = back.func;
            pc = back.pc as usize;
            fp = back.fp as usize;
        } else if event == EVENT_GROW {
            let maddr = s.instances.items()[inst as usize].memories.items()[0];
            let grown = &mut s.memories.items_mut()[maddr as usize];
            let pages = grown.data.len() as u64 / m.PAGE;
            if grow_by > m.MAX_PAGES or pages + grow_by > grown.type_max {
                s.stack.items_mut()[sp - 1] = 0xFFFFFFFF;
            } else if pages + grow_by > grown.max_pages {
                if s.limits.trap {
                    return Trap.MemoryLimit;
                }
                s.stack.items_mut()[sp - 1] = 0xFFFFFFFF;
            } else {
                grown.data.grow_zeroed(((pages + grow_by) * m.PAGE) as usize);
                s.stack.items_mut()[sp - 1] = pages;
            }
        } else if event == EVENT_TICK {
            if s.deadline_ns != 0 and now() >= s.deadline_ns {
                return Trap.Deadline;
            }
            s.fuel = s.limits.tick_every;
        }
        event = 0;
        if s.jit_on and not single {
            let fa = s.instances.items()[inst as usize].funcs.items()[fi as usize];
            let ji = s.jit_index.items()[fa as usize];
            if ji != NONE {
                let resume = s.jit_code.items()[ji as usize].resume.items()[pc];
                if resume != m.UNREACHED {
                    let status = enter_jit(s, inst: inst, fp: fp, resume: resume);
                    s.jit_runs += 1;
                    pc = s.jit_ctx.items()[jit.CTX_PC as usize] as usize;
                    sp = fp + s.jit_ctx.items()[jit.CTX_SP as usize] as usize;
                    if status == jit.EXIT_CALL {
                        target = s.instances.items()[inst as usize].funcs.items()[s.jit_ctx.items()[jit.CTX_ARG as usize] as usize];
                        s.frames.push(Frame { instance: inst, func: fi, pc: pc as u32, fp: fp as u32 });
                        event = EVENT_CALL;
                    } else if status == jit.EXIT_RETURN {
                        event = EVENT_RETURN;
                    } else if status == jit.EXIT_TICK {
                        event = EVENT_TICK;
                    } else {
                        single = true;
                        s.jit_slow += 1;
                    }
                    continue;
                }
            }
        }
        // Run the current function's code until something above is needed.
        let mod = &s.modules.items()[s.instances.items()[inst as usize].module as usize];
        let code = mod.funcs.items()[fi as usize].code.items();
        let it = &s.instances.items()[inst as usize];
        var maddr: u32 = 0;
        if it.memories.len() > 0 {
            maddr = it.memories.items()[0];
        }
        let mem = s.memories.items_mut()[maddr as usize].data.items_mut();
        let st = s.stack.items_mut();
        while true {
            let op = code[pc];
            pc += 1;
            match op {
                0x207 => {
                    // OP_TICK
                    if s.fuel == 0 {
                        event = EVENT_TICK;
                        break;
                    }
                    s.fuel -= 1;
                }
                0x41 => {
                    st[sp] = code[pc] as u64;
                    pc += 1;
                    sp += 1;
                }
                0x42 => {
                    st[sp] = (code[pc] as u64) | ((code[pc + 1] as u64) << 32);
                    pc += 2;
                    sp += 1;
                }
                0x20 => {
                    st[sp] = st[fp + code[pc] as usize];
                    pc += 1;
                    sp += 1;
                }
                0x21 => {
                    sp -= 1;
                    st[fp + code[pc] as usize] = st[sp];
                    pc += 1;
                }
                0x22 => {
                    st[fp + code[pc] as usize] = st[sp - 1];
                    pc += 1;
                }
                0x23 => {
                    let g = it.globals.items()[code[pc] as usize];
                    st[sp] = s.globals.items()[g as usize].value;
                    pc += 1;
                    sp += 1;
                }
                0x24 => {
                    let g = it.globals.items()[code[pc] as usize];
                    sp -= 1;
                    s.globals.items_mut()[g as usize].value = st[sp];
                    pc += 1;
                }
                0x200 => {
                    pc = code[pc] as usize;
                }
                0x201 => {
                    let keep = code[pc + 1] as usize;
                    let h = fp + code[pc + 2] as usize;
                    var i: usize = 0;
                    while i < keep : (i += 1) {
                        st[h + i] = st[sp - keep + i];
                    }
                    sp = h + keep;
                    pc = code[pc] as usize;
                }
                0x202 => {
                    sp -= 1;
                    if st[sp] != 0 {
                        pc = code[pc] as usize;
                    } else {
                        pc += 1;
                    }
                }
                0x203 => {
                    sp -= 1;
                    if st[sp] != 0 {
                        let keep = code[pc + 1] as usize;
                        let h = fp + code[pc + 2] as usize;
                        var i: usize = 0;
                        while i < keep : (i += 1) {
                            st[h + i] = st[sp - keep + i];
                        }
                        sp = h + keep;
                        pc = code[pc] as usize;
                    } else {
                        pc += 3;
                    }
                }
                0x204 => {
                    sp -= 1;
                    if st[sp] == 0 {
                        pc = code[pc] as usize;
                    } else {
                        pc += 1;
                    }
                }
                0x205 => {
                    sp -= 1;
                    let n = code[pc] as u64;
                    var k = st[sp];
                    if k > n {
                        k = n;
                    }
                    let at = pc + 1 + 3 * k as usize;
                    let to = code[at];
                    if to == 0xFFFFFFFF {
                        event = EVENT_RETURN;
                        break;
                    }
                    let keep = code[at + 1] as usize;
                    let h = fp + code[at + 2] as usize;
                    var i: usize = 0;
                    while i < keep : (i += 1) {
                        st[h + i] = st[sp - keep + i];
                    }
                    sp = h + keep;
                    pc = to as usize;
                }
                0x206 => {
                    event = EVENT_RETURN;
                    break;
                }
                0x10 => {
                    target = it.funcs.items()[code[pc] as usize];
                    pc += 1;
                    s.frames.push(Frame { instance: inst, func: fi, pc: pc as u32, fp: fp as u32 });
                    event = EVENT_CALL;
                    break;
                }
                0x11 => {
                    let want = it.types.items()[code[pc] as usize];
                    let taddr = it.tables.items()[code[pc + 1] as usize];
                    pc += 2;
                    sp -= 1;
                    let k = st[sp];
                    let t = &s.tables.items()[taddr as usize];
                    if k >= t.items.len() as u64 {
                        return Trap.UndefinedElement;
                    }
                    let f = t.items.items()[k as usize];
                    if f == m.NULL_REF {
                        return Trap.UninitializedElement;
                    }
                    if s.funcs.items()[f as usize].type_id != want {
                        return Trap.IndirectCallType;
                    }
                    target = f as u32;
                    s.frames.push(Frame { instance: inst, func: fi, pc: pc as u32, fp: fp as u32 });
                    event = EVENT_CALL;
                    break;
                }
                0x00 => {
                    return Trap.Unreachable;
                }
                0x1A => {
                    sp -= 1;
                }
                0x1B => {
                    sp -= 2;
                    if st[sp + 1] == 0 {
                        st[sp - 1] = st[sp];
                    }
                }
                0xD0 => {
                    st[sp] = m.NULL_REF;
                    sp += 1;
                }
                0xD1 => {
                    if st[sp - 1] == m.NULL_REF {
                        st[sp - 1] = 1;
                    } else {
                        st[sp - 1] = 0;
                    }
                }
                0xD2 => {
                    st[sp] = it.funcs.items()[code[pc] as usize] as u64;
                    pc += 1;
                    sp += 1;
                }
                0x3F => {
                    st[sp] = mem.len() as u64 / m.PAGE;
                    sp += 1;
                }
                0x40 => {
                    grow_by = st[sp - 1] & 0xFFFFFFFF;
                    event = EVENT_GROW;
                    break;
                }
                0x28 | 0x29 | 0x2A | 0x2B | 0x2C | 0x2D | 0x2E | 0x2F | 0x30 | 0x31 | 0x32 | 0x33 | 0x34 | 0x35 => {
                    let at = (st[sp - 1] & 0xFFFFFFFF) + code[pc] as u64;
                    pc += 1;
                    var r: u64 = 0;
                    if op == 0x28 or op == 0x2A or op == 0x35 {
                        r = try load(mem, at: at, size: 4);
                    } else if op == 0x29 or op == 0x2B {
                        r = try load(mem, at: at, size: 8);
                    } else if op == 0x2C {
                        r = sext(try load(mem, at: at, size: 1), bits: 8) & 0xFFFFFFFF;
                    } else if op == 0x2D or op == 0x31 {
                        r = try load(mem, at: at, size: 1);
                    } else if op == 0x2E {
                        r = sext(try load(mem, at: at, size: 2), bits: 16) & 0xFFFFFFFF;
                    } else if op == 0x2F or op == 0x33 {
                        r = try load(mem, at: at, size: 2);
                    } else if op == 0x30 {
                        r = sext(try load(mem, at: at, size: 1), bits: 8);
                    } else if op == 0x32 {
                        r = sext(try load(mem, at: at, size: 2), bits: 16);
                    } else {
                        r = sext(try load(mem, at: at, size: 4), bits: 32);
                    }
                    st[sp - 1] = r;
                }
                0x36 | 0x37 | 0x38 | 0x39 | 0x3A | 0x3B | 0x3C | 0x3D | 0x3E => {
                    let value = st[sp - 1];
                    let at = (st[sp - 2] & 0xFFFFFFFF) + code[pc] as u64;
                    pc += 1;
                    sp -= 2;
                    var size: u32 = 4;
                    if op == 0x37 or op == 0x39 {
                        size = 8;
                    } else if op == 0x3A or op == 0x3C {
                        size = 1;
                    } else if op == 0x3B or op == 0x3D {
                        size = 2;
                    }
                    try store_le(mem, at: at, size: size, value: value);
                }
                _ => {
                    if op >= 0x45 and op <= 0xC4 {
                        sp = try numeric(st, sp: sp, op: op);
                    } else if op >= 0x100 and op <= 0x107 {
                        st[sp - 1] = saturate(st[sp - 1], sub: op - 0x100);
                    } else {
                        // Tables and bulk memory: off the fast path.
                        s.sp = sp;
                        event = EVENT_TABLE;
                        break;
                    }
                }
            }
            if single {
                break;
            }
        }
        single = false;
        if event == EVENT_TABLE {
            let op = code[pc - 1];
            var x: u32 = 0;
            var y: u32 = 0;
            if pc < code.len() {
                x = code[pc];
            }
            if pc + 1 < code.len() {
                y = code[pc + 1];
            }
            event = 0;
            pc = try slow_op(s, inst: inst, op: op, x: x, y: y, sp: &mut sp, pc: pc);
        }
    }
}

/// The numeric instructions, 0x45 to 0xC4, on the top of the stack; the new
/// height.
fn numeric(st: []mut u64, sp: usize, op: u32) -> Trap!usize {
    if op == 0x45 or op == 0x50 {
        if st[sp - 1] == 0 { st[sp - 1] = 1; } else { st[sp - 1] = 0; }
        return sp;
    }
    if (op >= 0x67 and op <= 0x69) or (op >= 0x79 and op <= 0x7B) or (op >= 0x8B and op <= 0x91) or (op >= 0x99 and op <= 0x9F) or op >= 0xA7 {
        st[sp - 1] = try unary(st[sp - 1], op: op);
        return sp;
    }
    let x = st[sp - 2];
    let y = st[sp - 1];
    var r: u64 = 0;
    if op <= 0x4F {
        r = compare32(x: x, y: y, op: op - 0x46);
    } else if op <= 0x5A {
        r = compare64(x: x, y: y, op: op - 0x51);
    } else if op <= 0x60 {
        r = fcompare(x: num.f32_of(x) as f64, y: num.f32_of(y) as f64, op: op - 0x5B);
    } else if op <= 0x66 {
        r = fcompare(x: num.f64_of(x), y: num.f64_of(y), op: op - 0x61);
    } else if op <= 0x78 {
        r = try binary32(a: (x & 0xFFFFFFFF) as u32, y: (y & 0xFFFFFFFF) as u32, op: op);
    } else if op <= 0x8A {
        r = try binary64(a: x, y: y, op: op);
    } else if op <= 0x98 {
        r = fbinary32(x: x, y: y, op: op);
    } else {
        r = fbinary64(x: x, y: y, op: op);
    }
    st[sp - 2] = r;
    return sp - 1;
}

fn bit(b: bool) -> u64 {
    if b {
        return 1;
    }
    return 0;
}

/// eq ne lt_s lt_u gt_s gt_u le_s le_u ge_s ge_u, from 0.
fn compare32(x: u64, y: u64, op: u32) -> u64 {
    let a = (x & 0xFFFFFFFF) as u32;
    let b = (y & 0xFFFFFFFF) as u32;
    let sa = a as% i32;
    let sb = b as% i32;
    match op {
        0 => { return bit(a == b); }
        1 => { return bit(a != b); }
        2 => { return bit(sa < sb); }
        3 => { return bit(a < b); }
        4 => { return bit(sa > sb); }
        5 => { return bit(a > b); }
        6 => { return bit(sa <= sb); }
        7 => { return bit(a <= b); }
        8 => { return bit(sa >= sb); }
        _ => { return bit(a >= b); }
    }
}

fn compare64(x: u64, y: u64, op: u32) -> u64 {
    let sa = x as% i64;
    let sb = y as% i64;
    match op {
        0 => { return bit(x == y); }
        1 => { return bit(x != y); }
        2 => { return bit(sa < sb); }
        3 => { return bit(x < y); }
        4 => { return bit(sa > sb); }
        5 => { return bit(x > y); }
        6 => { return bit(sa <= sb); }
        7 => { return bit(x <= y); }
        8 => { return bit(sa >= sb); }
        _ => { return bit(x >= y); }
    }
}

/// eq ne lt gt le ge, from 0. An f32 compares the same as a double.
fn fcompare(x: f64, y: f64, op: u32) -> u64 {
    match op {
        0 => { return bit(x == y); }
        1 => { return bit(x != y); }
        2 => { return bit(x < y); }
        3 => { return bit(x > y); }
        4 => { return bit(x <= y); }
        _ => { return bit(x >= y); }
    }
}

fn binary32(a: u32, y: u32, op: u32) -> Trap!u64 {
    let b = y;
    var r: u32 = 0;
    match op {
        0x6A => { r = a +% b; }
        0x6B => { r = a -% b; }
        0x6C => { r = a *% b; }
        0x6D => {
            if b == 0 { return Trap.DivideByZero; }
            if a == 0x80000000 and b == 0xFFFFFFFF { return Trap.IntegerOverflow; }
            r = ((a as% i32) / (b as% i32)) as% u32;
        }
        0x6E => {
            if b == 0 { return Trap.DivideByZero; }
            r = a / b;
        }
        0x6F => {
            if b == 0 { return Trap.DivideByZero; }
            if b == 0xFFFFFFFF { r = 0; } else { r = ((a as% i32) % (b as% i32)) as% u32; }
        }
        0x70 => {
            if b == 0 { return Trap.DivideByZero; }
            r = a % b;
        }
        0x71 => { r = a & b; }
        0x72 => { r = a | b; }
        0x73 => { r = a ^ b; }
        0x74 => { r = a << (b & 31); }
        0x75 => { r = ((a as% i32) >> (b & 31)) as% u32; }
        0x76 => { r = a >> (b & 31); }
        0x77 => { r = num.rotl32(x: a, n: b); }
        _ => { r = num.rotr32(x: a, n: b); }
    }
    return r as u64;
}

fn binary64(a: u64, y: u64, op: u32) -> Trap!u64 {
    let b = y;
    match op {
        0x7C => { return a +% b; }
        0x7D => { return a -% b; }
        0x7E => { return a *% b; }
        0x7F => {
            if b == 0 { return Trap.DivideByZero; }
            if a == 0x8000000000000000 and b == 0xFFFFFFFFFFFFFFFF { return Trap.IntegerOverflow; }
            return ((a as% i64) / (b as% i64)) as% u64;
        }
        0x80 => {
            if b == 0 { return Trap.DivideByZero; }
            return a / b;
        }
        0x81 => {
            if b == 0 { return Trap.DivideByZero; }
            if b == 0xFFFFFFFFFFFFFFFF { return 0; }
            return ((a as% i64) % (b as% i64)) as% u64;
        }
        0x82 => {
            if b == 0 { return Trap.DivideByZero; }
            return a % b;
        }
        0x83 => { return a & b; }
        0x84 => { return a | b; }
        0x85 => { return a ^ b; }
        0x86 => { return a << (b & 63); }
        0x87 => { return ((a as% i64) >> (b & 63)) as% u64; }
        0x88 => { return a >> (b & 63); }
        0x89 => { return num.rotl64(x: a, n: b); }
        _ => { return num.rotr64(x: a, n: b); }
    }
}

fn fbinary32(x: u64, y: u64, op: u32) -> u64 {
    let a = num.f32_of(x);
    let b = num.f32_of(y);
    match op {
        0x92 => { return num.quiet32(num.f32_bits(a + b)); }
        0x93 => { return num.quiet32(num.f32_bits(a - b)); }
        0x94 => { return num.quiet32(num.f32_bits(a * b)); }
        0x95 => { return num.quiet32(num.f32_bits(a / b)); }
        0x96 => { return num.min32(x: x, y: y); }
        0x97 => { return num.max32(x: x, y: y); }
        _ => { return num.copysign32(x: x, y: y); }
    }
}

fn fbinary64(x: u64, y: u64, op: u32) -> u64 {
    let a = num.f64_of(x);
    let b = num.f64_of(y);
    match op {
        0xA0 => { return num.quiet64(num.f64_bits(a + b)); }
        0xA1 => { return num.quiet64(num.f64_bits(a - b)); }
        0xA2 => { return num.quiet64(num.f64_bits(a * b)); }
        0xA3 => { return num.quiet64(num.f64_bits(a / b)); }
        0xA4 => { return num.min64(x: x, y: y); }
        0xA5 => { return num.max64(x: x, y: y); }
        _ => { return num.copysign64(x: x, y: y); }
    }
}

/// A float to an integer, trapping: the spec's trunc.
fn truncate(x: f64, signed: bool, wide: bool) -> Trap!u64 {
    if x != x {
        return Trap.InvalidConversion;
    }
    if not num.trunc_fits(x, signed: signed, wide: wide) {
        return Trap.IntegerOverflow;
    }
    if signed {
        if wide {
            return (x as i64) as% u64;
        }
        return num.of_s32(x as i32);
    }
    if wide {
        return x as u64;
    }
    return (x as u32) as u64;
}

fn unary(x: u64, op: u32) -> Trap!u64 {
    let lo = (x & 0xFFFFFFFF) as u32;
    match op {
        0x67 => { return num.clz32(lo) as u64; }
        0x68 => { return num.ctz32(lo) as u64; }
        0x69 => { return num.popcnt32(lo) as u64; }
        0x79 => { return num.clz64(x); }
        0x7A => { return num.ctz64(x); }
        0x7B => { return num.popcnt64(x); }
        0x8B => { return x & 0x7FFFFFFF; }
        0x8C => { return (x ^ 0x80000000) & 0xFFFFFFFF; }
        0x8D => { return num.quiet32(num.f32_bits(num.f32_of(x).ceil())); }
        0x8E => { return num.quiet32(num.f32_bits(num.f32_of(x).floor())); }
        0x8F => { return num.quiet32(num.f32_bits(num.f32_of(x).trunc())); }
        0x90 => { return num.nearest32(x); }
        0x91 => { return num.quiet32(num.f32_bits(num.f32_of(x).sqrt())); }
        0x99 => { return x & 0x7FFFFFFFFFFFFFFF; }
        0x9A => { return x ^ 0x8000000000000000; }
        0x9B => { return num.quiet64(num.f64_bits(num.f64_of(x).ceil())); }
        0x9C => { return num.quiet64(num.f64_bits(num.f64_of(x).floor())); }
        0x9D => { return num.quiet64(num.f64_bits(num.f64_of(x).trunc())); }
        0x9E => { return num.nearest64(x); }
        0x9F => { return num.quiet64(num.f64_bits(num.f64_of(x).sqrt())); }
        0xA7 => { return x & 0xFFFFFFFF; }
        0xA8 => { return try truncate(num.f32_of(x) as f64, signed: true, wide: false); }
        0xA9 => { return try truncate(num.f32_of(x) as f64, signed: false, wide: false); }
        0xAA => { return try truncate(num.f64_of(x), signed: true, wide: false); }
        0xAB => { return try truncate(num.f64_of(x), signed: false, wide: false); }
        0xAC => { return sext(x & 0xFFFFFFFF, bits: 32); }
        0xAD => { return x & 0xFFFFFFFF; }
        0xAE => { return try truncate(num.f32_of(x) as f64, signed: true, wide: true); }
        0xAF => { return try truncate(num.f32_of(x) as f64, signed: false, wide: true); }
        0xB0 => { return try truncate(num.f64_of(x), signed: true, wide: true); }
        0xB1 => { return try truncate(num.f64_of(x), signed: false, wide: true); }
        0xB2 => { return num.f32_bits(num.s32(x) as f32); }
        0xB3 => { return num.f32_bits(lo as f32); }
        0xB4 => { return num.f32_bits(num.s64(x) as f32); }
        0xB5 => { return num.f32_bits(x as f32); }
        0xB6 => { return num.quiet32(num.f32_bits(num.f64_of(x) as f32)); }
        0xB7 => { return num.f64_bits(num.s32(x) as f64); }
        0xB8 => { return num.f64_bits(lo as f64); }
        0xB9 => { return num.f64_bits(num.s64(x) as f64); }
        0xBA => { return num.f64_bits(x as f64); }
        0xBB => { return num.quiet64(num.f64_bits(num.f32_of(x) as f64)); }
        0xBC | 0xBE => { return x & 0xFFFFFFFF; }
        0xBD | 0xBF => { return x; }
        0xC0 => { return sext(x, bits: 8) & 0xFFFFFFFF; }
        0xC1 => { return sext(x, bits: 16) & 0xFFFFFFFF; }
        0xC2 => { return sext(x, bits: 8); }
        0xC3 => { return sext(x, bits: 16); }
        _ => { return sext(x, bits: 32); }
    }
}

/// trunc_sat: 0 i32 from f32 signed, 1 unsigned, 2 and 3 from f64, 4 to 7
/// the same to i64.
fn saturate(x: u64, sub: u32) -> u64 {
    var f: f64 = 0.0;
    if sub == 0 or sub == 1 or sub == 4 or sub == 5 {
        f = num.f32_of(x) as f64;
    } else {
        f = num.f64_of(x);
    }
    if sub == 0 or sub == 2 {
        return num.of_s32(f as% i32);
    }
    if sub == 1 or sub == 3 {
        return (f as% u32) as u64;
    }
    if sub == 4 or sub == 6 {
        return (f as% i64) as% u64;
    }
    return f as% u64;
}

/// Tables and bulk memory, by the slow path; the pc after the immediates.
fn slow_op(s: &mut Store, inst: u32, op: u32, x: u32, y: u32, sp: &mut usize, pc: usize) -> Trap!usize {
    var at = sp.*;
    if op == 0x25 {
        let taddr = s.instances.items()[inst as usize].tables.items()[x as usize];
        let i = s.stack.items()[at - 1];
        let t = &s.tables.items()[taddr as usize];
        if i >= t.items.len() as u64 {
            return Trap.TableOutOfBounds;
        }
        s.stack.items_mut()[at - 1] = t.items.items()[i as usize];
        return pc + 1;
    }
    if op == 0x26 {
        let taddr = s.instances.items()[inst as usize].tables.items()[x as usize];
        let value = s.stack.items()[at - 1];
        let i = s.stack.items()[at - 2];
        sp.* = at - 2;
        if i >= s.tables.items()[taddr as usize].items.len() as u64 {
            return Trap.TableOutOfBounds;
        }
        s.tables.items_mut()[taddr as usize].items.items_mut()[i as usize] = value;
        return pc + 1;
    }
    if op == v.OP_FC + 8 {
        let n = s.stack.items()[at - 1] & 0xFFFFFFFF;
        let src = s.stack.items()[at - 2] & 0xFFFFFFFF;
        let dst = s.stack.items()[at - 3] & 0xFFFFFFFF;
        sp.* = at - 3;
        try memory_init(s, instance: inst, data: x, dst: dst, src: src, n: n);
        return pc + 1;
    }
    if op == v.OP_FC + 9 {
        s.instances.items_mut()[inst as usize].dropped.items_mut()[x as usize] = true;
        return pc + 1;
    }
    if op == v.OP_FC + 10 or op == v.OP_FC + 11 {
        let n = s.stack.items()[at - 1] & 0xFFFFFFFF;
        let src = s.stack.items()[at - 2];
        let dst = s.stack.items()[at - 3] & 0xFFFFFFFF;
        sp.* = at - 3;
        let maddr = s.instances.items()[inst as usize].memories.items()[0];
        let mem = s.memories.items_mut()[maddr as usize].data.items_mut();
        let size = mem.len() as u64;
        if op == v.OP_FC + 11 {
            if dst + n > size {
                return Trap.MemoryOutOfBounds;
            }
            let byte = (src & 0xFF) as u8;
            var i: u64 = 0;
            while i < n : (i += 1) {
                mem[(dst + i) as usize] = byte;
            }
            return pc;
        }
        let from = src & 0xFFFFFFFF;
        if from + n > size or dst + n > size {
            return Trap.MemoryOutOfBounds;
        }
        if dst <= from {
            var i: u64 = 0;
            while i < n : (i += 1) {
                mem[(dst + i) as usize] = mem[(from + i) as usize];
            }
        } else {
            var i = n;
            while i > 0 {
                i -= 1;
                mem[(dst + i) as usize] = mem[(from + i) as usize];
            }
        }
        return pc;
    }
    if op == v.OP_FC + 12 {
        let n = s.stack.items()[at - 1] & 0xFFFFFFFF;
        let src = s.stack.items()[at - 2] & 0xFFFFFFFF;
        let dst = s.stack.items()[at - 3] & 0xFFFFFFFF;
        sp.* = at - 3;
        try table_init(s, instance: inst, table: y, elem: x, dst: dst, src: src, n: n);
        return pc + 2;
    }
    if op == v.OP_FC + 13 {
        s.instances.items_mut()[inst as usize].elems.items_mut()[x as usize].clear();
        return pc + 1;
    }
    if op == v.OP_FC + 14 {
        let n = s.stack.items()[at - 1] & 0xFFFFFFFF;
        let src = s.stack.items()[at - 2] & 0xFFFFFFFF;
        let dst = s.stack.items()[at - 3] & 0xFFFFFFFF;
        sp.* = at - 3;
        let td = s.instances.items()[inst as usize].tables.items()[x as usize];
        let ts = s.instances.items()[inst as usize].tables.items()[y as usize];
        let ld = s.tables.items()[td as usize].items.len() as u64;
        let ls = s.tables.items()[ts as usize].items.len() as u64;
        if src + n > ls or dst + n > ld {
            return Trap.TableOutOfBounds;
        }
        if dst <= src {
            var i: u64 = 0;
            while i < n : (i += 1) {
                let value = s.tables.items()[ts as usize].items.items()[(src + i) as usize];
                s.tables.items_mut()[td as usize].items.items_mut()[(dst + i) as usize] = value;
            }
        } else {
            var i = n;
            while i > 0 {
                i -= 1;
                let value = s.tables.items()[ts as usize].items.items()[(src + i) as usize];
                s.tables.items_mut()[td as usize].items.items_mut()[(dst + i) as usize] = value;
            }
        }
        return pc + 2;
    }
    let taddr = s.instances.items()[inst as usize].tables.items()[x as usize];
    if op == v.OP_FC + 15 {
        let n = s.stack.items()[at - 1] & 0xFFFFFFFF;
        let value = s.stack.items()[at - 2];
        at -= 1;
        sp.* = at;
        let limit = s.limits.table_elems;
        let t = &mut s.tables.items_mut()[taddr as usize];
        let old = t.items.len() as u64;
        if old + n > t.max or old + n > limit {
            s.stack.items_mut()[at - 1] = 0xFFFFFFFF;
            return pc + 1;
        }
        var i: u64 = 0;
        while i < n : (i += 1) {
            t.items.push(value);
        }
        s.stack.items_mut()[at - 1] = old;
        return pc + 1;
    }
    if op == v.OP_FC + 16 {
        s.stack.items_mut()[at] = s.tables.items()[taddr as usize].items.len() as u64;
        sp.* = at + 1;
        return pc + 1;
    }
    // table.fill
    let n = s.stack.items()[at - 1] & 0xFFFFFFFF;
    let value = s.stack.items()[at - 2];
    let dst = s.stack.items()[at - 3] & 0xFFFFFFFF;
    sp.* = at - 3;
    if dst + n > s.tables.items()[taddr as usize].items.len() as u64 {
        return Trap.TableOutOfBounds;
    }
    var i: u64 = 0;
    while i < n : (i += 1) {
        s.tables.items_mut()[taddr as usize].items.items_mut()[(dst + i) as usize] = value;
    }
    return pc + 1;
}

// ---- the JIT ----------------------------------------------------------------------------

/// Machine code from now on, in the region of size bytes at base, which the
/// embedder made readable, writable and executable. x86-64 only.
pub fn enable_jit(s: &mut Store, base: u64, size: u64) {
    var x = jit.new_asm(s.a);
    let exit_at = jit.stubs(&mut x);
    s.jit_on = true;
    s.jit_base = base;
    s.jit_size = size;
    s.jit_used = 0;
    s.jit_exit = exit_at;
    write_code(s, x.bytes.items());
    s.jit_ctx.grow_zeroed(jit.CTX_SLOTS as usize);
}

fn write_code(s: &mut Store, bytes: []u8) {
    if s.jit_used + bytes.len() as u64 > s.jit_size {
        return;
    }
    unsafe {
        // SAFETY: the region is the embedder's, size bytes at base, and
        // this stays inside it.
        let p = ptr.from_addr(u8, (s.jit_base + s.jit_used) as usize);
        var i: usize = 0;
        while i < bytes.len() : (i += 1) {
            p.add(i).* = bytes[i];
        }
    }
    s.jit_used += bytes.len() as u64;
}

/// Compiles the instance's functions into the region; one that does not fit
/// stays with the interpreter.
fn compile_instance(s: &mut Store, instance: u32) {
    let mi = s.instances.items()[instance as usize].module;
    let nfuncs = s.modules.items()[mi as usize].funcs.len();
    let stride = raw.size_of(GlobalInst) as u32;
    var k: usize = 0;
    while k < nfuncs : (k += 1) {
        if s.modules.items()[mi as usize].funcs.items()[k].imported {
            continue;
        }
        var x = jit.new_asm(s.a);
        let base = s.jit_used as u32;
        let compiled = jit.compile(&s.modules.items()[mi as usize].funcs.items()[k], globals: s.instances.items()[instance as usize].globals.items(), global_stride: stride, global_value: 8, base: base, exit_at: s.jit_exit, &mut x, s.a);
        if s.jit_used + x.bytes.len() as u64 > s.jit_size {
            return;
        }
        write_code(s, x.bytes.items());
        let addr = s.instances.items()[instance as usize].funcs.items()[k];
        s.jit_index.items_mut()[addr as usize] = s.jit_code.len() as u32;
        s.jit_code.push(compiled);
    }
}

/// Runs machine code at resume with the frame at fp; what it came back for.
fn enter_jit(s: &mut Store, inst: u32, fp: usize, resume: u32) -> u64 {
    let it = &s.instances.items()[inst as usize];
    var maddr: u32 = 0;
    if it.memories.len() > 0 {
        maddr = it.memories.items()[0];
    }
    var stack_at: u64 = 0;
    var mem_at: u64 = 0;
    var globals_at: u64 = 0;
    var ctx_at: u64 = 0;
    unsafe {
        // SAFETY: addresses only; the machine code reads and writes within
        // the stack, the memory (checked against its size) and the globals.
        stack_at = raw.slice_data(u64, s.stack.items()).addr() as u64;
        mem_at = raw.slice_data(u8, s.memories.items()[maddr as usize].data.items()).addr() as u64;
        globals_at = raw.slice_data(GlobalInst, s.globals.items()).addr() as u64;
        ctx_at = raw.slice_data(u64, s.jit_ctx.items()).addr() as u64;
    }
    let size = s.memories.items()[maddr as usize].data.len() as u64;
    let c = s.jit_ctx.items_mut();
    c[jit.CTX_FRAME as usize] = stack_at + 8 * fp as u64;
    c[jit.CTX_MEM as usize] = mem_at;
    c[jit.CTX_MEM_SIZE as usize] = size;
    c[jit.CTX_RESUME as usize] = s.jit_base + resume as u64;
    c[jit.CTX_FUEL as usize] = s.fuel as u64;
    c[jit.CTX_GLOBALS as usize] = globals_at;
    let entry = s.jit_base + jit.ENTRY as u64;
    var status: u64 = 0;
    var arg = ctx_at;
    unsafe {
        // SAFETY: entry is the region's entry stub, which keeps what the
        // System V ABI keeps and returns to here; the code it runs only
        // touches what the context names.
        asm("call *%1", out("rax") status, in(reg) entry, inout("rdi") arg,
            clobber("rcx"), clobber("rdx"), clobber("rsi"), clobber("r8"), clobber("r9"), clobber("r10"), clobber("r11"),
            clobber("xmm0"), clobber("xmm1"));
    }
    s.fuel = s.jit_ctx.items()[jit.CTX_FUEL as usize] as u32;
    return status;
}
