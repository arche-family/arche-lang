/// A mini-app that calls what arche-wasm bindgen binds of options, results,
/// lists and records (docs/sprints.md S38), on the modules it makes of
/// tests/nimadir/world.wit, which nimadir-check.sh generates next to this
/// file: storage-set, storage-get and storage-keys; ui-choice, a list of
/// strings; dom's query-all, children, parent, get-attribute and
/// set-markup, whose error is a string; and of records, list-apps, a list
/// of them, app-info, dom's bounds and events, fetch, which takes a record
/// with a list of tuples and a list of bytes, and fetch-poll, an option of
/// a result of a record; and image-load, a result, given a JPEG and a PNG.
import alloc;
import dom;
import host_api;
import std;

type App = struct {
    frame: u64,
    choice: u32,
    /// The page's list, made in the first frame.
    list: u32,
}

fn init(host: &mut std.Host, a: alloc.Allocator) -> App {
    var why = alloc.String.init(a);
    if not host_api.storage_set(host, key: "visits", value: "1", why: &mut why, a: a) {
        host_api.log(host, msg: why.view());
    }
    return App { frame: 0, choice: 1, list: 0 };
}

