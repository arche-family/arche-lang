/// What image-load gave bytes, logged: its number, or that it refused.
fn loaded(host: &mut std.Host, what: str, bytes: []u8, a: alloc.Allocator) {
    var why = alloc.String.init(a);
    var line = alloc.String.from("image-load ", a);
    line.push_str(what);
    match host_api.image_load(host, bytes: bytes, why: &mut why, a: a) {
        some(h) => {
            line.push_str(": image ");
            line.push_u64(h as u64);
        }
        none => { line.push_str(": refused"); }
    }
    host_api.log(host, msg: line.view());
}

fn said(host: &mut std.Host, what: str, value: str, a: alloc.Allocator) {
    var line = alloc.String.from(what, a);
    line.push_str(": ");
    line.push_str(value);
    host_api.ui_label(host, text: line.view());
}

fn count(host: &mut std.Host, what: str, n: usize, a: alloc.Allocator) {
    var line = alloc.String.from(what, a);
    line.push_str(": ");
    line.push_u64(n as u64);
    host_api.ui_label(host, text: line.view());
}

fn update(state: &mut App, host: &mut std.Host, a: alloc.Allocator) {
    state.frame += 1;
    if state.frame == 1 {
        images(host, a: a);
    }
    // Storage: what is set comes back, and what is not is none.
    var frame = alloc.String.init(a);
    frame.push_u64(state.frame);
    var why = alloc.String.init(a);
    if not host_api.storage_set(host, key: "frame", value: frame.view(), why: &mut why, a: a) {
        said(host, what: "storage-set failed", value: why.view(), a: a);
    }
    let kept = host_api.storage_get(host, key: "frame", a: a) orelse alloc.String.from("(none)", a);
    said(host, what: "Kept", value: kept.view(), a: a);
    let visits = host_api.storage_get(host, key: "visits", a: a) orelse alloc.String.from("(none)", a);
    said(host, what: "Visits", value: visits.view(), a: a);
    let missing = host_api.storage_get(host, key: "missing", a: a) orelse alloc.String.from("(none)", a);
    said(host, what: "Missing", value: missing.view(), a: a);
    // The keys, in order of their bytes, whatever order they were set in.
    let keys = host_api.storage_keys(host, a: a);
    var listed = alloc.String.init(a);
    for k in keys.items() {
        if listed.len() > 0 {
            listed.push_str(", ");
        }
        listed.push_str(k.view());
    }
    said(host, what: "Keys", value: listed.view(), a: a);
    // A choice of three, from a list of strings.
    var colours = alloc.List(alloc.String).init(a);
    colours.push(alloc.String.from("Red", a));
    colours.push(alloc.String.from("Green", a));
    colours.push(alloc.String.from("Blue", a));
    state.choice = host_api.ui_choice(host, options: &colours, selected: state.choice, a: a);
    if (state.choice as usize) < colours.len() {
        said(host, what: "Picked", value: colours.items()[state.choice as usize].view(), a: a);
    }
    // The page: a list made once, then read back each frame.
    let root = dom.root(host);
    if state.list == 0 {
        state.list = dom.create_element(host, tag: "ul");
        dom.append_child(host, parent_: root, child: state.list);
        dom.set_attribute(host, item: state.list, name: "id", value_: "colours");
        var bad = alloc.String.init(a);
        if not dom.set_markup(host, item: state.list, markup: "<li>Red</li><li>Green</li><li>Blue</li>", why: &mut bad, a: a) {
            said(host, what: "set-markup failed", value: bad.view(), a: a);
        }
    }
    // Markup that cannot be read is refused, saying why and where, and
    // changes nothing; markup that can has its entities read, and its void
    // elements need no closing tag.
    let probe = dom.create_element(host, tag: "div");
    var refused = alloc.String.init(a);
    if not dom.set_markup(host, item: probe, markup: "</p>", why: &mut refused, a: a) {
        said(host, what: "Refused", value: refused.view(), a: a);
    }
    var unclosed = alloc.String.init(a);
    if not dom.set_markup(host, item: probe, markup: "<ul>\n  <li>open</ul>", why: &mut unclosed, a: a) {
        said(host, what: "Refused", value: unclosed.view(), a: a);
    }
    var read = alloc.String.init(a);
    if dom.set_markup(host, item: probe, markup: "<p title='a &amp; b' TITLE=c>x&lt;y<br>z&#x2014;<!-- no --><script>no()</script></p>", why: &mut read, a: a) {
        let para = dom.children(host, item: probe, a: a);
        if para.len() == 1 {
            let title = dom.get_attribute(host, item: para.items()[0], name: "title", a: a) orelse alloc.String.from("(none)", a);
            said(host, what: "Its title", value: title.view(), a: a);
            count(host, what: "Its children", n: dom.children(host, item: para.items()[0], a: a).len(), a: a);
            said(host, what: "Its text", value: dom.value(host, item: para.items()[0], a: a).view(), a: a);
        }
    } else {
        said(host, what: "Refused", value: read.view(), a: a);
    }
    dom.release(host, item: probe);
    count(host, what: "Items", n: dom.query_all(host, scope: root, selector: "li", a: a).len(), a: a);
    count(host, what: "Children", n: dom.children(host, item: state.list, a: a).len(), a: a);
    let up = dom.parent(host, item: state.list) orelse 0;
    if up == root {
        host_api.ui_label(host, text: "Parent: the page");
    }
    let id = dom.get_attribute(host, item: state.list, name: "id", a: a) orelse alloc.String.from("(none)", a);
    said(host, what: "Id", value: id.view(), a: a);
    let title = dom.get_attribute(host, item: state.list, name: "title", a: a) orelse alloc.String.from("(none)", a);
    said(host, what: "Title", value: title.view(), a: a);
    records(state, host: host, a: a);
}

/// What is said of the calls that take or give records.
fn records(state: &mut App, host: &mut std.Host, a: alloc.Allocator) {
    // The registry's apps, the first of them, and what it says of one.
    let apps = host_api.list_apps(host, a: a);
    count(host, what: "Apps", n: apps.len(), a: a);
    if apps.len() > 1 {
        said(host, what: "Second app", value: apps.items()[1].name.view(), a: a);
        said(host, what: "Its source", value: apps.items()[1].source.view(), a: a);
        said(host, what: "It is", value: apps.items()[1].description.view(), a: a);
    }
    let info = host_api.app_info(host, source: "mini-apps/counter/counter.component.wasm", a: a);
    count(host, what: "Its version, in bytes", n: info.version.len(), a: a);
    count(host, what: "Its publisher, in bytes", n: info.publisher.len(), a: a);
    // A node's box, before any layout: none. (Nimadir's headless shell
    // lays the page out after a frame, and this one does not: the phone's
    // shell does, and gives boxes.)
    if state.frame == 1 {
        match dom.bounds(host, item: state.list) {
            some(r) => {
                if r.width >= 0.0 and r.height >= 0.0 {
                    host_api.ui_label(host, text: "The list has a box");
                }
            }
            none => { host_api.ui_label(host, text: "The list has no box yet"); }
        }
    }
    dom.listen(host, item: state.list, kind: "click");
    let done = dom.events(host, a: a);
    count(host, what: "Events", n: done.len(), a: a);
    // A request: a method, an address, headers and a body.
    var headers = alloc.List(host_api.TupleStringString).init(a);
    headers.push(host_api.TupleStringString { f0: alloc.String.from("accept", a), f1: alloc.String.from("text/plain", a) });
    headers.push(host_api.TupleStringString { f0: alloc.String.from("x-app", a), f1: alloc.String.from("arche", a) });
    var body = alloc.List(u8).init(a);
    for b in "ping".bytes() {
        body.push(b.*);
    }
    let request = host_api.HttpRequest { method: alloc.String.from("POST", a), url: alloc.String.from("https://example.com/echo", a), headers: headers, body: body };
    var refused = alloc.String.init(a);
    match host_api.fetch(host, request: &request, why: &mut refused, a: a) {
        some(_) => { host_api.ui_label(host, text: "Fetch started"); }
        none => { said(host, what: "Fetch refused", value: refused.view(), a: a); }
    }
    match host_api.fetch_poll(host, request: 4242, a: a) {
        some(answer) => {
            match answer {
                .Ok { value } => { count(host, what: "Answered with status", n: value.status as usize, a: a); }
                .Err { value } => { said(host, what: "Failed", value: value.view(), a: a); }
            }
        }
        none => { host_api.ui_label(host, text: "Request 4242: no answer yet"); }
    }
}
