/// Nimadir's counter mini-app (mini-apps/counter), written in Arche
/// (docs/sprints.md S38): a label of the count and two buttons, Increment
/// and Reset. It calls the world through the modules `arche-wasm bindgen`
/// makes of tests/nimadir/world.wit, host_api.arche and host_api_raw.arche,
/// which nimadir-check.sh generates next to this file before it builds it.
/// As the Rust one, it keeps the count in storage and starts from what is
/// kept there, which for an app that is not signed is nothing.
import alloc;
import host_api;
import std;

type Counter = struct {
    count: i32,
}

fn init(host: &mut std.Host, a: alloc.Allocator) -> Counter {
    var line = alloc.String.from("counter mini-app: init at host-time ", a);
    line.push_i64(host_api.now_millis(host));
    host_api.log(host, msg: line.view());
    let kept = host_api.storage_get(host, key: "count", a: a) orelse alloc.String.init(a);
    return Counter { count: number(kept.view()) };
}

/// A count as written by keep; 0 for what is not one.
fn number(text: str) -> i32 {
    var n: i32 = 0;
    var minus = false;
    for b in text.bytes() {
        if b.* == '-' and not minus and n == 0 {
            minus = true;
        } else if b.* >= '0' and b.* <= '9' and n < 100000000 {
            n = n * 10 + (b.* - '0') as i32;
        } else {
            return 0;
        }
    }
    if minus {
        return -n;
    }
    return n;
}

/// The count into storage. A count is a few bytes; the quota cannot be
/// what refuses it.
fn keep(host: &mut std.Host, count: i32, a: alloc.Allocator) {
    var text = alloc.String.init(a);
    text.push_i64(count as i64);
    var why = alloc.String.init(a);
    _ = host_api.storage_set(host, key: "count", value: text.view(), why: &mut why, a: a);
}

/// Each frame: the count, then the buttons, so that a click shows the
/// frame after it, as in the Rust one.
fn update(state: &mut Counter, host: &mut std.Host, a: alloc.Allocator) {
    var line = alloc.String.from("Count: ", a);
    line.push_i64(state.count as i64);
    host_api.ui_label(host, text: line.view());
    // Button 0.
    if host_api.ui_button(host, text: "Increment") {
        state.count += 1;
        keep(host, count: state.count, a: a);
    }
    // Button 1.
    if host_api.ui_button(host, text: "Reset") {
        state.count = 0;
        keep(host, count: 0, a: a);
    }
}
