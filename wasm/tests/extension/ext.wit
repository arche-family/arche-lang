// A world that includes Nimadir's and imports more (nimadir-check.sh):
// what an embedder adds, as the phone adds arche:phone (arche-os T5).
package test:ext@0.1.0;

/// Notes an app posts, each numbered, and cancels.
interface notes {
    post: func(title: string, body: string) -> u32;
    cancel: func(id: u32);
}

/// Whether this update is the embedder's waking the app.
interface wake {
    woken: func() -> bool;
}

world app {
    include nimadir:shell/mini-app@1.2.0;
    import notes;
    import wake;
}
