// The WASM runtime (docs/sprints.md S31): a decoder, a validator, an
// interpreter and a JIT for WebAssembly 2.0, the Component Model over them,
// and a command that runs modules, components and the spec's tests. The
// engine's modules use core and alloc alone, so that Arche OS can carry
// them; main.arche reads files and the clock. The JIT runs machine code,
// which is unsafe.
import std.build;

const PACKAGE: build.Package = build.Package {
    name: "arche_wasm",
    version: "0.1.0",
    edition: 2026,
    needs: [build.Capability.Fs, build.Capability.Clock, build.Capability.Proc, build.Capability.Unsafe],
};
