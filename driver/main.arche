/// arche-driver: arche build and arche run (docs/sprints.md S24). The
/// compiler stays in Arche-0, which has no Proc, so this program, in full
/// Arche, drives it and clang.
///
///     arche-driver build [dir]               every program build.arche lists
///     arche-driver run [dir] [name] [-- args] build, then run one
///     arche-driver clean [dir]               forget the cache
///     arche-driver pkg add <name> [version] [--dir d]   depend on a package
///     arche-driver pkg lock [--dir d]        resolve and check, write package.lock
///     arche-driver pkg vendor [--dir d]      unpack the locked packages into vendor/
///     arche-driver pkg publish <registry> <key> [--dir d]   publish to a registry directory
///     arche-driver pkg keygen <key>          a new signing key; prints the public key
///
/// The pkg commands are in pkg.arche.
///
/// A package's build.arche lists its programs:
///
///     import std.build;
///
///     const BUILD: build.Build = build.Build {
///         programs: [build.program("webd", "main.arche")],
///     };
///
/// The compiler writes a program as one LLVM module per module of it
/// (arche units). Each is compiled to an object kept in dir/build/cache
/// under the SHA-256 of its text, the compiler's flags and clang's version,
/// so a module whose code did not change is not compiled again; the objects
/// and the runtime are linked into dir/build/<name>. A build with the cache
/// gives the same bytes as one without.
import alloc;
import core.mem;
import crypto.sha2;
import pkg;
import std;

/// How clang is called, for the system the driver runs on. The compiler's
/// own scripts have the same in compiler/target.sh; a flag is part of an
/// object's cache key, so a build for another system makes its own.
fn compile_flags() -> str {
    if std.SYSTEM.eq("windows") {
        return "-c -O1 --target=x86_64-pc-windows-msvc -ffunction-sections -fdata-sections -Wno-override-module";
    }
    return "-c -O1 -fno-pie -ffunction-sections -fdata-sections -Wno-override-module";
}

fn runtime_flags() -> str {
    if std.SYSTEM.eq("windows") {
        return "-c -O2 --target=x86_64-pc-windows-msvc -ffreestanding -fno-builtin -nostdlib -fno-stack-protector -ffunction-sections -fdata-sections";
    }
    return "-c -O2 -ffreestanding -fno-builtin -nostdlib -fno-stack-protector -fno-pie -ffunction-sections -fdata-sections";
}

/// The link, without a C library: on Windows the runtime owns the entry
/// point and Win32 comes from the system's import libraries, and the time
/// of the link is left out of the file (-Brepro) so that a build repeats.
/// The linker's options are written with a dash, which the shells of
/// Windows leave alone. The last flag takes the output's name.
fn link_flags() -> str {
    if std.SYSTEM.eq("windows") {
        return "--target=x86_64-pc-windows-msvc -fuse-ld=lld -nostdlib -Wl,-entry:a0rt_entry -Wl,-subsystem:console -Wl,-Brepro -Wl,-opt:ref -lkernel32 -lws2_32 -ladvapi32 -o";
    }
    return "-nostdlib -static -fno-pie -Wl,--gc-sections -o";
}

/// What the compiler is told to build for, as the module std says.
fn target_name() -> str {
    if std.SYSTEM.eq("windows") {
        return "windows-x86_64";
    }
    return "linux-x86_64";
}

fn join(dir: str, name: str, a: alloc.Allocator) -> alloc.String {
    var s = alloc.String.init(a);
    s.push_str(dir);
    if dir.len() > 0 and dir.bytes()[dir.len() - 1] != '/' {
        s.push_str("/");
    }
    s.push_str(name);
    return s;
}

fn parent(path: str) -> str {
    let b = path.bytes();
    var cut: usize = 0;
    var i: usize = 0;
    while i < b.len() : (i += 1) {
        // Windows names a program with backslashes, whatever separator the
        // paths of the build use (docs/sprints.md S19).
        if b[i] == '/' or b[i] == '\\' {
            cut = i;
        }
    }
    if cut == 0 {
        if b.len() > 0 and (b[0] == '/' or b[0] == '\\') {
            return "/";
        }
        return ".";
    }
    return path[0..cut];
}

/// Makes dir and the directories above it that are missing.
fn make_dirs(fs: &std.Fs, dir: str, a: alloc.Allocator) {
    if dir.len() == 0 or fs.exists(dir) {
        return;
    }
    let up = parent(dir);
    if not up.eq(dir) {
        make_dirs(fs, dir: up, a: a);
    }
    _ = fs.make_dir(dir);
}

fn hex(digest: [32]u8, a: alloc.Allocator) -> alloc.String {
    let digits = "0123456789abcdef".bytes();
    var s = alloc.String.init(a);
    for b in digest[0..32] {
        s.push_ascii(digits[(b.* >> 4) as usize]);
        s.push_ascii(digits[(b.* & 15) as usize]);
    }
    return s;
}

fn text_of(b: []u8, a: alloc.Allocator) -> alloc.String {
    var s = alloc.String.init(a);
    unsafe {
        // SAFETY: the bytes come from a str, cut at ASCII bytes.
        s.push_str(mem.str_from(b));
    }
    return s;
}

/// The lines of a file's text.
fn lines(text: str, a: alloc.Allocator) -> alloc.List(alloc.String) {
    var out = alloc.List(alloc.String).init(a);
    let b = text.bytes();
    var start: usize = 0;
    var i: usize = 0;
    while i <= b.len() : (i += 1) {
        if i == b.len() or b[i] == '\n' {
            if i > start {
                out.push(text_of(b[start..i], a));
            }
            start = i + 1;
        }
    }
    return out;
}

/// Where the tools are, and how they are called.
type Tools = struct {
    arche: alloc.String,
    runtime: alloc.String,
    clang: alloc.String,
    /// clang --version's first line: part of every cache key.
    version: alloc.String,
    /// No clang: programs are built by the compiler's own backend and its
    /// linker, on the runtime's object a release carries.
    no_clang: bool,
}

type Failed = error { Failed }

fn say(out: &mut std.Output, a: str, b: str, c: str) {
    out.write(a);
    out.write(b);
    out.write(c);
    out.write("\n");
}

/// Runs a command; its output goes to out_path, or to ours when empty.
fn run(sys: &mut std.System, argv: &alloc.List(alloc.String), out_path: str, a: alloc.Allocator) -> Failed!u8 {
    var cmd = std.Command.init(a);
    let words = argv.items();
    for x in words {
        cmd.arg(x.view(), a);
    }
    cmd.stdout_path.push_str(out_path);
    cmd.stderr_path.push_str(out_path);
    match sys.proc.spawn(&cmd, env: &sys.env, clock: &sys.clock, a) {
        ok(ending) => {
            match ending {
                .Exited { status } => { return status; }
                .Signaled { signal } => {
                    _ = signal;
                    return 128;
                }
                .TimedOut => { return 124; }
            }
        }
        err(_) => {
            say(&mut sys.stderr, a: "arche-driver: cannot run ", b: words[0].view(), c: "");
            return Failed.Failed;
        }
    }
}

fn args_of(words: str, a: alloc.Allocator) -> alloc.List(alloc.String) {
    var out = alloc.List(alloc.String).init(a);
    let b = words.bytes();
    var start: usize = 0;
    var i: usize = 0;
    while i <= b.len() : (i += 1) {
        if i == b.len() or b[i] == ' ' {
            if i > start {
                out.push(text_of(b[start..i], a));
            }
            start = i + 1;
        }
    }
    return out;
}

fn find_tools(sys: &mut std.System, work: str, a: alloc.Allocator) -> Failed!Tools {
    // The compiler: ARCHE; a release's, in ARCHE_HOME/bin or beside this
    // program (bin/arche-driver, bin/arche); or the repository's
    // (driver/build/arche-driver, compiler/build/arche).
    var arche = alloc.String.init(a);
    var runtime = alloc.String.init(a);
    let home = sys.env.get("ARCHE_HOME", a) orelse alloc.String.init(a);
    let here = parent(sys.args.get(0));
    let beside = join(dir: here, name: "arche", a);
    match sys.env.get("ARCHE", a) {
        some(v) => { arche.push_str(v.view()); }
        none => {
            if home.len() > 0 {
                arche = join(dir: home.view(), name: "bin/arche", a);
            } else if here.len() > 0 and sys.fs.exists(beside.view()) {
                arche.push_str(beside.view());
            } else {
                arche.push_str(here);
                arche.push_str("/../../compiler/build/arche");
            }
        }
    }
    // The runtime's source: a release's runtime/, or the repository's
    // compiler/runtime/, two levels above the compiler either way.
    runtime = join(dir: parent(parent(arche.view())), name: "runtime/rt.c", a);
    var clang = alloc.String.init(a);
    match sys.env.get("CLANG", a) {
        some(v) => { clang.push_str(v.view()); }
        none => { clang.push_str("clang"); }
    }
    if not sys.fs.exists(arche.view()) {
        say(&mut sys.stderr, a: "arche-driver: there is no compiler at ", b: arche.view(), c: "; set ARCHE");
        return Failed.Failed;
    }
    let version_file = join(dir: work, name: "clang-version", a);
    var argv = alloc.List(alloc.String).init(a);
    argv.push(text_of(clang.view().bytes(), a));
    argv.push(text_of("--version".bytes(), a));
    // Without clang a release still builds: by the compiler's own backend.
    let ran = run(sys, argv: &argv, out_path: version_file.view(), a) catch 1;
    if ran != 0 {
        if not sys.fs.exists(prebuilt_runtime(runtime.view(), a).view()) {
            say(&mut sys.stderr, a: "arche-driver: ", b: clang.view(), c: " --version failed, and there is no runtime object to build without it");
            return Failed.Failed;
        }
        return Tools { arche: arche, runtime: runtime, clang: clang, version: alloc.String.init(a), no_clang: true };
    }
    let text = sys.fs.read_file(version_file.view(), a) catch alloc.String.init(a);
    let ls = lines(text.view(), a);
    var version = alloc.String.init(a);
    if ls.len() > 0 {
        version.push_str(ls[0].view());
    }
    return Tools { arche: arche, runtime: runtime, clang: clang, version: version, no_clang: false };
}

/// The runtime's object for the compiler's own linker, as a release carries
/// it beside rt.c: rt-<target>.ao.
fn prebuilt_runtime(rt_c: str, a: alloc.Allocator) -> alloc.String {
    var p = alloc.String.init(a);
    p.push_str(parent(rt_c));
    p.push_str("/rt-");
    p.push_str(target_name());
    p.push_str(".ao");
    return p;
}

/// The object for some source text, from the cache or made now: what is
/// compiled, with which flags, by which clang, decides its name.
fn object(sys: &mut std.System, tools: &Tools, source: str, flags: str, cache: str, hits: &mut u32, a: alloc.Allocator) -> Failed!alloc.String {
    let nothing = alloc.List(alloc.String).init(a);
    return object_with(sys, tools: tools, source: source, also: &nothing, flags: flags, cache: cache, hits: hits, a: a);
}

/// object, with the files the source includes as part of the key.
fn object_with(sys: &mut std.System, tools: &Tools, source: str, also: &alloc.List(alloc.String), flags: str, cache: str, hits: &mut u32, a: alloc.Allocator) -> Failed!alloc.String {
    var text = alloc.List(u8).init(a);
    match sys.fs.read_bytes(source, a) {
        ok(t) => { text = t; }
        err(_) => {
            say(&mut sys.stderr, a: "arche-driver: cannot read ", b: source, c: "");
            return Failed.Failed;
        }
    }
    var h = sha2.Sha256.init();
    h.update(tools.version.view().bytes());
    h.update("\n".bytes());
    h.update(flags.bytes());
    h.update("\n".bytes());
    h.update(text.items());
    for f in also.items() {
        let more = sys.fs.read_bytes(f.view(), a) catch alloc.List(u8).init(a);
        h.update("\n".bytes());
        h.update(more.items());
    }
    let name = hex(h.finish(), a);
    var file = join(dir: cache, name: name.view(), a);
    file.push_str(".o");
    if sys.fs.exists(file.view()) {
        hits.* += 1;
        return file;
    }
    var tmp = alloc.String.init(a);
    tmp.push_str(file.view());
    tmp.push_str(".tmp");
    var argv = alloc.List(alloc.String).init(a);
    argv.push(text_of(tools.clang.view().bytes(), a));
    for f in args_of(flags, a).items() {
        argv.push(text_of(f.view().bytes(), a));
    }
    argv.push(text_of("-o".bytes(), a));
    argv.push(text_of(tmp.view().bytes(), a));
    argv.push(text_of(source.bytes(), a));
    let log = join(dir: cache, name: "clang.log", a);
    if try run(sys, argv: &argv, out_path: log.view(), a) != 0 {
        say(&mut sys.stderr, a: "arche-driver: clang failed on ", b: source, c: ":");
        let msg = sys.fs.read_file(log.view(), a) catch alloc.String.init(a);
        sys.stderr.write(msg.view());
        return Failed.Failed;
    }
    _ = sys.fs.rename(from: tmp.view(), to: file.view());
    return file;
}

/// What the runtime includes, each part of it a part of its object's key.
fn runtime_includes(sys: &mut std.System, tools: &Tools, a: alloc.Allocator) -> alloc.List(alloc.String) {
    let folder = parent(tools.runtime.view());
    let names = sys.fs.list(folder, a) catch alloc.List(alloc.String).init(a);
    var includes = alloc.List(alloc.String).init(a);
    for n in names.items() {
        let name = n.view();
        if name.len() > 4 and name[name.len() - 4..name.len()].eq(".inc") {
            includes.push(join(dir: folder, name: name, a));
        }
    }
    return includes;
}

/// Builds one program with the compiler's own backend, as ARCHE_BACKEND=own
/// asks (docs/sprints.md S27, S29): one object with its debug info, linked by
/// the compiler, with no LLVM and no lld, so quick that a cache of modules
/// would have nothing to save. The runtime is still C, and has frame pointers
/// for a panic's stack trace to walk.
fn build_own(sys: &mut std.System, tools: &Tools, dir: str, name: str, root: str, a: alloc.Allocator) -> Failed!alloc.String {
    let out_dir = join(dir: dir, name: "build", a);
    let cache = join(dir: out_dir.view(), name: "cache", a);
    make_dirs(&sys.fs, dir: cache.view(), a: a);
    var object_name = alloc.String.init(a);
    object_name.push_str(name);
    object_name.push_str(".ao");
    let object_file = join(dir: out_dir.view(), name: object_name.view(), a);
    let log = join(dir: out_dir.view(), name: "link.log", a);
    var argv = alloc.List(alloc.String).init(a);
    argv.push(text_of(tools.arche.view().bytes(), a));
    argv.push(text_of("build".bytes(), a));
    argv.push(join(dir: dir, name: root, a));
    argv.push(text_of(object_file.view().bytes(), a));
    if try run(sys, argv: &argv, out_path: log.view(), a) != 0 {
        let msg = sys.fs.read_file(log.view(), a) catch alloc.String.init(a);
        sys.stderr.write(msg.view());
        return Failed.Failed;
    }
    let program = join(dir: out_dir.view(), name: name, a);
    var tmp = copy_text(program.view(), a);
    tmp.push_str(".tmp");
    // The runtime is still C: its object, as the compiler's own linker reads
    // it; a release carries it made, and with no clang that one is used.
    var rt_ao = prebuilt_runtime(tools.runtime.view(), a);
    var rt = alloc.String.init(a);
    if not tools.no_clang {
        var flags = copy_text(runtime_flags(), a);
        flags.push_str(" -fno-omit-frame-pointer");
        let includes = runtime_includes(sys, tools: tools, a: a);
        var rt_hits: u32 = 0;
        rt = try object_with(sys, tools: tools, source: tools.runtime.view(), also: &includes, flags: flags.view(), cache: cache.view(), hits: &mut rt_hits, a: a);
        rt_ao = copy_text(rt.view(), a);
        rt_ao.push_str(".ao");
    }
    if not sys.fs.exists(rt_ao.view()) {
        var convert = alloc.List(alloc.String).init(a);
        convert.push(text_of(tools.arche.view().bytes(), a));
        convert.push(text_of("import".bytes(), a));
        convert.push(text_of(rt.view().bytes(), a));
        convert.push(text_of(rt_ao.view().bytes(), a));
        if try run(sys, argv: &convert, out_path: log.view(), a) != 0 {
            sys.stderr.write("arche-driver: the runtime's object:\n");
            let msg = sys.fs.read_file(log.view(), a) catch alloc.String.init(a);
            sys.stderr.write(msg.view());
            return Failed.Failed;
        }
    }
    var link = alloc.List(alloc.String).init(a);
    link.push(text_of(tools.arche.view().bytes(), a));
    link.push(text_of("link".bytes(), a));
    link.push(text_of(tmp.view().bytes(), a));
    link.push(text_of(object_file.view().bytes(), a));
    link.push(text_of(rt_ao.view().bytes(), a));
    if try run(sys, argv: &link, out_path: log.view(), a) != 0 {
        sys.stderr.write("arche-driver: the link failed:\n");
        let msg = sys.fs.read_file(log.view(), a) catch alloc.String.init(a);
        sys.stderr.write(msg.view());
        return Failed.Failed;
    }
    _ = sys.fs.rename(from: tmp.view(), to: program.view());
    sys.stdout.write(name);
    sys.stdout.write(": built by the compiler's own backend\n");
    return program;
}

fn copy_text(t: str, a: alloc.Allocator) -> alloc.String {
    var s = alloc.String.init(a);
    s.push_str(t);
    return s;
}

/// Builds one program; its path.
fn build_program(sys: &mut std.System, tools: &Tools, dir: str, name: str, root: str, a: alloc.Allocator) -> Failed!alloc.String {
    let backend = sys.env.get("ARCHE_BACKEND", a) orelse alloc.String.init(a);
    if backend.view().eq("own") or tools.no_clang {
        return build_own(sys, tools: tools, dir: dir, name: name, root: root, a: a);
    }
    let out_dir = join(dir: dir, name: "build", a);
    let cache = join(dir: out_dir.view(), name: "cache", a);
    let units_dir = join(dir: join(dir: out_dir.view(), name: "units", a).view(), name: name, a);
    make_dirs(&sys.fs, dir: cache.view(), a: a);
    make_dirs(&sys.fs, dir: units_dir.view(), a: a);
    // No unit left from an earlier build.
    let old = sys.fs.list(units_dir.view(), a) catch alloc.List(alloc.String).init(a);
    for f in old.items() {
        _ = sys.fs.remove(join(dir: units_dir.view(), name: f.view(), a).view());
    }
    var list_name = alloc.String.init(a);
    list_name.push_str(name);
    list_name.push_str(".units");
    let list_file = join(dir: out_dir.view(), name: list_name.view(), a);
    var argv = alloc.List(alloc.String).init(a);
    argv.push(text_of(tools.arche.view().bytes(), a));
    argv.push(text_of("--target".bytes(), a));
    argv.push(text_of(target_name().bytes(), a));
    argv.push(text_of("units".bytes(), a));
    argv.push(join(dir: dir, name: root, a));
    argv.push(text_of(units_dir.view().bytes(), a));
    if try run(sys, argv: &argv, out_path: list_file.view(), a) != 0 {
        let msg = sys.fs.read_file(list_file.view(), a) catch alloc.String.init(a);
        sys.stderr.write(msg.view());
        return Failed.Failed;
    }
    let listed = sys.fs.read_file(list_file.view(), a) catch alloc.String.init(a);
    let units = lines(listed.view(), a);
    var objects = alloc.List(alloc.String).init(a);
    var hits: u32 = 0;
    for u in units.items() {
        objects.push(try object(sys, tools: tools, source: u.view(), flags: compile_flags(), cache: cache.view(), hits: &mut hits, a: a));
    }
    var rt_hits: u32 = 0;
    // The runtime is rt.c and what it includes, one half for each system.
    let includes = runtime_includes(sys, tools: tools, a: a);
    let rt = try object_with(sys, tools: tools, source: tools.runtime.view(), also: &includes, flags: runtime_flags(), cache: cache.view(), hits: &mut rt_hits, a: a);
    // Linked to a file of its own, then moved into place.
    let program = join(dir: out_dir.view(), name: name, a);
    var tmp = alloc.String.init(a);
    tmp.push_str(program.view());
    tmp.push_str(".tmp");
    var link = alloc.List(alloc.String).init(a);
    link.push(text_of(tools.clang.view().bytes(), a));
    for f in args_of(link_flags(), a).items() {
        link.push(text_of(f.view().bytes(), a));
    }
    link.push(text_of(tmp.view().bytes(), a));
    for o in objects.items() {
        link.push(text_of(o.view().bytes(), a));
    }
    link.push(text_of(rt.view().bytes(), a));
    let log = join(dir: out_dir.view(), name: "link.log", a);
    if try run(sys, argv: &link, out_path: log.view(), a) != 0 {
        sys.stderr.write("arche-driver: the link failed:\n");
        let msg = sys.fs.read_file(log.view(), a) catch alloc.String.init(a);
        sys.stderr.write(msg.view());
        return Failed.Failed;
    }
    _ = sys.fs.rename(from: tmp.view(), to: program.view());
    sys.stdout.write(name);
    sys.stdout.write(": ");
    sys.stdout.write_u64(units.len() as u64);
    sys.stdout.write(" modules, ");
    sys.stdout.write_u64(hits as u64);
    sys.stdout.write(" from the cache\n");
    return program;
}

/// The programs of dir/build.arche, as name and root.
fn plan(sys: &mut std.System, tools: &Tools, dir: str, work: str, a: alloc.Allocator) -> Failed!alloc.List(alloc.String) {
    let build_file = join(dir: dir, name: "build.arche", a);
    if not sys.fs.exists(build_file.view()) {
        say(&mut sys.stderr, a: "arche-driver: there is no ", b: build_file.view(), c: "");
        return Failed.Failed;
    }
    let out = join(dir: work, name: "plan", a);
    var argv = alloc.List(alloc.String).init(a);
    argv.push(text_of(tools.arche.view().bytes(), a));
    argv.push(text_of("build-plan".bytes(), a));
    argv.push(text_of(build_file.view().bytes(), a));
    let status = try run(sys, argv: &argv, out_path: out.view(), a);
    let text = sys.fs.read_file(out.view(), a) catch alloc.String.init(a);
    if status != 0 {
        sys.stderr.write(text.view());
        return Failed.Failed;
    }
    // name TAB root, a line each: as a flat list of names and roots.
    var flat = alloc.List(alloc.String).init(a);
    for l in lines(text.view(), a).items() {
        let b = l.view().bytes();
        var tab: usize = 0;
        while tab < b.len() and b[tab] != '\t' : (tab += 1) {
        }
        if tab < b.len() {
            flat.push(text_of(b[0..tab], a));
            flat.push(text_of(b[tab + 1..b.len()], a));
        }
    }
    return flat;
}

/// What arche manifest says of dir/package.arche.
fn manifest_of(sys: &mut std.System, tools: &Tools, dir: str, work: str, a: alloc.Allocator) -> Failed!pkg.Manifest {
    let out = join(dir: work, name: "manifest", a);
    var argv = alloc.List(alloc.String).init(a);
    argv.push(text_of(tools.arche.view().bytes(), a));
    argv.push(text_of("manifest".bytes(), a));
    argv.push(join(dir: dir, name: "package.arche", a));
    let status = try run(sys, argv: &argv, out_path: out.view(), a: a);
    let text = sys.fs.read_file(out.view(), a) catch alloc.String.init(a);
    if status != 0 {
        sys.stderr.write(text.view());
        return Failed.Failed;
    }
    return pkg.parse_manifest(text.view(), a);
}

/// pkg lock: every dependency, and theirs, checked against the registry's
/// signatures and hashes, into package.lock. Two versions of one package
/// are an error.
fn pkg_lock(sys: &mut std.System, tools: &Tools, dir: str, work: str, a: alloc.Allocator) -> Failed!void {
    let m = try manifest_of(sys, tools: tools, dir: dir, work: work, a: a);
    let r = match pkg.registry_of(sys, m: &m, dir: dir, a: a) {
        ok(got5) => { got5 }
        err(_) => { return Failed.Failed; }
    };
    let cache = join(dir: work, name: "pkg", a);
    var queue = alloc.List(pkg.Dep).init(a);
    for d in m.deps.items() {
        queue.push(pkg.Dep { name: text_of(d.name.view().bytes(), a), version: text_of(d.version.view().bytes(), a), hash: text_of(d.hash.view().bytes(), a) });
    }
    var resolved = alloc.List(pkg.Dep).init(a);
    var i: usize = 0;
    while i < queue.len() : (i += 1) {
        let name = text_of(queue[i].name.view().bytes(), a);
        if not pkg.safe_name(name.view()) {
            say(&mut sys.stderr, a: "arche-driver pkg: a package's name is an identifier, not ", b: name.view(), c: "");
            return Failed.Failed;
        }
        let version = text_of(queue[i].version.view().bytes(), a);
        var pinned = text_of(queue[i].hash.view().bytes(), a);
        var known = false;
        for x in resolved.items() {
            if x.name.view().eq(name.view()) {
                known = true;
                if not x.version.view().eq(version.view()) {
                    sys.stderr.write("arche-driver pkg: two versions of ");
                    sys.stderr.write(name.view());
                    sys.stderr.write(" are needed, ");
                    sys.stderr.write(x.version.view());
                    sys.stderr.write(" and ");
                    sys.stderr.write(version.view());
                    sys.stderr.write("\n");
                    return Failed.Failed;
                }
            }
        }
        if known {
            continue;
        }
        let hash = match pkg.release_hash(sys, r: &r, name: name.view(), version: version.view(), a: a) {
            ok(got6) => { got6 }
            err(_) => { return Failed.Failed; }
        };
        if pinned.view().starts_with("sha256:") {
            pinned = text_of(pinned.view().bytes()[7..pinned.len()], a);
        }
        if pinned.len() > 0 and not pinned.view().eq(hash.view()) {
            say(&mut sys.stderr, a: "arche-driver pkg: the manifest pins another hash for ", b: name.view(), c: "");
            return Failed.Failed;
        }
        let data = match pkg.archive(sys, r: &r, hash: hash.view(), cache: cache.view(), a: a) {
            ok(got7) => { got7 }
            err(_) => { return Failed.Failed; }
        };
        // Its own dependencies, from its manifest.
        let unpacked = join(dir: join(dir: cache.view(), name: "unpacked", a).view(), name: name.view(), a);
        pkg.remove_all(&sys.fs, path: unpacked.view(), a: a);
        if not pkg.unpack(&sys.fs, data: data.items(), dir: unpacked.view(), to: &mut sys.stderr, a: a) {
            return Failed.Failed;
        }
        let dm = try manifest_of(sys, tools: tools, dir: unpacked.view(), work: work, a: a);
        if not dm.name.view().eq(name.view()) {
            say(&mut sys.stderr, a: "arche-driver pkg: the registry's package is not ", b: name.view(), c: "");
            return Failed.Failed;
        }
        for d in dm.deps.items() {
            queue.push(pkg.Dep { name: text_of(d.name.view().bytes(), a), version: text_of(d.version.view().bytes(), a), hash: text_of(d.hash.view().bytes(), a) });
        }
        resolved.push(pkg.Dep { name: name, version: version, hash: hash });
    }
    let text = pkg.lock_text(&resolved, a);
    match sys.fs.write_file(path: join(dir: dir, name: "package.lock", a).view(), data: text.view()) {
        ok(_) => { }
        err(_) => { return Failed.Failed; }
    }
    sys.stdout.write("locked ");
    sys.stdout.write_u64(resolved.len() as u64);
    sys.stdout.write(" packages\n");
}

/// pkg vendor: the locked packages, their hashes checked, in vendor/.
fn pkg_vendor(sys: &mut std.System, tools: &Tools, dir: str, work: str, a: alloc.Allocator) -> Failed!void {
    var lock_text = alloc.String.init(a);
    match sys.fs.read_file(join(dir: dir, name: "package.lock", a).view(), a) {
        ok(t) => { lock_text = t; }
        err(_) => {
            say(&mut sys.stderr, a: "arche-driver pkg: there is no package.lock; run arche-driver pkg lock", b: "", c: "");
            return Failed.Failed;
        }
    }
    let locked = pkg.read_lock(lock_text.view(), a);
    let m = try manifest_of(sys, tools: tools, dir: dir, work: work, a: a);
    let r = match pkg.registry_of(sys, m: &m, dir: dir, a: a) {
        ok(got8) => { got8 }
        err(_) => { return Failed.Failed; }
    };
    let cache = join(dir: work, name: "pkg", a);
    let vendor = join(dir: dir, name: "vendor", a);
    for d in locked.items() {
        if not pkg.safe_name(d.name.view()) {
            say(&mut sys.stderr, a: "arche-driver pkg: a package's name is an identifier, not ", b: d.name.view(), c: "");
            return Failed.Failed;
        }
    }
    pkg.remove_all(&sys.fs, path: vendor.view(), a: a);
    for d in locked.items() {
        let data = match pkg.archive(sys, r: &r, hash: d.hash.view(), cache: cache.view(), a: a) {
            ok(got9) => { got9 }
            err(_) => { return Failed.Failed; }
        };
        if not pkg.unpack(&sys.fs, data: data.items(), dir: join(dir: vendor.view(), name: d.name.view(), a).view(), to: &mut sys.stderr, a: a) {
            return Failed.Failed;
        }
    }
    sys.stdout.write("vendored ");
    sys.stdout.write_u64(locked.len() as u64);
    sys.stdout.write(" packages\n");
}

/// pkg add: the dependency goes into the manifest, then lock and vendor.
fn pkg_add(sys: &mut std.System, tools: &Tools, dir: str, work: str, name: str, version: str, a: alloc.Allocator) -> Failed!void {
    let m = try manifest_of(sys, tools: tools, dir: dir, work: work, a: a);
    for d in m.deps.items() {
        if d.name.view().eq(name) {
            say(&mut sys.stderr, a: "arche-driver pkg: the package depends on ", b: name, c: " already");
            return Failed.Failed;
        }
    }
    let r = match pkg.registry_of(sys, m: &m, dir: dir, a: a) {
        ok(got10) => { got10 }
        err(_) => { return Failed.Failed; }
    };
    var chosen = text_of(version.bytes(), a);
    if chosen.len() == 0 {
        var path = text_of(name.bytes(), a);
        path.push_str("/versions");
        match pkg.fetch(sys, r: &r, path: path.view(), a: a) {
            ok(found) => {
                match found {
                    some(b) => { chosen = pkg.latest(text_of(b.items(), a).view(), a); }
                    none => { }
                }
            }
            err(_) => { return Failed.Failed; }
        }
        if chosen.len() == 0 {
            say(&mut sys.stderr, a: "arche-driver pkg: the registry has no package ", b: name, c: "");
            return Failed.Failed;
        }
    }
    match pkg.release_hash(sys, r: &r, name: name, version: chosen.view(), a: a) {
        ok(_) => { }
        err(_) => { return Failed.Failed; }
    }
    let mpath = join(dir: dir, name: "package.arche", a);
    let text = match sys.fs.read_file(mpath.view(), a) {
        ok(got11) => { got11 }
        err(_) => { return Failed.Failed; }
    };
    var entry = text_of("build.dep(\"".bytes(), a);
    entry.push_str(name);
    entry.push_str("\", \"");
    entry.push_str(chosen.view());
    entry.push_str("\")");
    let updated = add_dependency(text: text.view(), entry: entry.view(), a: a);
    match sys.fs.write_file(path: mpath.view(), data: updated.view()) {
        ok(_) => { }
        err(_) => { return Failed.Failed; }
    }
    say(&mut sys.stdout, a: "added ", b: entry.view(), c: "");
    try pkg_lock(sys, tools: tools, dir: dir, work: work, a: a);
    try pkg_vendor(sys, tools: tools, dir: dir, work: work, a: a);
}

/// The manifest's text with one more dependency: in its dependencies
/// array, or in a new one before the end of PACKAGE.
fn add_dependency(text: str, entry: str, a: alloc.Allocator) -> alloc.String {
    let b = text.bytes();
    let key = "dependencies:".bytes();
    var at: usize = 0;
    var found = b.len();
    while at + key.len() <= b.len() and found == b.len() : (at += 1) {
        var k: usize = 0;
        while k < key.len() and b[at + k] == key[k] : (k += 1) {
        }
        if k == key.len() {
            found = at;
        }
    }
    var out = alloc.String.init(a);
    if found < b.len() {
        var lb = found;
        while lb < b.len() and b[lb] != '[' : (lb += 1) {
        }
        var rb = lb;
        while rb < b.len() and b[rb] != ']' : (rb += 1) {
        }
        // What is between the brackets, without the space around it.
        var s = lb + 1;
        while s < rb and (b[s] == ' ' or b[s] == '\n') : (s += 1) {
        }
        var e = rb;
        while e > s and (b[e - 1] == ' ' or b[e - 1] == '\n') : (e -= 1) {
        }
        out.push_str(text[0..lb + 1]);
        out.push_str(text[s..e]);
        if e > s and b[e - 1] != ',' {
            out.push_str(", ");
        } else if e > s {
            out.push_str(" ");
        }
        out.push_str(entry);
        out.push_str(text[rb..text.len()]);
        return out;
    }
    var close = b.len();
    var i: usize = 0;
    while i + 1 < b.len() : (i += 1) {
        if b[i] == '}' and b[i + 1] == ';' {
            close = i;
        }
    }
    out.push_str(text[0..close]);
    out.push_str("    dependencies: [");
    out.push_str(entry);
    out.push_str("],\n");
    out.push_str(text[close..text.len()]);
    return out;
}

fn usage(out: &mut std.Output) {
    out.write("usage: arche-driver build [dir]\n");
    out.write("       arche-driver run [dir] [program] [-- arguments]\n");
    out.write("       arche-driver clean [dir]\n");
    out.write("       arche-driver pkg add <name> [version] | lock | vendor | publish <registry> <key> | keygen <key>  [--dir d]\n");
}

fn main(sys: &mut std.System) -> !void {
    let a = sys.alloc;
    if sys.args.len() < 2 {
        usage(&mut sys.stderr);
        sys.proc.exit(2);
    }
    let command = text_of(sys.args.get(1).bytes(), a);
    if command.view().eq("pkg") {
        package_command(sys, a: a);
        return;
    }
    var dir = alloc.String.init(a);
    dir.push_str(".");
    var program_name = alloc.String.init(a);
    var program_args = alloc.List(alloc.String).init(a);
    var i: usize = 2;
    var dir_given = false;
    while i < sys.args.len() : (i += 1) {
        let arg = sys.args.get(i);
        if arg.eq("--") {
            i += 1;
            while i < sys.args.len() : (i += 1) {
                program_args.push(text_of(sys.args.get(i).bytes(), a));
            }
            break;
        }
        if not dir_given {
            dir = text_of(arg.bytes(), a);
            dir_given = true;
        } else {
            program_name.push_str(arg);
        }
    }
    let work = join(dir: dir.view(), name: "build", a);
    make_dirs(&sys.fs, dir: work.view(), a: a);
    if command.view().eq("clean") {
        let cache = join(dir: work.view(), name: "cache", a);
        let old = sys.fs.list(cache.view(), a) catch alloc.List(alloc.String).init(a);
        for f in old.items() {
            _ = sys.fs.remove(join(dir: cache.view(), name: f.view(), a).view());
        }
        return;
    }
    if not command.view().eq("build") and not command.view().eq("run") {
        usage(&mut sys.stderr);
        sys.proc.exit(2);
    }
    let tools = find_tools(sys, work: work.view(), a: a) catch sys.proc.exit(1);
    let programs = plan(sys, tools: &tools, dir: dir.view(), work: work.view(), a: a) catch sys.proc.exit(1);
    var chosen = alloc.String.init(a);
    var k: usize = 0;
    while k + 1 < programs.len() : (k += 2) {
        let name = programs[k].view();
        if command.view().eq("run") and program_name.len() > 0 and not program_name.view().eq(name) {
            continue;
        }
        let path = build_program(sys, tools: &tools, dir: dir.view(), name: name, root: programs[k + 1].view(), a: a) catch sys.proc.exit(1);
        if chosen.len() == 0 {
            chosen.push_str(path.view());
        }
    }
    if command.view().eq("build") {
        return;
    }
    if chosen.len() == 0 {
        say(&mut sys.stderr, a: "arche-driver: build.arche has no program ", b: program_name.view(), c: "");
        sys.proc.exit(1);
    }
    // Run it, its output ours, and end as it does.
    var argv = alloc.List(alloc.String).init(a);
    argv.push(chosen);
    for x in program_args.items() {
        argv.push(text_of(x.view().bytes(), a));
    }
    let status = run(sys, argv: &argv, out_path: "", a: a) catch sys.proc.exit(1);
    sys.proc.exit(status);
}

/// arche-driver pkg <command> [arguments] [--dir d].
fn package_command(sys: &mut std.System, a: alloc.Allocator) {
    var dir = text_of(".".bytes(), a);
    var rest = alloc.List(alloc.String).init(a);
    var i: usize = 2;
    while i < sys.args.len() : (i += 1) {
        if sys.args.get(i).eq("--dir") and i + 1 < sys.args.len() {
            i += 1;
            dir = text_of(sys.args.get(i).bytes(), a);
        } else {
            rest.push(text_of(sys.args.get(i).bytes(), a));
        }
    }
    if rest.len() == 0 {
        usage(&mut sys.stderr);
        sys.proc.exit(2);
    }
    let what = text_of(rest[0].view().bytes(), a);
    if what.view().eq("keygen") and rest.len() == 2 {
        pkg.keygen(sys, file: rest[1].view(), a: a) catch sys.proc.exit(1);
        return;
    }
    let work = join(dir: dir.view(), name: "build", a);
    make_dirs(&sys.fs, dir: work.view(), a: a);
    let tools = find_tools(sys, work: work.view(), a: a) catch sys.proc.exit(1);
    if what.view().eq("lock") and rest.len() == 1 {
        pkg_lock(sys, tools: &tools, dir: dir.view(), work: work.view(), a: a) catch sys.proc.exit(1);
    } else if what.view().eq("vendor") and rest.len() == 1 {
        pkg_vendor(sys, tools: &tools, dir: dir.view(), work: work.view(), a: a) catch sys.proc.exit(1);
    } else if what.view().eq("add") and (rest.len() == 2 or rest.len() == 3) {
        var version = alloc.String.init(a);
        if rest.len() == 3 {
            version.push_str(rest[2].view());
        }
        pkg_add(sys, tools: &tools, dir: dir.view(), work: work.view(), name: rest[1].view(), version: version.view(), a: a) catch sys.proc.exit(1);
    } else if what.view().eq("publish") and rest.len() == 3 {
        let m = manifest_of(sys, tools: &tools, dir: dir.view(), work: work.view(), a: a) catch sys.proc.exit(1);
        pkg.publish(sys, dir: dir.view(), m: &m, registry_dir: rest[1].view(), key_file: rest[2].view(), a: a) catch sys.proc.exit(1);
    } else {
        usage(&mut sys.stderr);
        sys.proc.exit(2);
    }
}
