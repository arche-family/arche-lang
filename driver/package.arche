// The build driver: it reads files, runs the compiler and clang, reads the
// environment and the clock, and fetches packages over HTTPS, which needs
// the network and randomness; so does the registry's server.
import std.build;

const PACKAGE: build.Package = build.Package {
    name: "arche_driver",
    version: "0.1.0",
    edition: 2026,
    needs: [build.Capability.Fs, build.Capability.Proc, build.Capability.Env, build.Capability.Clock, build.Capability.Net, build.Capability.Rand],
};
