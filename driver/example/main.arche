import std;
import alloc;
import words;

fn main(sys: &mut std.System) -> !void {
    var xs = alloc.List(u64).init(sys.alloc);
    for i: u64 in 1..=10 {
        xs.push(i);
    }
    var total: u64 = 0;
    for x in xs.items() {
        total += x.*;
    }
    sys.stdout.write(words.greeting());
    sys.stdout.write(": ");
    sys.stdout.write_u64(total);
    sys.stdout.write("\n");
}
