// The web benchmark's load generator (docs/sprints.md S33): it connects to
// a server on this machine, reads the clock, and runs a task a connection.
import std.build;

const PACKAGE: build.Package = build.Package {
    name: "webload",
    version: "0.1.0",
    edition: 2026,
    needs: [build.Capability.Net, build.Capability.Clock, build.Capability.Proc],
};
