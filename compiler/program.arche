/// A program: the root module and every module it reaches through imports
/// (spec/arche-0.md §3). The root's directory is the package root, and a
/// module path a.b is the file a/b.arche there.
import std;
import alloc;
import codes;
import diag;
import manifest;
import syntax.cst;
import syntax.lexer;
import syntax.parser;
import syntax.token as tk;

pub type ModuleId = struct { pub index: u32 }

/// What the program is built for (spec/arche.md §10.3): a host with std,
/// Linux or Windows, or a machine without an operating system, with core
/// and alloc only.
pub type Target = enum { LinuxX86_64, LinuxAarch64, LinuxRiscv64, WindowsX86_64, FreestandingX86_64, FreestandingRiscv64, FreestandingAarch64, WasiWasm32 }

pub fn target_by_name(name: str) -> ?Target {
    if name.eq("linux-x86_64") { return Target.LinuxX86_64; }
    if name.eq("linux-aarch64") { return Target.LinuxAarch64; }
    if name.eq("linux-riscv64") { return Target.LinuxRiscv64; }
    if name.eq("windows-x86_64") { return Target.WindowsX86_64; }
    if name.eq("freestanding-x86_64") { return Target.FreestandingX86_64; }
    if name.eq("freestanding-riscv64") { return Target.FreestandingRiscv64; }
    if name.eq("freestanding-aarch64") { return Target.FreestandingAarch64; }
    if name.eq("wasm32-wasi") { return Target.WasiWasm32; }
    return none;
}

/// Whether the target has an operating system under it, and so std.
pub fn hosted(t: Target) -> bool {
    return t == Target.LinuxX86_64 or t == Target.LinuxAarch64 or t == Target.LinuxRiscv64 or t == Target.WindowsX86_64 or t == Target.WasiWasm32;
}

/// The file of the library's std for a target: each host has its own
/// (lib/std.arche, lib/std-windows.arche, lib/std-wasi.arche; docs/abi.md).
pub fn std_file(t: Target) -> str {
    if t == Target.WindowsX86_64 {
        return "std-windows.arche";
    }
    if t == Target.WasiWasm32 {
        return "std-wasi.arche";
    }
    return "std.arche";
}

/// The file of the library's std.linux for a target: its numbers and how a
/// system call is made differ by processor.
pub fn linux_file(t: Target) -> str {
    if t == Target.LinuxAarch64 {
        return "std/linux-aarch64.arche";
    }
    if t == Target.LinuxRiscv64 {
        return "std/linux-riscv64.arche";
    }
    return "std/linux.arche";
}

/// The options of one compilation, from the command line.
pub type Options = struct {
    /// The library's directory, ending with '/'.
    pub lib: alloc.String,
    pub lib_alloc: bool,
    pub lib_std: bool,
    pub target: Target,
    /// module.function: what a panic calls on a freestanding target.
    pub panic_handler: alloc.String,
    /// Build the root module's test blocks and a runner, not main.
    pub tests: bool,
    /// A release build: the IR is optimized (ir/opt.arche).
    pub release: bool,
    /// An object from the compiler's own backend: lines, variables and types
    /// are kept for its debug info.
    pub debug_info: bool,
    /// Files whose text is elsewhere: an editor's unsaved buffers.
    pub overlays: alloc.List(Overlay),
    /// The package's root, when the file is not at it; empty: its directory.
    pub package: alloc.String,
    /// The root file need not have a main: any module, checked on its own.
    pub no_main: bool,
}

/// A file whose text is to be read from another one.
pub type Overlay = struct {
    pub path: alloc.String,
    pub text_path: alloc.String,
}

/// The overlay of a path, if it has one.
pub fn overlay_of(opts: &Options, path: str) -> ?usize {
    var i: usize = 0;
    while i < opts.overlays.len() : (i += 1) {
        if opts.overlays[i].path.view().eq(path) {
            return i;
        }
    }
    return none;
}

/// A source file's text, from its overlay when it has one.
fn read_source(fs: &std.Fs, opts: &Options, path: str, a: alloc.Allocator) -> std.IoError!alloc.String {
    match overlay_of(opts, path: path) {
        some(i) => { return fs.read_file(opts.overlays[i].text_path.view(), a); }
        none => { return fs.read_file(path, a); }
    }
}

pub type Module = struct {
    /// The dotted module path; empty for a root file whose name is not one.
    pub name: alloc.String,
    /// The file as it was opened, for diagnostics.
    pub path: alloc.String,
    /// The file relative to the package root, for panics (§10).
    pub display: alloc.String,
    pub text: alloc.String,
    pub tree: cst.Tree,
    /// Full Arche (spec/arche.md), not Arche-0: the package has a manifest,
    /// or the module is part of the library.
    pub full: bool,
    /// The edition its package declares (spec/arche.md §1.2); the
    /// library's is the first.
    pub edition: u32,
    /// Whether it belongs to the package being built or one of its
    /// dependencies, not the library: its manifest's needs and
    /// strict_unsafe apply to it.
    pub in_package: bool,
    /// Its package: 0 the root's, k + 1 the k-th dependency's; NO_PACKAGE
    /// for the library.
    pub package: u32,

    /// The source text of a token.
    pub fn token_text(self: &Module, t: u32) -> str {
        let tok = self.tree.tokens[t as usize];
        return self.text.view()[tok.start as usize..(tok.start + tok.len) as usize];
    }

    pub fn token_span(self: &Module, t: u32) -> diag.Span {
        let tok = self.tree.tokens[t as usize];
        return diag.Span { start: tok.start, len: tok.len };
    }

    /// The span of a node's significant tokens.
    pub fn node_span(self: &Module, id: cst.NodeId) -> diag.Span {
        let n = self.tree.node(id);
        let first = self.tree.first_token(id);
        if first >= n.end {
            return self.token_span(first);
        }
        var last = n.end - 1;
        while last > first and self.tree.tokens[last as usize].kind.is_trivia() : (last -= 1) {
        }
        let a = self.tree.tokens[first as usize];
        let b = self.tree.tokens[last as usize];
        return diag.Span { start: a.start, len: b.start + b.len - a.start };
    }
}

pub const NO_PACKAGE: u32 = 4294967295;

/// A dependency: its name, its directory, and its own manifest, whose
/// needs and edition its modules follow (spec/arche.md §1.1).
pub type Dep = struct {
    pub name: alloc.String,
    pub dir: alloc.String,
    pub manifest: manifest.Manifest,
}

/// An import resolved: the module's name in the program, its file, and
/// its package.
pub type Resolved = struct {
    pub dotted: alloc.String,
    pub file: alloc.String,
    pub package: u32,
}

pub type Program = struct {
    pub modules: alloc.List(Module),
    pub diags: diag.Diagnostics,
    pub a: alloc.Allocator,
    /// The package has a manifest, package.arche, at its root: it is full
    /// Arche (spec/arche.md §1). Without one it is Arche-0.
    pub full: bool,
    /// alloc is the library's (lib/alloc.arche), not the compiler's
    /// built-in one: in a full-Arche package, or when asked for.
    pub lib_alloc: bool,
    /// std is the library's (lib/std.arche): in a full-Arche package on
    /// Linux, or when asked for.
    pub lib_std: bool,
    pub target: Target,
    pub panic_handler: alloc.String,
    pub tests: bool,
    pub debug_info: bool,
    /// Whether the checker keeps where each name is used (arche query).
    pub record_uses: bool,
    /// The root file need not have a main (Options.no_main).
    pub no_main: bool,
    /// What the package's manifest declares (manifest.arche).
    pub manifest: manifest.Manifest,
    /// The dependencies package.lock lists, vendored in vendor/<name>/.
    pub deps: alloc.List(Dep),
    root_dir: alloc.String,

    /// The manifest of a module's package; the root's for the library's.
    pub fn manifest_of(self: &Program, module: u32) -> &manifest.Manifest {
        let pk = self.modules[module as usize].package;
        if pk == 0 or pk == NO_PACKAGE {
            return &self.manifest;
        }
        return &self.deps[(pk - 1) as usize].manifest;
    }

    pub fn module(self: &Program, id: ModuleId) -> &Module {
        return &self.modules[id.index as usize];
    }

    pub fn find(self: &Program, name: str) -> ?ModuleId {
        let items = self.modules.items();
        var i: usize = 0;
        while i < items.len() : (i += 1) {
            if items[i].name.view().eq(name) {
                return ModuleId { index: i as u32 };
            }
        }
        return none;
    }
}

fn is_identifier(s: str) -> bool {
    if s.len() == 0 or s.eq("_") {
        return false;
    }
    var i: usize = 0;
    while i < s.len() : (i += 1) {
        let c = s[i];
        match c {
            'a'..='z' | 'A'..='Z' | '_' => { }
            '0'..='9' => {
                if i == 0 {
                    return false;
                }
            }
            _ => { return false; }
        }
    }
    return true;
}

/// Lexes and parses one file into a module, reporting into p.diags.
fn add_module(p: &mut Program, name: str, path: str, display: str, text: alloc.String, full: bool, package: u32) -> ModuleId {
    let in_package = package != NO_PACKAGE;
    let id = ModuleId { index: p.modules.len() as u32 };
    p.diags.file = id.index;
    var edition = manifest.FIRST_EDITION;
    if package == 0 {
        edition = p.manifest.edition;
    } else if in_package {
        edition = p.deps[(package - 1) as usize].manifest.edition;
    }
    var lexed = diag.Diagnostics.init(p.a);
    lexed.file = id.index;
    let tokens = lexer.lex_edition(text.view(), full, edition: edition, diags: &mut lexed, a: p.a);
    let parsed = parser.parse_edition(tokens, text.view(), full, edition: edition, diags: lexed, a: p.a);
    var n = alloc.String.init(p.a);
    n.push_str(name);
    var pa = alloc.String.init(p.a);
    pa.push_str(path);
    var di = alloc.String.init(p.a);
    di.push_str(display);
    let found = parsed.diags.items.items();
    var i: usize = 0;
    while i < found.len() : (i += 1) {
        p.diags.items.push(copy_diagnostic(&found[i], p.a));
    }
    p.modules.push(Module { name: n, path: pa, display: di, text: text, tree: parsed.tree, full: full, edition: edition, in_package: in_package, package: package });
    return id;
}

fn copy_diagnostic(d: &diag.Diagnostic, a: alloc.Allocator) -> diag.Diagnostic {
    var m = alloc.String.init(a);
    m.push_str(d.message.view());
    var fix: ?diag.Fix = none;
    match &d.fix {
        some(f) => {
            var r = alloc.String.init(a);
            r.push_str(f.replacement.view());
            fix = some(diag.Fix { span: f.span, replacement: r });
        }
        none => { }
    }
    return diag.Diagnostic { file: d.file, code: d.code, span: d.span, message: m, fix: fix };
}

/// The path of an import, dotted ("a.b") and as a file ("a/b.arche").
type ImportPath = struct {
    dotted: alloc.String,
    file: alloc.String,
    library: bool,
    span: diag.Span,
}

fn import_path(m: &Module, node: cst.NodeId, a: alloc.Allocator) -> ImportPath {
    let own = m.tree.own_tokens(node, a);
    let toks = own.items();
    var dotted = alloc.String.init(a);
    var file = alloc.String.init(a);
    var i: usize = 1; // after 'import'
    while i < toks.len() : (i += 1) {
        let k = m.tree.token(toks[i]).kind;
        if k == tk.Kind.Ident {
            dotted.push_str(m.token_text(toks[i]));
            file.push_str(m.token_text(toks[i]));
        } else if k == tk.Kind.Dot {
            dotted.push_str(".");
            file.push_str("/");
        } else {
            break;
        }
    }
    file.push_str(".arche");
    // An import with a syntax error may have no name: it loads nothing.
    var library = true;
    if toks.len() > 1 and m.tree.token(toks[1]).kind == tk.Kind.Ident {
        let first = m.token_text(toks[1]);
        library = first.eq("std") or first.eq("alloc");
    }
    return ImportPath { dotted: dotted, file: file, library: library, span: m.node_span(node) };
}

/// The dependency named name, as its index in p.deps, if there is one.
pub fn dependency(p: &Program, name: str) -> ?u32 {
    var i: usize = 0;
    while i < p.deps.len() : (i += 1) {
        if p.deps[i].name.view().eq(name) {
            return i as u32;
        }
    }
    return none;
}

/// An import written in a module, resolved (spec/arche.md §1.1): a
/// dependency's name first reaches its package, vendor/<name>/, where
/// <name>.<path> is <path>.arche and <name> alone is <name>.arche; in a
/// dependency, the other paths are its own modules; in the root package
/// they are the package's, and its own name may lead them.
pub fn resolve_import(p: &Program, module: u32, dotted: str, a: alloc.Allocator) -> Resolved {
    var first_end: usize = 0;
    while first_end < dotted.len() and dotted[first_end] != '.' : (first_end += 1) {
    }
    let first = dotted[0..first_end];
    var rest = "";
    if first_end < dotted.len() {
        rest = dotted[first_end + 1..dotted.len()];
    }
    var r = Resolved { dotted: alloc.String.init(a), file: alloc.String.init(a), package: 0 };
    var dep: ?u32 = dependency(p, name: first);
    var dep_rest = rest;
    var dep_whole = rest.len() == 0;
    let pk = p.modules[module as usize].package;
    if pk != 0 and pk != NO_PACKAGE {
        match dep {
            some(_) => { }
            none => {
                // A path of the dependency's own.
                dep = some(pk - 1);
                dep_rest = dotted;
                dep_whole = false;
            }
        }
    }
    match dep {
        some(d) => {
            let name = p.deps[d as usize].name.view();
            r.package = d + 1;
            r.dotted.push_str(name);
            r.file.push_str("vendor/");
            r.file.push_str(name);
            r.file.push_str("/");
            if dep_whole {
                r.file.push_str(name);
            } else {
                r.dotted.push_str(".");
                r.dotted.push_str(dep_rest);
                var i: usize = 0;
                while i < dep_rest.len() : (i += 1) {
                    if dep_rest[i] == '.' {
                        r.file.push_ascii('/');
                    } else {
                        r.file.push_ascii(dep_rest[i]);
                    }
                }
            }
            r.file.push_str(".arche");
            return r;
        }
        none => { }
    }
    var own = dotted;
    if p.manifest.found and rest.len() > 0 and first.eq(p.manifest.name.view()) {
        own = rest;
    }
    r.dotted.push_str(own);
    var i: usize = 0;
    while i < own.len() : (i += 1) {
        if own[i] == '.' {
            r.file.push_ascii('/');
        } else {
            r.file.push_ascii(own[i]);
        }
    }
    r.file.push_str(".arche");
    return r;
}

/// The dependencies package.lock lists (name version hash, a line each),
/// with their manifests from vendor/<name>/package.arche.
fn read_lock(fs: &std.Fs, p: &mut Program, a: alloc.Allocator) {
    var lock_path = alloc.String.init(a);
    lock_path.push_str(p.root_dir.view());
    lock_path.push_str("package.lock");
    var text = alloc.String.init(a);
    match fs.read_file(lock_path.view(), a) {
        ok(t) => { text = t; }
        err(_) => { return; }
    }
    let t = text.view();
    var start: usize = 0;
    var i: usize = 0;
    while i <= t.len() : (i += 1) {
        if i < t.len() and t[i] != '\n' {
            continue;
        }
        let line = t[start..i];
        start = i + 1;
        if line.len() == 0 or line[0] == '#' {
            continue;
        }
        var sp: usize = 0;
        while sp < line.len() and line[sp] != ' ' : (sp += 1) {
        }
        var name = alloc.String.init(a);
        name.push_str(line[0..sp]);
        var dir = alloc.String.init(a);
        dir.push_str("vendor/");
        dir.push_str(name.view());
        dir.push_str("/");
        var mpath = alloc.String.init(a);
        mpath.push_str(p.root_dir.view());
        mpath.push_str(dir.view());
        mpath.push_str("package.arche");
        var m = manifest.defaults(a);
        match fs.read_file(mpath.view(), a) {
            ok(mtext) => {
                var lexed = diag.Diagnostics.init(a);
                let tokens = lexer.lex(mtext.view(), true, &mut lexed, a);
                let parsed = parser.parse(tokens, mtext.view(), true, lexed, a);
                var problems = parsed.diags;
                if problems.count() == 0 {
                    m = manifest.read(parsed.tree, text: mtext.view(), diags: &mut problems, a: a);
                }
            }
            err(_) => { }
        }
        p.deps.push(Dep { name: name, dir: dir, manifest: m });
    }
}

/// The imports of a module that name package modules, not library roots.
fn package_imports(m: &Module, a: alloc.Allocator, lib_alloc: bool, lib_std: bool) -> alloc.List(ImportPath) {
    var out = alloc.List(ImportPath).init(a);
    let file_node = m.tree.node(m.tree.root);
    var c: u32 = 0;
    while c < file_node.children_len : (c += 1) {
        let item = m.tree.child(file_node, c);
        if m.tree.node(item).kind == cst.Kind.Import {
            let ip = import_path(m, item, a);
            let d = ip.dotted.view();
            if not ip.library or (lib_alloc and d.eq("alloc")) or (lib_std and (d.eq("std") or d.starts_with("std."))) {
                out.push(ip);
            }
        }
    }
    return out;
}

/// Starts from the root file, whose text the caller has read, and loads,
/// breadth first, every module it imports.
pub fn freestanding(p: &Program) -> bool {
    return not hosted(p.target);
}

pub fn load(fs: &std.Fs, path: str, text: alloc.String, a: alloc.Allocator, opts: &Options) -> Program {
    let lib = opts.lib.view();
    var handler = alloc.String.init(a);
    handler.push_str(opts.panic_handler.view());
    var p = Program {
        modules: alloc.List(Module).init(a),
        diags: diag.Diagnostics.init(a),
        a: a,
        full: false,
        lib_alloc: opts.lib_alloc or opts.lib_std or not hosted(opts.target) or opts.target == Target.WasiWasm32,
        lib_std: (opts.lib_std and hosted(opts.target)) or opts.target == Target.WasiWasm32,
        target: opts.target,
        panic_handler: handler,
        tests: opts.tests,
        debug_info: opts.debug_info,
        record_uses: false,
        no_main: opts.no_main,
        manifest: manifest.defaults(a),
        deps: alloc.List(Dep).init(a),
        root_dir: alloc.String.init(a),
    };
    var base = path;
    var at_package = false;
    if opts.package.len() > 0 {
        var dir = alloc.String.init(a);
        dir.push_str(opts.package.view());
        if dir.view()[dir.len() - 1] != '/' {
            dir.push_str("/");
        }
        if path.starts_with(dir.view()) {
            p.root_dir.push_str(dir.view());
            base = path[dir.len()..path.len()];
            at_package = true;
        }
    }
    if not at_package {
        var slash: ?usize = none;
        var i: usize = 0;
        while i < path.len() : (i += 1) {
            if path[i] == '/' {
                slash = some(i);
            }
        }
        match slash {
            some(s) => {
                p.root_dir.push_str(path[0..s + 1]);
                base = path[s + 1..path.len()];
            }
            none => { }
        }
    }
    var manifest_path = alloc.String.init(a);
    manifest_path.push_str(p.root_dir.view());
    manifest_path.push_str("package.arche");
    var manifest_problems = diag.Diagnostics.init(a);
    var manifest_tree = cst.Tree { tokens: alloc.List(tk.Token).init(a), nodes: alloc.List(cst.Node).init(a), children: alloc.List(cst.NodeId).init(a), root: cst.NodeId { index: 0 } };
    var manifest_text = alloc.String.init(a);
    match read_source(fs, opts, path: manifest_path.view(), a: a) {
        ok(mtext) => {
            p.full = true;
            p.lib_alloc = true;
            p.lib_std = hosted(p.target);
            var lexed = diag.Diagnostics.init(a);
            let tokens = lexer.lex(mtext.view(), true, &mut lexed, a);
            let parsed = parser.parse(tokens, mtext.view(), true, lexed, a);
            let found = parsed.diags.items.items();
            var k: usize = 0;
            while k < found.len() : (k += 1) {
                manifest_problems.items.push(copy_diagnostic(&found[k], a));
            }
            // Diagnostics need only the text; the tree goes to the reader.
            if found.len() == 0 {
                p.manifest = manifest.read(parsed.tree, text: mtext.view(), diags: &mut manifest_problems, a: a);
                if p.panic_handler.len() == 0 {
                    p.panic_handler.push_str(p.manifest.panic_handler.view());
                }
            } else {
                manifest_tree = parsed.tree;
            }
            manifest_text = mtext;
        }
        err(_) => { }
    }
    var stem = base;
    if base.len() > 6 and base[base.len() - 6..base.len()].eq(".arche") {
        stem = base[0..base.len() - 6];
    }
    // Below the package's root, its path names it: a/b.arche is a.b.
    var dotted_root = alloc.String.init(a);
    var dotted_ok = stem.len() > 0;
    var part: usize = 0;
    var at: usize = 0;
    while at <= stem.len() : (at += 1) {
        if at == stem.len() or stem[at] == '/' {
            dotted_ok = dotted_ok and is_identifier(stem[part..at]);
            if part > 0 {
                dotted_root.push_str(".");
            }
            dotted_root.push_str(stem[part..at]);
            part = at + 1;
        }
    }
    var root_name = "";
    if dotted_ok {
        root_name = dotted_root.view();
    }
    let root_full = p.full;
    read_lock(fs, p: &mut p, a: a);
    _ = add_module(&mut p, name: root_name, path: path, display: base, text, full: root_full, package: 0);

    var next: usize = 0;
    while next < p.modules.len() : (next += 1) {
        // The imports are collected first: adding a module grows p.modules,
        // so no view of a module may be live then (§5.4).
        let imports = package_imports(&p.modules[next], a, lib_alloc: p.lib_alloc, lib_std: p.lib_std);
        let ips = imports.items();
        var c: usize = 0;
        while c < ips.len() : (c += 1) {
            let ip = &ips[c];
            // core and its modules come from the library (spec/arche.md
            // §1.1): full Arche, whatever the package is.
            let written = ip.dotted.view();
            let from_lib = written.eq("core") or written.starts_with("core.") or (p.lib_alloc and written.eq("alloc")) or
                (p.lib_std and (written.eq("std") or written.starts_with("std."))) or
                (p.full and (written.starts_with("crypto.") or written.eq("tls") or written.starts_with("tls.") or written.eq("http") or written.starts_with("http.") or written.eq("web") or written.starts_with("web.") or written.eq("kv") or written.eq("font") or written.starts_with("image.")));
            var r = Resolved { dotted: alloc.String.init(a), file: alloc.String.init(a), package: NO_PACKAGE };
            if from_lib {
                r.dotted.push_str(written);
                if written.eq("std") {
                    // Each host has its own std; the module is std for all
                    // of them (std_file, docs/abi.md).
                    r.file.push_str(std_file(p.target));
                } else if written.eq("std.linux") {
                    r.file.push_str(linux_file(p.target));
                } else {
                    r.file.push_str(ip.file.view());
                }
            } else {
                r = resolve_import(&p, module: next as u32, dotted: written, a: a);
            }
            match p.find(r.dotted.view()) {
                some(_) => { continue; }
                none => { }
            }
            var full = alloc.String.init(a);
            var shown = alloc.String.init(a);
            if from_lib {
                full.push_str(lib);
                shown.push_str("lib/");
                full.push_str(r.file.view());
                shown.push_str(r.file.view());
            } else {
                full.push_str(p.root_dir.view());
                full.push_str(r.file.view());
                shown.push_str(r.file.view());
            }
            let module_full = from_lib or p.full;
            match read_source(fs, opts, path: full.view(), a: a) {
                ok(source) => {
                    _ = add_module(&mut p, name: r.dotted.view(), path: full.view(), display: shown.view(), source, full: module_full, package: r.package);
                }
                err(_) => {
                    p.diags.file = next as u32;
                    var msg = p.diags.new_message();
                    msg.push_str("cannot find module '");
                    msg.push_str(r.dotted.view());
                    msg.push_str("': there is no readable file ");
                    msg.push_str(full.view());
                    p.diags.report_owned(codes.MODULE_NOT_FOUND, ip.span, msg);
                }
            }
        }
    }
    // A manifest that cannot be read is shown as a file of its own.
    if manifest_problems.count() > 0 {
        let index = p.modules.len() as u32;
        var name = alloc.String.init(a);
        name.push_str("package");
        var shown_name = alloc.String.init(a);
        shown_name.push_str("package.arche");
        p.modules.push(Module {
            name: name,
            path: manifest_path,
            display: shown_name,
            text: manifest_text,
            tree: manifest_tree,
            full: true,
            edition: manifest.FIRST_EDITION,
            in_package: true,
            package: 0,
        });
        let found = manifest_problems.items.items();
        var k: usize = 0;
        while k < found.len() : (k += 1) {
            var d = copy_diagnostic(&found[k], a);
            d.file = index;
            p.diags.items.push(d);
        }
    }
    return p;
}

/// Writes every diagnostic of the program, as text or JSON.
pub fn write_diagnostics(out: &mut std.Output, p: &Program, json: bool) {
    let mods = p.modules.items();
    var first = true;
    if json {
        out.write("[");
    }
    var i: usize = 0;
    while i < mods.len() : (i += 1) {
        let m = &mods[i];
        if json {
            diag.write_json(out, &p.diags, i as u32, path: m.path.view(), text: m.text.view(), first: &mut first);
        } else {
            diag.write_text(out, &p.diags, i as u32, path: m.path.view(), text: m.text.view());
        }
    }
    if json {
        if not first {
            out.write("\n");
        }
        out.write("]\n");
    }
}
