/// Name resolution and type checking: spec/arche-0.md §3–§10.
///
/// The whole program is checked at once, in passes: imports and the names
/// of every module's items; the members of type declarations; constants;
/// function signatures; `main`; and last the bodies (sema.stmt and
/// sema.expr). The checker reads the CST directly and keeps what it learns
/// in tables indexed by handles: declarations, fields, variants,
/// functions, and the type of every expression node.
import std;
import alloc;
import codes;
import diag;
import program;
import syntax.cst;
import syntax.token as tk;
import sema.types as ty;
import sema.stmt;
import sema.consts;
import sema.expr;
import sema.memory;

pub const NONE: u32 = 4294967295;
/// node_refs of a FieldExpr that reads a field of a value: it is a place.
pub const VALUE_FIELD: u32 = 4294967294;
/// node_refs from ENV_REF up name entry (ref - ENV_REF) of env: a comptime
/// value parameter.
pub const ENV_REF: u32 = 2147483648;

pub type Library = enum { NotLibrary, Std, Alloc }

/// What an import binds: a library root of §11, or a module of the package.
pub type Alias = struct {
    pub library: Library,
    pub module: u32,
}

pub type DeclKind = enum { Fn, Const, Struct, Enum, ErrorSet, Alias, Interface }

pub type SelfMode = enum { Value, Ref, MutRef }

pub type Decl = struct {
    pub kind: DeclKind,
    pub module: u32,
    pub node: cst.NodeId,
    pub name: alloc.Symbol,
    pub name_token: u32,
    pub is_pub: bool,
    /// Struct, Enum, ErrorSet: its type. Alias and Const: their type, once
    /// resolved.
    pub type_id: ty.TypeId,
    /// Alias and Const: 0 before, 1 while and 2 after they are resolved.
    pub state: u32,
    /// A method: the declaration of its type; NONE otherwise.
    pub owner: u32,
    /// Struct: a range of fields; Enum: of variants; ErrorSet: of
    /// error_members.
    pub members_start: u32,
    pub members_len: u32,
    /// Struct and Enum: a range of methods.
    pub methods_start: u32,
    pub methods_len: u32,
    /// Fn: its index in fns.
    pub fn_index: u32,
    /// Const: an integer or bool value as two's complement bits; a str
    /// value as the string literal it comes from.
    pub value: u64,
    pub value_module: u32,
    pub value_node: cst.NodeId,
    /// A declaration with comptime parameters: a template, instantiated per
    /// list of arguments (spec/arche.md §4).
    pub generic: bool,
    /// An instance: its template, and its arguments as a range of env.
    pub template: u32,
    pub env_start: u32,
    pub env_len: u32,
    /// A method of an `impl`: its index in impls; NONE otherwise.
    pub impl_index: u32,
}

/// impl I for T (spec/arche.md §5.1): its methods are methods of T.
pub type Impl = struct {
    pub module: u32,
    pub node: cst.NodeId,
    /// The interface's declaration, and the type; NONE and invalid until
    /// resolved, or when they are wrong.
    pub iface: u32,
    pub target: ty.TypeId,
    pub methods_start: u32,
    pub methods_len: u32,
}

/// What a closure captures: a copy or move of a binding, or a view of it
/// (mode Ref or MutRef). type_id is the binding's type.
pub type Capture = struct {
    pub name: alloc.Symbol,
    pub name_token: u32,
    pub type_id: ty.TypeId,
    pub mode: SelfMode,
}

/// A closure (spec/arche.md §6): its body is function fn_index, which
/// takes the closure's captures as its first, hidden parameter.
pub type Closure = struct {
    pub fn_index: u32,
    pub captures_start: u32,
    pub captures_len: u32,
}

/// A comptime argument, bound to its parameter's name.
pub type EnvEntry = struct {
    pub name: alloc.Symbol,
    pub is_type: bool,
    pub type_id: ty.TypeId,
    /// A value argument: its bits, and type_id is its type.
    pub value: u64,
}

/// What instances are made already: a template and its arguments.
pub type InstKey = struct {
    pub template: u32,
    pub n: u32,
    pub kinds: u32,
    pub a0: u64,
    pub a1: u64,
    pub a2: u64,
    pub a3: u64,
}

pub type Field = struct {
    pub name: alloc.Symbol,
    pub name_token: u32,
    pub type_id: ty.TypeId,
    pub is_pub: bool,
}

pub type Variant = struct {
    pub name: alloc.Symbol,
    pub name_token: u32,
    pub has_fields: bool,
    pub fields_start: u32,
    pub fields_len: u32,
}

pub type ParamInfo = struct {
    pub name: alloc.Symbol,
    pub name_token: u32,
    pub type_id: ty.TypeId,
}

pub type FnInfo = struct {
    pub decl: u32,
    pub params_start: u32,
    pub params_len: u32,
    pub ret: ty.TypeId,
    pub has_self: bool,
    pub self_mode: SelfMode,
    /// The table of node types and references of an instance's body, or
    /// NONE for the module's own (generic bodies differ per instance).
    pub table: u32,
    /// Calls pass this many comptime arguments before the run-time ones.
    pub ncomptime: u32,
}

pub type Binding = struct {
    pub name: alloc.Symbol,
    pub name_token: u32,
    pub type_id: ty.TypeId,
    pub mutable: bool,
}

pub type Checker = struct {
    pub p: program.Program,
    pub t: ty.Types,
    pub names: alloc.Interner,
    pub decls: alloc.List(Decl),
    pub fields: alloc.List(Field),
    pub variants: alloc.List(Variant),
    pub fns: alloc.List(FnInfo),
    pub params: alloc.List(ParamInfo),
    pub methods: alloc.List(u32),
    pub error_members: alloc.List(u32),
    /// Error names are global (§5.2): each has one number, from 1.
    pub error_ids: alloc.Map(alloc.Symbol, u32),
    pub error_names: alloc.List(alloc.Symbol),
    /// Per module: its items, and the names its imports bind.
    pub items: alloc.List(alloc.Map(alloc.Symbol, u32)),
    pub imports: alloc.List(alloc.Map(alloc.Symbol, Alias)),
    /// Per module, per CST node: the type of the expression.
    pub node_types: alloc.List(alloc.List(ty.TypeId)),
    /// Per module, per CST node: the declaration a name or call refers to
    /// (a constant, a function), or NONE.
    pub node_refs: alloc.List(alloc.List(u32)),
    pub scope: alloc.List(Binding),
    /// The module whose code is being checked.
    pub module: u32,
    /// The function being checked; NONE in a constant.
    pub fn_index: u32,
    pub loops: u32,
    /// The loop depth where the innermost defer began; NONE outside defers.
    pub defer_loops: u32,
    /// The declaration of std.IoError.
    pub io_error: u32,
    /// Comptime arguments of instances; the range that is in scope.
    pub env: alloc.List(EnvEntry),
    pub env_start: u32,
    pub env_len: u32,
    /// Node tables of instance bodies, and the one in use.
    pub tables: alloc.List(alloc.Map(u32, ty.TypeId)),
    pub ref_tables: alloc.List(alloc.Map(u32, u32)),
    pub cur_table: u32,
    pub instances: alloc.Map(InstKey, u32),
    /// Instance functions whose bodies are still to be checked.
    pub pending: alloc.List(u32),
    /// The next call checked has this many comptime arguments first.
    pub arg_offset: u32,
    /// Function bodies already checked: a constant can call a function
    /// before the pass over bodies reaches it.
    pub checked: alloc.Map(u32, bool),
    pub impls: alloc.List(Impl),
    /// Expressions of type &T used where a &dyn I is expected: the &dyn I,
    /// by dyn_key (spec/arche.md §5.3).
    pub dyn_casts: alloc.Map(u64, ty.TypeId),
    /// What `Self` names: inside an interface, the interface; inside an
    /// impl, its type; invalid elsewhere.
    pub self_type: ty.TypeId,
    /// Inside an unsafe block or an unsafe fn (spec/arche.md §10.1).
    pub unsafe_depth: u32,
    pub closures: alloc.List(Closure),
    pub captures: alloc.List(Capture),
    /// The interfaces fn(P) -> R made so far (spec/arche.md §6).
    pub fn_ifaces: alloc.List(u32),
    /// Inside a closure: the bindings around it, which it may not use
    /// without capturing them.
    pub outer_scope: alloc.List(Binding),
    pub a: alloc.Allocator,
}

// ---- the current module ---------------------------------------------------------

pub fn tree(c: &Checker) -> &cst.Tree {
    return &c.p.modules[c.module as usize].tree;
}

pub fn node(c: &Checker, n: cst.NodeId) -> cst.Node {
    return c.p.modules[c.module as usize].tree.node(n);
}

pub fn kind_of(c: &Checker, n: cst.NodeId) -> cst.Kind {
    return c.p.modules[c.module as usize].tree.node(n).kind;
}

/// Reports an operation that needs unsafe outside of it (spec/arche.md §10.1).
pub fn require_unsafe(c: &mut Checker, s: diag.Span, what: str) {
    if c.unsafe_depth > 0 {
        return;
    }
    var m = new_message(c);
    m.push_str(what);
    m.push_str(" is allowed only inside 'unsafe { ... }' or an 'unsafe fn'");
    report_owned(c, codes.NEEDS_UNSAFE, s, m);
}

/// Declaration d is an unsafe fn.
pub fn is_unsafe_fn(c: &Checker, d: u32) -> bool {
    let decl = c.decls[d as usize];
    let t = &c.p.modules[decl.module as usize].tree;
    match t.find_own(decl.node, tk.Kind.KwUnsafe, c.a) {
        some(_) => { return true; }
        none => { return false; }
    }
}

/// The kind of node n of module m.
pub fn kind_of_in(c: &Checker, m: u32, n: cst.NodeId) -> cst.Kind {
    return c.p.modules[m as usize].tree.node(n).kind;
}

/// A function's declaration is a signature only: a method of an interface.
pub fn is_signature(c: &Checker, f: u32) -> bool {
    let d = c.fns[f as usize].decl;
    if d == NONE {
        return false;
    }
    let k = kind_of_in(c, c.decls[d as usize].module, c.decls[d as usize].node);
    return k == cst.Kind.FnSig or k == cst.Kind.TypeFn;
}

/// The function is a closure's body (spec/arche.md §6).
pub fn is_closure_fn(c: &Checker, f: u32) -> bool {
    let d = c.fns[f as usize].decl;
    if d == NONE {
        return false;
    }
    return kind_of_in(c, c.decls[d as usize].module, c.decls[d as usize].node) == cst.Kind.ClosureExpr;
}

/// The closure whose body is function f.
pub fn closure_of_fn(c: &Checker, f: u32) -> u32 {
    var i: usize = 0;
    while i < c.closures.len() : (i += 1) {
        if c.closures[i].fn_index == f {
            return i as u32;
        }
    }
    return NONE;
}

/// Declaration d is an interface fn(P) -> R.
pub fn is_fn_iface(c: &Checker, d: u32) -> bool {
    let decl = c.decls[d as usize];
    return decl.kind == DeclKind.Interface and kind_of_in(c, decl.module, decl.node) == cst.Kind.TypeFn;
}

/// The interface fn(P) -> R, one per signature: its one method, `call`,
/// takes the closure as self (spec/arche.md §6).
pub fn fn_iface(c: &mut Checker, n: cst.NodeId) -> ty.TypeId {
    var params = alloc.List(ty.TypeId).init(c.a);
    var ret = ty.void_type();
    let count = child_count(c, n);
    let arrow = has_own(c, n, tk.Kind.Arrow);
    var i: u32 = 0;
    while i < count : (i += 1) {
        let t = resolve_type(c, child(c, n, i));
        if arrow and i == count - 1 {
            ret = t;
        } else {
            params.push(t);
        }
    }
    let ps = params.items();
    var k: usize = 0;
    while k < c.fn_ifaces.len() : (k += 1) {
        let d = c.fn_ifaces[k];
        let f = c.fns[c.decls[c.methods[c.decls[d as usize].methods_start as usize] as usize].fn_index as usize];
        var same = f.ret == ret and f.params_len == ps.len() as u32 + 1;
        var j: usize = 0;
        while same and j < ps.len() : (j += 1) {
            same = c.params[f.params_start as usize + 1 + j].type_id == ps[j];
        }
        if same {
            return c.decls[d as usize].type_id;
        }
    }
    let id = c.decls.len() as u32;
    var d = new_decl(DeclKind.Interface, module: c.module, n, c.names.intern("fn"), name_token: first_own(c, n), true);
    d.type_id = c.t.declared(ty.Kind.Interface, id);
    let it = d.type_id;
    c.decls.push(d);
    var md = new_decl(DeclKind.Fn, module: c.module, n, c.names.intern("call"), name_token: first_own(c, n), true);
    md.owner = id;
    let mid = c.decls.len() as u32;
    c.decls.push(md);
    let start = c.params.len() as u32;
    let self_sym = c.names.intern("self");
    c.params.push(ParamInfo { name: self_sym, name_token: first_own(c, n), type_id: c.t.reference(false, it) });
    var q: usize = 0;
    while q < ps.len() : (q += 1) {
        var pname = alloc.String.init(c.a);
        pname.push_str("p");
        write_number(&mut pname, q as u64);
        let sym = c.names.intern(pname.view());
        c.params.push(ParamInfo { name: sym, name_token: first_own(c, n), type_id: ps[q] });
    }
    c.decls[mid as usize].fn_index = c.fns.len() as u32;
    c.fns.push(FnInfo {
        decl: mid,
        params_start: start,
        params_len: c.params.len() as u32 - start,
        ret: ret,
        has_self: true,
        self_mode: SelfMode.Ref,
        table: NONE,
        ncomptime: 0,
    });
    c.decls[id as usize].methods_start = c.methods.len() as u32;
    c.decls[id as usize].methods_len = 1;
    c.methods.push(mid);
    c.fn_ifaces.push(id);
    return it;
}

/// Closure ci has the signature of the interface fn(P) -> R declared by d.
fn closure_fits(c: &Checker, ci: u32, d: u32) -> bool {
    let cf = c.fns[c.closures[ci as usize].fn_index as usize];
    let f = c.fns[c.decls[c.methods[c.decls[d as usize].methods_start as usize] as usize].fn_index as usize];
    if cf.ret != f.ret or cf.params_len + 1 != f.params_len {
        return false;
    }
    var j: u32 = 0;
    while j < cf.params_len : (j += 1) {
        if c.params[(cf.params_start + j) as usize].type_id != c.params[(f.params_start + 1 + j) as usize].type_id {
            return false;
        }
    }
    return true;
}

pub fn child(c: &Checker, n: cst.NodeId, i: u32) -> cst.NodeId {
    let t = &c.p.modules[c.module as usize].tree;
    return t.child(t.node(n), i);
}

pub fn child_count(c: &Checker, n: cst.NodeId) -> u32 {
    return c.p.modules[c.module as usize].tree.node(n).children_len;
}

pub fn own(c: &Checker, n: cst.NodeId) -> alloc.List(u32) {
    return c.p.modules[c.module as usize].tree.own_tokens(n, c.a);
}

/// The first own token of a node, without allocating.
pub fn first_own(c: &Checker, n: cst.NodeId) -> u32 {
    return c.p.modules[c.module as usize].tree.first_own(n);
}

pub fn has_own(c: &Checker, n: cst.NodeId, k: tk.Kind) -> bool {
    match c.p.modules[c.module as usize].tree.find_own(n, k, c.a) {
        some(_) => { return true; }
        none => { return false; }
    }
}

pub fn find_own(c: &Checker, n: cst.NodeId, k: tk.Kind) -> ?u32 {
    return c.p.modules[c.module as usize].tree.find_own(n, k, c.a);
}

pub fn tok_kind(c: &Checker, t: u32) -> tk.Kind {
    return c.p.modules[c.module as usize].tree.token(t).kind;
}

pub fn tok_value(c: &Checker, t: u32) -> u64 {
    return c.p.modules[c.module as usize].tree.token(t).value;
}

pub fn text(c: &Checker, t: u32) -> str {
    return c.p.modules[c.module as usize].token_text(t);
}

pub fn symbol(c: &mut Checker, t: u32) -> alloc.Symbol {
    return c.names.intern(c.p.modules[c.module as usize].token_text(t));
}

pub fn span_of(c: &Checker, n: cst.NodeId) -> diag.Span {
    return c.p.modules[c.module as usize].node_span(n);
}

pub fn token_span(c: &Checker, t: u32) -> diag.Span {
    return c.p.modules[c.module as usize].token_span(t);
}

/// The first identifier a node owns: the name of a declaration.
pub fn ident_of(c: &Checker, n: cst.NodeId) -> u32 {
    return find_own(c, n, tk.Kind.Ident) orelse c.p.modules[c.module as usize].tree.first_token(n);
}

pub fn name_text(c: &Checker, sym: alloc.Symbol) -> str {
    return c.names.text(sym);
}

/// The type checked for an expression node of the current module.
pub fn type_of(c: &Checker, n: cst.NodeId) -> ty.TypeId {
    if c.cur_table != NONE {
        return c.tables[c.cur_table as usize].get(n.index) orelse ty.invalid();
    }
    return c.node_types[c.module as usize][n.index as usize];
}

pub fn set_type(c: &mut Checker, n: cst.NodeId, t: ty.TypeId) {
    if c.cur_table != NONE {
        c.tables[c.cur_table as usize].put(n.index, t);
        return;
    }
    c.node_types[c.module as usize][n.index as usize] = t;
}

pub fn ref_of(c: &Checker, n: cst.NodeId) -> u32 {
    if c.cur_table != NONE {
        return c.ref_tables[c.cur_table as usize].get(n.index) orelse NONE;
    }
    return c.node_refs[c.module as usize][n.index as usize];
}

pub fn set_ref(c: &mut Checker, n: cst.NodeId, d: u32) {
    if c.cur_table != NONE {
        c.ref_tables[c.cur_table as usize].put(n.index, d);
        return;
    }
    c.node_refs[c.module as usize][n.index as usize] = d;
}

/// The comptime argument in scope named `name`.
pub fn find_env(c: &Checker, name: alloc.Symbol) -> ?u32 {
    var i = c.env_start;
    while i < c.env_start + c.env_len : (i += 1) {
        if c.env[i as usize].name == name {
            return i;
        }
    }
    return none;
}

/// Brings the comptime arguments and node table of a declaration into
/// scope; the caller restores the previous ones from the result.
pub type Context = struct {
    pub module: u32,
    pub env_start: u32,
    pub env_len: u32,
    pub cur_table: u32,
    pub self_type: ty.TypeId,
}

pub fn save_context(c: &Checker) -> Context {
    return Context { module: c.module, env_start: c.env_start, env_len: c.env_len, cur_table: c.cur_table, self_type: c.self_type };
}

pub fn restore_context(c: &mut Checker, x: Context) {
    c.module = x.module;
    c.env_start = x.env_start;
    c.env_len = x.env_len;
    c.cur_table = x.cur_table;
    c.self_type = x.self_type;
}

pub fn enter_decl(c: &mut Checker, d: u32) {
    let decl = c.decls[d as usize];
    c.module = decl.module;
    c.env_start = decl.env_start;
    c.env_len = decl.env_len;
    c.self_type = ty.invalid();
    if decl.owner != NONE {
        let owner = c.decls[decl.owner as usize];
        if owner.kind == DeclKind.Interface or decl.impl_index != NONE {
            c.self_type = owner.type_id;
        }
    } else if decl.kind == DeclKind.Interface {
        c.self_type = decl.type_id;
    }
}

// ---- diagnostics ------------------------------------------------------------------

pub fn report(c: &mut Checker, code: u16, span: diag.Span, message: str) {
    c.p.diags.file = c.module;
    c.p.diags.report(code, span, message);
}

pub fn report_owned(c: &mut Checker, code: u16, span: diag.Span, message: alloc.String) {
    c.p.diags.file = c.module;
    c.p.diags.report_owned(code, span, message);
}

pub fn new_message(c: &Checker) -> alloc.String {
    return c.p.diags.new_message();
}

/// A type as the source writes it: "&mut alloc.List(u32)".
pub fn write_type(c: &Checker, m: &mut alloc.String, t: ty.TypeId) {
    let info = c.t.get(t);
    match info.kind {
        .Invalid => { m.push_str("<invalid>"); }
        .Void => { m.push_str("void"); }
        .Noreturn => { m.push_str("noreturn"); }
        .Bool => { m.push_str("bool"); }
        .Str => { m.push_str("str"); }
        .Int => { m.push_str(ty.int_name(info.int_kind)); }
        .Ref => {
            m.push_str("&");
            if info.mutable {
                m.push_str("mut ");
            }
            write_type(c, m, info.elem);
        }
        .Slice => {
            m.push_str("[]");
            if info.mutable {
                m.push_str("mut ");
            }
            write_type(c, m, info.elem);
        }
        .Array => {
            m.push_str("[");
            write_number(m, info.len);
            m.push_str("]");
            write_type(c, m, info.elem);
        }
        .List => {
            m.push_str("alloc.List(");
            write_type(c, m, info.elem);
            m.push_str(")");
        }
        .Map => {
            m.push_str("alloc.Map(");
            write_type(c, m, info.key);
            m.push_str(", ");
            write_type(c, m, info.elem);
            m.push_str(")");
        }
        .Optional => {
            m.push_str("?");
            write_type(c, m, info.elem);
        }
        .ErrorUnion => {
            if info.decl != NONE {
                write_decl_name(c, m, info.decl);
            }
            m.push_str("!");
            write_type(c, m, info.elem);
        }
        .ErrorSet => {
            if info.decl == NONE {
                m.push_str("error");
            } else {
                write_decl_name(c, m, info.decl);
            }
        }
        .Struct | .Enum | .Interface => { write_decl_name(c, m, info.decl); }
        .Dyn => {
            m.push_str("&");
            if info.mutable {
                m.push_str("mut ");
            }
            m.push_str("dyn ");
            write_decl_name(c, m, info.decl);
        }
        .Ptr => {
            m.push_str("*");
            if info.mutable {
                m.push_str("mut ");
            }
            write_type(c, m, info.elem);
        }
        .Closure => {
            m.push_str("closure ");
            write_signature(c, m, f: c.closures[info.decl as usize].fn_index, skip: 0);
        }
        .Builtin => {
            match info.builtin {
                .Output => { m.push_str("std.Output"); }
                .Args => { m.push_str("std.Args"); }
                .Fs => { m.push_str("std.Fs"); }
                .System => { m.push_str("std.System"); }
                .Allocator => { m.push_str("alloc.Allocator"); }
                .String => { m.push_str("alloc.String"); }
                .Interner => { m.push_str("alloc.Interner"); }
                .Symbol => { m.push_str("alloc.Symbol"); }
                .NotBuiltin => { m.push_str("?"); }
            }
        }
    }
}

/// fn(P) -> R of function f, leaving out its first `skip` parameters.
pub fn write_signature(c: &Checker, m: &mut alloc.String, f: u32, skip: u32) {
    let info = c.fns[f as usize];
    m.push_str("fn(");
    var i = info.params_start + skip;
    while i < info.params_start + info.params_len : (i += 1) {
        if i > info.params_start + skip {
            m.push_str(", ");
        }
        write_type(c, m, c.params[i as usize].type_id);
    }
    m.push_str(")");
    if c.t.kind(info.ret) != ty.Kind.Void {
        m.push_str(" -> ");
        write_type(c, m, info.ret);
    }
}

pub fn write_decl_name(c: &Checker, m: &mut alloc.String, d: u32) {
    if d == c.io_error {
        m.push_str("std.IoError");
        return;
    }
    if is_fn_iface(c, d) {
        let md = c.methods[c.decls[d as usize].methods_start as usize];
        write_signature(c, m, f: c.decls[md as usize].fn_index, skip: 1);
        return;
    }
    let decl = c.decls[d as usize];
    let module_name = c.p.modules[decl.module as usize].name.view();
    if decl.module != c.module and module_name.len() > 0 {
        m.push_str(module_name);
        m.push_str(".");
    }
    m.push_str(c.names.text(decl.name));
    if decl.template != NONE and decl.kind != DeclKind.Fn {
        m.push_str("(");
        var i = decl.env_start;
        while i < decl.env_start + decl.env_len : (i += 1) {
            if i > decl.env_start {
                m.push_str(", ");
            }
            let e = c.env[i as usize];
            if e.is_type {
                write_type(c, m, e.type_id);
            } else {
                write_number(m, e.value);
            }
        }
        m.push_str(")");
    }
}

pub fn write_number(m: &mut alloc.String, n: u64) {
    if n >= 10 {
        write_number(m, n / 10);
    }
    m.push_ascii('0' + (n % 10) as u8);
}

/// "expected T, found U" at a node.
pub fn report_mismatch(c: &mut Checker, n: cst.NodeId, want: ty.TypeId, got: ty.TypeId) {
    var m = new_message(c);
    m.push_str("expected ");
    write_type(c, &mut m, want);
    m.push_str(", found ");
    write_type(c, &mut m, got);
    let s = span_of(c, n);
    report_owned(c, codes.TYPE_MISMATCH, s, m);
}

// ---- types ------------------------------------------------------------------

pub fn is_int(c: &Checker, t: ty.TypeId) -> bool {
    return c.t.kind(t) == ty.Kind.Int;
}

pub fn is_invalid(c: &Checker, t: ty.TypeId) -> bool {
    return c.t.kind(t) == ty.Kind.Invalid;
}

/// A value of type got can be used where want is expected: they are the
/// same, or got never completes, or one is invalid already, or got is a
/// &mut T or []mut T where &T or []T is expected (§5.4).
pub fn assignable(c: &Checker, got: ty.TypeId, want: ty.TypeId) -> bool {
    if got == want {
        return true;
    }
    let g = c.t.get(got);
    let w = c.t.get(want);
    if g.kind == ty.Kind.Noreturn or g.kind == ty.Kind.Invalid or w.kind == ty.Kind.Invalid {
        return true;
    }
    if g.kind == ty.Kind.Dyn and w.kind == ty.Kind.Dyn {
        return g.decl == w.decl and g.mutable and not w.mutable;
    }
    return g.kind == w.kind and (g.kind == ty.Kind.Ref or g.kind == ty.Kind.Slice) and g.elem == w.elem and g.mutable and
        not w.mutable;
}

/// Where an expression of the current module or instance is converted to
/// &dyn I: its module, instance table and node.
pub fn dyn_key(c: &Checker, n: cst.NodeId) -> u64 {
    let table = ((c.cur_table +% 1) & 0xFFFFFF) as u64;
    return (table << 40) | ((c.module as u64) << 28) | n.index as u64;
}

/// The &dyn I that expression n is converted to, or invalid.
pub fn dyn_cast(c: &Checker, n: cst.NodeId) -> ty.TypeId {
    return c.dyn_casts.get(dyn_key(c, n)) orelse ty.invalid();
}

/// == and != work on the type (§5.5).
pub fn comparable(c: &Checker, t: ty.TypeId) -> bool {
    return comparable_within(c, t, 0);
}

/// A type that contains itself (E0423) would make the walk endless; past
/// this depth the error is already reported, and the answer does not
/// matter.
const MAX_TYPE_DEPTH: u32 = 64;

fn comparable_within(c: &Checker, t: ty.TypeId, depth: u32) -> bool {
    if depth > MAX_TYPE_DEPTH {
        return true;
    }
    let info = c.t.get(t);
    match info.kind {
        .Int | .Bool | .ErrorSet | .Invalid | .Ptr => { return true; }
        .Builtin => { return info.builtin == ty.Builtin.Symbol; }
        .Enum => {
            let d = c.decls[info.decl as usize];
            var i = d.members_start;
            while i < d.members_start + d.members_len : (i += 1) {
                if c.variants[i as usize].has_fields {
                    return false;
                }
            }
            return true;
        }
        .Struct => {
            let d = c.decls[info.decl as usize];
            var i = d.members_start;
            while i < d.members_start + d.members_len : (i += 1) {
                if not comparable_within(c, c.fields[i as usize].type_id, depth + 1) {
                    return false;
                }
            }
            return true;
        }
        _ => { return false; }
    }
}

/// The type can be a Map key (§5.5).
pub fn is_key(c: &Checker, t: ty.TypeId) -> bool {
    return is_key_within(c, t, 0);
}

fn is_key_within(c: &Checker, t: ty.TypeId, depth: u32) -> bool {
    if depth > MAX_TYPE_DEPTH {
        return true;
    }
    let info = c.t.get(t);
    if info.kind == ty.Kind.ErrorSet {
        return false;
    }
    if info.kind == ty.Kind.Struct {
        let d = c.decls[info.decl as usize];
        var i = d.members_start;
        while i < d.members_start + d.members_len : (i += 1) {
            if not is_key_within(c, c.fields[i as usize].type_id, depth + 1) {
                return false;
            }
        }
        return true;
    }
    return comparable_within(c, t, depth);
}

fn primitive(name: str) -> ?ty.TypeId {
    match ty.int_by_name(name) {
        some(k) => { return ty.int_type(k); }
        none => { }
    }
    if name.eq("bool") {
        return ty.bool_type();
    }
    if name.eq("str") {
        return ty.str_type();
    }
    if name.eq("void") {
        return ty.void_type();
    }
    if name.eq("noreturn") {
        return ty.noreturn_type();
    }
    return none;
}

/// The type of a comptime value parameter: an integer type, bool or str
/// (spec/arche.md §4.1); invalid otherwise. Only these names are looked
/// at, so a parameter typed with its own template cannot recurse.
fn comptime_param_type(c: &Checker, p: cst.NodeId) -> ty.TypeId {
    let tn = child(c, p, 0);
    if kind_of(c, tn) != cst.Kind.TypePath or child_count(c, tn) > 0 {
        return ty.invalid();
    }
    let toks = own(c, tn);
    if toks.len() != 1 {
        return ty.invalid();
    }
    match primitive(text(c, toks[0])) {
        some(t) => {
            if t == ty.void_type() or t == ty.noreturn_type() {
                return ty.invalid();
            }
            return t;
        }
        none => { return ty.invalid(); }
    }
}

/// Reports comptime value parameters of other types than those.
fn check_comptime_params(c: &mut Checker, n: cst.NodeId) {
    let count = child_count(c, n);
    var i: u32 = 0;
    while i < count : (i += 1) {
        let p = child(c, n, i);
        if kind_of(c, p) != cst.Kind.Param or not has_own(c, p, tk.Kind.KwComptime) or child_count(c, p) == 0 {
            continue;
        }
        if not takes_type(c, p) and is_invalid(c, comptime_param_type(c, p)) {
            let s = span_of(c, child(c, p, 0));
            report(c, codes.BAD_GENERIC, s, "a comptime parameter takes a type, an integer, a bool or a str");
        }
    }
}

pub fn is_predeclared(name: str) -> bool {
    match primitive(name) {
        some(_) => { return true; }
        none => { }
    }
    return name.eq("panic") or name.eq("assert") or name.eq("unreachable");
}

/// A type of §11 by its library and name.
pub fn library_type(c: &mut Checker, lib: Library, name: str) -> ?ty.TypeId {
    if lib == Library.Std {
        if name.eq("Output") { return c.t.builtin(ty.Builtin.Output); }
        if name.eq("Args") { return c.t.builtin(ty.Builtin.Args); }
        if name.eq("Fs") { return c.t.builtin(ty.Builtin.Fs); }
        if name.eq("System") { return c.t.builtin(ty.Builtin.System); }
        if name.eq("IoError") { return c.decls[c.io_error as usize].type_id; }
    } else if lib == Library.Alloc {
        if name.eq("Allocator") { return c.t.builtin(ty.Builtin.Allocator); }
        if name.eq("String") { return c.t.builtin(ty.Builtin.String); }
        if name.eq("Interner") { return c.t.builtin(ty.Builtin.Interner); }
        if name.eq("Symbol") { return c.t.builtin(ty.Builtin.Symbol); }
    }
    return none;
}

pub fn find_item(c: &Checker, module: u32, name: alloc.Symbol) -> ?u32 {
    return c.items[module as usize].get(name);
}

pub fn find_import(c: &Checker, name: alloc.Symbol) -> ?Alias {
    return c.imports[c.module as usize].get(name);
}

/// Erasable (§4), but cheap: another module reaches only what is pub.
pub fn require_visible(c: &mut Checker, span: diag.Span, owner_module: u32, is_pub: bool, what: str) {
    if owner_module == c.module or is_pub {
        return;
    }
    var m = new_message(c);
    m.push_str(what);
    m.push_str(" is private to module '");
    m.push_str(c.p.modules[owner_module as usize].name.view());
    m.push_str("'; mark it 'pub' to use it here");
    report_owned(c, codes.PRIVATE, span, m);
}

/// The type a declaration names, resolving an alias the first time.
pub fn decl_type(c: &mut Checker, d: u32) -> ty.TypeId {
    let decl = c.decls[d as usize];
    if decl.kind != DeclKind.Alias or decl.state == 2 {
        return decl.type_id;
    }
    if decl.state == 1 {
        let saved = c.module;
        c.module = decl.module;
        let s = token_span(c, decl.name_token);
        report(c, codes.ALIAS_CYCLE, s, "this type alias refers to itself");
        c.module = saved;
        c.decls[d as usize].state = 2;
        c.decls[d as usize].type_id = ty.invalid();
        return ty.invalid();
    }
    c.decls[d as usize].state = 1;
    let saved = c.module;
    c.module = decl.module;
    let target = resolve_type(c, child(c, decl.node, 0));
    c.module = saved;
    if c.decls[d as usize].state == 1 {
        c.decls[d as usize].type_id = target;
        c.decls[d as usize].state = 2;
    }
    return c.decls[d as usize].type_id;
}

/// The type a type node of the current module names (§5).
pub fn resolve_type(c: &mut Checker, n: cst.NodeId) -> ty.TypeId {
    match kind_of(c, n) {
        .TypeRef => {
            if has_own(c, n, tk.Kind.KwDyn) {
                let it = resolve_interface(c, child(c, n, 0));
                if is_invalid(c, it) {
                    return ty.invalid();
                }
                let d = c.t.get(it).decl;
                dyn_safe(c, d, span_of(c, n));
                return c.t.dyn_ref(has_own(c, n, tk.Kind.KwMut), d);
            }
            let elem = resolve_type(c, child(c, n, 0));
            if c.t.kind(elem) == ty.Kind.Interface and not is_self_path(c, child(c, n, 0)) {
                let s = span_of(c, n);
                report(c, codes.INTERFACE_AS_TYPE, s, "a view of a value of any type that implements an interface is written '&dyn I'");
                return ty.invalid();
            }
            return c.t.reference(has_own(c, n, tk.Kind.KwMut), elem);
        }
        .TypeSlice => {
            let elem = resolve_type(c, child(c, n, 0));
            return c.t.slice(has_own(c, n, tk.Kind.KwMut), elem);
        }
        .TypePtr => {
            let elem = resolve_type(c, child(c, n, 0));
            return c.t.pointer(has_own(c, n, tk.Kind.KwMut), elem);
        }
        .TypeFn => {
            let s = span_of(c, n);
            report(c, codes.INTERFACE_AS_TYPE, s, "fn(P) -> R is the interface of closures; a view of one is '&dyn fn(P) -> R'");
            return ty.invalid();
        }
        .TypeOptional => {
            let elem = resolve_type(c, child(c, n, 0));
            return c.t.optional(elem);
        }
        .TypeArray => {
            let len = consts.array_length(c, child(c, n, 0));
            let elem = resolve_type(c, child(c, n, 1));
            return c.t.array(elem, len);
        }
        .TypeErrorUnion => {
            if child_count(c, n) == 1 {
                let elem = resolve_type(c, child(c, n, 0));
                return c.t.error_union(NONE, elem);
            }
            let set = resolve_type(c, child(c, n, 0));
            let elem = resolve_type(c, child(c, n, 1));
            let info = c.t.get(set);
            if info.kind == ty.Kind.Invalid {
                return ty.invalid();
            }
            if info.kind != ty.Kind.ErrorSet {
                var m = new_message(c);
                write_type(c, &mut m, set);
                m.push_str(" is not an error set; E!T needs one");
                let s = span_of(c, child(c, n, 0));
                report_owned(c, codes.TYPE_MISMATCH, s, m);
                return ty.invalid();
            }
            return c.t.error_union(info.decl, elem);
        }
        .TypePath => {
            let t = resolve_path_type(c, n);
            if c.t.kind(t) == ty.Kind.Interface and not is_self_path(c, n) {
                var m = new_message(c);
                write_type(c, &mut m, t);
                m.push_str(" is an interface, not a type of values; a view of a value that implements it is '&dyn ");
                write_type(c, &mut m, t);
                m.push_str("'");
                let s = span_of(c, n);
                report_owned(c, codes.INTERFACE_AS_TYPE, s, m);
                return ty.invalid();
            }
            return t;
        }
        _ => {
            let s = span_of(c, n);
            report(c, codes.UNKNOWN_TYPE, s, "expected a type");
            return ty.invalid();
        }
    }
}

/// The type node is `Self`, in an interface or an impl.
fn is_self_path(c: &Checker, n: cst.NodeId) -> bool {
    if not c.p.full or is_invalid(c, c.self_type) or kind_of(c, n) != cst.Kind.TypePath or child_count(c, n) > 0 {
        return false;
    }
    let toks = own(c, n);
    return toks.len() == 1 and text(c, toks[0]).eq("Self");
}

/// The interface a type node names, or invalid after reporting why not
/// (spec/arche.md §5).
pub fn resolve_interface(c: &mut Checker, n: cst.NodeId) -> ty.TypeId {
    if kind_of(c, n) == cst.Kind.TypeFn {
        return fn_iface(c, n);
    }
    if kind_of(c, n) != cst.Kind.TypePath {
        let s = span_of(c, n);
        report(c, codes.BAD_IMPL, s, "expected an interface");
        return ty.invalid();
    }
    let t = resolve_path_type(c, n);
    if is_invalid(c, t) or c.t.kind(t) == ty.Kind.Interface {
        return t;
    }
    var m = new_message(c);
    write_type(c, &mut m, t);
    m.push_str(" is not an interface");
    let s = span_of(c, n);
    report_owned(c, codes.BAD_IMPL, s, m);
    return ty.invalid();
}

/// An interface is usable with dyn when its methods take self by
/// reference, mention Self nowhere else and take no comptime arguments
/// (spec/arche.md §5.3).
fn dyn_safe(c: &mut Checker, d: u32, at: diag.Span) {
    let decl = c.decls[d as usize];
    var i = decl.methods_start;
    while i < decl.methods_start + decl.methods_len : (i += 1) {
        let md = c.methods[i as usize];
        check_signature(c, md);
        if c.decls[md as usize].fn_index == NONE {
            continue;
        }
        let f = c.fns[c.decls[md as usize].fn_index as usize];
        var fine = f.has_self and f.self_mode != SelfMode.Value and f.ncomptime == 0 and
            not mentions(c, t: f.ret, x: decl.type_id, 0);
        var k = f.params_start + 1;
        while k < f.params_start + f.params_len : (k += 1) {
            fine = fine and not mentions(c, t: c.params[k as usize].type_id, x: decl.type_id, 0);
        }
        if not fine {
            var m = new_message(c);
            write_decl_name(c, &mut m, d);
            m.push_str(" cannot be used with dyn: its method '");
            m.push_str(c.names.text(c.decls[md as usize].name));
            m.push_str("' must take self as &Self or &mut Self and use Self nowhere else");
            report_owned(c, codes.NOT_DYN_SAFE, at, m);
            return;
        }
    }
}

/// Type t contains type x.
fn mentions(c: &Checker, t: ty.TypeId, x: ty.TypeId, depth: u32) -> bool {
    if t == x {
        return true;
    }
    if depth > 32 {
        return false;
    }
    let info = c.t.get(t);
    match info.kind {
        .Ref | .Slice | .Array | .List | .Optional | .ErrorUnion => { return mentions(c, t: info.elem, x: x, depth + 1); }
        .Map => { return mentions(c, t: info.key, x: x, depth + 1) or mentions(c, t: info.elem, x: x, depth + 1); }
        _ => { return false; }
    }
}

/// Type t with x replaced by y: an interface's signature for one type.
pub fn replace_type(c: &mut Checker, t: ty.TypeId, x: ty.TypeId, y: ty.TypeId) -> ty.TypeId {
    if t == x {
        return y;
    }
    let info = c.t.get(t);
    match info.kind {
        .Ref => { return c.t.reference(info.mutable, replace_type(c, t: info.elem, x: x, y: y)); }
        .Slice => { return c.t.slice(info.mutable, replace_type(c, t: info.elem, x: x, y: y)); }
        .Array => { return c.t.array(replace_type(c, t: info.elem, x: x, y: y), info.len); }
        .List => { return c.t.list(replace_type(c, t: info.elem, x: x, y: y)); }
        .Optional => { return c.t.optional(replace_type(c, t: info.elem, x: x, y: y)); }
        .ErrorUnion => { return c.t.error_union(info.decl, replace_type(c, t: info.elem, x: x, y: y)); }
        .Map => {
            let k = replace_type(c, t: info.key, x: x, y: y);
            let v = replace_type(c, t: info.elem, x: x, y: y);
            return c.t.map(key: k, value: v);
        }
        _ => { return t; }
    }
}

fn report_unknown_type(c: &mut Checker, n: cst.NodeId) {
    var m = new_message(c);
    m.push_str("unknown type '");
    let toks = own(c, n);
    let items = toks.items();
    var i: usize = 0;
    while i < items.len() and tok_kind(c, items[i]) != tk.Kind.LParen : (i += 1) {
        m.push_str(text(c, items[i]));
    }
    m.push_str("'");
    let s = span_of(c, n);
    report_owned(c, codes.UNKNOWN_TYPE, s, m);
}

fn resolve_path_type(c: &mut Checker, n: cst.NodeId) -> ty.TypeId {
    let toks = own(c, n);
    let items = toks.items();
    var segments = alloc.List(u32).init(c.a);
    var i: usize = 0;
    while i < items.len() and tok_kind(c, items[i]) != tk.Kind.LParen : (i += 1) {
        if tok_kind(c, items[i]) == tk.Kind.Ident {
            segments.push(items[i]);
        }
    }
    let nargs = child_count(c, n);
    if segments.len() == 0 {
        let s = span_of(c, n);
        report(c, codes.UNKNOWN_TYPE, s, "'type' is only the type of a comptime parameter");
        return ty.invalid();
    }
    let first = segments[0];
    if segments.len() == 1 and nargs == 0 and c.p.full and not is_invalid(c, c.self_type) and text(c, first).eq("Self") {
        return c.self_type;
    }
    if segments.len() == 1 {
        let sym = symbol(c, first);
        match find_env(c, sym) {
            some(e) => {
                if c.env[e as usize].is_type and nargs == 0 {
                    return c.env[e as usize].type_id;
                }
                let s = span_of(c, n);
                report(c, codes.UNKNOWN_TYPE, s, "this comptime parameter is a value, not a type");
                return ty.invalid();
            }
            none => { }
        }
        if nargs == 0 {
            match primitive(text(c, first)) {
                some(t) => { return t; }
                none => { }
            }
        }
        match find_item(c, c.module, sym) {
            some(d) => {
                let k = c.decls[d as usize].kind;
                if k != DeclKind.Fn and k != DeclKind.Const {
                    if c.decls[d as usize].generic {
                        return instance_from_type_args(c, d, n);
                    }
                    if nargs == 0 {
                        return decl_type(c, d);
                    }
                }
            }
            none => { }
        }
        report_unknown_type(c, n);
        return ty.invalid();
    }
    if segments.len() != 2 {
        report_unknown_type(c, n);
        return ty.invalid();
    }
    let alias_sym = symbol(c, first);
    let second = segments[1];
    match find_import(c, alias_sym) {
        some(alias) => {
            if alias.library == Library.Alloc and (text(c, second).eq("List") or text(c, second).eq("Map")) {
                return resolve_generic(c, n, text(c, second).eq("List"));
            }
            if nargs > 0 and alias.library != Library.NotLibrary {
                let s = span_of(c, n);
                report(c, codes.BAD_GENERIC, s, "Arche-0 has no generic types besides alloc.List and alloc.Map");
                return ty.invalid();
            }
            if alias.library != Library.NotLibrary {
                // A copy: library_type changes c, so no view of c may go with it.
                var name = alloc.String.init(c.a);
                name.push_str(text(c, second));
                match library_type(c, alias.library, name.view()) {
                    some(t) => { return t; }
                    none => { }
                }
            } else {
                let sym = symbol(c, second);
                match find_item(c, alias.module, sym) {
                    some(d) => {
                        let decl = c.decls[d as usize];
                        if decl.kind != DeclKind.Fn and decl.kind != DeclKind.Const {
                            let s = span_of(c, n);
                            require_visible(c, s, decl.module, decl.is_pub, "this type");
                            if decl.generic {
                                return instance_from_type_args(c, d, n);
                            }
                            if nargs == 0 {
                                return decl_type(c, d);
                            }
                        }
                    }
                    none => { }
                }
            }
        }
        none => { }
    }
    report_unknown_type(c, n);
    return ty.invalid();
}

fn resolve_generic(c: &mut Checker, n: cst.NodeId, is_list: bool) -> ty.TypeId {
    let nargs = child_count(c, n);
    if (is_list and nargs != 1) or (not is_list and nargs != 2) {
        let s = span_of(c, n);
        if is_list {
            report(c, codes.BAD_GENERIC, s, "alloc.List takes one type");
        } else {
            report(c, codes.BAD_GENERIC, s, "alloc.Map takes two types: the key and the value");
        }
        return ty.invalid();
    }
    let a = resolve_type(c, child(c, n, 0));
    if is_list {
        return c.t.list(a);
    }
    let b = resolve_type(c, child(c, n, 1));
    return make_map(c, n, key: a, value: b);
}

/// alloc.Map(key, value), when key can be a key (§5.5).
pub fn make_map(c: &mut Checker, n: cst.NodeId, key: ty.TypeId, value: ty.TypeId) -> ty.TypeId {
    if not is_key(c, key) {
        var m = new_message(c);
        write_type(c, &mut m, key);
        m.push_str(" cannot be a Map key (§5.5)");
        let s = span_of(c, n);
        report_owned(c, codes.BAD_KEY, s, m);
        return ty.invalid();
    }
    return c.t.map(key: key, value: value);
}

// ---- generics (spec/arche.md §4) --------------------------------------------------

/// A comptime argument: a type, or a value's bits.
pub type ArgVal = struct {
    pub is_type: bool,
    pub type_id: ty.TypeId,
    pub value: u64,
}

/// The comptime parameters of a template: the leading Param children of a
/// type declaration, or the comptime Param children of a function.
pub fn template_params(c: &Checker, d: u32) -> alloc.List(cst.NodeId) {
    let decl = c.decls[d as usize];
    var out = alloc.List(cst.NodeId).init(c.a);
    let t = &c.p.modules[decl.module as usize].tree;
    let n = t.node(decl.node);
    var i: u32 = 0;
    while i < n.children_len : (i += 1) {
        let ch = t.child(n, i);
        if t.node(ch).kind != cst.Kind.Param {
            if decl.kind == DeclKind.Fn {
                continue;
            }
            break;
        }
        match t.find_own(ch, tk.Kind.KwComptime, c.a) {
            some(_) => { out.push(ch); }
            none => { }
        }
    }
    return out;
}

/// The parameter's type is `type`: it takes a type.
pub fn takes_type(c: &Checker, param: cst.NodeId) -> bool {
    let tnode = child(c, param, 0);
    return tok_kind(c, tree(c).first_token(tnode)) == tk.Kind.KwType;
}

fn arg_bits(a: ArgVal) -> u64 {
    if a.is_type {
        return a.type_id.index as u64;
    }
    return a.value;
}

/// The instance of template d for these arguments: made and checked the
/// first time, then reused. NONE when the arguments do not fit.
pub fn instantiate(c: &mut Checker, d: u32, args: &alloc.List(ArgVal), at: diag.Span) -> u32 {
    let saved = save_context(c);
    enter_decl(c, d);
    c.env_len = 0;
    let params = template_params(c, d);
    let ps = params.items();
    let given = args.items();
    if ps.len() != given.len() or ps.len() > 4 {
        restore_context(c, saved);
        var m = new_message(c);
        m.push_str("this takes ");
        write_number(&mut m, ps.len() as u64);
        m.push_str(" comptime argument");
        if ps.len() != 1 {
            m.push_str("s");
        }
        if ps.len() > 4 {
            m.push_str(", and the compiler handles up to 4 for now");
        }
        report_owned(c, codes.BAD_GENERIC, at, m);
        return NONE;
    }
    var key = InstKey { template: d, n: ps.len() as u32, kinds: 0, a0: 0, a1: 0, a2: 0, a3: 0 };
    var i: usize = 0;
    while i < ps.len() : (i += 1) {
        let wants_type = takes_type(c, ps[i]);
        if wants_type != given[i].is_type {
            restore_context(c, saved);
            if wants_type {
                report(c, codes.BAD_GENERIC, at, "this comptime argument should be a type");
            } else {
                report(c, codes.BAD_GENERIC, at, "this comptime argument should be a value, not a type");
            }
            return NONE;
        }
        if given[i].is_type {
            key.kinds = key.kinds | (1 << i as u32);
        }
        let bits = arg_bits(given[i]);
        if i == 0 { key.a0 = bits; }
        if i == 1 { key.a1 = bits; }
        if i == 2 { key.a2 = bits; }
        if i == 3 { key.a3 = bits; }
    }
    match c.instances.get(key) {
        some(found) => {
            restore_context(c, saved);
            return found;
        }
        none => { }
    }
    let env_start = c.env.len() as u32;
    i = 0;
    while i < ps.len() : (i += 1) {
        let sym = symbol(c, ident_of(c, ps[i]));
        var t = given[i].type_id;
        if not given[i].is_type {
            t = comptime_param_type(c, ps[i]);
        }
        c.env.push(EnvEntry { name: sym, is_type: given[i].is_type, type_id: t, value: given[i].value });
    }
    // where T: I (spec/arche.md §5.2), with the arguments in scope.
    c.env_start = env_start;
    c.env_len = ps.len() as u32;
    var unmet = new_message(c);
    bounds_unmet(c, d, &mut unmet);
    c.env_len = 0;
    if unmet.len() > 0 {
        restore_context(c, saved);
        report_owned(c, codes.BOUND_UNMET, at, unmet);
        return NONE;
    }
    var inst = c.decls[d as usize];
    inst.generic = false;
    inst.template = d;
    inst.env_start = env_start;
    inst.env_len = ps.len() as u32;
    let id = c.decls.len() as u32;
    c.decls.push(inst);
    c.instances.put(key, id);
    let k = inst.kind;
    if k == DeclKind.Struct {
        c.decls[id as usize].type_id = c.t.declared(ty.Kind.Struct, id);
    } else if k == DeclKind.Enum {
        c.decls[id as usize].type_id = c.t.declared(ty.Kind.Enum, id);
    } else if k == DeclKind.ErrorSet {
        c.decls[id as usize].type_id = c.t.declared(ty.Kind.ErrorSet, id);
    } else if k == DeclKind.Interface {
        c.decls[id as usize].type_id = c.t.declared(ty.Kind.Interface, id);
    }
    if k == DeclKind.Fn {
        check_signature(c, id);
        c.pending.push(c.decls[id as usize].fn_index);
    } else {
        resolve_members(c, id);
        let mstart = c.decls[id as usize].methods_start;
        let mlen = c.decls[id as usize].methods_len;
        var mi = mstart;
        while mi < mstart + mlen : (mi += 1) {
            let md = c.methods[mi as usize];
            c.decls[md as usize].env_start = env_start;
            c.decls[md as usize].env_len = ps.len() as u32;
            check_signature(c, md);
            c.pending.push(c.decls[md as usize].fn_index);
        }
    }
    restore_context(c, saved);
    return id;
}

/// The where clause of a declaration, or NONE.
fn where_clause(c: &Checker, n: cst.NodeId) -> cst.NodeId {
    let count = child_count(c, n);
    var i: u32 = 0;
    while i < count : (i += 1) {
        let ch = child(c, n, i);
        if kind_of(c, ch) == cst.Kind.WhereClause {
            return ch;
        }
    }
    return cst.NodeId { index: NONE };
}

/// Says in m which bound of template d its arguments, in scope as env,
/// do not meet; m stays empty when they meet every one.
fn bounds_unmet(c: &mut Checker, d: u32, m: &mut alloc.String) {
    let w = where_clause(c, c.decls[d as usize].node);
    if w.index == NONE {
        return;
    }
    let nb = child_count(c, w);
    var i: u32 = 0;
    while i < nb : (i += 1) {
        let b = child(c, w, i);
        let nt = first_own(c, b);
        let sym = symbol(c, nt);
        var arg = ty.invalid();
        match find_env(c, sym) {
            some(e) => {
                if c.env[e as usize].is_type {
                    arg = c.env[e as usize].type_id;
                }
            }
            none => { }
        }
        if is_invalid(c, arg) {
            let s = token_span(c, nt);
            report(c, codes.BOUND_UNMET, s, "'where' constrains the comptime type parameters of its declaration");
            continue;
        }
        let ni = child_count(c, b);
        var k: u32 = 0;
        while k < ni : (k += 1) {
            let it = resolve_interface(c, child(c, b, k));
            if is_invalid(c, it) or m.len() > 0 {
                continue;
            }
            if not implements(c, arg, c.t.get(it).decl) {
                m.push_str(text(c, nt));
                m.push_str(" is ");
                write_type(c, m, arg);
                m.push_str(", which does not implement ");
                write_type(c, m, it);
                m.push_str(" (where ");
                m.push_str(text(c, nt));
                m.push_str(": ");
                write_type(c, m, it);
                m.push_str(")");
            }
        }
    }
}

/// A comptime value written where a type argument may be: a literal, a
/// constant, or a comptime value parameter.
pub fn comptime_value(c: &mut Checker, n: cst.NodeId, t: ty.TypeId) -> u64 {
    if kind_of(c, n) == cst.Kind.TypePath {
        let toks = own(c, n);
        if toks.len() == 1 and tok_kind(c, toks[0]) == tk.Kind.Ident {
            let sym = symbol(c, toks[0]);
            match find_env(c, sym) {
                some(e) => { return c.env[e as usize].value; }
                none => { }
            }
            match find_item(c, c.module, sym) {
                some(d) => {
                    if c.decls[d as usize].kind == DeclKind.Const {
                        consts.check_const(c, d);
                        return c.decls[d as usize].value;
                    }
                }
                none => { }
            }
        }
        let s = span_of(c, n);
        report(c, codes.NOT_CONSTANT, s, "a comptime argument must be a constant");
        return 0;
    }
    let saved_fn = c.fn_index;
    c.fn_index = NONE;
    let before = c.p.diags.count();
    expr.check_value(c, n, t);
    var v: u64 = 0;
    if c.p.diags.count() == before {
        v = consts.eval(c, n);
    }
    c.fn_index = saved_fn;
    return v;
}

/// The instance a written type such as Pair(u32, u8) or Grid(u8, 4, 4)
/// names.
fn instance_from_type_args(c: &mut Checker, d: u32, n: cst.NodeId) -> ty.TypeId {
    let wants = comptime_kinds(c, d);
    var args = alloc.List(ArgVal).init(c.a);
    let nargs = child_count(c, n);
    var k: u32 = 0;
    while k < nargs : (k += 1) {
        let an = child(c, n, k);
        if (k as usize) < wants.len() and not ck_is_type(&wants, k) {
            let vt = wants[k as usize].type_id;
            let v = comptime_value(c, an, vt);
            args.push(ArgVal { is_type: false, type_id: vt, value: v });
        } else {
            let t = resolve_type(c, an);
            args.push(ArgVal { is_type: true, type_id: t, value: 0 });
        }
    }
    let s = span_of(c, n);
    let inst = instantiate(c, d, &args, at: s);
    if inst == NONE {
        return ty.invalid();
    }
    return c.decls[inst as usize].type_id;
}

fn ck_is_type(wants: &alloc.List(ArgVal), k: u32) -> bool {
    return wants.items()[k as usize].is_type;
}

/// What each comptime parameter of template d takes: a type, or a value of
/// the given type.
pub fn comptime_kinds(c: &mut Checker, d: u32) -> alloc.List(ArgVal) {
    let saved = save_context(c);
    enter_decl(c, d);
    c.env_len = 0;
    let params = template_params(c, d);
    var out = alloc.List(ArgVal).init(c.a);
    let ps = params.items();
    var i: usize = 0;
    while i < ps.len() : (i += 1) {
        if takes_type(c, ps[i]) {
            out.push(ArgVal { is_type: true, type_id: ty.invalid(), value: 0 });
        } else {
            let vt = comptime_param_type(c, ps[i]);
            out.push(ArgVal { is_type: false, type_id: vt, value: 0 });
        }
    }
    restore_context(c, saved);
    return out;
}

/// The number of leading Param children of a node: a generic type's comptime
/// parameters come before its members.
/// Where a type's fields start: after its parameters and where clause.
fn members_from(c: &Checker, n: cst.NodeId) -> u32 {
    let i = param_children(c, n);
    if i < child_count(c, n) and kind_of(c, child(c, n, i)) == cst.Kind.WhereClause {
        return i + 1;
    }
    return i;
}

fn param_children(c: &Checker, n: cst.NodeId) -> u32 {
    let count = child_count(c, n);
    var i: u32 = 0;
    while i < count and kind_of(c, child(c, n, i)) == cst.Kind.Param : (i += 1) {
    }
    return i;
}

// ---- declarations -------------------------------------------------------------

fn new_decl(kind: DeclKind, module: u32, n: cst.NodeId, name: alloc.Symbol, name_token: u32, is_pub: bool) -> Decl {
    return Decl {
        kind: kind,
        module: module,
        node: n,
        name: name,
        name_token: name_token,
        is_pub: is_pub,
        type_id: ty.invalid(),
        state: 0,
        owner: NONE,
        members_start: 0,
        members_len: 0,
        methods_start: 0,
        methods_len: 0,
        fn_index: NONE,
        value: 0,
        value_module: 0,
        value_node: cst.NodeId { index: 0 },
        generic: false,
        template: NONE,
        env_start: 0,
        env_len: 0,
        impl_index: NONE,
    };
}

fn library_of(name: str) -> Library {
    if name.eq("std") {
        return Library.Std;
    }
    if name.eq("alloc") {
        return Library.Alloc;
    }
    return Library.NotLibrary;
}

fn collect_import(c: &mut Checker, n: cst.NodeId) {
    let toks = own(c, n);
    let items = toks.items();
    var path = alloc.String.init(c.a);
    var last: u32 = items[1];
    var segments: u32 = 0;
    var i: usize = 1;
    while i < items.len() and tok_kind(c, items[i]) != tk.Kind.KwAs and tok_kind(c, items[i]) != tk.Kind.Semi : (i += 1) {
        if tok_kind(c, items[i]) == tk.Kind.Ident {
            if segments > 0 {
                path.push_str(".");
            }
            path.push_str(text(c, items[i]));
            last = items[i];
            segments += 1;
        }
    }
    var bound = last;
    if i < items.len() and tok_kind(c, items[i]) == tk.Kind.KwAs {
        bound = items[i + 1];
    }
    let first = text(c, items[1]);
    var alias = Alias { library: library_of(first), module: 0 };
    let s = span_of(c, n);
    if first.eq("core") or (alias.library != Library.NotLibrary and segments > 1) {
        report(c, codes.BAD_IMPORT, s, "Arche-0 provides only the modules 'std' and 'alloc'");
        return;
    }
    if alias.library == Library.NotLibrary {
        match c.p.find(path.view()) {
            some(id) => { alias.module = id.index; }
            none => { return; } // reported by program.load
        }
    }
    let sym = symbol(c, bound);
    match find_import(c, sym) {
        some(_) => {
            var m = new_message(c);
            m.push_str("'");
            m.push_str(text(c, bound));
            m.push_str("' is already imported");
            report_owned(c, codes.BAD_IMPORT, s, m);
            return;
        }
        none => { }
    }
    c.imports[c.module as usize].put(sym, alias);
}

/// Adds a declaration to the module's items, unless the name is taken.
fn add_item(c: &mut Checker, d: Decl) -> u32 {
    let id = c.decls.len() as u32;
    let s = token_span(c, d.name_token);
    match find_item(c, c.module, d.name) {
        some(_) => {
            var m = new_message(c);
            m.push_str("'");
            m.push_str(c.names.text(d.name));
            m.push_str("' is already declared in this module");
            report_owned(c, codes.DUPLICATE, s, m);
            c.decls.push(d);
            return id;
        }
        none => { }
    }
    match find_import(c, d.name) {
        some(_) => {
            report(c, codes.SHADOWING, s, "this name is already imported; Arche has no shadowing");
        }
        none => { }
    }
    if is_predeclared(c.names.text(d.name)) {
        report(c, codes.SHADOWING, s, "this is a predeclared name; Arche has no shadowing");
    }
    c.items[c.module as usize].put(d.name, id);
    c.decls.push(d);
    return id;
}

fn type_decl_kind(c: &Checker, n: cst.NodeId) -> DeclKind {
    if has_own(c, n, tk.Kind.KwStruct) {
        return DeclKind.Struct;
    }
    if has_own(c, n, tk.Kind.KwEnum) {
        return DeclKind.Enum;
    }
    if has_own(c, n, tk.Kind.KwError) {
        return DeclKind.ErrorSet;
    }
    if has_own(c, n, tk.Kind.KwInterface) {
        return DeclKind.Interface;
    }
    return DeclKind.Alias;
}

/// A function with comptime parameters is a template; they come before
/// the others (spec/arche.md §4.1).
fn has_comptime_param(c: &mut Checker, n: cst.NodeId) -> bool {
    let count = child_count(c, n);
    var found = false;
    var runtime_seen = false;
    var i: u32 = 0;
    while i < count : (i += 1) {
        let ch = child(c, n, i);
        if kind_of(c, ch) != cst.Kind.Param {
            continue;
        }
        if has_own(c, ch, tk.Kind.KwComptime) {
            found = true;
            if runtime_seen {
                let s = span_of(c, ch);
                report(c, codes.BAD_GENERIC, s, "comptime parameters come before the others (spec/arche.md §4.1)");
            }
        } else {
            runtime_seen = true;
        }
    }
    return found;
}

fn collect_items(c: &mut Checker) {
    let root = tree(c).root;
    let count = child_count(c, root);
    var i: u32 = 0;
    while i < count : (i += 1) {
        let n = child(c, root, i);
        let k = kind_of(c, n);
        if k == cst.Kind.Import {
            collect_import(c, n);
            continue;
        }
        if k == cst.Kind.ImplDecl {
            c.impls.push(Impl { module: c.module, node: n, iface: NONE, target: ty.invalid(), methods_start: 0, methods_len: 0 });
            continue;
        }
        if k == cst.Kind.FnSig {
            let s = span_of(c, n);
            report(c, codes.UNEXPECTED_TOKEN, s, "only the methods of an interface have no body");
            continue;
        }
        if k != cst.Kind.FnDecl and k != cst.Kind.ConstDecl and k != cst.Kind.TypeDecl {
            continue;
        }
        let nt = ident_of(c, n);
        let sym = symbol(c, nt);
        let is_pub = has_own(c, n, tk.Kind.KwPub);
        if k == cst.Kind.FnDecl {
            let id = add_item(c, new_decl(DeclKind.Fn, module: c.module, n, sym, name_token: nt, is_pub));
            c.decls[id as usize].generic = has_comptime_param(c, n);
            check_comptime_params(c, n);
        } else if k == cst.Kind.ConstDecl {
            _ = add_item(c, new_decl(DeclKind.Const, module: c.module, n, sym, name_token: nt, is_pub));
        } else {
            let dk = type_decl_kind(c, n);
            let id = add_item(c, new_decl(dk, module: c.module, n, sym, name_token: nt, is_pub));
            if param_children(c, n) > 0 {
                check_comptime_params(c, n);
                c.decls[id as usize].generic = true; // a template has no type of its own
            } else if dk == DeclKind.Struct {
                c.decls[id as usize].type_id = c.t.declared(ty.Kind.Struct, id);
            } else if dk == DeclKind.Enum {
                c.decls[id as usize].type_id = c.t.declared(ty.Kind.Enum, id);
            } else if dk == DeclKind.ErrorSet {
                c.decls[id as usize].type_id = c.t.declared(ty.Kind.ErrorSet, id);
            } else if dk == DeclKind.Interface {
                c.decls[id as usize].type_id = c.t.declared(ty.Kind.Interface, id);
            }
        }
    }
}

pub fn error_id(c: &mut Checker, name: alloc.Symbol) -> u32 {
    match c.error_ids.get(name) {
        some(id) => { return id; }
        none => { }
    }
    c.error_names.push(name);
    let id = c.error_names.len() as u32;
    c.error_ids.put(name, id);
    return id;
}

fn report_duplicate_member(c: &mut Checker, t: u32, what: str) {
    var m = new_message(c);
    m.push_str(what);
    m.push_str(" '");
    m.push_str(text(c, t));
    m.push_str("' is declared twice");
    let s = token_span(c, t);
    report_owned(c, codes.DUPLICATE, s, m);
}

/// Adds the FieldDecl children of n, from child `from` on, to c.fields.
/// A run of the fields list.
type Run = struct {
    start: u32,
    len: u32,
}

/// Adds the FieldDecl children of n, from child `from` on, to c.fields, as
/// one run. Resolving a field's type may make instances, which add fields
/// of their own: the run is pushed only once every type is known.
fn add_fields(c: &mut Checker, n: cst.NodeId, from: u32) -> Run {
    var local = alloc.List(Field).init(c.a);
    let count = child_count(c, n);
    var i = from;
    while i < count : (i += 1) {
        let f = child(c, n, i);
        if kind_of(c, f) != cst.Kind.FieldDecl {
            break;
        }
        let nt = ident_of(c, f);
        let sym = symbol(c, nt);
        let seen = local.items();
        var j: usize = 0;
        var twice = false;
        while j < seen.len() : (j += 1) {
            twice = twice or seen[j].name == sym;
        }
        if twice {
            report_duplicate_member(c, nt, "field");
        }
        let ft = resolve_type(c, child(c, f, 0));
        local.push(Field { name: sym, name_token: nt, type_id: ft, is_pub: has_own(c, f, tk.Kind.KwPub) });
    }
    let start = c.fields.len() as u32;
    let items = local.items();
    var k: usize = 0;
    while k < items.len() : (k += 1) {
        c.fields.push(items[k]);
    }
    return Run { start: start, len: items.len() as u32 };
}

fn add_methods(c: &mut Checker, d: u32) {
    let n = c.decls[d as usize].node;
    let start = c.methods.len() as u32;
    let count = child_count(c, n);
    var i: u32 = 0;
    while i < count : (i += 1) {
        let f = child(c, n, i);
        let fk = kind_of(c, f);
        let is_iface = c.decls[d as usize].kind == DeclKind.Interface;
        if fk == cst.Kind.FnSig and not is_iface {
            let s = span_of(c, f);
            report(c, codes.UNEXPECTED_TOKEN, s, "only the methods of an interface have no body");
            continue;
        }
        if fk == cst.Kind.FnDecl and is_iface {
            let s = token_span(c, ident_of(c, f));
            report(c, codes.UNEXPECTED_TOKEN, s, "an interface lists signatures: end this one with ';', and write the body in an impl");
            continue;
        }
        if fk != cst.Kind.FnDecl and fk != cst.Kind.FnSig {
            continue;
        }
        let nt = ident_of(c, f);
        let sym = symbol(c, nt);
        var j = start;
        while j < c.methods.len() as u32 : (j += 1) {
            if c.decls[c.methods[j as usize] as usize].name == sym {
                report_duplicate_member(c, nt, "function");
            }
        }
        var clash = false;
        let decl = c.decls[d as usize];
        var k = decl.members_start;
        while k < decl.members_start + decl.members_len : (k += 1) {
            if decl.kind == DeclKind.Struct {
                clash = clash or c.fields[k as usize].name == sym;
            } else {
                clash = clash or c.variants[k as usize].name == sym;
            }
        }
        if clash {
            let s = token_span(c, nt);
            if decl.kind == DeclKind.Struct {
                report(c, codes.METHOD_CLASH, s, "this name is already a field of the type");
            } else {
                report(c, codes.METHOD_CLASH, s, "this name is already a variant of the type");
            }
        }
        var md = new_decl(DeclKind.Fn, module: c.module, f, sym, name_token: nt, has_own(c, f, tk.Kind.KwPub));
        md.owner = d;
        c.methods.push(c.decls.len() as u32);
        c.decls.push(md);
    }
    c.decls[d as usize].methods_start = start;
    c.decls[d as usize].methods_len = c.methods.len() as u32 - start;
}

fn resolve_members(c: &mut Checker, d: u32) {
    let decl = c.decls[d as usize];
    if decl.generic {
        return; // a template: its instances are resolved as they are made
    }
    let saved = save_context(c);
    enter_decl(c, d);
    resolve_members_here(c, d, decl.node);
    restore_context(c, saved);
}

fn resolve_members_here(c: &mut Checker, d: u32, n: cst.NodeId) {
    let decl = c.decls[d as usize];
    match decl.kind {
        .Struct => {
            let run = add_fields(c, n, members_from(c, n));
            c.decls[d as usize].members_start = run.start;
            c.decls[d as usize].members_len = run.len;
            add_methods(c, d);
        }
        .Enum => {
            var local = alloc.List(Variant).init(c.a);
            let count = child_count(c, n);
            var i: u32 = 0;
            while i < count : (i += 1) {
                let v = child(c, n, i);
                if kind_of(c, v) != cst.Kind.Variant {
                    continue;
                }
                let nt = ident_of(c, v);
                let sym = symbol(c, nt);
                let seen = local.items();
                var j: usize = 0;
                var twice = false;
                while j < seen.len() : (j += 1) {
                    twice = twice or seen[j].name == sym;
                }
                if twice {
                    report_duplicate_member(c, nt, "variant");
                }
                let has_fields = has_own(c, v, tk.Kind.LBrace);
                let run = add_fields(c, v, 0);
                local.push(Variant {
                    name: sym,
                    name_token: nt,
                    has_fields: has_fields,
                    fields_start: run.start,
                    fields_len: run.len,
                });
            }
            // Pushed as one run, after any instance the payloads made.
            let start = c.variants.len() as u32;
            let vs = local.items();
            var k: usize = 0;
            while k < vs.len() : (k += 1) {
                c.variants.push(vs[k]);
            }
            c.decls[d as usize].members_start = start;
            c.decls[d as usize].members_len = vs.len() as u32;
            add_methods(c, d);
        }
        .ErrorSet => {
            let start = c.error_members.len() as u32;
            let toks = own(c, n);
            let items = toks.items();
            var after_error = false;
            var i: usize = 0;
            while i < items.len() : (i += 1) {
                let t = items[i];
                if tok_kind(c, t) == tk.Kind.KwError {
                    after_error = true;
                    continue;
                }
                if not after_error or tok_kind(c, t) != tk.Kind.Ident {
                    continue;
                }
                let sym = symbol(c, t);
                let id = error_id(c, sym);
                var j = start;
                while j < c.error_members.len() as u32 : (j += 1) {
                    if c.error_members[j as usize] == id {
                        report_duplicate_member(c, t, "error");
                    }
                }
                c.error_members.push(id);
            }
            c.decls[d as usize].members_start = start;
            c.decls[d as usize].members_len = c.error_members.len() as u32 - start;
        }
        .Alias => {
            _ = decl_type(c, d);
        }
        .Interface => {
            add_methods(c, d);
        }
        .Fn | .Const => { }
    }
}

/// A struct or enum that contains itself by value has no size (E0423).
fn check_contains(c: &mut Checker, t: ty.TypeId, path: &mut alloc.List(u32), done: &mut alloc.Map(u32, bool)) {
    var info = c.t.get(t);
    while info.kind == ty.Kind.Array {
        info = c.t.get(info.elem);
    }
    if info.kind != ty.Kind.Struct and info.kind != ty.Kind.Enum {
        return;
    }
    let d = info.decl;
    match done.get(d) {
        some(_) => { return; }
        none => { }
    }
    let on_path = path.items();
    var i: usize = 0;
    while i < on_path.len() : (i += 1) {
        if on_path[i] == d {
            let decl = c.decls[d as usize];
            let saved = c.module;
            c.module = decl.module;
            let s = token_span(c, decl.name_token);
            report(c, codes.CONTAINS_ITSELF, s, "this type contains itself; link values with a handle, such as an index into a list");
            c.module = saved;
            done.put(d, true);
            return;
        }
    }
    path.push(d);
    let decl = c.decls[d as usize];
    if info.kind == ty.Kind.Struct {
        var f = decl.members_start;
        while f < decl.members_start + decl.members_len : (f += 1) {
            check_contains(c, c.fields[f as usize].type_id, path, done);
        }
    } else {
        var v = decl.members_start;
        while v < decl.members_start + decl.members_len : (v += 1) {
            let variant = c.variants[v as usize];
            var f = variant.fields_start;
            while f < variant.fields_start + variant.fields_len : (f += 1) {
                check_contains(c, c.fields[f as usize].type_id, path, done);
            }
        }
    }
    _ = path.pop();
    done.put(d, true);
}

pub fn check_signature(c: &mut Checker, d: u32) {
    let decl = c.decls[d as usize];
    if decl.generic or decl.fn_index != NONE {
        return; // a template, or a signature checked already, on demand
    }
    let saved = save_context(c);
    enter_decl(c, d);
    check_signature_here(c, d);
    restore_context(c, saved);
}

fn check_signature_here(c: &mut Checker, d: u32) {
    let decl = c.decls[d as usize];
    let n = decl.node;
    if decl.template == NONE and decl.owner == NONE {
        let w = where_clause(c, n);
        if w.index != NONE {
            let s = span_of(c, w);
            report(c, codes.BOUND_UNMET, s, "'where' constrains comptime type parameters, and this function has none");
        }
    }
    var ncomptime: u32 = 0;
    // Collected first: resolving a type may make instances with
    // signatures of their own, which add parameters too.
    var local = alloc.List(ParamInfo).init(c.a);
    let count = child_count(c, n);
    var ret = ty.void_type();
    var i: u32 = 0;
    while i < count : (i += 1) {
        let ch = child(c, n, i);
        let k = kind_of(c, ch);
        if k == cst.Kind.Param and has_own(c, ch, tk.Kind.KwComptime) {
            ncomptime += 1; // bound in env: not a run-time parameter

        } else if k == cst.Kind.Param {
            let nt = ident_of(c, ch);
            let sym = symbol(c, nt);
            let seen = local.items();
            var j: usize = 0;
            var twice = false;
            while j < seen.len() : (j += 1) {
                twice = twice or seen[j].name == sym;
            }
            if twice {
                report_duplicate_member(c, nt, "parameter");
            }
            let pt = resolve_type(c, child(c, ch, 0));
            local.push(ParamInfo { name: sym, name_token: nt, type_id: pt });
        } else if k != cst.Kind.Block and k != cst.Kind.WhereClause {
            ret = resolve_type(c, ch);
        }
    }
    let start = c.params.len() as u32;
    let ps = local.items();
    var k2: usize = 0;
    while k2 < ps.len() : (k2 += 1) {
        c.params.push(ps[k2]);
    }
    var info = FnInfo {
        decl: d,
        params_start: start,
        params_len: c.params.len() as u32 - start,
        ret: ret,
        has_self: false,
        self_mode: SelfMode.Value,
        table: NONE,
        ncomptime: ncomptime,
    };
    // An instance's body has types of its own (§4.1).
    let is_instance = decl.template != NONE or (decl.owner != NONE and c.decls[decl.owner as usize].template != NONE);
    if is_instance {
        info.table = c.tables.len() as u32;
        c.tables.push(alloc.Map(u32, ty.TypeId).init(c.a));
        c.ref_tables.push(alloc.Map(u32, u32).init(c.a));
    }
    if decl.owner != NONE and info.params_len > 0 and c.names.text(c.params[start as usize].name).eq("self") {
        let owner_type = c.decls[decl.owner as usize].type_id;
        let pt = c.params[start as usize].type_id;
        let pi = c.t.get(pt);
        info.has_self = true;
        if pt == owner_type {
            info.self_mode = SelfMode.Value;
        } else if pi.kind == ty.Kind.Ref and pi.elem == owner_type {
            if pi.mutable {
                info.self_mode = SelfMode.MutRef;
            } else {
                info.self_mode = SelfMode.Ref;
            }
        } else if not is_invalid(c, pt) {
            let s = token_span(c, c.params[start as usize].name_token);
            var m = new_message(c);
            m.push_str("'self' is ");
            write_type(c, &mut m, owner_type);
            m.push_str(", &");
            write_type(c, &mut m, owner_type);
            m.push_str(" or &mut ");
            write_type(c, &mut m, owner_type);
            report_owned(c, codes.BAD_SELF, s, m);
        }
    }
    c.decls[d as usize].fn_index = c.fns.len() as u32;
    c.fns.push(info);
}

// ---- impls (spec/arche.md §5.1) --------------------------------------------------

/// Resolves each impl's interface and type, checks where it may be, and
/// makes its functions methods of the type.
fn resolve_impls(c: &mut Checker) {
    var i: usize = 0;
    while i < c.impls.len() : (i += 1) {
        let im = c.impls[i];
        c.module = im.module;
        c.env_len = 0;
        c.self_type = ty.invalid();
        let it = resolve_interface(c, child(c, im.node, 0));
        let target_node = child(c, im.node, 1);
        let target = resolve_type(c, target_node);
        if is_invalid(c, it) or is_invalid(c, target) {
            continue;
        }
        let target_kind = c.t.kind(target);
        if target_kind != ty.Kind.Struct and target_kind != ty.Kind.Enum {
            var m = new_message(c);
            write_type(c, &mut m, target);
            m.push_str(" cannot implement an interface here: only the package's own struct and enum types do, for now");
            let s = span_of(c, target_node);
            report_owned(c, codes.BAD_IMPL, s, m);
            continue;
        }
        let iface = c.t.get(it).decl;
        let td = c.t.get(target).decl;
        if c.decls[td as usize].module != im.module and c.decls[iface as usize].module != im.module {
            var m = new_message(c);
            m.push_str("impl ");
            write_type(c, &mut m, it);
            m.push_str(" for ");
            write_type(c, &mut m, target);
            m.push_str(" belongs in the module that declares one of them");
            let s = span_of(c, im.node);
            report_owned(c, codes.IMPL_PLACE, s, m);
            continue;
        }
        var j: usize = 0;
        var twice = false;
        while j < i : (j += 1) {
            twice = twice or (c.impls[j].iface == iface and c.impls[j].target == target);
        }
        if twice {
            var m = new_message(c);
            write_type(c, &mut m, target);
            m.push_str(" already implements ");
            write_type(c, &mut m, it);
            let s = span_of(c, im.node);
            report_owned(c, codes.IMPL_TWICE, s, m);
            continue;
        }
        c.impls[i].iface = iface;
        c.impls[i].target = target;
        let start = c.methods.len() as u32;
        let count = child_count(c, im.node);
        var k: u32 = 2;
        while k < count : (k += 1) {
            let f = child(c, im.node, k);
            if kind_of(c, f) != cst.Kind.FnDecl {
                continue;
            }
            let nt = ident_of(c, f);
            let sym = symbol(c, nt);
            var q = start;
            while q < c.methods.len() as u32 : (q += 1) {
                if c.decls[c.methods[q as usize] as usize].name == sym {
                    report_duplicate_member(c, nt, "function");
                }
            }
            var md = new_decl(DeclKind.Fn, module: im.module, f, sym, name_token: nt, has_own(c, f, tk.Kind.KwPub));
            md.owner = td;
            md.impl_index = i as u32;
            md.env_start = c.decls[td as usize].env_start;
            md.env_len = c.decls[td as usize].env_len;
            c.methods.push(c.decls.len() as u32);
            c.decls.push(md);
        }
        c.impls[i].methods_start = start;
        c.impls[i].methods_len = c.methods.len() as u32 - start;
    }
}

fn method_named(c: &Checker, start: u32, len: u32, name: alloc.Symbol) -> u32 {
    var i = start;
    while i < start + len : (i += 1) {
        let m = c.methods[i as usize];
        if c.decls[m as usize].name == name {
            return m;
        }
    }
    return NONE;
}

fn report_impl(c: &mut Checker, module: u32, s: diag.Span, m: alloc.String) {
    let saved = c.module;
    c.module = module;
    report_owned(c, codes.IMPL_MISMATCH, s, m);
    c.module = saved;
}

/// Each impl has the interface's methods, with Self as its type, and no
/// others (spec/arche.md §5.1).
fn check_impls(c: &mut Checker) {
    var i: usize = 0;
    while i < c.impls.len() : (i += 1) {
        let im = c.impls[i];
        if im.iface == NONE {
            continue;
        }
        let iface = c.decls[im.iface as usize];
        let owner = c.decls[c.t.get(im.target).decl as usize];
        // The interface's own methods.
        var k = iface.methods_start;
        while k < iface.methods_start + iface.methods_len : (k += 1) {
            let want_d = c.methods[k as usize];
            let found = method_named(c, start: im.methods_start, len: im.methods_len, c.decls[want_d as usize].name);
            if found == NONE {
                c.module = im.module;
                var m = new_message(c);
                m.push_str("this impl is missing the method '");
                m.push_str(c.names.text(c.decls[want_d as usize].name));
                m.push_str("' of ");
                write_decl_name(c, &mut m, im.iface);
                let s = token_span(c, first_own(c, im.node));
                report_impl(c, im.module, s, m);
                continue;
            }
            check_signature(c, want_d);
            check_signature(c, found);
            let want = c.fns[c.decls[want_d as usize].fn_index as usize];
            let got = c.fns[c.decls[found as usize].fn_index as usize];
            var same = want.params_len == got.params_len and want.ncomptime == got.ncomptime and
                replace_type(c, t: want.ret, x: iface.type_id, y: im.target) == got.ret;
            var p: u32 = 0;
            while same and p < want.params_len : (p += 1) {
                let wp = c.params[(want.params_start + p) as usize];
                let gp = c.params[(got.params_start + p) as usize];
                same = wp.name == gp.name and replace_type(c, t: wp.type_id, x: iface.type_id, y: im.target) == gp.type_id;
            }
            if not same {
                c.module = im.module;
                var m = new_message(c);
                m.push_str("'");
                m.push_str(c.names.text(c.decls[found as usize].name));
                m.push_str("' differs from the interface's: its parameters, their names and the result are those of ");
                write_decl_name(c, &mut m, im.iface);
                m.push_str(", with Self as ");
                write_type(c, &mut m, im.target);
                let s = token_span(c, c.decls[found as usize].name_token);
                report_impl(c, im.module, s, m);
            }
        }
        // Methods the interface does not have, or the type has already.
        var q = im.methods_start;
        while q < im.methods_start + im.methods_len : (q += 1) {
            let md = c.methods[q as usize];
            let name = c.decls[md as usize].name;
            c.module = im.module;
            if method_named(c, start: iface.methods_start, len: iface.methods_len, name) == NONE {
                var m = new_message(c);
                m.push_str("'");
                m.push_str(c.names.text(name));
                m.push_str("' is not a method of ");
                write_decl_name(c, &mut m, im.iface);
                m.push_str("; an impl has only the interface's methods");
                let s = token_span(c, c.decls[md as usize].name_token);
                report_impl(c, im.module, s, m);
            } else if method_named(c, start: owner.methods_start, len: owner.methods_len, name) != NONE {
                var m = new_message(c);
                write_type(c, &mut m, im.target);
                m.push_str(" has a method '");
                m.push_str(c.names.text(name));
                m.push_str("' of its own already");
                let s = token_span(c, c.decls[md as usize].name_token);
                report_impl(c, im.module, s, m);
            }
        }
    }
}

/// The method `name` of the impl of iface for t, or NONE.
pub fn impl_method(c: &Checker, t: ty.TypeId, iface: u32, name: alloc.Symbol) -> u32 {
    var i: usize = 0;
    while i < c.impls.len() : (i += 1) {
        let im = c.impls[i];
        if im.iface == iface and im.target == t {
            return method_named(c, start: im.methods_start, len: im.methods_len, name);
        }
    }
    return NONE;
}

/// The number of the impl of iface for t, or NONE.
pub fn impl_index(c: &Checker, t: ty.TypeId, iface: u32) -> u32 {
    var i: usize = 0;
    while i < c.impls.len() : (i += 1) {
        if c.impls[i].iface == iface and c.impls[i].target == t {
            return i as u32;
        }
    }
    return NONE;
}

/// Type t implements the interface declared by iface.
pub fn implements(c: &Checker, t: ty.TypeId, iface: u32) -> bool {
    if c.t.kind(t) == ty.Kind.Closure and is_fn_iface(c, iface) {
        return closure_fits(c, ci: c.t.get(t).decl, d: iface);
    }
    var i: usize = 0;
    while i < c.impls.len() : (i += 1) {
        if c.impls[i].iface == iface and c.impls[i].target == t {
            return true;
        }
    }
    return false;
}

fn check_main(c: &mut Checker) {
    c.module = 0;
    let main_sym = c.names.intern("main");
    let system = c.t.builtin(ty.Builtin.System);
    let want_param = c.t.reference(true, system);
    let want_ret = c.t.error_union(NONE, ty.void_type());
    match find_item(c, 0, main_sym) {
        some(d) => {
            let decl = c.decls[d as usize];
            if decl.kind == DeclKind.Fn {
                let f = c.fns[decl.fn_index as usize];
                if f.params_len == 1 and c.params[f.params_start as usize].type_id == want_param and f.ret == want_ret {
                    return;
                }
                let s = token_span(c, decl.name_token);
                report(c, codes.BAD_MAIN, s, "main must be declared as 'fn main(sys: &mut std.System) -> !void'");
                return;
            }
        }
        none => { }
    }
    report(c, codes.BAD_MAIN, diag.Span { start: 0, len: 0 }, "the root module has no 'fn main(sys: &mut std.System) -> !void'");
}

fn io_error_name(i: u32) -> str {
    match i {
        0 => { return "NotFound"; }
        1 => { return "AccessDenied"; }
        2 => { return "IsDirectory"; }
        3 => { return "InvalidUtf8"; }
        _ => { return "IoFailed"; }
    }
}

/// std.IoError (§11): its errors are numbered first, 1 to 5, so that the
/// runtime can return them.
fn add_io_error(c: &mut Checker) {
    let name = c.names.intern("IoError");
    var d = new_decl(DeclKind.ErrorSet, module: 0, cst.NodeId { index: 0 }, name, name_token: 0, true);
    d.members_start = c.error_members.len() as u32;
    d.members_len = 5;
    let id = c.decls.len() as u32;
    c.decls.push(d);
    c.io_error = id;
    c.decls[id as usize].type_id = c.t.declared(ty.Kind.ErrorSet, id);
    var i: u32 = 0;
    while i < 5 : (i += 1) {
        let sym = c.names.intern(io_error_name(i));
        let eid = error_id(c, sym);
        c.error_members.push(eid);
    }
}

/// The bodies of instances made while checking: each may make more.
fn check_pending(c: &mut Checker) {
    var i: usize = 0;
    while i < c.pending.len() : (i += 1) {
        let f = c.pending[i];
        stmt.check_fn(c, f);
    }
    c.pending.clear();
}

/// Checks a program and returns its diagnostics.
pub fn check(p: program.Program) -> program.Program {
    let c = analyze(p);
    return c.p;
}

/// Checks a program and keeps what the checker learnt, for lowering.
pub fn analyze(p: program.Program) -> Checker {
    let a = p.a;
    let nmodules = p.modules.len();
    var c = Checker {
        p: p,
        t: ty.Types.init(a),
        names: alloc.Interner.init(a),
        decls: alloc.List(Decl).init(a),
        fields: alloc.List(Field).init(a),
        variants: alloc.List(Variant).init(a),
        fns: alloc.List(FnInfo).init(a),
        params: alloc.List(ParamInfo).init(a),
        methods: alloc.List(u32).init(a),
        error_members: alloc.List(u32).init(a),
        error_ids: alloc.Map(alloc.Symbol, u32).init(a),
        error_names: alloc.List(alloc.Symbol).init(a),
        items: alloc.List(alloc.Map(alloc.Symbol, u32)).init(a),
        imports: alloc.List(alloc.Map(alloc.Symbol, Alias)).init(a),
        node_types: alloc.List(alloc.List(ty.TypeId)).init(a),
        node_refs: alloc.List(alloc.List(u32)).init(a),
        scope: alloc.List(Binding).init(a),
        module: 0,
        fn_index: NONE,
        loops: 0,
        defer_loops: NONE,
        io_error: NONE,
        env: alloc.List(EnvEntry).init(a),
        env_start: 0,
        env_len: 0,
        tables: alloc.List(alloc.Map(u32, ty.TypeId)).init(a),
        ref_tables: alloc.List(alloc.Map(u32, u32)).init(a),
        cur_table: NONE,
        instances: alloc.Map(InstKey, u32).init(a),
        pending: alloc.List(u32).init(a),
        arg_offset: 0,
        checked: alloc.Map(u32, bool).init(a),
        impls: alloc.List(Impl).init(a),
        dyn_casts: alloc.Map(u64, ty.TypeId).init(a),
        self_type: ty.invalid(),
        unsafe_depth: 0,
        closures: alloc.List(Closure).init(a),
        captures: alloc.List(Capture).init(a),
        fn_ifaces: alloc.List(u32).init(a),
        outer_scope: alloc.List(Binding).init(a),
        a: a,
    };
    add_io_error(&mut c);
    var m: usize = 0;
    while m < nmodules : (m += 1) {
        c.items.push(alloc.Map(alloc.Symbol, u32).init(a));
        c.imports.push(alloc.Map(alloc.Symbol, Alias).init(a));
        var nt = alloc.List(ty.TypeId).init(a);
        var nr = alloc.List(u32).init(a);
        var k: usize = 0;
        while k < c.p.modules[m].tree.nodes.len() : (k += 1) {
            nt.push(ty.invalid());
            nr.push(NONE);
        }
        c.node_types.push(nt);
        c.node_refs.push(nr);
    }
    m = 0;
    while m < nmodules : (m += 1) {
        c.module = m as u32;
        collect_items(&mut c);
    }
    // Members of the module-level types; methods become declarations here.
    let ntop = c.decls.len();
    var d: usize = 0;
    while d < ntop : (d += 1) {
        if d as u32 != c.io_error { // std.IoError has no source to resolve
            resolve_members(&mut c, d as u32);
        }
    }
    resolve_impls(&mut c);
    var path = alloc.List(u32).init(a);
    var done = alloc.Map(u32, bool).init(a);
    d = 0;
    while d < ntop : (d += 1) {
        let k = c.decls[d].kind;
        if k == DeclKind.Struct or k == DeclKind.Enum {
            check_contains(&mut c, c.decls[d].type_id, &mut path, &mut done);
        }
    }
    d = 0;
    while d < c.decls.len() : (d += 1) {
        if c.decls[d].kind == DeclKind.Const {
            consts.check_const(&mut c, d as u32);
        }
    }
    d = 0;
    while d < c.decls.len() : (d += 1) {
        if c.decls[d].kind == DeclKind.Fn {
            check_signature(&mut c, d as u32);
        }
    }
    check_main(&mut c);
    check_impls(&mut c);
    let nfns = c.fns.len();
    var f: usize = 0;
    while f < nfns : (f += 1) {
        stmt.check_fn(&mut c, f as u32);
    }
    check_pending(&mut c);
    m = 0;
    while m < nmodules : (m += 1) {
        c.module = m as u32;
        let root = tree(&c).root;
        let count = child_count(&c, root);
        var i: u32 = 0;
        while i < count : (i += 1) {
            let n = child(&c, root, i);
            if kind_of(&c, n) == cst.Kind.TestDecl {
                stmt.check_test(&mut c, m as u32, n);
            }
        }
    }
    check_pending(&mut c);
    // The memory model (§5.4, §5.5) is checked once the types are right.
    if c.p.diags.count() == 0 {
        memory.check(&mut c);
    }
    return c;
}
