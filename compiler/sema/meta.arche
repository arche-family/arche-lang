/// core.meta (lib/core/meta.arche): what a type is made of, which the
/// compiler answers at compile time (spec/arche.md §4.3).
import alloc;
import codes;
import diag;
import syntax.cst;
import sema.check as ck;
import sema.types as ty;

/// d is a function of core.meta, or an instance of one.
pub fn is_meta(c: &ck.Checker, d: u32) -> bool {
    if d == ck.NONE or d >= ck.ENV_REF {
        return false;
    }
    var decl = c.decls[d as usize];
    if decl.template != ck.NONE {
        decl = c.decls[decl.template as usize];
    }
    return decl.kind == ck.DeclKind.Fn and decl.owner == ck.NONE and c.p.modules[decl.module as usize].name.view().eq("core.meta");
}

/// The name of core.meta function d, which is_meta says it is.
fn name_of(c: &ck.Checker, d: u32) -> str {
    return c.names.text(c.decls[d as usize].name);
}

/// d is core.meta's function called nm, or an instance of it.
pub fn is_named(c: &ck.Checker, d: u32, nm: str) -> bool {
    return is_meta(c, d) and name_of(c, d).eq(nm);
}

/// The interface an instance d of core.meta asks about, its declaration;
/// NONE when it is not one.
pub fn iface_asked(c: &ck.Checker, d: u32) -> u32 {
    if c.decls[d as usize].env_len == 0 {
        return ck.NONE;
    }
    return iface_of(c, env_type(c, d, k: 0));
}

/// The method number an instance d of core.meta asks about.
pub fn method_asked(c: &ck.Checker, d: u32) -> u64 {
    return env_value(c, d, k: 1);
}

/// The parameter number an instance d of arg asks about.
pub fn param_asked(c: &ck.Checker, d: u32) -> u64 {
    return env_value(c, d, k: 2);
}

/// d is field_type, elem_type, param_type, result_type or Args: a function
/// of types that gives a type, so a call of it is written where a type
/// goes.
pub fn gives_type(c: &ck.Checker, d: u32) -> bool {
    if not is_meta(c, d) {
        return false;
    }
    let nm = name_of(c, d);
    return nm.eq("field_type") or nm.eq("elem_type") or nm.eq("param_type") or nm.eq("result_type") or nm.eq("Args");
}

// ---- interfaces (spec/arche.md §4.3, §5.4) ------------------------------------------

/// The declaration of interface t; NONE when t is not one.
pub fn iface_of(c: &ck.Checker, t: ty.TypeId) -> u32 {
    let info = c.t.get(t);
    if info.kind != ty.Kind.Interface or info.decl == ty.NO_DECL {
        return ck.NONE;
    }
    return info.decl;
}

/// Method m of interface declaration i; NONE when it has none such.
pub fn method_at(c: &ck.Checker, i: u32, m: u64) -> u32 {
    let d = c.decls[i as usize];
    if m >= d.methods_len as u64 {
        return ck.NONE;
    }
    return c.methods[(d.methods_start as u64 + m) as usize];
}

/// Interface i's methods all take self by reference and no comptime
/// arguments, as dyn needs (spec/arche.md §5.3), and their signatures are
/// checked.
pub fn usable(c: &ck.Checker, i: u32) -> bool {
    let d = c.decls[i as usize];
    if d.generic {
        return false;
    }
    var k = d.methods_start;
    while k < d.methods_start + d.methods_len : (k += 1) {
        let md = c.methods[k as usize];
        if c.decls[md as usize].fn_index == ck.NONE {
            return false;
        }
        let f = c.fns[c.decls[md as usize].fn_index as usize];
        if not f.has_self or f.self_mode == ck.SelfMode.Value or f.ncomptime != 0 {
            return false;
        }
    }
    return true;
}

/// The signature of method m of interface t, when t is an interface usable
/// with dyn that has it.
pub fn method_sig(c: &ck.Checker, t: ty.TypeId, m: u64) -> ?ck.FnInfo {
    let i = iface_of(c, t);
    if i == ck.NONE or not usable(c, i) {
        return none;
    }
    let md = method_at(c, i, m: m);
    if md == ck.NONE {
        return none;
    }
    return c.fns[c.decls[md as usize].fn_index as usize];
}

/// The comptime argument k of instance d: a type's id, or a value.
fn env_type(c: &ck.Checker, d: u32, k: u64) -> ty.TypeId {
    return c.env[(c.decls[d as usize].env_start as u64 + k) as usize].type_id;
}

fn env_value(c: &ck.Checker, d: u32, k: u64) -> u64 {
    return c.env[(c.decls[d as usize].env_start as u64 + k) as usize].value;
}

/// The method an instance d of method_name, param_count, call or arg asks
/// about, its signature; none when the interface has none such.
pub fn sig_of(c: &ck.Checker, d: u32) -> ?ck.FnInfo {
    if c.decls[d as usize].env_len < 2 {
        return none;
    }
    return method_sig(c, env_type(c, d, k: 0), m: env_value(c, d, k: 1));
}

/// The method's name for an instance d of method_name.
pub fn method_name_of(c: &ck.Checker, d: u32) -> str {
    let i = iface_of(c, env_type(c, d, k: 0));
    let md = method_at(c, i, m: env_value(c, d, k: 1));
    return c.names.text(c.decls[md as usize].name);
}

/// Says why interface t has no method m, or method m no parameter p
/// (p is NONE when there is none to ask about).
fn no_method(c: &mut ck.Checker, t: ty.TypeId, m: u64, p: u64, at: diag.Span) {
    var msg = ck.new_message(c);
    let i = iface_of(c, t);
    ck.write_type(c, &mut msg, t);
    if i == ck.NONE {
        msg.push_str(" is not an interface, so it has no methods");
    } else if not usable(c, i) {
        msg.push_str(" cannot be used with dyn, so its methods cannot be asked about");
    } else if m >= c.decls[i as usize].methods_len as u64 {
        msg.push_str(" has ");
        ck.write_number(&mut msg, c.decls[i as usize].methods_len as u64);
        msg.push_str(" method");
        if c.decls[i as usize].methods_len != 1 {
            msg.push_str("s");
        }
        msg.push_str(", so none is number ");
        ck.write_number(&mut msg, m);
    } else {
        msg.push_str("'s method ");
        msg.push_str(c.names.text(c.decls[method_at(c, i, m: m) as usize].name));
        msg.push_str(" has ");
        let f = c.fns[c.decls[method_at(c, i, m: m) as usize].fn_index as usize];
        ck.write_number(&mut msg, (f.params_len - 1) as u64);
        msg.push_str(" parameters after self, so none is number ");
        ck.write_number(&mut msg, p);
    }
    ck.report_owned(c, codes.META, at, msg);
}

/// The pub fields of t, as indexes into the checker's fields, in the order
/// they are declared; none when t is not a struct.
pub fn fields(c: &ck.Checker, t: ty.TypeId) -> alloc.List(u32) {
    var out = alloc.List(u32).init(c.a);
    let info = c.t.get(t);
    if info.kind != ty.Kind.Struct {
        return out;
    }
    let d = c.decls[info.decl as usize];
    var i = d.members_start;
    while i < d.members_start + d.members_len : (i += 1) {
        if c.fields[i as usize].is_pub {
            out.push(i);
        }
    }
    return out;
}

/// t is the library's alloc.List(E), or Arche-0's built-in list.
fn is_list(c: &ck.Checker, t: ty.TypeId) -> bool {
    let info = c.t.get(t);
    if info.kind == ty.Kind.List {
        return true;
    }
    if info.kind != ty.Kind.Struct {
        return false;
    }
    let d = c.decls[info.decl as usize];
    if d.template == ck.NONE {
        return false;
    }
    let tmpl = c.decls[d.template as usize];
    return c.names.text(tmpl.name).eq("List") and c.p.modules[tmpl.module as usize].name.view().eq("alloc");
}

/// The E of List(E), ?E or X!E; invalid for any other t.
fn elem_of(c: &ck.Checker, t: ty.TypeId) -> ty.TypeId {
    let info = c.t.get(t);
    if info.kind == ty.Kind.List or info.kind == ty.Kind.Optional or info.kind == ty.Kind.ErrorUnion {
        return c.t.elem(t);
    }
    if is_list(c, t) {
        let d = c.decls[info.decl as usize];
        return c.env[d.env_start as usize].type_id;
    }
    return ty.invalid();
}

fn bit(b: bool) -> u64 {
    if b {
        return 1;
    }
    return 0;
}

/// The value of a call of instance d when it is one of core.meta's that
/// gives a bool or an integer; none otherwise.
pub fn value(c: &ck.Checker, d: u32) -> ?u64 {
    if not is_meta(c, d) {
        return none;
    }
    let decl = c.decls[d as usize];
    if decl.env_len == 0 {
        return none;
    }
    let nm = name_of(c, d);
    let t = c.env[decl.env_start as usize].type_id;
    let info = c.t.get(t);
    if nm.eq("is_struct") {
        return bit(info.kind == ty.Kind.Struct);
    }
    if nm.eq("is_int") {
        return bit(info.kind == ty.Kind.Int);
    }
    if nm.eq("is_signed") {
        return bit(info.kind == ty.Kind.Int and ty.is_signed(info.int_kind));
    }
    if nm.eq("is_float") {
        return bit(info.kind == ty.Kind.Float);
    }
    if nm.eq("is_bool") {
        return bit(info.kind == ty.Kind.Bool);
    }
    if nm.eq("is_list") {
        return bit(is_list(c, t));
    }
    if nm.eq("is_optional") {
        return bit(info.kind == ty.Kind.Optional);
    }
    if nm.eq("same") {
        let u = c.env[(decl.env_start + 1) as usize].type_id;
        return bit(t.index == u.index);
    }
    if nm.eq("field_count") {
        return fields(c, t).len() as u64;
    }
    if nm.eq("is_interface") {
        return bit(info.kind == ty.Kind.Interface);
    }
    if nm.eq("method_count") {
        let i = iface_of(c, t);
        if i == ck.NONE or not usable(c, i) {
            return 0;
        }
        return c.decls[i as usize].methods_len as u64;
    }
    if nm.eq("param_count") {
        match sig_of(c, d) {
            some(f) => { return (f.params_len - 1) as u64; }
            none => { return 0; }
        }
    }
    if nm.eq("pub_only") {
        if info.kind != ty.Kind.Struct {
            return 0;
        }
        return bit(fields(c, t).len() == c.decls[info.decl as usize].members_len as usize);
    }
    return none;
}

/// The field a call of field_name, field or field_mut instance d means, as
/// an index into the checker's fields; NONE when there is none.
pub fn field_of(c: &ck.Checker, d: u32) -> u32 {
    let decl = c.decls[d as usize];
    if decl.env_len < 2 {
        return ck.NONE;
    }
    let t = c.env[decl.env_start as usize].type_id;
    let i = c.env[(decl.env_start + 1) as usize].value;
    let fs = fields(c, t);
    if i >= fs.len() as u64 {
        return ck.NONE;
    }
    return fs[i as usize];
}

/// The type a call of field_type or elem_type d names for these comptime
/// arguments. When there is none it is invalid, and the diagnostic is at
/// `at`, unless the call is core.meta's own (field's result), which the
/// call of field reports.
pub fn type_of(c: &mut ck.Checker, d: u32, args: &alloc.List(ck.ArgVal), at: diag.Span) -> ty.TypeId {
    let quiet = c.p.modules[c.module as usize].name.view().eq("core.meta");
    var name = alloc.String.init(c.a);
    name.push_str(name_of(c, d));
    let nm = name.view();
    let given = args.items();
    var wants: usize = 1;
    if nm.eq("field_type") or nm.eq("result_type") or nm.eq("Args") {
        wants = 2;
    }
    if nm.eq("param_type") {
        wants = 3;
    }
    var fits = given.len() == wants and given[0].is_type;
    var k: usize = 1;
    while fits and k < given.len() : (k += 1) {
        fits = not given[k].is_type;
    }
    if not fits {
        if not quiet {
            ck.report(c, codes.BAD_GENERIC, at, "core.meta.field_type takes a type and a field number; elem_type a type; param_type an interface, a method number and a parameter number; result_type and Args an interface and a method number");
        }
        return ty.invalid();
    }
    let t = given[0].type_id;
    if ck.is_invalid(c, t) {
        return t;
    }
    if nm.eq("param_type") or nm.eq("result_type") or nm.eq("Args") {
        // A type may name these before the pass over signatures does.
        let i = iface_of(c, t);
        if i != ck.NONE {
            var k2 = c.decls[i as usize].methods_start;
            while k2 < c.decls[i as usize].methods_start + c.decls[i as usize].methods_len : (k2 += 1) {
                ck.check_signature(c, c.methods[k2 as usize]);
            }
        }
        match method_sig(c, t, m: given[1].value) {
            some(f) => {
                if nm.eq("Args") {
                    return c.t.args_of(iface_of(c, t), m: given[1].value);
                }
                if nm.eq("result_type") {
                    return f.ret;
                }
                if given[2].value + 1 >= f.params_len as u64 {
                    if not quiet {
                        no_method(c, t, m: given[1].value, p: given[2].value, at: at);
                    }
                    return ty.invalid();
                }
                return c.params[(f.params_start as u64 + 1 + given[2].value) as usize].type_id;
            }
            none => {
                if not quiet {
                    no_method(c, t, m: given[1].value, p: 0, at: at);
                }
                return ty.invalid();
            }
        }
    }
    if nm.eq("elem_type") {
        let e = elem_of(c, t);
        if ck.is_invalid(c, e) and not quiet {
            var m = ck.new_message(c);
            ck.write_type(c, &mut m, t);
            m.push_str(" is not an alloc.List, an optional or an error union, so it has no element type");
            ck.report_owned(c, codes.META, at, m);
        }
        return e;
    }
    let fs = fields(c, t);
    if given[1].value >= fs.len() as u64 {
        if not quiet {
            no_field(c, t, given[1].value, at);
        }
        return ty.invalid();
    }
    return c.fields[fs[given[1].value as usize] as usize].type_id;
}

fn no_field(c: &mut ck.Checker, t: ty.TypeId, i: u64, at: diag.Span) {
    var m = ck.new_message(c);
    ck.write_type(c, &mut m, t);
    if c.t.kind(t) != ty.Kind.Struct {
        m.push_str(" is not a struct, so it has no fields");
    } else {
        m.push_str(" has ");
        ck.write_number(&mut m, fields(c, t).len() as u64);
        m.push_str(" pub field");
        if fields(c, t).len() != 1 {
            m.push_str("s");
        }
        m.push_str(", so none is number ");
        ck.write_number(&mut m, i);
    }
    ck.report_owned(c, codes.META, at, m);
}

/// The checks a call of core.meta instance d at `call` needs beyond its
/// signature's: a field that exists, and unsupported, which is an error
/// wherever it is checked.
pub fn check_call(c: &mut ck.Checker, call: cst.NodeId, d: u32) {
    var name = alloc.String.init(c.a);
    name.push_str(name_of(c, d));
    let nm = name.view();
    let decl = c.decls[d as usize];
    let s = ck.span_of(c, call);
    if nm.eq("field_name") or nm.eq("field") or nm.eq("field_mut") {
        if field_of(c, d) == ck.NONE {
            let t = c.env[decl.env_start as usize].type_id;
            no_field(c, t, c.env[(decl.env_start + 1) as usize].value, s);
        }
        return;
    }
    if nm.eq("method_count") {
        let t = c.env[decl.env_start as usize].type_id;
        let i = iface_of(c, t);
        if i == ck.NONE or not usable(c, i) {
            no_method(c, t, m: 0, p: 0, at: s);
        }
        return;
    }
    if nm.eq("method_name") or nm.eq("param_count") or nm.eq("call") or nm.eq("arg") {
        let t = c.env[decl.env_start as usize].type_id;
        match sig_of(c, d) {
            some(f) => {
                if nm.eq("arg") and env_value(c, d, k: 2) + 1 >= f.params_len as u64 {
                    no_method(c, t, m: env_value(c, d, k: 1), p: env_value(c, d, k: 2), at: s);
                }
            }
            none => { no_method(c, t, m: env_value(c, d, k: 1), p: 0, at: s); }
        }
        return;
    }
    if nm.eq("unsupported") {
        let t = c.env[decl.env_start as usize].type_id;
        var m = ck.new_message(c);
        var within = ck.NONE;
        if c.fn_index != ck.NONE {
            within = c.fns[c.fn_index as usize].decl;
            ck.write_decl_name(c, &mut m, within);
            m.push_str(" does not handle ");
        } else {
            m.push_str("this code does not handle ");
        }
        ck.write_type(c, &mut m, t);
        // Said where the program asks for it: the call in the package that
        // leads, through instances, to this one.
        var module = c.module;
        var at = s;
        var steps: u32 = 0;
        while within != ck.NONE and not c.p.modules[module as usize].in_package and steps < 1000 : (steps += 1) {
            match c.origins.get(within) {
                some(o) => {
                    module = o.module;
                    at = o.span;
                    within = o.within;
                }
                none => { break; }
            }
        }
        if module != c.module {
            m.push_str(", which this call reaches");
        }
        c.p.diags.file = module;
        c.p.diags.report_owned(codes.META, at, m);
    }
}
