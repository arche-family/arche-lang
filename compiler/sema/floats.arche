/// Float literals (spec/arche.md §2.1): the IEEE 754 value nearest to the
/// decimal text, ties to even, found with exact integer arithmetic, since
/// the compiler's own language has no floats.
import alloc;

/// A natural number in base 2^32, least significant limb first.
type Big = struct {
    limbs: alloc.List(u32),
}

fn pow2(k: u64) -> u64 {
    let one: u64 = 1;
    return one << k;
}

fn big(a: alloc.Allocator) -> Big {
    return Big { limbs: alloc.List(u32).init(a) };
}

fn trim(x: &mut Big) {
    while x.limbs.len() > 0 and x.limbs[x.limbs.len() - 1] == 0 {
        _ = x.limbs.pop();
    }
}

/// x = x * m + add
fn mul_add(x: &mut Big, m: u32, add: u32) {
    var carry: u64 = add as u64;
    var i: usize = 0;
    while i < x.limbs.len() : (i += 1) {
        let v = (x.limbs[i] as u64) * (m as u64) + carry;
        x.limbs[i] = (v & 0xFFFFFFFF) as u32;
        carry = v >> 32;
    }
    if carry > 0 {
        x.limbs.push(carry as u32);
    }
}

fn bit_len(x: &Big) -> u64 {
    let n = x.limbs.len();
    if n == 0 {
        return 0;
    }
    var top = x.limbs[n - 1];
    var bits: u64 = 0;
    while top > 0 : (bits += 1) {
        top = top >> 1;
    }
    return (n as u64 - 1) * 32 + bits;
}

/// x * 2^k, as a new number.
fn shl(x: &Big, k: u64, a: alloc.Allocator) -> Big {
    var out = big(a);
    let words = (k / 32) as usize;
    let bits = (k % 32) as u32;
    var i: usize = 0;
    while i < words : (i += 1) {
        out.limbs.push(0);
    }
    var carry: u32 = 0;
    i = 0;
    while i < x.limbs.len() : (i += 1) {
        let v = x.limbs[i];
        if bits == 0 {
            out.limbs.push(v);
        } else {
            out.limbs.push((v << bits) | carry);
            carry = v >> (32 - bits);
        }
    }
    if carry > 0 {
        out.limbs.push(carry);
    }
    trim(&mut out);
    return out;
}

fn copy(x: &Big, a: alloc.Allocator) -> Big {
    return shl(x, 0, a);
}

/// -1, 0 or 1 as x is less than, equal to or greater than y.
fn compare(x: &Big, y: &Big) -> i32 {
    if x.limbs.len() != y.limbs.len() {
        if x.limbs.len() < y.limbs.len() {
            return -1;
        }
        return 1;
    }
    var i = x.limbs.len();
    while i > 0 : (i -= 1) {
        let a = x.limbs[i - 1];
        let b = y.limbs[i - 1];
        if a != b {
            if a < b {
                return -1;
            }
            return 1;
        }
    }
    return 0;
}

/// x = x - y, for x >= y.
fn sub(x: &mut Big, y: &Big) {
    var borrow: u64 = 0;
    var i: usize = 0;
    while i < x.limbs.len() : (i += 1) {
        var yv: u64 = 0;
        if i < y.limbs.len() {
            yv = y.limbs[i] as u64;
        }
        let xv = x.limbs[i] as u64;
        let need = yv + borrow;
        if xv >= need {
            x.limbs[i] = (xv - need) as u32;
            borrow = 0;
        } else {
            x.limbs[i] = (xv + 4294967296 - need) as u32;
            borrow = 1;
        }
    }
    trim(x);
}

/// The quotient n / d, which is below 2^64, and n becomes the remainder.
fn divide(n: &mut Big, d: &Big, a: alloc.Allocator) -> u64 {
    var q: u64 = 0;
    var bit: u64 = 64;
    while bit > 0 : (bit -= 1) {
        let shifted = shl(d, bit - 1, a);
        if compare(x: n, y: &shifted) >= 0 {
            sub(n, &shifted);
            q = q | pow2(bit - 1);
        }
    }
    return q;
}

/// The format: p significant bits, the smallest normal exponent, the
/// bias, and the largest biased exponent (all ones: infinity).
type Format = struct {
    p: u64,
    emin: i64,
    bias: i64,
    max_biased: u64,
}

/// The bits of the value num / den, rounded to the format.
fn round(num: &Big, den: &Big, f: Format, a: alloc.Allocator) -> u64 {
    if num.limbs.len() == 0 {
        return 0;
    }
    // e such that num / den / 2^e has p bits: q = floor(num * 2^-e / den).
    var e = bit_len(num) as i64 - bit_len(den) as i64 - f.p as i64;
    var q: u64 = 0;
    var rem = big(a);
    var d2 = big(a);
    var tries: u32 = 0;
    while tries < 4 : (tries += 1) {
        if e < f.emin - f.p as i64 + 1 {
            e = f.emin - f.p as i64 + 1; // subnormal: fewer bits
        }
        if e <= 0 {
            rem = shl(num, (-e) as u64, a);
            d2 = copy(den, a);
        } else {
            rem = copy(num, a);
            d2 = shl(den, e as u64, a);
        }
        q = divide(&mut rem, &d2, a);
        if q >= pow2(f.p) {
            e += 1;
            continue;
        }
        if q < pow2(f.p - 1) and e > f.emin - f.p as i64 + 1 {
            e -= 1;
            continue;
        }
        break;
    }
    // Ties to even: compare twice the remainder with the divisor.
    let twice = shl(&rem, 1, a);
    let c = compare(x: &twice, y: &d2);
    if c > 0 or (c == 0 and q % 2 == 1) {
        q += 1;
        if q == pow2(f.p) {
            q = q >> 1;
            e += 1;
        }
    }
    let mantissa_bits = f.p - 1;
    if q < pow2(mantissa_bits) {
        return q; // subnormal, or zero
    }
    let biased = e + f.p as i64 - 1 + f.bias;
    if biased >= f.max_biased as i64 {
        return f.max_biased << mantissa_bits; // infinity
    }
    return ((biased as u64) << mantissa_bits) | (q - pow2(mantissa_bits));
}

/// The bits of the literal in the format with p significant bits.
fn parse(text: str, f: Format, a: alloc.Allocator) -> u64 {
    var digits = big(a);
    var exp10: i64 = 0;
    var ndigits: i64 = 0;
    var i: usize = 0;
    var after_point = false;
    while i < text.len() : (i += 1) {
        let ch = text[i];
        if ch == '_' {
            continue;
        }
        if ch == '.' {
            after_point = true;
            continue;
        }
        if ch == 'e' or ch == 'E' {
            break;
        }
        let d = (ch - '0') as u32;
        if digits.limbs.len() > 0 or d != 0 {
            ndigits += 1;
        }
        // Digits past what can change the result only matter as nonzero.
        if ndigits <= 800 {
            mul_add(&mut digits, m: 10, add: d);
            if after_point {
                exp10 -= 1;
            }
        } else if not after_point {
            exp10 += 1;
        }
    }
    if i < text.len() {
        i += 1;
        var negative = false;
        if text[i] == '+' or text[i] == '-' {
            negative = text[i] == '-';
            i += 1;
        }
        var e: i64 = 0;
        while i < text.len() : (i += 1) {
            if text[i] != '_' and e < 100000 {
                e = e * 10 + (text[i] - '0') as i64;
            }
        }
        if negative {
            e = -e;
        }
        exp10 += e;
    }
    trim(&mut digits);
    if digits.limbs.len() == 0 {
        return 0;
    }
    if ndigits + exp10 > 400 {
        return f.max_biased << (f.p - 1); // infinity
    }
    if ndigits + exp10 < -400 {
        return 0;
    }
    var num = digits;
    var den = big(a);
    den.limbs.push(1);
    while exp10 > 0 : (exp10 -= 1) {
        mul_add(&mut num, m: 10, add: 0);
    }
    while exp10 < 0 : (exp10 += 1) {
        mul_add(&mut den, m: 10, add: 0);
    }
    return round(num: &num, den: &den, f, a);
}

pub fn f64_bits(text: str, a: alloc.Allocator) -> u64 {
    return parse(text, Format { p: 53, emin: -1022, bias: 1023, max_biased: 2047 }, a);
}

pub fn f32_bits(text: str, a: alloc.Allocator) -> u64 {
    return parse(text, Format { p: 24, emin: -126, bias: 127, max_biased: 255 }, a);
}

/// The f64 bits of the value that f32 bits b hold, which f64 holds exactly.
pub fn widen(b: u64) -> u64 {
    let sign = (b >> 31) & 1;
    let exp = (b >> 23) & 0xFF;
    var mant = b & 0x7FFFFF;
    if exp == 0 and mant == 0 {
        return sign << 63;
    }
    if exp == 0xFF {
        let all_ones: u64 = 0x7FF;
        return (sign << 63) | (all_ones << 52) | (mant << 29);
    }
    var e = exp as i64 - 127;
    if exp == 0 {
        // Subnormal: normalize the mantissa.
        e = -126;
        while (mant & 0x800000) == 0 : (mant = mant << 1) {
            e -= 1;
        }
        mant = mant & 0x7FFFFF;
    }
    return (sign << 63) | (((e + 1023) as u64) << 52) | (mant << 29);
}

pub fn is_infinite_f64(b: u64) -> bool {
    return (b & 0x7FFFFFFFFFFFFFFF) == 0x7FF0000000000000;
}

pub fn is_infinite_f32(b: u64) -> bool {
    return (b & 0x7FFFFFFF) == 0x7F800000;
}
