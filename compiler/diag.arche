/// Diagnostics: errors with a stable code (docs/error-codes.md), a place in
/// the source and a message, written as text or as JSON.
import std;
import alloc;

/// A byte range of a source file.
pub type Span = struct {
    pub start: u32,
    pub len: u32,

    pub fn end(self: Span) -> u32 {
        return self.start + self.len;
    }
}

/// A machine-applicable fix: replace the text of span with replacement.
pub type Fix = struct {
    pub span: Span,
    pub replacement: alloc.String,
}

pub type Diagnostic = struct {
    /// The file it is about: an index into the program's modules.
    pub file: u32,
    pub code: u16,
    pub span: Span,
    pub message: alloc.String,
    pub fix: ?Fix,
}

pub type Diagnostics = struct {
    pub items: alloc.List(Diagnostic),
    /// The file that report and its relatives are about.
    pub file: u32,
    a: alloc.Allocator,

    pub fn init(a: alloc.Allocator) -> Diagnostics {
        return Diagnostics { items: alloc.List(Diagnostic).init(a), file: 0, a: a };
    }

    /// A diagnostic whose message is fixed text.
    pub fn report(self: &mut Diagnostics, code: u16, span: Span, message: str) {
        var m = alloc.String.init(self.a);
        m.push_str(message);
        self.items.push(Diagnostic { file: self.file, code: code, span: span, message: m, fix: none });
    }

    /// A diagnostic whose message was built by the caller.
    pub fn report_owned(self: &mut Diagnostics, code: u16, span: Span, message: alloc.String) {
        self.items.push(Diagnostic { file: self.file, code: code, span: span, message: message, fix: none });
    }

    /// A diagnostic with a fix that replaces the text of `at` with `replacement`.
    pub fn report_fix(self: &mut Diagnostics, code: u16, span: Span, message: str, at: Span, replacement: str) {
        var m = alloc.String.init(self.a);
        m.push_str(message);
        var r = alloc.String.init(self.a);
        r.push_str(replacement);
        self.items.push(Diagnostic { file: self.file, code: code, span: span, message: m, fix: some(Fix { span: at, replacement: r }) });
    }

    /// Gives the last diagnostic a fix.
    pub fn attach_fix(self: &mut Diagnostics, at: Span, replacement: str) {
        var r = alloc.String.init(self.a);
        r.push_str(replacement);
        let last = self.items.len() - 1;
        self.items[last].fix = some(Fix { span: at, replacement: r });
    }

    pub fn new_message(self: &Diagnostics) -> alloc.String {
        return alloc.String.init(self.a);
    }

    pub fn count(self: &Diagnostics) -> usize {
        return self.items.len();
    }
}

/// The line and column (both from 1, the column in bytes) of an offset.
pub type Position = struct {
    pub line: u32,
    pub column: u32,
}

pub fn position(text: str, offset: u32) -> Position {
    var line: u32 = 1;
    var line_start: usize = 0;
    var i: usize = 0;
    let end = offset as usize;
    while i < end and i < text.len() : (i += 1) {
        if text[i] == '\n' {
            line += 1;
            line_start = i + 1;
        }
    }
    return Position { line: line, column: (end - line_start) as u32 + 1 };
}

/// The diagnostics in source order: lexing and parsing report in two
/// passes, but a reader goes through the file once. Equal positions keep
/// the order they were reported in.
fn sorted(diags: &Diagnostics, file: u32) -> alloc.List(u32) {
    var order = alloc.List(u32).init(diags.a);
    let items = diags.items.items();
    var i: usize = 0;
    while i < items.len() : (i += 1) {
        if items[i].file != file {
            continue;
        }
        order.push(i as u32);
        var j = order.len() - 1;
        while j > 0 and items[order[j - 1] as usize].span.start > items[i].span.start : (j -= 1) {
            order[j] = order[j - 1];
            order[j - 1] = i as u32;
        }
    }
    return order;
}

fn write_code(out: &mut std.Output, code: u16) {
    out.write_byte('E');
    var divisor: u16 = 1000;
    while divisor > 0 : (divisor /= 10) {
        out.write_byte('0' + ((code / divisor) % 10) as u8);
    }
}

/// path:line:column: error[E0112]: message, for the diagnostics of one file.
pub fn write_text(out: &mut std.Output, diags: &Diagnostics, file: u32, path: str, text: str) {
    let items = diags.items.items();
    let order = sorted(diags, file);
    var i: usize = 0;
    while i < order.len() : (i += 1) {
        let d = &items[order[i] as usize];
        let pos = position(text, d.span.start);
        out.write(path);
        out.write(":");
        out.write_u64(pos.line as u64);
        out.write(":");
        out.write_u64(pos.column as u64);
        out.write(": error[");
        write_code(out, d.code);
        out.write("]: ");
        out.write(d.message.view());
        out.write("\n");
    }
}

fn write_json_string(out: &mut std.Output, s: str) {
    out.write_byte('"');
    var i: usize = 0;
    while i < s.len() : (i += 1) {
        let c = s[i];
        match c {
            '"' => { out.write("\\\""); }
            '\\' => { out.write("\\\\"); }
            '\n' => { out.write("\\n"); }
            '\t' => { out.write("\\t"); }
            0..=0x1F => {
                out.write("\\u00");
                write_hex_digit(out, c / 16);
                write_hex_digit(out, c % 16);
            }
            _ => { out.write_byte(c); }
        }
    }
    out.write_byte('"');
}

fn write_hex_digit(out: &mut std.Output, d: u8) {
    if d < 10 {
        out.write_byte('0' + d);
    } else {
        out.write_byte('a' + d - 10);
    }
}

/// A JSON array with one object per diagnostic, in source order. A fix
/// replaces the text from (line, column) up to, not including,
/// (end_line, end_column) with its replacement.
///
/// The objects of one file; the caller writes the brackets around all the
/// files. `first` says whether no object has been written yet.
pub fn write_json(out: &mut std.Output, diags: &Diagnostics, file: u32, path: str, text: str, first: &mut bool) {
    let items = diags.items.items();
    let order = sorted(diags, file);
    var i: usize = 0;
    while i < order.len() : (i += 1) {
        let d = &items[order[i] as usize];
        let pos = position(text, d.span.start);
        if not first.* {
            out.write(",");
        }
        first.* = false;
        out.write("\n  {\"file\": ");
        write_json_string(out, path);
        out.write(", \"line\": ");
        out.write_u64(pos.line as u64);
        out.write(", \"column\": ");
        out.write_u64(pos.column as u64);
        out.write(", \"severity\": \"error\", \"code\": \"");
        write_code(out, d.code);
        out.write("\", \"message\": ");
        write_json_string(out, d.message.view());
        out.write(", \"fix\": ");
        match &d.fix {
            some(f) => {
                let from = position(text, f.span.start);
                let to = position(text, f.span.end());
                out.write("{\"line\": ");
                out.write_u64(from.line as u64);
                out.write(", \"column\": ");
                out.write_u64(from.column as u64);
                out.write(", \"end_line\": ");
                out.write_u64(to.line as u64);
                out.write(", \"end_column\": ");
                out.write_u64(to.column as u64);
                out.write(", \"replacement\": ");
                write_json_string(out, f.replacement.view());
                out.write("}");
            }
            none => { out.write("null"); }
        }
        out.write("}");
    }
}
