#!/bin/sh
# Builds a program as arche-driver does, one object for each module
# (arche units), without the cache: the conformance runner's compiler
# command for checking the units against the tests.
# Usage: arche-build-units <source.arche> <output>
set -eu
if [ $# -ne 2 ]; then
    echo "usage: arche-build-units <source.arche> <output>" >&2
    exit 2
fi
here=$(cd "$(dirname "$0")" && pwd)
. "$here/target.sh"
cc=$CLANG
rt="$here/build/rt-sections-$ARCHE_TARGET.o"
if rt_stale "$rt"; then
    $cc -c -O2 -ffreestanding -fno-builtin -nostdlib -fno-stack-protector $RT_FLAGS -ffunction-sections -fdata-sections \
        -Wall -Wextra -Werror -o "$rt.tmp.$$" "$here/runtime/rt.c"
    mv "$rt.tmp.$$" "$rt"
fi
units="$2.units"
rm -rf "$units"
mkdir -p "$units"
"${ARCHE:-$here/build/arche}" ${ARCHE_FLAGS:-} $TARGET_FLAG units "$1" "$units" > "$units/list"
objects=""
for u in $(cat "$units/list"); do
    $cc -c -O1 $RT_FLAGS -ffunction-sections -fdata-sections -Wno-override-module -o "$u.o" "$u"
    objects="$objects $u.o"
done
# shellcheck disable=SC2086
$cc $LINK_FLAGS $GC_FLAGS -o "$2" $objects "$rt"
