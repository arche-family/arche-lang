import std;
import alloc;
import helper;

/// A point on the plane.
type Point = struct {
    x: u32,
    pub y: u32,

    /// The point moved right.
    fn right(self: Point, by: u32) -> Point {
        return Point { x: self.x + by, y: self.y };
    }

    fn origin() -> Point {
        return Point { x: 0, y: 0 };
    }
}

type Shape = enum {
    Circle,
    Square,

    fn sides(self: Shape) -> u32 {
        return 0;
    }
}

fn area(width: u32, height: u32) -> u32 {
    return width * height;
}

fn main(sys: &mut std.System) -> !void {
    let p = Point.origin();
    let total = p.right(by: 2).x;
    let name = "text";
    var list = alloc.List(u32).init(sys.alloc);
    list.push(total);
    sys.stdout.write(name);
    // HERE
}
