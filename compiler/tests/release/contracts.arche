// A release build proves these contracts, and the checks of division and
// overflow, from the constants: main keeps no trap (compiler/tests/run.sh).
import std;

fn half(n: u32) -> u32
    requires n % 2 == 0
    ensures result * 2 == n
{
    return n / 2;
}

fn main(sys: &mut std.System) -> !void {
    sys.stdout.write_u64(half(8) as u64);
    sys.stdout.write("\n");
}
