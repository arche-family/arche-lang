import std;

type Point = struct {
    x: u32,
    y: u32,
}

fn area(width: u32, height: u32) -> u32 {
    return width * height;
}

fn twice(p: Point) -> u32 {
    let a = area(width: p.x, height: p.y);
    return a + area(width: p.y, height: p.x);
}

fn main(sys: &mut std.System) -> !void {
    let p = Point { x: 3, y: 4 };
    let total = twice(p) + area(width: 1, height: 2);
    sys.stdout.write_u64(total as u64);
}
