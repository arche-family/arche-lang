// arche fmt: indentation, spaces and blank lines.
import std;

type Shape = enum {
    Circle { radius: u32 },
    Square,
}

fn area(width: u32, height: u32) -> u32
    requires width < 1000
{
    return width * height;
}

fn main(sys: &mut std.System) -> !void {
    let x: u32 = -3 + 10; // a comment, kept
    var list = alloc.List(u8).init(sys.alloc);
    if x > 1 and
        x < 100 {
        list.push(1);
    }
    let arr: [4]u8 = [1, 2, 3, 4];
    let y = arr[0..2];
    let p = &x;
    let n = area(width: 2, height: x) +
        1;
    match x {
        1 | 2 => { }
        _ => {}
    }
}
