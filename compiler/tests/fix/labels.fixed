// arche fix: labels for arguments whose parameters share a type, and a
// carriage return taken out.
import std;

fn area(width: u32, height: u32) -> u32 {
    return width * height;
}

fn blend(a: u8, b: u8, c: u8) -> u8 {
    return a ^ b ^ c;
}

fn main(sys: &mut std.System) -> !void {
    sys.stdout.write_u64(area(width: 3, height: 4) as u64);
    sys.stdout.write_u64(blend(a: 1, b: 2, c: area(width: 5, height: 6) as u8) as u64);
    sys.stdout.write("\n");
}

