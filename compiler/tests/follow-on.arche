// An error says what is wrong once: a literal whose context is in error has
// nothing to add, and one that never had a context still does.
import std;

fn unknown_function() -> i32 {
    return nope(1) + 2;
}

fn unknown_method(x: i32) -> i32 {
    return x.nope(1, -2, none, [3, 4]);
}

fn from_an_error() -> i32 {
    let v = nope(2 + 3);
    let w: Nope = 5;
    return v + 1 + w;
}

fn still_reported() {
    let q = 5;
    _ = q;
}

fn main(sys: &mut std.System) -> !void {
}
