/// What `arche explain <code>` prints: each error code's meaning, from
/// docs/error-codes.md, and an example that gets the code. Generated by
/// gen-explain.py from the error codes and the conformance tests; do not
/// edit it, run that.

/// The meaning of a code, or "" when there is no such code.
pub fn meaning(code: u16) -> str {
    if code == 101 {
        return "The file is not valid UTF-8.";
    }
    if code == 102 {
        return "A `\\r` outside a string literal; lines end with `\\n`.";
    }
    if code == 103 {
        return "A character that starts no token, such as `#` or a non-ASCII letter outside a string or comment.";
    }
    if code == 104 {
        return "A word reserved for full Arche (§2.1) used as a name.";
    }
    if code == 110 {
        return "An integer literal with a base prefix and no digits: `0x`.";
    }
    if code == 111 {
        return "A `_` in an integer literal that does not separate two digits.";
    }
    if code == 112 {
        return "A digit that is not valid in the literal's base, or a suffix: `0b102`, `10u64`.";
    }
    if code == 113 {
        return "An integer literal that does not fit in 64 bits.";
    }
    if code == 120 {
        return "An empty character literal: `''`.";
    }
    if code == 121 {
        return "A character literal with more than one character.";
    }
    if code == 122 {
        return "A non-ASCII character literal.";
    }
    if code == 123 {
        return "A character literal that is not closed.";
    }
    if code == 130 {
        return "A string literal that is not closed on its line.";
    }
    if code == 131 {
        return "An unknown escape: `\\q`.";
    }
    if code == 132 {
        return "A `\\x` escape above `\\x7F`.";
    }
    if code == 133 {
        return "A `\\u{...}` escape in a character literal.";
    }
    if code == 134 {
        return "A malformed `\\u{...}` escape: no digits, more than six, or no closing `}`.";
    }
    if code == 135 {
        return "A `\\u{...}` escape that is not a Unicode scalar value.";
    }
    if code == 201 {
        return "An unexpected token: the grammar needs something else here.";
    }
    if code == 202 {
        return "An `import` after another item; imports come first.";
    }
    if code == 203 {
        return "Chained comparisons: `a < b < c`.";
    }
    if code == 204 {
        return "`&`, `^` and `|` mixed without parentheses.";
    }
    if code == 205 {
        return "`and` and `or` mixed without parentheses.";
    }
    if code == 206 {
        return "A struct field after a method; fields come first.";
    }
    if code == 207 {
        return "A module-level `var` or `let`; a module has no mutable state.";
    }
    if code == 208 {
        return "A field in an enum body; an enum lists variants, then methods.";
    }
    if code == 209 {
        return "A `_ = ...` discard as a `while` step.";
    }
    if code == 210 {
        return "A variant written with `{ }` and no fields.";
    }
    if code == 211 {
        return "`pub` before `test` or `import`.";
    }
    if code == 212 {
        return "In edition 2027, a pattern `ok(…)` or `err(…)`: they are `.ok(…)` and `.err(…)`, like variants (§1.2).";
    }
    if code == 301 {
        return "An unknown name where a value is expected.";
    }
    if code == 302 {
        return "An unknown type.";
    }
    if code == 303 {
        return "An unknown function.";
    }
    if code == 304 {
        return "An item, parameter, field, variant or error declared twice.";
    }
    if code == 305 {
        return "A name declared while the same name is visible: Arche has no shadowing (§6.3). Erasable.";
    }
    if code == 306 {
        return "A private item, field or method used from another module (§4). Erasable.";
    }
    if code == 307 {
        return "An imported module that cannot be found.";
    }
    if code == 308 {
        return "A name imported twice, or an import of a library module Arche-0 does not have.";
    }
    if code == 309 {
        return "A name that is not a value: a function, type or module used as one.";
    }
    if code == 310 {
        return "A field, method, variant or error that the type does not have.";
    }
    if code == 311 {
        return "A module that has no item with this name.";
    }
    if code == 312 {
        return "A method with the name of a field or variant of its type.";
    }
    if code == 313 {
        return "No `main`, or `main` not declared as `fn main(sys: &mut std.System) -> !void`.";
    }
    if code == 401 {
        return "A value of the wrong type.";
    }
    if code == 402 {
        return "The operands of a binary operator have different types.";
    }
    if code == 403 {
        return "An operator that does not work on this type.";
    }
    if code == 404 {
        return "An integer literal that does not fit in its type.";
    }
    if code == 405 {
        return "An integer literal, `none` or array literal with no type from context (§5.6). Erasable for integers.";
    }
    if code == 406 {
        return "An `as` conversion between types that are not both integers, or of a literal.";
    }
    if code == 407 {
        return "A call with the wrong number of arguments.";
    }
    if code == 408 {
        return "A label that does not match its parameter (§7.5). Erasable.";
    }
    if code == 409 {
        return "A missing label where two parameters have the same type (§7.5). Erasable.";
    }
    if code == 410 {
        return "An expression that cannot be called.";
    }
    if code == 411 {
        return "An assignment or `&` of something that is not a place.";
    }
    if code == 412 {
        return "A change through a place that is not mutable: a `let`, a parameter, or a `&` view.";
    }
    if code == 413 {
        return "`.*` of something that is not a reference.";
    }
    if code == 414 {
        return "Indexing or slicing a type that cannot be indexed, or slicing a value that is not a place.";
    }
    if code == 415 {
        return "A struct literal whose fields are missing, unknown or out of order.";
    }
    if code == 416 {
        return "A variant used without its fields, or with fields it does not have.";
    }
    if code == 417 {
        return "An array literal with the wrong number of elements.";
    }
    if code == 418 {
        return "`orelse` or `catch` on a value that is not an optional or error union.";
    }
    if code == 419 {
        return "`try` in a function that does not return an error union, or on a value that is not one.";
    }
    if code == 420 {
        return "An error that the function's error set does not contain.";
    }
    if code == 421 {
        return "`let` of an expression that has no value.";
    }
    if code == 422 {
        return "A method whose `self` is not the type, `&` or `&mut` of it; or an associated function called as a method.";
    }
    if code == 423 {
        return "A struct or enum that contains itself.";
    }
    if code == 424 {
        return "A type alias that refers to itself.";
    }
    if code == 425 {
        return "A Map key type that is not a key type (§5.5).";
    }
    if code == 426 {
        return "A generic type with the wrong number of arguments, or one Arche-0 does not have.";
    }
    if code == 501 {
        return "A result that is not used; write `_ = ...` to drop it (§7.8). Erasable.";
    }
    if code == 502 {
        return "`return` without a value in a function that returns one, or with one in a function that does not.";
    }
    if code == 503 {
        return "A function that can reach its end without returning its value (§10).";
    }
    if code == 504 {
        return "`break` or `continue` outside a loop.";
    }
    if code == 505 {
        return "`return`, `break`, `continue` or `try` in deferred code.";
    }
    if code == 506 {
        return "A pattern that cannot match the type of the value.";
    }
    if code == 507 {
        return "Alternatives joined with `|` that bind names.";
    }
    if code == 508 {
        return "A variant pattern that does not name every field and does not end with `..`.";
    }
    if code == 509 {
        return "A `match` that is not exhaustive. Erasable: stage0 traps at run time instead.";
    }
    if code == 510 {
        return "An empty range pattern.";
    }
    if code == 511 {
        return "A label that no enclosing loop has, or one that repeats an enclosing loop's (spec/arche.md §3.4).";
    }
    if code == 512 {
        return "An `if` expression without `else`, or a branch of an `if` or `match` expression that ends without a value (spec/arche.md §3.1).";
    }
    if code == 701 {
        return "An expression that is not a constant expression.";
    }
    if code == 702 {
        return "A constant expression that overflows its type.";
    }
    if code == 703 {
        return "Division by zero in a constant expression.";
    }
    if code == 704 {
        return "A constant that depends on itself.";
    }
    if code == 705 {
        return "A constant whose type is not an integer type, `bool` or `str`.";
    }
    if code == 601 {
        return "A view where views cannot be: a field, a payload, an element, or the payload of `?` or `!` (§5.4).";
    }
    if code == 602 {
        return "A function that returns a view with more than one view parameter (§5.4).";
    }
    if code == 603 {
        return "A view that outlives what it views: a view of a local returned, or stored in a binding of an enclosing block (§5.4).";
    }
    if code == 604 {
        return "A place used while a view of it is live, through another path: written or viewed `&mut` while viewed, or used at all while viewed `&mut` (§5.4).";
    }
    if code == 605 {
        return "A move-only value used after it was moved (§5.5).";
    }
    if code == 606 {
        return "A move out of a place reached through a view (§5.5).";
    }
    if code == 607 {
        return "A view chosen by an `if` or `match` expression whose branches view different places (spec/arche.md §3.1).";
    }
    if code == 801 {
        return "A capability type, or a capability field of `std.System`, that the package manifest does not list in `needs` (§1.3).";
    }
    if code == 802 {
        return "A manifest (`package.arche`) or a build file (`build.arche`) that is not one constant of the expected form: an unknown field, or a value that is not a literal of its kind (§1.1).";
    }
    if code == 803 {
        return "A manifest's `edition` that is not an edition: 2026 or 2027 (§1.2).";
    }
    if code == 810 {
        return "A `for` loop over a value that is not a range, a slice or an iterator (§3.2).";
    }
    if code == 811 {
        return "A `for` loop's range or names that do not fit: bounds of two types, a pair over a range or over items that are not a struct of two fields, a type on a name that is not a range's (§3.2).";
    }
    if code == 820 {
        return "An `impl` of something that is not an interface, or for a type that cannot implement one here (§5.1).";
    }
    if code == 821 {
        return "An `impl` outside both the module that declares the type and the one that declares the interface (§5.1).";
    }
    if code == 822 {
        return "An `impl` whose methods are not the interface's: one missing, one more, one with other parameters, names or result, or one the type has already (§5.1).";
    }
    if code == 823 {
        return "A second `impl` of one interface for one type (§5.1).";
    }
    if code == 824 {
        return "A method call whose name two interfaces of the type have; name the interface: `I.name(&x, …)` (§5.1).";
    }
    if code == 825 {
        return "An interface where a type of values is expected; a view of a value that implements it is `&dyn I` (§5.3).";
    }
    if code == 830 {
        return "A `comptime` type argument that does not implement an interface its `where` bound requires (§5.2).";
    }
    if code == 831 {
        return "`dyn I` of an interface whose methods do not all take `self` by reference and use `Self` nowhere else (§5.3).";
    }
    if code == 832 {
        return "A value converted to `&dyn I`, or passed to `I.name(…)`, whose type does not implement `I` (§5.1, §5.3).";
    }
    if code == 840 {
        return "Compile-time evaluation that runs too many steps or recurses too deep (§4.3).";
    }
    if code == 850 {
        return "A closure body that uses a binding from outside without capturing it (§6).";
    }
    if code == 851 {
        return "A capture that names no local binding, or one binding twice (§6).";
    }
    if code == 901 {
        return "A value bound to a region that leaves the region's block (§7).";
    }
    if code == 902 {
        return "A `&mut` view captured by a task while another task or its scope uses the place (§9).";
    }
    if code == 903 {
        return "A `spawn` whose argument is not a closure written there (§9).";
    }
    if code == 910 {
        return "An operation that can panic or trap in a `nopanic` function, or a call of a function that is not `nopanic` (§8.2).";
    }
    if code == 920 {
        return "An `unsafe` block without a `// SAFETY:` comment at its start, in a package that sets `strict_unsafe` (§10.1).";
    }
    if code == 921 {
        return "An operation that needs `unsafe` outside an `unsafe` block or `unsafe fn`: a raw pointer made, read, written, offset or turned into a view, or an `unsafe fn` called (§10.1).";
    }
    if code == 922 {
        return "An `asm` operand that is not `in`, `out`, `inout` or `clobber`, whose value is not an integer, `bool` or pointer, that writes a place it cannot, or a `%N` without an operand (§10.2).";
    }
    if code == 923 {
        return "A `naked fn` with parameters or a result, or whose body is not one `asm` statement (§10.2).";
    }
    if code == 924 {
        return "A foreign function with another calling convention than `\"c\"`, or one that takes or returns something other than integers, `bool`s, floats and raw pointers (§10.1).";
    }
    if code == 925 {
        return "An `align(N)` whose `N` is not a power of two from 1 to 4096, or one on a field of a packed struct (§10.2).";
    }
    if code == 926 {
        return "A view of a field of a packed struct, which may be unaligned (§10.2).";
    }
    if code == 927 {
        return "An atomic operation whose ordering is not written as a constant, is one the operation cannot have, or whose type it does not work on (§10.2).";
    }
    if code == 928 {
        return "A freestanding program without a panic handler, or one whose handler is not `fn(message: str, file: str, line: u32, column: u32) -> noreturn`, or that is not full Arche (§10.3).";
    }
    if code == 929 {
        return "A test block's parameter that is not a `&mut std.testing.Test` (spec/arche.md §1.3, tests).";
    }
    return "";
}

/// A program that gets the code, or "" when there is none yet.
pub fn example(code: u16) -> str {
    if code == 101 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n}\n// The next line has the byte 0xFF, which UTF-8 never uses:\n";
    }
    if code == 102 {
        return "import std;\r\n\nfn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 103 {
        return "import std;\n\nfn café() {}\n\nfn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 104 {
        return "import std;\n\nfn for() {}\n\nfn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 110 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write_u64(0x);\n}\n";
    }
    if code == 111 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write_u64(1_);\n}\n";
    }
    if code == 112 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write_u64(0XFF);\n}\n";
    }
    if code == 113 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write_u64(18446744073709551616);\n}\n";
    }
    if code == 120 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write_byte('');\n}\n";
    }
    if code == 121 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write_byte('ab');\n}\n";
    }
    if code == 122 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write_byte('é');\n}\n";
    }
    if code == 123 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    let c: u8 = 'a;\n}\n";
    }
    if code == 130 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write(\"abc);\n}\n";
    }
    if code == 131 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write(\"\\q\");\n}\n";
    }
    if code == 132 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write(\"\\x80\");\n}\n";
    }
    if code == 133 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write_byte('\\u{41}');\n}\n";
    }
    if code == 134 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write(\"\\u{}\");\n}\n";
    }
    if code == 135 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write(\"\\u{D800}\");\n}\n";
    }
    if code == 201 {
        return "import std;\n\nfn _() {\n}\n\nfn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 202 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n}\n\nimport alloc;\n";
    }
    if code == 203 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n\n    let a: u32 = 1;\n    let b: u32 = 2;\n    if a < b < 3 {\n        sys.stdout.write(\"x\");\n    }\n}\n";
    }
    if code == 204 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n\n    let a: u32 = 1;\n    let b: u32 = a & 2 | 4;\n    sys.stdout.write_u64(b as u64);\n}\n";
    }
    if code == 205 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n\n    let a: bool = true;\n    if a and false or a {\n        sys.stdout.write(\"x\");\n    }\n}\n";
    }
    if code == 206 {
        return "import std;\n\ntype Counter = struct {\n    n: u32,\n\n    fn get(self: Counter) -> u32 {\n        return self.n;\n    }\n    extra: u32,\n}\n\nfn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 207 {
        return "import std;\n\nvar counter: u32 = 0;\n\nfn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 208 {
        return "import std;\n\ntype Shape = enum {\n    Circle,\n    Square,\n\n    fn sides(self: Shape) -> u32 {\n        return 0;\n    }\n\n    radius: u32,\n}\n\nfn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 209 {
        return "import std;\n\nfn tick() -> u32 {\n    return 1;\n}\n\nfn main(sys: &mut std.System) -> !void {\n    var i: u32 = 0;\n    while i < 3 : (_ = tick()) {\n        i += 1;\n    }\n}\n";
    }
    if code == 210 {
        return "import std;\n\ntype Shape = enum {\n    Circle {},\n    Square,\n}\n\nfn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 211 {
        return "pub import std;\n\nfn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 212 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    match sys.fs.read_file(\"notes.txt\", sys.alloc) {\n        ok(text) => { sys.stdout.write(text.view()); }\n        .err(_) => { }\n    }\n}\n";
    }
    if code == 301 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    system.out.write(\"x\");\n}\n";
    }
    if code == 302 {
        return "fn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 303 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    greet();\n}\n";
    }
    if code == 304 {
        return "import std;\n\nfn f() {\n}\n\nfn f() {\n}\n\nfn main(sys: &mut std.System) -> !void {\n    f();\n}\n";
    }
    if code == 305 {
        return "import std;\n\nfn f(result: u32) -> u32\n    ensures result > 0\n{\n    return result;\n}\n\nfn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 306 {
        return "import std;\nimport core;\n\nfn main(sys: &mut std.System) -> !void {\n    let c = std.Clock { unique: core.Unique { } };\n}\n";
    }
    if code == 307 {
        return "import std;\nimport geometry;\n\nfn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 308 {
        return "import std;\nimport std;\n\nfn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 309 {
        return "import std;\n\nfn tick() -> u32 {\n    return 1;\n}\n\nfn main(sys: &mut std.System) -> !void {\n    let f = tick;\n}\n";
    }
    if code == 310 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.print(\"x\");\n}\n";
    }
    if code == 311 {
        return "import std;\nimport core.math;\n\nfn main(sys: &mut std.System) -> !void {\n    let x = math.nothing;\n}\n";
    }
    if code == 312 {
        return "import std;\n\ntype Counter = struct {\n    n: u32,\n\n    fn n(self: Counter) -> u32 {\n        return self.n;\n    }\n}\n\nfn main(sys: &mut std.System) -> !void {\n}\n";
    }
    if code == 313 {
        return "import std;\n\nfn main(sys: &std.System) -> !void {\n}\n";
    }
    if code == 401 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write_u64(\"7\");\n}\n";
    }
    if code == 402 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n\n    let a: f64 = 5.0;\n    let b: f32 = 2.0;\n    let c = a + b;\n}\n";
    }
    if code == 403 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n\n    let a: f64 = 5.0;\n    let b = a % 2.0;\n}\n";
    }
    if code == 404 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n\n    let x: f32 = 1.0e39;\n}\n";
    }
    if code == 405 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n\n    let x = 1.5;\n}\n";
    }
    if code == 406 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n\n    var x: u32 = 1;\n    unsafe {\n        let p = &x as *mut u32;\n    }\n}\n";
    }
    if code == 407 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write(\"a\", \"b\");\n}\n";
    }
    if code == 408 {
        return "import std;\n\nfn greet(out: &mut std.Output, name: str) {\n    out.write(name);\n}\n\nfn main(sys: &mut std.System) -> !void {\n    greet(out: &mut sys.stdout, who: \"Ada\");\n}\n";
    }
    if code == 409 {
        return "import std;\n\nfn area(width: u32, height: u32) -> u32 {\n    return width * height;\n}\n\nfn main(sys: &mut std.System) -> !void {\n    let a = area(3, 4);\n    sys.stdout.write_u64(a as u64);\n}\n";
    }
    if code == 410 {
        return "import std;\n\nfn main(sys: &mut std.System) -> !void {\n    let x: u32 = 1;\n    let y = x();\n}\n";
    }
    if code == 411 {
        return "import std;\n\nfn count(comptime N: u32) -> u32 {\n    var total: u32 = 0;\n    total += N;\n    N = 2;\n    return total;\n}\n\nfn main(sys: &mut std.System) -> !void {\n    sys.stdout.write_u64(count(3) as u64);\n}\n";
