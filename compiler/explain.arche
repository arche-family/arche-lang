/// The options to check the example with, before the command.
pub fn example_options(code: u16) -> str {
    if code == 928 {
        return "--target freestanding-x86_64";
    }
    return "";
}

/// The package.arche the example needs, or "" for one that only says
/// the package is full Arche.
pub fn example_manifest(code: u16) -> str {
    if code == 212 {
        return "import std.build; const PACKAGE: build.Package = build.Package { name: \"demo\", edition: 2027 };\n";
    }
    if code == 801 {
        return "import std.build; const PACKAGE: build.Package = build.Package { name: \"demo\", needs: [build.Capability.Fs] };\n";
    }
    if code == 920 {
        return "import std.build; const PACKAGE: build.Package = build.Package { name: \"demo\", needs: [], strict_unsafe: true };\n";
    }
    return "";
}

/// The name the example's file must have, or "" for any.
pub fn example_file(code: u16) -> str {
    if code == 802 {
        return "package.arche";
    }
    if code == 803 {
        return "package.arche";
    }
    return "";
}
