/// The parser: spec/arche-0.md §14.
import alloc;
import diag;
import syntax.cst;
import syntax.token as tk;

pub fn parse(text: str, tokens: &alloc.List(tk.Token), diags: &mut diag.Diagnostics, a: alloc.Allocator) -> cst.Tree {
    _ = text;
    _ = diags;
    _ = a;
    return cst.Tree { tokens: tokens.len() as u32 };
}
