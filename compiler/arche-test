#!/bin/sh
# Builds the test blocks of a file into a test binary and runs it: arche
# test, linked with the runtime as arche-build links a program.
# Usage: arche-test <source.arche> [--filter <text>] [--seed <number>]
set -eu
if [ $# -lt 1 ]; then
    echo "usage: arche-test <source.arche> [--filter <text>] [--seed <number>]" >&2
    exit 2
fi
here=$(cd "$(dirname "$0")" && pwd)
. "$here/target.sh"
src=$1
shift
cc=$CLANG
rt="$here/build/rt-$ARCHE_TARGET.o"
if rt_stale "$rt"; then
    $cc -c -O2 -ffreestanding -fno-builtin -nostdlib -fno-stack-protector $RT_FLAGS -Wall -Wextra -Werror \
        -o "$rt.tmp.$$" "$here/runtime/rt.c"
    mv "$rt.tmp.$$" "$rt"
fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
if [ "$ARCHE_BACKEND" = own ]; then
    "${ARCHE:-$here/build/arche}" ${ARCHE_FLAGS:-} $TARGET_FLAG test "$src" "$work/tests.ao"
    own_link "$work/tests" "$work/tests.ao" "$rt"
else
    "${ARCHE:-$here/build/arche}" ${ARCHE_FLAGS:-} $TARGET_FLAG test "$src" "$work/tests.ll"
    $cc -O1 $LINK_FLAGS -Wno-override-module -o "$work/tests" "$work/tests.ll" "$rt"
fi
wrap_for_qemu "$work/tests"
"$work/tests" "$@"
