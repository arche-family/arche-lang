/// The package manifest, package.arche (spec/arche.md §1.1), and the build
/// file, build.arche: Arche files that declare one constant each, read
/// here from their syntax tree. Their values are literals: strings,
/// integers, booleans, std.build names and arrays of those.
///
///     import std.build;
///
///     const PACKAGE: build.Package = build.Package {
///         name: "webd",
///         version: "0.3.1",
///         edition: 2027,
///         needs: [build.Capability.Net, build.Capability.Fs],
///         dependencies: [build.dep("webkit", "1.2.0")],
///         registry: "https://127.0.0.1:8443/",
///         registry_key: "<the registry's Ed25519 public key, hex>",
///         strict_unsafe: true,
///         panic_handler: "kernel.panic",
///     };
///
/// A manifest without PACKAGE, only comments, says that the package is
/// full Arche and declares the rest by default: edition 2026, and every
/// capability.
import alloc;
import codes;
import diag;
import syntax.cst;
import syntax.token as tk;

/// The editions there are (§1.2), oldest first.
pub const FIRST_EDITION: u32 = 2026;
pub const LATEST_EDITION: u32 = 2027;

/// A bit per capability type of std (§1.3).
pub const FS: u32 = 1;
pub const NET: u32 = 2;
pub const CLOCK: u32 = 4;
pub const ENV: u32 = 8;
pub const PROC: u32 = 16;
pub const RAND: u32 = 32;
pub const ALL: u32 = 63;

/// The capability bit of a std type name, or 0.
pub fn capability(name: str) -> u32 {
    if name.eq("Fs") { return FS; }
    if name.eq("Net") { return NET; }
    if name.eq("Clock") { return CLOCK; }
    if name.eq("Env") { return ENV; }
    if name.eq("Proc") { return PROC; }
    if name.eq("Rand") { return RAND; }
    return 0;
}

/// The capability bit of a field of std.System, or 0.
pub fn system_field(name: str) -> u32 {
    if name.eq("fs") { return FS; }
    if name.eq("net") { return NET; }
    if name.eq("clock") { return CLOCK; }
    if name.eq("env") { return ENV; }
    if name.eq("proc") { return PROC; }
    if name.eq("rand") { return RAND; }
    return 0;
}

pub type Dependency = struct {
    pub name: alloc.String,
    pub version: alloc.String,
    pub hash: alloc.String,
}

pub type Manifest = struct {
    /// Whether it declares PACKAGE.
    pub found: bool,
    pub name: alloc.String,
    pub version: alloc.String,
    pub edition: u32,
    pub needs: u32,
    pub dependencies: alloc.List(Dependency),
    pub strict_unsafe: bool,
    pub panic_handler: alloc.String,
    /// Where dependencies come from, and the key that signs them.
    pub registry: alloc.String,
    pub registry_key: alloc.String,
}

/// A program build.arche asks for: its name and its root file.
pub type Program = struct {
    pub name: alloc.String,
    pub root: alloc.String,
}

pub fn defaults(a: alloc.Allocator) -> Manifest {
    return Manifest {
        found: false,
        name: alloc.String.init(a),
        version: alloc.String.init(a),
        edition: FIRST_EDITION,
        needs: ALL,
        dependencies: alloc.List(Dependency).init(a),
        strict_unsafe: false,
        panic_handler: alloc.String.init(a),
        registry: alloc.String.init(a),
        registry_key: alloc.String.init(a),
    };
}

/// A tree and its text, and where to report.
type Reader = struct {
    tree: cst.Tree,
    text: alloc.String,
}

fn node(r: &Reader, n: cst.NodeId) -> cst.Node {
    return r.tree.node(n);
}

fn child(r: &Reader, n: cst.NodeId, i: u32) -> cst.NodeId {
    return r.tree.child(r.tree.node(n), i);
}

fn token_text(r: &Reader, t: u32) -> str {
    let tok = r.tree.tokens[t as usize];
    return r.text.view()[tok.start as usize..(tok.start + tok.len) as usize];
}

fn span_of(r: &Reader, n: cst.NodeId) -> diag.Span {
    let first = r.tree.first_token(n);
    let nd = r.tree.node(n);
    var last = nd.end;
    while last > first and r.tree.tokens[(last - 1) as usize].kind.is_trivia() : (last -= 1) {
    }
    let s = r.tree.tokens[first as usize].start;
    if last <= first {
        return diag.Span { start: s, len: 1 };
    }
    let e = r.tree.tokens[(last - 1) as usize];
    return diag.Span { start: s, len: e.start + e.len - s };
}

/// The text of a node's significant tokens, without spaces: "build.Package".
fn joined(r: &Reader, n: cst.NodeId, a: alloc.Allocator) -> alloc.String {
    var s = alloc.String.init(a);
    let nd = node(r, n);
    var t = nd.first;
    while t < nd.end : (t += 1) {
        if not r.tree.tokens[t as usize].kind.is_trivia() {
            s.push_str(token_text(r, t));
        }
    }
    return s;
}

/// A string literal's contents: the manifest's strings have no escapes.
fn string_value(r: &Reader, n: cst.NodeId, diags: &mut diag.Diagnostics, a: alloc.Allocator) -> alloc.String {
    var s = alloc.String.init(a);
    if node(r, n).kind != cst.Kind.StringLit {
        diags.report(codes.BAD_MANIFEST, span_of(r, n), "expected a string");
        return s;
    }
    let text = token_text(r, r.tree.first_token(n));
    var i: usize = 1;
    while i + 1 < text.len() : (i += 1) {
        if text[i] == '\\' {
            diags.report(codes.BAD_MANIFEST, span_of(r, n), "a manifest's strings have no escapes");
            return s;
        }
    }
    s.push_str(text[1..text.len() - 1]);
    return s;
}

/// The constant named name, its value, if the file has it.
fn constant(r: &Reader, name: str) -> ?cst.NodeId {
    let root = node(r, r.tree.root);
    var i: u32 = 0;
    while i < root.children_len : (i += 1) {
        let n = child(r, r.tree.root, i);
        let nd = node(r, n);
        if nd.kind == cst.Kind.ConstDecl and nd.children_len >= 2 {
            var t = nd.first;
            while t < nd.end and r.tree.tokens[t as usize].kind != tk.Kind.Ident : (t += 1) {
            }
            if t < nd.end and token_text(r, t).eq(name) {
                return child(r, n, nd.children_len - 1);
            }
        }
    }
    return none;
}

fn field_name(r: &Reader, f: cst.NodeId) -> str {
    let nd = node(r, f);
    var t = nd.first;
    while t < nd.end and r.tree.tokens[t as usize].kind != tk.Kind.Ident : (t += 1) {
    }
    if t < nd.end {
        return token_text(r, t);
    }
    return "";
}

/// The fields of a struct literal of the type named type_name, as their
/// FieldInit nodes; none, reported, when the value is something else.
fn struct_fields(r: &Reader, v: cst.NodeId, type_name: str, diags: &mut diag.Diagnostics, a: alloc.Allocator) -> ?alloc.List(cst.NodeId) {
    let nd = node(r, v);
    if nd.kind != cst.Kind.StructLit or nd.children_len == 0 or not joined(r, child(r, v, 0), a).view().eq(type_name) {
        var m = diags.new_message();
        m.push_str("expected a ");
        m.push_str(type_name);
        m.push_str(" { ... } literal");
        diags.report_owned(codes.BAD_MANIFEST, span_of(r, v), m);
        return none;
    }
    var out = alloc.List(cst.NodeId).init(a);
    var i: u32 = 1;
    while i < nd.children_len : (i += 1) {
        out.push(child(r, v, i));
    }
    return out;
}

fn parse(tree: cst.Tree, text: str, a: alloc.Allocator) -> Reader {
    var t = alloc.String.init(a);
    t.push_str(text);
    return Reader { tree: tree, text: t };
}

/// Reads a manifest's syntax tree; problems go to diags, against it.
pub fn read(tree: cst.Tree, text: str, diags: &mut diag.Diagnostics, a: alloc.Allocator) -> Manifest {
    let r = parse(tree, text, a);
    var m = defaults(a);
    var value = cst.NodeId { index: 0 };
    match constant(&r, "PACKAGE") {
        some(v) => { value = v; }
        none => { return m; }
    }
    m.found = true;
    var fields = alloc.List(cst.NodeId).init(a);
    match struct_fields(&r, value, type_name: "build.Package", diags: diags, a: a) {
        some(f) => { fields = f; }
        none => { return m; }
    }
    var has_name = false;
    let fs = fields.items();
    var i: usize = 0;
    while i < fs.len() : (i += 1) {
        let f = fs[i];
        let name = field_name(&r, f);
        if node(&r, f).children_len == 0 {
            continue;
        }
        let v = child(&r, f, 0);
        if name.eq("name") {
            m.name = string_value(&r, v, diags: diags, a: a);
            has_name = true;
        } else if name.eq("version") {
            m.version = string_value(&r, v, diags: diags, a: a);
        } else if name.eq("edition") {
            var year: u32 = 0;
            if node(&r, v).kind == cst.Kind.IntLit {
                year = r.tree.tokens[r.tree.first_token(v) as usize].value as u32;
            }
            if year < FIRST_EDITION or year > LATEST_EDITION {
                diags.report(codes.UNKNOWN_EDITION, span_of(&r, v), "the editions are 2026 and 2027");
            } else {
                m.edition = year;
            }
        } else if name.eq("needs") {
            m.needs = 0;
            if node(&r, v).kind != cst.Kind.ArrayLit {
                diags.report(codes.BAD_MANIFEST, span_of(&r, v), "needs is an array of build.Capability values");
            } else {
                var k: u32 = 0;
                while k < node(&r, v).children_len : (k += 1) {
                    let e = child(&r, v, k);
                    let text_e = joined(&r, e, a);
                    let t = text_e.view();
                    var bit: u32 = 0;
                    if t.starts_with("build.Capability.") {
                        bit = capability(t[17..t.len()]);
                    }
                    if bit == 0 {
                        diags.report(codes.BAD_MANIFEST, span_of(&r, e), "a capability is build.Capability.Fs, Net, Clock, Env, Proc or Rand");
                    }
                    m.needs = m.needs | bit;
                }
            }
        } else if name.eq("dependencies") {
            if node(&r, v).kind != cst.Kind.ArrayLit {
                diags.report(codes.BAD_MANIFEST, span_of(&r, v), "dependencies is an array of build.dep(name, version, hash)");
            } else {
                var k: u32 = 0;
                while k < node(&r, v).children_len : (k += 1) {
                    let e = child(&r, v, k);
                    let args = node(&r, e).children_len;
                    let ok_call = node(&r, e).kind == cst.Kind.CallExpr and (args == 3 or args == 4) and
                        joined(&r, child(&r, e, 0), a).view().eq("build.dep");
                    if not ok_call {
                        diags.report(codes.BAD_MANIFEST, span_of(&r, e), "a dependency is build.dep(name, version), or build.dep(name, version, hash)");
                    } else {
                        var hash = alloc.String.init(a);
                        if args == 4 {
                            hash = string_value(&r, child(&r, child(&r, e, 3), 0), diags: diags, a: a);
                        }
                        m.dependencies.push(Dependency {
                            name: string_value(&r, child(&r, child(&r, e, 1), 0), diags: diags, a: a),
                            version: string_value(&r, child(&r, child(&r, e, 2), 0), diags: diags, a: a),
                            hash: hash,
                        });
                    }
                }
            }
        } else if name.eq("strict_unsafe") {
            let t = joined(&r, v, a);
            if t.view().eq("true") {
                m.strict_unsafe = true;
            } else if not t.view().eq("false") {
                diags.report(codes.BAD_MANIFEST, span_of(&r, v), "strict_unsafe is true or false");
            }
        } else if name.eq("panic_handler") {
            m.panic_handler = string_value(&r, v, diags: diags, a: a);
        } else if name.eq("registry") {
            m.registry = string_value(&r, v, diags: diags, a: a);
        } else if name.eq("registry_key") {
            m.registry_key = string_value(&r, v, diags: diags, a: a);
        } else {
            var msg = diags.new_message();
            msg.push_str("a manifest has no field '");
            msg.push_str(name);
            msg.push_str("'; its fields are name, version, edition, needs, dependencies, registry, registry_key, strict_unsafe and panic_handler");
            diags.report_owned(codes.BAD_MANIFEST, span_of(&r, f), msg);
        }
    }
    if not has_name {
        diags.report(codes.BAD_MANIFEST, span_of(&r, value), "a manifest names its package: name: \"...\"");
    }
    return m;
}

/// Reads build.arche's BUILD: the programs, each build.program(name, root).
pub fn read_build(tree: cst.Tree, text: str, diags: &mut diag.Diagnostics, a: alloc.Allocator) -> alloc.List(Program) {
    let r = parse(tree, text, a);
    var programs = alloc.List(Program).init(a);
    var value = cst.NodeId { index: 0 };
    match constant(&r, "BUILD") {
        some(v) => { value = v; }
        none => {
            diags.report(codes.BAD_MANIFEST, diag.Span { start: 0, len: 0 }, "build.arche declares const BUILD: build.Build = build.Build { programs: [...] };");
            return programs;
        }
    }
    var fields = alloc.List(cst.NodeId).init(a);
    match struct_fields(&r, value, type_name: "build.Build", diags: diags, a: a) {
        some(f) => { fields = f; }
        none => { return programs; }
    }
    let fs = fields.items();
    var i: usize = 0;
    while i < fs.len() : (i += 1) {
        let f = fs[i];
        if node(&r, f).children_len == 0 {
            continue;
        }
        let v = child(&r, f, 0);
        if not field_name(&r, f).eq("programs") or node(&r, v).kind != cst.Kind.ArrayLit {
            diags.report(codes.BAD_MANIFEST, span_of(&r, f), "a build has programs: [build.program(name, root), ...]");
            continue;
        }
        var k: u32 = 0;
        while k < node(&r, v).children_len : (k += 1) {
            let e = child(&r, v, k);
            if node(&r, e).kind != cst.Kind.CallExpr or node(&r, e).children_len != 3 or
                not joined(&r, child(&r, e, 0), a).view().eq("build.program") {
                diags.report(codes.BAD_MANIFEST, span_of(&r, e), "a program is build.program(name, root)");
            } else {
                programs.push(Program {
                    name: string_value(&r, child(&r, child(&r, e, 1), 0), diags: diags, a: a),
                    root: string_value(&r, child(&r, child(&r, e, 2), 0), diags: diags, a: a),
                });
            }
        }
    }
    return programs;
}
