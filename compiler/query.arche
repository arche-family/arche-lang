/// arche query (docs/sprints.md S23): what a name at a place in the root
/// file is. The checker keeps every use of a name with the declaration it
/// refers to (sema.check.Use); a query reads them.
///
///     def      where the name is declared
///     refs     the declaration and every use, in every module
///     type     the type of the innermost expression there
///     callers  the calls of the function named there, with the function
///              each is in
///     hover    the declaration's signature and comment, and the type there
///
/// With --json each answer is a JSON value: a list of places for def, refs
/// and callers, an object for type and hover. A file with type errors still
/// gets answers: what the checker could work out.
import std;
import alloc;
import diag;
import doc;
import program;
import sema.check as ck;
import syntax.cst;
import syntax.token as tk;

/// A place: a token of a module.
type Place = struct {
    module: u32,
    token: u32,
}

/// The offset of a line and a column (both from 1, the column in bytes).
pub fn offset_of(text: str, line: u32, column: u32) -> ?u32 {
    var l: u32 = 1;
    var i: usize = 0;
    while l < line and i < text.len() : (i += 1) {
        if text[i] == '\n' {
            l += 1;
        }
    }
    if l != line {
        return none;
    }
    let at = i + (column as usize) - 1;
    if column == 0 or at > text.len() {
        return none;
    }
    return at as u32;
}

/// The identifier at an offset, or just before it (a cursor after a name).
fn token_at(c: &ck.Checker, module: u32, offset: u32) -> ?u32 {
    let tree = &c.p.modules[module as usize].tree;
    let ts = tree.tokens.items();
    var i: usize = 0;
    while i < ts.len() : (i += 1) {
        let t = ts[i];
        if t.kind == tk.Kind.Ident and t.start <= offset and offset <= t.start + t.len {
            return i as u32;
        }
    }
    return none;
}

/// What the token names: a use's declaration, or the token itself.
fn target_of(c: &ck.Checker, at: Place) -> Place {
    let us = c.uses.items();
    var i: usize = 0;
    while i < us.len() : (i += 1) {
        if us[i].module == at.module and us[i].token == at.token {
            return Place { module: us[i].decl_module, token: us[i].decl_token };
        }
    }
    return at;
}

fn write_place(out: &mut std.Output, c: &ck.Checker, at: Place) {
    let m = &c.p.modules[at.module as usize];
    let t = m.tree.tokens[at.token as usize];
    let pos = diag.position(m.text.view(), t.start);
    out.write(m.path.view());
    out.write(":");
    out.write_u64(pos.line as u64);
    out.write(":");
    out.write_u64(pos.column as u64);
}

/// The function a token is in, by name, or "".
fn enclosing_fn(c: &ck.Checker, at: Place) -> str {
    let m = &c.p.modules[at.module as usize];
    let nodes = m.tree.nodes.items();
    var best: u32 = ck.NONE;
    var best_size: u32 = 0;
    var i: usize = 0;
    while i < nodes.len() : (i += 1) {
        let n = nodes[i];
        if n.kind == cst.Kind.FnDecl and n.first <= at.token and at.token < n.end {
            if best == ck.NONE or n.end - n.first < best_size {
                best = i as u32;
                best_size = n.end - n.first;
            }
        }
    }
    if best == ck.NONE {
        return "";
    }
    // The function's name: the first identifier after `fn`.
    let n = nodes[best as usize];
    var seen_fn = false;
    var t = n.first;
    while t < n.end : (t += 1) {
        let k = m.tree.tokens[t as usize].kind;
        if k == tk.Kind.KwFn {
            seen_fn = true;
        } else if seen_fn and k == tk.Kind.Ident {
            return m.token_text(t);
        }
    }
    return "";
}

/// The places that name the target, the declaration first, each once, in
/// module and token order.
fn references(c: &ck.Checker, target: Place, a: alloc.Allocator) -> alloc.List(Place) {
    var found = alloc.List(Place).init(a);
    let us = c.uses.items();
    var u: usize = 0;
    while u < us.len() : (u += 1) {
        if us[u].decl_module == target.module and us[u].decl_token == target.token {
            let p = Place { module: us[u].module, token: us[u].token };
            var seen = p.module == target.module and p.token == target.token;
            var q: usize = 0;
            while q < found.len() : (q += 1) {
                if found[q].module == p.module and found[q].token == p.token {
                    seen = true;
                }
            }
            if not seen {
                found.push(p);
            }
        }
    }
    // Insertion sort, by module, then token.
    let fs = found.items_mut();
    var i: usize = 1;
    while i < fs.len() : (i += 1) {
        var k = i;
        while k > 0 and (fs[k - 1].module > fs[k].module or (fs[k - 1].module == fs[k].module and fs[k - 1].token > fs[k].token)) : (k -= 1) {
            let x = fs[k - 1];
            fs[k - 1] = fs[k];
            fs[k] = x;
        }
    }
    return found;
}

/// The type of the innermost expression at the token, or invalid.
fn type_at(c: &ck.Checker, at: Place) -> ?u32 {
    let m = &c.p.modules[at.module as usize];
    let nodes = m.tree.nodes.items();
    let types = c.node_types[at.module as usize].items();
    var best: u32 = ck.NONE;
    var best_size: u32 = 0;
    var i: usize = 0;
    while i < nodes.len() and i < types.len() : (i += 1) {
        let n = nodes[i];
        if n.first <= at.token and at.token < n.end and types[i].index != 0 {
            if best == ck.NONE or n.end - n.first < best_size {
                best = i as u32;
                best_size = n.end - n.first;
            }
        }
    }
    if best == ck.NONE {
        return none;
    }
    return best;
}

/// A place as JSON: its start and end.
fn write_json_place(out: &mut std.Output, c: &ck.Checker, at: Place) {
    let m = &c.p.modules[at.module as usize];
    let t = m.tree.tokens[at.token as usize];
    let from = diag.position(m.text.view(), t.start);
    let to = diag.position(m.text.view(), t.start + t.len);
    out.write("{\"file\": ");
    diag.write_json_string(out, m.path.view());
    out.write(", \"line\": ");
    out.write_u64(from.line as u64);
    out.write(", \"column\": ");
    out.write_u64(from.column as u64);
    out.write(", \"end_line\": ");
    out.write_u64(to.line as u64);
    out.write(", \"end_column\": ");
    out.write_u64(to.column as u64);
}

fn write_places(out: &mut std.Output, c: &ck.Checker, target: Place, refs: &alloc.List(Place), with_fn: bool) {
    out.write("[");
    var wrote = false;
    if not with_fn {
        write_json_place(out, c, at: target);
        out.write(", \"declared\": true}");
        wrote = true;
    }
    let rs = refs.items();
    var i: usize = 0;
    while i < rs.len() : (i += 1) {
        if wrote {
            out.write(", ");
        }
        write_json_place(out, c, at: rs[i]);
        if with_fn {
            out.write(", \"in\": ");
            diag.write_json_string(out, enclosing_fn(c, rs[i]));
        }
        out.write("}");
        wrote = true;
    }
    out.write("]\n");
}

/// The first identifier of a node: the name of what it declares.
fn first_name(m: &program.Module, n: cst.Node) -> u32 {
    var t = n.first;
    while t < n.end : (t += 1) {
        if m.tree.tokens[t as usize].kind == tk.Kind.Ident {
            return t;
        }
    }
    return ck.NONE;
}

/// The declaration a token names, as its node, if it has a signature worth
/// showing: a function, a type, a constant, a field, a variant, a parameter.
fn declaration_of(m: &program.Module, token: u32) -> ?u32 {
    let nodes = m.tree.nodes.items();
    var i: usize = 0;
    while i < nodes.len() : (i += 1) {
        let k = nodes[i].kind;
        if k == cst.Kind.FnDecl or k == cst.Kind.TypeDecl or k == cst.Kind.ConstDecl or k == cst.Kind.FieldDecl or k == cst.Kind.Variant or k == cst.Kind.Param {
            if first_name(m, n: nodes[i]) == token {
                return i as u32;
            }
        }
    }
    return none;
}

/// The hover text of a name: its signature, comment and type.
fn hover(out: &mut std.Output, c: &ck.Checker, at: Place, target: Place, json: bool, a: alloc.Allocator) {
    var signature = alloc.String.init(a);
    var comment = alloc.String.init(a);
    let m = &c.p.modules[target.module as usize];
    match declaration_of(m, token: target.token) {
        some(n) => {
            let id = cst.NodeId { index: n };
            doc.signature(m, id, out: &mut signature);
            let lines = doc.doc_before(m, at: m.tree.first_token(id), a: a);
            let ls = lines.items();
            var i: usize = 0;
            while i < ls.len() : (i += 1) {
                comment.push_str(ls[i].view());
                comment.push_str("\n");
            }
        }
        none => { }
    }
    var type_text = alloc.String.init(a);
    match type_at(c, at) {
        some(n) => { ck.write_type(c, &mut type_text, c.node_types[at.module as usize][n as usize]); }
        none => { }
    }
    if json {
        out.write("{\"signature\": ");
        diag.write_json_string(out, signature.view());
        out.write(", \"doc\": ");
        diag.write_json_string(out, comment.view());
        out.write(", \"type\": ");
        diag.write_json_string(out, type_text.view());
        out.write("}\n");
        return;
    }
    if signature.len() > 0 {
        out.write(signature.view());
        out.write("\n");
    }
    out.write(comment.view());
    if signature.len() == 0 {
        out.write(type_text.view());
        out.write("\n");
    }
}

/// Runs a query; false when there is nothing at the place.
pub fn run(out: &mut std.Output, err_out: &mut std.Output, c: &ck.Checker, what: str, line: u32, column: u32, json: bool, a: alloc.Allocator) -> bool {
    let root: u32 = 0;
    var offset: u32 = 0;
    match offset_of(c.p.modules[root as usize].text.view(), line: line, column: column) {
        some(o) => { offset = o; }
        none => {
            err_out.write("arche query: the file has no such line and column\n");
            return false;
        }
    }
    var token: u32 = 0;
    match token_at(c, module: root, offset: offset) {
        some(t) => { token = t; }
        none => {
            err_out.write("arche query: there is no name there\n");
            return false;
        }
    }
    let at = Place { module: root, token: token };
    let target = target_of(c, at);
    if what.eq("def") {
        if json {
            out.write("[");
            write_json_place(out, c, at: target);
            out.write("}]\n");
            return true;
        }
        write_place(out, c, target);
        out.write("\n");
        return true;
    }
    if what.eq("refs") {
        let refs = references(c, target, a);
        if json {
            write_places(out, c, target: target, refs: &refs, with_fn: false);
            return true;
        }
        write_place(out, c, target);
        out.write(": declared\n");
        var i: usize = 0;
        while i < refs.len() : (i += 1) {
            write_place(out, c, refs[i]);
            out.write("\n");
        }
        return true;
    }
    if what.eq("callers") {
        var is_fn = false;
        let ds = c.decls.items();
        var i: usize = 0;
        while i < ds.len() : (i += 1) {
            if ds[i].module == target.module and ds[i].name_token == target.token and ds[i].kind == ck.DeclKind.Fn {
                is_fn = true;
            }
        }
        if not is_fn {
            err_out.write("arche query: that is not a function\n");
            return false;
        }
        let refs = references(c, target, a);
        if json {
            write_places(out, c, target: target, refs: &refs, with_fn: true);
            return true;
        }
        var k: usize = 0;
        while k < refs.len() : (k += 1) {
            write_place(out, c, refs[k]);
            let f = enclosing_fn(c, refs[k]);
            if f.len() > 0 {
                out.write(": in ");
                out.write(f);
            }
            out.write("\n");
        }
        return true;
    }
    if what.eq("type") {
        match type_at(c, at) {
            some(n) => {
                var text = alloc.String.init(a);
                ck.write_type(c, &mut text, c.node_types[root as usize][n as usize]);
                if json {
                    out.write("{\"type\": ");
                    diag.write_json_string(out, text.view());
                    out.write("}\n");
                } else {
                    out.write(text.view());
                    out.write("\n");
                }
                return true;
            }
            none => {
                err_out.write("arche query: no expression with a type there\n");
                return false;
            }
        }
    }
    if what.eq("hover") {
        hover(out, c, at: at, target: target, json: json, a: a);
        return true;
    }
    err_out.write("arche query: def, refs, type, callers or hover\n");
    return false;
}
