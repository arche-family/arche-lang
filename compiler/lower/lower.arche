/// Lowering: a checked program becomes an IR module (sprint S8).
///
/// Every binding has a stack slot, or for a composite parameter the address
/// the caller passed; scalars are loaded from slots and stored back, and
/// LLVM's mem2reg turns the slots into registers. A composite value is the
/// address of memory holding it: a fresh temporary, or a place. Before a
/// composite value from a place is passed on, it is copied, so that a later
/// argument cannot change it (§7.3).
import alloc;
import diag;
import program;
import syntax.cst;
import syntax.token as tk;
import ir.ir;
import lower.layout;
import lower.expr;
import lower.stmt;
import sema.check as ck;
import sema.types as ty;

pub type Var = struct {
    pub name: alloc.Symbol,
    /// The address of the binding's value.
    pub addr: u32,
    pub type_id: ty.TypeId,
}

pub type LoopCtx = struct {
    pub break_block: u32,
    pub continue_block: u32,
    /// defers.len() when the loop began: break and continue run the ones after.
    pub defer_depth: u32,
    /// Its label (spec/arche.md §3.4), or the empty name.
    pub label: alloc.Symbol,
}

/// A value: a scalar in an IR value, or the address of a composite one.
/// `fresh` says that the memory is a temporary nothing else refers to.
pub type Val = struct {
    pub v: u32,
    pub scalar: bool,
    pub fresh: bool,
}

pub type Lower = struct {
    pub c: ck.Checker,
    pub m: ir.Module,
    pub f: ir.Function,
    pub block: u32,
    pub vars: alloc.List(Var),
    pub defers: alloc.List(cst.NodeId),
    pub loops: alloc.List(LoopCtx),
    pub fn_index: u32,
    /// The address the result is written to, for a composite result.
    pub sret: u32,
    pub ret: ty.TypeId,
    /// impl number -> its method table in m.vtables.
    pub vtables: alloc.Map(u32, u32),
    /// The ensures conditions of the function being lowered (§8.1).
    pub post_conditions: alloc.List(cst.NodeId),
    /// For debug info (the compiler's own backend): the line being lowered,
    /// each module's file in m.files and where its lines start, the types
    /// told of so far, and whether a binding is a parameter.
    pub debug: bool,
    pub line: u32,
    pub module_files: alloc.List(u32),
    pub line_starts: alloc.List(alloc.List(u32)),
    pub debug_types: alloc.Map(ty.TypeId, u32),
    pub binding_param: bool,
    pub a: alloc.Allocator,
}

// ---- building IR ---------------------------------------------------------------

pub fn emit(l: &mut Lower, i: ir.Inst) -> u32 {
    let id = l.f.insts.len() as u32;
    var placed = i;
    placed.line = l.line;
    l.f.insts.push(placed);
    l.f.blocks[l.block as usize].insts.push(id);
    return id;
}

pub fn konst(l: &mut Lower, t: ir.Ty, v: u64) -> u32 {
    var i = ir.inst(ir.Op.Const, t);
    i.imm = v;
    return emit(l, i);
}

pub fn alloca(l: &mut Lower, t: ty.TypeId) -> u32 {
    let lay = layout.layout(&l.c, t);
    return alloca_bytes(l, size: lay.size, align: lay.align);
}

pub fn alloca_bytes(l: &mut Lower, size: u64, align: u64) -> u32 {
    var i = ir.inst(ir.Op.Alloca, ir.Ty.Ptr);
    var n = size;
    if n == 0 {
        n = 1;
    }
    i.imm = n;
    i.flag = align as u32;
    let p = emit(l, i);
    var z = ir.inst(ir.Op.Memzero, ir.Ty.Void);
    z.a = p;
    z.imm = n;
    _ = emit(l, z);
    return p;
}

pub fn load(l: &mut Lower, t: ir.Ty, addr: u32) -> u32 {
    var i = ir.inst(ir.Op.Load, t);
    i.a = addr;
    return emit(l, i);
}

/// A load or store with ir.LOAD_VOLATILE or ir.LOAD_UNALIGNED.
pub fn load_with(l: &mut Lower, t: ir.Ty, addr: u32, flags: u32) -> u32 {
    var i = ir.inst(ir.Op.Load, t);
    i.a = addr;
    i.flag = flags;
    return emit(l, i);
}

pub fn store_with(l: &mut Lower, value: u32, addr: u32, flags: u32) {
    var i = ir.inst(ir.Op.Store, ir.Ty.Void);
    i.a = value;
    i.b = addr;
    i.flag = flags;
    _ = emit(l, i);
}

pub fn store(l: &mut Lower, value: u32, addr: u32) {
    var i = ir.inst(ir.Op.Store, ir.Ty.Void);
    i.a = value;
    i.b = addr;
    _ = emit(l, i);
}

pub fn gep(l: &mut Lower, addr: u32, offset: u64) -> u32 {
    if offset == 0 {
        return addr;
    }
    var i = ir.inst(ir.Op.Gep, ir.Ty.Ptr);
    i.a = addr;
    i.imm = offset;
    return emit(l, i);
}

/// A field's address in a packed struct: always a Gep, marked unaligned.
pub fn gep_unaligned(l: &mut Lower, addr: u32, offset: u64) -> u32 {
    var i = ir.inst(ir.Op.Gep, ir.Ty.Ptr);
    i.a = addr;
    i.imm = offset;
    i.flag = ir.LOAD_UNALIGNED;
    return emit(l, i);
}

pub fn gep_index(l: &mut Lower, addr: u32, index: u32, size: u64) -> u32 {
    var i = ir.inst(ir.Op.GepIndex, ir.Ty.Ptr);
    i.a = addr;
    i.b = index;
    i.imm = size;
    return emit(l, i);
}

pub fn memcpy(l: &mut Lower, dst: u32, src: u32, size: u64) {
    if size == 0 {
        return;
    }
    var i = ir.inst(ir.Op.Memcpy, ir.Ty.Void);
    i.a = dst;
    i.b = src;
    i.imm = size;
    _ = emit(l, i);
}

pub fn bin(l: &mut Lower, k: ir.BinKind, x: u32, y: u32) -> u32 {
    var i = ir.inst(ir.Op.Bin, l.f.insts[x as usize].ty);
    i.a = x;
    i.b = y;
    i.flag = bin_code(k);
    return emit(l, i);
}

fn bin_code(k: ir.BinKind) -> u32 {
    match k {
        .Add => { return 0; }
        .Sub => { return 1; }
        .Mul => { return 2; }
        .SDiv => { return 3; }
        .UDiv => { return 4; }
        .SRem => { return 5; }
        .URem => { return 6; }
        .And => { return 7; }
        .Or => { return 8; }
        .Xor => { return 9; }
        .Shl => { return 10; }
        .LShr => { return 11; }
        .AShr => { return 12; }
    }
}

pub fn cmp(l: &mut Lower, k: ir.CmpKind, x: u32, y: u32) -> u32 {
    var i = ir.inst(ir.Op.Cmp, ir.Ty.I1);
    i.a = x;
    i.b = y;
    match k {
        .Eq => { i.flag = 0; }
        .Ne => { i.flag = 1; }
        .SLt => { i.flag = 2; }
        .SLe => { i.flag = 3; }
        .SGt => { i.flag = 4; }
        .SGe => { i.flag = 5; }
        .ULt => { i.flag = 6; }
        .ULe => { i.flag = 7; }
        .UGt => { i.flag = 8; }
        .UGe => { i.flag = 9; }
    }
    return emit(l, i);
}

/// x op y with a check: the wrapped result, and an i1 that says whether it
/// overflowed.
pub fn overflow(l: &mut Lower, k: ir.OverflowKind, x: u32, y: u32) -> u32 {
    var i = ir.inst(ir.Op.Overflow, l.f.insts[x as usize].ty);
    i.a = x;
    i.b = y;
    match k {
        .SAdd => { i.flag = 0; }
        .UAdd => { i.flag = 1; }
        .SSub => { i.flag = 2; }
        .USub => { i.flag = 3; }
        .SMul => { i.flag = 4; }
        .UMul => { i.flag = 5; }
    }
    return emit(l, i);
}

pub fn overflow_bit(l: &mut Lower, o: u32) -> u32 {
    var i = ir.inst(ir.Op.OverflowBit, ir.Ty.I1);
    i.a = o;
    return emit(l, i);
}

/// Converts an integer to type t: truncates, or extends with the sign
/// when `signed`.
pub fn convert(l: &mut Lower, x: u32, t: ir.Ty, signed: bool) -> u32 {
    let from = l.f.insts[x as usize].ty;
    if from == t {
        return x;
    }
    if ir.bits(from) > ir.bits(t) {
        var i = ir.inst(ir.Op.Trunc, t);
        i.a = x;
        return emit(l, i);
    }
    var i = ir.inst(ir.Op.Ext, t);
    i.a = x;
    if signed {
        i.flag = 1;
    }
    return emit(l, i);
}

/// An i1 as 0 or 1 of type t.
pub fn lconvert(l: &mut Lower, x: u32, t: ir.Ty) -> u32 {
    return convert(l, x, t, false);
}

pub fn new_block(l: &mut Lower) -> u32 {
    l.f.blocks.push(ir.Block { insts: alloc.List(u32).init(l.a) });
    return l.f.blocks.len() as u32 - 1;
}

pub fn switch_to(l: &mut Lower, b: u32) {
    l.block = b;
}

/// The current block already ends in a terminator.
pub fn terminated(l: &Lower) -> bool {
    let ids = l.f.blocks[l.block as usize].insts.items();
    return ids.len() > 0 and ir.is_terminator(l.f.insts[ids[ids.len() - 1] as usize].op);
}

pub fn br(l: &mut Lower, target: u32) {
    if terminated(l) {
        return;
    }
    var i = ir.inst(ir.Op.Br, ir.Ty.Void);
    i.a = target;
    _ = emit(l, i);
}

pub fn cond_br(l: &mut Lower, cond: u32, yes: u32, no: u32) {
    var i = ir.inst(ir.Op.CondBr, ir.Ty.Void);
    i.a = cond;
    i.b = yes;
    i.c = no;
    _ = emit(l, i);
}

/// After a terminator: code that follows goes to a new block, which nothing
/// reaches.
pub fn after_terminator(l: &mut Lower) {
    let b = new_block(l);
    switch_to(l, b);
}

fn record_params(l: &mut Lower, e: u32, args: &alloc.List(u32)) {
    if l.m.externals[e as usize].params.len() > 0 or args.len() == 0 {
        return;
    }
    let items = args.items();
    var i: usize = 0;
    while i < items.len() : (i += 1) {
        let t = l.f.insts[items[i] as usize].ty;
        l.m.externals[e as usize].params.push(t);
    }
}

/// Calls a runtime function; its parameter types are those of the first
/// call.
pub fn call_runtime(l: &mut Lower, name: str, ret: ir.Ty, args: &alloc.List(u32)) -> u32 {
    let never = name.eq("a0rt_trap");
    let e = l.m.external(name, ret, never);
    record_params(l, e, args);
    return call_with(l, e, true, ret, args);
}

pub fn call_with(l: &mut Lower, callee: u32, external: bool, ret: ir.Ty, args: &alloc.List(u32)) -> u32 {
    var i = ir.inst(ir.Op.Call, ret);
    i.imm = callee as u64;
    if external {
        i.flag = 1;
    }
    i.args_start = l.f.args.len() as u32;
    let items = args.items();
    var k: usize = 0;
    while k < items.len() : (k += 1) {
        l.f.args.push(items[k]);
    }
    i.args_len = items.len() as u32;
    return emit(l, i);
}

/// A call through a function's address: a method of a &dyn I.
pub fn call_indirect(l: &mut Lower, callee: u32, ret: ir.Ty, args: &alloc.List(u32)) -> u32 {
    var i = ir.inst(ir.Op.CallIndirect, ret);
    i.a = callee;
    i.args_start = l.f.args.len() as u32;
    let items = args.items();
    var k: usize = 0;
    while k < items.len() : (k += 1) {
        l.f.args.push(items[k]);
    }
    i.args_len = items.len() as u32;
    return emit(l, i);
}

/// The table of a closure as a &dyn fn(P) -> R: its body alone.
pub fn closure_vtable(l: &mut Lower, ci: u32) -> u32 {
    let key = ci | 0x80000000;
    match l.vtables.get(key) {
        some(v) => { return v; }
        none => { }
    }
    var fns = alloc.List(u32).init(l.a);
    fns.push(l.c.closures[ci as usize].fn_index);
    var name = alloc.String.init(l.a);
    name.push_str("a0vc_");
    ir.write_number(&mut name, ci as u64);
    let id = l.m.vtables.len() as u32;
    // The captures' size, so a task can copy the closure (lib/std/task.arche).
    let closure_t = l.c.t.declared(ty.Kind.Closure, ci);
    let size = layout.layout(&l.c, closure_t).size;
    l.m.vtables.push(ir.VTable { name: name, functions: fns, size: size + 1 });
    l.vtables.put(key, id);
    return id;
}

/// The method table of impl i: its methods in the order of its interface's
/// (spec/arche.md §5.3), made once.
pub fn vtable(l: &mut Lower, i: u32) -> u32 {
    match l.vtables.get(i) {
        some(v) => { return v; }
        none => { }
    }
    let im = l.c.impls[i as usize];
    let iface = l.c.decls[im.iface as usize];
    var fns = alloc.List(u32).init(l.a);
    var k = iface.methods_start;
    while k < iface.methods_start + iface.methods_len : (k += 1) {
        let name = l.c.decls[l.c.methods[k as usize] as usize].name;
        let d = ck.impl_method(&l.c, im.target, im.iface, name);
        fns.push(l.c.decls[d as usize].fn_index);
    }
    var name = alloc.String.init(l.a);
    name.push_str("a0vt_");
    ir.write_number(&mut name, i as u64);
    let id = l.m.vtables.len() as u32;
    l.m.vtables.push(ir.VTable { name: name, functions: fns, size: 0 });
    l.vtables.put(i, id);
    return id;
}

pub fn args0(l: &Lower) -> alloc.List(u32) {
    return alloc.List(u32).init(l.a);
}

// ---- traps -------------------------------------------------------------------

/// A str value {ptr, len} of constant bytes, in a temporary.
pub fn str_global(l: &mut Lower, bytes: str) -> Val {
    let g = l.m.global(bytes);
    var gi = ir.inst(ir.Op.Global, ir.Ty.Ptr);
    gi.imm = g as u64;
    let p = emit(l, gi);
    let tmp = alloca(l, ty.str_type());
    store(l, value: p, addr: tmp);
    let n = konst(l, ir.Ty.I64, bytes.len() as u64);
    store(l, value: n, addr: gep(l, tmp, 8));
    return Val { v: tmp, scalar: false, fresh: true };
}

/// Where a trap points: the operator of an operation, `[` of an index,
/// `as` of a conversion, `match` of a match; the start of a call.
pub fn op_token(l: &Lower, n: cst.NodeId) -> u32 {
    let k = ck.kind_of(&l.c, n);
    if k == cst.Kind.CallExpr or k == cst.Kind.Arg {
        return ck.tree(&l.c).first_token(n);
    }
    let toks = ck.own(&l.c, n);
    if toks.len() == 0 {
        return ck.tree(&l.c).first_token(n);
    }
    return toks[0];
}

/// Stops the program with "panic: <message>" and where the token is (§10).
/// The location of node n as runtime arguments: file, its length, line
/// and column.
pub fn location_args(l: &mut Lower, n: cst.NodeId, args: &mut alloc.List(u32), at_start: bool) {
    var tok = op_token(l, n);
    if at_start {
        tok = ck.tree(&l.c).first_token(n);
    }
    let m = &l.c.p.modules[l.c.module as usize];
    var file = alloc.String.init(l.a);
    file.push_str(m.display.view());
    let at = m.tree.token(tok).start;
    let pos = diag.position(m.text.view(), at);
    let fg = l.m.global(file.view());
    var gi = ir.inst(ir.Op.Global, ir.Ty.Ptr);
    gi.imm = fg as u64;
    let fp = emit(l, gi);
    args.push(fp);
    args.push(konst(l, ir.Ty.I64, file.len() as u64));
    args.push(konst(l, ir.Ty.I32, pos.line as u64));
    args.push(konst(l, ir.Ty.I32, pos.column as u64));
}

/// Records n in the error return trace (spec/arche.md §8.3): `start` for
/// where an error is made, else a `try` that passes it up.
pub fn trace(l: &mut Lower, n: cst.NodeId, start: bool) {
    if not ck.full(&l.c) {
        return;
    }
    var args = args0(l);
    location_args(l, n, &mut args, at_start: start);
    if start {
        _ = call_runtime(l, "a0rt_trace_start", ir.Ty.Void, &args);
    } else {
        _ = call_runtime(l, "a0rt_trace_push", ir.Ty.Void, &args);
    }
}

pub fn trap_with(l: &mut Lower, message_ptr: u32, message_len: u32, n: cst.NodeId) {
    var args = args0(l);
    args.push(message_ptr);
    args.push(message_len);
    location_args(l, n, &mut args, at_start: false);
    _ = call_runtime(l, "a0rt_trap", ir.Ty.Void, &args);
    _ = emit(l, ir.inst(ir.Op.Unreachable, ir.Ty.Void));
    after_terminator(l);
}

pub fn trap(l: &mut Lower, message: str, n: cst.NodeId) {
    let g = l.m.global(message);
    var gi = ir.inst(ir.Op.Global, ir.Ty.Ptr);
    gi.imm = g as u64;
    let p = emit(l, gi);
    let len = konst(l, ir.Ty.I64, message.len() as u64);
    trap_with(l, message_ptr: p, message_len: len, n);
}

/// Traps with the message unless fine holds.
pub fn check(l: &mut Lower, fine: u32, message: str, n: cst.NodeId) {
    let fail = new_block(l);
    let cont = new_block(l);
    cond_br(l, cond: fine, yes: cont, no: fail);
    switch_to(l, fail);
    trap(l, message, n);
    br(l, cont);
    switch_to(l, cont);
}

// ---- values ----------------------------------------------------------------------

/// The value of type t stored at addr.
/// A load or store at an address of a packed struct's field is unaligned:
/// the Gep that made it has LOAD_UNALIGNED in its flag.
fn access_flags(l: &Lower, addr: u32) -> u32 {
    let i = l.f.insts[addr as usize];
    if i.op == ir.Op.Gep or i.op == ir.Op.Alloca {
        return i.flag & ir.LOAD_UNALIGNED;
    }
    return 0;
}

pub fn load_val(l: &mut Lower, t: ty.TypeId, addr: u32) -> Val {
    let s = layout.scalar(&l.c, t);
    if s != ir.Ty.Void {
        let flags = access_flags(l, addr);
        if flags != 0 and l.f.insts[addr as usize].op == ir.Op.Gep {
            return Val { v: load_with(l, s, addr: addr, flags: flags), scalar: true, fresh: true };
        }
        return Val { v: load(l, s, addr), scalar: true, fresh: true };
    }
    return Val { v: addr, scalar: false, fresh: false };
}

/// Stores value v of type t at addr.
pub fn store_val(l: &mut Lower, t: ty.TypeId, v: Val, addr: u32) {
    if layout.is_nothing(&l.c, t) {
        return;
    }
    if v.scalar {
        let flags = access_flags(l, addr);
        if flags != 0 and l.f.insts[addr as usize].op == ir.Op.Gep {
            store_with(l, value: v.v, addr: addr, flags: flags);
            return;
        }
        store(l, value: v.v, addr: addr);
        return;
    }
    let size = layout.layout(&l.c, t).size;
    memcpy(l, dst: addr, src: v.v, size);
}

/// A value nothing else refers to: a composite read from a place is copied.
pub fn own_val(l: &mut Lower, t: ty.TypeId, v: Val) -> Val {
    if v.scalar or v.fresh {
        return v;
    }
    let tmp = alloca(l, t);
    store_val(l, t, v, tmp);
    return Val { v: tmp, scalar: false, fresh: true };
}

/// How a value of type t is passed to a call: a scalar, or the address of
/// a composite (docs/abi.md).
pub fn as_arg(l: &mut Lower, t: ty.TypeId, v: Val) -> u32 {
    return own_val(l, t, v).v;
}

/// The IR type a function returns: composite results go through memory.
pub fn ret_ty(c: &ck.Checker, t: ty.TypeId) -> ir.Ty {
    if layout.is_nothing(c, t) {
        return ir.Ty.Void;
    }
    let s = layout.scalar(c, t);
    if s == ir.Ty.Void {
        return ir.Ty.Void;
    }
    return s;
}

pub fn returns_in_memory(c: &ck.Checker, t: ty.TypeId) -> bool {
    return not layout.is_nothing(c, t) and not layout.is_scalar(c, t);
}

pub fn param_ty(c: &ck.Checker, t: ty.TypeId) -> ir.Ty {
    let s = layout.scalar(c, t);
    if s == ir.Ty.Void {
        return ir.Ty.Ptr;
    }
    return s;
}

pub fn find_var(l: &Lower, name: alloc.Symbol) -> ?Var {
    var i = l.vars.len();
    while i > 0 : (i -= 1) {
        if l.vars[i - 1].name == name {
            return l.vars[i - 1];
        }
    }
    return none;
}

pub fn bind(l: &mut Lower, name: alloc.Symbol, addr: u32, t: ty.TypeId) {
    l.vars.push(Var { name: name, addr: addr, type_id: t });
    if l.debug {
        var n = alloc.String.init(l.a);
        n.push_str(l.c.names.text(name));
        let index = debug_type(l, t);
        l.f.vars.push(ir.DebugVar { name: n, addr: addr, type_index: index, line: l.line, is_param: l.binding_param });
    }
}

// ---- debug info --------------------------------------------------------------------

/// The line of a byte of the current module's text.
fn line_at(l: &mut Lower, offset: u32) -> u32 {
    let module = l.c.module as usize;
    while l.line_starts.len() <= module {
        l.line_starts.push(alloc.List(u32).init(l.a));
    }
    if l.line_starts[module].len() == 0 {
        l.line_starts[module].push(0);
        let text = l.c.p.modules[module].text.view();
        var i: usize = 0;
        while i < text.len() : (i += 1) {
            if text[i] == '\n' {
                l.line_starts[module].push(i as u32 + 1);
            }
        }
    }
    let starts = l.line_starts[module].items();
    var lo: usize = 0;
    var hi = starts.len();
    while lo + 1 < hi {
        let mid = (lo + hi) / 2;
        if starts[mid] <= offset {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    return lo as u32 + 1;
}

/// What is lowered from here on comes from n's line.
pub fn at_line(l: &mut Lower, n: cst.NodeId) {
    if l.debug {
        let tok = ck.tree(&l.c).first_token(n);
        let at = l.c.p.modules[l.c.module as usize].tree.token(tok).start;
        l.line = line_at(l, offset: at);
    }
}

/// The current module's file, in the module's list of them.
fn file_of_module(l: &mut Lower) -> u32 {
    let module = l.c.module as usize;
    while l.module_files.len() <= module {
        l.module_files.push(ir.NO_FILE);
    }
    if l.module_files[module] == ir.NO_FILE {
        // A file as it was opened. The library's is by its own name: where
        // the library is depends on where the compiler is, and a build is
        // to be the same wherever that is.
        var path = alloc.String.init(l.a);
        if l.c.p.modules[module].package == program.NO_PACKAGE {
            path.push_str(l.c.p.modules[module].display.view());
        } else {
            path.push_str(l.c.p.modules[module].path.view());
        }
        l.m.files.push(path);
        l.module_files[module] = l.m.files.len() as u32 - 1;
    }
    return l.module_files[module];
}

/// The function being lowered, for its debug info.
fn debug_function(l: &mut Lower, name: str, name_token: u32) {
    if not l.debug {
        return;
    }
    l.f.file = file_of_module(l);
    l.f.source_name.push_str(name);
    if name_token != ck.NONE {
        let at = l.c.p.modules[l.c.module as usize].tree.token(name_token).start;
        l.f.line = line_at(l, offset: at);
        l.line = l.f.line;
    }
}

fn debug_base(l: &mut Lower, name: str, size: u64, encoding: u8) -> u32 {
    var n = alloc.String.init(l.a);
    n.push_str(name);
    l.m.debug_types.push(ir.DebugType { kind: ir.DEBUG_BASE, name: n, size: size, encoding: encoding, target: 0, count: 0, members: alloc.List(ir.DebugMember).init(l.a) });
    return l.m.debug_types.len() as u32 - 1;
}

fn debug_pointer_to(l: &mut Lower, target: u32) -> u32 {
    l.m.debug_types.push(ir.DebugType { kind: ir.DEBUG_POINTER, name: alloc.String.init(l.a), size: 8, encoding: 0, target: target, count: 0, members: alloc.List(ir.DebugMember).init(l.a) });
    return l.m.debug_types.len() as u32 - 1;
}

fn debug_member(l: &mut Lower, of: u32, name: str, type_index: u32, offset: u64) {
    var n = alloc.String.init(l.a);
    n.push_str(name);
    l.m.debug_types[of as usize].members.push(ir.DebugMember { name: n, type_index: type_index, offset: offset });
}

const ATE_BOOLEAN: u8 = 2;
const ATE_FLOAT: u8 = 4;
const ATE_SIGNED: u8 = 5;
const ATE_UNSIGNED: u8 = 7;
const ATE_UNSIGNED_CHAR: u8 = 8;

/// The type as a debugger is told of it, each once. A type is listed before
/// what it is made of, since through a pointer it may be made of itself.
fn debug_type(l: &mut Lower, t: ty.TypeId) -> u32 {
    match l.debug_types.get(t) {
        some(known) => { return known; }
        none => { }
    }
    let info = l.c.t.get(t);
    let lay = layout.layout(&l.c, t);
    var name = alloc.String.init(l.a);
    ck.write_type(&l.c, &mut name, t);
    let index = l.m.debug_types.len() as u32;
    l.m.debug_types.push(ir.DebugType { kind: ir.DEBUG_STRUCT, name: name, size: lay.size, encoding: 0, target: 0, count: 0, members: alloc.List(ir.DebugMember).init(l.a) });
    l.debug_types.put(t, index);
    match info.kind {
        .Bool => {
            l.m.debug_types[index as usize].kind = ir.DEBUG_BASE;
            l.m.debug_types[index as usize].encoding = ATE_BOOLEAN;
        }
        .Int => {
            l.m.debug_types[index as usize].kind = ir.DEBUG_BASE;
            if ty.is_signed(info.int_kind) {
                l.m.debug_types[index as usize].encoding = ATE_SIGNED;
            } else if lay.size == 1 {
                l.m.debug_types[index as usize].encoding = ATE_UNSIGNED_CHAR;
            } else {
                l.m.debug_types[index as usize].encoding = ATE_UNSIGNED;
            }
        }
        .Float => {
            l.m.debug_types[index as usize].kind = ir.DEBUG_BASE;
            l.m.debug_types[index as usize].encoding = ATE_FLOAT;
        }
        .ErrorSet => {
            l.m.debug_types[index as usize].kind = ir.DEBUG_BASE;
            l.m.debug_types[index as usize].encoding = ATE_UNSIGNED;
        }
        .Ref | .Ptr => {
            let target = debug_type(l, info.elem);
            l.m.debug_types[index as usize].kind = ir.DEBUG_POINTER;
            l.m.debug_types[index as usize].target = target;
        }
        .Array => {
            let target = debug_type(l, info.elem);
            l.m.debug_types[index as usize].kind = ir.DEBUG_ARRAY;
            l.m.debug_types[index as usize].target = target;
            l.m.debug_types[index as usize].count = info.len;
        }
        .Str => {
            let byte = debug_base(l, "u8", 1, ATE_UNSIGNED_CHAR);
            let word = debug_base(l, "u64", 8, ATE_UNSIGNED);
            let p = debug_pointer_to(l, target: byte);
            debug_member(l, of: index, name: "ptr", type_index: p, offset: 0);
            debug_member(l, of: index, name: "len", type_index: word, offset: 8);
        }
        .Slice => {
            let target = debug_type(l, info.elem);
            let word = debug_base(l, "u64", 8, ATE_UNSIGNED);
            let p = debug_pointer_to(l, target: target);
            debug_member(l, of: index, name: "ptr", type_index: p, offset: 0);
            debug_member(l, of: index, name: "len", type_index: word, offset: 8);
        }
        .List => {
            let target = debug_type(l, info.elem);
            let word = debug_base(l, "u64", 8, ATE_UNSIGNED);
            let p = debug_pointer_to(l, target: target);
            debug_member(l, of: index, name: "data", type_index: p, offset: 0);
            debug_member(l, of: index, name: "len", type_index: word, offset: 8);
            debug_member(l, of: index, name: "cap", type_index: word, offset: 16);
        }
        .Optional => {
            let has = debug_base(l, "u8", 1, ATE_UNSIGNED_CHAR);
            debug_member(l, of: index, name: "has", type_index: has, offset: 0);
            if not layout.is_nothing(&l.c, info.elem) {
                let target = debug_type(l, info.elem);
                debug_member(l, of: index, name: "value", type_index: target, offset: layout.value_offset(&l.c, t));
            }
        }
        .ErrorUnion => {
            let code = debug_base(l, "u16", 2, ATE_UNSIGNED);
            debug_member(l, of: index, name: "error", type_index: code, offset: 0);
            if not layout.is_nothing(&l.c, info.elem) {
                let target = debug_type(l, info.elem);
                debug_member(l, of: index, name: "value", type_index: target, offset: layout.value_offset(&l.c, t));
            }
        }
        .Struct => {
            let d = l.c.decls[info.decl as usize];
            var k: u32 = 0;
            while k < d.members_len : (k += 1) {
                let field = l.c.fields[(d.members_start + k) as usize];
                let target = debug_type(l, field.type_id);
                var field_name = alloc.String.init(l.a);
                field_name.push_str(l.c.names.text(field.name));
                debug_member(l, of: index, name: field_name.view(), type_index: target, offset: layout.field_offset(&l.c, start: d.members_start, i: d.members_start + k));
            }
        }
        .Enum => {
            let tag = debug_base(l, "u32", 4, ATE_UNSIGNED);
            debug_member(l, of: index, name: "tag", type_index: tag, offset: 0);
        }
        _ => { }
    }
    return index;
}

// ---- names -----------------------------------------------------------------------

fn segment(out: &mut alloc.String, s: str) {
    out.push_str("_");
    ir.write_number(out, s.len() as u64);
    out.push_str(s);
}

/// docs/abi.md: a0, then each segment of the module path, the type and the
/// function, as _<length><text>.
pub fn mangle(c: &ck.Checker, d: u32, a: alloc.Allocator) -> alloc.String {
    let decl = c.decls[d as usize];
    var out = alloc.String.init(a);
    out.push_str("a0");
    let mname = c.p.modules[decl.module as usize].name.view();
    if mname.len() == 0 {
        out.push_str("_0");
    }
    var start: usize = 0;
    var i: usize = 0;
    while i <= mname.len() : (i += 1) {
        if i == mname.len() or mname[i] == '.' {
            if i > start {
                segment(&mut out, mname[start..i]);
            }
            start = i + 1;
        }
    }
    {
        if d == c.panic_handler {
            var name = alloc.String.init(a);
            name.push_str("a0_panic"); // what the freestanding runtime calls
            return name;
        }
        let exported = ck.fn_attribute(c, d, "export");
        if decl.kind == ck.DeclKind.Fn and exported.len() > 0 {
            return exported;
        }
    }
    if decl.owner != ck.NONE {
        segment(&mut out, c.names.text(c.decls[decl.owner as usize].name));
    } else if decl.impl_index != ck.NONE {
        // A method of an impl for a type without a declaration: the interface.
        segment(&mut out, c.names.text(c.decls[c.impls[decl.impl_index as usize].iface as usize].name));
    }
    segment(&mut out, c.names.text(decl.name));
    // Names depend only on the module's own text and the comptime
    // arguments, so a module's code does not change when another module
    // does (an incremental build reuses it, arche-driver).
    // A closure: one per expression, named by its node in the module.
    if ck.kind_of_in(c, decl.module, decl.node) == cst.Kind.ClosureExpr {
        out.push_str("_C");
        ir.write_number(&mut out, decl.node.index as u64);
    }
    // A method of an impl: two interfaces may both have one of its name;
    // the impl's node tells them apart.
    if decl.impl_index != ck.NONE {
        out.push_str("_X");
        ir.write_number(&mut out, c.impls[decl.impl_index as usize].node.index as u64);
    }
    // An instance, a method of one, or a closure in one: a hash of the
    // comptime arguments tells it from the template's other instances
    // (spec/arche.md §4).
    if decl.env_len > 0 {
        var key = alloc.String.init(a);
        var e = decl.env_start;
        while e < decl.env_start + decl.env_len : (e += 1) {
            type_key(c, &mut key, c.env[e as usize].type_id, 0);
            if not c.env[e as usize].is_type {
                key.push_str("=");
                ir.write_number(&mut key, c.env[e as usize].value);
            }
            key.push_str(";");
        }
        out.push_str("_I");
        hex64(&mut out, fnv(key.view()));
    }
    return out;
}

/// FNV-1a, 64 bits.
fn fnv(text: str) -> u64 {
    var h: u64 = 0xcbf29ce484222325;
    var i: usize = 0;
    while i < text.len() : (i += 1) {
        h = (h ^ text[i] as u64) *% 0x100000001b3;
    }
    return h;
}

fn hex64(out: &mut alloc.String, v: u64) {
    let digits = "0123456789abcdef";
    var shift: u32 = 64;
    while shift > 0 : (shift -= 4) {
        out.push_ascii(digits[((v >> (shift - 4)) & 15) as usize]);
    }
}

/// A type as text that names it in the whole program: a declared type by
/// its module and name, and its comptime arguments when it is an instance.
fn type_key(c: &ck.Checker, out: &mut alloc.String, t: ty.TypeId, depth: u32) {
    let info = c.t.get(t);
    if depth > 16 {
        out.push_str("...");
        return;
    }
    out.push_str("(");
    let k = info.kind;
    // A tag for each kind that is made of others; the rest by their name.
    if k == ty.Kind.Ref {
        out.push_str("ref");
    } else if k == ty.Kind.Slice {
        out.push_str("slice");
    } else if k == ty.Kind.Array {
        out.push_str("array ");
        ir.write_number(out, info.len);
    } else if k == ty.Kind.List {
        out.push_str("list");
    } else if k == ty.Kind.Map {
        out.push_str("map");
    } else if k == ty.Kind.Optional {
        out.push_str("optional");
    } else if k == ty.Kind.ErrorUnion {
        out.push_str("result");
    } else if k == ty.Kind.Ptr {
        out.push_str("ptr");
    } else if k == ty.Kind.Struct {
        out.push_str("struct");
    } else if k == ty.Kind.Enum {
        out.push_str("enum");
    } else if k == ty.Kind.ErrorSet {
        out.push_str("errors");
    } else if k == ty.Kind.Interface {
        out.push_str("interface");
    } else if k == ty.Kind.Dyn {
        out.push_str("dyn");
    } else if k == ty.Kind.Closure {
        out.push_str("closure");
    } else {
        ck.write_type(c, out, t);
    }
    if info.mutable {
        out.push_str(",mut");
    }
    if k == ty.Kind.Struct or k == ty.Kind.Enum or k == ty.Kind.ErrorSet or k == ty.Kind.Interface or k == ty.Kind.Dyn {
        if info.decl != ty.NO_DECL and info.decl != ck.NONE {
            let d = c.decls[info.decl as usize];
            out.push_str(",");
            out.push_str(c.p.modules[d.module as usize].name.view());
            out.push_str(".");
            out.push_str(c.names.text(d.name));
            var e = d.env_start;
            while e < d.env_start + d.env_len : (e += 1) {
                out.push_str(",");
                type_key(c, out, c.env[e as usize].type_id, depth + 1);
                if not c.env[e as usize].is_type {
                    out.push_str("=");
                    ir.write_number(out, c.env[e as usize].value);
                }
            }
        }
    } else if k == ty.Kind.Closure {
        let fd = c.fns[c.closures[info.decl as usize].fn_index as usize].decl;
        out.push_str(",closure ");
        out.push_str(c.p.modules[c.decls[fd as usize].module as usize].name.view());
        out.push_str(" ");
        ir.write_number(out, c.decls[fd as usize].node.index as u64);
    } else if k == ty.Kind.ErrorUnion and info.decl != ty.NO_DECL and info.decl != ck.NONE {
        out.push_str(",");
        out.push_str(c.names.text(c.decls[info.decl as usize].name));
    }
    let elem_kinds = k == ty.Kind.Ref or k == ty.Kind.Slice or k == ty.Kind.Array or k == ty.Kind.List or
        k == ty.Kind.Map or k == ty.Kind.Optional or k == ty.Kind.ErrorUnion or k == ty.Kind.Ptr;
    if elem_kinds {
        out.push_str(",");
        type_key(c, out, info.elem, depth + 1);
    }
    if k == ty.Kind.Map {
        out.push_str(",");
        type_key(c, out, info.key, depth + 1);
    }
    out.push_str(")");
}

// ---- functions -------------------------------------------------------------------

/// The IR function for checker function f, with its signature only.
fn declare_fn(l: &mut Lower, f: u32) -> ir.Function {
    let info = l.c.fns[f as usize];
    let name = mangle(&l.c, info.decl, l.a);
    let rt = ret_ty(&l.c, info.ret);
    var irf = ir.new_function(name.view(), rt, l.a);
    if returns_in_memory(&l.c, info.ret) {
        irf.params.push(ir.Ty.Ptr);
    }
    if ck.is_closure_fn(&l.c, f) {
        irf.params.push(ir.Ty.Ptr); // the closure: its captures
    }
    var i = info.params_start;
    while i < info.params_start + info.params_len : (i += 1) {
        irf.params.push(param_ty(&l.c, l.c.params[i as usize].type_id));
    }
    return irf;
}

fn lower_fn(l: &mut Lower, f: u32) {
    let info = l.c.fns[f as usize];
    let decl = l.c.decls[info.decl as usize];
    l.f = declare_fn(l, f);
    l.block = 0;
    l.fn_index = f;
    l.ret = info.ret;
    ck.enter_decl(&mut l.c, info.decl);
    l.c.cur_table = info.table;
    l.c.fn_index = f;
    var source_name = alloc.String.init(l.a);
    source_name.push_str(l.c.names.text(decl.name));
    debug_function(l, name: source_name.view(), name_token: decl.name_token);
    if ck.fn_attribute(&l.c, info.decl, "export").len() > 0 or info.decl == l.c.panic_handler {
        l.f.internal = false; // others call it by its name
    }
    l.f.section = ck.fn_attribute(&l.c, info.decl, "section");
    l.f.no_frame = ck.is_naked_fn(&l.c, info.decl);
    l.vars = alloc.List(Var).init(l.a);
    l.defers = alloc.List(cst.NodeId).init(l.a);
    l.loops = alloc.List(LoopCtx).init(l.a);
    l.sret = ck.NONE;
    var position: u64 = 0;
    if returns_in_memory(&l.c, info.ret) {
        var p = ir.inst(ir.Op.Param, ir.Ty.Ptr);
        p.imm = 0;
        l.sret = emit(l, p);
        position = 1;
    }
    if ck.is_closure_fn(&l.c, f) {
        // A capture is a binding at its place in the closure, or, for a
        // view, at the address the closure holds.
        var p = ir.inst(ir.Op.Param, ir.Ty.Ptr);
        p.imm = position;
        let env = emit(l, p);
        position += 1;
        let ci = ck.closure_of_fn(&l.c, f);
        let cl = l.c.closures[ci as usize];
        var k: u32 = 0;
        while k < cl.captures_len : (k += 1) {
            let cap = l.c.captures[(cl.captures_start + k) as usize];
            var addr = gep(l, env, layout.capture_offset(&l.c, ci: ci, k: k));
            if cap.mode != ck.SelfMode.Value {
                addr = load(l, ir.Ty.Ptr, addr);
            }
            bind(l, cap.name, addr, cap.type_id);
        }
    }
    l.binding_param = true;
    var i = info.params_start;
    while i < info.params_start + info.params_len : (i += 1) {
        let pi = l.c.params[i as usize];
        let pt = param_ty(&l.c, pi.type_id);
        var p = ir.inst(ir.Op.Param, pt);
        p.imm = position;
        let v = emit(l, p);
        position += 1;
        if layout.is_scalar(&l.c, pi.type_id) {
            let slot = alloca(l, pi.type_id);
            store(l, value: v, addr: slot);
            bind(l, pi.name, slot, pi.type_id);
        } else {
            bind(l, pi.name, v, pi.type_id);
        }
    }
    l.binding_param = false;
    l.f.body_start = l.f.insts.len() as u32;
    let n = decl.node;
    // requires before the body; ensures at every return (spec/arche.md §8.1).
    l.post_conditions = alloc.List(cst.NodeId).init(l.a);
    let nc = ck.child_count(&l.c, n);
    var ci: u32 = 0;
    while ci < nc : (ci += 1) {
        let ch = ck.child(&l.c, n, ci);
        if ck.kind_of(&l.c, ch) != cst.Kind.Contract {
            continue;
        }
        if ck.has_own(&l.c, ch, tk.Kind.KwEnsures) {
            l.post_conditions.push(ch);
        } else {
            stmt.check_contract(l, ch);
        }
    }
    let body = ck.child(&l.c, n, ck.child_count(&l.c, n) - 1);
    stmt.block(l, body);
    if not terminated(l) {
        let k = l.c.t.kind(info.ret);
        if l.f.no_frame {
            // Its asm never falls through to an epilogue it does not have.
            _ = emit(l, ir.inst(ir.Op.Unreachable, ir.Ty.Void));
            return;
        }
        if k == ty.Kind.Void or (l.f.ret == ir.Ty.I16 and k == ty.Kind.ErrorUnion) {
            stmt.check_ensures(l, false, Val { v: 0, scalar: true, fresh: true });
        }
        if k == ty.Kind.Void {
            _ = emit(l, ir.inst(ir.Op.RetVoid, ir.Ty.Void));
        } else if l.f.ret == ir.Ty.I16 and k == ty.Kind.ErrorUnion {
            // E!void falls off its end with success (§10).
            var r = ir.inst(ir.Op.Ret, ir.Ty.Void);
            r.a = konst(l, ir.Ty.I16, 0);
            _ = emit(l, r);
        } else {
            _ = emit(l, ir.inst(ir.Op.Unreachable, ir.Ty.Void));
        }
    }
}

/// a0_entry: what the runtime calls; it calls the root module's main.
/// In a test build, the test block of the root module whose function is f,
/// or NONE.
fn root_test(c: &ck.Checker, f: u32) -> u32 {
    if not c.p.tests {
        return ck.NONE;
    }
    var i: usize = 0;
    while i < c.tests.len() : (i += 1) {
        if c.tests[i].fn_index == f and c.tests[i].module == 0 {
            return i as u32;
        }
    }
    return ck.NONE;
}

/// A test block as a function of the runner: a0_test_<n>, n its number
/// among the tests, taking the runner's Test when the block does
/// (std.testing).
fn lower_test(l: &mut Lower, i: u32) {
    let t = l.c.tests[i as usize];
    let info = l.c.fns[t.fn_index as usize];
    var name = alloc.String.init(l.a);
    name.push_str("a0_test_");
    ir.write_number(&mut name, i as u64);
    l.f = ir.new_function(name.view(), ir.Ty.Void, l.a);
    l.block = 0;
    l.fn_index = t.fn_index;
    l.ret = ty.void_type();
    l.c.module = t.module;
    l.c.env_len = 0;
    l.c.cur_table = ck.NONE;
    l.c.fn_index = t.fn_index;
    debug_function(l, name: name.view(), name_token: ck.NONE);
    l.vars = alloc.List(Var).init(l.a);
    l.defers = alloc.List(cst.NodeId).init(l.a);
    l.loops = alloc.List(LoopCtx).init(l.a);
    l.post_conditions = alloc.List(cst.NodeId).init(l.a);
    l.sret = ck.NONE;
    if info.params_len > 0 {
        l.f.params.push(ir.Ty.Ptr);
        var p = ir.inst(ir.Op.Param, ir.Ty.Ptr);
        p.imm = 0;
        let v = emit(l, p);
        let pi = l.c.params[info.params_start as usize];
        let slot = alloca(l, pi.type_id);
        store(l, value: v, addr: slot);
        bind(l, pi.name, slot, pi.type_id);
    }
    stmt.block(l, ck.child(&l.c, t.node, ck.child_count(&l.c, t.node) - 1));
    if not terminated(l) {
        _ = emit(l, ir.inst(ir.Op.RetVoid, ir.Ty.Void));
    }
    // The runner's table: the name as written, without its quotes.
    let m = &l.c.p.modules[t.module as usize];
    let tok = ck.find_own(&l.c, t.node, tk.Kind.String) orelse 0;
    let quoted = m.token_text(tok);
    var text = alloc.String.init(l.a);
    text.push_str(quoted[1..quoted.len() - 1]);
    let g = l.m.global(text.view());
    l.m.tests.push(ir.TestEntry { name: g, function: l.m.functions.len() as u32, takes_test: t.takes_test });
}

/// A test build's entry: the runner (compiler/runtime/rt.c).
fn test_entry(l: &mut Lower) {
    var e = ir.new_function("a0_entry", ir.Ty.I16, l.a);
    e.internal = false;
    e.params.push(ir.Ty.Ptr);
    l.f = e;
    l.block = 0;
    var p = ir.inst(ir.Op.Param, ir.Ty.Ptr);
    p.imm = 0;
    let sys = emit(l, p);
    var args = args0(l);
    args.push(sys);
    let r = call_runtime(l, "a0rt_run_tests", ir.Ty.I16, &args);
    var ret = ir.inst(ir.Op.Ret, ir.Ty.Void);
    ret.a = r;
    _ = emit(l, ret);
}

fn entry(l: &mut Lower) {
    if l.c.p.tests {
        test_entry(l);
        return;
    }
    let main_sym = l.c.names.intern("main");
    let d = l.c.items[0].get(main_sym) orelse 0;
    let f = l.c.decls[d as usize].fn_index;
    var e = ir.new_function("a0_entry", ir.Ty.I16, l.a);
    e.internal = false;
    e.params.push(ir.Ty.Ptr);
    l.f = e;
    l.block = 0;
    var p = ir.inst(ir.Op.Param, ir.Ty.Ptr);
    p.imm = 0;
    let sys = emit(l, p);
    var args = args0(l);
    args.push(sys);
    let r = call_with(l, f, false, ir.Ty.I16, &args);
    var ret = ir.inst(ir.Op.Ret, ir.Ty.Void);
    ret.a = r;
    _ = emit(l, ret);
}

/// The names of the program's errors, by number, for the runtime.
fn error_names(l: &mut Lower) {
    var entries = alloc.List(u32).init(l.a);
    entries.push(l.m.global(""));
    var i: usize = 0;
    while i < l.c.error_names.len() : (i += 1) {
        var name = alloc.String.init(l.a);
        name.push_str(l.c.names.text(l.c.error_names[i]));
        entries.push(l.m.global(name.view()));
    }
    var table = alloc.String.init(l.a);
    table.push_str("a0_error_names");
    l.m.tables.push(ir.StrTable { name: table, entries: entries });
}

/// Lowers the whole program. Every function is verified as it is made.
pub fn lower(c: ck.Checker) -> ir.Module {
    let a = c.a;
    let c_debug = c.p.debug_info;
    var l = Lower {
        c: c,
        m: ir.Module.init(a),
        f: ir.new_function("", ir.Ty.Void, a),
        block: 0,
        vars: alloc.List(Var).init(a),
        defers: alloc.List(cst.NodeId).init(a),
        loops: alloc.List(LoopCtx).init(a),
        fn_index: 0,
        sret: ck.NONE,
        ret: ty.void_type(),
        vtables: alloc.Map(u32, u32).init(a),
        post_conditions: alloc.List(cst.NodeId).init(a),
        debug: c_debug,
        line: 0,
        module_files: alloc.List(u32).init(a),
        line_starts: alloc.List(alloc.List(u32)).init(a),
        debug_types: alloc.Map(ty.TypeId, u32).init(a),
        binding_param: false,
        a: a,
    };
    l.m.test_mode = l.c.p.tests;
    var f: usize = 0;
    while f < l.c.fns.len() : (f += 1) {
        let test_block = root_test(&l.c, f as u32);
        if test_block != ck.NONE {
            lower_test(&mut l, test_block);
            let done = l.f;
            l.m.functions.push(done);
            l.f = ir.new_function("", ir.Ty.Void, a);
            continue;
        }
        if l.c.fns[f].decl == ck.NONE or ck.is_signature(&l.c, f as u32) {
            // A test block, which a build leaves out, or an interface's
            // method, which has no body. A stub keeps the IR functions
            // numbered like the checker's.
            var name = alloc.String.init(a);
            name.push_str("a0_test_");
            ir.write_number(&mut name, f as u64);
            var stub = ir.new_function(name.view(), ir.Ty.Void, a);
            stub.stub = true;
            var u = ir.inst(ir.Op.Unreachable, ir.Ty.Void);
            u.a = 0;
            stub.insts.push(u);
            stub.blocks[0].insts.push(0);
            l.m.functions.push(stub);
            continue;
        }
        lower_fn(&mut l, f as u32);
        let done = l.f;
        l.m.functions.push(done);
        l.f = ir.new_function("", ir.Ty.Void, a);
    }
    l.c.cur_table = ck.NONE;
    // A hosted target has an entry that the runtime calls, and the names
    // of the program's errors for it (docs/abi.md); a freestanding one
    // exports its own entry (spec/arche.md §10.3).
    var hosted = false;
    match l.c.p.target {
        .LinuxX86_64 => {
            l.m.triple.push_str("x86_64-pc-linux-gnu");
            hosted = true;
        }
        .WindowsX86_64 => {
            l.m.triple.push_str("x86_64-pc-windows-msvc");
            hosted = true;
        }
        .FreestandingX86_64 => { l.m.triple.push_str("x86_64-unknown-none-elf"); }
        .FreestandingRiscv64 => { l.m.triple.push_str("riscv64-unknown-none-elf"); }
    }
    if hosted {
        entry(&mut l);
        error_names(&mut l);
        let e = l.f;
        l.m.functions.push(e);
    }
    return l.m;
}
