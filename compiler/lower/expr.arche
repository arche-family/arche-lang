/// Lowering of expressions (spec/arche-0.md §7, §11).
import alloc;
import syntax.cst;
import syntax.token as tk;
import ir.ir;
import lower.layout;
import lower.lower as lw;
import lower.stmt;
import sema.floats;
import sema.check as ck;
import sema.expr as sx;
import sema.types as ty;

fn kind(l: &lw.Lower, n: cst.NodeId) -> cst.Kind {
    return ck.kind_of(&l.c, n);
}

fn child(l: &lw.Lower, n: cst.NodeId, i: u32) -> cst.NodeId {
    return ck.child(&l.c, n, i);
}

fn count(l: &lw.Lower, n: cst.NodeId) -> u32 {
    return ck.child_count(&l.c, n);
}

fn type_of(l: &lw.Lower, n: cst.NodeId) -> ty.TypeId {
    return ck.type_of(&l.c, n);
}

fn nothing() -> lw.Val {
    return lw.Val { v: 0, scalar: true, fresh: true };
}

fn scalar_val(v: u32) -> lw.Val {
    return lw.Val { v: v, scalar: true, fresh: true };
}

fn fresh_val(v: u32) -> lw.Val {
    return lw.Val { v: v, scalar: false, fresh: true };
}

fn size_of(l: &lw.Lower, t: ty.TypeId) -> u64 {
    return layout.layout(&l.c, t).size;
}

fn int_kind(l: &lw.Lower, t: ty.TypeId) -> ty.IntKind {
    return l.c.t.get(t).int_kind;
}

// ---- string literals ----------------------------------------------------------------

fn hex(c: u8) -> u32 {
    match c {
        '0'..='9' => { return (c - '0') as u32; }
        'a'..='f' => { return (c - 'a') as u32 + 10; }
        _ => { return (c - 'A') as u32 + 10; }
    }
}

fn push_utf8(out: &mut alloc.List(u8), cp: u32) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xC0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else if cp < 0x10000 {
        out.push((0xE0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    } else {
        out.push((0xF0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3F)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3F)) as u8);
        out.push((0x80 | (cp & 0x3F)) as u8);
    }
}

/// The bytes of a string literal, its quotes included, with the escapes
/// of §2.2 decoded. The lexer has checked it.
fn decode(raw: []u8, a: alloc.Allocator) -> alloc.List(u8) {
    var out = alloc.List(u8).init(a);
    var i: usize = 1;
    while i + 1 < raw.len() {
        let c = raw[i];
        if c != '\\' {
            out.push(c);
            i += 1;
            continue;
        }
        let e = raw[i + 1];
        i += 2;
        match e {
            'n' => { out.push(10); }
            'r' => { out.push(13); }
            't' => { out.push(9); }
            '0' => { out.push(0); }
            'x' => {
                out.push((hex(raw[i]) * 16 + hex(raw[i + 1])) as u8);
                i += 2;
            }
            'u' => {
                i += 1; // {
                var cp: u32 = 0;
                while raw[i] != '}' : (i += 1) {
                    cp = cp * 16 + hex(raw[i]);
                }
                i += 1;
                push_utf8(&mut out, cp);
            }
            _ => { out.push(e); }
        }
    }
    return out;
}

/// The str value of the string literal node n of module m.
fn string_literal(l: &mut lw.Lower, module: u32, n: cst.NodeId) -> lw.Val {
    let mod = &l.c.p.modules[module as usize];
    let t = mod.tree.first_token(n);
    let bytes = decode(mod.token_text(t).bytes(), l.a);
    let g = l.m.global_bytes(bytes.items());
    var gi = ir.inst(ir.Op.Global, ir.Ty.Ptr);
    gi.imm = g as u64;
    let p = lw.emit(l, gi);
    let tmp = lw.alloca(l, ty.str_type());
    lw.store(l, value: p, addr: tmp);
    let len = lw.konst(l, ir.Ty.I64, bytes.len() as u64);
    lw.store(l, value: len, addr: lw.gep(l, tmp, 8));
    return fresh_val(tmp);
}

fn const_value(l: &mut lw.Lower, d: u32) -> lw.Val {
    let decl = l.c.decls[d as usize];
    let t = decl.type_id;
    if l.c.t.kind(t) == ty.Kind.Str {
        return string_literal(l, decl.value_module, decl.value_node);
    }
    let s = layout.scalar(&l.c, t);
    return scalar_val(lw.konst(l, s, decl.value));
}

// ---- values -----------------------------------------------------------------------

/// The value of an expression.
pub fn value(l: &mut lw.Lower, e: cst.NodeId) -> lw.Val {
    let v = value_of(l, e);
    let want = ck.dyn_cast(&l.c, e);
    if ck.is_invalid(&l.c, want) {
        return v;
    }
    return to_dyn(l, e, want: want, v: v);
}

/// A &T as a &dyn I: the address, and the table of T's impl of I.
fn to_dyn(l: &mut lw.Lower, e: cst.NodeId, want: ty.TypeId, v: lw.Val) -> lw.Val {
    var target = l.c.t.elem(type_of(l, e));
    if l.c.t.kind(type_of(l, e)) == ty.Kind.Closure {
        target = type_of(l, e); // a closure written in place: v is its address
    }
    var vt: u32 = 0;
    if l.c.t.kind(target) == ty.Kind.Closure {
        vt = lw.closure_vtable(l, l.c.t.get(target).decl);
    } else {
        let imp = ck.impl_index(&l.c, target, l.c.t.get(want).decl);
        vt = lw.vtable(l, imp);
    }
    let tmp = lw.alloca(l, want);
    lw.store(l, value: v.v, addr: tmp);
    var i = ir.inst(ir.Op.VTable, ir.Ty.Ptr);
    i.imm = vt as u64;
    let table = lw.emit(l, i);
    lw.store(l, value: table, addr: lw.gep(l, tmp, 8));
    return fresh_val(tmp);
}

/// d.name(...) on a &dyn I: the method's address from d's table, called
/// with d's address as self.
fn dyn_call(l: &mut lw.Lower, n: cst.NodeId, d: u32) -> lw.Val {
    let callee = child(l, n, 0);
    let receiver = child(l, callee, 0);
    let t = type_of(l, n);
    let fi = l.c.decls[d as usize].fn_index;
    let info = l.c.fns[fi as usize];
    let iface = l.c.decls[l.c.decls[d as usize].owner as usize];
    var slot: u64 = 0;
    while l.c.methods[(iface.methods_start as u64 + slot) as usize] != d : (slot += 1) {
    }
    let dv = in_memory(l, type_of(l, receiver), value(l, receiver));
    let data = lw.load(l, ir.Ty.Ptr, dv);
    let table = lw.load(l, ir.Ty.Ptr, lw.gep(l, dv, 8));
    let fp = lw.load(l, ir.Ty.Ptr, lw.gep(l, table, slot * 8));
    var args = lw.args0(l);
    var sret = ck.NONE;
    if lw.returns_in_memory(&l.c, info.ret) {
        sret = lw.alloca(l, info.ret);
        args.push(sret);
    }
    args.push(data);
    let nargs = count(l, n) - 1;
    var i: u32 = 0;
    while i < nargs : (i += 1) {
        let pt = l.c.params[(info.params_start + 1 + i) as usize].type_id;
        let v = value(l, arg_node(l, n, i));
        args.push(lw.as_arg(l, pt, v));
    }
    let r = lw.call_indirect(l, fp, lw.ret_ty(&l.c, info.ret), &args);
    return result_of(l, t, r: r, sret: sret);
}

/// A closure's value: its captures, copied, moved or viewed (§6).
fn closure_value(l: &mut lw.Lower, t: ty.TypeId) -> lw.Val {
    let ci = l.c.t.get(t).decl;
    let cl = l.c.closures[ci as usize];
    let tmp = lw.alloca(l, t);
    var k: u32 = 0;
    while k < cl.captures_len : (k += 1) {
        let cap = l.c.captures[(cl.captures_start + k) as usize];
        let var_ = lw.find_var(l, cap.name) orelse lw.Var { name: cap.name, addr: 0, type_id: cap.type_id };
        let at = lw.gep(l, tmp, layout.capture_offset(&l.c, ci: ci, k: k));
        if cap.mode == ck.SelfMode.Value {
            let v = lw.load_val(l, cap.type_id, var_.addr);
            lw.store_val(l, cap.type_id, v, at);
        } else {
            lw.store(l, value: var_.addr, addr: at);
        }
    }
    return fresh_val(tmp);
}

/// x(...) of a closure, a view of one, or a &dyn fn(P) -> R: the body
/// with the closure as its hidden first parameter.
fn closure_call(l: &mut lw.Lower, n: cst.NodeId) -> lw.Val {
    let callee = child(l, n, 0);
    let ct = type_of(l, callee);
    let t = type_of(l, n);
    var inner = ct;
    if l.c.t.kind(ct) == ty.Kind.Ref {
        inner = l.c.t.elem(ct);
    }
    var info = l.c.fns[0];
    var fi = ck.NONE;
    var env: u32 = 0;
    var fp: u32 = 0;
    var skip: u32 = 0;
    if l.c.t.kind(inner) == ty.Kind.Closure {
        fi = l.c.closures[l.c.t.get(inner).decl as usize].fn_index;
        info = l.c.fns[fi as usize];
        if l.c.t.kind(ct) == ty.Kind.Ref {
            env = value(l, callee).v;
        } else {
            env = address(l, callee);
        }
    } else {
        let iface = l.c.decls[l.c.t.get(inner).decl as usize];
        let md = l.c.methods[iface.methods_start as usize];
        info = l.c.fns[l.c.decls[md as usize].fn_index as usize];
        let dv = in_memory(l, ct, value(l, callee));
        env = lw.load(l, ir.Ty.Ptr, dv);
        let table = lw.load(l, ir.Ty.Ptr, lw.gep(l, dv, 8));
        fp = lw.load(l, ir.Ty.Ptr, table);
        skip = 1;
    }
    var args = lw.args0(l);
    var sret = ck.NONE;
    if lw.returns_in_memory(&l.c, info.ret) {
        sret = lw.alloca(l, info.ret);
        args.push(sret);
    }
    args.push(env);
    let nargs = count(l, n) - 1;
    var i: u32 = 0;
    while i < nargs : (i += 1) {
        let pt = l.c.params[(info.params_start + skip + i) as usize].type_id;
        let v = value(l, arg_node(l, n, i));
        args.push(lw.as_arg(l, pt, v));
    }
    var r: u32 = 0;
    if fi != ck.NONE {
        r = lw.call_with(l, fi, false, lw.ret_ty(&l.c, info.ret), &args);
    } else {
        r = lw.call_indirect(l, fp, lw.ret_ty(&l.c, info.ret), &args);
    }
    return result_of(l, t, r: r, sret: sret);
}

/// A float literal's bits; an f32's as the double of its value, as LLVM
/// writes f32 constants (spec/arche.md §2.1).
fn float_literal(l: &mut lw.Lower, e: cst.NodeId, t: ty.TypeId) -> u32 {
    var text = alloc.String.init(l.a);
    text.push_str(ck.text(&l.c, ck.tree(&l.c).first_token(e)));
    if l.c.t.get(t).len == 32 {
        return lw.konst(l, ir.Ty.F32, floats.widen(floats.f32_bits(text.view(), l.a)));
    }
    return lw.konst(l, ir.Ty.F64, floats.f64_bits(text.view(), l.a));
}

fn fbin(l: &mut lw.Lower, k: ir.FBinKind, t: ir.Ty, x: u32, y: u32) -> u32 {
    var i = ir.inst(ir.Op.FBin, t);
    i.a = x;
    i.b = y;
    i.flag = ir.fbin_flag(k);
    return lw.emit(l, i);
}

fn fcmp(l: &mut lw.Lower, k: ir.FCmpKind, x: u32, y: u32) -> u32 {
    var i = ir.inst(ir.Op.FCmp, ir.Ty.I1);
    i.a = x;
    i.b = y;
    i.flag = ir.fcmp_flag(k);
    return lw.emit(l, i);
}

fn fconv(l: &mut lw.Lower, k: ir.FConvKind, x: u32, to: ir.Ty) -> u32 {
    var i = ir.inst(ir.Op.FConv, to);
    i.a = x;
    i.flag = ir.fconv_flag(k);
    return lw.emit(l, i);
}

const SIGN_BIT: u64 = 0x8000000000000000;

/// The f64 bits of 2^k; with SIGN_BIT, of -2^k.
fn pow2_f64(k: u64) -> u64 {
    return (1023 + k) << 52;
}

/// A float as an integer (spec/arche.md §2.3): `as` truncates and traps
/// when the result does not fit or the value is a NaN; `as%` saturates.
fn float_to_int(l: &mut lw.Lower, e: cst.NodeId, x: u32, from: ty.TypeId, to: ty.TypeId, wrapping: bool) -> u32 {
    let s = layout.scalar(&l.c, to);
    let k = l.c.t.get(to).int_kind;
    let sg = ty.is_signed(k);
    if wrapping {
        if sg {
            return fconv(l, ir.FConvKind.SatToSI, x, s);
        }
        return fconv(l, ir.FConvKind.SatToUI, x, s);
    }
    // Checked in f64: lo < x < hi.
    var d = x;
    if l.c.t.get(from).len == 32 {
        d = fconv(l, ir.FConvKind.Ext, x, ir.Ty.F64);
    }
    let bits = ty.bits(k) as u64;
    var hi = pow2_f64(bits);
    var lo: u64 = 0;
    if sg {
        hi = pow2_f64(bits - 1);
        // -2^(n-1) fits; anything above -2^(n-1) - 1 truncates into range.
        // An f64 holds that bound below 64 bits; at 64 the float next below
        // -2^63 is -2^63 - 2048, so the test is d >= -2^63.
        let below = lw.konst(l, ir.Ty.F64, pow2_f64(bits - 1) | SIGN_BIT);
        lo = 0;
        var fine_lo = below;
        if bits == 64 {
            fine_lo = fcmp(l, ir.FCmpKind.Ge, x: d, y: below);
        } else {
            let one = lw.konst(l, ir.Ty.F64, pow2_f64(0));
            let limit = fbin(l, ir.FBinKind.Sub, ir.Ty.F64, x: below, y: one);
            fine_lo = fcmp(l, ir.FCmpKind.Gt, x: d, y: limit);
        }
        let fine_hi = fcmp(l, ir.FCmpKind.Lt, x: d, y: lw.konst(l, ir.Ty.F64, hi));
        lw.check(l, lw.bin(l, ir.BinKind.And, x: fine_lo, y: fine_hi), "value does not fit in the integer type", e);
        return fconv(l, ir.FConvKind.ToSI, x, s);
    }
    let minus_one = lw.konst(l, ir.Ty.F64, pow2_f64(0) | SIGN_BIT);
    let fine_lo = fcmp(l, ir.FCmpKind.Gt, x: d, y: minus_one);
    let fine_hi = fcmp(l, ir.FCmpKind.Lt, x: d, y: lw.konst(l, ir.Ty.F64, hi));
    lw.check(l, lw.bin(l, ir.BinKind.And, x: fine_lo, y: fine_hi), "value does not fit in the integer type", e);
    _ = lo;
    return fconv(l, ir.FConvKind.ToUI, x, s);
}

/// One operand's constraint: r for reg, else {name}.
fn asm_register(l: &lw.Lower, op: cst.NodeId, out: &mut alloc.String) {
    let toks = ck.own(&l.c, op);
    var reg = "reg";
    var i: usize = 0;
    while i < toks.len() : (i += 1) {
        let k = ck.tok_kind(&l.c, toks[i]);
        if (k == tk.Kind.Ident or k == tk.Kind.String) and i > 0 {
            reg = ck.text(&l.c, toks[i]);
        }
    }
    if reg.len() >= 2 and reg[0] == '"' {
        reg = reg[1..reg.len() - 1];
    }
    if reg.eq("reg") {
        out.push_str("r");
    } else {
        out.push_str("{");
        out.push_str(reg);
        out.push_str("}");
    }
}

/// asm(...) as LLVM inline assembly: outputs first in its constraints, then
/// inputs (an inout one tied to its output), then clobbers; %N of the text
/// becomes $ and the operand's place in that order.
fn asm_value(l: &mut lw.Lower, e: cst.NodeId) -> lw.Val {
    let n = count(l, e);
    var map = alloc.List(u32).init(l.a);
    var nout: u32 = 0;
    var i: u32 = 0;
    while i < n : (i += 1) {
        let w = sx.asm_kind(&l.c, child(l, e, i));
        if w.eq("out") or w.eq("inout") {
            nout += 1;
        }
    }
    var cons = alloc.String.init(l.a);
    var outputs = alloc.List(ir.Ty).init(l.a);
    var out_places = alloc.List(u32).init(l.a);
    var next_out: u32 = 0;
    var next_in = nout;
    var inputs = lw.args0(l);
    var tied = alloc.String.init(l.a);
    var plain = alloc.String.init(l.a);
    var clobbers = alloc.String.init(l.a);
    i = 0;
    while i < n : (i += 1) {
        let op = child(l, e, i);
        let w = sx.asm_kind(&l.c, op);
        if w.eq("clobber") {
            clobbers.push_str(",~");
            var reg = alloc.String.init(l.a);
            asm_register(l, op, &mut reg);
            clobbers.push_str(reg.view());
            continue;
        }
        let x = child(l, op, 0);
        if w.eq("in") {
            map.push(next_in);
            next_in += 1;
            plain.push_str(",");
            asm_register(l, op, &mut plain);
            inputs.push(value(l, x).v);
            continue;
        }
        map.push(next_out);
        if cons.len() > 0 {
            cons.push_str(",");
        }
        cons.push_str("=");
        asm_register(l, op, &mut cons);
        let addr = place(l, x);
        out_places.push(addr);
        outputs.push(layout.scalar(&l.c, type_of(l, x)));
        if w.eq("inout") {
            tied.push_str(",");
            ir.write_number(&mut tied, next_out as u64);
            inputs.push(lw.load(l, layout.scalar(&l.c, type_of(l, x)), addr));
            next_in += 1;
        }
        next_out += 1;
    }
    // LLVM numbers outputs, then the tied inputs, then the others: renumber
    // the plain inputs after the tied ones.
    let ntied = next_in - nout - (map.len() as u32 - nout);
    var constraints = alloc.String.init(l.a);
    constraints.push_str(cons.view());
    var rest = alloc.String.init(l.a);
    rest.push_str(tied.view());
    rest.push_str(plain.view());
    rest.push_str(clobbers.view());
    rest.push_str(",~{memory}");
    if constraints.len() == 0 and rest.len() > 0 {
        constraints.push_str(rest.view()[1..rest.len()]);
    } else {
        constraints.push_str(rest.view());
    }
    // Inputs: the tied ones were pushed in order with the plain ones; put
    // tied first, as their constraints are.
    var ordered = lw.args0(l);
    var tied_vals = lw.args0(l);
    var plain_vals = lw.args0(l);
    var vi: usize = 0;
    i = 0;
    while i < n : (i += 1) {
        let w = sx.asm_kind(&l.c, child(l, e, i));
        if w.eq("inout") {
            tied_vals.push(inputs[vi]);
            vi += 1;
        } else if w.eq("in") {
            plain_vals.push(inputs[vi]);
            vi += 1;
        }
    }
    var q: usize = 0;
    while q < tied_vals.len() : (q += 1) {
        ordered.push(tied_vals[q]);
    }
    q = 0;
    while q < plain_vals.len() : (q += 1) {
        ordered.push(plain_vals[q]);
    }
    // A plain input's LLVM number comes after every output and tied input.
    var remapped = alloc.List(u32).init(l.a);
    var plain_seen: u32 = 0;
    i = 0;
    var oi: usize = 0;
    while i < n : (i += 1) {
        let w = sx.asm_kind(&l.c, child(l, e, i));
        if w.eq("clobber") {
            continue;
        }
        if w.eq("in") {
            remapped.push(nout + ntied + plain_seen);
            plain_seen += 1;
        } else {
            remapped.push(map[oi]);
        }
        oi += 1;
    }
    // The text: %N to $N in LLVM's numbering, %% to %, $ to $$.
    let toks = ck.own(&l.c, e);
    let mod = &l.c.p.modules[l.c.module as usize];
    var text = alloc.List(u8).init(l.a);
    var t: usize = 0;
    while t < toks.len() : (t += 1) {
        if ck.tok_kind(&l.c, toks[t]) == tk.Kind.String {
            let piece = decode(mod.token_text(toks[t]).bytes(), l.a);
            let pb = piece.items();
            var b: usize = 0;
            while b < pb.len() : (b += 1) {
                text.push(pb[b]);
            }
        }
    }
    let tb = text.items();
    var tmpl = alloc.String.init(l.a);
    var k: usize = 0;
    while k < tb.len() : (k += 1) {
        let ch = tb[k];
        if ch == '%' and k + 1 < tb.len() and tb[k + 1] == '%' {
            tmpl.push_ascii('%');
            k += 1;
        } else if ch == '%' and k + 1 < tb.len() and tb[k + 1] >= '0' and tb[k + 1] <= '9' {
            tmpl.push_ascii('$');
            ir.write_number(&mut tmpl, remapped[(tb[k + 1] - '0') as usize] as u64);
            k += 1;
        } else if ch == '$' {
            tmpl.push_str("$$");
        } else if ch == '"' or ch == '\\' or ch < 32 {
            tmpl.push_ascii('\\');
            tmpl.push_ascii(hex_digit_char((ch >> 4) as u32));
            tmpl.push_ascii(hex_digit_char((ch & 15) as u32));
        } else {
            tmpl.push_ascii(ch);
        }
    }
    var outs_copy = alloc.List(ir.Ty).init(l.a);
    q = 0;
    while q < outputs.len() : (q += 1) {
        outs_copy.push(outputs[q]);
    }
    let idx = l.m.asms.len() as u32;
    l.m.asms.push(ir.AsmText { template: tmpl, constraints: constraints, outputs: outputs });
    var ai = ir.inst(ir.Op.Asm, ir.Ty.Void);
    ai.imm = idx as u64;
    ai.flag = outs_copy.len() as u32;
    if outs_copy.len() == 1 {
        ai.ty = outs_copy[0];
    }
    ai.args_start = l.f.args.len() as u32;
    q = 0;
    while q < ordered.len() : (q += 1) {
        l.f.args.push(ordered[q]);
    }
    ai.args_len = ordered.len() as u32;
    let r = lw.emit(l, ai);
    q = 0;
    while q < out_places.len() : (q += 1) {
        var v = r;
        if outs_copy.len() > 1 {
            var o = ir.inst(ir.Op.AsmOut, outs_copy[q]);
            o.a = r;
            o.imm = q as u64;
            v = lw.emit(l, o);
        }
        lw.store(l, value: v, addr: out_places[q]);
    }
    return nothing();
}

fn hex_digit_char(d: u32) -> u8 {
    if d < 10 {
        return '0' + d as u8;
    }
    return 'A' + (d - 10) as u8;
}

fn value_of(l: &mut lw.Lower, e: cst.NodeId) -> lw.Val {
    let t = type_of(l, e);
    match kind(l, e) {
        .AsmExpr => { return asm_value(l, e); }
        .FloatLit => { return scalar_val(float_literal(l, e, t)); }
        .ClosureExpr => { return closure_value(l, t); }
        .IfExpr | .MatchExpr => { return stmt.branch_value(l, e); }
        .IntLit | .CharLit => {
            let v = ck.tok_value(&l.c, ck.tree(&l.c).first_token(e));
            return scalar_val(lw.konst(l, layout.scalar(&l.c, t), v));
        }
        .BoolLit => {
            let is_true = ck.tok_kind(&l.c, ck.tree(&l.c).first_token(e)) == tk.Kind.KwTrue;
            var v: u64 = 0;
            if is_true {
                v = 1;
            }
            return scalar_val(lw.konst(l, ir.Ty.I1, v));
        }
        .StringLit => {
            let m = l.c.module;
            return string_literal(l, m, e);
        }
        .NoneLit => { return fresh_val(lw.alloca(l, t)); }
        .SomeExpr => {
            let v = value(l, child(l, e, 0));
            return wrap_some(l, t, v);
        }
        .ParenExpr => { return value(l, child(l, e, 0)); }
        .NameExpr => {
            let d = ck.ref_of(&l.c, e);
            if d >= ck.ENV_REF and d < ck.VALUE_FIELD {
                // A comptime value parameter of an instance.
                let entry = l.c.env[(d - ck.ENV_REF) as usize];
                return scalar_val(lw.konst(l, layout.scalar(&l.c, entry.type_id), entry.value));
            }
            if d != ck.NONE {
                return const_value(l, d);
            }
            let sym = ck.symbol(&mut l.c, ck.ident_of(&l.c, e));
            let var_ = lw.find_var(l, sym) orelse lw.Var { name: sym, addr: 0, type_id: t };
            return lw.load_val(l, var_.type_id, var_.addr);
        }
        .FieldExpr => {
            let r = ck.ref_of(&l.c, e);
            if r == ck.VALUE_FIELD {
                let addr = place(l, e);
                return lw.load_val(l, t, addr);
            }
            if r != ck.NONE {
                return const_value(l, r);
            }
            let sym = ck.symbol(&mut l.c, sx.member_token(&l.c, e));
            if l.c.t.kind(t) == ty.Kind.ErrorSet {
                let id = l.c.error_ids.get(sym) orelse 0;
                return scalar_val(lw.konst(l, ir.Ty.I16, id as u64));
            }
            // A variant without fields.
            let v = sx.find_variant(&l.c, t, sym) orelse 0;
            let first = l.c.decls[l.c.t.get(t).decl as usize].members_start;
            let tmp = lw.alloca(l, t);
            lw.store(l, value: lw.konst(l, ir.Ty.I32, (v - first) as u64), addr: tmp);
            return fresh_val(tmp);
        }
        .IndexExpr => {
            if l.c.t.kind(type_of(l, child(l, e, 0))) == ty.Kind.Str {
                let s = value(l, child(l, e, 0));
                let i = value(l, child(l, e, 1)).v;
                let data = lw.load(l, ir.Ty.Ptr, s.v);
                let len = lw.load(l, ir.Ty.I64, lw.gep(l, s.v, 8));
                lw.check(l, lw.cmp(l, ir.CmpKind.ULt, x: i, y: len), "index out of range", e);
                return scalar_val(lw.load(l, ir.Ty.I8, lw.gep_index(l, addr: data, index: i, 1)));
            }
            let addr = place(l, e);
            return lw.load_val(l, t, addr);
        }
        .SliceExpr => { return slice(l, e); }
        .DerefExpr => {
            let p = value(l, child(l, e, 0)).v;
            return lw.load_val(l, t, p);
        }
        .RefExpr => { return scalar_val(address(l, child(l, e, 0))); }
        .CallExpr => {
            lw.at_line(l, e);
            return call(l, e);
        }
        .StructLit => { return struct_lit(l, e); }
        .ArrayRepeat => {
            // The slot starts zeroed (alloca); other values are stored in a loop.
            let tmp = lw.alloca(l, t);
            let et = l.c.t.elem(t);
            let size = size_of(l, et);
            let n = l.c.t.get(t).len;
            let x = child(l, e, 0);
            let zero = kind(l, x) == cst.Kind.IntLit and ck.tok_value(&l.c, ck.tree(&l.c).first_token(x)) == 0;
            let v = value(l, x);
            if zero or n == 0 {
                return fresh_val(tmp);
            }
            let index = lw.alloca(l, ty.int_type(ty.IntKind.Usize));
            let head = lw.new_block(l);
            let body = lw.new_block(l);
            let done = lw.new_block(l);
            lw.br(l, head);
            lw.switch_to(l, head);
            let i = lw.load(l, ir.Ty.I64, index);
            lw.cond_br(l, cond: lw.cmp(l, ir.CmpKind.ULt, x: i, y: lw.konst(l, ir.Ty.I64, n)), yes: body, no: done);
            lw.switch_to(l, body);
            lw.store_val(l, et, v, lw.gep_index(l, addr: tmp, index: i, size));
            lw.store(l, value: lw.bin(l, ir.BinKind.Add, x: i, y: lw.konst(l, ir.Ty.I64, 1)), addr: index);
            lw.br(l, head);
            lw.switch_to(l, done);
            return fresh_val(tmp);
        }
        .ArrayLit => {
            let tmp = lw.alloca(l, t);
            let et = l.c.t.elem(t);
            let size = size_of(l, et);
            let n = count(l, e);
            var i: u32 = 0;
            while i < n : (i += 1) {
                let v = value(l, child(l, e, i));
                lw.store_val(l, et, v, lw.gep(l, tmp, size * i as u64));
            }
            return fresh_val(tmp);
        }
        .UnaryExpr => { return unary(l, e); }
        .BinaryExpr => { return binary(l, e); }
        .CastExpr => { return cast(l, e); }
        .TryExpr => { return try_expr(l, e); }
        .CatchExpr | .OrelseExpr => { return fallback(l, e); }
        _ => { return nothing(); }
    }
}

// ---- places (§7.6) ------------------------------------------------------------------

fn is_place(l: &lw.Lower, e: cst.NodeId) -> bool {
    match kind(l, e) {
        .NameExpr => { return ck.ref_of(&l.c, e) == ck.NONE; }
        .ParenExpr => { return is_place(l, child(l, e, 0)); }
        .FieldExpr => { return ck.ref_of(&l.c, e) == ck.VALUE_FIELD; }
        .IndexExpr => { return l.c.t.kind(type_of(l, child(l, e, 0))) != ty.Kind.Str; }
        .DerefExpr => { return true; }
        _ => { return false; }
    }
}

/// The address of the memory holding e's value: a place's own, or a
/// temporary for any other expression.
pub fn address(l: &mut lw.Lower, e: cst.NodeId) -> u32 {
    if is_place(l, e) {
        return place(l, e);
    }
    let t = type_of(l, e);
    let v = value(l, e);
    if v.scalar {
        let tmp = lw.alloca(l, t);
        lw.store(l, value: v.v, addr: tmp);
        return tmp;
    }
    return v.v;
}

/// The offset of a field of a struct, or of std.System.
fn field_offset(l: &mut lw.Lower, t: ty.TypeId, name: alloc.Symbol) -> u64 {
    let info = l.c.t.get(t);
    if info.kind == ty.Kind.Builtin {
        return layout.system_field(l.c.names.text(name));
    }
    let d = l.c.decls[info.decl as usize];
    var f = d.members_start;
    while f < d.members_start + d.members_len and l.c.fields[f as usize].name != name : (f += 1) {
    }
    return layout.field_offset(&l.c, start: d.members_start, i: f);
}

pub fn place(l: &mut lw.Lower, e: cst.NodeId) -> u32 {
    match kind(l, e) {
        .NameExpr => {
            let sym = ck.symbol(&mut l.c, ck.ident_of(&l.c, e));
            let var_ = lw.find_var(l, sym) orelse lw.Var { name: sym, addr: 0, type_id: ty.invalid() };
            return var_.addr;
        }
        .ParenExpr => { return place(l, child(l, e, 0)); }
        .FieldExpr => {
            let base = child(l, e, 0);
            let bt = type_of(l, base);
            var t = bt;
            var base_addr: u32 = 0;
            if l.c.t.kind(bt) == ty.Kind.Ref {
                base_addr = value(l, base).v;
                t = l.c.t.elem(bt);
            } else {
                base_addr = address(l, base);
            }
            let sym = ck.symbol(&mut l.c, sx.member_token(&l.c, e));
            let off = field_offset(l, t, sym);
            if ck.is_packed(&l.c, t) {
                return lw.gep_unaligned(l, base_addr, off);
            }
            return lw.gep(l, base_addr, off);
        }
        .IndexExpr => { return element(l, e); }
        .DerefExpr => { return value(l, child(l, e, 0)).v; }
        _ => { return address(l, e); }
    }
}

/// The data and length of an array, slice, str or list value at addr.
type Run = struct {
    data: u32,
    len: u32,
}

fn run_of(l: &mut lw.Lower, t: ty.TypeId, addr: u32) -> Run {
    let info = l.c.t.get(t);
    if info.kind == ty.Kind.Array {
        return Run { data: addr, len: lw.konst(l, ir.Ty.I64, info.len) };
    }
    let data = lw.load(l, ir.Ty.Ptr, addr);
    let len = lw.load(l, ir.Ty.I64, lw.gep(l, addr, 8));
    return Run { data: data, len: len };
}

fn element(l: &mut lw.Lower, e: cst.NodeId) -> u32 {
    let base = child(l, e, 0);
    let bt = type_of(l, base);
    let addr = address(l, base);
    let i = value(l, child(l, e, 1)).v;
    let r = run_of(l, bt, addr);
    lw.check(l, lw.cmp(l, ir.CmpKind.ULt, x: i, y: r.len), "index out of range", e);
    let size = size_of(l, ck.indexed_elem(&l.c, bt));
    return lw.gep_index(l, addr: r.data, index: i, size);
}

fn slice(l: &mut lw.Lower, e: cst.NodeId) -> lw.Val {
    let base = child(l, e, 0);
    let bt = type_of(l, base);
    let addr = address(l, base);
    let a = value(l, child(l, e, 1)).v;
    let b = value(l, child(l, e, 2)).v;
    let r = run_of(l, bt, addr);
    let fine = lw.bin(l, ir.BinKind.And, x: lw.cmp(l, ir.CmpKind.ULe, x: a, y: b), y: lw.cmp(l, ir.CmpKind.ULe, x: b, y: r.len));
    lw.check(l, fine, "slice out of range", e);
    var size: u64 = 1;
    if l.c.t.kind(bt) == ty.Kind.Str {
        var args = lw.args0(l);
        args.push(r.data);
        args.push(r.len);
        args.push(a);
        let at_a = lw.call_runtime(l, "a0rt_str_boundary", ir.Ty.I8, &args);
        var args2 = lw.args0(l);
        args2.push(r.data);
        args2.push(r.len);
        args2.push(b);
        let at_b = lw.call_runtime(l, "a0rt_str_boundary", ir.Ty.I8, &args2);
        let both = lw.bin(l, ir.BinKind.And, x: at_a, y: at_b);
        lw.check(l, lw.cmp(l, ir.CmpKind.Ne, x: both, y: lw.konst(l, ir.Ty.I8, 0)), "slice is not on a character boundary", e);
    } else {
        size = size_of(l, ck.indexed_elem(&l.c, bt));
    }
    let tmp = lw.alloca(l, type_of(l, e));
    lw.store(l, value: lw.gep_index(l, addr: r.data, index: a, size), addr: tmp);
    lw.store(l, value: lw.bin(l, ir.BinKind.Sub, x: b, y: a), addr: lw.gep(l, tmp, 8));
    return fresh_val(tmp);
}

fn struct_lit(l: &mut lw.Lower, e: cst.NodeId) -> lw.Val {
    let t = type_of(l, e);
    let tmp = lw.alloca(l, t);
    let info = l.c.t.get(t);
    var start: u32 = 0;
    var base = tmp;
    if info.kind == ty.Kind.Enum {
        let path = child(l, e, 0);
        let sym = ck.symbol(&mut l.c, sx.member_token(&l.c, path));
        let v = sx.find_variant(&l.c, t, sym) orelse 0;
        let first = l.c.decls[info.decl as usize].members_start;
        lw.store(l, value: lw.konst(l, ir.Ty.I32, (v - first) as u64), addr: tmp);
        start = l.c.variants[v as usize].fields_start;
        base = lw.gep(l, tmp, layout.payload_offset(&l.c, t));
    } else {
        start = l.c.decls[info.decl as usize].members_start;
    }
    let n = count(l, e) - 1;
    var i: u32 = 0;
    while i < n : (i += 1) {
        let field_init = child(l, e, i + 1);
        let ft = l.c.fields[(start + i) as usize].type_id;
        let v = value(l, child(l, field_init, 0));
        let off = layout.field_offset(&l.c, start: start, i: start + i);
        if l.c.fields[(start + i) as usize].packed {
            lw.store_val(l, ft, v, lw.gep_unaligned(l, base, off));
        } else {
            lw.store_val(l, ft, v, lw.gep(l, base, off));
        }
    }
    return fresh_val(tmp);
}

// ---- optionals and error unions -----------------------------------------------------

pub fn wrap_some(l: &mut lw.Lower, t: ty.TypeId, v: lw.Val) -> lw.Val {
    let tmp = lw.alloca(l, t);
    lw.store(l, value: lw.konst(l, ir.Ty.I8, 1), addr: tmp);
    lw.store_val(l, l.c.t.elem(t), v, lw.gep(l, tmp, layout.value_offset(&l.c, t)));
    return fresh_val(tmp);
}

pub fn wrap_ok(l: &mut lw.Lower, t: ty.TypeId, v: lw.Val) -> lw.Val {
    if layout.is_scalar(&l.c, t) {
        return scalar_val(lw.konst(l, ir.Ty.I16, 0));
    }
    let tmp = lw.alloca(l, t);
    lw.store_val(l, l.c.t.elem(t), v, lw.gep(l, tmp, layout.value_offset(&l.c, t)));
    return fresh_val(tmp);
}

pub fn wrap_error(l: &mut lw.Lower, t: ty.TypeId, code: u32) -> lw.Val {
    if layout.is_scalar(&l.c, t) {
        return scalar_val(code);
    }
    let tmp = lw.alloca(l, t);
    lw.store(l, value: code, addr: tmp);
    return fresh_val(tmp);
}

/// The error code of an error union value.
fn error_code(l: &mut lw.Lower, t: ty.TypeId, v: lw.Val) -> u32 {
    if layout.is_scalar(&l.c, t) {
        return v.v;
    }
    return lw.load(l, ir.Ty.I16, v.v);
}

fn try_expr(l: &mut lw.Lower, e: cst.NodeId) -> lw.Val {
    let operand = child(l, e, 0);
    let ut = type_of(l, operand);
    let v = lw.own_val(l, ut, value(l, operand));
    let code = error_code(l, ut, v);
    let failed = lw.cmp(l, ir.CmpKind.Ne, x: code, y: lw.konst(l, ir.Ty.I16, 0));
    let fail = lw.new_block(l);
    let fine = lw.new_block(l);
    lw.cond_br(l, cond: failed, yes: fail, no: fine);
    lw.switch_to(l, fail);
    lw.trace(l, e, false);
    // The error leaves the function, after its deferred code (§8).
    let rt = l.ret;
    let result = wrap_error(l, rt, code);
    stmt.run_defers(l, 0);
    stmt.emit_return(l, true, result);
    lw.switch_to(l, fine);
    let et = l.c.t.elem(ut);
    if layout.is_nothing(&l.c, et) {
        return nothing();
    }
    return lw.load_val(l, et, lw.gep(l, v.v, layout.value_offset(&l.c, ut)));
}

/// x orelse y, x catch y: y only when x has no value.
fn fallback(l: &mut lw.Lower, e: cst.NodeId) -> lw.Val {
    let lhs = child(l, e, 0);
    let rhs = child(l, e, 1);
    let xt = type_of(l, lhs);
    let et = l.c.t.elem(xt);
    let x = lw.own_val(l, xt, value(l, lhs));
    var has: u32 = 0;
    if kind(l, e) == cst.Kind.OrelseExpr {
        has = lw.cmp(l, ir.CmpKind.Ne, x: lw.load(l, ir.Ty.I8, x.v), y: lw.konst(l, ir.Ty.I8, 0));
    } else {
        has = lw.cmp(l, ir.CmpKind.Eq, x: error_code(l, xt, x), y: lw.konst(l, ir.Ty.I16, 0));
    }
    let nothing_left = layout.is_nothing(&l.c, et);
    var result: u32 = 0;
    if not nothing_left {
        result = lw.alloca(l, et);
    }
    let yes = lw.new_block(l);
    let no = lw.new_block(l);
    let done = lw.new_block(l);
    lw.cond_br(l, cond: has, yes: yes, no: no);
    lw.switch_to(l, yes);
    if not nothing_left {
        let inner = lw.load_val(l, et, lw.gep(l, x.v, layout.value_offset(&l.c, xt)));
        lw.store_val(l, et, inner, result);
    }
    lw.br(l, done);
    lw.switch_to(l, no);
    if sx.is_jump(&l.c, rhs) {
        stmt.lower_jump(l, rhs);
    } else {
        let y = value(l, rhs);
        if not nothing_left and not lw.terminated(l) and l.c.t.kind(type_of(l, rhs)) != ty.Kind.Noreturn {
            lw.store_val(l, et, y, result);
        }
    }
    lw.br(l, done);
    lw.switch_to(l, done);
    if nothing_left {
        return nothing();
    }
    let r = lw.load_val(l, et, result);
    return lw.Val { v: r.v, scalar: r.scalar, fresh: true };
}

// ---- operators (§7.2) ----------------------------------------------------------------

fn signed(l: &lw.Lower, t: ty.TypeId) -> bool {
    return l.c.t.kind(t) == ty.Kind.Int and ty.is_signed(int_kind(l, t));
}

fn all_ones(l: &mut lw.Lower, s: ir.Ty) -> u32 {
    return lw.konst(l, s, 18446744073709551615);
}

/// a op b on integers of type t, with the traps of §7.2.
pub fn int_op(l: &mut lw.Lower, op: tk.Kind, t: ty.TypeId, a: u32, b: u32, n: cst.NodeId) -> u32 {
    let sg = signed(l, t);
    let s = layout.scalar(&l.c, t);
    match op {
        .Plus | .Minus | .Star => {
            var k = ir.OverflowKind.UAdd;
            if op == tk.Kind.Plus and sg {
                k = ir.OverflowKind.SAdd;
            } else if op == tk.Kind.Minus {
                k = ir.OverflowKind.USub;
                if sg {
                    k = ir.OverflowKind.SSub;
                }
            } else if op == tk.Kind.Star {
                k = ir.OverflowKind.UMul;
                if sg {
                    k = ir.OverflowKind.SMul;
                }
            }
            let r = lw.overflow(l, k, x: a, y: b);
            let over = lw.overflow_bit(l, r);
            lw.check(l, lw.bin(l, ir.BinKind.Xor, x: over, y: lw.konst(l, ir.Ty.I1, 1)), "integer overflow", n);
            return r;
        }
        .Slash | .Percent => {
            lw.check(l, lw.cmp(l, ir.CmpKind.Ne, x: b, y: lw.konst(l, s, 0)), "division by zero", n);
            if not sg {
                if op == tk.Kind.Slash {
                    return lw.bin(l, ir.BinKind.UDiv, x: a, y: b);
                }
                return lw.bin(l, ir.BinKind.URem, x: a, y: b);
            }
            let minus_one = lw.cmp(l, ir.CmpKind.Eq, x: b, y: all_ones(l, s));
            if op == tk.Kind.Slash {
                let min = lw.konst(l, s, 1 << (ty.bits(int_kind(l, t)) - 1) as u64);
                let bad = lw.bin(l, ir.BinKind.And, x: minus_one, y: lw.cmp(l, ir.CmpKind.Eq, x: a, y: min));
                lw.check(l, lw.bin(l, ir.BinKind.Xor, x: bad, y: lw.konst(l, ir.Ty.I1, 1)), "integer overflow", n);
                return lw.bin(l, ir.BinKind.SDiv, x: a, y: b);
            }
            // x % -1 is 0, and LLVM leaves MIN % -1 undefined: divide by 1 instead.
            let two = lw.bin(l, ir.BinKind.Shl, x: lw.lconvert(l, minus_one, s), y: lw.konst(l, s, 1));
            return lw.bin(l, ir.BinKind.SRem, x: a, y: lw.bin(l, ir.BinKind.Add, x: b, y: two));
        }
        .PlusWrap => { return lw.bin(l, ir.BinKind.Add, x: a, y: b); }
        .MinusWrap => { return lw.bin(l, ir.BinKind.Sub, x: a, y: b); }
        .StarWrap => { return lw.bin(l, ir.BinKind.Mul, x: a, y: b); }
        .Amp => { return lw.bin(l, ir.BinKind.And, x: a, y: b); }
        .Pipe => { return lw.bin(l, ir.BinKind.Or, x: a, y: b); }
        .Caret => { return lw.bin(l, ir.BinKind.Xor, x: a, y: b); }
        .Shl | .Shr => {
            let wide = lw.convert(l, b, ir.Ty.I64, false);
            let width = lw.konst(l, ir.Ty.I64, ty.bits(int_kind(l, t)) as u64);
            lw.check(l, lw.cmp(l, ir.CmpKind.ULt, x: wide, y: width), "shift amount too large", n);
            let amount = lw.convert(l, b, s, false);
            if op == tk.Kind.Shl {
                return lw.bin(l, ir.BinKind.Shl, x: a, y: amount);
            }
            if sg {
                return lw.bin(l, ir.BinKind.AShr, x: a, y: amount);
            }
            return lw.bin(l, ir.BinKind.LShr, x: a, y: amount);
        }
        _ => { return a; }
    }
}

fn unary(l: &mut lw.Lower, e: cst.NodeId) -> lw.Val {
    let toks = ck.own(&l.c, e);
    let op = ck.tok_kind(&l.c, toks[0]);
    let operand = child(l, e, 0);
    let t = type_of(l, e);
    if op == tk.Kind.Minus and kind(l, operand) == cst.Kind.IntLit {
        let v = ck.tok_value(&l.c, ck.tree(&l.c).first_token(operand));
        return scalar_val(lw.konst(l, layout.scalar(&l.c, t), ~v +% 1));
    }
    let x = value(l, operand).v;
    if op == tk.Kind.KwNot {
        return scalar_val(lw.bin(l, ir.BinKind.Xor, x: x, y: lw.konst(l, ir.Ty.I1, 1)));
    }
    let s = layout.scalar(&l.c, t);
    if l.c.t.kind(t) == ty.Kind.Float {
        var i = ir.inst(ir.Op.FNeg, s);
        i.a = x;
        return scalar_val(lw.emit(l, i));
    }
    if op == tk.Kind.Tilde {
        return scalar_val(lw.bin(l, ir.BinKind.Xor, x: x, y: all_ones(l, s)));
    }
    let r = lw.overflow(l, ir.OverflowKind.SSub, x: lw.konst(l, s, 0), y: x);
    let over = lw.overflow_bit(l, r);
    lw.check(l, lw.bin(l, ir.BinKind.Xor, x: over, y: lw.konst(l, ir.Ty.I1, 1)), "integer overflow", e);
    return scalar_val(r);
}

/// a == b for values of type t at addresses (§5.5): field by field.
fn equal_at(l: &mut lw.Lower, t: ty.TypeId, a: u32, b: u32) -> u32 {
    let info = l.c.t.get(t);
    if info.kind == ty.Kind.Enum {
        return lw.cmp(l, ir.CmpKind.Eq, x: lw.load(l, ir.Ty.I32, a), y: lw.load(l, ir.Ty.I32, b));
    }
    if info.kind == ty.Kind.Struct {
        let d = l.c.decls[info.decl as usize];
        var r = lw.konst(l, ir.Ty.I1, 1);
        var f = d.members_start;
        while f < d.members_start + d.members_len : (f += 1) {
            let off = layout.field_offset(&l.c, start: d.members_start, i: f);
            let ft = l.c.fields[f as usize].type_id;
            var fa = lw.gep(l, a, off);
            var fb = lw.gep(l, b, off);
            if d.packed {
                fa = lw.gep_unaligned(l, a, off);
                fb = lw.gep_unaligned(l, b, off);
            }
            let fe = equal_at(l, ft, a: fa, b: fb);
            r = lw.bin(l, ir.BinKind.And, x: r, y: fe);
        }
        return r;
    }
    let s = layout.scalar(&l.c, t);
    if info.kind == ty.Kind.Float {
        return fcmp(l, ir.FCmpKind.Eq, x: lw.load(l, s, a), y: lw.load(l, s, b));
    }
    return lw.cmp(l, ir.CmpKind.Eq, x: lw.load(l, s, a), y: lw.load(l, s, b));
}

fn equal(l: &mut lw.Lower, t: ty.TypeId, a: lw.Val, b: lw.Val) -> u32 {
    if a.scalar {
        return lw.cmp(l, ir.CmpKind.Eq, x: a.v, y: b.v);
    }
    return equal_at(l, t, a: a.v, b: b.v);
}

fn binary(l: &mut lw.Lower, e: cst.NodeId) -> lw.Val {
    let toks = ck.own(&l.c, e);
    let op = ck.tok_kind(&l.c, toks[0]);
    let lhs = child(l, e, 0);
    let rhs = child(l, e, 1);
    if op == tk.Kind.KwAnd or op == tk.Kind.KwOr {
        let result = lw.alloca(l, ty.bool_type());
        let x = value(l, lhs).v;
        lw.store(l, value: x, addr: result);
        let more = lw.new_block(l);
        let done = lw.new_block(l);
        if op == tk.Kind.KwAnd {
            lw.cond_br(l, cond: x, yes: more, no: done);
        } else {
            lw.cond_br(l, cond: x, yes: done, no: more);
        }
        lw.switch_to(l, more);
        let y = value(l, rhs).v;
        lw.store(l, value: y, addr: result);
        lw.br(l, done);
        lw.switch_to(l, done);
        return scalar_val(lw.load(l, ir.Ty.I1, result));
    }
    let t = type_of(l, lhs);
    let a = lw.own_val(l, t, value(l, lhs));
    let b = value(l, rhs);
    if l.c.t.kind(t) == ty.Kind.Float {
        // IEEE 754: no traps; every comparison with a NaN is false but !=.
        let s = layout.scalar(&l.c, t);
        match op {
            .EqEq => { return scalar_val(fcmp(l, ir.FCmpKind.Eq, x: a.v, y: b.v)); }
            .NotEq => { return scalar_val(fcmp(l, ir.FCmpKind.Ne, x: a.v, y: b.v)); }
            .Lt => { return scalar_val(fcmp(l, ir.FCmpKind.Lt, x: a.v, y: b.v)); }
            .Le => { return scalar_val(fcmp(l, ir.FCmpKind.Le, x: a.v, y: b.v)); }
            .Gt => { return scalar_val(fcmp(l, ir.FCmpKind.Gt, x: a.v, y: b.v)); }
            .Ge => { return scalar_val(fcmp(l, ir.FCmpKind.Ge, x: a.v, y: b.v)); }
            .Plus => { return scalar_val(fbin(l, ir.FBinKind.Add, s, x: a.v, y: b.v)); }
            .Minus => { return scalar_val(fbin(l, ir.FBinKind.Sub, s, x: a.v, y: b.v)); }
            .Star => { return scalar_val(fbin(l, ir.FBinKind.Mul, s, x: a.v, y: b.v)); }
            _ => { return scalar_val(fbin(l, ir.FBinKind.Div, s, x: a.v, y: b.v)); }
        }
    }
    match op {
        .EqEq => { return scalar_val(equal(l, t, a: a, b: b)); }
        .NotEq => {
            let eq = equal(l, t, a: a, b: b);
            return scalar_val(lw.bin(l, ir.BinKind.Xor, x: eq, y: lw.konst(l, ir.Ty.I1, 1)));
        }
        .Lt | .Le | .Gt | .Ge => {
            let sg = signed(l, t);
            var k = ir.CmpKind.ULt;
            if op == tk.Kind.Lt and sg { k = ir.CmpKind.SLt; }
            if op == tk.Kind.Le { k = ir.CmpKind.ULe; if sg { k = ir.CmpKind.SLe; } }
            if op == tk.Kind.Gt { k = ir.CmpKind.UGt; if sg { k = ir.CmpKind.SGt; } }
            if op == tk.Kind.Ge { k = ir.CmpKind.UGe; if sg { k = ir.CmpKind.SGe; } }
            return scalar_val(lw.cmp(l, k, x: a.v, y: b.v));
        }
        _ => { return scalar_val(int_op(l, op, type_of(l, e), a: a.v, b: b.v, e)); }
    }
}

/// `as` checks that the value fits; `as%` keeps the low bits (§5.6).
fn cast(l: &mut lw.Lower, e: cst.NodeId) -> lw.Val {
    let operand = child(l, e, 0);
    let from = type_of(l, operand);
    let to = type_of(l, e);
    let x = value(l, operand).v;
    let wrap = ck.tok_kind(&l.c, ck.own(&l.c, e)[0]) == tk.Kind.KwAsWrap;
    let from_float = l.c.t.kind(from) == ty.Kind.Float;
    let to_float = l.c.t.kind(to) == ty.Kind.Float;
    if from_float and to_float {
        let ts_ = layout.scalar(&l.c, to);
        if l.c.t.get(from).len == l.c.t.get(to).len {
            return scalar_val(x);
        }
        if l.c.t.get(to).len == 32 {
            return scalar_val(fconv(l, ir.FConvKind.Trunc, x, ts_));
        }
        return scalar_val(fconv(l, ir.FConvKind.Ext, x, ts_));
    }
    if to_float {
        // Rounds to nearest (spec/arche.md §2.3).
        if signed(l, from) {
            return scalar_val(fconv(l, ir.FConvKind.FromSI, x, layout.scalar(&l.c, to)));
        }
        return scalar_val(fconv(l, ir.FConvKind.FromUI, x, layout.scalar(&l.c, to)));
    }
    if from_float {
        return scalar_val(float_to_int(l, e, x, from: from, to: to, wrapping: wrap));
    }
    let fs = signed(l, from);
    let ts = signed(l, to);
    let fb = ty.bits(int_kind(l, from));
    let tb = ty.bits(int_kind(l, to));
    let s = layout.scalar(&l.c, to);
    if l.c.t.kind(to) == ty.Kind.Ptr {
        return scalar_val(x); // a view or pointer as a pointer: the same address
    }
    let wrapping = ck.tok_kind(&l.c, ck.own(&l.c, e)[0]) == tk.Kind.KwAsWrap;
    if not wrapping {
        let fsx = layout.scalar(&l.c, from);
        var fine = lw.konst(l, ir.Ty.I1, 1);
        if fs and not ts {
            fine = lw.cmp(l, ir.CmpKind.SGe, x: x, y: lw.konst(l, fsx, 0));
        }
        // Too large: only when the target holds less of the positive range.
        let to_max = ty.max_value(int_kind(l, to));
        let from_max = ty.max_value(int_kind(l, from));
        if to_max < from_max {
            var k = ir.CmpKind.ULe;
            if fs {
                k = ir.CmpKind.SLe;
            }
            fine = lw.bin(l, ir.BinKind.And, x: fine, y: lw.cmp(l, k, x: x, y: lw.konst(l, fsx, to_max)));
        }
        if fs and ts and tb < fb {
            let min = ~(ty.min_magnitude(int_kind(l, to))) +% 1;
            fine = lw.bin(l, ir.BinKind.And, x: fine, y: lw.cmp(l, ir.CmpKind.SGe, x: x, y: lw.konst(l, fsx, min)));
        }
        var msg = alloc.String.init(l.a);
        msg.push_str("value does not fit in ");
        msg.push_str(ty.int_name(int_kind(l, to)));
        lw.check(l, fine, msg.view(), e);
    }
    return scalar_val(lw.convert(l, x, s, fs));
}

// ---- calls ---------------------------------------------------------------------------

fn arg_node(l: &lw.Lower, call_node: cst.NodeId, i: u32) -> cst.NodeId {
    return child(l, child(l, call_node, i + 1), 0);
}

/// The i-th run-time argument of a call whose comptime ones come first.
fn runtime_arg(l: &lw.Lower, call_node: cst.NodeId, offset: u32, i: u32) -> cst.NodeId {
    return child(l, child(l, call_node, offset + i + 1), 0);
}

/// The receiver's address for a method taking self by reference.
fn receiver_addr(l: &mut lw.Lower, receiver: cst.NodeId) -> u32 {
    if l.c.t.kind(type_of(l, receiver)) == ty.Kind.Ref {
        return value(l, receiver).v;
    }
    return address(l, receiver);
}

fn result_of(l: &mut lw.Lower, t: ty.TypeId, r: u32, sret: u32) -> lw.Val {
    if l.c.t.kind(t) == ty.Kind.Noreturn {
        _ = lw.emit(l, ir.inst(ir.Op.Unreachable, ir.Ty.Void));
        lw.after_terminator(l);
        return nothing();
    }
    if sret != ck.NONE {
        return fresh_val(sret);
    }
    if layout.is_nothing(&l.c, t) {
        return nothing();
    }
    return scalar_val(r);
}

/// Calls method d, which takes only self, with self at self_addr: the iter
/// and next of a for loop (spec/arche.md §3.2).
pub fn call_self(l: &mut lw.Lower, d: u32, self_addr: u32) -> lw.Val {
    let fi = l.c.decls[d as usize].fn_index;
    let info = l.c.fns[fi as usize];
    var args = lw.args0(l);
    var sret = ck.NONE;
    if lw.returns_in_memory(&l.c, info.ret) {
        sret = lw.alloca(l, info.ret);
        args.push(sret);
    }
    if info.self_mode == ck.SelfMode.Value {
        let st = l.c.params[info.params_start as usize].type_id;
        let v = lw.load_val(l, st, self_addr);
        args.push(lw.as_arg(l, st, v));
    } else {
        args.push(self_addr);
    }
    let r = lw.call_with(l, fi, false, lw.ret_ty(&l.c, info.ret), &args);
    return result_of(l, info.ret, r: r, sret: sret);
}

/// The address of a receiver's value: a place, or a temporary holding it.
pub fn self_address(l: &mut lw.Lower, receiver: cst.NodeId) -> u32 {
    let t = type_of(l, receiver);
    if l.c.t.kind(t) == ty.Kind.Ref {
        return value(l, receiver).v;
    }
    if is_place(l, receiver) {
        return address(l, receiver);
    }
    return in_memory(l, t, value(l, receiver));
}

/// A function of core.mem, which the compiler writes in place (lib/core/mem.arche).
fn intrinsic(l: &mut lw.Lower, n: cst.NodeId, d: u32) -> lw.Val {
    let decl = l.c.decls[d as usize];
    var name = alloc.String.init(l.a);
    name.push_str(l.c.names.text(decl.name));
    let nm = name.view();
    let info = l.c.fns[decl.fn_index as usize];
    var t = ty.invalid();
    if decl.env_len > 0 {
        t = l.c.env[decl.env_start as usize].type_id;
    }
    let rt = type_of(l, n);
    if ck.is_atomic_op(&l.c, d) {
        return atomic(l, n, nm, info.ncomptime);
    }
    if nm.eq("size_of") {
        return scalar_val(lw.konst(l, ir.Ty.I64, layout.layout(&l.c, t).size));
    }
    if nm.eq("align_of") {
        return scalar_val(lw.konst(l, ir.Ty.I64, layout.layout(&l.c, t).align));
    }
    if nm.eq("null") {
        return scalar_val(lw.konst(l, ir.Ty.Ptr, 0));
    }
    if nm.eq("from_addr") {
        var i = ir.inst(ir.Op.IntToPtr, ir.Ty.Ptr);
        i.a = value(l, runtime_arg(l, n, offset: info.ncomptime, i: 0)).v;
        return scalar_val(lw.emit(l, i));
    }
    let a0 = value(l, runtime_arg(l, n, offset: info.ncomptime, i: 0));
    // core.float: the same bits as the other type, which an Ext between two
    // types of one width is.
    if nm.eq("bits64") or nm.eq("bits32") or nm.eq("from_bits64") or nm.eq("from_bits32") {
        var i = ir.inst(ir.Op.Ext, layout.scalar(&l.c, rt));
        i.a = a0.v;
        return scalar_val(lw.emit(l, i));
    }
    if nm.eq("str_from") {
        return lw.own_val(l, rt, a0);
    }
    if nm.eq("str_data") or nm.eq("slice_data") {
        return scalar_val(lw.load(l, ir.Ty.Ptr, a0.v));
    }
    // A &dyn fn is {captures, table}; a closure's table is {code, size + 1}.
    if nm.eq("closure_env") {
        return scalar_val(lw.load(l, ir.Ty.Ptr, a0.v));
    }
    if nm.eq("closure_code") or nm.eq("closure_size") {
        let table = lw.load(l, ir.Ty.Ptr, lw.gep(l, a0.v, 8));
        if nm.eq("closure_code") {
            return scalar_val(lw.load(l, ir.Ty.Ptr, table));
        }
        let stored = lw.load(l, ir.Ty.I64, lw.gep(l, table, 8));
        return scalar_val(lw.bin(l, ir.BinKind.Sub, x: stored, y: lw.konst(l, ir.Ty.I64, 1)));
    }
    if nm.eq("bytes_of") {
        let tmp = lw.alloca(l, rt);
        lw.store(l, value: a0.v, addr: tmp);
        lw.store(l, value: lw.konst(l, ir.Ty.I64, layout.layout(&l.c, t).size), addr: lw.gep(l, tmp, 8));
        return fresh_val(tmp);
    }
    let a1 = value(l, runtime_arg(l, n, offset: info.ncomptime, i: 1));
    if nm.eq("alloc") {
        var args = lw.args0(l);
        args.push(a0.v);
        args.push(a1.v);
        return scalar_val(lw.call_runtime(l, "a0rt_alloc_in", ir.Ty.Ptr, &args));
    }
    if nm.eq("slice") or nm.eq("slice_mut") {
        let tmp = lw.alloca(l, rt);
        lw.store(l, value: a0.v, addr: tmp);
        lw.store(l, value: a1.v, addr: lw.gep(l, tmp, 8));
        return fresh_val(tmp);
    }
    // copy
    let a2 = value(l, runtime_arg(l, n, offset: info.ncomptime, i: 2));
    var args = lw.args0(l);
    args.push(a0.v);
    args.push(a1.v);
    args.push(a2.v);
    _ = lw.call_runtime(l, "a0rt_memmove", ir.Ty.Void, &args);
    return nothing();
}

/// core.atomic's operations, as LLVM's atomic instructions.
fn atomic(l: &mut lw.Lower, n: cst.NodeId, nm: str, offset: u32) -> lw.Val {
    let nargs = count(l, n) - 1;
    let order = sx.ordering_of(&l.c, child(l, child(l, n, nargs), 0));
    if nm.eq("fence") {
        var i = ir.inst(ir.Op.Fence, ir.Ty.Void);
        i.flag = order;
        _ = lw.emit(l, i);
        return nothing();
    }
    let p = value(l, runtime_arg(l, n, offset: offset, i: 0)).v;
    let rt = type_of(l, n);
    if nm.eq("load") {
        var i = ir.inst(ir.Op.AtomicLoad, layout.scalar(&l.c, rt));
        i.a = p;
        i.flag = order;
        return scalar_val(lw.emit(l, i));
    }
    let v = value(l, runtime_arg(l, n, offset: offset, i: 1)).v;
    if nm.eq("store") {
        var i = ir.inst(ir.Op.AtomicStore, ir.Ty.Void);
        i.a = v;
        i.b = p;
        i.flag = order;
        _ = lw.emit(l, i);
        return nothing();
    }
    if nm.eq("compare_exchange") {
        let w = value(l, runtime_arg(l, n, offset: offset, i: 2)).v;
        var i = ir.inst(ir.Op.CmpXchg, layout.scalar(&l.c, rt));
        i.a = p;
        i.b = v;
        i.c = w;
        i.flag = order;
        return scalar_val(lw.emit(l, i));
    }
    var k = ir.RMW_XCHG;
    if nm.eq("fetch_add") {
        k = ir.RMW_ADD;
    } else if nm.eq("fetch_sub") {
        k = ir.RMW_SUB;
    } else if nm.eq("fetch_and") {
        k = ir.RMW_AND;
    } else if nm.eq("fetch_or") {
        k = ir.RMW_OR;
    }
    var i = ir.inst(ir.Op.AtomicRmw, layout.scalar(&l.c, rt));
    i.a = p;
    i.b = v;
    i.flag = order | (k << 8);
    return scalar_val(lw.emit(l, i));
}

fn call(l: &mut lw.Lower, n: cst.NodeId) -> lw.Val {
    let callee = child(l, n, 0);
    let intrinsic_d = ck.ref_of(&l.c, n);
    if intrinsic_d != ck.NONE and ck.is_intrinsic(&l.c, intrinsic_d) {
        return intrinsic(l, n, intrinsic_d);
    }
    if kind(l, callee) == cst.Kind.NameExpr and not ck.is_invalid(&l.c, type_of(l, callee)) {
        return closure_call(l, n);
    }
    let t = type_of(l, n);
    let nargs = count(l, n) - 1;
    let is_method = kind(l, callee) == cst.Kind.FieldExpr and not ck.is_invalid(&l.c, type_of(l, callee));
    let d = ck.ref_of(&l.c, n);
    if d != ck.NONE and ck.is_extern_fn(&l.c, d) {
        // A foreign function, by its own name, with scalars only.
        let info = l.c.fns[l.c.decls[d as usize].fn_index as usize];
        var args = lw.args0(l);
        var i: u32 = 0;
        while i < nargs : (i += 1) {
            args.push(value(l, arg_node(l, n, i)).v);
        }
        var name = alloc.String.init(l.a);
        name.push_str(l.c.names.text(l.c.decls[d as usize].name));
        let rt = lw.ret_ty(&l.c, info.ret);
        let r = lw.call_runtime(l, name.view(), rt, &args);
        return result_of(l, t, r: r, sret: ck.NONE);
    }
    if is_method and d != ck.NONE and l.c.decls[d as usize].owner != ck.NONE and
        l.c.decls[l.c.decls[d as usize].owner as usize].kind == ck.DeclKind.Interface {
        return dyn_call(l, n, d);
    }
    if d != ck.NONE and l.c.decls[d as usize].kind == ck.DeclKind.Fn {
        let fi = l.c.decls[d as usize].fn_index;
        let info = l.c.fns[fi as usize];
        var args = lw.args0(l);
        var sret = ck.NONE;
        if lw.returns_in_memory(&l.c, info.ret) {
            sret = lw.alloca(l, info.ret);
            args.push(sret);
        }
        var skip: u32 = 0;
        if is_method {
            skip = 1;
            let receiver = child(l, callee, 0);
            if info.self_mode == ck.SelfMode.Value {
                let st = l.c.params[info.params_start as usize].type_id;
                var v = value(l, receiver);
                if l.c.t.kind(type_of(l, receiver)) == ty.Kind.Ref {
                    v = lw.load_val(l, st, v.v);
                }
                args.push(lw.as_arg(l, st, v));
            } else {
                args.push(receiver_addr(l, receiver));
            }
        }
        var i: u32 = 0;
        while i + info.ncomptime < nargs : (i += 1) {
            let pt = l.c.params[(info.params_start + skip + i) as usize].type_id;
            let v = value(l, runtime_arg(l, n, offset: info.ncomptime, i: i));
            args.push(lw.as_arg(l, pt, v));
        }
        let r = lw.call_with(l, fi, false, lw.ret_ty(&l.c, info.ret), &args);
        return result_of(l, t, r: r, sret: sret);
    }
    if is_method {
        return builtin_method(l, n: n, callee: callee);
    }
    if kind(l, callee) == cst.Kind.FieldExpr {
        return init(l, n, t);
    }
    return builtin_fn(l, n);
}

/// T.init(a) of alloc.List, alloc.Map, alloc.String and alloc.Interner:
/// zeroed memory and the allocator in its slot (docs/abi.md).
fn init(l: &mut lw.Lower, n: cst.NodeId, t: ty.TypeId) -> lw.Val {
    let a = value(l, arg_node(l, n, 0)).v;
    let tmp = lw.alloca(l, t);
    let info = l.c.t.get(t);
    var at: u64 = 24;
    if info.kind == ty.Kind.Map {
        at = 48;
    } else if info.kind == ty.Kind.Builtin and info.builtin == ty.Builtin.Interner {
        at = 40;
    }
    lw.store(l, value: a, addr: lw.gep(l, tmp, at));
    return fresh_val(tmp);
}

fn builtin_fn(l: &mut lw.Lower, n: cst.NodeId) -> lw.Val {
    let callee = child(l, n, 0);
    let name = ck.text(&l.c, ck.ident_of(&l.c, callee));
    if name.eq("panic") {
        let m = value(l, arg_node(l, n, 0)).v;
        let p = lw.load(l, ir.Ty.Ptr, m);
        let len = lw.load(l, ir.Ty.I64, lw.gep(l, m, 8));
        lw.trap_with(l, message_ptr: p, message_len: len, n);
    } else if name.eq("assert") {
        let c = value(l, arg_node(l, n, 0)).v;
        lw.check(l, c, "assertion failed", n);
    } else {
        lw.trap(l, "reached unreachable code", n);
    }
    return nothing();
}

/// The data and length of a str argument, as two scalars.
fn str_parts(l: &mut lw.Lower, s: lw.Val, args: &mut alloc.List(u32)) {
    args.push(lw.load(l, ir.Ty.Ptr, s.v));
    args.push(lw.load(l, ir.Ty.I64, lw.gep(l, s.v, 8)));
}

/// A value's address in memory: a scalar is stored in a temporary first.
pub fn in_memory(l: &mut lw.Lower, t: ty.TypeId, v: lw.Val) -> u32 {
    if v.scalar {
        let tmp = lw.alloca(l, t);
        lw.store(l, value: v.v, addr: tmp);
        return tmp;
    }
    return lw.own_val(l, t, v).v;
}

/// A {data, len} view of the list or String at addr.
fn view_of_run(l: &mut lw.Lower, t: ty.TypeId, addr: u32) -> lw.Val {
    let tmp = lw.alloca(l, t);
    lw.memcpy(l, dst: tmp, src: addr, 16);
    return fresh_val(tmp);
}

fn builtin_method(l: &mut lw.Lower, n: cst.NodeId, callee: cst.NodeId) -> lw.Val {
    let receiver = child(l, callee, 0);
    var rt = type_of(l, receiver);
    if l.c.t.kind(rt) == ty.Kind.Ref {
        rt = l.c.t.elem(rt);
    }
    let result_t = type_of(l, n);
    var name = alloc.String.init(l.a);
    name.push_str(ck.text(&l.c, sx.member_token(&l.c, callee)));
    let nm = name.view();
    let info = l.c.t.get(rt);
    if info.kind == ty.Kind.Float {
        let s = layout.scalar(&l.c, rt);
        var i = ir.inst(ir.Op.FMath, s);
        i.a = value(l, receiver).v;
        if nm.eq("sqrt") {
            i.flag = ir.fmath_flag(ir.FMathKind.Sqrt);
        } else if nm.eq("abs") {
            i.flag = ir.fmath_flag(ir.FMathKind.Abs);
        } else if nm.eq("floor") {
            i.flag = ir.fmath_flag(ir.FMathKind.Floor);
        } else if nm.eq("ceil") {
            i.flag = ir.fmath_flag(ir.FMathKind.Ceil);
        } else if nm.eq("trunc") {
            i.flag = ir.fmath_flag(ir.FMathKind.Trunc);
        } else if nm.eq("rem") {
            i.flag = ir.fmath_flag(ir.FMathKind.Rem);
            i.b = value(l, arg_node(l, n, 0)).v;
        } else {
            i.flag = ir.fmath_flag(ir.FMathKind.Fma);
            i.b = value(l, arg_node(l, n, 0)).v;
            i.c = value(l, arg_node(l, n, 1)).v;
        }
        return scalar_val(lw.emit(l, i));
    }
    if info.kind == ty.Kind.Ptr {
        let p = value(l, receiver).v;
        if nm.eq("add") {
            let k = value(l, arg_node(l, n, 0)).v;
            return scalar_val(lw.gep_index(l, addr: p, index: k, size_of(l, info.elem)));
        }
        if nm.eq("read_volatile") {
            let s = layout.scalar(&l.c, info.elem);
            return scalar_val(lw.load_with(l, s, addr: p, flags: ir.LOAD_VOLATILE));
        }
        if nm.eq("write_volatile") {
            let v = value(l, arg_node(l, n, 0));
            lw.store_with(l, value: v.v, addr: p, flags: ir.LOAD_VOLATILE);
            return nothing();
        }
        if nm.eq("addr") {
            var i = ir.inst(ir.Op.PtrToInt, ir.Ty.I64);
            i.a = p;
            return scalar_val(lw.emit(l, i));
        }
        return scalar_val(p); // as_ref, as_mut: the same address
    }
    let r = receiver_addr(l, receiver);
    match info.kind {
        .Str => {
            if nm.eq("len") {
                return scalar_val(lw.load(l, ir.Ty.I64, lw.gep(l, r, 8)));
            }
            if nm.eq("bytes") {
                return view_of_run(l, result_t, r);
            }
            var args = lw.args0(l);
            str_parts(l, lw.Val { v: r, scalar: false, fresh: false }, &mut args);
            let other = value(l, arg_node(l, n, 0));
            str_parts(l, other, &mut args);
            var rtname = "a0rt_str_eq";
            if nm.eq("starts_with") {
                rtname = "a0rt_str_starts_with";
            }
            let b = lw.call_runtime(l, rtname, ir.Ty.I8, &args);
            return scalar_val(lw.cmp(l, ir.CmpKind.Ne, x: b, y: lw.konst(l, ir.Ty.I8, 0)));
        }
        .Array => { return scalar_val(lw.konst(l, ir.Ty.I64, info.len)); }
        .Slice => { return scalar_val(lw.load(l, ir.Ty.I64, lw.gep(l, r, 8))); }
        .List => { return list_method(l, n, nm, rt, r); }
        .Map => { return map_method(l, n, nm, rt, r); }
        .Builtin => { return library_method(l, n, nm, info.builtin, r); }
        _ => { return nothing(); }
    }
}

fn list_method(l: &mut lw.Lower, n: cst.NodeId, nm: str, t: ty.TypeId, r: u32) -> lw.Val {
    let et = l.c.t.elem(t);
    let size = size_of(l, et);
    let len_addr = lw.gep(l, r, 8);
    if nm.eq("push") {
        let item = lw.own_val(l, et, value(l, arg_node(l, n, 0)));
        var args = lw.args0(l);
        args.push(r);
        args.push(lw.konst(l, ir.Ty.I64, size));
        _ = lw.call_runtime(l, "a0rt_list_reserve", ir.Ty.Void, &args);
        let data = lw.load(l, ir.Ty.Ptr, r);
        let len = lw.load(l, ir.Ty.I64, len_addr);
        lw.store_val(l, et, item, lw.gep_index(l, addr: data, index: len, size));
        lw.store(l, value: lw.bin(l, ir.BinKind.Add, x: len, y: lw.konst(l, ir.Ty.I64, 1)), addr: len_addr);
        return nothing();
    }
    if nm.eq("pop") {
        let ot = type_of(l, n);
        let tmp = lw.alloca(l, ot);
        let len = lw.load(l, ir.Ty.I64, len_addr);
        let some_left = lw.cmp(l, ir.CmpKind.Ne, x: len, y: lw.konst(l, ir.Ty.I64, 0));
        let yes = lw.new_block(l);
        let done = lw.new_block(l);
        lw.cond_br(l, cond: some_left, yes: yes, no: done);
        lw.switch_to(l, yes);
        let last = lw.bin(l, ir.BinKind.Sub, x: len, y: lw.konst(l, ir.Ty.I64, 1));
        lw.store(l, value: last, addr: len_addr);
        let data = lw.load(l, ir.Ty.Ptr, r);
        lw.memcpy(l, dst: lw.gep(l, tmp, layout.value_offset(&l.c, ot)), src: lw.gep_index(l, addr: data, index: last, size), size);
        lw.store(l, value: lw.konst(l, ir.Ty.I8, 1), addr: tmp);
        lw.br(l, done);
        lw.switch_to(l, done);
        return fresh_val(tmp);
    }
    if nm.eq("len") {
        return scalar_val(lw.load(l, ir.Ty.I64, len_addr));
    }
    if nm.eq("clear") {
        lw.store(l, value: lw.konst(l, ir.Ty.I64, 0), addr: len_addr);
        return nothing();
    }
    return view_of_run(l, type_of(l, n), r); // items, items_mut
}

fn map_method(l: &mut lw.Lower, n: cst.NodeId, nm: str, t: ty.TypeId, r: u32) -> lw.Val {
    let info = l.c.t.get(t);
    let kt = info.key;
    let vt = info.elem;
    let ksize = lw.konst(l, ir.Ty.I64, size_of(l, kt));
    let vsize = lw.konst(l, ir.Ty.I64, size_of(l, vt));
    if nm.eq("len") {
        return scalar_val(lw.load(l, ir.Ty.I64, lw.gep(l, r, 40)));
    }
    let key = in_memory(l, kt, value(l, arg_node(l, n, 0)));
    var args = lw.args0(l);
    args.push(r);
    args.push(key);
    args.push(ksize);
    if nm.eq("put") {
        let v = in_memory(l, vt, value(l, arg_node(l, n, 1)));
        args.push(v);
        args.push(vsize);
        _ = lw.call_runtime(l, "a0rt_map_put", ir.Ty.Void, &args);
        return nothing();
    }
    let ot = type_of(l, n);
    let tmp = lw.alloca(l, ot);
    let at = lw.gep(l, tmp, layout.value_offset(&l.c, ot));
    args.push(vsize);
    if nm.eq("remove") {
        args.push(at);
        let found = lw.call_runtime(l, "a0rt_map_remove", ir.Ty.I8, &args);
        lw.store(l, value: found, addr: tmp);
        return fresh_val(tmp);
    }
    let p = lw.call_runtime(l, "a0rt_map_get", ir.Ty.Ptr, &args);
    let null = lw.konst(l, ir.Ty.Ptr, 0);
    let yes = lw.new_block(l);
    let done = lw.new_block(l);
    lw.cond_br(l, cond: lw.cmp(l, ir.CmpKind.Ne, x: p, y: null), yes: yes, no: done);
    lw.switch_to(l, yes);
    lw.memcpy(l, dst: at, src: p, size_of(l, vt));
    lw.store(l, value: lw.konst(l, ir.Ty.I8, 1), addr: tmp);
    lw.br(l, done);
    lw.switch_to(l, done);
    return fresh_val(tmp);
}

fn library_method(l: &mut lw.Lower, n: cst.NodeId, nm: str, b: ty.Builtin, r: u32) -> lw.Val {
    var args = lw.args0(l);
    args.push(r);
    match b {
        .Output => {
            let x = value(l, arg_node(l, n, 0));
            if nm.eq("write") {
                str_parts(l, x, &mut args);
                _ = lw.call_runtime(l, "a0rt_write", ir.Ty.Void, &args);
            } else {
                args.push(x.v);
                var rtname = "a0rt_write_byte";
                if nm.eq("write_u64") {
                    rtname = "a0rt_write_u64";
                } else if nm.eq("write_i64") {
                    rtname = "a0rt_write_i64";
                } else if nm.eq("write_f64") {
                    rtname = "a0rt_write_f64";
                } else if nm.eq("write_f32") {
                    rtname = "a0rt_write_f32";
                }
                _ = lw.call_runtime(l, rtname, ir.Ty.Void, &args);
            }
            return nothing();
        }
        .Args => {
            let len = lw.load(l, ir.Ty.I64, lw.gep(l, r, 8));
            if nm.eq("len") {
                return scalar_val(len);
            }
            let i = value(l, arg_node(l, n, 0)).v;
            lw.check(l, lw.cmp(l, ir.CmpKind.ULt, x: i, y: len), "argument index out of range", n);
            let items = lw.load(l, ir.Ty.Ptr, r);
            return view_of_run(l, ty.str_type(), lw.gep_index(l, addr: items, index: i, 16));
        }
        .Fs => {
            let path = value(l, arg_node(l, n, 0));
            str_parts(l, path, &mut args);
            if nm.eq("write_file") or nm.eq("write_bytes") or nm.eq("write_executable") {
                let data = value(l, arg_node(l, n, 1));
                str_parts(l, data, &mut args);
                if nm.eq("write_executable") {
                    return scalar_val(lw.call_runtime(l, "a0rt_write_executable", ir.Ty.I16, &args));
                }
                return scalar_val(lw.call_runtime(l, "a0rt_write_file", ir.Ty.I16, &args));
            }
            // The allocator's handle: a u64, also inside lib/alloc's Allocator.
            let av = value(l, arg_node(l, n, 1));
            if av.scalar {
                args.push(av.v);
            } else {
                args.push(lw.load(l, ir.Ty.I64, av.v));
            }
            let tmp = lw.alloca(l, type_of(l, n));
            args.push(tmp);
            var rtname = "a0rt_read_file";
            if nm.eq("read_bytes") {
                rtname = "a0rt_read_bytes";
            }
            _ = lw.call_runtime(l, rtname, ir.Ty.Void, &args);
            return fresh_val(tmp);
        }
        .String => {
            if nm.eq("view") {
                return view_of_run(l, ty.str_type(), r);
            }
            if nm.eq("len") {
                return scalar_val(lw.load(l, ir.Ty.I64, lw.gep(l, r, 8)));
            }
            if nm.eq("push_str") {
                let text = value(l, arg_node(l, n, 0));
                str_parts(l, text, &mut args);
            } else {
                let byte = value(l, arg_node(l, n, 0)).v;
                lw.check(l, lw.cmp(l, ir.CmpKind.ULe, x: byte, y: lw.konst(l, ir.Ty.I8, 127)),
                    "push_ascii takes ASCII, a byte up to 0x7F", n);
                let tmp = lw.alloca_bytes(l, size: 1, align: 1);
                lw.store(l, value: byte, addr: tmp);
                args.push(tmp);
                args.push(lw.konst(l, ir.Ty.I64, 1));
            }
            _ = lw.call_runtime(l, "a0rt_bytes_push", ir.Ty.Void, &args);
            return nothing();
        }
        .Interner => {
            if nm.eq("intern") {
                let text = value(l, arg_node(l, n, 0));
                str_parts(l, text, &mut args);
                return scalar_val(lw.call_runtime(l, "a0rt_intern", ir.Ty.I32, &args));
            }
            let sym = value(l, arg_node(l, n, 0)).v;
            let wide = lw.convert(l, sym, ir.Ty.I64, false);
            let len = lw.load(l, ir.Ty.I64, lw.gep(l, r, 8));
            lw.check(l, lw.cmp(l, ir.CmpKind.ULt, x: wide, y: len), "this symbol is not from this interner", n);
            let texts = lw.load(l, ir.Ty.Ptr, r);
            return view_of_run(l, ty.str_type(), lw.gep_index(l, addr: texts, index: wide, 16));
        }
        _ => { return nothing(); }
    }
}
