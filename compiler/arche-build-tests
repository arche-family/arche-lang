#!/bin/sh
# Builds the test blocks of a file into a test binary: the compiler command
# the conformance runner calls for conformance/testrunner (arche test).
# Usage: arche-build-tests <source.arche> <output>
set -eu
if [ $# -ne 2 ]; then
    echo "usage: arche-build-tests <source.arche> <output>" >&2
    exit 2
fi
here=$(cd "$(dirname "$0")" && pwd)
. "$here/target.sh"
cc=$CLANG
rt="$here/build/rt-$ARCHE_TARGET.o"
if [ ! -f "$rt" ] || [ "$here/runtime/rt.c" -nt "$rt" ] || [ "$here/runtime/math.inc" -nt "$rt" ] ||
    [ "$here/runtime/linux.inc" -nt "$rt" ] || [ "$here/runtime/windows.inc" -nt "$rt" ]; then
    $cc -c -O2 -ffreestanding -fno-builtin -nostdlib -fno-stack-protector $RT_FLAGS -Wall -Wextra -Werror \
        -o "$rt.tmp.$$" "$here/runtime/rt.c"
    mv "$rt.tmp.$$" "$rt"
fi
if [ "$ARCHE_BACKEND" = own ]; then
    "${ARCHE:-$here/build/arche}" ${ARCHE_FLAGS:-} $TARGET_FLAG test "$1" "$2.o"
    "$LLD" -static -o "$2" "$2.o" "$rt"
else
    "${ARCHE:-$here/build/arche}" ${ARCHE_FLAGS:-} $TARGET_FLAG test "$1" "$2.ll"
    $cc -O1 $LINK_FLAGS -Wno-override-module -o "$2" "$2.ll" "$rt"
fi
