/// What every processor's backend does the same way: how each value of a
/// function lives, its live range, and which register it gets.
///
/// Constants, stack addresses and parameters are read where they are used and
/// take no register; the others are numbered by position, and their ranges come
/// from a liveness pass over the blocks. Then linear scan, over the registers a
/// processor offers (spec: x64/gen.arche, a64/gen.arche, rv64/gen.arche).
///
/// An optimized function (a release build, ir/opt.arche) has phis: a phi has
/// no code of its own, and takes its value on each edge into its block, at
/// the end of the block the edge leaves, after its branch: edge_moves says
/// how, and each backend writes the moves there.
import alloc;
import ir.ir;

pub const V_NONE: u8 = 0;
pub const V_REG: u8 = 1;
pub const V_CONST: u8 = 2;
pub const V_ADDR: u8 = 3;
pub const V_PARAM: u8 = 4;
pub const V_FUSED: u8 = 5;

pub const NO_REG: u8 = 255;
pub const NONE: u32 = 4294967295;

/// A register of the backend's for a value on its way between two places,
/// while the moves of an edge go round in a cycle.
pub const SCRATCH: u32 = 4294967294;

/// One move of an edge: the value src (or SCRATCH) to where the phi dst lives
/// (or to SCRATCH), a float or not.
pub type Move = struct {
    pub src: u32,
    pub dst: u32,
    pub float: bool,
}

/// Everything about the function being written, kept between functions so
/// that the compiler's one arena does not grow with each.
pub type Ranges = struct {
    /// By instruction.
    pub kinds: alloc.List(u8),
    pub regs: alloc.List(u8),
    pub slots: alloc.List(i32),
    pub starts: alloc.List(u32),
    pub ends: alloc.List(u32),
    def_block: alloc.List(u32),
    pub uses: alloc.List(u32),
    pub addr_root: alloc.List(u32),
    pub addr_off: alloc.List(i64),
    pub disps: alloc.List(i32),
    global_index: alloc.List(u32),
    /// An overflow's bit, and the next bit of the same overflow: the
    /// optimizer may leave more than one.
    pub overflow_bit: alloc.List(u32),
    pub next_bit: alloc.List(u32),
    /// By block.
    block_starts: alloc.List(u32),
    block_ends: alloc.List(u32),
    live_in: alloc.List(u64),
    live_out: alloc.List(u64),
    gen_bits: alloc.List(u64),
    kill_bits: alloc.List(u64),
    globals: alloc.List(u32),
    /// By position.
    call_positions: alloc.List(u32),
    order: alloc.List(u32),
    operands: alloc.List(u32),
    /// The registers' current values, for linear scan: who, and until when.
    /// The general registers' places first, the vector ones' from 32.
    holder: alloc.List(u32),
    holder_end: alloc.List(u32),
    /// Which registers were given out, the same way.
    used: alloc.List(bool),
    /// Those a function must keep for its caller: general ones, then vector.
    pub saved_ints: alloc.List(u8),
    pub saved_floats: alloc.List(u8),
    /// The bytes of the frame below the frame pointer so far.
    pub frame: i32,
    /// The moves of the edge being written, in order (edge_moves), and those
    /// still to be ordered.
    pub moves: alloc.List(Move),
    pending: alloc.List(Move),
    /// The order the blocks are written in (plan).
    pub layout: alloc.List(u32),
    /// Whether the backend branches on the flags or the register an
    /// overflow left (fuse_overflow): the machine backends do, WebAssembly's
    /// does not.
    pub fuse_overflows: bool,
}

pub fn new_ranges(a: alloc.Allocator) -> Ranges {
    return Ranges {
        kinds: alloc.List(u8).init(a),
        regs: alloc.List(u8).init(a),
        slots: alloc.List(i32).init(a),
        starts: alloc.List(u32).init(a),
        ends: alloc.List(u32).init(a),
        def_block: alloc.List(u32).init(a),
        uses: alloc.List(u32).init(a),
        addr_root: alloc.List(u32).init(a),
        addr_off: alloc.List(i64).init(a),
        disps: alloc.List(i32).init(a),
        global_index: alloc.List(u32).init(a),
        overflow_bit: alloc.List(u32).init(a),
        next_bit: alloc.List(u32).init(a),
        block_starts: alloc.List(u32).init(a),
        block_ends: alloc.List(u32).init(a),
        live_in: alloc.List(u64).init(a),
        live_out: alloc.List(u64).init(a),
        gen_bits: alloc.List(u64).init(a),
        kill_bits: alloc.List(u64).init(a),
        globals: alloc.List(u32).init(a),
        call_positions: alloc.List(u32).init(a),
        order: alloc.List(u32).init(a),
        operands: alloc.List(u32).init(a),
        holder: alloc.List(u32).init(a),
        holder_end: alloc.List(u32).init(a),
        used: alloc.List(bool).init(a),
        saved_ints: alloc.List(u8).init(a),
        saved_floats: alloc.List(u8).init(a),
        frame: 0,
        moves: alloc.List(Move).init(a),
        pending: alloc.List(Move).init(a),
        layout: alloc.List(u32).init(a),
        fuse_overflows: false,
    };
}

pub fn is_float(t: ir.Ty) -> bool {
    return t == ir.Ty.F32 or t == ir.Ty.F64;
}

/// A type's width in memory.
pub fn size_of(t: ir.Ty) -> u32 {
    match t {
        .I1 | .I8 => { return 1; }
        .I16 => { return 2; }
        .I32 | .F32 => { return 4; }
        _ => { return 8; }
    }
}

/// The width the operations on a type work at.
pub fn work_size(t: ir.Ty) -> u32 {
    if size_of(t) == 8 {
        return 8;
    }
    return 4;
}

fn fill_u8(l: &mut alloc.List(u8), n: usize, v: u8) {
    l.clear();
    var i: usize = 0;
    while i < n : (i += 1) {
        l.push(v);
    }
}

fn fill_u32(l: &mut alloc.List(u32), n: usize, v: u32) {
    l.clear();
    var i: usize = 0;
    while i < n : (i += 1) {
        l.push(v);
    }
}

fn fill_u64(l: &mut alloc.List(u64), n: usize, v: u64) {
    l.clear();
    var i: usize = 0;
    while i < n : (i += 1) {
        l.push(v);
    }
}

fn fill_i32(l: &mut alloc.List(i32), n: usize, v: i32) {
    l.clear();
    var i: usize = 0;
    while i < n : (i += 1) {
        l.push(v);
    }
}

fn fill_i64(l: &mut alloc.List(i64), n: usize, v: i64) {
    l.clear();
    var i: usize = 0;
    while i < n : (i += 1) {
        l.push(v);
    }
}

/// The values an instruction reads, into r.operands.
pub fn collect_operands(r: &mut Ranges, f: &ir.Function, id: u32) {
    r.operands.clear();
    let i = f.insts[id as usize];
    match i.op {
        .Load | .Gep | .Memzero | .Ext | .Trunc | .FNeg | .FConv | .IntToPtr | .PtrToInt | .AtomicLoad | .CondBr | .Ret | .CallIndirect => {
            r.operands.push(i.a);
        }
        .Store | .GepIndex | .Memcpy | .Bin | .Overflow | .Cmp | .FBin | .FCmp | .AtomicStore | .AtomicRmw => {
            r.operands.push(i.a);
            r.operands.push(i.b);
        }
        .CmpXchg => {
            r.operands.push(i.a);
            r.operands.push(i.b);
            r.operands.push(i.c);
        }
        .FMath => {
            r.operands.push(i.a);
            if i.flag == 5 or i.flag == 6 {
                r.operands.push(i.b);
            }
            if i.flag == 6 {
                r.operands.push(i.c);
            }
        }
        _ => { }
    }
    if i.op == ir.Op.Call or i.op == ir.Op.CallIndirect or i.op == ir.Op.Asm {
        var k = i.args_start;
        while k < i.args_start + i.args_len : (k += 1) {
            r.operands.push(f.args[k as usize]);
        }
    }
}

/// Whether the operation calls a function of the runtime, which does not
/// keep the vector registers.
pub fn calls_out(i: ir.Inst) -> bool {
    return i.op == ir.Op.Call or i.op == ir.Op.CallIndirect or (i.op == ir.Op.FMath and i.flag >= 2);
}

pub fn plan(r: &mut Ranges, f: &ir.Function) {
    let n = f.insts.len();
    fill_u8(&mut r.kinds, n, V_NONE);
    fill_u8(&mut r.regs, n, NO_REG);
    fill_i32(&mut r.slots, n, 0);
    fill_u32(&mut r.starts, n, 0);
    fill_u32(&mut r.ends, n, 0);
    fill_u32(&mut r.def_block, n, NONE);
    fill_u32(&mut r.uses, n, 0);
    fill_u32(&mut r.addr_root, n, NONE);
    fill_i64(&mut r.addr_off, n, 0);
    fill_i32(&mut r.disps, n, 0);
    fill_u32(&mut r.global_index, n, NONE);
    fill_u32(&mut r.overflow_bit, n, NONE);
    fill_u32(&mut r.next_bit, n, NONE);
    let nblocks = f.blocks.len();
    fill_u32(&mut r.block_starts, nblocks, 0);
    fill_u32(&mut r.block_ends, nblocks, 0);
    r.call_positions.clear();
    r.globals.clear();

    // How each value lives. Numbers go up with definitions, so an address's
    // root is known by the time its offset is; in an optimized function an
    // operand may be numbered after its user, and the addresses whose root
    // came later are settled after.
    var id: u32 = 0;
    while id < n as u32 : (id += 1) {
        let i = f.insts[id as usize];
        match i.op {
            .Const => { r.kinds[id as usize] = V_CONST; }
            .Param => { r.kinds[id as usize] = V_PARAM; }
            .Alloca | .Global | .VTable => {
                r.kinds[id as usize] = V_ADDR;
                r.addr_root[id as usize] = id;
            }
            .Gep => {
                if r.kinds[i.a as usize] == V_ADDR {
                    r.kinds[id as usize] = V_ADDR;
                    r.addr_root[id as usize] = r.addr_root[i.a as usize];
                    r.addr_off[id as usize] = r.addr_off[i.a as usize] + i.imm as i64;
                } else {
                    r.kinds[id as usize] = V_REG;
                }
            }
            .OverflowBit => {
                r.kinds[id as usize] = V_REG;
                r.overflow_bit[i.a as usize] = id;
            }
            _ => {
                if ir.has_value(i) {
                    r.kinds[id as usize] = V_REG;
                }
            }
        }
    }

    if f.ssa {
        settle_addresses(r, f);
    }

    lay_out(r, f);

    // Positions, definitions and uses, in the order the blocks are written.
    var pos: u32 = 2;
    var li: usize = 0;
    while li < nblocks : (li += 1) {
        let b = r.layout[li] as usize;
        r.block_starts[b] = pos;
        let ids = f.blocks[b].insts.items();
        var k: usize = 0;
        while k < ids.len() : (k += 1) {
            let this = ids[k];
            let i = f.insts[this as usize];
            collect_operands(r, f, this);
            var o: usize = 0;
            while o < r.operands.len() : (o += 1) {
                let u = r.operands[o] as usize;
                r.uses[u] += 1;
                if r.kinds[u] == V_REG {
                    if r.ends[u] < pos {
                        r.ends[u] = pos;
                    }
                }
            }
            if calls_out(i) {
                r.call_positions.push(pos);
            }
            if r.kinds[this as usize] == V_REG {
                r.def_block[this as usize] = b as u32;
                var at = pos;
                if i.op == ir.Op.OverflowBit or i.op == ir.Op.AsmOut {
                    at = r.starts[i.a as usize];
                }
                r.starts[this as usize] = at;
                if r.ends[this as usize] < at + 1 {
                    r.ends[this as usize] = at + 1;
                }
            }
            pos += 2;
        }
        r.block_ends[b] = pos;
    }
    if f.ssa {
        place_phis(r, f);
    }

    // A comparison its branch reads alone is done by the branch.
    var b: usize = 0;
    while b < nblocks : (b += 1) {
        let ids = f.blocks[b].insts.items();
        if ids.len() >= 2 {
            let last = f.insts[ids[ids.len() - 1] as usize];
            let before = ids[ids.len() - 2];
            if last.op == ir.Op.CondBr and last.a == before and f.insts[before as usize].op == ir.Op.Cmp and r.uses[before as usize] == 1 {
                r.kinds[before as usize] = V_FUSED;
            }
        }
    }
    if r.fuse_overflows {
        b = 0;
        while b < nblocks : (b += 1) {
            fuse_overflow(r, f, b: b as u32);
        }
    }
    liveness(r, f);
}

/// The order the blocks are written in. A debug build's, theirs. An
/// optimized function's, so that the code that runs falls through more and
/// jumps less: from the first, each block followed by a successor not yet
/// written, the branch's true one first, else by the first not yet written;
/// those that end in unreachable, a trap's, last. block_starts marks those
/// written until the positions are counted.
fn lay_out(r: &mut Ranges, f: &ir.Function) {
    let nblocks = f.blocks.len() as u32;
    r.layout.clear();
    var b: u32 = 0;
    if not f.ssa {
        while b < nblocks : (b += 1) {
            r.layout.push(b);
        }
        return;
    }
    var cur: u32 = 0;
    var first: u32 = 1;
    while cur != NONE {
        r.layout.push(cur);
        r.block_starts[cur as usize] = 1;
        let ids = f.blocks[cur as usize].insts.items();
        let term = f.insts[ids[ids.len() - 1] as usize];
        var next = NONE;
        if term.op == ir.Op.Br and hot_and_new(r, f, b: term.a) {
            next = term.a;
        } else if term.op == ir.Op.CondBr {
            if hot_and_new(r, f, b: term.b) {
                next = term.b;
            } else if hot_and_new(r, f, b: term.c) {
                next = term.c;
            }
        }
        while next == NONE and first < nblocks {
            if hot_and_new(r, f, b: first) {
                next = first;
            }
            first += 1;
        }
        cur = next;
    }
    b = 1;
    while b < nblocks : (b += 1) {
        if r.block_starts[b as usize] == 0 {
            r.layout.push(b);
        }
    }
}

fn hot_and_new(r: &Ranges, f: &ir.Function, b: u32) -> bool {
    return r.block_starts[b as usize] == 0 and not ends_unreachable(f, b);
}

fn ends_unreachable(f: &ir.Function, b: u32) -> bool {
    let ids = f.blocks[b as usize].insts.items();
    return ids.len() > 0 and f.insts[ids[ids.len() - 1] as usize].op == ir.Op.Unreachable;
}

/// BinKind.Xor's number (ir/ir.arche).
const BIN_XOR: u32 = 9;

/// Whether an instruction writes no code where it stands: a constant, a
/// parameter, a stack slot's or a global's address.
fn no_code(op: ir.Op) -> bool {
    return op == ir.Op.Const or op == ir.Op.Param or op == ir.Op.Alloca or op == ir.Op.Global or op == ir.Op.VTable;
}

/// The position in ids of the instruction with code before at; at itself
/// when none is.
fn code_before(f: &ir.Function, ids: []u32, at: usize) -> usize {
    var k = at;
    while k > 0 : (k -= 1) {
        if not no_code(f.insts[ids[k - 1] as usize].op) {
            return k - 1;
        }
    }
    return at;
}

/// An overflow's bit its branch reads alone, right after the operation,
/// flipped by an xor with 1 or not, is what the operation left in the
/// flags, or in a register: the branch reads it there (each backend's
/// gen_overflow), and the bit and the xor take no place. Instructions with
/// no code between them, a constant, change nothing.
fn fuse_overflow(r: &mut Ranges, f: &ir.Function, b: u32) {
    let ids = f.blocks[b as usize].insts.items();
    let n = ids.len();
    if n < 3 {
        return;
    }
    let term = f.insts[ids[n - 1] as usize];
    var at = code_before(f, ids: ids, at: n - 1);
    if term.op != ir.Op.CondBr or at == n - 1 or ids[at] != term.a or r.uses[term.a as usize] != 1 {
        return;
    }
    var bit = term.a;
    let c = f.insts[bit as usize];
    if c.op == ir.Op.Bin and c.flag == BIN_XOR and r.kinds[c.b as usize] == V_CONST and f.insts[c.b as usize].imm & 1 == 1 {
        let k = code_before(f, ids: ids, at: at);
        if k == at or ids[k] != c.a {
            return;
        }
        bit = c.a;
        at = k;
    }
    let i = f.insts[bit as usize];
    let k = code_before(f, ids: ids, at: at);
    if i.op != ir.Op.OverflowBit or k == at or ids[k] != i.a or r.uses[bit as usize] != 1 {
        return;
    }
    if r.overflow_bit[i.a as usize] != bit or r.next_bit[bit as usize] != NONE {
        return;
    }
    r.kinds[bit as usize] = V_FUSED;
    r.kinds[term.a as usize] = V_FUSED;
}

/// The addresses of an optimized function whose root is numbered after them,
/// in as many rounds as their chains are long.
fn settle_addresses(r: &mut Ranges, f: &ir.Function) {
    var settled = false;
    while not settled {
        settled = true;
        var id: u32 = 0;
        while id < f.insts.len() as u32 : (id += 1) {
            let i = f.insts[id as usize];
            if i.op == ir.Op.Gep and r.kinds[id as usize] == V_REG and r.kinds[i.a as usize] == V_ADDR {
                r.kinds[id as usize] = V_ADDR;
                r.addr_root[id as usize] = r.addr_root[i.a as usize];
                r.addr_off[id as usize] = r.addr_off[i.a as usize] + i.imm as i64;
                settled = false;
            }
        }
    }
}

/// Whether a block begins with phis: every edge into it has moves.
pub fn has_phis(f: &ir.Function, b: u32) -> bool {
    let ids = f.blocks[b as usize].insts.items();
    return ids.len() > 0 and f.insts[ids[0] as usize].op == ir.Op.Phi;
}

/// The phis' edges: the value a phi takes on an edge is read at the end of
/// the block it leaves, so it lives to there; and the phi is written there,
/// so it lives from there. Each is a use, which a comparison's fusing with its
/// branch counts. An overflow's bit and an asm's output are written with the
/// operation (each backend's gen_overflow, gen_asm), wherever the optimizer
/// left them: defined there. And the other values no block holds, which the
/// optimizer took out, live nowhere.
fn place_phis(r: &mut Ranges, f: &ir.Function) {
    var id: usize = 0;
    while id < f.insts.len() : (id += 1) {
        let i = f.insts[id];
        if r.kinds[id] == V_REG and (i.op == ir.Op.OverflowBit or i.op == ir.Op.AsmOut) and r.def_block[i.a as usize] != NONE {
            r.def_block[id] = r.def_block[i.a as usize];
            r.starts[id] = r.starts[i.a as usize];
            if r.ends[id] < r.starts[id] + 1 {
                r.ends[id] = r.starts[id] + 1;
            }
        }
    }
    id = 0;
    while id < f.insts.len() : (id += 1) {
        if r.kinds[id] == V_REG and r.def_block[id] == NONE {
            r.kinds[id] = V_NONE;
        }
    }
    // A stack slot is used when any address into it is (has_place).
    id = 0;
    while id < f.insts.len() : (id += 1) {
        let root = r.addr_root[id];
        if r.kinds[id] == V_ADDR and root != NONE and root != id as u32 and r.uses[id] > 0 {
            r.uses[root as usize] += 1;
        }
    }
    // The bits each overflow writes: those that live, not those the
    // optimizer took out.
    fill_u32(&mut r.overflow_bit, f.insts.len(), NONE);
    id = 0;
    while id < f.insts.len() : (id += 1) {
        let i = f.insts[id];
        if i.op == ir.Op.OverflowBit and r.kinds[id] == V_REG {
            r.next_bit[id] = r.overflow_bit[i.a as usize];
            r.overflow_bit[i.a as usize] = id as u32;
        }
    }
    var b: usize = 0;
    while b < f.blocks.len() : (b += 1) {
        let ids = f.blocks[b].insts.items();
        var k: usize = 0;
        while k < ids.len() and f.insts[ids[k] as usize].op == ir.Op.Phi : (k += 1) {
            let p = ids[k] as usize;
            let i = f.insts[p];
            var j = i.args_start;
            while j + 1 < i.args_start + i.args_len : (j += 2) {
                let edge = r.block_ends[f.args[j as usize] as usize];
                let v = f.args[j as usize + 1] as usize;
                r.uses[v] += 1;
                if r.kinds[v] == V_REG and r.ends[v] < edge {
                    r.ends[v] = edge;
                }
                if r.kinds[p] == V_REG {
                    if r.starts[p] > edge - 1 {
                        r.starts[p] = edge - 1;
                    }
                    if r.ends[p] < edge {
                        r.ends[p] = edge;
                    }
                }
            }
        }
    }
}

/// Where a value is while an edge's moves run, for telling which overwrite
/// which: a register of its class, a slot, or SCRATCH's register; NOWHERE
/// for a value read where it is used (a constant, an address, a parameter).
const NOWHERE: u64 = 18446744073709551615;

fn place_of(r: &Ranges, f: &ir.Function, v: u32, float: bool) -> u64 {
    if v == SCRATCH {
        if float {
            return 1099511627777;
        }
        return 1099511627776;
    }
    if r.kinds[v as usize] != V_REG {
        return NOWHERE;
    }
    let reg = r.regs[v as usize];
    if reg != NO_REG {
        if is_float(f.insts[v as usize].ty) {
            return 64 + reg as u64;
        }
        return reg as u64;
    }
    return 4294967296 + (r.slots[v as usize] as% u32) as u64;
}

/// The moves of the edge from → to into r.moves: each phi of to takes the
/// value it has from from, all at once. In an order that reads every place
/// before it is written; where they go round in a cycle, one value waits in
/// SCRATCH. A move to where the value is already is none.
pub fn edge_moves(r: &mut Ranges, f: &ir.Function, from: u32, to: u32) {
    r.moves.clear();
    r.pending.clear();
    let ids = f.blocks[to as usize].insts.items();
    var k: usize = 0;
    while k < ids.len() and f.insts[ids[k] as usize].op == ir.Op.Phi : (k += 1) {
        let p = ids[k];
        let i = f.insts[p as usize];
        if r.kinds[p as usize] == V_REG {
            let float = is_float(i.ty);
            var j = i.args_start;
            var found = false;
            while j + 1 < i.args_start + i.args_len and not found : (j += 2) {
                if f.args[j as usize] == from {
                    found = true;
                    let v = f.args[j as usize + 1];
                    if place_of(r, f, v: v, float: float) != place_of(r, f, v: p, float: float) {
                        r.pending.push(Move { src: v, dst: p, float: float });
                    }
                }
            }
        }
    }
    while r.pending.len() > 0 {
        // A move whose place no other reads goes first.
        var pick = r.pending.len();
        var m: usize = 0;
        while m < r.pending.len() and pick == r.pending.len() : (m += 1) {
            let target = place_of(r, f, v: r.pending[m].dst, float: r.pending[m].float);
            var read = false;
            var o: usize = 0;
            while o < r.pending.len() and not read : (o += 1) {
                if o != m and place_of(r, f, v: r.pending[o].src, float: r.pending[o].float) == target {
                    read = true;
                }
            }
            if not read {
                pick = m;
            }
        }
        if pick < r.pending.len() {
            r.moves.push(r.pending[pick]);
            let last = r.pending.len() - 1;
            r.pending[pick] = r.pending[last];
            _ = r.pending.pop();
        } else {
            // A cycle: what the first move's place holds waits in SCRATCH,
            // and the moves that read it read it there.
            let first = r.pending[0];
            let target = place_of(r, f, v: first.dst, float: first.float);
            var o: usize = 0;
            var saved = false;
            while o < r.pending.len() : (o += 1) {
                if place_of(r, f, v: r.pending[o].src, float: r.pending[o].float) == target {
                    if not saved {
                        r.moves.push(Move { src: r.pending[o].src, dst: SCRATCH, float: first.float });
                        saved = true;
                    }
                    r.pending[o].src = SCRATCH;
                }
            }
        }
    }
}

fn successors_into(r: &mut Ranges, i: ir.Inst) {
    r.operands.clear();
    if i.op == ir.Op.Br {
        r.operands.push(i.a);
    } else if i.op == ir.Op.CondBr {
        r.operands.push(i.b);
        r.operands.push(i.c);
    }
}

/// Ranges of the values used outside the block that defines them: most stay
/// in one, and only these take a place in the bit sets.
fn liveness(r: &mut Ranges, f: &ir.Function) {
    let nblocks = f.blocks.len();
    var b: usize = 0;
    while b < nblocks : (b += 1) {
        let ids = f.blocks[b].insts.items();
        var k: usize = 0;
        while k < ids.len() : (k += 1) {
            collect_operands(r, f, ids[k]);
            var o: usize = 0;
            while o < r.operands.len() : (o += 1) {
                let u = r.operands[o];
                if r.kinds[u as usize] == V_REG and r.def_block[u as usize] != b as u32 and r.global_index[u as usize] == NONE {
                    r.global_index[u as usize] = r.globals.len() as u32;
                    r.globals.push(u);
                }
            }
        }
    }
    // A phi's value from an edge is used at the end of the block it leaves:
    // outside its own block when it is defined elsewhere.
    if f.ssa {
        each_phi_use(r, f, mark: true, words: 0);
    }
    if r.globals.len() == 0 {
        return;
    }
    let words = (r.globals.len() + 63) / 64;
    fill_u64(&mut r.live_in, nblocks * words, 0);
    fill_u64(&mut r.live_out, nblocks * words, 0);
    fill_u64(&mut r.gen_bits, nblocks * words, 0);
    fill_u64(&mut r.kill_bits, nblocks * words, 0);
    let one: u64 = 1;
    b = 0;
    while b < nblocks : (b += 1) {
        let ids = f.blocks[b].insts.items();
        var k: usize = 0;
        while k < ids.len() : (k += 1) {
            collect_operands(r, f, ids[k]);
            var o: usize = 0;
            while o < r.operands.len() : (o += 1) {
                let gi = r.global_index[r.operands[o] as usize];
                if gi != NONE {
                    let word = b * words + gi as usize / 64;
                    let bit = one << (gi as u64 % 64);
                    if r.kill_bits[word] & bit == 0 {
                        r.gen_bits[word] = r.gen_bits[word] | bit;
                    }
                }
            }
            let gd = r.global_index[ids[k] as usize];
            if gd != NONE {
                let word = b * words + gd as usize / 64;
                r.kill_bits[word] = r.kill_bits[word] | (one << (gd as u64 % 64));
            }
        }
    }
    if f.ssa {
        each_phi_use(r, f, mark: false, words: words);
    }
    var changed = true;
    while changed {
        changed = false;
        var left = nblocks;
        while left > 0 : (left -= 1) {
            let this = left - 1;
            let ids = f.blocks[this].insts.items();
            successors_into(r, f.insts[ids[ids.len() - 1] as usize]);
            var w: usize = 0;
            while w < words : (w += 1) {
                var out: u64 = 0;
                var s: usize = 0;
                while s < r.operands.len() : (s += 1) {
                    out = out | r.live_in[r.operands[s] as usize * words + w];
                }
                let at = this * words + w;
                r.live_out[at] = out;
                let live = r.gen_bits[at] | (out & ~r.kill_bits[at]);
                if live != r.live_in[at] {
                    r.live_in[at] = live;
                    changed = true;
                }
            }
        }
    }
    b = 0;
    while b < nblocks : (b += 1) {
        var gi: usize = 0;
        while gi < r.globals.len() : (gi += 1) {
            let word = b * words + gi / 64;
            let bit = one << (gi as u64 % 64);
            let v = r.globals[gi] as usize;
            if r.live_in[word] & bit != 0 {
                if r.starts[v] > r.block_starts[b] {
                    r.starts[v] = r.block_starts[b];
                }
                if r.ends[v] < r.block_starts[b] {
                    r.ends[v] = r.block_starts[b];
                }
            }
            if r.live_out[word] & bit != 0 {
                if r.ends[v] < r.block_ends[b] {
                    r.ends[v] = r.block_ends[b];
                }
                if r.starts[v] > r.block_ends[b] {
                    r.starts[v] = r.block_ends[b];
                }
            }
        }
    }
}

/// Each value a phi takes on an edge, defined outside the block the edge
/// leaves: with mark, made one of the values the bit sets follow; without, a
/// use at that block's end, so live into it.
fn each_phi_use(r: &mut Ranges, f: &ir.Function, mark: bool, words: usize) {
    let one: u64 = 1;
    var b: usize = 0;
    while b < f.blocks.len() : (b += 1) {
        let ids = f.blocks[b].insts.items();
        var k: usize = 0;
        while k < ids.len() and f.insts[ids[k] as usize].op == ir.Op.Phi : (k += 1) {
            let i = f.insts[ids[k] as usize];
            var j = i.args_start;
            while j + 1 < i.args_start + i.args_len : (j += 2) {
                let from = f.args[j as usize];
                let v = f.args[j as usize + 1];
                if r.kinds[v as usize] == V_REG and r.def_block[v as usize] != from {
                    if mark {
                        if r.global_index[v as usize] == NONE {
                            r.global_index[v as usize] = r.globals.len() as u32;
                            r.globals.push(v);
                        }
                    } else {
                        let gi = r.global_index[v as usize];
                        let word = from as usize * words + gi as usize / 64;
                        let bit = one << (gi as u64 % 64);
                        if r.kill_bits[word] & bit == 0 {
                            r.gen_bits[word] = r.gen_bits[word] | bit;
                        }
                    }
                }
            }
        }
    }
}

fn crosses_call(r: &Ranges, start: u32, end: u32) -> bool {
    let calls = r.call_positions.items();
    var lo: usize = 0;
    var hi = calls.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        if calls[mid] <= start {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo < calls.len() and calls[lo] < end;
}

fn new_slot(r: &mut Ranges) -> i32 {
    r.frame += 8;
    return -r.frame;
}

fn spill(r: &mut Ranges, v: u32) {
    r.regs[v as usize] = NO_REG;
    r.slots[v as usize] = new_slot(r);
}

/// Linear scan over one class of registers: holders' places from first, with
/// the register of each from regs.
fn take_register(r: &mut Ranges, v: u32, regs: []u8, first: usize) {
    let start = r.starts[v as usize];
    let end = r.ends[v as usize];
    var k: usize = 0;
    var worst = first;
    while k < regs.len() : (k += 1) {
        let place = first + k;
        if r.holder_end[place] <= start {
            r.holder[place] = v;
            r.holder_end[place] = end;
            r.regs[v as usize] = regs[k];
            r.used[first + regs[k] as usize] = true;
            return;
        }
        if r.holder_end[place] > r.holder_end[worst] {
            worst = place;
        }
    }
    // None free: what lives longest goes to memory, for the whole of its life.
    if r.holder_end[worst] > end {
        let old = r.holder[worst];
        r.regs[v as usize] = r.regs[old as usize];
        spill(r, old);
        r.holder[worst] = v;
        r.holder_end[worst] = end;
    } else {
        spill(r, v);
    }
}

/// Registers for the function's values. reserved is what the frame already
/// holds below the frame pointer. A float in a register a call does not keep
/// goes to memory when it lives across a call: floats_kept says they all are.
pub fn allocate(r: &mut Ranges, f: &ir.Function, ints: []u8, floats: []u8, floats_kept: bool, reserved: i32) {
    r.frame = 0;
    r.order.clear();
    var id: u32 = 0;
    while id < f.insts.len() as u32 : (id += 1) {
        if r.kinds[id as usize] == V_REG {
            r.order.push(id);
        }
    }
    // By where each starts: nearly in order already.
    let order = r.order.items_mut();
    var i: usize = 1;
    while i < order.len() : (i += 1) {
        let v = order[i];
        let s = r.starts[v as usize];
        var j = i;
        while j > 0 and r.starts[order[j - 1] as usize] > s : (j -= 1) {
            order[j] = order[j - 1];
        }
        order[j] = v;
    }
    fill_u32(&mut r.holder, 64, NONE);
    fill_u32(&mut r.holder_end, 64, 0);
    r.used.clear();
    i = 0;
    while i < 64 : (i += 1) {
        r.used.push(false);
    }
    i = 0;
    while i < r.order.len() : (i += 1) {
        let v = r.order[i];
        if is_float(f.insts[v as usize].ty) {
            if not floats_kept and crosses_call(r, start: r.starts[v as usize], end: r.ends[v as usize]) {
                spill(r, v);
            } else {
                take_register(r, v, regs: floats, first: 32);
            }
        } else {
            take_register(r, v, regs: ints, first: 0);
        }
    }
    // What is to be kept takes the first places below what is reserved, and
    // the spilled values move down below that.
    r.saved_ints.clear();
    r.saved_floats.clear();
    i = 0;
    while i < ints.len() : (i += 1) {
        if r.used[ints[i] as usize] {
            r.saved_ints.push(ints[i]);
        }
    }
    if floats_kept {
        i = 0;
        while i < floats.len() : (i += 1) {
            if r.used[32 + floats[i] as usize] {
                r.saved_floats.push(floats[i]);
            }
        }
    }
    let above = reserved + (r.saved_ints.len() + r.saved_floats.len()) as i32 * 8;
    i = 0;
    while i < r.order.len() : (i += 1) {
        let v = r.order[i] as usize;
        if r.regs[v] == NO_REG {
            r.slots[v] -= above;
        }
    }
    r.frame += above;
}

/// Where the n-th register kept for the caller goes, below reserved.
pub fn saved_place(n: usize, reserved: i32) -> i32 {
    return -(reserved + (n as i32 + 1) * 8);
}

fn align_up(v: i32, to: i32) -> i32 {
    return (v + to - 1) / to * to;
}

/// Whether a stack slot takes room in the frame: every one of a debug build;
/// of an optimized function, those still used, not those the optimizer took
/// out of memory.
pub fn has_place(r: &Ranges, f: &ir.Function, alloca: u32) -> bool {
    return not f.ssa or r.uses[alloca as usize] > 0;
}

/// The stack slots, below what the frame holds so far. Past 16 bytes of
/// alignment the frame cannot promise it: room to round the address.
pub fn place_allocas(r: &mut Ranges, f: &ir.Function) {
    var id: u32 = 0;
    while id < f.insts.len() as u32 : (id += 1) {
        let i = f.insts[id as usize];
        if i.op == ir.Op.Alloca and has_place(r, f, alloca: id) {
            var al = i.flag as i32;
            if al < 1 {
                al = 1;
            }
            var size = i.imm as i32;
            if al > 16 {
                size += al;
                al = 16;
            }
            r.frame = align_up(v: r.frame + size, to: al);
            r.disps[id as usize] = -r.frame;
        }
    }
}
