// manifest: import std.build; const PACKAGE: build.Package = build.Package { name: "demo", edition: 2027 };
import std;

fn main(sys: &mut std.System) -> !void {
    match sys.fs.read_file("notes.txt", sys.alloc) {
        ok(text) => { sys.stdout.write(text.view()); }
        .err(_) => { }
    }
}
