/// The Arche compiler, written in Arche-0 (spec/arche-0.md) and built by
/// stage0.
///
///     arche check [--json] <file>   report the file's errors
///     arche tokens <file>           list its tokens, trivia included
///     arche cst <file>              print it again from its syntax tree
///     arche fix <file>              apply the fixes the checker suggests
///     arche explain <code>          what an error code means, with an example
///     arche fmt [--check] <file>    lay the file out the one way (syntax/fmt.arche)
///     arche build <file> <out.ll>   compile it to LLVM IR (arche-build links it)
///
/// Functions take the capabilities they use one by one, not the whole
/// std.System: a path read from sys.args can then be passed beside
/// &mut sys.stdout without two views of one place (§5.4).
import std;
import alloc;
import diag;
import explain;
import program;
import sema.check as sema;
import syntax.lexer;
import syntax.parser;
import syntax.cst;
import syntax.fmt;
import ir.ir;
import ir.llvm;
import lower.lower;

/// What `arche` exits with, besides success (§10: `error: <name>`, status 1).
type Failure = error { ErrorsFound, BadUsage, CannotRead, CannotWrite, BadIr }

fn usage(err_out: &mut std.Output) -> Failure!void {
    err_out.write("usage: arche check [--json] <file>\n");
    err_out.write("       arche fix <file>                apply the checker's fixes to the files\n");
    err_out.write("       arche explain [--example] <code>   what an error code means, or just its example\n");
    err_out.write("       arche fmt [--check] <file>      lay the file out; --check only says whether it is\n");
    err_out.write("       arche tokens <file>\n");
    err_out.write("       arche cst <file>\n");
    err_out.write("       arche build <file> <out.ll>\n");
    err_out.write("       arche test <file> <out.ll>     the test blocks of <file>, run by std.testing\n");
    err_out.write("options, before the command: --lib-alloc, --lib-std, --target <linux-x86_64 | freestanding-x86_64 |\n");
    err_out.write("       freestanding-riscv64>, --panic-handler <module.function>\n");
    return Failure.BadUsage;
}

/// The offset of the first byte that breaks UTF-8 (§2), if one does.
fn first_invalid_utf8(b: []u8) -> ?usize {
    var i: usize = 0;
    while i < b.len() {
        let c = b[i];
        var n: usize = 0;
        var min: u32 = 0;
        var cp: u32 = 0;
        if c < 0x80 {
            i += 1;
            continue;
        } else if c >= 0xC2 and c <= 0xDF {
            n = 2;
            min = 0x80;
            cp = (c & 0x1F) as u32;
        } else if c >= 0xE0 and c <= 0xEF {
            n = 3;
            min = 0x800;
            cp = (c & 0x0F) as u32;
        } else if c >= 0xF0 and c <= 0xF4 {
            n = 4;
            min = 0x10000;
            cp = (c & 0x07) as u32;
        } else {
            return i;
        }
        if i + n > b.len() {
            return i;
        }
        var k: usize = 1;
        while k < n : (k += 1) {
            if b[i + k] & 0xC0 != 0x80 {
                return i;
            }
            cp = (cp << 6) | (b[i + k] & 0x3F) as u32;
        }
        if cp < min or cp > 0x10FFFF or (cp >= 0xD800 and cp <= 0xDFFF) {
            return i;
        }
        i += n;
    }
    return none;
}

/// A file that is not UTF-8 cannot become a str, so its one diagnostic is
/// written from its bytes, here, rather than through diag.
fn report_invalid_utf8(fs: &std.Fs, err_out: &mut std.Output, path: str, a: alloc.Allocator) {
    let bytes = fs.read_bytes(path, a) catch alloc.List(u8).init(a);
    let b = bytes.items();
    let at = first_invalid_utf8(b) orelse 0;
    var line: u64 = 1;
    var line_start: usize = 0;
    var i: usize = 0;
    while i < at : (i += 1) {
        if b[i] == '\n' {
            line += 1;
            line_start = i + 1;
        }
    }
    err_out.write(path);
    err_out.write(":");
    err_out.write_u64(line);
    err_out.write(":");
    err_out.write_u64((at - line_start + 1) as u64);
    err_out.write(": error[E0101]: the file is not valid UTF-8\n");
}

fn read(fs: &std.Fs, err_out: &mut std.Output, path: str, a: alloc.Allocator) -> Failure!alloc.String {
    match fs.read_file(path, a) {
        ok(text) => {
            return text;
        }
        err(.InvalidUtf8) => {
            report_invalid_utf8(fs, err_out, path, a);
            return Failure.ErrorsFound;
        }
        err(e) => {
            err_out.write("arche: cannot read ");
            err_out.write(path);
            err_out.write(": ");
            match e {
                .NotFound => { err_out.write("not found"); }
                .AccessDenied => { err_out.write("access denied"); }
                .IsDirectory => { err_out.write("it is a directory"); }
                .InvalidUtf8 => { err_out.write("it is not UTF-8"); }
                .IoFailed => { err_out.write("input/output failed"); }
            }
            err_out.write("\n");
            return Failure.CannotRead;
        }
    }
}

fn check(
    out: &mut std.Output,
    err_out: &mut std.Output,
    fs: &std.Fs,
    a: alloc.Allocator,
    path: str,
    json: bool,
    opts: &program.Options,
) -> Failure!void {
    let source = try read(fs, err_out, path, a);
    var p = program.load(fs, path: path, source, a, opts);
    if p.diags.count() == 0 {
        p = sema.check(p);
    }
    if json {
        program.write_diagnostics(out, &p, true);
    } else {
        program.write_diagnostics(err_out, &p, false);
    }
    if p.diags.count() > 0 {
        return Failure.ErrorsFound;
    }
}

/// The number of a code written E0409 (or 0409, or 409), or none.
fn code_number(text: str) -> ?u16 {
    var start: usize = 0;
    if text.len() > 0 and (text[0] == 'E' or text[0] == 'e') {
        start = 1;
    }
    if text.len() == start or text.len() - start > 4 {
        return none;
    }
    var n: u16 = 0;
    var i = start;
    while i < text.len() : (i += 1) {
        let c = text[i];
        if c < '0' or c > '9' {
            return none;
        }
        n = n * 10 + (c - '0') as u16;
    }
    return n;
}

fn write_code(out: &mut std.Output, n: u16) {
    out.write("E");
    if n < 1000 {
        out.write("0");
    }
    out.write_u64(n as u64);
}

/// `arche explain`: the meaning of a code and its example; with --example
/// only the example, as a file to check (the byte E0101's needs included).
fn explain_code(out: &mut std.Output, err_out: &mut std.Output, text: str, only_example: bool) -> Failure!void {
    var n: u16 = 0;
    match code_number(text) {
        some(v) => { n = v; }
        none => {
            err_out.write("arche explain: a code is written like E0409\n");
            return Failure.BadUsage;
        }
    }
    let meaning = explain.meaning(n);
    if meaning.len() == 0 {
        err_out.write("arche explain: there is no code ");
        write_code(err_out, n);
        err_out.write(" (docs/error-codes.md lists them)\n");
        return Failure.BadUsage;
    }
    let example = explain.example(n);
    if only_example {
        out.write(example);
        if n == 101 {
            out.write_byte(0xFF);
            out.write("\n");
        }
        return;
    }
    write_code(out, n);
    out.write(": ");
    out.write(meaning);
    out.write("\n");
    if example.len() == 0 {
        return;
    }
    out.write("\nFor example, ");
    let options = explain.example_options(n);
    if explain.example_is_full(n) {
        out.write("in a package (a package.arche beside it, so full Arche), ");
    }
    out.write("`arche ");
    if options.len() > 0 {
        out.write(options);
        out.write(" ");
    }
    out.write("check` reports ");
    write_code(out, n);
    out.write(" on this file:\n\n");
    var line_start = true;
    var i: usize = 0;
    while i < example.len() : (i += 1) {
        if line_start and example[i] != '\n' {
            out.write("    ");
        }
        out.write_byte(example[i]);
        line_start = example[i] == '\n';
    }
    if n == 101 {
        out.write("    (the byte 0xFF)\n");
    }
}

/// `arche fmt`: rewrites the file laid out, or with --check says whether it
/// is (status 1 when not).
fn format_file(out: &mut std.Output, err_out: &mut std.Output, fs: &std.Fs, a: alloc.Allocator, path: str, check_only: bool) -> Failure!void {
    let source = try read(fs, err_out, path, a);
    var text = alloc.String.init(a);
    match fmt.format(source.view(), a) {
        some(t) => { text = t; }
        none => {
            err_out.write("arche fmt: ");
            err_out.write(path);
            err_out.write(" has a lexical error; arche check says which\n");
            return Failure.ErrorsFound;
        }
    }
    if text.view().eq(source.view()) {
        return;
    }
    if check_only {
        out.write(path);
        out.write(": not formatted\n");
        return Failure.ErrorsFound;
    }
    match fs.write_file(path: path, data: text.view()) {
        ok(_) => { }
        err(_) => {
            err_out.write("arche: cannot write ");
            err_out.write(path);
            err_out.write("\n");
            return Failure.CannotWrite;
        }
    }
}

/// One edit of a fix: replace text[start..end] with replacement.
type Edit = struct {
    start: u32,
    end: u32,
    replacement: alloc.String,
}

/// Applies the checker's fixes to the files they are in, and checks again,
/// until no fix is left (a fix can uncover another); then reports what is
/// left as check does.
fn fix(out: &mut std.Output, err_out: &mut std.Output, fs: &std.Fs, a: alloc.Allocator, path: str, opts: &program.Options) -> Failure!void {
    var applied: u64 = 0;
    var round: u32 = 0;
    while true {
        let source = try read(fs, err_out, path, a);
        var p = program.load(fs, path: path, source, a, opts);
        if p.diags.count() == 0 {
            p = sema.check(p);
        }
        var changed = false;
        let mods = p.modules.items();
        var m: usize = 0;
        while m < mods.len() and round < 16 : (m += 1) {
            // This module's edits, latest first, each once.
            var edits = alloc.List(Edit).init(a);
            let ds = p.diags.items.items();
            var i: usize = 0;
            while i < ds.len() : (i += 1) {
                if ds[i].file as usize != m {
                    continue;
                }
                match &ds[i].fix {
                    some(f) => {
                        var r = alloc.String.init(a);
                        r.push_str(f.replacement.view());
                        let e = Edit { start: f.span.start, end: f.span.end(), replacement: r };
                        var dup = false;
                        var k: usize = 0;
                        while k < edits.len() : (k += 1) {
                            if edits[k].start == e.start and edits[k].end == e.end and edits[k].replacement.view().eq(e.replacement.view()) {
                                dup = true;
                            }
                        }
                        if not dup {
                            edits.push(e);
                        }
                    }
                    none => { }
                }
            }
            if edits.len() == 0 {
                continue;
            }
            // Insertion sort by start, from the end of the file back.
            let es = edits.items_mut();
            var j: usize = 1;
            while j < es.len() : (j += 1) {
                var k = j;
                while k > 0 and es[k - 1].start < es[k].start : (k -= 1) {
                    let a_start = es[k - 1].start;
                    let a_end = es[k - 1].end;
                    var a_text = alloc.String.init(a);
                    a_text.push_str(es[k - 1].replacement.view());
                    es[k - 1].start = es[k].start;
                    es[k - 1].end = es[k].end;
                    var b_text = alloc.String.init(a);
                    b_text.push_str(es[k].replacement.view());
                    es[k - 1].replacement = b_text;
                    es[k].start = a_start;
                    es[k].end = a_end;
                    es[k].replacement = a_text;
                }
            }
            let text = mods[m].text.view();
            var result = alloc.String.init(a);
            // Built from the front: the edits in source order are es reversed.
            var at: u32 = 0;
            var e = es.len();
            while e > 0 : (e -= 1) {
                let ed = &es[e - 1];
                if ed.start < at {
                    continue;
                }
                result.push_str(text[at as usize..ed.start as usize]);
                result.push_str(ed.replacement.view());
                at = ed.end;
                applied += 1;
            }
            result.push_str(text[at as usize..text.len()]);
            match fs.write_file(path: mods[m].path.view(), data: result.view()) {
                ok(_) => { }
                err(_) => {
                    err_out.write("arche: cannot write ");
                    err_out.write(mods[m].path.view());
                    err_out.write("\n");
                    return Failure.CannotWrite;
                }
            }
            changed = true;
        }
        if not changed {
            out.write("arche fix: applied ");
            out.write_u64(applied);
            out.write(" fixes\n");
            program.write_diagnostics(err_out, &p, false);
            if p.diags.count() > 0 {
                return Failure.ErrorsFound;
            }
            return;
        }
        round += 1;
    }
}

fn build(err_out: &mut std.Output, fs: &std.Fs, a: alloc.Allocator, path: str, out_path: str, opts: &program.Options) -> Failure!void {
    let source = try read(fs, err_out, path, a);
    let p = program.load(fs, path: path, source, a, opts);
    if p.diags.count() > 0 {
        program.write_diagnostics(err_out, &p, false);
        return Failure.ErrorsFound;
    }
    let c = sema.analyze(p);
    if c.p.diags.count() > 0 {
        program.write_diagnostics(err_out, &c.p, false);
        return Failure.ErrorsFound;
    }
    let m = lower.lower(c);
    // The verifier checks every function the lowering made.
    let fns = m.functions.items();
    var i: usize = 0;
    while i < fns.len() : (i += 1) {
        let problem = ir.verify(&fns[i]);
        if problem.found {
            err_out.write("arche: internal error: the IR of ");
            err_out.write(fns[i].name.view());
            err_out.write(" is wrong at instruction ");
            err_out.write_u64(problem.inst as u64);
            err_out.write(": ");
            err_out.write(ir.describe(problem.what));
            err_out.write("\n");
            return Failure.BadIr;
        }
    }
    let text = llvm.emit(&m, a);
    match fs.write_file(path: out_path, data: text.view()) {
        ok(_) => { }
        err(_) => {
            err_out.write("arche: cannot write ");
            err_out.write(out_path);
            err_out.write("\n");
            return Failure.CannotWrite;
        }
    }
}

fn dump_tokens(out: &mut std.Output, err_out: &mut std.Output, fs: &std.Fs, a: alloc.Allocator, path: str) -> Failure!void {
    let source = try read(fs, err_out, path, a);
    let text = source.view();
    var diags = diag.Diagnostics.init(a);
    let tokens = lexer.lex(text, true, &mut diags, a);
    lexer.write_tokens(out, &tokens, text);
    diag.write_text(err_out, &diags, 0, path: path, text: text);
}

fn print_cst(out: &mut std.Output, err_out: &mut std.Output, fs: &std.Fs, a: alloc.Allocator, path: str) -> Failure!void {
    let source = try read(fs, err_out, path, a);
    let text = source.view();
    var lexed = diag.Diagnostics.init(a);
    let tokens = lexer.lex(text, true, &mut lexed, a);
    let parsed = parser.parse(tokens, text, true, lexed, a);
    cst.write_source(out, &parsed.tree, text);
}

/// The library's directory (spec/arche.md §1.1): lib/ beside the
/// compiler's directory, as the repository lays them out, from where the
/// binary was started.
fn find_lib(fs: &std.Fs, argv0: str, a: alloc.Allocator) -> alloc.String {
    var cut: usize = 0;
    var i: usize = 0;
    while i < argv0.len() : (i += 1) {
        if argv0[i] == '/' {
            cut = i + 1;
        }
    }
    var up: u32 = 2;
    while up <= 4 : (up += 1) {
        var dir = alloc.String.init(a);
        dir.push_str(argv0[0..cut]);
        var k: u32 = 0;
        while k < up : (k += 1) {
            dir.push_str("../");
        }
        dir.push_str("lib/");
        var probe = alloc.String.init(a);
        probe.push_str(dir.view());
        probe.push_str("core.arche");
        match fs.read_bytes(probe.view(), a) {
            ok(_) => { return dir; }
            err(_) => { }
        }
    }
    var fallback = alloc.String.init(a);
    fallback.push_str(argv0[0..cut]);
    fallback.push_str("../../lib/");
    return fallback;
}

fn main(sys: &mut std.System) -> !void {
    let n = sys.args.len();
    if n < 3 {
        try usage(&mut sys.stderr);
    }
    // Options come before the command: --lib-alloc builds Arche-0 code on
    // lib/alloc; --target and --panic-handler choose a freestanding build.
    var opts = program.Options {
        lib: find_lib(&sys.fs, sys.args.get(0), sys.alloc),
        lib_alloc: false,
        lib_std: false,
        target: program.Target.LinuxX86_64,
        panic_handler: alloc.String.init(sys.alloc),
        tests: false,
    };
    var first: usize = 1;
    while first + 1 < n and sys.args.get(first).starts_with("--") : (first += 1) {
        let o = sys.args.get(first);
        if o.eq("--lib-alloc") {
            opts.lib_alloc = true;
        } else if o.eq("--lib-std") {
            opts.lib_std = true;
        } else if o.eq("--target") {
            first += 1;
            match program.target_by_name(sys.args.get(first)) {
                some(t) => { opts.target = t; }
                none => {
                    sys.stderr.write("arche: unknown target; the targets are linux-x86_64, freestanding-x86_64 and freestanding-riscv64\n");
                    return Failure.BadUsage;
                }
            }
        } else if o.eq("--panic-handler") {
            first += 1;
            opts.panic_handler.push_str(sys.args.get(first));
        } else {
            try usage(&mut sys.stderr);
        }
    }
    let k = first - 1;
    let count = n - k;
    let command = sys.args.get(first);
    if command.eq("check") and count == 4 and sys.args.get(2 + k).eq("--json") {
        try check(out: &mut sys.stdout, err_out: &mut sys.stderr, fs: &sys.fs, a: sys.alloc, path: sys.args.get(3 + k), json: true, opts: &opts);
    } else if command.eq("check") and count == 3 {
        try check(out: &mut sys.stdout, err_out: &mut sys.stderr, fs: &sys.fs, a: sys.alloc, path: sys.args.get(2 + k), json: false, opts: &opts);
    } else if command.eq("fix") and count == 3 {
        try fix(out: &mut sys.stdout, err_out: &mut sys.stderr, fs: &sys.fs, a: sys.alloc, path: sys.args.get(2 + k), opts: &opts);
    } else if command.eq("explain") and count == 3 {
        try explain_code(out: &mut sys.stdout, err_out: &mut sys.stderr, text: sys.args.get(2 + k), only_example: false);
    } else if command.eq("explain") and count == 4 and sys.args.get(2 + k).eq("--example") {
        try explain_code(out: &mut sys.stdout, err_out: &mut sys.stderr, text: sys.args.get(3 + k), only_example: true);
    } else if command.eq("fmt") and count == 3 {
        try format_file(out: &mut sys.stdout, err_out: &mut sys.stderr, fs: &sys.fs, a: sys.alloc, path: sys.args.get(2 + k), check_only: false);
    } else if command.eq("fmt") and count == 4 and sys.args.get(2 + k).eq("--check") {
        try format_file(out: &mut sys.stdout, err_out: &mut sys.stderr, fs: &sys.fs, a: sys.alloc, path: sys.args.get(3 + k), check_only: true);
    } else if command.eq("tokens") and count == 3 {
        try dump_tokens(out: &mut sys.stdout, err_out: &mut sys.stderr, fs: &sys.fs, a: sys.alloc, path: sys.args.get(2 + k));
    } else if command.eq("build") and count == 4 {
        try build(err_out: &mut sys.stderr, fs: &sys.fs, a: sys.alloc, path: sys.args.get(2 + k), out_path: sys.args.get(3 + k), opts: &opts);
    } else if command.eq("test") and count == 4 {
        // The root module's test blocks and a runner (std.testing).
        opts.tests = true;
        try build(err_out: &mut sys.stderr, fs: &sys.fs, a: sys.alloc, path: sys.args.get(2 + k), out_path: sys.args.get(3 + k), opts: &opts);
    } else if command.eq("cst") and count == 3 {
        try print_cst(out: &mut sys.stdout, err_out: &mut sys.stderr, fs: &sys.fs, a: sys.alloc, path: sys.args.get(2 + k));
    } else {
        try usage(&mut sys.stderr);
    }
}
