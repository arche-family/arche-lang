/// The Arche compiler, written in Arche-0 (spec/arche-0.md) and built by
/// stage0.
///
///     arche check [--json] <file>   report the file's errors
///     arche tokens <file>           list its tokens, trivia included
///     arche cst <file>              print it again from its syntax tree
///
/// Functions take the capabilities they use one by one, not the whole
/// std.System: a path read from sys.args can then be passed beside
/// &mut sys.stdout without two views of one place (§5.4).
import std;
import alloc;
import diag;
import program;
import sema.check as sema;
import syntax.lexer;
import syntax.parser;
import syntax.cst;

/// What `arche` exits with, besides success (§10: `error: <name>`, status 1).
type Failure = error { ErrorsFound, BadUsage, CannotRead }

fn usage(err_out: &mut std.Output) -> Failure!void {
    err_out.write("usage: arche check [--json] <file>\n");
    err_out.write("       arche tokens <file>\n");
    err_out.write("       arche cst <file>\n");
    return Failure.BadUsage;
}

/// The offset of the first byte that breaks UTF-8 (§2), if one does.
fn first_invalid_utf8(b: []u8) -> ?usize {
    var i: usize = 0;
    while i < b.len() {
        let c = b[i];
        var n: usize = 0;
        var min: u32 = 0;
        var cp: u32 = 0;
        if c < 0x80 {
            i += 1;
            continue;
        } else if c >= 0xC2 and c <= 0xDF {
            n = 2;
            min = 0x80;
            cp = (c & 0x1F) as u32;
        } else if c >= 0xE0 and c <= 0xEF {
            n = 3;
            min = 0x800;
            cp = (c & 0x0F) as u32;
        } else if c >= 0xF0 and c <= 0xF4 {
            n = 4;
            min = 0x10000;
            cp = (c & 0x07) as u32;
        } else {
            return i;
        }
        if i + n > b.len() {
            return i;
        }
        var k: usize = 1;
        while k < n : (k += 1) {
            if b[i + k] & 0xC0 != 0x80 {
                return i;
            }
            cp = (cp << 6) | (b[i + k] & 0x3F) as u32;
        }
        if cp < min or cp > 0x10FFFF or (cp >= 0xD800 and cp <= 0xDFFF) {
            return i;
        }
        i += n;
    }
    return none;
}

/// A file that is not UTF-8 cannot become a str, so its one diagnostic is
/// written from its bytes, here, rather than through diag.
fn report_invalid_utf8(fs: &std.Fs, err_out: &mut std.Output, path: str, a: alloc.Allocator) {
    let bytes = fs.read_bytes(path, a) catch alloc.List(u8).init(a);
    let b = bytes.items();
    let at = first_invalid_utf8(b) orelse 0;
    var line: u64 = 1;
    var line_start: usize = 0;
    var i: usize = 0;
    while i < at : (i += 1) {
        if b[i] == '\n' {
            line += 1;
            line_start = i + 1;
        }
    }
    err_out.write(path);
    err_out.write(":");
    err_out.write_u64(line);
    err_out.write(":");
    err_out.write_u64((at - line_start + 1) as u64);
    err_out.write(": error[E0101]: the file is not valid UTF-8\n");
}

fn read(fs: &std.Fs, err_out: &mut std.Output, path: str, a: alloc.Allocator) -> Failure!alloc.String {
    match fs.read_file(path, a) {
        ok(text) => {
            return text;
        }
        err(.InvalidUtf8) => {
            report_invalid_utf8(fs, err_out, path, a);
            return Failure.ErrorsFound;
        }
        err(e) => {
            err_out.write("arche: cannot read ");
            err_out.write(path);
            err_out.write(": ");
            match e {
                .NotFound => { err_out.write("not found"); }
                .AccessDenied => { err_out.write("access denied"); }
                .IsDirectory => { err_out.write("it is a directory"); }
                .InvalidUtf8 => { err_out.write("it is not UTF-8"); }
                .IoFailed => { err_out.write("input/output failed"); }
            }
            err_out.write("\n");
            return Failure.CannotRead;
        }
    }
}

fn check(
    out: &mut std.Output,
    err_out: &mut std.Output,
    fs: &std.Fs,
    a: alloc.Allocator,
    path: str,
    json: bool,
) -> Failure!void {
    let source = try read(fs, err_out, path, a);
    var p = program.load(fs, path, source, a);
    if p.diags.count() == 0 {
        sema.check(&mut p);
    }
    if json {
        program.write_diagnostics(out, &p, true);
    } else {
        program.write_diagnostics(err_out, &p, false);
    }
    if p.diags.count() > 0 {
        return Failure.ErrorsFound;
    }
}

fn dump_tokens(out: &mut std.Output, err_out: &mut std.Output, fs: &std.Fs, a: alloc.Allocator, path: str) -> Failure!void {
    let source = try read(fs, err_out, path, a);
    let text = source.view();
    var diags = diag.Diagnostics.init(a);
    let tokens = lexer.lex(text, &mut diags, a);
    lexer.write_tokens(out, &tokens, text);
    diag.write_text(err_out, &diags, 0, path: path, text: text);
}

fn print_cst(out: &mut std.Output, err_out: &mut std.Output, fs: &std.Fs, a: alloc.Allocator, path: str) -> Failure!void {
    let source = try read(fs, err_out, path, a);
    let text = source.view();
    var lexed = diag.Diagnostics.init(a);
    let tokens = lexer.lex(text, &mut lexed, a);
    let parsed = parser.parse(tokens, text, lexed, a);
    cst.write_source(out, &parsed.tree, text);
}

fn main(sys: &mut std.System) -> !void {
    let n = sys.args.len();
    if n < 3 {
        try usage(&mut sys.stderr);
    }
    let command = sys.args.get(1);
    if command.eq("check") and n == 4 and sys.args.get(2).eq("--json") {
        try check(out: &mut sys.stdout, err_out: &mut sys.stderr, fs: &sys.fs, a: sys.alloc, path: sys.args.get(3), json: true);
    } else if command.eq("check") and n == 3 {
        try check(out: &mut sys.stdout, err_out: &mut sys.stderr, fs: &sys.fs, a: sys.alloc, path: sys.args.get(2), json: false);
    } else if command.eq("tokens") and n == 3 {
        try dump_tokens(out: &mut sys.stdout, err_out: &mut sys.stderr, fs: &sys.fs, a: sys.alloc, path: sys.args.get(2));
    } else if command.eq("cst") and n == 3 {
        try print_cst(out: &mut sys.stdout, err_out: &mut sys.stderr, fs: &sys.fs, a: sys.alloc, path: sys.args.get(2));
    } else {
        try usage(&mut sys.stderr);
    }
}
