# What the phone's Linux kernel adds to x86_64_defconfig and kvm_guest.config
# (interop/linux/kernel.sh): everything built in, no modules, so the
# Arche init in the initramfs loads nothing; a screen through virtio-gpu
# and DRM, with no kernel console drawn on it; input through virtio-input
# and evdev; /dev from devtmpfs.
CONFIG_MODULES=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=n
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=n
CONFIG_FB=n
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_LOCALVERSION="-arche-phone"
CONFIG_LOCALVERSION_AUTO=n
