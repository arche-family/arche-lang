# What the phone's Linux kernel adds to x86_64_defconfig and kvm_guest.config
# (interop/linux/kernel.sh): everything built in, no modules, so the
# Arche init in the initramfs loads nothing; a screen through virtio-gpu
# and DRM, with no kernel console drawn on it; input through virtio-input
# and evdev; /dev from devtmpfs. Wi-Fi (arche-os T5): the wireless stack
# and mac80211_hwsim, whose two radios QEMU has none of, and the kernel's
# crypto iwd uses (AF_ALG, keys, Diffie-Hellman).
CONFIG_MODULES=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=n
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=n
CONFIG_FB=n
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_WLAN=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MAC80211_HWSIM=y
CONFIG_RFKILL=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_LOCALVERSION="-arche-phone"
CONFIG_LOCALVERSION_AUTO=n
