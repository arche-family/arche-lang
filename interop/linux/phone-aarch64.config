# What the phone's kernel for ARM64 (interop/linux/kernel.sh aarch64,
# S39) adds on top of phone.config, for QEMU's virt machine: its PCI host
# bridge, where the virtio devices and the sound card are; virtio over MMIO
# too; its PL011 serial port as the console and its PL031 clock; and PSCI
# to power off and restart. The 8250 serial port phone.config asks for is
# there too, unused. No KVM host: the phone runs no machines of its own.
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_MMIO=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_ARM_PSCI_FW=y
CONFIG_POWER_RESET=y
CONFIG_VIRTUALIZATION=n
CONFIG_KVM=n
